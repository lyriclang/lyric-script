// B4 words: a text of 100 000 words from a vocabulary of 5000 (an LCG picks them), built in a
// StringBuilder, split at the spaces and counted in a Map<string, int> — strings, hashing, a map.
// The same algorithm as ../v46/words.lyr. Prints the distinct words and the largest count.
fn run(): string {
    var x = 12345
    let text = StringBuilder.new()
    var i = 0
    while (i < 100000) {
        x = (x * 1103515245 + 12345) % 2147483648
        if (i > 0) {
            text.append(" ")
        }
        text.append("w")
        text.append(x / 65536 % 5000)
        i += 1
    }
    let counts: Map<string, int> = Map.new()
    var most = 0
    for (w in text.toString().split(" ")) {
        let c = (counts[w] ?? 0) + 1
        counts[w] = c
        if (c > most) {
            most = c
        }
    }
    return f"{counts.length()} {most}"
}

println(run())
