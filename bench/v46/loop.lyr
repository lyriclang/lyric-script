// B2 loop: N iterations of acc = (acc + i * i) % 1000003 — dispatch and int arithmetic.
// The same algorithm as ../loop.lyrsasm.
import std.io.console { println };

fn main(): int {
    let n = 10000000;
    var acc = 0;
    var i = 0;
    while (i < n) {
        acc = (acc + i * i) % 1000003;
        i += 1;
    }
    println(acc);
    return 0;
}
