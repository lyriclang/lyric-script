// B7 map: 100 000 writes of LCG keys into a Map<int, int> (some overwrite), then 400 000 reads, most
// of them misses. The same algorithm as ../src/map.lyrs.
import std.io.console { println };
import std.collections { Map };

fn main(): int {
    let m = Map<int, int>.empty();
    var x = 12345;
    var i = 0;
    while (i < 100000) {
        x = (x * 1103515245 + 12345) % 2147483648;
        m.set(x % 1000003, i);
        i += 1;
    }
    var sum = 0;
    i = 0;
    while (i < 400000) {
        sum += m.getOr(i * 2, 1);
        i += 1;
    }
    println(f"{m.length()} {sum}");
    return 0;
}
