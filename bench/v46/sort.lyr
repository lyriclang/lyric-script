// B5 sort: 50 000 ints from an LCG sorted by their natural order with std.collections' merge
// sort, then a checksum over the order. The same algorithm as ../src/sort.lyrs.
import std.io.console { println };
import std.collections { List, sortList };

fn main(): int {
    var x = 12345;
    let xs = List<int>.empty();
    var i = 0;
    while (i < 50000) {
        x = (x * 1103515245 + 12345) % 2147483648;
        xs.push(x % 1000000);
        i += 1;
    }
    sortList<int>(xs);
    var check = 0;
    i = 0;
    while (i < xs.length()) {
        check = (check * 31 + xs.get(i)) % 1000000007;
        i += 1;
    }
    println(check);
    return 0;
}
