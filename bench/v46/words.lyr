// B4 words: a text of 100 000 words from a vocabulary of 5000 (an LCG picks them), built in a
// StringBuilder, split at the spaces and counted in a Map<string, int>.
// The same algorithm as ../src/words.lyrs.
import std.io.console { println };
import std.string { StringBuilder, fromInt };
import std.collections { Map };

fn main(): int {
    var x = 12345;
    let text = StringBuilder.new();
    var i = 0;
    while (i < 100000) {
        x = (x * 1103515245 + 12345) % 2147483648;
        if (i > 0) {
            text.append(" ");
        }
        text.append("w");
        text.append(fromInt(x / 65536 % 5000));
        i += 1;
    }
    let counts = Map<string, int>.empty();
    var most = 0;
    for (w in text.build().split(" ")) {
        let c = counts.getOr(w, 0) + 1;
        counts.set(w, c);
        if (c > most) {
            most = c;
        }
    }
    println(f"{counts.length()} {most}");
    return 0;
}
