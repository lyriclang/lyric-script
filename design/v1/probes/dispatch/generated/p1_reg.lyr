import std.io { println };
import std.os { args };

@Layout(C)
struct Instr { op: uint8, a: uint16, b: uint16, c: uint16 }

fn mk(op: int, a: int, b: int, c: int): Instr {
    return Instr { op = op as uint8, a = a as uint16, b = b as uint16, c = c as uint16 };
}

fn run(code: Instr[], regs: uint64[], consts: uint64[], mem: uint64[], frames: int[]): int {
    var pc = 0;
    var fp = 0;
    var executed = 0;
    while (true) {
        let ins = code[pc];
        executed += 1;
        match (ins.op) {
            0 => { regs[ins.a] = regs[ins.b] +% regs[ins.c]; pc += 1; }  // ADD
            1 => { regs[ins.a] = regs[ins.b] -% regs[ins.c]; pc += 1; }  // SUB
            2 => { regs[ins.a] = regs[ins.b] *% regs[ins.c]; pc += 1; }  // MUL
            3 => { regs[ins.a] = regs[ins.b] ^ regs[ins.c]; pc += 1; }  // XOR
            4 => { regs[ins.a] = regs[ins.b] & regs[ins.c]; pc += 1; }  // AND
            5 => { regs[ins.a] = regs[ins.b] & (ins.c as uint64); pc += 1; }  // ANDI
            6 => { regs[ins.a] = regs[ins.b] +% (ins.c as uint64); pc += 1; }  // ADDI
            7 => { if (regs[ins.a] < regs[ins.b]) { pc = ins.c as int; } else { pc += 1; } }  // JLT
            8 => { return executed; }  // HALT
            9 => { pc += 1; }  // NOP
            10 => { regs[ins.a] = regs[ins.b]; pc += 1; }  // MOV
            11 => { regs[ins.a] = (ins.b as uint64) | ((ins.c as uint64) << 16); pc += 1; }  // LOADI
            12 => { regs[ins.a] = consts[ins.b]; pc += 1; }  // LOADK
            13 => { regs[ins.a] = regs[ins.b] / regs[ins.c]; pc += 1; }  // DIV
            14 => { regs[ins.a] = regs[ins.b] % regs[ins.c]; pc += 1; }  // MOD
            15 => { regs[ins.a] = regs[ins.b] | regs[ins.c]; pc += 1; }  // OR
            16 => { regs[ins.a] = regs[ins.b] << (regs[ins.c] & 63); pc += 1; }  // SHL
            17 => { regs[ins.a] = regs[ins.b] >> (regs[ins.c] & 63); pc += 1; }  // SHR
            18 => { regs[ins.a] = (0 as uint64) -% regs[ins.b]; pc += 1; }  // NEG
            19 => { regs[ins.a] = ~regs[ins.b]; pc += 1; }  // NOT
            20 => { regs[ins.a] = regs[ins.b] -% (ins.c as uint64); pc += 1; }  // SUBI
            21 => { regs[ins.a] = regs[ins.b] *% (ins.c as uint64); pc += 1; }  // MULI
            22 => { regs[ins.a] = regs[ins.b] | (ins.c as uint64); pc += 1; }  // ORI
            23 => { regs[ins.a] = regs[ins.b] ^ (ins.c as uint64); pc += 1; }  // XORI
            24 => { regs[ins.a] = regs[ins.b] << (ins.c & 63); pc += 1; }  // SHLI
            25 => { regs[ins.a] = regs[ins.b] >> (ins.c & 63); pc += 1; }  // SHRI
            26 => { if (regs[ins.b] == regs[ins.c]) { regs[ins.a] = 1; } else { regs[ins.a] = 0; } pc += 1; }  // EQ
            27 => { if (regs[ins.b] != regs[ins.c]) { regs[ins.a] = 1; } else { regs[ins.a] = 0; } pc += 1; }  // NE
            28 => { if (regs[ins.b] < regs[ins.c]) { regs[ins.a] = 1; } else { regs[ins.a] = 0; } pc += 1; }  // LT
            29 => { if (regs[ins.b] <= regs[ins.c]) { regs[ins.a] = 1; } else { regs[ins.a] = 0; } pc += 1; }  // LE
            30 => { if (regs[ins.b] > regs[ins.c]) { regs[ins.a] = 1; } else { regs[ins.a] = 0; } pc += 1; }  // GT
            31 => { if (regs[ins.b] >= regs[ins.c]) { regs[ins.a] = 1; } else { regs[ins.a] = 0; } pc += 1; }  // GE
            32 => { pc = ins.c as int; }  // JMP
            33 => { if (regs[ins.a] == 0) { pc = ins.c as int; } else { pc += 1; } }  // JZ
            34 => { if (regs[ins.a] != 0) { pc = ins.c as int; } else { pc += 1; } }  // JNZ
            35 => { if (regs[ins.a] == regs[ins.b]) { pc = ins.c as int; } else { pc += 1; } }  // JEQ
            36 => { if (regs[ins.a] != regs[ins.b]) { pc = ins.c as int; } else { pc += 1; } }  // JNE
            37 => { if (regs[ins.a] <= regs[ins.b]) { pc = ins.c as int; } else { pc += 1; } }  // JLE
            38 => { if (regs[ins.a] >= regs[ins.b]) { pc = ins.c as int; } else { pc += 1; } }  // JGE
            39 => { regs[ins.a] = regs[ins.a] +% 1; pc += 1; }  // INC
            40 => { regs[ins.a] = regs[ins.a] -% 1; pc += 1; }  // DEC
            41 => { if (regs[ins.b] < regs[ins.c]) { regs[ins.a] = regs[ins.b]; } else { regs[ins.a] = regs[ins.c]; } pc += 1; }  // MIN
            42 => { if (regs[ins.b] > regs[ins.c]) { regs[ins.a] = regs[ins.b]; } else { regs[ins.a] = regs[ins.c]; } pc += 1; }  // MAX
            43 => { regs[ins.a] = mem[(regs[ins.b] +% (ins.c as uint64)) as int]; pc += 1; }  // LOADM
            44 => { mem[(regs[ins.b] +% (ins.c as uint64)) as int] = regs[ins.a]; pc += 1; }  // STOREM
            45 => { frames[fp] = pc + 1; fp += 1; pc = ins.c as int; }  // CALL
            46 => { fp -= 1; pc = frames[fp]; }  // RET
            47 => { if (regs[ins.c] != 0) { regs[ins.a] = regs[ins.b]; } pc += 1; }  // CMOV
            _ => { panic("bad opcode"); }
        }
    }
}

fn main(): int {
    let argv = args();
    var n = 100000000;
    if (argv.length() > 1) {
        n = (try? int.parse(argv[1])) ?? n;
    }
