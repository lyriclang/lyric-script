    let consts: uint64[] = [n as uint64, 0x9E3779B9, 0x3FFFFFFFFFFFFFFF];
    let mem: uint64[] = [0u64] * 1024;
    let frames: int[] = [0] * 256;
    let executed = run(code, regs, consts, mem, frames);
    println(f"acc={regs[2]} executed={executed}");
    return 0;
}
