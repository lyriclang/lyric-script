}

fn main(): int {
    let argv = args();
    var n = 100000000;
    if (argv.length() > 1) {
        n = (try? int.parse(argv[1])) ?? n;
    }
    let code: Instr[] = [
        mk(11, 0, 0, 0),  //  0 LOADI r0 = 0            (i)
        mk(12, 1, 0, 0),  //  1 LOADK r1 = K0           (n)
        mk(11, 2, 0, 0),  //  2 LOADI r2 = 0            (acc)
        mk(12, 3, 1, 0),  //  3 LOADK r3 = K1           (k)
        mk(12, 6, 2, 0),  //  4 LOADK r6 = K2           (mask)
        mk(2, 4, 0, 0),  //  5 MUL   r4 = r0 *% r0     -- loop @5
        mk(3, 4, 4, 3),  //  6 XOR   r4 = r4 ^ r3
        mk(0, 2, 2, 4),  //  7 ADD   r2 = r2 +% r4
