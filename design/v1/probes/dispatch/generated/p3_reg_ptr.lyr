import std.io { println };
import std.os { args };
import std.ffi;

@Layout(C)
struct Instr { op: uint8, a: uint16, b: uint16, c: uint16 }

fn mk(op: int, a: int, b: int, c: int): Instr {
    return Instr { op = op as uint8, a = a as uint16, b = b as uint16, c = c as uint16 };
}

fn run(code: Instr[], regs: uint64[], consts: uint64[], mem: uint64[], frames: int[]): int {
    var pc = 0;
    var fp = 0;
    var executed = 0;
    let cp = code.asPtr();
    let rp = regs.asPtr();
    unsafe {
        while (true) {
            let ins = cp.offset(pc).read();
            executed += 1;
            match (ins.op) {
                0 => { rp.offset(ins.a).write(rp.offset(ins.b).read() +% rp.offset(ins.c).read()); pc += 1; }  // ADD
                1 => { rp.offset(ins.a).write(rp.offset(ins.b).read() -% rp.offset(ins.c).read()); pc += 1; }  // SUB
                2 => { rp.offset(ins.a).write(rp.offset(ins.b).read() *% rp.offset(ins.c).read()); pc += 1; }  // MUL
                3 => { rp.offset(ins.a).write(rp.offset(ins.b).read() ^ rp.offset(ins.c).read()); pc += 1; }  // XOR
                4 => { rp.offset(ins.a).write(rp.offset(ins.b).read() & rp.offset(ins.c).read()); pc += 1; }  // AND
                5 => { rp.offset(ins.a).write(rp.offset(ins.b).read() & (ins.c as uint64)); pc += 1; }  // ANDI
                6 => { rp.offset(ins.a).write(rp.offset(ins.b).read() +% (ins.c as uint64)); pc += 1; }  // ADDI
                7 => { if (rp.offset(ins.a).read() < rp.offset(ins.b).read()) { pc = ins.c as int; } else { pc += 1; } }  // JLT
                8 => { return executed; }  // HALT
                9 => { pc += 1; }  // NOP
                10 => { rp.offset(ins.a).write(rp.offset(ins.b).read()); pc += 1; }  // MOV
                11 => { rp.offset(ins.a).write((ins.b as uint64) | ((ins.c as uint64) << 16)); pc += 1; }  // LOADI
                12 => { rp.offset(ins.a).write(consts[ins.b]); pc += 1; }  // LOADK
                13 => { rp.offset(ins.a).write(rp.offset(ins.b).read() / rp.offset(ins.c).read()); pc += 1; }  // DIV
                14 => { rp.offset(ins.a).write(rp.offset(ins.b).read() % rp.offset(ins.c).read()); pc += 1; }  // MOD
                15 => { rp.offset(ins.a).write(rp.offset(ins.b).read() | rp.offset(ins.c).read()); pc += 1; }  // OR
                16 => { rp.offset(ins.a).write(rp.offset(ins.b).read() << (rp.offset(ins.c).read() & 63)); pc += 1; }  // SHL
                17 => { rp.offset(ins.a).write(rp.offset(ins.b).read() >> (rp.offset(ins.c).read() & 63)); pc += 1; }  // SHR
                18 => { rp.offset(ins.a).write((0 as uint64) -% rp.offset(ins.b).read()); pc += 1; }  // NEG
                19 => { rp.offset(ins.a).write(~rp.offset(ins.b).read()); pc += 1; }  // NOT
                20 => { rp.offset(ins.a).write(rp.offset(ins.b).read() -% (ins.c as uint64)); pc += 1; }  // SUBI
                21 => { rp.offset(ins.a).write(rp.offset(ins.b).read() *% (ins.c as uint64)); pc += 1; }  // MULI
                22 => { rp.offset(ins.a).write(rp.offset(ins.b).read() | (ins.c as uint64)); pc += 1; }  // ORI
                23 => { rp.offset(ins.a).write(rp.offset(ins.b).read() ^ (ins.c as uint64)); pc += 1; }  // XORI
                24 => { rp.offset(ins.a).write(rp.offset(ins.b).read() << (ins.c & 63)); pc += 1; }  // SHLI
                25 => { rp.offset(ins.a).write(rp.offset(ins.b).read() >> (ins.c & 63)); pc += 1; }  // SHRI
                26 => { if (rp.offset(ins.b).read() == rp.offset(ins.c).read()) { rp.offset(ins.a).write(1); } else { rp.offset(ins.a).write(0); } pc += 1; }  // EQ
                27 => { if (rp.offset(ins.b).read() != rp.offset(ins.c).read()) { rp.offset(ins.a).write(1); } else { rp.offset(ins.a).write(0); } pc += 1; }  // NE
                28 => { if (rp.offset(ins.b).read() < rp.offset(ins.c).read()) { rp.offset(ins.a).write(1); } else { rp.offset(ins.a).write(0); } pc += 1; }  // LT
                29 => { if (rp.offset(ins.b).read() <= rp.offset(ins.c).read()) { rp.offset(ins.a).write(1); } else { rp.offset(ins.a).write(0); } pc += 1; }  // LE
                30 => { if (rp.offset(ins.b).read() > rp.offset(ins.c).read()) { rp.offset(ins.a).write(1); } else { rp.offset(ins.a).write(0); } pc += 1; }  // GT
                31 => { if (rp.offset(ins.b).read() >= rp.offset(ins.c).read()) { rp.offset(ins.a).write(1); } else { rp.offset(ins.a).write(0); } pc += 1; }  // GE
                32 => { pc = ins.c as int; }  // JMP
                33 => { if (rp.offset(ins.a).read() == 0) { pc = ins.c as int; } else { pc += 1; } }  // JZ
                34 => { if (rp.offset(ins.a).read() != 0) { pc = ins.c as int; } else { pc += 1; } }  // JNZ
                35 => { if (rp.offset(ins.a).read() == rp.offset(ins.b).read()) { pc = ins.c as int; } else { pc += 1; } }  // JEQ
                36 => { if (rp.offset(ins.a).read() != rp.offset(ins.b).read()) { pc = ins.c as int; } else { pc += 1; } }  // JNE
                37 => { if (rp.offset(ins.a).read() <= rp.offset(ins.b).read()) { pc = ins.c as int; } else { pc += 1; } }  // JLE
                38 => { if (rp.offset(ins.a).read() >= rp.offset(ins.b).read()) { pc = ins.c as int; } else { pc += 1; } }  // JGE
                39 => { rp.offset(ins.a).write(rp.offset(ins.a).read() +% 1); pc += 1; }  // INC
                40 => { rp.offset(ins.a).write(rp.offset(ins.a).read() -% 1); pc += 1; }  // DEC
                41 => { if (rp.offset(ins.b).read() < rp.offset(ins.c).read()) { rp.offset(ins.a).write(rp.offset(ins.b).read()); } else { rp.offset(ins.a).write(rp.offset(ins.c).read()); } pc += 1; }  // MIN
                42 => { if (rp.offset(ins.b).read() > rp.offset(ins.c).read()) { rp.offset(ins.a).write(rp.offset(ins.b).read()); } else { rp.offset(ins.a).write(rp.offset(ins.c).read()); } pc += 1; }  // MAX
                43 => { rp.offset(ins.a).write(mem[(rp.offset(ins.b).read() +% (ins.c as uint64)) as int]); pc += 1; }  // LOADM
                44 => { mem[(rp.offset(ins.b).read() +% (ins.c as uint64)) as int] = rp.offset(ins.a).read(); pc += 1; }  // STOREM
                45 => { frames[fp] = pc + 1; fp += 1; pc = ins.c as int; }  // CALL
                46 => { fp -= 1; pc = frames[fp]; }  // RET
                47 => { if (rp.offset(ins.c).read() != 0) { rp.offset(ins.a).write(rp.offset(ins.b).read()); } pc += 1; }  // CMOV
                _ => { panic("bad opcode"); }
