// GENERATED by gen.py — W1: the cost of a value's way into an interface value.
// Modes (argv[1]); each stores into slot i & 15 of an array, n times (argv[2]):
//   base    a class instance into a ScriptObject[]       (no interface: the baseline)
//   class   a class instance into a HeapRef[]            (class -> interface)
//   string  a string into a HeapRef[]                    (string -> interface, via extend string :: [HeapRef])
//   struct  a fresh Small { a, b } into a HeapRef[]      (struct -> interface)
//   int     the counter into a HeapRef[]                 (int -> interface, via extend int :: [HeapRef])
//   move    a ready interface value (a string's) into a HeapRef[]   (interface -> interface)
// Prints mode, n, ns (the loop, in-process), the allocations and bytes of the loop (the calling
// thread's counters), the collections and their pause total during it, and check = the sum of
// tag() over the 16 slots afterwards.
import std.io { println };
import std.os { args };
import std.core { arrayOf };
import std.time { Monotonic };

extern "C" fn lyr_gc_thread_allocations(): int;
extern "C" fn lyr_gc_thread_allocated_bytes(): int;
extern "C" fn lyr_gc_stat(which: int): int;

interface HeapRef {
    fn tag(): int;
}

class ScriptObject :: [HeapRef] {
    id: int,
    fn tag(): int { return this.id; }
}

extend string :: [HeapRef] {
    fn tag(): int { return this.length(); }
}

extend int :: [HeapRef] {
    fn tag(): int { return this; }
}

struct Small :: [HeapRef] {
    a: int,
    b: int,
    fn tag(): int { return this.a + this.b; }
}

@NoInline
fn loopBase(objs: ScriptObject[], pool: ScriptObject[], n: int): void {
    var i = 0;
    while (i < n) {
        objs[i & 15] = pool[i & 7];
        i += 1;
    }
}

@NoInline
fn loopClass(refs: HeapRef[], pool: ScriptObject[], n: int): void {
    var i = 0;
    while (i < n) {
        refs[i & 15] = pool[i & 7];
        i += 1;
    }
}

@NoInline
fn loopString(refs: HeapRef[], strs: string[], n: int): void {
    var i = 0;
    while (i < n) {
        refs[i & 15] = strs[i & 7];
        i += 1;
    }
}

@NoInline
fn loopStruct(refs: HeapRef[], n: int): void {
    var i = 0;
    while (i < n) {
        refs[i & 15] = Small { a = i, b = i };
        i += 1;
    }
}

@NoInline
fn loopInt(refs: HeapRef[], n: int): void {
    var i = 0;
    while (i < n) {
        refs[i & 15] = i;
        i += 1;
    }
}

@NoInline
fn loopMove(refs: HeapRef[], src: HeapRef[], n: int): void {
    var i = 0;
    while (i < n) {
        refs[i & 15] = src[i & 7];
        i += 1;
    }
}

fn asRef(s: string): HeapRef {
    return s;
}

fn main(): int {
    let argv = args();
    let mode = argv[1];
    var n = 10000000;
    if (argv.length() > 2) {
        n = (try? int.parse(argv[2])) ?? n;
    }
    let mkObj = (i: int) => ScriptObject { id = i };
    let pool: ScriptObject[] = arrayOf(8, mkObj);
    let objs: ScriptObject[] = arrayOf(16, (i: int) => pool[0]);
    let strs: string[] = ["a", "bb", "ccc", "dddd", "eeeee", "ffffff", "ggggggg", "hhhhhhhh"];
    let src: HeapRef[] = arrayOf(8, (i: int) => asRef(strs[i]));
    let first: HeapRef = pool[0];
    let refs: HeapRef[] = arrayOf(16, (i: int) => first);

    lyr_gc_stat(9);
    let a0 = lyr_gc_thread_allocations();
    let b0 = lyr_gc_thread_allocated_bytes();
    let t0 = Monotonic.now();
    if (mode == "base") {
        loopBase(objs, pool, n);
    } else if (mode == "class") {
        loopClass(refs, pool, n);
    } else if (mode == "string") {
        loopString(refs, strs, n);
    } else if (mode == "struct") {
        loopStruct(refs, n);
    } else if (mode == "int") {
        loopInt(refs, n);
    } else if (mode == "move") {
        loopMove(refs, src, n);
    } else {
        panic("unknown mode");
    }
    let ns = t0.elapsed().nanos();
    let a1 = lyr_gc_thread_allocations();
    let b1 = lyr_gc_thread_allocated_bytes();
    let gcs = lyr_gc_stat(0);
    let pause = lyr_gc_stat(3);

    var check = 0;
    var k = 0;
    while (k < 16) {
        if (mode == "base") { check += objs[k].tag(); } else { check += refs[k].tag(); }
        k += 1;
    }
    println(f"mode={mode} n={n} ns={ns} allocs={a1 - a0} bytes={b1 - b0} gcs={gcs} pause_ns={pause} check={check}");
    return 0;
}
