// A pipeline of tasks: a generator feeds numbers into a channel, three workers square them, and the
// top level collects the squares with a select that would give up after five seconds. The workers
// tell a semaphore when they are done; the last one closes the results.
fn numbers(n: int): Coroutine<int> {
    var i = 0
    while (i < n) {
        i += 1
        yield i
    }
}

let jobs = Channel<int>.new(4)
let results = Channel<int>.new(4)
let done = Semaphore.new(0)

spawn {
    for (k in numbers(10)) {
        jobs.send(k)
    }
    jobs.close()
}
for (w in 1..=3) {
    spawn {
        while (let k = jobs.recv()) {
            results.send(k * k)
        }
        done.release()
    }
}
spawn {
    for (w in 1..=3) {
        done.acquire()
    }
    results.close()
}

var sum = 0
var count = 0
var open = true
while (open) {
    Select.on(results) { v =>
        if (let x = v) {
            sum += x
            count += 1
        } else {
            open = false
        }
    }
        .timeout(Duration.ofSecs(5)) {
            println("timed out")
            open = false
        }
        .run()
}
println(f"{count} squares, sum {sum}")
