//! The C ABI of Lyric-Script (design/v1, 11 Emb b; S8h1): `liblyric_script` and its header
//! `lyric_script.h`, built with `lyric5 build --lib`. A host of C's — or of any language that
//! calls C — makes a VM, loads scripts into instances and calls them with values, as a host of
//! Lyric 5's does with `lyric_script.embed`.
//!
//! What C holds is a number, `int64_t`, never an address: a VM, an instance, a value or a call's
//! result, in a table of the process until `lyrs_release` lets it go. 0 is never one. A number
//! of another kind, released or never given is the host's mistake, a status, not a crash.
//! Every export throws: C gets `LYR_OK`, `LYR_ERROR` — the error's type and message from
//! `lyr_take_error` — or `LYR_PANIC`, and the process goes on. `lyr_init` runs first.
import std.collections { List, Map };
import std.ffi { CStr, Ptr };
import std.sync { Atomic, Mutex };
import std.time { Duration };
import lyric_script.embed { Vm, vmOf };
import lyric_script.vm.interp { Budget as VmBudget, CallResult, Instance, Step };
import lyric_script.vm.value { MapValue, StructValue, Value };

/// The version of the C ABI (`lyrs_abi_version`): it changes with every incompatible change of an
/// export.
pub let abiLevel: int = 1;

/// A call's budget as C gives it (01 S5, S6): fuel units, a deadline in nanoseconds and the bytes
/// the call may allocate; -1 for no limit.
@Layout(C)
pub struct Budget {
    pub fuel: int,
    pub deadlineNs: int,
    pub alloc: int,
}

/// A mistake of C's at the ABI: a number of another kind, one released or never given, a value
/// read as what it is not, text that is no UTF-8.
pub struct AbiMisuse :: [Error] {
    reason: string,

    pub fn message(): string {
        return this.reason;
    }
}

/// What a number of C's stands for.
enum Held {
    Machine(Vm),
    Inst(Instance),
    Val(Value),
    Res(CallResult),
}

// the numbers C holds, each what it stands for, and the last number given
let held: Mutex<Map<int, Held>> = Mutex<Map<int, Held>>.new(Map<int, Held>.new());

let lastNumber: Atomic<int> = Atomic<int>.new(0);

// a new number for `h`
fn hold(h: Held): int throws Error {
    let n = lastNumber.addAndFetch(1);
    try held.lock { &m => m[n] = h; };
    return n;
}

// what the number `n` stands for
fn heldAt(n: int): Held throws Error {
    let found = try held.lock { &m => m[n] };
    if (let h = found) {
        return h;
    }
    throw AbiMisuse { reason = f"{n} is no number of the ABI's: never given, or released" };
}

fn vmAt(n: int): Vm throws Error {
    return match (try heldAt(n)) {
        .Machine(vm) => vm,
        _ => throw AbiMisuse { reason = f"{n} is no VM" },
    };
}

fn instanceAt(n: int): Instance throws Error {
    return match (try heldAt(n)) {
        .Inst(inst) => inst,
        _ => throw AbiMisuse { reason = f"{n} is no instance" },
    };
}

fn valueAt(n: int): Value throws Error {
    return match (try heldAt(n)) {
        .Val(v) => v,
        _ => throw AbiMisuse { reason = f"{n} is no value" },
    };
}

fn resultAt(n: int): CallResult throws Error {
    return match (try heldAt(n)) {
        .Res(r) => r,
        _ => throw AbiMisuse { reason = f"{n} is no call's result" },
    };
}

// the values whose numbers lie at `p`, `count` of them
fn valuesAt(p: ?Ptr<int>, count: int): Value[] throws Error {
    let out = List<Value>.new();
    if (count > 0) {
        if (let q = p) {
            var k = 0;
            while (k < count) {
                out.push(try valueAt(wordAt(q, k)));
                k += 1;
            }
        } else {
            throw AbiMisuse { reason = f"{count} values at a null pointer" };
        }
    }
    return out.toArray();
}

fn wordAt(p: Ptr<int>, k: int): int {
    unsafe {
        return p.offset(k).read();
    }
}

fn cstrAt(p: Ptr<CStr>, k: int): CStr {
    unsafe {
        return p.offset(k).read();
    }
}

fn byteAt(p: Ptr<uint8>, k: int): uint8 {
    unsafe {
        return p.offset(k).read();
    }
}

// the text C gave, which must be UTF-8
fn textOf(c: CStr): string throws Error {
    return try c.toString() catch (_) {
        throw AbiMisuse { reason = "text that is no UTF-8" };
    };
}

// the `count` bytes at `p` as text
fn bytesText(p: ?Ptr<uint8>, count: int): string throws Error {
    if (count <= 0) {
        return "";
    }
    if (let q = p) {
        let bytes = [0u8] * count;
        var k = 0;
        while (k < count) {
            bytes[k] = byteAt(q, k);
            k += 1;
        }
        return try string.fromUtf8(bytes[..]) catch (_) {
            throw AbiMisuse { reason = "text that is no UTF-8" };
        };
    }
    throw AbiMisuse { reason = f"{count} bytes at a null pointer" };
}

// copies `text` into C's buffer, as much as `capacity` takes; its whole length in bytes
fn copyOut(text: string, buffer: ?Ptr<uint8>, capacity: int): int {
    let bytes = text.toBytes();
    if (let b = buffer) {
        var k = 0;
        while (k < bytes.length() && k < capacity) {
            unsafe {
                b.offset(k).write(bytes[k]);
            }
            k += 1;
        }
    }
    return bytes.length();
}

fn budgetOf(b: Budget): VmBudget {
    return VmBudget {
        fuel = if (b.fuel < 0) -1 else b.fuel,
        deadline = if (b.deadlineNs < 0) null else Duration.ofNanos(b.deadlineNs),
        alloc = if (b.alloc < 0) -1 else b.alloc,
    };
}

/// A new VM; `cacheDir` where it keeps compiled scripts, NULL for none.
@Export("lyrs_vm_new")
pub fn vmNew(cacheDir: ?CStr): int throws Error {
    var dir: ?string = null;
    if (let c = cacheDir) {
        dir = try textOf(c);
    }
    return try hold(Held.Machine(vmOf(dir)));
}

/// Registers the module `host.<name>` of the VM `vm` (S8f2): its declarations in `source`.
@Export("lyrs_vm_host")
pub fn vmHost(vm: int, name: CStr, source: CStr): void throws Error {
    try (vmAt(vm)).host(textOf(name), textOf(source));
}

/// An instance of the script `source` named `name`, with the `count` rights at `allow` — or every
/// right with `all` —, and with `seed` where `seeded`; its top level not run yet.
@Export("lyrs_vm_load")
pub fn vmLoad(
    vm: int,
    name: CStr,
    source: CStr,
    allow: ?Ptr<CStr>,
    count: int,
    all: bool,
    seeded: bool,
    seed: int
): int throws Error {
    let rights = List<string>.new();
    if (count > 0) {
        if (let p = allow) {
            var k = 0;
            while (k < count) {
                rights.push(try textOf(cstrAt(p, k)));
                k += 1;
            }
        } else {
            throw AbiMisuse { reason = f"{count} rights at a null pointer" };
        }
    }
    let machine = try vmAt(vm);
    let inst = try machine.load(
        textOf(name),
        textOf(source),
        rights.toArray(),
        all,
        if (seeded) seed else null
    );
    return try hold(Held.Inst(inst));
}

/// Runs the instance's top level within `budget`; the number of its result.
@Export("lyrs_instance_init")
pub fn instanceInit(inst: int, budget: Budget): int throws Error {
    return try hold(Held.Res((instanceAt(inst)).init(budgetOf(budget))));
}

/// Calls the function `name` with the `count` values at `args` within `budget`; the number of
/// its result.
@Export("lyrs_instance_call")
pub fn instanceCall(
    inst: int,
    name: CStr,
    args: ?Ptr<int>,
    count: int,
    budget: Budget
): int throws Error {
    let i = try instanceAt(inst);
    let r = try i.call(textOf(name), valuesAt(args, count), budgetOf(budget));
    return try hold(Held.Res(r));
}

/// Starts a call as `lyrs_instance_call` does, without waiting: the number of its result, or 0
/// where it waits and takes `lyrs_instance_step`.
@Export("lyrs_instance_start")
pub fn instanceStart(
    inst: int,
    name: CStr,
    args: ?Ptr<int>,
    count: int,
    budget: Budget
): int throws Error {
    let i = try instanceAt(inst);
    return try stepped(i.start(textOf(name), valuesAt(args, count), budgetOf(budget)));
}

/// Goes on with a started call without waiting; a halted one with `budget` where `renewed`. The
/// number of its result, or 0 where it waits.
@Export("lyrs_instance_step")
pub fn instanceStep(inst: int, renewed: bool, budget: Budget): int throws Error {
    let i = try instanceAt(inst);
    let b: ?VmBudget = if (renewed) budgetOf(budget) else null;
    return try stepped(i.step(b));
}

fn stepped(s: Step): int throws Error {
    return match (s) {
        .Waiting => 0,
        .Done(r) => try hold(Held.Res(r)),
    };
}

/// Goes on with the call the budget halted, within `budget`; the number of its result.
@Export("lyrs_instance_resume")
pub fn instanceResume(inst: int, budget: Budget): int throws Error {
    return try hold(Held.Res((instanceAt(inst)).resume(budgetOf(budget))));
}

/// Ends the instance at once (01 S5b); the number of its result.
@Export("lyrs_instance_abort")
pub fn instanceAbort(inst: int): int throws Error {
    return try hold(Held.Res((instanceAt(inst)).abort()));
}

/// Whether the instance may go to another thread (11 Thr).
@Export("lyrs_instance_resting")
pub fn instanceResting(inst: int): bool throws Error {
    return (try instanceAt(inst)).resting();
}

/// What the instance takes next: 0 fresh, 1 ready, 2 started, 3 running, 4 suspended, 5 ended,
/// 6 broken.
@Export("lyrs_instance_phase")
pub fn instancePhase(inst: int): int throws Error {
    return match ((try instanceAt(inst)).phase()) {
        .Fresh => 0,
        .Ready => 1,
        .Started => 2,
        .Running => 3,
        .Suspended => 4,
        .Ended => 5,
        .Broken => 6,
    };
}

/// Lets the number `n` go: what it stood for is the collector's once nothing else holds it. An
/// instance it stood for is closed.
@Export("lyrs_release")
pub fn release(n: int): void throws Error {
    let gone = try held.lock { &m => m.remove(n) };
    match (gone) {
        null => throw AbiMisuse {
            reason = f"{n} is no number of the ABI's: never given, or released",
        },
        _ => { }
    }
}

// the values (S8a3) — numbers too

@Export("lyrs_void")
pub fn valueVoid(): int throws Error {
    return try hold(Held.Val(Value.Void));
}

@Export("lyrs_int")
pub fn valueInt(v: int): int throws Error {
    return try hold(Held.Val(Value.Int(v)));
}

@Export("lyrs_float")
pub fn valueFloat(v: float): int throws Error {
    return try hold(Held.Val(Value.Float(v)));
}

@Export("lyrs_bool")
pub fn valueBool(v: bool): int throws Error {
    return try hold(Held.Val(Value.Bool(v)));
}

@Export("lyrs_char")
pub fn valueChar(v: char): int throws Error {
    return try hold(Held.Val(Value.Char(v)));
}

/// A string of the `count` UTF-8 bytes at `text`; a NUL among them is one of its characters.
@Export("lyrs_str")
pub fn valueStr(text: ?Ptr<uint8>, count: int): int throws Error {
    return try hold(Held.Val(Value.Str(bytesText(text, count))));
}

/// A list of the `count` values at `items`.
@Export("lyrs_list")
pub fn valueList(items: ?Ptr<int>, count: int): int throws Error {
    return try hold(Held.Val(Value.List(valuesAt(items, count))));
}

/// A map of the `count` keys at `keys`, each to the value at the same place of `values`.
@Export("lyrs_map")
pub fn valueMap(keys: ?Ptr<int>, values: ?Ptr<int>, count: int): int throws Error {
    let m = MapValue { keys = try valuesAt(keys, count), values = try valuesAt(values, count) };
    return try hold(Held.Val(Value.Map(m)));
}

/// A struct of the host's type `type` (S8f3b) of the `count` fields at `fields`, in its order.
@Export("lyrs_struct")
pub fn valueStruct(type: CStr, fields: ?Ptr<int>, count: int): int throws Error {
    let s = StructValue { type = try textOf(type), fields = try valuesAt(fields, count) };
    return try hold(Held.Val(Value.Struct(s)));
}

/// What the value is: 0 void, 1 int, 2 float, 3 bool, 4 char, 5 string, 6 list, 7 map, 8 struct,
/// 9 handle, 10 callback.
@Export("lyrs_value_kind")
pub fn valueKind(v: int): int throws Error {
    return match (try valueAt(v)) {
        .Void => 0,
        .Int(_) => 1,
        .Float(_) => 2,
        .Bool(_) => 3,
        .Char(_) => 4,
        .Str(_) => 5,
        .List(_) => 6,
        .Map(_) => 7,
        .Struct(_) => 8,
        .Handle(_) => 9,
        .Callback(_) => 10,
    };
}

@Export("lyrs_value_int")
pub fn valueAsInt(v: int): int throws Error {
    return match (try valueAt(v)) {
        .Int(i) => i,
        _ => throw AbiMisuse { reason = f"{v} is no int" },
    };
}

@Export("lyrs_value_float")
pub fn valueAsFloat(v: int): float throws Error {
    return match (try valueAt(v)) {
        .Float(f) => f,
        _ => throw AbiMisuse { reason = f"{v} is no float" },
    };
}

@Export("lyrs_value_bool")
pub fn valueAsBool(v: int): bool throws Error {
    return match (try valueAt(v)) {
        .Bool(b) => b,
        _ => throw AbiMisuse { reason = f"{v} is no bool" },
    };
}

@Export("lyrs_value_char")
pub fn valueAsChar(v: int): char throws Error {
    return match (try valueAt(v)) {
        .Char(c) => c,
        _ => throw AbiMisuse { reason = f"{v} is no char" },
    };
}

/// Copies a string's UTF-8 bytes, or a struct's type, into `buffer`, at most `capacity`; their
/// whole length — NULL measures.
@Export("lyrs_value_text")
pub fn valueText(v: int, buffer: ?Ptr<uint8>, capacity: int): int throws Error {
    return match (try valueAt(v)) {
        .Str(s) => copyOut(s, buffer, capacity),
        .Struct(s) => copyOut(s.type, buffer, capacity),
        _ => throw AbiMisuse { reason = f"{v} is no string and no struct" },
    };
}

/// How many elements a list has, entries a map, fields a struct.
@Export("lyrs_value_length")
pub fn valueLength(v: int): int throws Error {
    return match (try valueAt(v)) {
        .List(xs) => xs.length(),
        .Map(m) => m.keys.length(),
        .Struct(s) => s.fields.length(),
        _ => throw AbiMisuse { reason = f"{v} is no list, map or struct" },
    };
}

/// The element `k` of a list, the value of a map's entry `k`, a struct's field `k`: a new number.
@Export("lyrs_value_item")
pub fn valueItem(v: int, k: int): int throws Error {
    let xs = match (try valueAt(v)) {
        .List(xs) => xs,
        .Map(m) => m.values,
        .Struct(s) => s.fields,
        _ => throw AbiMisuse { reason = f"{v} is no list, map or struct" },
    };
    if (k < 0 || k >= xs.length()) {
        throw AbiMisuse { reason = f"{k} is outside the {xs.length()} items of {v}" };
    }
    return try hold(Held.Val(xs[k]));
}

/// The key of a map's entry `k`: a new number.
@Export("lyrs_value_key")
pub fn valueKey(v: int, k: int): int throws Error {
    let m = match (try valueAt(v)) {
        .Map(m) => m,
        _ => throw AbiMisuse { reason = f"{v} is no map" },
    };
    if (k < 0 || k >= m.keys.length()) {
        throw AbiMisuse { reason = f"{k} is outside the {m.keys.length()} entries of {v}" };
    }
    return try hold(Held.Val(m.keys[k]));
}

/// How a call ended: 0 a value, 1 an error of the script, 2 a panic, 3 halted by its budget,
/// 4 aborted, 5 stale, 6 the script's exit.
@Export("lyrs_result_kind")
pub fn resultKind(r: int): int throws Error {
    return match (try resultAt(r)) {
        .Ok(_) => 0,
        .Error(_) => 1,
        .Panic(_) => 2,
        .Suspended => 3,
        .Aborted => 4,
        .Stale => 5,
        .Exit(_) => 6,
    };
}

/// The value a call gave: a new number.
@Export("lyrs_result_value")
pub fn resultValue(r: int): int throws Error {
    return match (try resultAt(r)) {
        .Ok(v) => try hold(Held.Val(v)),
        _ => throw AbiMisuse { reason = f"{r} gave no value" },
    };
}

/// The code of a panic, the type of an error: copied as `lyrs_value_text` copies.
@Export("lyrs_result_code")
pub fn resultCode(r: int, buffer: ?Ptr<uint8>, capacity: int): int throws Error {
    return match (try resultAt(r)) {
        .Error(e) => copyOut(e.typeName, buffer, capacity),
        .Panic(p) => copyOut(p.code, buffer, capacity),
        _ => throw AbiMisuse { reason = f"{r} is no error and no panic" },
    };
}

/// The message of a panic or an error: copied as `lyrs_value_text` copies.
@Export("lyrs_result_message")
pub fn resultMessage(r: int, buffer: ?Ptr<uint8>, capacity: int): int throws Error {
    return match (try resultAt(r)) {
        .Error(e) => copyOut(e.message, buffer, capacity),
        .Panic(p) => copyOut(p.message, buffer, capacity),
        _ => throw AbiMisuse { reason = f"{r} is no error and no panic" },
    };
}

/// The code the script's `exit` gave.
@Export("lyrs_result_exit")
pub fn resultExit(r: int): int throws Error {
    return match (try resultAt(r)) {
        .Exit(code) => code,
        _ => throw AbiMisuse { reason = f"{r} is no exit" },
    };
}
