//! The `lyric-script` command line (design/v1, 12): `run` — also `lyric-script script.lyrs` —,
//! `check`, `--version`, `help`, and, until the debugging tools come, `asm`, which runs bytecode in
//! its text form.
import std.collections { List };
import std.fs { readText };
import std.io { eprintln, println };
import std.os { args };
import std.path { join, parent, stem };
import lyric_script { version };
import lyric_script.cache { clean, load, store };
import lyric_script.compiler.diagnostic { Diagnostic };
import lyric_script.compiler.checker { ProgramUnit, checkModule };
import lyric_script.compiler.codegen { generate, scriptEntry };
import lyric_script.compiler.parser { Parsed, parse };
import lyric_script.compiler.render { SourceLines, renderJson, renderSummary, renderText };
import lyric_script.vm { bytecodeFormat };
import lyric_script.vm.asm { AsmError, assemble };
import lyric_script.vm.heap { ScriptString };
import lyric_script.vm.interp { Outcome, execute };
import lyric_script.vm.module { Module, check };

fn usage(): void {
    println("usage: lyric-script <command> | lyric-script SCRIPT.lyrs");
    println("");
    println("commands:");
    println("  run FILE   run a script (also: lyric-script FILE.lyrs)");
    println("  check FILE check a script without running it");
    println("  clean      empty the bytecode cache");
    println("");
    println("options of run and check:");
    println("  --json     the diagnostics as JSON lines on standard output");
    println("  version    print the version (also --version)");
    println("  help       print this text (also --help)");
    println("  asm FILE   run a .lyrsasm file's 'main' (bytecode in its text form)");
}

fn main(): int {
    let given = args();
    if (given.length() < 2) {
        usage();
        return 0;
    }
    let command = given[1];
    if (command == "--version" || command == "version") {
        println(f"lyric-script {version} (bytecode format {bytecodeFormat})");
        return 0;
    }
    if (command == "--help" || command == "help") {
        usage();
        return 0;
    }
    if (command == "clean" && given.length() == 2) {
        let dir = clean();
        if (dir != null) {
            println(f"emptied {dir}");
        }
        return 0;
    }
    if (command == "run" || command == "check" || command == "asm") {
        let o = options(given, 2, null);
        if (o.fault != 0) {
            return o.fault;
        }
        let file = o.file;
        if (file == null || (command == "asm" && o.json)) {
            let example = if (command == "asm") "program.lyrsasm" else "script.lyrs";
            eprintln(f"error[LYS-CLI0002]: '{command}' takes one file");
            eprintln(f"  = help: lyric-script {command} {example}");
            return 2;
        }
        return match (command) {
            "run" => runScript(file, o.json),
            "check" => checkScript(file, o.json),
            _ => runAsm(file),
        };
    }
    // `lyric-script script.lyrs` runs it (12 CLI)
    if (command.endsWith(".lyrs")) {
        let o = options(given, 2, command);
        if (o.fault != 0) {
            return o.fault;
        }
        return runScript(command, o.json);
    }
    eprintln(f"error[LYS-CLI0001]: unknown command '{command}'");
    eprintln("  = help: lyric-script help lists the commands");
    return 2;
}

/// What follows a command: its one file and its options.
struct Options {
    file: ?string,
    json: bool,
    // the exit code of a fault in them, reported already; 0 for none
    fault: int,
}

fn options(given: string[], from: int, file: ?string): Options {
    var found = file;
    var json = false;
    var k = from;
    while (k < given.length()) {
        let a = given[k];
        if (a == "--json") {
            json = true;
        } else if (a.startsWith("-")) {
            eprintln(f"error[LYS-CLI0004]: unknown option '{a}'");
            eprintln("  = help: lyric-script help lists the options");
            return Options { file = null, json = json, fault = 2 };
        } else if (found == null) {
            found = a;
        } else {
            eprintln(f"error[LYS-CLI0002]: one file, not '{found}' and '{a}'");
            return Options { file = null, json = json, fault = 2 };
        }
        k += 1;
    }
    return Options { file = found, json = json, fault = 0 };
}

fn readScript(path: string): ?string {
    return try readText(path) catch (e) {
        eprintln(f"error[LYS-CLI0003]: cannot read '{path}': {e.message()}");
        return null;
    };
}

/// Checks a script: 1 where it has errors, 0 where it has none; warnings are printed either way.
fn checkScript(path: string, json: bool): int {
    let text = readScript(path);
    if (text == null) {
        return 2;
    }
    return if (compile(loadProgram(path, text), json).module != null) 0 else 1;
}

/// A program as read (S5a): each file's path, text, parse and module name, in the order they were
/// found — 0 the entry —; the order their imports need, each module after those it imports; what
/// the reading found wrong.
class Loaded {
    paths: List<string>,
    texts: List<string>,
    names: List<string>,
    parses: List<Parsed>,
    order: List<int>,
    errors: List<Diagnostic>,

    /// The text the cache keys the program by: the entry's alone where it is the one file, else
    /// every file's module name and text.
    fn cacheText(): string {
        if (this.texts.length() == 1) {
            return this.texts[0];
        }
        let parts = List<string>.new();
        var k = 0;
        while (k < this.texts.length()) {
            parts.push(this.names[k]);
            parts.push(this.texts[k]);
            k += 1;
        }
        return parts.toArray().join("\u{0}");
    }
}

/// Reads the program whose entry is `path`, its text `text`: every module an import reaches,
/// `import a.b` the file `a/b.lyrs` below the entry's folder (07 Path).
fn loadProgram(path: string, text: string): Loaded {
    let folder = parent(path);
    let l = Loaded {
        paths = List<string>.new(),
        texts = List<string>.new(),
        names = List<string>.new(),
        parses = List<Parsed>.new(),
        order = List<int>.new(),
        errors = List<Diagnostic>.new(),
    };
    l.paths.push(path);
    l.texts.push(text);
    l.names.push(stem(path));
    // each module's imports: the module, and the import's place for a cycle through it
    let edges = List<List<int>>.new();
    let edgeAt = List<List<Diagnostic>>.new();
    var i = 0;
    while (i < l.paths.length()) {
        let parsed = parse(l.texts[i], i);
        l.parses.push(parsed);
        let deps = List<int>.new();
        let at = List<Diagnostic>.new();
        for (item in parsed.module.items) {
            let im = match (item) {
                .Decl(.Import(im)) => im,
                _ => {
                    continue;
                }
            };
            let name = im.path.join(".");
            let where = Diagnostic {
                code = "LYS-RES0003",
                message = "",
                start = im.span.start,
                end = im.span.end,
                line = im.span.line,
                column = im.span.column,
                help = null,
                file = i,
            };
            var j = indexOf(l.names, name);
            if (j < 0) {
                let rel = im.path.join("/") + ".lyrs";
                let file = if (folder == ".") rel else join(folder, rel);
                let found = try? readText(file);
                if (found == null) {
                    l.errors.push(
                        where with {
                            message = f"no module '{name}': there is no file '{rel}' beside the entry",
                        }
                    );
                    continue;
                }
                j = l.paths.length();
                l.paths.push(file);
                l.texts.push(found);
                l.names.push(name);
            }
            deps.push(j);
            at.push(where);
        }
        edges.push(deps);
        edgeAt.push(at);
        i += 1;
    }
    let state = List<int>.new();
    for (_ in l.paths) {
        state.push(0);
    }
    visit(0, edges, edgeAt, state, List<int>.new(), l);
    return l;
}

/// Depth first from module `k`: its imports first, then it; `stack` the modules on the way, which
/// an import of one of them closes to a cycle (LYS-RES0005). `state`: 0 not seen, 1 on the way,
/// 2 placed.
fn visit(
    k: int,
    edges: List<List<int>>,
    edgeAt: List<List<Diagnostic>>,
    state: List<int>,
    stack: List<int>,
    l: Loaded
): void {
    state[k] = 1;
    stack.push(k);
    var e = 0;
    while (e < edges[k].length()) {
        let j = edges[k][e];
        if (state[j] == 1) {
            let names = List<string>.new();
            var n = 0;
            while (stack[n] != j) {
                n += 1;
            }
            while (n < stack.length()) {
                names.push(l.names[stack[n]]);
                n += 1;
            }
            names.push(l.names[j]);
            let chain = names.toArray().join(" -> ");
            l.errors.push(
                edgeAt[k][e] with {
                    code = "LYS-RES0005",
                    message = f"modules that import each other: {chain}",
                }
            );
        } else if (state[j] == 0) {
            visit(j, edges, edgeAt, state, stack, l);
        }
        e += 1;
    }
    stack.pop();
    state[k] = 2;
    l.order.push(k);
}

fn indexOf(xs: List<string>, x: string): int {
    var k = 0;
    while (k < xs.length()) {
        if (xs[k] == x) {
            return k;
        }
        k += 1;
    }
    return -1;
}

/// Runs a script: 0 at its end, 1 where it does not compile or an error leaves it, 101 for a
/// panic.
fn runScript(path: string, json: bool): int {
    let text = readScript(path);
    if (text == null) {
        return 2;
    }
    // a script compiled before, without a warning, runs from its bytecode (11 Fmt); a program of
    // modules is keyed by all of its files' texts, a script without an import by its own before
    // it is parsed
    let alone = !text.contains("import");
    if (alone) {
        let done = runCached(text, json);
        if (done != null) {
            return done;
        }
    }
    let loaded = loadProgram(path, text);
    let key = loaded.cacheText();
    if (!alone) {
        let done = runCached(key, json);
        if (done != null) {
            return done;
        }
    }
    let compiled = compile(loaded, json);
    let module = compiled.module;
    if (module == null) {
        return 1;
    }
    if (compiled.warnings == 0) {
        store(key, module);
    }
    return finish(execute(module, scriptEntry, [], -1));
}

/// The run of the module cached for `key`, its exit code; `null` where there is none.
fn runCached(key: string, json: bool): ?int {
    let cached = load(key);
    if (cached == null) {
        return null;
    }
    if (json) {
        println(renderSummary(0, 0));
    }
    return finish(execute(cached, scriptEntry, [], -1));
}

/// What compiling a script gave: its module, `null` where it has errors, and how many warnings
/// it had — a script with warnings is not cached, so that they are said at every run.
struct Compiled {
    module: ?Module,
    warnings: int,
}

/// The module of a script, its diagnostics reported — as text on standard error, or as JSON
/// lines on standard output that a summary closes.
fn compile(l: Loaded, json: bool): Compiled {
    let lines = List<SourceLines>.new();
    for (t in l.texts) {
        lines.push(SourceLines.of(t));
    }
    let path = l.paths[0];
    let r = Reporter { paths = l.paths.toArray(), lines = lines.toArray(), json = json };
    var broken = l.errors.length();
    for (parsed in l.parses) {
        r.all(parsed.errors, parsed.warnings);
        broken += parsed.errors.length();
    }
    r.all(l.errors.toArray(), []);
    if (broken > 0) {
        r.summary();
        return Compiled { module = null, warnings = r.warnings };
    }
    // the checker reads trees without faults: a fault of the parse would only echo
    let imported = List<ProgramUnit>.new();
    for (k in l.order) {
        if (k != 0) {
            imported.push(ProgramUnit { name = l.names[k], module = l.parses[k].module, file = k });
        }
    }
    let checked = checkModule(l.parses[0].module, imported.toArray());
    r.all(checked.errors, checked.warnings);
    r.summary();
    if (checked.errors.length() > 0) {
        return Compiled { module = null, warnings = r.warnings };
    }
    let module = generate(checked.program, path);
    let faults = check(module);
    if (faults.length() > 0) {
        // the compiler's fault, not the script's
        for (fault in faults) {
            eprintln(
                f"error[LYS-ICE0002]: {path}: the compiler made faulty bytecode: {fault.function} at {fault.pc}: {fault.message}"
            );
        }
        return Compiled { module = null, warnings = r.warnings };
    }
    return Compiled { module = module, warnings = r.warnings };
}

/// Says a script's diagnostics, in the form asked for, and counts them.
class Reporter {
    // each file's path and lines, by its place among the program's files
    paths: string[],
    lines: SourceLines[],
    json: bool,
    var errors: int = 0,
    var warnings: int = 0,

    mut fn all(errors: Diagnostic[], warnings: Diagnostic[]): void {
        for (d in errors) {
            this.say("error", d);
            this.errors += 1;
        }
        for (d in warnings) {
            this.say("warning", d);
            this.warnings += 1;
        }
    }

    mut fn say(severity: string, d: Diagnostic): void {
        // the file it is about; the prelude's, which is no file of the program, as the entry's
        let k = if (d.file >= 0 && d.file < this.paths.length()) d.file else 0;
        if (this.json) {
            println(renderJson(d, severity, this.paths[k], this.lines[k]));
        } else {
            eprintln(renderText(d, severity, this.paths[k], this.lines[k]));
        }
    }

    /// The JSON form's last line: the counts; the text form says nothing more.
    mut fn summary(): void {
        if (this.json) {
            println(renderSummary(this.errors, this.warnings));
        }
    }
}

/// The exit code of a run: 0 at its end, 1 for an error that left it and 101 for a panic, each
/// reported with its frames.
fn finish(outcome: Outcome): int {
    return match (outcome) {
        .Void | .Scalar(_) | .Ref(_) | .Slots(_, _) => 0,
        .Error(e) => {
            eprintln(f"error: {e.message}");
            for (cause in e.causes) {
                eprintln(f"  caused by: {cause}");
            }
            for (s in e.suppressed) {
                eprintln(f"  suppressed: {s}");
            }
            for (frame in e.trace) {
                eprintln(f"    {frame}");
            }
            1
        }
        .Panic(p) => {
            eprintln(f"panic [{p.code}]: {p.message}");
            for (frame in p.trace) {
                eprintln(f"    {frame}");
            }
            101
        }
        .Suspended => {
            eprintln("error: the run was suspended");
            1
        }
    };
}

/// Runs the file's `main`: its result is printed; a panic is reported with its frames and
/// ends with 101.
fn runAsm(path: string): int {
    let text = readScript(path);
    if (text == null) {
        return 2;
    }
    let module = try assemble(text, path) catch (e: AsmError) {
        eprintln(f"error[LYS-ASM0001]: {path}: {e.message()}");
        return 1;
    };
    let faults = check(module);
    if (faults.length() > 0) {
        for (fault in faults) {
            eprintln(
                f"error[LYS-ASM0002]: {path}: {fault.function} at {fault.pc}: {fault.message}"
            );
        }
        return 1;
    }
    let outcome = execute(module, "main", [], -1);
    match (outcome) {
        .Scalar(bits) => println(bits as int),
        .Ref(v) => {
            if (v is ScriptString) {
                println(v.text);
            }
        }
        _ => { }
    }
    return finish(outcome);
}
