//! The `lyric-script` command line (design/v1, 12). It knows `--version`, `help`, `check`, which
//! grows with the compiler (S2: lexer, parser, checker), and, until `run` comes, `asm`, which runs
//! bytecode in its text form.
import std.fs { readText };
import std.io { println, eprintln };
import std.os { args };
import lyric_script { version };
import lyric_script.compiler.diagnostic { Diagnostic };
import lyric_script.compiler.checker { checkModule };
import lyric_script.compiler.parser { parse };
import lyric_script.vm { bytecodeFormat };
import lyric_script.vm.asm { AsmError, assemble };
import lyric_script.vm.heap { ScriptString };
import lyric_script.vm.interp { execute };
import lyric_script.vm.module { check };

fn usage(): void {
    println("usage: lyric-script <command>");
    println("");
    println("commands:");
    println("  version    print the version (also --version)");
    println("  help       print this text (also --help)");
    println("  check FILE check a script without running it");
    println("  asm FILE   run a .lyrsasm file's 'main' (provisional, until 'run' in S2)");
}

fn main(): int {
    let given = args();
    if (given.length() < 2) {
        usage();
        return 0;
    }
    let command = given[1];
    if (command == "--version" || command == "version") {
        println(f"lyric-script {version} (bytecode format {bytecodeFormat})");
        return 0;
    }
    if (command == "--help" || command == "help") {
        usage();
        return 0;
    }
    if (command == "check") {
        if (given.length() != 3) {
            eprintln("error[LYS-CLI0002]: 'check' takes one file");
            eprintln("  = help: lyric-script check script.lyrs");
            return 2;
        }
        return checkScript(given[2]);
    }
    if (command == "asm") {
        if (given.length() != 3) {
            eprintln("error[LYS-CLI0002]: 'asm' takes one file");
            eprintln("  = help: lyric-script asm program.lyrsasm");
            return 2;
        }
        return runAsm(given[2]);
    }
    eprintln(f"error[LYS-CLI0001]: unknown command '{command}'");
    eprintln("  = help: lyric-script help lists the commands");
    return 2;
}

/// Checks a script: 1 where it has errors, 0 where it has none; warnings are printed either way.
fn checkScript(path: string): int {
    let text = try readText(path) catch (e) {
        eprintln(f"error[LYS-CLI0003]: cannot read '{path}': {e.message()}");
        return 2;
    };
    let parsed = parse(text);
    for (d in parsed.errors) {
        report("error", d, path);
    }
    for (d in parsed.warnings) {
        report("warning", d, path);
    }
    if (parsed.errors.length() > 0) {
        return 1;
    }
    // the checker reads a tree without faults: a fault of the parse would only echo
    let checked = checkModule(parsed.module);
    for (d in checked.errors) {
        report("error", d, path);
    }
    for (d in checked.warnings) {
        report("warning", d, path);
    }
    return if (checked.errors.length() > 0) 1 else 0;
}

fn report(severity: string, d: Diagnostic, path: string): void {
    eprintln(f"{severity}[{d.code}]: {d.message}");
    eprintln(f"  --> {path}:{d.line}:{d.column}");
}

/// Runs the file's `main`: its result is printed; a panic is reported with its frames and
/// ends with 101.
fn runAsm(path: string): int {
    let text = try readText(path) catch (e) {
        eprintln(f"error[LYS-CLI0003]: cannot read '{path}': {e.message()}");
        return 2;
    };
    let module = try assemble(text, path) catch (e: AsmError) {
        eprintln(f"error[LYS-ASM0001]: {path}: {e.message()}");
        return 1;
    };
    let faults = check(module);
    if (faults.length() > 0) {
        for (fault in faults) {
            eprintln(
                f"error[LYS-ASM0002]: {path}: {fault.function} at {fault.pc}: {fault.message}"
            );
        }
        return 1;
    }
    return match (execute(module, "main", [], -1)) {
        .Void => 0,
        .Scalar(bits) => {
            println(bits as int);
            0
        }
        .Ref(v) => {
            if (v is ScriptString) {
                println(v.text);
            }
            0
        }
        .Panic(p) => {
            eprintln(f"panic [{p.code}]: {p.message}");
            for (frame in p.trace) {
                eprintln(f"    {frame}");
            }
            101
        }
        .Suspended => {
            eprintln("error: the run was suspended");
            1
        }
    };
}
