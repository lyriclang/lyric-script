//! The syntax tree (spec chapter 2): what the parser reads, before names and types. Its shape is
//! Lyric 5's `std.syntax` — enums whose children are boxed — with Lyric-Script's forms: a module
//! of declarations and statements, map literals, expression bodies. The checker reads it into
//! a tree of its own, with types (S2d); nothing here is changed after the parse.

/// Where a node stands: byte offsets into the source, and the line and column (from 1) of its
/// start.
struct Span :: [Equatable, Debug] {
    start: int,
    end: int,
    line: int,
    column: int,
}

extend Span {
    /// Returns the span from this one's start to `other`'s end.
    fn to(other: Span): Span {
        return Span { start = this.start, end = other.end, line = this.line, column = this.column };
    }
}

enum UnaryOp :: [Equatable, Debug] {
    Neg,
    Not,
    BitNot,
}

enum BinaryOp :: [Equatable, Debug] {
    Add,
    Sub,
    Mul,
    Div,
    Rem,
    AddWrap,
    SubWrap,
    MulWrap,
    Shl,
    Shr,
    BitAnd,
    BitXor,
    BitOr,
    Lt,
    Le,
    Gt,
    Ge,
    Eq,
    Ne,
    In,
    NotIn,
    And,
    Or,
    Coalesce,
}

/// A written type: a name with its arguments (`int`, `Point`, `Map<string, int>`), `?T`, `T[]`,
/// a tuple, a function type.
enum TypeExpr :: [Debug] {
    Named(string, TypeExpr[], Span),
    Optional(Box<TypeExpr>, Span),
    List(Box<TypeExpr>, Span),
    /// `(A, B)` or `(x: A, y: B)`: the elements and their labels, `""` where none is written.
    Tuple(TypeExpr[], string[], Span),
    Fn(TypeExpr[], Box<TypeExpr>, Span),
}

/// An argument of a call: its name, if written with one, and its value.
struct Arg :: [Debug] {
    name: ?string,
    value: Expr,
}

/// A field of an initializer, `name = value`; `name` alone reads the binding of that name.
struct FieldInit :: [Debug] {
    name: string,
    value: Expr,
    span: Span,
}

/// An entry of a map literal, `key: value`.
struct MapEntry :: [Debug] {
    key: Expr,
    value: Expr,
}

/// A piece of an f-string: text, its escapes resolved, or a hole with its expression and its
/// format spec.
enum Segment :: [Debug] {
    Text(string),
    Hole(Expr, ?string),
}

/// An expression, each form a variant; the span is the whole expression's.
enum Expr :: [Debug] {
    Int(int, Span),
    Float(float, Span),
    Bool(bool, Span),
    Char(char, Span),
    Str(string, Span),
    /// `b"…"`: its bytes.
    Bytes(uint8[], Span),
    Interpolated(Segment[], Span),
    Null(Span),
    Name(string, Span),
    This(Span),
    Unary(UnaryOp, Box<Expr>, Span),
    Binary(Box<Expr>, BinaryOp, Box<Expr>, Span),
    /// `target = value`, or `target op= value` with the operator.
    Assign(Box<Expr>, ?BinaryOp, Box<Expr>, Span),
    /// `a..b`, or `a..=b` when the flag is set.
    Range(Box<Expr>, Box<Expr>, bool, Span),
    Cast(Box<Expr>, TypeExpr, Span),
    Call(Box<Expr>, Arg[], Span),
    Index(Box<Expr>, Box<Expr>, Span),
    /// `x.name`, or `x?.name` when the flag is set.
    Member(Box<Expr>, string, bool, Span),
    List(Expr[], Span),
    /// `["a": 1]`, and `[:]` with no entry.
    Map(MapEntry[], Span),
    StructInit(string, FieldInit[], Span),
    /// `if (c) a else b` where a value stands: each branch an expression or a value block.
    If(Box<Expr>, Box<Expr>, Box<Expr>, Span),
    Block(Block, Span),
    Loop(Block, ?string, Span),
    /// `x!`: the optional's value, the script's panic where it is absent.
    Unwrap(Box<Expr>, Span),
    /// `(a, b)`: a tuple, of two elements or more.
    Tuple(Expr[], Span),
    /// `.Red`: the member of the enum the position expects (Lyric 5 §4.2).
    Implicit(string, Span),
    /// `Shape.Rect { w = 1 }` or `.Rect { w = 1 }`: a struct variant built; the enum if written.
    VariantInit(?string, string, FieldInit[], Span),
    /// `match (e) { arms }`.
    Match(Box<Expr>, MatchArm[], Span),
    /// A lambda: its parameters, its result type if written, its body (an expression or a value
    /// block), and whether it is a trailing block without named parameters (`it`, or none).
    Lambda(LambdaParam[], ?TypeExpr, Box<Expr>, bool, Span),
}

/// A lambda's parameter: its name, its type if written.
struct LambdaParam :: [Debug] {
    name: string,
    type: ?TypeExpr,
    span: Span,
}

/// An arm of a `match`: its pattern, its guard, its value — an expression or a value block.
struct MatchArm :: [Debug] {
    pattern: Pattern,
    guard: ?Expr,
    body: Expr,
    span: Span,
}

/// `w = P` in a field pattern, or `h` alone, which binds the field to its own name.
struct FieldPattern :: [Debug] {
    name: string,
    pattern: Pattern,
    span: Span,
}

/// A pattern (Lyric 5 §9): what an arm of a `match` or a `let` tries against a value.
enum Pattern :: [Debug] {
    /// A bare name: binds the whole value.
    Name(string, Span),
    Ignore(Span),
    Tuple(Pattern[], Span),
    /// An int, float, char, string, `bool` or `null` literal, as the expression it is.
    Literal(Expr, Span),
    /// `a..b`, or `a..=b` with the flag, over int or char literals.
    Range(Expr, Expr, bool, Span),
    /// `.Num(p)` or `Shape.Num(p)`: the enum if written, the variant, the payload's patterns by
    /// position — `null` without parentheses.
    Variant(?string, string, ?Pattern[], Span),
    /// `.Rect { w = 0, h }` or `Shape.Rect { … }`: a struct variant by its fields.
    VariantFields(?string, string, FieldPattern[], Span),
    /// `Point { x = 0, y }`: a struct's or a class's fields.
    Fields(string, FieldPattern[], Span),
    /// `P | Q`.
    Or(Pattern[], Span),
}

/// A statement, each form a variant.
enum Stmt :: [Debug] {
    Expr(Expr, Span),
    /// `let` or, with the flag, `var`: the name, its type if written, its value if given.
    Let(bool, string, ?TypeExpr, ?Expr, Span),
    /// `fn name(…) { … }` in a block: a named closure (Lyric 5 03 §8.6).
    LocalFn(FnDecl),
    /// `let P = value`, or `var`, and `let P = value else { … }`: the value taken apart.
    Destructure(bool, Pattern, Expr, ?Block, Span),
    /// `if` as a statement: the `else` is a block's statement or another `if`, or none.
    If(Expr, Block, ?Box<Stmt>, Span),
    While(Expr, Block, ?string, Span),
    /// `for (name in iterable)`.
    For(string, Expr, Block, ?string, Span),
    Break(?string, ?Expr, Span),
    Continue(?string, Span),
    Return(?Expr, Span),
    Block(Block, Span),
    /// `if (let name = optional) { … }`: the block sees the value where it is there.
    IfLet(Pattern, Expr, Block, ?Box<Stmt>, Span),
    /// `while (let name = optional) { … }`: a turn for each value that is there.
    WhileLet(Pattern, Expr, Block, ?string, Span),
}

/// A block: its statements, in order. Where a block gives a value, its last statement does,
/// when it is an expression (09 NL rule 6).
struct Block :: [Debug] {
    stmts: Stmt[],
    span: Span,
}

/// A parameter: its name, its type, its default.
struct Param :: [Debug] {
    name: string,
    type: TypeExpr,
    default: ?Expr,
    span: Span,
}

/// A function's body: a block, or `= expr` (09 Ret).
enum FnBody :: [Debug] {
    Block(Block),
    Expr(Expr),
    /// An interface's abstract member: no body.
    None,
}

/// An interface a type conforms to in its list, and the field it delegates to (`I by f`).
struct Conformance :: [Debug] {
    name: string,
    by: ?string,
    span: Span,
}

/// `interface I :: [Parents] { fn m(): T  fn d(): U { … } }`, `sealed` before it or not.
struct InterfaceDecl :: [Debug] {
    name: string,
    parents: Conformance[],
    members: FnDecl[],
    sealed: bool,
    isPub: bool,
    span: Span,
}

/// `extend T { … }` or `extend T :: [I] { … }`: methods, and conformances, added to a type.
struct ExtendDecl :: [Debug] {
    target: TypeExpr,
    conforms: Conformance[],
    methods: FnDecl[],
    span: Span,
}

struct FnDecl :: [Debug] {
    name: string,
    params: Param[],
    returns: ?TypeExpr,
    body: FnBody,
    isPub: bool,
    isStatic: bool,
    span: Span,
}

/// A field of a struct or a class: `var` only in a class.
struct FieldDecl :: [Debug] {
    name: string,
    type: TypeExpr,
    default: ?Expr,
    isVar: bool,
    isPub: bool,
    span: Span,
}

/// A struct or, with the flag, a class: its fields and its methods.
struct TypeDecl :: [Debug] {
    name: string,
    conforms: Conformance[],
    isClass: bool,
    fields: FieldDecl[],
    methods: FnDecl[],
    isPub: bool,
    span: Span,
}

/// A variant of an enum: its name and its payload — positional types (`Num(int)`), named fields
/// (`Rect { w: int, h: int }`, `named` set), or neither.
struct Variant :: [Debug] {
    name: string,
    positional: TypeExpr[],
    fields: FieldDecl[],
    named: bool,
    span: Span,
}

struct EnumDecl :: [Debug] {
    name: string,
    conforms: Conformance[],
    variants: Variant[],
    methods: FnDecl[],
    isPub: bool,
    span: Span,
}

/// `type Name = T`.
struct AliasDecl :: [Debug] {
    name: string,
    type: TypeExpr,
    isPub: bool,
    span: Span,
}

enum Decl :: [Debug] {
    Fn(FnDecl),
    Type(TypeDecl),
    Enum(EnumDecl),
    Alias(AliasDecl),
    Interface(InterfaceDecl),
    Extend(ExtendDecl),
}

/// What stands at the top of a module: a declaration, or a statement of the script (07 Top).
enum Item :: [Debug] {
    Decl(Decl),
    Stmt(Stmt),
}

/// A module as read: its frontmatter's TOML, if it has one, and its items in order.
struct Module :: [Debug] {
    frontmatter: ?string,
    items: Item[],
}

/// How a prefix operator is written.
fn unaryText(op: UnaryOp): string {
    return match (op) {
        .Neg => "-",
        .Not => "!",
        .BitNot => "~",
    };
}

/// How an infix operator is written.
fn binaryText(op: BinaryOp): string {
    return match (op) {
        .Add => "+",
        .Sub => "-",
        .Mul => "*",
        .Div => "/",
        .Rem => "%",
        .AddWrap => "+%",
        .SubWrap => "-%",
        .MulWrap => "*%",
        .Shl => "<<",
        .Shr => ">>",
        .BitAnd => "&",
        .BitXor => "^",
        .BitOr => "|",
        .Lt => "<",
        .Le => "<=",
        .Gt => ">",
        .Ge => ">=",
        .Eq => "==",
        .Ne => "!=",
        .In => "in",
        .NotIn => "!in",
        .And => "&&",
        .Or => "||",
        .Coalesce => "??",
    };
}
