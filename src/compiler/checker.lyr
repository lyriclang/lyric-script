//! The checker (S2d; spec chapters 3, 7, 8 for the core): the syntax tree to the checked program.
//! It resolves names — locals in their scopes, the script's top-level bindings (07 Top), functions
//! by name and number of arguments (Lyric 5 §8.1.2), types —, gives every expression its type and
//! writes out the conversions the language makes on its own (`int` to `float`, 03 Mix).
//!
//! Two passes: the declarations first (types, then fields and signatures), then the bodies. A
//! function whose body is `= expr` without a written type gets the type of `expr` (09 Ret),
//! checked when it is first needed.
//!
//! A code means what Lyric 5's `LYR-SEM` code of the same number means; Lyric-Script's own start
//! at 0900. `LYS-NYI0001` names what the plan builds later: it
//! leaves the toolchain before 1.0.
import std.collections { List, Map, Set };
import lyric_script.compiler.ast {
    AliasDecl,
    Arg,
    BinaryOp,
    Block,
    CatchClause,
    Conformance,
    EnumDecl,
    ExtendDecl,
    Expr,
    FieldDecl,
    FieldInit,
    FieldPattern,
    FnDecl,
    InterfaceDecl,
    ImportDecl,
    Item,
    LambdaParam,
    MapEntry,
    MatchArm,
    Module,
    Pattern,
    Segment,
    Span,
    StaticLet,
    Stmt,
    TypeAnswer,
    TypeDecl,
    TypeExpr,
    TypeParam,
    UnaryOp,
    WithField,
    binaryText,
    unaryText,
};
import lyric_script.compiler.diagnostic { Diagnostic };
import lyric_script.compiler.parser { Parsed, parse };
import lyric_script.compiler.throws { ThrowSets, Thrown };
import lyric_script.stdsrc { collectionsText, preludeText, stdPackage };
import lyric_script.vm.native { nativeNamed, nativeNumber };
import lyric_script.compiler.typed {
    FieldInfo,
    FixedTy,
    FnInfo,
    GlobalInfo,
    ListOp,
    Native,
    ParamInfo,
    Place,
    Program,
    TExpr,
    TStmt,
    Ty,
    TClause,
    TypeInfo,
    TypeKind,
    CaptureInfo,
    FnTy,
    isScalar,
    TupleTy,
    TypeParamInfo,
    tupleOf,
    tyKey,
    typeOf,
    stmtLine,
};

/// What the checker made of a module: the program, and its errors and warnings.
struct Checked {
    program: Program,
    errors: Diagnostic[],
    warnings: Diagnostic[],
}

/// A file of a program (S5a): its module's dotted path below the root, what it parsed to, and its
/// place among the program's files — 0 the entry.
struct ProgramUnit {
    name: string,
    module: Module,
    file: int,
    /// The last segments of its submodules: the modules in the folder of its name (S5a2).
    submodules: string[] = [],
    /// The package it is of, by its place among the program's packages; 0 the entry's (S5b).
    package: int = 0,
}

/// Checks a program: its entry, file 0, with the modules it imports, given in the order their
/// imports need — each module before the modules that import it (07 V5).
fn checkModule(parsed: Module, imported: ProgramUnit[] = [], collections: bool = false): Checked {
    let c = Checker.new();
    // the prelude's declarations before the program's, parsed as no file of it; the entry's last
    let items = List<Item>.new();
    let prelude = parse(preludeText(), -1);
    c.stdParses(prelude, "the prelude");
    for (item in prelude.module.items) {
        items.push(item);
    }
    // std.collections where the program names a map: its names the prelude's (S7d2)
    if (collections) {
        let parsed = parse(collectionsText(), -1);
        c.stdParses(parsed, "std.collections");
        for (item in parsed.module.items) {
            items.push(item);
        }
    }
    for (u in imported) {
        c.modNames.insert(u.file, u.name);
        c.modPkg.insert(u.file, u.package);
        let subs = Set<string>.new();
        for (n in u.submodules) {
            subs.insert(n);
        }
        c.submodules.insert(u.file, Names { names = subs });
        c.modByName.insert(u.name, u.file);
        c.sources.insert(u.file, u.module.text);
        for (item in u.module.items) {
            items.push(item);
        }
    }
    c.sources.insert(0, parsed.text);
    for (item in parsed.items) {
        items.push(item);
    }
    let module = Module {
        frontmatter = parsed.frontmatter,
        items = items.toArray(),
        text = parsed.text,
    };
    c.source = parsed.text;
    c.declare(module);
    c.checkMain(module);
    c.checkImports();
    c.checkBodies();
    c.unusedImports();
    c.checkThrows();
    c.fillTextSlot();
    c.fillDebugSlot();
    c.instantiate();
    return Checked {
        program = c.program(),
        errors = c.errors.toArray(),
        warnings = c.warnings.toArray(),
    };
}

/// A clause's head: the test it makes of the error, the types it takes (none for every error),
/// the statement that binds the error.
struct ClauseHead {
    test: ?TExpr,
    takes: Ty[],
    bind: TStmt[],
}

/// A match over the binding of a clause that carries a set: its clause's key, the types its
/// arms take, where it stands (05 K7).
struct LaterMatch {
    key: string,
    types: Ty[],
    at: Span,
}

/// A module's view: each name it sees, to its key. A class of its own: a field of type
/// `Map<int, Map<…>>` does not lower yet (as lyriclang/lyric#612).
class View {
    names: Map<string, string>,
}

/// A set of names, a module's submodules (a class: a map of sets as a field of the checker is
/// one Lyric 5 does not compile).
class Names {
    names: Set<string>,
}

/// The modules a module's qualified and aliased imports bind, by name.
class ModuleNames {
    modules: Map<string, int>,
}

/// What an import binds under a name, where, and whether anything used it.
class ImportUse {
    name: string,
    mod: int,
    at: Span,
    var used: bool = false,
}

/// A selective import's name, to check once every declaration is known: its key, its name and
/// module, the module that imports it and the one it names, where.
struct ImportCheck {
    key: string,
    name: string,
    // the name it binds: its alias or its own
    bound: string,
    path: string,
    from: int,
    target: int,
    at: Span,
}

/// A loop being checked: `loop` gives the value of its breaks, `while` and `for` give none.
/// A coroutine's body about to be checked (S6b): the type it yields and the one it returns, each
/// given or inferred from its yields and returns (`inferY`, `inferR`, starting from `y` and `r`),
/// quietly where `quiet`; and the code for a path that ends without the result.
class GenBody {
    y: Ty,
    inferY: bool,
    r: Ty,
    inferR: bool,
    quiet: bool,
    pathCode: string,
}

class LoopCtx {
    isLoop: bool,
    var breakTy: ?Ty = null,
    var breaks: int = 0,
    // the bindings without a value its breaks leave unassigned: what follows a `loop`
    var exits: Set<int> = Set<int>.new(),
    // its label, where it stands, and whether a jump names it (07 §1 rule 3)
    var label: ?string = null,
    var labelAt: ?Span = null,
    var named: bool = false,
}

/// A scope's locals by name. A class of its own: a field of type `List<Map<…>>` does not lower
/// yet (lyriclang/lyric#612).
class Scope {
    names: Map<string, int>,
    // the locals and the script's globals a condition has narrowed here: what they hold
    narrowed: Map<int, Ty>,
    narrowedGlobals: Map<int, Ty>,

    static fn new(): Scope {
        return Scope {
            names = Map<string, int>.new(),
            narrowed = Map<int, Ty>.new(),
            narrowedGlobals = Map<int, Ty>.new(),
        };
    }
}

/// What a condition says where it holds, or where it does not: a binding of an optional holds
/// its value (03 O).
struct Fact {
    isGlobal: bool,
    id: int,
    ty: Ty,
}

/// The function being checked: its scopes of locals and its loops.
class FnCtx {
    fnIndex: int,
    scopes: List<Scope>,
    locals: List<Ty>,
    localIsVar: List<bool>,
    localNames: List<string>,
    loops: List<LoopCtx>,
    var returns: Ty,
    // whether `let` and `var` at the outermost scope are the script's globals (main's code)
    isMain: bool,
    // the bindings declared without a value that are not assigned on every way to here (Lyric 5
    // §7.1 rule 5); never changed in place, so a saved set stays as it was
    var unassigned: Set<int>,
    // 03 Leer: the first pass over a function that declares `var x = null` reports nothing and
    // records, for each such binding in order, the first type a use fixes; the second pass gives
    // the bindings these types
    fixing: bool,
    var fixes: List<?Ty>,
    var nullVars: int = 0,
    sought: Map<int, int>,
    soughtGlobals: Map<int, int>,
    // a lambda's: the function around it, what it captures by name in order, and the locals of
    // its own a lambda inside captures as `var`s (Lyric 5 03 §8.3)
    var isLambda: bool = false,
    var outer: ?FnCtx = null,
    captures: List<Capture>,
    captureIndex: Map<string, int>,
    boxed: List<bool>,
    // a clause's binding: the locals the error it took and its record are in (06 §4 rule 4); and
    // for the binding of a clause without a type or of a set, its clause, "<fn>:<local>:<k>"
    var clauseErrors: Map<int, int> = Map<int, int>.new(),
    var clauseRecords: Map<int, int> = Map<int, int>.new(),
    var clauseKeys: Map<int, string> = Map<int, string>.new(),
    // in a defer's body: how many loops stood around it, which its jumps may not leave; -1 for
    // none (S4e)
    var deferLoops: int = -1,
    // a coroutine's body: the type it yields; none elsewhere (S6b); whether its yields and its
    // returns infer the types, which they unify into (S6b2)
    var yields: ?Ty = null,
    var yieldsInferred: bool = false,
    var returnsInferred: bool = false,

    static fn new(fnIndex: int, returns: Ty, isMain: bool, fixing: bool): FnCtx {
        let scopes = List<Scope>.new();
        scopes.push(Scope.new());
        return FnCtx {
            fnIndex = fnIndex,
            scopes = scopes,
            locals = List<Ty>.new(),
            localIsVar = List<bool>.new(),
            localNames = List<string>.new(),
            loops = List<LoopCtx>.new(),
            returns = returns,
            isMain = isMain,
            unassigned = Set<int>.new(),
            fixing = fixing,
            fixes = List<?Ty>.new(),
            sought = Map<int, int>.new(),
            soughtGlobals = Map<int, int>.new(),
            captures = List<Capture>.new(),
            captureIndex = Map<string, int>.new(),
            boxed = List<bool>.new(),
        };
    }
}

/// The state of a function's signature: an expression body without a written type is inferred
/// when first needed.
enum FnState :: [Equatable] {
    Declared,
    Inferring,
    Done,
}

/// The interfaces the compiler synthesizes beside `Equatable` — `Clone`, `Default` — and the
/// functions it made for them, by "clone:" or "default:" and the type (S7c6c1): one field of the
/// checker, whose Debug form Lyric 5 nests a level deeper for each field it has.
class Synthesized {
    var cloneIx: int = -1,
    var defaultIx: int = -1,
    var hashableIx: int = -1,
    var hasherIx: int = -1,
    // `Debug`, `Display` and the builder they write into (S7e3)
    var debugIx: int = -1,
    var displayIx: int = -1,
    var builderIx: int = -1,
    // the slot of every type's text (S7e3), as `debugSlot` is of its Debug form
    var textSlot: int = -1,
    // whether the call being checked took its spread, `xs...` (S7e4a)
    var spreadTaken: bool = false,
    fns: Map<string, int> = Map<string, int>.new(),
}

class Checker {
    errors: List<Diagnostic>,
    warnings: List<Diagnostic>,
    types: List<TypeInfo>,
    typeIndex: Map<string, int>,
    aliases: Map<string, AliasDecl>,
    resolvingAliases: List<string>,
    functions: List<FnInfo>,
    // top-level functions by name: the indices of those of that name
    fnByName: Map<string, List<int>>,
    fnDecls: List<?FnDecl>,
    fnStates: List<FnState>,
    globals: List<GlobalInfo>,
    globalIndex: Map<string, int>,
    var ctx: FnCtx,
    var mainIndex: int = -1,
    // the interface methods' slots given so far
    var slotCount: int = 0,
    // `Any`'s entry, and `Identity`'s
    var anyIndex: int = -1,
    var identityIndex: int = -1,
    // where each function writes its `throws` (S4c)
    var throwsAt: Map<int, Span> = Map<int, Span>.new(),
    // whether a task is spawned anywhere: the top level then ends with a join (S6a)
    var spawns: bool = false,
    // the coroutine body the next lambda made is (S6b), and the types the last one yielded and
    // returned
    var pendingBody: ?GenBody = null,
    var lastYields: Ty = Ty.Void,
    var lastReturns: Ty = Ty.Void,
    // the modules (S5a): the current one, by its file — 0 the entry, -1 the prelude —; each
    // imported module's dotted path and its view, a name to its key; the modules a qualified
    // import binds, by name
    var mod: int = 0,
    var modNames: Map<int, string> = Map<int, string>.new(),
    var modScopes: Map<int, View> = Map<int, View>.new(),
    var modAliases: Map<int, ModuleNames> = Map<int, ModuleNames>.new(),
    var modByName: Map<string, int> = Map<string, int>.new(),
    var sources: Map<int, string> = Map<int, string>.new(),
    // the names imports bind, by "<module>:<name>", and whether anything used them; and the
    // selective imports' names, checked once every declaration is known
    var importUses: Map<string, ImportUse> = Map<string, ImportUse>.new(),
    // the same, in the order they were written: the map's own order changes from run to run
    var importOrder: List<ImportUse> = List<ImportUse>.new(),
    var imported: List<ImportCheck> = List<ImportCheck>.new(),
    // the keys of what is `private`: its file's alone (02 V)
    var privateKeys: Set<string> = Set<string>.new(),
    // the keys of what is `internal`: its package's alone (07 V2, S5b); each module's package
    var internalKeys: Set<string> = Set<string>.new(),
    var modPkg: Map<int, int> = Map<int, int>.new(),
    // each module's submodules, by its file (S5a2)
    var submodules: Map<int, Names> = Map<int, Names>.new(),
    // a `pub import`'s names: the key under the passing module to the key it passes on
    var reexports: Map<string, string> = Map<string, string>.new(),
    // the module's source, which an assertion quotes as written (S4f)
    var source: string = "",
    // the matches over a clause's set, checked once the sets are known (05 K7)
    var laterMatches: List<LaterMatch> = List<LaterMatch>.new(),
    // the synthesized equality of each struct and enum compared, by type; its Debug form
    eqFns: Map<int, int>,
    debugFns: Map<int, int>,
    // the Debug form of each list type printed, by the type's key (S7b1)
    var listDebugFns: Map<string, int> = Map<string, int>.new(),
    // the prelude's `Equatable` (S7c5a); each type's comparison a copy made, by the type's key
    var equatableIndex: int = -1,
    // `Clone` and `Default`, synthesized as `Equatable` is (S7c6c1)
    synth: Synthesized = Synthesized { },
    // what `Self` is in a default type argument being read: the conformer, the parameter a
    // constraint is of (S7c5c1)
    var defaultSelf: ?Ty = null,
    // while a written interface is made an instance: never its template (S7c5c1)
    var exactInstance: bool = false,
    // the prelude's `Ordered`, `TotalOrder` and `Ordering` (S7c5b)
    var orderedIndex: int = -1,
    var totalOrderIndex: int = -1,
    var orderingIndex: int = -1,
    var genericEqFns: Map<string, int> = Map<string, int>.new(),
    // the type parameters in scope by name, and the generic they are of
    var typeParams: Map<string, int> = Map<string, int>.new(),
    var genericFn: int = -1,
    // the copies made of generics, by function and the shape of the type arguments
    instances: Map<string, int>,
    // the type arguments a method's receiver binds before its call is checked
    var presetBinds: Ty[] = [],
    // for the next call checked, not an argument's: the position's type and the type arguments
    // written at a method (Lyric 5 §9.2 rules 2, 4; S7c4c2); whether a call took the written ones
    var callExpected: ?Ty = null,
    var writtenArgs: Ty[] = [],
    var writtenTaken: bool = false,
    // the members of blanket blocks, by name (05 §13 rule 7; S7c4c2)
    blankets: Map<string, List<int>> = Map<string, List<int>>.new(),
    // the same, in the order they are declared
    blanketFns: List<int> = List<int>.new(),
    // the blanket blocks that conform (05 §13 rule 8; S7c4c3a), their entries in order; each
    // entry by its block's place; the entries a conformance question is asking now
    blanketConfs: List<int> = List<int>.new(),
    blanketIndex: Map<string, int> = Map<string, int>.new(),
    blanketVisiting: List<int> = List<int>.new(),
    // where a type's conformance to an interface stands, by `type:interface name`
    conformedAt: Map<string, Span> = Map<string, Span>.new(),
    // the instance a block on one instance names, by the block's place (S7c4c3b); -2 where the
    // target was refused
    instanceBlocks: Map<string, int> = Map<string, int>.new(),
    // a conformance block's members, by the block's place; the block whose conformances are
    // checked now; the interfaces each member of a set answers; the members refused already
    // (S7c5d2)
    memberSite: Map<int, string> = Map<int, string>.new(),
    var blockSite: string = "",
    answering: Map<int, List<int>> = Map<int, List<int>>.new(),
    refusedMembers: Map<int, bool> = Map<int, bool>.new(),
    // the arguments a member's choice checked: for its call, not checked again (S7c5d2)
    var pickedArgs: TExpr[] = [],
    var preChecked: TExpr[] = [],
    // the type the position wants of a member read without a call (S7c5d2)
    var memberExpected: ?Ty = null,
    // the functions that give a value's text in a copy, by "text:" or "debug:" and the type
    textFns: Map<string, int> = Map<string, int>.new(),
    // a conformance block's answers, by "<the block's place>#<name>" (05 §8 rule 3; S7c5d3)
    siteAnswers: Map<string, Ty> = Map<string, Ty>.new(),
    // the type's answers a conformance block's stand in for while its signatures are read
    var answersBefore: List<(string, Ty)> = List<(string, Ty)>.new(),
    var answersAbsent: List<string> = List<string>.new(),
    // while a blanket block's signatures are checked: its target, and the answers it gives
    var selfAnswersAt: int = -1,
    var selfAnswers: Map<string, Ty> = Map<string, Ty>.new(),
    // while a copy is made: where each type parameter's descriptor comes from at run time, null
    // where the copy knows its argument (S3i)
    var specDescs: (?TExpr)[] = [],
    // the slot of every type's Debug form, once something prints through a table (S3i); while
    // the tables are filled, a type without a form gets a placeholder, not an error
    var debugSlot: int = -1,
    var fnDebug: int = -1,
    var quietDebug: bool = false,
    // what `Self` names where a type is resolved now: the type whose members these are, `null`
    // outside them (S3i, Lyric 5 05 §7 rule 1)
    var selfTyIs: ?Ty = null,
    // while a static default's copy is made: one of its own, never shared
    var copyExact: bool = false,
    // the type parameters of the declaration whose signature is resolved, with their
    // constraints: what `T.Item` is read through (S3i)
    var declaringParams: TypeParamInfo[] = [],
    // an associated type's default and its bounds, by "<interface>.<name>"
    assocDefaults: Map<string, TypeExpr>,
    assocBounds: Map<string, int[]>,
    // the interfaces with fixed associated types, the types of values (05 §8 rule 6)
    fixedForms: Map<string, int>,
    // the types' constants: the first globals, set where the script begins (05 §7 rule 2)
    staticInits: List<StaticInit>,
    // a generic function's copy as a value: its thunk holding the descriptors, by copy
    descThunks: Map<string, int>,
    // while a generic block's conformances are checked: its parameters (05 §13 rule 3)
    var blockCond: TypeParamInfo[] = [],
    // the entries of the built-in types that have methods or conformances, by name
    builtinIndex: Map<string, int>,
    // the function each boxed conformer's method runs through its box, by method
    unboxers: Map<int, int>,
    // the function value of each function named without a call: its thunk's index
    thunks: Map<int, int>,
    // the function value of each method named without a call: its function's index
    bound: Map<int, int>,
    // what the statement just checked lets the rest of its block know (an `if` whose one branch
    // never comes out)
    var postFacts: List<Fact> = List<Fact>.new(),

    static fn new(): Checker {
        return Checker {
            errors = List<Diagnostic>.new(),
            warnings = List<Diagnostic>.new(),
            types = List<TypeInfo>.new(),
            typeIndex = Map<string, int>.new(),
            aliases = Map<string, AliasDecl>.new(),
            resolvingAliases = List<string>.new(),
            functions = List<FnInfo>.new(),
            fnByName = Map<string, List<int>>.new(),
            fnDecls = List<?FnDecl>.new(),
            fnStates = List<FnState>.new(),
            globals = List<GlobalInfo>.new(),
            globalIndex = Map<string, int>.new(),
            thunks = Map<int, int>.new(),
            bound = Map<int, int>.new(),
            builtinIndex = Map<string, int>.new(),
            unboxers = Map<int, int>.new(),
            instances = Map<string, int>.new(),
            eqFns = Map<int, int>.new(),
            debugFns = Map<int, int>.new(),
            assocDefaults = Map<string, TypeExpr>.new(),
            assocBounds = Map<string, int[]>.new(),
            fixedForms = Map<string, int>.new(),
            staticInits = List<StaticInit>.new(),
            descThunks = Map<string, int>.new(),
            ctx = FnCtx.new(-1, Ty.Void, false, false),
        };
    }

    mut fn program(): Program {
        return Program {
            types = this.types.toArray(),
            functions = this.functions.toArray(),
            globals = this.globals.toArray(),
            main = this.mainIndex,
            slots = this.slotCount,
            debugSlot = this.debugSlot,
            fnDebug = this.fnDebug,
            textSlot = this.synth.textSlot,
            errorMessage = this.errorSlot("message"),
            errorCause = this.errorSlot("cause"),
            spawns = this.spawns,
            cancelled = this.typeIndex.get("Cancelled") ?? -1,
            channelClosed = this.typeIndex.get("ChannelClosed") ?? -1,
        };
    }

    /// The key a declaration of the current module is registered under: "<path>::<name>" in a
    /// module of the program — the entry's path empty —, its name alone in the prelude (S5a).
    mut fn declKey(name: string): string {
        return keyIn(this.modNames.get(this.mod) ?? "", this.mod, name);
    }

    /// A part of the standard library merged into the prelude parses, or the compiler is at fault:
    /// a parse error there would drop its declarations without a word (S7e1: an `extend fn(…)`
    /// block did).
    mut fn stdParses(p: Parsed, what: string): void {
        for (d in p.errors) {
            this.error(
                "LYS-ICE0001",
                f"{what} does not parse at line {d.line}: {d.message}",
                nowhereSpan
            );
        }
    }

    /// The current module sees a declaration of its own by its name, before the prelude's of
    /// that name (`LYS-SEM0153`) and before a name an import binds beside it (`LYS-RES0001`, said
    /// with the imports). A builtin type's name is no declaration's (`LYS-RES0011`).
    mut fn register(name: string, at: Span): void {
        if (this.mod < 0) {
            return;
        }
        this.viewOf(this.mod).insert(name, this.declKey(name));
        this.notASubmodule(name, at);
        if (isBuiltinType(name)) {
            this.error("LYS-RES0011", f"'{name}' is a builtin type's name", at);
        } else if (this.inPrelude(name)) {
            this.hidesPrelude(name, at);
        }
    }

    /// Whether the prelude gives every module `name`: a declaration of it, or one of the
    /// functions the compiler knows.
    mut fn inPrelude(name: string): bool {
        return this.typeIndex.containsKey(name)
            || this.fnByName.containsKey(name)
            || this.globalIndex.containsKey(name)
            || this.aliases.containsKey(name)
            || isPreludeFn(name);
    }

    /// A name the current module declares or imports is not also one of its submodules (Lyric 5
    /// 04 §4 rule 7, `LYS-RES0012`).
    mut fn notASubmodule(name: string, at: Span): void {
        let subs = this.submodules.get(this.mod);
        if (subs != null && subs.names.contains(name)) {
            let path = this.modNames.get(this.mod) ?? "";
            this.error(
                "LYS-RES0012",
                f"'{name}' is also the name of the submodule '{path}.{name}'",
                at
            );
        }
    }

    mut fn hidesPrelude(name: string, at: Span): void {
        this.warn(
            "LYS-SEM0153",
            f"'{name}' hides the prelude's: in this module the name is its own",
            at
        );
    }

    /// A declaration of the current module kept to its file (`private`, 02 V) or to its package
    /// (`internal`, 07 V2).
    mut fn keepPrivate(name: string, isPub: bool, isInternal: bool): void {
        if (!isPub) {
            this.privateKeys.insert(this.declKey(name));
        } else if (isInternal) {
            this.internalKeys.insert(this.declKey(name));
        }
    }

    /// The package of module `m`: the entry's, 0, where none is known.
    mut fn pkgOf(m: int): int {
        return this.modPkg.get(m) ?? 0;
    }

    /// Why module `from` may not name the declaration `key` of module `target`, `name`: a
    /// `private` one is named in its own file alone, an `internal` one in its own package
    /// (`LYS-RES0009`); `null` where it may.
    mut fn hiddenFrom(key: string, name: string, target: int, from: int): ?string {
        let path = this.modNames.get(target) ?? "";
        if (this.privateKeys.contains(key) && target != from) {
            return f"'{name}' is private to the module '{path}'";
        }
        if (this.internalKeys.contains(key) && this.pkgOf(target) != this.pkgOf(from)) {
            return f"'{name}' is internal to the package of the module '{path}'";
        }
        return null;
    }

    /// Whether the current module may name the declaration `key` of module `target`, `name`
    /// (`LYS-RES0009`).
    mut fn maySee(key: string, name: string, target: int, at: Span): bool {
        let why = this.hiddenFrom(key, name, target, this.mod);
        if (why != null) {
            this.error("LYS-RES0009", why, at);
            return false;
        }
        return true;
    }

    /// The type an expression names: `util.Point` through its module, else as the module sees
    /// the name; `null` where none — reported for a name through a module.
    mut fn typeNamed(name: string, at: Span): ?int {
        let dot = name.find('.');
        if (dot == null) {
            return this.typeIndex.get(this.q(name));
        }
        let head = name[0..dot].toString();
        let rest = name[dot + 1..name.length()].toString();
        let target = this.moduleNamed(head);
        if (target == null) {
            this.error("LYS-SEM0002", f"nothing in scope is named '{head}'", at);
            return null;
        }
        let key = this.exportKey(target, rest);
        let index = this.typeIndex.get(key);
        if (index == null) {
            this.error("LYS-RES0004", f"the module '{head}' declares no type '{rest}'", at);
            return null;
        }
        this.maySee(key, rest, target, at);
        return index;
    }

    /// Type `index` written with `args`: an instance of a generic one, an interface fixed in its
    /// associated types, or the type itself.
    mut fn namedWith(index: int, shown: string, args: TypeExpr[], at: Span): Ty {
        let t = this.types[index];
        if (t.kind == .Interface && args.length() > 0) {
            return this.fixedInterface(index, args, at);
        }
        let n = t.typeParams.length();
        if (n == 0 && args.length() == 0) {
            return Ty.Named(index);
        }
        let tys = List<Ty>.new();
        for (x in args) {
            tys.push(this.resolveType(x));
        }
        let all = if (args.length() <= n) this.withDefaults(t.typeParams, tys.toArray(), null)
            else null;
        if (all == null) {
            this.error(
                "LYS-SEM0026",
                f"'{shown}' takes {n} type arguments, not {args.length()}",
                at
            );
            return Ty.Unknown;
        }
        return Ty.Named(this.typeInstance(index, all));
    }

    /// Whether the current module may name member `member` of type `i` (Lyric 5 04 §3 rule 6):
    /// a `private` field or method in its type's file alone (`LYS-RES0009`).
    mut fn mayName(i: int, member: string, at: Span): bool {
        let base = if (this.types[i].template >= 0) this.types[i].template else i;
        let t = this.types[base];
        if (t.mod != this.mod && t.hidden.contains(member)) {
            this.error("LYS-RES0009", f"'{t.name}.{member}' is private to its type's file", at);
            return false;
        }
        if (this.pkgOf(t.mod) != this.pkgOf(this.mod) && t.internalNames.contains(member)) {
            this.error("LYS-RES0009", f"'{t.name}.{member}' is internal to its type's package", at);
            return false;
        }
        return true;
    }

    /// A type with a field the current module may not name is built in its type's file alone —
    /// by its initializer, or a copy with `with` (Lyric 5 04 §3 rule 7, `LYS-RES0009`): a
    /// function of its module builds it.
    mut fn mayBuild(i: int, at: Span): void {
        let base = if (this.types[i].template >= 0) this.types[i].template else i;
        let t = this.types[base];
        if (t.mod == this.mod) {
            return;
        }
        let otherPkg = this.pkgOf(t.mod) != this.pkgOf(this.mod);
        for (f in t.fields) {
            if (t.hidden.contains(f.name) || (otherPkg && t.internalNames.contains(f.name))) {
                this.error(
                    "LYS-RES0009",
                    f"'{t.name}' has the private field '{f.name}': a function of its module builds it",
                    at
                );
                return;
            }
        }
    }

    /// The file of module `m` as its frames name it: its path below the root, `a/b.lyrs`; empty
    /// for the entry's and the prelude's (S5a2).
    mut fn fileText(m: int): string {
        if (m <= 0) {
            return "";
        }
        return (this.modNames.get(m) ?? "").replace(".", "/") + ".lyrs";
    }

    /// Whether module `m` declares `name` itself.
    mut fn declaresOwn(m: int, name: string): bool {
        let key = keyIn(this.modNames.get(m) ?? "", m, name);
        return m >= 0
            && (this.typeIndex.containsKey(key)
                || this.fnByName.containsKey(key)
                || this.globalIndex.containsKey(key)
                || this.aliases.containsKey(key));
    }

    /// The module a qualified or aliased import binds under `name` here; `null` for none.
    mut fn moduleNamed(name: string): ?int {
        let aliases = this.modAliases.get(this.mod);
        if (aliases == null) {
            return null;
        }
        let target = aliases.modules.get(name);
        if (target != null) {
            let use = this.importUses.get(f"{this.mod}:{name}");
            if (use != null) {
                use.used = true;
            }
        }
        return target;
    }

    /// The key of what module `target` offers under `name`: its declaration's, or what it passes
    /// on with `pub import`.
    mut fn exportKey(target: int, name: string): string {
        var key = keyIn(this.modNames.get(target) ?? "", target, name);
        var hops = 0;
        while (hops < 64) {
            let on = this.reexports.get(key);
            if (on == null) {
                break;
            }
            key = on;
            hops += 1;
        }
        return key;
    }

    /// An import (Lyric 5 04 §4 rules 1–2): a selective one's names into the module's view, a
    /// qualified or aliased one's module under its name; `pub` passes them on.
    mut fn bindImport(im: ImportDecl): void {
        let path = im.path.join(".");
        // std.collections' names are the prelude's: an import of them, as Lyric 5's modules
        // write it, names what every module sees already (S7d4, P28)
        if (path == "std.collections") {
            if (!im.selective) {
                this.error(
                    "LYS-RES0003",
                    "std.collections is no module to name as a whole: its names are the prelude's, `import std.collections { Map }`",
                    im.span
                );
                return;
            }
            let names = collectionsNames();
            for (it in im.items) {
                if (!names.contains(it.name)) {
                    this.error(
                        "LYS-RES0004",
                        f"the module 'std.collections' declares no '{it.name}'",
                        it.span
                    );
                } else if (let alias = it.alias) {
                    // under a name of its own: the prelude's declaration, whose key is its name
                    if (this.noteImport(alias, it.span, im.isPub)) {
                        this.viewOf(this.mod).insert(alias, it.name);
                        this.notASubmodule(alias, it.span);
                    }
                }
            }
            return;
        }
        let target = this.modByName.get(path);
        if (target == null) {
            this.error("LYS-RES0003", f"no module '{path}'", im.span);
            return;
        }
        if (im.selective) {
            for (it in im.items) {
                let key = this.exportKey(target, it.name);
                let bound = it.alias ?? it.name;
                if (!this.noteImport(bound, it.span, im.isPub)) {
                    continue;
                }
                // a declaration of the module's own keeps its name
                let own = this.viewOf(this.mod).get(bound);
                if (own == null || own != this.declKey(bound)) {
                    this.viewOf(this.mod).insert(bound, key);
                }
                if (this.inPrelude(bound)) {
                    this.hidesPrelude(bound, it.span);
                }
                this.notASubmodule(bound, it.span);
                if (im.isPub) {
                    this.reexports.insert(this.declKey(bound), key);
                }
                this.imported.push(
                    ImportCheck {
                        key = key,
                        name = it.name,
                        bound = bound,
                        path = path,
                        from = this.mod,
                        target = target,
                        at = it.span,
                    }
                );
            }
            return;
        }
        let bound = im.alias ?? im.path[im.path.length() - 1];
        if (!this.noteImport(bound, im.span, im.isPub)) {
            return;
        }
        this.notASubmodule(bound, im.span);
        let known = this.modAliases.get(this.mod);
        let aliases = if (known != null) known
            else ModuleNames { modules = Map<string, int>.new() };
        aliases.modules.insert(bound, target);
        this.modAliases.insert(this.mod, aliases);
    }

    /// What the selective imports name: a declaration of the module (`LYS-RES0004`) its file does
    /// not keep to itself (`LYS-RES0009`); and the imports nothing uses (`LYS-SEM0072`).
    mut fn checkImports(): void {
        for (use in this.importOrder) {
            if (this.declaresOwn(use.mod, use.name)) {
                this.error(
                    "LYS-RES0001",
                    f"'{use.name}' is imported here and declared in this module too",
                    use.at
                );
                use.used = true;
            }
        }
        for (c in this.imported) {
            let known = this.typeIndex.containsKey(c.key)
                || this.fnByName.containsKey(c.key)
                || this.globalIndex.containsKey(c.key)
                || this.aliases.containsKey(c.key);
            let why = if (known) this.hiddenFrom(c.key, c.name, c.target, c.from) else null;
            let wrong = !known || why != null;
            if (!known) {
                this.error("LYS-RES0004", f"the module '{c.path}' declares no '{c.name}'", c.at);
            } else if (why != null) {
                this.error("LYS-RES0009", why, c.at);
            }
            if (wrong) {
                // an import said to be wrong is not also said to be unused
                let use = this.importUses.get(f"{c.from}:{c.bound}");
                if (use != null) {
                    use.used = true;
                }
            }
        }
    }

    /// An import that binds `bound` in the current module: unused until a name reads it, unless
    /// it passes the name on. `false` where an import of the module binds the name already
    /// (`LYS-RES0001`).
    mut fn noteImport(bound: string, at: Span, isPub: bool): bool {
        let slot = f"{this.mod}:{bound}";
        if (this.importUses.containsKey(slot)) {
            this.error("LYS-RES0001", f"'{bound}' is imported twice in this module", at);
            return false;
        }
        let use = ImportUse { name = bound, mod = this.mod, at = at, used = isPub };
        this.importUses.insert(slot, use);
        this.importOrder.push(use);
        return true;
    }

    /// The imports nothing used, once every body is checked.
    mut fn unusedImports(): void {
        for (use in this.importOrder) {
            if (!use.used) {
                this.warn("LYS-SEM0072", f"the import '{use.name}' is never used", use.at);
            }
        }
    }

    mut fn viewOf(m: int): Map<string, string> {
        let known = this.modScopes.get(m);
        if (known != null) {
            return known.names;
        }
        let made = View { names = Map<string, string>.new() };
        this.modScopes.insert(m, made);
        return made.names;
    }

    /// A name as the current module sees it: the key of its own declaration or of what it
    /// imports, the name itself for the prelude's and the builtins'. An imported module does not
    /// see the entry's names unimported.
    mut fn q(name: string): string {
        let view = this.modScopes.get(this.mod);
        if (view != null) {
            let key = view.names.get(name);
            if (key != null) {
                let use = this.importUses.get(f"{this.mod}:{name}");
                if (use != null) {
                    use.used = true;
                }
                return key;
            }
        }
        return name;
    }

    /// `Error`'s type: the prelude's interface.
    mut fn errorTy(): Ty {
        let i = this.typeIndex.get("Error");
        return if (i != null && this.types[i].kind == .Interface) Ty.Named(i) else Ty.Unknown;
    }

    /// The slot of `Error`'s member `name`; -1 for none.
    mut fn errorSlot(name: string): int {
        return match (this.errorTy()) {
            .Named(i) => this.types[i].slotOf.get(name) ?? -1,
            _ => -1,
        };
    }

    // --- reports ---------------------------------------------------------------------------------

    mut fn error(code: string, message: string, at: Span): void {
        this.errorHelp(code, message, null, at);
    }

    mut fn warn(code: string, message: string, at: Span): void {
        if (this.ctx.fixing) {
            return;
        }
        this.warnings.push(
            Diagnostic {
                code = code,
                message = message,
                start = at.start,
                end = at.end,
                line = at.line,
                column = at.column,
                help = null,
                file = at.file,
            }
        );
    }

    mut fn errorHelp(code: string, message: string, help: ?string, at: Span): void {
        // the first pass of 03 Leer reports nothing: the second reports what holds
        if (this.ctx.fixing) {
            return;
        }
        this.errors.push(
            Diagnostic {
                code = code,
                message = message,
                start = at.start,
                end = at.end,
                line = at.line,
                column = at.column,
                help = help,
                file = at.file,
            }
        );
    }

    /// A literal where its place's type takes it through a literal protocol (03 Lit): the type's
    /// own `from…Literal(lit)` — of an optional's value type too; nowhere else, and never a value
    /// that is no literal.
    mut fn literalOf(lit: TExpr, proto: string, member: string, expected: ?Ty): TExpr {
        if (expected == null) {
            return lit;
        }
        let target = match (expected) {
            .Optional(inner) => inner.value,
            _ => expected,
        };
        return this.literalBuilt(lit, proto, member, target) ?? lit;
    }

    /// The call of `target`'s `member` with the literal (none for `null`), where `target`
    /// conforms to the protocol; `null` where it does not.
    mut fn literalBuilt(lit: ?TExpr, proto: string, member: string, target: Ty): ?TExpr {
        let pi = this.typeIndex.get(this.q(proto));
        if (pi == null) {
            return null;
        }
        let args: TExpr[] = if (lit != null) [lit] else [];
        match (target) {
            .Named(i) => {
                let info = this.types[i];
                if (info.kind == .Interface || !this.conformsTo(target, pi)) {
                    return null;
                }
                let own = this.methodOf(i, member);
                if (own == null) {
                    return null;
                }
                if (this.functions[own].typeParams.length() > 0) {
                    return TExpr.CallGeneric(own, info.args, args, target);
                }
                return TExpr.Call(own, args, target);
            }
            .Param(k) => {
                if (!this.conformsTo(target, pi)) {
                    return null;
                }
                let found = this.ifaceMember(pi, member);
                if (found == null) {
                    return null;
                }
                let (_, slot) = found;
                return TExpr.CallStatic(k, pi, member, slot, args, target);
            }
            _ => {
                return null;
            }
        }
    }

    /// What a later milestone builds: reported, and the expression read as unknown.
    mut fn notYet(what: string, milestone: string, at: Span): TExpr {
        this.error("LYS-NYI0001", f"{what} comes with {milestone} of the plan to 1.0", at);
        return TExpr.Unknown;
    }

    // --- declarations ----------------------------------------------------------------------------

    mut fn declare(module: Module): void {
        // `Any`, the empty interface every struct, class, enum and built-in value is (05 §9); it
        // and `Identity` are the prelude's
        this.mod = -1;
        this.anyIndex = this.types.length();
        this.declareTypeName(
            "Any",
            TypeKind.Interface,
            Span { start = 0, end = 0, line = 1, column = 1 }
        );
        // `Identity`: a class compared by its reference (03 Eq)
        this.identityIndex = this.types.length();
        this.declareTypeName(
            "Identity",
            TypeKind.Interface,
            Span { start = 0, end = 0, line = 1, column = 1 }
        );
        // the names of the types first: fields and signatures may name any of them
        for (item in module.items) {
            this.mod = itemFile(item);
            match (item) {
                .Decl(d) => {
                    match (d) {
                        .Type(t) => {
                            this.declareTypeName(
                                t.name,
                                if (t.isClass) TypeKind.Class else TypeKind.Struct,
                                t.span
                            );
                            this.keepPrivate(t.name, t.isPub, t.isInternal);
                        }
                        .Enum(e) => {
                            this.declareTypeName(e.name, TypeKind.Enum, e.span);
                            this.keepPrivate(e.name, e.isPub, e.isInternal);
                        }
                        .Interface(i) => {
                            this.declareTypeName(i.name, TypeKind.Interface, i.span);
                            this.keepPrivate(i.name, i.isPub, i.isInternal);
                        }
                        .Extend(_) => { }
                        .Alias(a) => {
                            let key = this.declKey(a.name);
                            if (this.typeIndex.containsKey(key) || this.aliases.containsKey(key)) {
                                this.error("LYS-SEM0176", f"'{a.name}' is declared twice", a.span);
                            } else {
                                this.aliases.insert(key, a);
                                this.register(a.name, a.span);
                                this.keepPrivate(a.name, a.isPub, a.isInternal);
                            }
                        }
                        .Fn(f) => this.keepPrivate(f.name, f.isPub, f.isInternal),
                        .Import(im) => this.bindImport(im),
                    }
                }
                .Stmt(_) => { }
            }
        }
        // what `==` asks of a type parameter (S7c5a)
        this.equatableIndex = this.typeIndex.get("Equatable") ?? -1;
        this.synth.cloneIx = this.typeIndex.get("Clone") ?? -1;
        this.synth.defaultIx = this.typeIndex.get("Default") ?? -1;
        this.synth.hashableIx = this.typeIndex.get("Hashable") ?? -1;
        this.synth.hasherIx = this.typeIndex.get("Hasher") ?? -1;
        this.synth.debugIx = this.typeIndex.get("Debug") ?? -1;
        this.synth.displayIx = this.typeIndex.get("Display") ?? -1;
        this.synth.builderIx = this.typeIndex.get("StringBuilder") ?? -1;
        this.orderedIndex = this.typeIndex.get("Ordered") ?? -1;
        this.totalOrderIndex = this.typeIndex.get("TotalOrder") ?? -1;
        this.orderingIndex = this.typeIndex.get("Ordering") ?? -1;
        // the values the VM holds without a descriptor: boxed as interface values (S7c4b)
        for (held in ["Task", "Coroutine", "TaskScope", "Channel", "Semaphore"]) {
            if (let k = this.typeIndex.get(held)) {
                this.types[k].vmHeld = true;
            }
        }
        // which interfaces are a constraint only (05 §7 rule 3), before a type is resolved
        this.classifyInterfaces(module);
        // how many type arguments each interface takes, before any is declared: two may name each
        // other (S7c4c2: `Iterator.collect` names `FromIterator<…>`, whose member names
        // `Iterator`)
        for (item in module.items) {
            this.mod = itemFile(item);
            match (item) {
                .Decl(d) => match (d) {
                    .Interface(i) => this.declareArity(i),
                    // a generic type named before its declaration, `fn f(b: Box<int>)` (S7c4c3b;
                    // SEM0026 since S3g)
                    .Type(t) => this.declareTypeArity(t.name, t.typeParams),
                    .Enum(e) => this.declareTypeArity(e.name, e.typeParams),
                    _ => { }
                },
                .Stmt(_) => { }
            }
        }
        // then what they hold, and the functions' signatures
        for (item in module.items) {
            this.mod = itemFile(item);
            match (item) {
                .Decl(d) => {
                    match (d) {
                        .Type(t) => this.declareMembers(t),
                        .Enum(e) => this.declareEnum(e),
                        .Interface(i) => this.declareInterface(i),
                        .Extend(x) => this.declareExtend(x),
                        .Alias(a) => {
                            this.resolveAlias(a);
                        }
                        .Fn(f) => {
                            this.declareFn(f, -1);
                        }
                        .Import(_) => { }
                    }
                }
                .Stmt(_) => { }
            }
        }
        // the instances made before their template's members were known
        var ti = 0;
        while (ti < this.types.length()) {
            let t = this.types[ti];
            if (t.template >= 0 && t.template != ti) {
                this.fillInstance(ti);
            }
            ti += 1;
        }
        // the fields' defaults, now that every type is known
        for (item in module.items) {
            this.mod = itemFile(item);
            match (item) {
                .Decl(d) => {
                    match (d) {
                        .Type(t) => this.checkFieldDefaults(t),
                        .Enum(e) => this.checkVariantDefaults(e),
                        _ => { }
                    }
                }
                .Stmt(_) => { }
            }
        }
        // the conformances, now that every type and method is known
        for (item in module.items) {
            this.mod = itemFile(item);
            match (item) {
                .Decl(d) => {
                    match (d) {
                        .Type(t) => this.conform(t.name, t.conforms),
                        .Enum(e) => this.conform(e.name, e.conforms),
                        .Extend(x) => {
                            if (blanketTarget(x) >= 0) {
                                this.blanketConformance(x);
                                continue;
                            }
                            let inst = this.instanceBlocks.get(f"{x.span.file}:{x.span.start}");
                            if (inst != null) {
                                if (inst >= 0) {
                                    this.conformAt(inst, x.conforms);
                                }
                                continue;
                            }
                            match (x.target) {
                                .Named(name, _, _) => {
                                    this.blockCond = if (x.typeParams.length()
                                        > 0) this.typeParamsOf(x.typeParams)
                                        else [];
                                    this.blockSite = f"{x.span.file}:{x.span.start}";
                                    this.conform(name, x.conforms);
                                    this.blockSite = "";
                                    this.blockCond = [];
                                }
                                // `extend<T> T[] :: [I]`: every list's (S7c3)
                                .List(_, _) => {
                                    this.blockCond = if (x.typeParams.length()
                                        > 0) this.typeParamsOf(x.typeParams)
                                        else [];
                                    this.blockSite = f"{x.span.file}:{x.span.start}";
                                    this.conform("List", x.conforms);
                                    this.blockSite = "";
                                    this.blockCond = [];
                                }
                                // a function type, an optional, a tuple of the block's parameters
                                // (S7e2c), its conformances conditional on the block, as a list's
                                _ if (x.typeParams.length() > 0) => {
                                    let (kind, n) = shapeKindOf(x.target);
                                    let g = this.shapeTemplate(kind, n, false);
                                    if (g >= 0) {
                                        this.blockCond = this.typeParamsOf(x.typeParams);
                                        this.blockSite = f"{x.span.file}:{x.span.start}";
                                        this.conformAt(g, x.conforms);
                                        this.blockSite = "";
                                        this.blockCond = [];
                                    }
                                }
                                // a function type, an optional, a tuple at fixed types (S7e2)
                                _ => {
                                    let shape = this.resolveType(x.target);
                                    let i = if (hasParam(shape)) -1 else this.builtinOf(shape);
                                    if (i >= 0) {
                                        this.blockSite = f"{x.span.file}:{x.span.start}";
                                        this.conformAt(i, x.conforms);
                                        this.blockSite = "";
                                    }
                                }
                            }
                        }
                        _ => { }
                    }
                }
                .Stmt(_) => { }
            }
        }
        // what the blanket blocks that conform give the types they reach (05 §13 rule 8)
        this.conformBlankets();
        // what a synthesized `equals` or `compare` asks of the parts (Lyric 5 05 §14; S7c5b)
        this.checkSynthesized();
        // the members of one name a type has several of (05 §3, 08 §1.2; S7c5d2)
        this.checkSets();
        // a type's member that hides a blanket block's (05 §13 rule 7; S7c4c2)
        if (this.blanketFns.length() > 0) {
            for (item in module.items) {
                this.mod = itemFile(item);
                match (item) {
                    .Decl(d) => match (d) {
                        .Type(t) => this.warnHiddenBlankets(t.name, t.methods, t.span),
                        .Enum(e) => this.warnHiddenBlankets(e.name, e.methods, e.span),
                        _ => { }
                    },
                    .Stmt(_) => { }
                }
            }
        }
        this.checkAnswers(module);
        // the parameters' defaults: a call that leaves a parameter out gets its default where it
        // stands, so a default sees no parameter (Lyric 5 lets it read those before it)
        var k = 0;
        while (k < this.functions.length()) {
            let decl = this.fnDecls[k];
            if (decl != null) {
                this.mod = fileModule(decl.span.file);
                this.checkParamDefaults(k, decl);
                this.declareThrows(k, decl);
            }
            k += 1;
        }
    }

    /// A function's written `throws`: each type an `Error` (`LYS-SEM0030`), named once
    /// (`LYS-SEM0137`); the bare form is `throws Error` (06 §2 rules 1–2).
    mut fn declareThrows(k: int, decl: FnDecl): void {
        let clause = decl.throws;
        if (clause == null) {
            return;
        }
        let info = this.functions[k];
        let savedScope = this.typeParams;
        let savedGeneric = this.genericFn;
        if (info.typeParams.length() > 0) {
            let scope = Map<string, int>.new();
            var t = 0;
            for (tp in info.typeParams) {
                scope.insert(tp.name, t);
                t += 1;
            }
            this.typeParams = scope;
            this.genericFn = k;
        }
        let out = List<Ty>.new();
        if (clause.types.length() == 0) {
            out.push(this.errorTy());
        }
        for (x in clause.types) {
            let t = this.resolveType(x);
            if (t == .Unknown) {
                continue;
            }
            var twice = false;
            for (y in out) {
                twice = twice || y == t;
            }
            if (!this.throwable(t)) {
                this.error(
                    "LYS-SEM0030",
                    f"{this.tyName(t)} is not an Error: a 'throws' names what conforms to Error",
                    clause.span
                );
            } else if (twice) {
                this.error(
                    "LYS-SEM0137",
                    f"{this.tyName(t)} is named twice in this 'throws'",
                    clause.span
                );
            } else {
                out.push(t);
            }
        }
        info.throws = out.toArray();
        this.throwsAt.insert(k, clause.span);
        this.typeParams = savedScope;
        this.genericFn = savedGeneric;
    }

    /// The thrown sets, and the contracts written against them: a function's `throws` covers what
    /// it may throw (`LYS-SEM0034`, 06 §3 rule 3); an implementation of a member that writes
    /// `throws` throws at most that (`LYS-SEM0042`, §2 rule 4). Script infers the rest (05 K).
    mut fn checkThrows(): void {
        let ei = match (this.errorTy()) {
            .Named(i) => i,
            _ => -1,
        };
        if (ei < 0) {
            return;
        }
        let sets = ThrowSets.of(
            this.types.toArray(),
            this.functions.toArray(),
            ei,
            this.typeIndex.get("Cancelled") ?? -1,
            this.typeIndex.get("ChannelClosed") ?? -1
        );
        sets.infer();
        // a match over a clause's set covers the set (05 K7)
        for (m in this.laterMatches) {
            let reached = sets.reachedAt(m.key);
            if (reached.any) {
                this.errorHelp(
                    "LYS-SEM0050",
                    f"this match does not cover every value: any error may reach the clause (line {reached.anyLine})",
                    "add an arm with '_'",
                    m.at
                );
                continue;
            }
            var j = 0;
            while (j < reached.types.length()) {
                let t = reached.types[j];
                if (!sets.coveredWithin(t, m.types, m.key)) {
                    this.errorHelp(
                        "LYS-SEM0050",
                        f"this match does not cover every value: no arm takes _: {this.tyName(t)}",
                        "add an arm for it, or one with '_'",
                        m.at
                    );
                    break;
                }
                j += 1;
            }
        }
        var k = 0;
        while (k < this.functions.length()) {
            let written = this.functions[k].throws;
            let at = this.throwsAt.get(k);
            if (written != null && at != null) {
                let missed = sets.left(sets.setOf(k), written, k);
                for (what in this.thrownTexts(missed)) {
                    this.error(
                        "LYS-SEM0034",
                        f"'{this.functions[k].name}' {what}, which its 'throws' does not cover",
                        at
                    );
                }
            }
            k += 1;
        }
        for (t in this.types) {
            if (t.kind == .Interface) {
                continue;
            }
            // by slot, not by the map's order, which changes from run to run
            var slot = 0;
            while (slot < this.slotCount) {
                let impl = t.witness.get(slot);
                let member = if (impl == null) -1 else this.slotMember(slot);
                slot += 1;
                if (impl == null || member < 0 || impl == member) {
                    continue;
                }
                let written = this.functions[member].throws;
                let decl = this.fnDecls[impl];
                if (written == null || decl == null) {
                    continue;
                }
                let missed = sets.left(sets.setOf(impl), written, impl);
                for (what in this.thrownTexts(missed)) {
                    this.error(
                        "LYS-SEM0042",
                        f"'{t.name}.{this.functions[impl].name}' {what}, which the member it implements does not write in its 'throws'",
                        decl.span
                    );
                }
            }
        }
    }

    /// What a set says, a phrase each: anything, or a type, with the line it comes from.
    mut fn thrownTexts(set: Thrown): string[] {
        let out = List<string>.new();
        if (set.any) {
            out.push(
                f"may throw any Error (line {set.anyLine}: a function value, or an interface member without 'throws')"
            );
        }
        var k = 0;
        while (k < set.types.length()) {
            out.push(f"throws {this.tyName(set.types[k])} (line {set.lines[k]})");
            k += 1;
        }
        return out.toArray();
    }

    /// The interface member of a slot; -1 for none.
    mut fn slotMember(slot: int): int {
        for (t in this.types) {
            if (t.kind == .Interface) {
                for (name in t.slotOf.keys()) {
                    if (t.slotOf.get(name) == slot) {
                        return t.methods.get(name) ?? -1;
                    }
                }
            }
        }
        return -1;
    }

    mut fn checkParamDefaults(k: int, decl: FnDecl): void {
        let info = this.functions[k];
        let params = List<ParamInfo>.new();
        var j = 0;
        for (p in decl.params) {
            let t = info.params[j].ty;
            var dflt: ?TExpr = null;
            let written = p.default;
            if (written != null) {
                let saved = this.ctx;
                this.ctx = FnCtx.new(-1, Ty.Void, false, false);
                dflt = this.coerce(this.expr(written, t), t, spanOf(written));
                this.ctx = saved;
            }
            params.push(
                ParamInfo {
                    name = p.name,
                    ty = t,
                    default = dflt,
                    variadic = info.params[j].variadic,
                }
            );
            j += 1;
        }
        info.params = params.toArray();
    }

    mut fn declareTypeName(name: string, kind: TypeKind, at: Span): void {
        let key = this.declKey(name);
        if (this.typeIndex.containsKey(key) || this.aliases.containsKey(key)) {
            this.error("LYS-SEM0176", f"'{name}' is declared twice", at);
            return;
        }
        this.typeIndex.insert(key, this.types.length());
        this.register(name, at);
        this.types.push(
            TypeInfo { name = name, kind = kind, methods = Map<string, int>.new(), mod = this.mod }
        );
    }

    mut fn declareMembers(t: TypeDecl): void {
        let index = this.typeIndex.get(this.q(t.name));
        if (index == null) {
            return;
        }
        let info = this.types[index];
        if (info.kind == .Enum || info.name != t.name) {
            return;
        }
        let savedScope = this.typeParams;
        if (t.typeParams.length() > 0) {
            this.enterGenericType(index, t.typeParams);
        }
        defer {
            this.typeParams = savedScope;
            info.filled = true;
        }
        this.declareAnswers(index, t.answers);
        this.declareStatics(index, t.statics);
        let fields = List<FieldInfo>.new();
        let seen = Map<string, bool>.new();
        for (f in t.fields) {
            if (seen.containsKey(f.name)) {
                this.error("LYS-SEM0121", f"'{t.name}' has a second member '{f.name}'", f.span);
                continue;
            }
            seen.insert(f.name, true);
            if (f.isVar && !t.isClass) {
                this.error(
                    "LYS-SEM0901",
                    f"a struct's fields are never written: '{f.name}' takes no 'var' (a class's may)",
                    f.span
                );
            }
            fields.push(
                FieldInfo {
                    name = f.name,
                    ty = this.resolveType(f.type),
                    isVar = f.isVar,
                    default = null,
                }
            );
            if (!f.isPub) {
                info.hidden.insert(f.name);
            } else if (f.isInternal) {
                info.internalNames.insert(f.name);
            }
        }
        info.fields = fields.toArray();
        for (m in t.methods) {
            // a second member of a method's name joins its set, asked once the conformances
            // stand (S7c5d2); a field's name stays refused
            if (seen.containsKey(m.name) && !info.methods.containsKey(m.name)) {
                this.error("LYS-SEM0121", f"'{t.name}' has a second member '{m.name}'", m.span);
                continue;
            }
            let fi = this.declareFn(m, index);
            if (info.methods.containsKey(m.name)) {
                // the name's visibility is its first member's
                this.another(index, m.name, fi);
                continue;
            }
            seen.insert(m.name, true);
            info.methods.insert(m.name, fi);
            if (!m.isPub) {
                info.hidden.insert(m.name);
            } else if (m.isInternal) {
                info.internalNames.insert(m.name);
            }
        }
    }

    /// `interface I :: [P] { … }` (Lyric 5 05 §1): its members, each a slot of the program; a
    /// default's `this` is the interface value.
    /// Marks each interface whose members name `Self` beyond the receiver or are static — its
    /// members are generic over `Self` — and each that is a constraint only: that, a generic
    /// member, or a parent that is one (Lyric 5 05 §7 rule 3).
    mut fn classifyInterfaces(module: Module): void {
        // each with its module: a name resolves in the module that declares it (S7c4a — the
        // prelude's `Iterator` was read as the script's of that name)
        let decls = List<InterfaceDecl>.new();
        let files = List<int>.new();
        for (item in module.items) {
            match (item) {
                .Decl(d) => match (d) {
                    .Interface(i) => {
                        decls.push(i);
                        files.push(itemFile(item));
                    }
                    _ => { }
                },
                .Stmt(_) => { }
            }
        }
        var di = 0;
        for (i in decls) {
            this.mod = files[di];
            di += 1;
            let index = this.typeIndex.get(this.q(i.name));
            if (index == null) {
                continue;
            }
            let info = this.types[index];
            // its associated types (05 §8): a value of it would have no one signature
            let assoc = List<string>.new();
            for (a in i.assoc) {
                assoc.push(a.name);
                let d = a.default;
                if (d != null) {
                    this.assocDefaults.insert(f"{index}.{a.name}", d);
                }
                // its bounds: interfaces, as a type parameter's constraints (05 §8 rule 2)
                let bounds = List<int>.new();
                for (b in a.bounds) {
                    let bi = this.typeIndex.get(this.q(b.name));
                    if (bi == null || this.types[bi].kind != .Interface) {
                        this.error("LYS-SEM0078", f"'{b.name}' is no interface", b.span);
                        continue;
                    }
                    bounds.push(bi);
                }
                this.assocBounds.insert(f"{index}.{a.name}", bounds.toArray());
                if (!info.constraintOnly) {
                    info.constraintOnly = true;
                    info.onlyWhy = f"it declares the associated type '{a.name}'";
                }
            }
            info.assocNames = assoc.toArray();
            for (sl in i.statics) {
                info.selfParam = true;
                if (!info.hardOnly) {
                    info.hardOnly = true;
                    info.constraintOnly = true;
                    info.onlyWhy = f"its member '{sl.name}' is static";
                }
            }
            for (m in i.members) {
                // `Self` itself, or a static: a constraint only whatever is fixed; `Self.Item`
                // alone reads an associated type, which a value's type may fix (rule 6)
                var itself = m.isStatic;
                var through = false;
                for (p in m.params) {
                    itself = itself || mentionsSelfItself(p.type);
                    through = through || mentionsSelf(p.type);
                }
                let r = m.returns;
                if (r != null) {
                    itself = itself || mentionsSelfItself(r);
                    through = through || mentionsSelf(r);
                }
                if (itself || through) {
                    info.selfParam = true;
                }
                if (itself && !info.hardOnly) {
                    info.hardOnly = true;
                    info.constraintOnly = true;
                    info.onlyWhy = if (m.isStatic) f"its member '{m.name}' is static"
                        else f"its member '{m.name}' names 'Self' beyond the receiver";
                }
                if (m.typeParams.length() > 0 && !info.hardOnly) {
                    info.hardOnly = true;
                    info.constraintOnly = true;
                    info.onlyWhy = f"its member '{m.name}' is generic";
                }
            }
        }
        // a parent's members are the child's
        var changed = true;
        while (changed) {
            changed = false;
            for (i in decls) {
                let index = this.typeIndex.get(this.q(i.name));
                if (index == null || this.types[index].constraintOnly) {
                    continue;
                }
                for (p in i.parents) {
                    let pi = this.typeIndex.get(this.q(p.name));
                    if (pi != null && this.types[pi].constraintOnly) {
                        this.types[index].constraintOnly = true;
                        this.types[index].hardOnly = this.types[pi].hardOnly;
                        this.types[index].onlyWhy = f"its parent '{p.name}' is one";
                        changed = true;
                    }
                }
            }
        }
    }

    /// `T.Item`, `Self.Item`, `Bag.Item`: an associated type through a type (05 §8 rule 4).
    mut fn assocPath(path: string, at: Span): Ty {
        let parts = List<string>.new();
        for (p in path.split(".")) {
            parts.push(p.toString());
        }
        let head = parts[0];
        var base = Ty.Unknown;
        let pk = this.typeParams.get(head);
        if (pk != null) {
            base = Ty.Param(pk);
        } else if (head == "Self") {
            let s = this.selfTyIs;
            if (s == null) {
                this.error(
                    "LYS-SEM0011",
                    "'Self' names the type whose members these are: in an interface or a type",
                    at
                );
                return Ty.Unknown;
            }
            base = s;
        } else {
            let i = this.typeNamed(head);
            if (i < 0) {
                this.error("LYS-SEM0011", f"unknown type '{head}'", at);
                return Ty.Unknown;
            }
            base = this.selfTy(i);
        }
        var k = 1;
        while (k < parts.length()) {
            base = this.assocOf(base, parts[k], at);
            k += 1;
        }
        return base;
    }

    /// `Iterator<Item = int>`: the interface as the type of a value, its associated types fixed
    /// (05 §8 rule 6) — every one of them, where no member names `Self` itself or is static or
    /// generic (`LYS-SEM0126` otherwise). One entry per interface and fixations: a child of the
    /// interface, which gives the members, with the fixed types as its answers.
    mut fn fixedInterface(ii: int, args: TypeExpr[], at: Span): Ty {
        let base = this.types[ii];
        let fixed = Map<string, Ty>.new();
        let names = List<string>.new();
        let keys = List<string>.new();
        for (x in args) {
            let item = match (x) {
                .Named(n, inner, _) => if (n.startsWith("=")
                    && inner.length() == 1) n[1..].toString()
                    else "",
                _ => "",
            };
            if (item == "") {
                this.error(
                    "LYS-SEM0026",
                    f"'{base.name}' takes no type arguments: it fixes associated types, {base.name}<Item = T>",
                    at
                );
                return Ty.Unknown;
            }
            var declared = false;
            for (a in this.ancestry(ii)) {
                for (n in this.assocNamesOf(a)) {
                    declared = declared || n == item;
                }
            }
            if (!declared) {
                this.error(
                    "LYS-SEM0128",
                    f"'{base.name}' declares no associated type '{item}'",
                    at
                );
                return Ty.Unknown;
            }
            let ty = match (x) {
                .Named(_, inner, _) => this.resolveType(inner[0]),
                _ => Ty.Unknown,
            };
            fixed.insert(item, ty);
            names.push(f"{item} = {this.tyName(ty)}");
            keys.push(f"{item}={tyKey(ty)}");
        }
        if (base.hardOnly) {
            this.error(
                "LYS-SEM0126",
                f"'{base.name}' is a constraint only, no value of it arises: {base.onlyWhy}",
                at
            );
            return Ty.Unknown;
        }
        for (a in this.ancestry(ii)) {
            for (n in this.assocNamesOf(a)) {
                if (!fixed.containsKey(n)) {
                    this.error(
                        "LYS-SEM0126",
                        f"'{base.name}' as a value's type answers every associated type: '{n}' is left open",
                        at
                    );
                    return Ty.Unknown;
                }
            }
        }
        let key = f"{ii}<{keys.toArray().join(",")}>";
        let known = this.fixedForms.get(key);
        if (known != null) {
            return Ty.Named(known);
        }
        let index = this.types.length();
        this.types.push(
            TypeInfo {
                name = f"{base.name}<{names.toArray().join(", ")}>",
                kind = TypeKind.Interface,
                methods = Map<string, int>.new(),
            }
        );
        let info = this.types[index];
        info.template = ii;
        info.parents = [ii];
        info.answers = fixed;
        this.fixedForms.insert(key, index);
        return Ty.Named(index);
    }

    /// Whether `args` meet the constraints of a generic block's parameters.
    mut fn meetsBlock(args: Ty[], params: TypeParamInfo[]): bool {
        var k = 0;
        for (tp in params) {
            if (k < args.length()) {
                for (c in tp.constraints) {
                    if (args[k] != .Unknown && !this.conformsTo(args[k], c)) {
                        return false;
                    }
                }
            }
            k += 1;
        }
        return true;
    }

    /// The bounds of associated type `name` of interface `ii`.
    mut fn boundsOf(ii: int, name: string): int[] {
        return this.assocBounds.get(f"{this.ifaceBase(ii)}.{name}") ?? [];
    }

    /// The associated type `item` of `base`: through a type parameter the constraint that
    /// declares it; of a type its answer (`LYS-SEM0128` where there is none).
    mut fn assocOf(base: Ty, item: string, at: Span): Ty {
        match (base) {
            .Param(k) => {
                let infos = if (this.genericFn >= 0) this.functions[this.genericFn].typeParams
                    else this.declaringParams;
                if (k < infos.length()) {
                    // fixed by a constraint: the type itself, wherever it stands (rule 5)
                    for (f in infos[k].fixed) {
                        if (f.name == item) {
                            return f.ty;
                        }
                    }
                    // the instance the constraint names: `T :: [Mul<float>]` reads `Mul<float>`'s
                    // answer in each copy (S7c5d3)
                    for (c in infos[k].constraints) {
                        for (x in this.ancestry(c)) {
                            for (n in this.assocNamesOf(x)) {
                                if (n == item) {
                                    return Ty.Assoc(boxTy(base), x, item);
                                }
                            }
                        }
                    }
                }
                this.error(
                    "LYS-SEM0128",
                    f"no constraint of {this.tyName(base)} declares an associated type '{item}'",
                    at
                );
                return Ty.Unknown;
            }
            .Unknown => {
                return Ty.Unknown;
            }
            // through an associated type: what its bounds declare (05 §8 rule 4)
            .Assoc(_, ii, n) => {
                for (b in this.boundsOf(ii, n)) {
                    for (x in this.ancestry(b)) {
                        for (m in this.assocNamesOf(x)) {
                            if (m == item) {
                                return Ty.Assoc(boxTy(base), this.ifaceBase(x), item);
                            }
                        }
                    }
                }
                this.error(
                    "LYS-SEM0128",
                    f"no bound of {this.tyName(base)} declares an associated type '{item}'",
                    at
                );
                return Ty.Unknown;
            }
            _ => { }
        }
        let answer = this.answerOf(base, item);
        if (answer == null) {
            this.error(
                "LYS-SEM0128",
                f"'{this.tyName(base)}' answers no associated type '{item}'",
                at
            );
            return Ty.Unknown;
        }
        return answer;
    }

    /// The type a constraint of type parameter `k` fixes associated type `item` to, where one does
    /// (05 §8 rule 5): in the body being checked, or the declaration being read.
    mut fn fixedAt(k: int, item: string, ii: int): ?Ty {
        let infos = if (this.genericFn >= 0) this.functions[this.genericFn].typeParams
            else this.declaringParams;
        if (k < infos.length()) {
            for (f in infos[k].fixed) {
                if (f.name == item && f.iface == ii) {
                    return f.ty;
                }
            }
        }
        return this.fixedOf(k, item);
    }

    /// The type a constraint of type parameter `k` fixes associated type `item` to (05 §8 rule 5),
    /// whichever constraint.
    mut fn fixedOf(k: int, item: string): ?Ty {
        let infos = if (this.genericFn >= 0) this.functions[this.genericFn].typeParams
            else this.declaringParams;
        if (k < infos.length()) {
            for (f in infos[k].fixed) {
                if (f.name == item) {
                    return f.ty;
                }
            }
        }
        return null;
    }

    /// The associated type `item` of `t` where a call checks a fixation: a type's answer, or
    /// what a type parameter's constraints say of it; unknown where nothing does.
    mut fn answerThrough(t: Ty, item: string, at: Span): Ty {
        return match (t) {
            .Param(_) | .Assoc(_, _, _) => {
                let saved = this.errors.length();
                let r = this.assocOf(t, item, at);
                // a missing one is reported where it is declared, not here
                while (this.errors.length() > saved) {
                    this.errors.pop();
                }
                r
            }
            _ => this.answerOf(t, item) ?? Ty.Unknown,
        };
    }

    /// A type's answer to the associated type `item`; an instance's is its template's at its
    /// arguments.
    mut fn answerOf(t: Ty, item: string): ?Ty {
        let e = this.entryOf(t);
        if (e < 0) {
            return null;
        }
        let info = this.types[e];
        let own = info.answers.get(item);
        if (own != null) {
            return own;
        }
        if (info.template >= 0 && info.template != e) {
            let tmpl = this.types[info.template].answers.get(item);
            if (tmpl != null) {
                return this.subst(tmpl, info.args);
            }
        }
        return null;
    }

    /// The answers a type's body or extend block writes (05 §8 rule 3), `Self` its type.
    mut fn declareAnswers(index: int, answers: TypeAnswer[]): void {
        let info = this.types[index];
        let saved = this.selfTyIs;
        this.selfTyIs = this.selfTy(index);
        for (a in answers) {
            if (info.answers.containsKey(a.name)) {
                this.error("LYS-SEM0121", f"'{info.name}' answers '{a.name}' twice", a.span);
                continue;
            }
            let t = this.resolveType(a.type);
            info.answers.insert(a.name, t);
            info.bodyAnswers.insert(a.name, t);
        }
        this.selfTyIs = saved;
    }

    /// A conformance block's answers: its conformances' (05 §8 rule 3; S7c5d3) — `Mul<int>` and
    /// `Mul<float>` each answer `Out` in their own block —, the type's while the block's
    /// signatures are read (`restoreAnswers` after).
    mut fn declareBlockAnswers(index: int, x: ExtendDecl): void {
        let info = this.types[index];
        let saved = this.selfTyIs;
        this.selfTyIs = this.selfTy(index);
        let mine = Map<string, Ty>.new();
        for (a in x.answers) {
            if (mine.containsKey(a.name) || info.bodyAnswers.containsKey(a.name)) {
                this.error("LYS-SEM0121", f"'{info.name}' answers '{a.name}' twice", a.span);
                continue;
            }
            let t = this.resolveType(a.type);
            mine.insert(a.name, t);
            this.siteAnswers.insert(f"{x.span.file}:{x.span.start}#{a.name}", t);
            if (let before = info.answers.get(a.name)) {
                this.answersBefore.push((a.name, before));
            } else {
                this.answersAbsent.push(a.name);
            }
            info.answers.insert(a.name, t);
        }
        this.selfTyIs = saved;
    }

    /// The type's answers again after a conformance block's signatures are read: another
    /// conformance does not take the block's (S7c5d3; `int`'s `Neg` took `Add<float>`'s `Out`).
    mut fn restoreAnswers(index: int): void {
        let info = this.types[index];
        for (n in this.answersAbsent) {
            info.answers.remove(n);
        }
        for (x in this.answersBefore) {
            let (n, t) = x;
            info.answers.insert(n, t);
        }
        this.answersAbsent = List<string>.new();
        this.answersBefore = List<(string, Ty)>.new();
    }

    /// The answer to `n` type `index`'s conformance to `ii` takes, at `at` where it has none: the
    /// block's, which is its conformances' (05 §8 rule 3; S7c5d3), else the body's; an instance of
    /// a generic interface takes no other block's, a conformance to another interface — one per
    /// type — the type's; else the default (`LYS-SEM0128` where there is none).
    mut fn conformanceAnswer(index: int, ii: int, n: string, at: Span): ?Ty {
        let info = this.types[index];
        if (this.blockSite != "") {
            if (let t = this.siteAnswers.get(f"{this.blockSite}#{n}")) {
                return t;
            }
        }
        if (let t = info.bodyAnswers.get(n)) {
            return t;
        }
        if (this.ifaceBase(ii) == ii) {
            if (let t = info.answers.get(n)) {
                return t;
            }
        }
        if (let d = this.assocDefaults.get(f"{this.ifaceBase(ii)}.{n}")) {
            let saved = this.selfTyIs;
            this.selfTyIs = this.selfTy(index);
            let t = this.resolveType(d);
            this.selfTyIs = saved;
            return t;
        }
        this.error(
            "LYS-SEM0128",
            f"'{info.name}' does not answer '{this.types[this.ifaceBase(ii)].name}.{n}'",
            at
        );
        return null;
    }

    /// A type's answer to `item` for its conformance to interface `ii` — `Mul<float>`'s beside
    /// `Mul<int>`'s (05 §8 rule 3; S7c5d3), an instance's its template's at its arguments —; else
    /// its answer.
    mut fn answerIn(t: Ty, ii: int, item: string): ?Ty {
        let e = this.entryOf(t);
        if (e < 0) {
            return null;
        }
        let info = this.types[e];
        if (let own = info.instAnswers.get(f"{ii}.{item}")) {
            return own;
        }
        if (info.template >= 0 && info.template != e) {
            let tmpl = this.types[info.template];
            for (x in tmpl.ifaces) {
                if (this.ifaceAt(x, info.args) == ii) {
                    if (let a = tmpl.instAnswers.get(f"{x}.{item}")) {
                        return this.subst(a, info.args);
                    }
                }
            }
        }
        return this.answerOf(t, item);
    }

    /// `answerThrough` for a fixation of interface `ii` (S7c5d3): a type's answer for that
    /// conformance.
    mut fn answerThroughAt(t: Ty, ii: int, item: string, at: Span): Ty {
        return match (t) {
            .Param(_) | .Assoc(_, _, _) => this.answerThrough(t, item, at),
            _ => this.answerIn(t, ii, item) ?? Ty.Unknown,
        };
    }

    /// The interface an associated type `Self.<name>` of interface `ii`, read at `a`, belongs to:
    /// inside a generic interface's own declaration it names the template, and the interface's
    /// binds — `Self`, then its parameters — make the instance (S7c5d3); else `ii`.
    mut fn assocAt(ii: int, b: Ty, a: Ty[]): int {
        let base = this.ifaceBase(ii);
        let count = this.types[base].typeParams.length();
        if (base != ii || count == 0 || a.length() < count + 1) {
            return ii;
        }
        let selfParam = match (b) {
            .Param(k) => k == 0,
            _ => false,
        };
        if (!selfParam) {
            return ii;
        }
        let args = sliceOf(a, 1, count + 1);
        for (x in args) {
            if (x == .Unknown) {
                return ii;
            }
        }
        return this.typeInstance(base, args);
    }

    /// Every type's answers: each one an interface of the type asks for (`LYS-SEM0129`).
    mut fn checkAnswers(module: Module): void {
        for (item in module.items) {
            this.mod = itemFile(item);
            match (item) {
                .Decl(d) => match (d) {
                    .Type(t) => this.answersAsked(t.name, t.answers),
                    .Enum(e) => this.answersAsked(e.name, e.answers),
                    .Extend(x) => match (x.target) {
                        .Named(name, _, _) => {
                            if (blanketTarget(x) < 0) {
                                this.answersAsked(name, x.answers);
                            }
                        }
                        _ => { }
                    },
                    _ => { }
                },
                .Stmt(_) => { }
            }
        }
    }

    mut fn answersAsked(name: string, answers: TypeAnswer[]): void {
        let index = this.typeNamed(name);
        if (index < 0) {
            return;
        }
        for (a in answers) {
            var asked = false;
            for (ii in this.types[index].ifaces) {
                for (n in this.assocNamesOf(ii)) {
                    asked = asked || n == a.name;
                }
            }
            if (!asked) {
                this.error(
                    "LYS-SEM0129",
                    f"no interface of '{this.types[index].name}' asks for an associated type '{a.name}'",
                    a.span
                );
            }
        }
    }

    /// What `Self` names in the members of `owner`: the type itself (a generic one at its own
    /// parameters, a built-in's its type); in an interface generic over `Self`, its parameter.
    mut fn selfFor(owner: int): ?Ty {
        if (owner < 0) {
            return null;
        }
        let info = this.types[owner];
        if (info.kind == .Interface) {
            return if (info.selfParam) Ty.Param(0) else null;
        }
        return this.selfTy(owner);
    }

    /// A generic interface's parameters by name, their constraints to come with its declaration,
    /// and what an instance takes over from it (S7c4c2).
    mut fn declareTypeArity(name: string, params: TypeParam[]): void {
        let index = this.typeIndex.get(this.q(name));
        if (index == null || params.length() == 0) {
            return;
        }
        let info = this.types[index];
        if (info.kind == .Interface || info.name != name || info.typeParams.length() > 0) {
            return;
        }
        let ps = List<TypeParamInfo>.new();
        let own = List<Ty>.new();
        var j = 0;
        for (tp in params) {
            ps.push(
                TypeParamInfo {
                    name = tp.name,
                    constraints = [],
                    defaultType = tp.defaultType,
                    defaultMod = this.mod,
                }
            );
            own.push(Ty.Param(j));
            j += 1;
        }
        info.typeParams = ps.toArray();
        info.template = index;
        info.args = own.toArray();
    }

    mut fn declareArity(i: InterfaceDecl): void {
        let index = this.typeIndex.get(this.q(i.name));
        if (index == null || i.typeParams.length() == 0) {
            return;
        }
        let info = this.types[index];
        if (info.kind != .Interface || info.name != i.name) {
            return;
        }
        let ps = List<TypeParamInfo>.new();
        let own = List<Ty>.new();
        var j = 0;
        for (tp in i.typeParams) {
            ps.push(
                TypeParamInfo {
                    name = tp.name,
                    constraints = [],
                    defaultType = tp.defaultType,
                    defaultMod = this.mod,
                }
            );
            own.push(Ty.Param(j));
            j += 1;
        }
        info.typeParams = ps.toArray();
        info.template = index;
        info.args = own.toArray();
        info.sealed = i.sealed;
    }

    mut fn declareInterface(i: InterfaceDecl): void {
        let index = this.typeIndex.get(this.q(i.name));
        if (index == null) {
            return;
        }
        let info = this.types[index];
        if (info.kind != .Interface || info.name != i.name) {
            return;
        }
        info.sealed = i.sealed;
        // a generic interface (S7c1; Lyric 5 §5): its parameters in scope for its parents and its
        // members, which are generic over them as a generic type's methods are
        let savedScope = this.typeParams;
        let savedDeclaring = this.declaringParams;
        if (i.typeParams.length() > 0) {
            info.typeParams = this.typeParamsOf(i.typeParams);
            let scope = Map<string, int>.new();
            let own = List<Ty>.new();
            var j = 0;
            for (tp in i.typeParams) {
                scope.insert(tp.name, j);
                own.push(Ty.Param(j));
                j += 1;
            }
            this.typeParams = scope;
            this.declaringParams = info.typeParams;
            info.template = index;
            info.args = own.toArray();
        }
        let parents = List<int>.new();
        for (p in i.parents) {
            let named = this.typeIndex.get(this.q(p.name));
            if (named == null || this.types[named].kind != .Interface || named == index) {
                this.error(
                    "LYS-SEM0078",
                    f"'{p.name}' is no interface {i.name} can extend",
                    p.span
                );
                continue;
            }
            let pi = this.ifaceOf(p);
            if (pi >= 0) {
                parents.push(pi);
            }
        }
        info.parents = parents.toArray();
        // a member of an interface generic over `Self` takes `Self` first, the interface's own
        // parameters after it (S7c1b)
        if (info.selfParam && i.typeParams.length() > 0) {
            let shifted = Map<string, int>.new();
            var j = 0;
            for (tp in i.typeParams) {
                shifted.insert(tp.name, j + 1);
                j += 1;
            }
            this.typeParams = shifted;
        }
        let names = List<string>.new();
        for (m in i.members) {
            if (info.methods.containsKey(m.name)) {
                this.error("LYS-SEM0121", f"'{i.name}' has a second member '{m.name}'", m.span);
                continue;
            }
            let fi = this.declareFn(m, index);
            match (m.body) {
                .None => {
                    this.functions[fi].abstract = true;
                }
                // a default member of a generic interface is copied for each instance (S7c1b)
                _ => { }
            }
            // a member of its own type parameters has its interface's before them (S7c4c1)
            if (i.typeParams.length() > 0 && m.typeParams.length() == 0) {
                this.functions[fi].typeParams = info.typeParams;
            }
            if (info.selfParam && m.typeParams.length() == 0) {
                // generic over `Self`, the conformer, bound by the receiver or the type; then over
                // the interface's parameters (S7c1b)
                this.functions[fi].typeParams = this.selfFirst(index, info.typeParams);
            }
            info.methods.insert(m.name, fi);
            info.slotOf.insert(m.name, this.slotCount);
            this.slotCount += 1;
            names.push(m.name);
        }
        // its constants: each conformer gives its own (05 §7 rule 2), read through a getter
        let savedSelf = this.selfTyIs;
        this.selfTyIs = this.selfFor(index);
        for (sl in i.statics) {
            if (sl.value != null) {
                this.error(
                    "LYS-SEM0127",
                    f"'{i.name}.{sl.name}' has no value: each conformer gives its own",
                    sl.span
                );
            }
            if (info.methods.containsKey(sl.name)) {
                this.error("LYS-SEM0121", f"'{i.name}' has a second member '{sl.name}'", sl.span);
                continue;
            }
            let written = sl.type;
            let ty = if (written != null) this.resolveType(written) else Ty.Unknown;
            let fi = this.functions.length();
            this.functions.push(
                FnInfo { name = sl.name, owner = index, isStatic = true, line = sl.span.line }
            );
            this.fnDecls.push(null);
            this.fnStates.push(FnState.Done);
            let f = this.functions[fi];
            f.returns = ty;
            f.abstract = true;
            f.typeParams = this.selfFirst(index, info.typeParams);
            info.methods.insert(sl.name, fi);
            info.slotOf.insert(sl.name, this.slotCount);
            this.slotCount += 1;
            names.push(sl.name);
        }
        this.selfTyIs = savedSelf;
        info.memberNames = names.toArray();
        this.typeParams = savedScope;
        this.declaringParams = savedDeclaring;
    }

    /// The interface a written conformance or constraint names (S7c1): the interface, or its
    /// instance at the type arguments written, `I<int>`; -1 for none (`LYS-SEM0078`) or arguments
    /// that do not fit (`LYS-SEM0026`).
    mut fn ifaceOf(c: Conformance): int {
        let ii = this.typeIndex.get(this.q(c.name));
        if (ii == null || this.types[ii].kind != .Interface) {
            this.error("LYS-SEM0078", f"'{c.name}' is no interface", c.span);
            return -1;
        }
        let n = this.types[ii].typeParams.length();
        if (n == 0 && c.args.length() == 0) {
            return ii;
        }
        let tys = List<Ty>.new();
        for (x in c.args) {
            tys.push(this.resolveType(x));
        }
        // fewer arguments: the defaults of the trailing ones (S7c5c1)
        let all = if (c.args.length() <= n) this.withDefaults(
            this.types[ii].typeParams,
            tys.toArray(),
            this.defaultSelf ?? this.selfTyIs
        )
            else null;
        if (all == null) {
            this.error(
                "LYS-SEM0026",
                f"'{c.name}' takes {n} type arguments, not {c.args.length()}",
                c.span
            );
            return -1;
        }
        this.exactInstance = true;
        let inst = this.typeInstance(ii, all);
        this.exactInstance = false;
        return inst;
    }

    /// The arguments of a generic whose parameters are `params`, written as `given` — the trailing
    /// ones left out taking their defaults (Lyric 5 03 §9.1 rule 5; S7c5c1): each read where the
    /// generic is declared, its earlier parameters the arguments, `Self` the type `self` says;
    /// null where one without a default is left out.
    mut fn withDefaults(params: TypeParamInfo[], given: Ty[], self: ?Ty): ?Ty[] {
        if (given.length() >= params.length()) {
            return given;
        }
        let n = params.length();
        let out = List<Ty>.new();
        for (x in given) {
            out.push(x);
        }
        let scope = Map<string, int>.new();
        var j = 0;
        for (p in params) {
            scope.insert(p.name, j);
            j += 1;
        }
        var k = given.length();
        while (k < n) {
            let d = params[k].defaultType;
            if (d == null) {
                return null;
            }
            // read in the declaration's own terms — its parameters by position, `Self` one past
            // them —, then put in place at once
            let savedMod = this.mod;
            let savedScope = this.typeParams;
            let savedSelf = this.selfTyIs;
            this.mod = params[k].defaultMod;
            this.typeParams = scope;
            this.selfTyIs = Ty.Param(n);
            let written = this.resolveType(d);
            this.mod = savedMod;
            this.typeParams = savedScope;
            this.selfTyIs = savedSelf;
            let at = List<Ty>.new();
            for (x in out) {
                at.push(x);
            }
            while (at.length() < n) {
                at.push(Ty.Unknown);
            }
            at.push(self ?? Ty.Unknown);
            out.push(this.subst(written, at.toArray()));
            k += 1;
        }
        return out.toArray();
    }

    /// `Self` of interface `index`, then its own parameters: what a member generic over `Self` is
    /// generic over (S7c1b).
    fn selfFirst(index: int, params: TypeParamInfo[]): TypeParamInfo[] {
        let out = List<TypeParamInfo>.new();
        out.push(TypeParamInfo { name = "Self", constraints = [index] });
        for (p in params) {
            out.push(p);
        }
        return out.toArray();
    }

    /// The type arguments a call of member `fi` of interface `ii` binds (S7c1b): `self`, the
    /// receiver's type, where the member is generic over `Self`, then the arguments of the instance
    /// of a generic interface that declares it.
    mut fn bindsOf(fi: int, ii: int, self: Ty): Ty[] {
        let out = List<Ty>.new();
        if (this.selfGeneric(fi)) {
            out.push(self);
        }
        for (x in this.memberBinds(ii, this.functions[fi].name)) {
            out.push(x);
        }
        return out.toArray();
    }

    /// The associated types interface `x` declares: an instance of a generic interface its
    /// template's (S7c2).
    mut fn assocNamesOf(x: int): string[] {
        return this.types[this.ifaceBase(x)].assocNames;
    }

    /// The interface whose members, slots and associated types `ii` has: the template of an
    /// instance of a generic interface, else `ii` (S7c1).
    mut fn ifaceBase(ii: int): int {
        let t = this.types[ii].template;
        return if (t >= 0 && t != ii && this.types[t].typeParams.length() > 0) t else ii;
    }

    /// The type arguments a member `name` of interface `ii` is called with: those of the instance
    /// of a generic interface that declares it, among `ii`'s ancestry; none for another (S7c1).
    mut fn memberBinds(ii: int, name: string): Ty[] {
        for (a in this.ancestry(ii)) {
            let base = this.ifaceBase(a);
            if (this.types[base].methods.containsKey(name)) {
                // the template itself stands for its own parameters: `Source<T>` in a generic of
                // `T` is the template at `T`
                return if (this.types[base].typeParams.length() > 0) this.types[a].args else [];
            }
        }
        return [];
    }

    /// The parents of interface `ii`: its own, or for an instance of a generic interface its
    /// template's at the instance's arguments (S7c1) — made when asked, since an instance may be
    /// made before its template's parents are read.
    mut fn parentsOf(ii: int): int[] {
        let base = this.ifaceBase(ii);
        if (base == ii) {
            return this.types[ii].parents;
        }
        let args = this.types[ii].args;
        let out = List<int>.new();
        for (p in this.types[base].parents) {
            let pt = this.ifaceBase(p);
            if (pt == p && this.types[p].typeParams.length() == 0) {
                out.push(p);
                continue;
            }
            let a = List<Ty>.new();
            for (x in this.types[p].args) {
                a.push(this.subst(x, args));
            }
            out.push(
                this.typeInstance(
                    if (this.types[p].template >= 0) this.types[p].template else p,
                    a.toArray()
                )
            );
        }
        return out.toArray();
    }

    /// A type's constants (05 §7 rule 2): each a global the script sets where it begins, and a
    /// static getter, the member an interface's constant is answered by.
    mut fn declareStatics(index: int, statics: StaticLet[]): void {
        let info = this.types[index];
        let savedSelf = this.selfTyIs;
        this.selfTyIs = this.selfTy(index);
        for (sl in statics) {
            let value = sl.value;
            let written = sl.type;
            if (value == null || written == null) {
                this.error(
                    "LYS-SEM0010",
                    f"'{info.name}.{sl.name}' needs its type and its value: static let {sl.name}: T = …",
                    sl.span
                );
                continue;
            }
            if (info.methods.containsKey(sl.name)) {
                this.error(
                    "LYS-SEM0121",
                    f"'{info.name}' has a second member '{sl.name}'",
                    sl.span
                );
                continue;
            }
            let ty = this.resolveType(written);
            let g = this.globals.length();
            let gname = f"{info.name}.{sl.name}";
            this.globals.push(GlobalInfo { name = gname, ty = ty, isVar = false });
            this.globalIndex.insert(gname, g);
            info.staticLets.insert(sl.name, g);
            let fi = this.functions.length();
            this.functions.push(
                FnInfo { name = sl.name, owner = index, isStatic = true, line = sl.span.line }
            );
            this.fnDecls.push(null);
            this.fnStates.push(FnState.Done);
            let f = this.functions[fi];
            f.returns = ty;
            f.body = [TStmt.Return(TExpr.Global(g, ty), sl.span.line)];
            info.methods.insert(sl.name, fi);
            this.staticInits.push(StaticInit { global = g, value = value, ty = ty, owner = index });
        }
        this.selfTyIs = savedSelf;
    }

    /// The statements that set the types' constants, before the script's own (05 §7 rule 2).
    mut fn staticInitStmts(): TStmt[] {
        let out = List<TStmt>.new();
        for (si in this.staticInits) {
            let saved = this.selfTyIs;
            this.selfTyIs = this.selfTy(si.owner);
            let v = this.coerce(this.expr(si.value, si.ty), si.ty, spanOf(si.value));
            this.selfTyIs = saved;
            out.push(TStmt.SetGlobal(si.global, v, spanOf(si.value).line));
        }
        return out.toArray();
    }

    /// `extend T { … }`: methods added to a type of the program (on a built-in type with S3f's
    /// boxes); its conformances are checked with the others.
    mut fn declareExtend(x: ExtendDecl): void {
        for (tp in x.typeParams) {
            if (tp.defaultType != null) {
                this.error(
                    "LYS-SEM0026",
                    f"'{tp.name}' of an extend block takes no default: the target binds it",
                    tp.span
                );
            }
        }
        let at = blanketTarget(x);
        if (at >= 0) {
            this.declareBlanket(x, at);
            return;
        }
        // `extend Box<int> { … }`, `extend int[] { … }`: a block on one instance (S7c4c3b)
        let inst = this.instanceTarget(x);
        if (inst != -1) {
            this.instanceBlocks.insert(f"{x.span.file}:{x.span.start}", inst);
            if (inst >= 0) {
                this.declareInstanceBlock(inst, x);
            }
            return;
        }
        let name = match (x.target) {
            .Named(n, _, _) => n,
            .List(_, _) => "List",
            _ => "",
        };
        // a function type, an optional, a tuple (Lyric 5 05 §13 rule 6; S7e2): at fixed types an
        // entry of its own; over a block's parameters not yet
        var index = -1;
        if (name == "" && x.typeParams.length() > 0) {
            // over a shape of the block's parameters (S7e2c): the template of its kind and arity
            let (kind, n) = shapeKindOf(x.target);
            index = this.shapeTemplate(kind, n, true);
            if (index < 0) {
                this.error(
                    "LYS-SEM0124",
                    "a generic block's target is its type at the block's parameters, in their order",
                    x.span
                );
                return;
            }
        } else if (name == "") {
            let shape = this.resolveType(x.target);
            if (hasParam(shape)) {
                this.error(
                    "LYS-SEM0124",
                    "a generic block's target is its type at the block's parameters, in their order",
                    x.span
                );
                return;
            }
            index = this.builtinOf(shape);
            if (index < 0) {
                this.error(
                    "LYS-SEM0124",
                    f"'{this.tyName(shape)}' is no type an extend block adds to",
                    x.span
                );
                return;
            }
        } else {
            index = this.typeNamed(name);
        }
        if (index < 0 || this.types[index].kind == .Interface) {
            this.error(
                "LYS-SEM0124",
                f"'{name}' is no type an extend block adds to: a struct, class, enum or built-in type",
                x.span
            );
            return;
        }
        let info = this.types[index];
        if (x.typeParams.length() > 0) {
            this.declareBlock(index, x);
            return;
        }
        if (x.conforms.length() > 0) {
            this.declareBlockAnswers(index, x);
        } else {
            this.declareAnswers(index, x.answers);
        }
        this.declareStatics(index, x.statics);
        for (m in x.methods) {
            let fi = this.declareFn(m, index);
            // a conformance block's member answers its block's conformances (05 §3 rule 4;
            // S7c5d2)
            if (x.conforms.length() > 0) {
                this.memberSite.insert(fi, f"{x.span.file}:{x.span.start}");
            }
            if (info.methods.containsKey(m.name)) {
                this.another(index, m.name, fi);
            } else {
                info.methods.insert(m.name, fi);
            }
        }
        this.restoreAnswers(index);
    }

    /// Adds `fi` to the members of `name` that type `index` has more than one of (S7c5d2).
    mut fn another(index: int, name: string, fi: int): void {
        let info = this.types[index];
        if (let set = info.sets.get(name)) {
            set.push(fi);
            return;
        }
        let set = List<int>.new();
        set.push(info.methods.get(name) ?? fi);
        set.push(fi);
        info.sets.insert(name, set);
        info.setNames.push(name);
    }

    /// Where function `fi` is declared; nowhere for one the compiler made.
    fn fnSpan(fi: int): Span {
        if (let d = this.fnDecls[fi]) {
            return d.span;
        }
        return nowhereSpan;
    }

    /// The instance a block without parameters names — `Box<int>`, `int[]` (05 §13 rule 1;
    /// S7c4c3b) —; -1 for a target that is no instance, -2 for one refused already.
    mut fn instanceTarget(x: ExtendDecl): int {
        if (x.typeParams.length() > 0) {
            return -1;
        }
        let written = match (x.target) {
            .Named(_, targs, _) => targs.length() > 0,
            .List(_, _) => true,
            _ => false,
        };
        if (!written) {
            return -1;
        }
        return match (this.resolveType(x.target)) {
            .Named(j) => if (this.types[j].template >= 0 && this.types[j].template != j) j else -2,
            .List(e) => if (hasParam(Ty.List(e))) -2 else this.entryOf(Ty.List(e)),
            _ => -2,
        };
    }

    /// A block on instance `inst` alone: its answers, constants and members that instance's,
    /// checked at it (`this` a `Box<int>`), no other instance's (05 §13 rules 1–2; S7c4c3b).
    mut fn declareInstanceBlock(inst: int, x: ExtendDecl): void {
        let info = this.types[inst];
        this.declareAnswers(inst, x.answers);
        this.declareStatics(inst, x.statics);
        for (m in x.methods) {
            // one member of a name: a block on one instance holds no set (S7c5d2; P22)
            if (this.methodOf(inst, m.name) != null) {
                this.error("LYS-SEM0121", f"'{info.name}' has a second member '{m.name}'", m.span);
                continue;
            }
            info.ownMethods.insert(m.name, this.declareFn(m, inst));
        }
    }

    /// Method `name` of type `i`: one a block on the instance alone gave it (S7c4c3b), else its
    /// type's.
    fn methodOf(i: int, name: string): ?int {
        return this.types[i].ownMethods.get(name) ?? this.types[i].methods.get(name);
    }

    /// `extend<I :: [Iterator]> I { … }`: members of every type its constraints admit (05 §13
    /// rule 7; S7c4c2) — an entry of its own, generic over the block's parameters, `this` the one
    /// the target names; a call binds it to the receiver. Its conformances are read once every
    /// interface is declared (`blanketConformance`, S7c4c3a).
    mut fn declareBlanket(x: ExtendDecl, at: int): void {
        // Lyric 5 §13 gives a blanket block members and conformances, no constant
        if (x.statics.length() > 0) {
            this.error(
                "LYS-SEM0124",
                "a blanket block holds no constant: it adds members to every type its constraints admit",
                x.span
            );
            return;
        }
        let index = this.types.length();
        this.types.push(
            TypeInfo {
                name = f"extend {x.typeParams[at].name}",
                kind = TypeKind.Builtin,
                methods = Map<string, int>.new(),
                mod = this.mod,
            }
        );
        let info = this.types[index];
        info.blanketAt = at;
        this.blanketIndex.insert(f"{x.span.file}:{x.span.start}", index);
        let savedScope = this.typeParams;
        let savedDeclaring = this.declaringParams;
        this.enterGenericType(index, x.typeParams);
        this.declareAnswers(index, x.answers);
        // a parameter neither the target nor a fixation names: the block reaches no type
        var k = 0;
        for (tp in x.typeParams) {
            var named = k == at;
            for (other in info.typeParams) {
                for (f in other.fixed) {
                    named = named || this.namesParam(f.ty, k);
                }
            }
            if (!named) {
                this.error(
                    "LYS-SEM0170",
                    f"'{tp.name}' is bound by nothing: the block's target is its receiver, and no constraint fixes '{tp.name}'",
                    x.span
                );
            }
            k += 1;
        }
        for (m in x.methods) {
            if (info.methods.containsKey(m.name)) {
                this.error("LYS-SEM0121", f"the block has a second member '{m.name}'", m.span);
                continue;
            }
            let fi = this.declareFn(m, index);
            this.blanketFns.push(fi);
            info.methods.insert(m.name, fi);
            let known = this.blankets.get(m.name);
            if (known != null) {
                known.push(fi);
            } else {
                let fns = List<int>.new();
                fns.push(fi);
                this.blankets.insert(m.name, fns);
            }
        }
        this.typeParams = savedScope;
        this.declaringParams = savedDeclaring;
    }

    /// Whether type parameter `k` occurs in `t`, at any depth.
    mut fn namesParam(t: Ty, k: int): bool {
        return match (t) {
            .Param(j) => j == k,
            .Optional(inner) | .List(inner) | .Cell(inner) => this.namesParam(inner.value, k),
            .Map(a, b) => this.namesParam(a.value, k) || this.namesParam(b.value, k),
            .Tuple(tt) => {
                var found = false;
                for (x in tt.elements) {
                    found = found || this.namesParam(x, k);
                }
                found
            }
            .Fn(ft) => {
                var found = this.namesParam(ft.result.value, k);
                for (x in ft.params) {
                    found = found || this.namesParam(x, k);
                }
                found
            }
            .Named(i) => {
                var found = false;
                if (this.types[i].template >= 0 && this.types[i].template != i) {
                    for (x in this.types[i].args) {
                        found = found || this.namesParam(x, k);
                    }
                }
                found
            }
            .Assoc(b, _, _) => this.namesParam(b.value, k),
            _ => false,
        };
    }

    /// A type's member of a name a blanket block gives the type (05 §13 rule 7; S7c4c2): the
    /// type's comes first, a call on the type reaches it, generic code the block's — warned about
    /// where it stands, at the type for one it inherits or leaves to a field (`LYS-SEM0168`).
    mut fn warnHiddenBlankets(name: string, methods: FnDecl[], at: Span): void {
        let index = this.typeIndex.get(this.q(name));
        if (index == null) {
            return;
        }
        let info = this.types[index];
        for (fi in this.blanketFns) {
            let member = this.functions[fi].name;
            if (this.blanketBinds(fi, Ty.Named(index)) == null) {
                continue;
            }
            var where = at;
            var has = false;
            for (m in methods) {
                if (m.name == member) {
                    where = m.span;
                    has = true;
                }
            }
            has = has || info.methods.containsKey(member);
            for (ii in this.ifacesOf(index)) {
                let found = this.ifaceMember(ii, member);
                if (found != null) {
                    let (f, _) = found;
                    has = has || !this.functions[f].abstract;
                }
            }
            if (has) {
                this.warn(
                    "LYS-SEM0168",
                    f"'{name}.{member}' hides the '{member}' a blanket block gives {name}: a call on a {name} reaches the type's, generic code through the block's constraints the block's",
                    where
                );
            }
        }
    }

    /// Blanket member `method` on a receiver of type `t`, where a block's constraints admit `t`
    /// (05 §13 rule 7; S7c4c2): the receiver binds the block's parameter, a fixation the others;
    /// null where no block gives `method` to `t`.
    mut fn blanketCall(
        t: Ty,
        receiver: TExpr,
        method: string,
        args: Arg[],
        at: Span,
        posTy: ?Ty,
        writtenTys: Ty[]
    ): ?TExpr {
        let fns = this.blankets.get(method);
        if (fns == null) {
            return null;
        }
        let found = this.blanketPick(fns, t, method, false, at);
        if (found == null) {
            return null;
        }
        let (pick, binds) = found;
        if (pick < 0) {
            return TExpr.Unknown;
        }
        this.presetBinds = binds;
        let call = this.callExpecting(posTy, writtenTys, method, [pick], receiver, args, at);
        this.presetBinds = [];
        return call;
    }

    /// Blanket static member `method` through type `t` — `Cat.describe()`, `T.describe()` (05
    /// §13 rule 7; S7c4c3a): null where no block gives it to `t`.
    mut fn blanketStatic(t: Ty, method: string, args: Arg[], at: Span): ?TExpr {
        let fns = this.blankets.get(method);
        if (fns == null) {
            return null;
        }
        let found = this.blanketPick(fns, t, method, true, at);
        if (found == null) {
            return null;
        }
        let (pick, binds) = found;
        if (pick < 0) {
            return TExpr.Unknown;
        }
        this.presetBinds = binds;
        let call = this.callAmong(method, [pick], null, args, at);
        this.presetBinds = [];
        return call;
    }

    /// The one blanket member of `fns`, static or not, that reaches `t`, with the block's
    /// parameters; null for none, -1 after the error that two do (`LYS-SEM0121`).
    mut fn blanketPick(
        fns: List<int>,
        t: Ty,
        method: string,
        statics: bool,
        at: Span
    ): ?(int, Ty[]) {
        var pick = -1;
        var binds: Ty[] = [];
        for (fi in fns) {
            if (this.functions[fi].isStatic != statics) {
                continue;
            }
            if (let b = this.blanketBinds(fi, t)) {
                if (pick >= 0) {
                    this.error(
                        "LYS-SEM0121",
                        f"two blanket blocks give {this.tyName(t)} a member '{method}'",
                        at
                    );
                    return (-1, binds);
                }
                pick = fi;
                binds = b;
            }
        }
        if (pick < 0) {
            return null;
        }
        return (pick, binds);
    }

    /// The parameters of blanket member `fi`'s block for a receiver of type `t`: the target `t`,
    /// another what a fixation names; null where `t` does not meet the constraints.
    mut fn blanketBinds(fi: int, t: Ty): ?Ty[] {
        return this.blanketBindsAt(this.functions[fi].owner, t);
    }

    /// The parameters of blanket block `e` for a receiver of type `t`; null where `t` does not
    /// meet its constraints.
    mut fn blanketBindsAt(e: int, t: Ty): ?Ty[] {
        let entry = this.types[e];
        let params = entry.typeParams;
        let binds = List<?Ty>.new();
        for (_ in params) {
            binds.push(null);
        }
        binds[entry.blanketAt] = t;
        var k = 0;
        for (tp in params) {
            let b = binds[k];
            if (b != null) {
                for (f in tp.fixed) {
                    this.bind(f.ty, this.answerThroughAt(b, f.iface, f.name, nowhereSpan), binds);
                }
            }
            k += 1;
        }
        let out = List<Ty>.new();
        for (b in binds) {
            if (b == null) {
                return null;
            }
            out.push(b);
        }
        let bound = out.toArray();
        k = 0;
        for (tp in params) {
            for (c in tp.constraints) {
                if (!this.conformsTo(bound[k], this.constraintAt(c, bound))) {
                    return null;
                }
            }
            for (f in tp.fixed) {
                let got = this.answerThroughAt(bound[k], f.iface, f.name, nowhereSpan);
                if (!sameOrUnknown(got, this.subst(f.ty, bound))) {
                    return null;
                }
            }
            k += 1;
        }
        return bound;
    }

    /// A blanket block's conformances (05 §13 rule 8; S7c4c3a), once every interface is declared:
    /// the interfaces, the answers a fixation in the list gives (05 §8 rule 3), the block
    /// implementing each one's chain as declared at the target (`LYS-SEM0042`, `LYS-SEM0020`,
    /// `LYS-SEM0128`), no other blanket block giving one of it (`LYS-SEM0133`).
    mut fn blanketConformance(x: ExtendDecl): void {
        let e = this.blanketIndex.get(f"{x.span.file}:{x.span.start}") ?? -1;
        if (e < 0 || x.conforms.length() == 0) {
            return;
        }
        let entry = this.types[e];
        let self = Ty.Param(entry.blanketAt);
        let savedScope = this.typeParams;
        let savedDeclaring = this.declaringParams;
        let savedSelf = this.selfTyIs;
        let scope = Map<string, int>.new();
        var k = 0;
        for (tp in x.typeParams) {
            scope.insert(tp.name, k);
            k += 1;
        }
        this.typeParams = scope;
        this.declaringParams = entry.typeParams;
        this.selfTyIs = self;
        let added = List<int>.new();
        for (c in x.conforms) {
            let ii = this.ifaceOf(c);
            if (ii < 0) {
                continue;
            }
            for (fx in c.fixed) {
                if (entry.answers.containsKey(fx.name)) {
                    this.error("LYS-SEM0121", f"the block answers '{fx.name}' twice", fx.span);
                    continue;
                }
                entry.answers.insert(fx.name, this.resolveType(fx.type));
            }
            added.push(ii);
        }
        entry.ifaces = added.toArray();
        // one blanket block per interface of a chain, even where no type meets both (rule 8)
        for (other in this.blanketConfs) {
            for (a in this.chainOf(other)) {
                for (b in this.chainOf(e)) {
                    if (this.ifaceBase(a) == this.ifaceBase(b)) {
                        this.error(
                            "LYS-SEM0133",
                            f"two blanket blocks give '{this.types[this.ifaceBase(b)].name}'",
                            x.span
                        );
                        this.typeParams = savedScope;
                        this.declaringParams = savedDeclaring;
                        this.selfTyIs = savedSelf;
                        return;
                    }
                }
            }
        }
        // the block implements each chain: its members as the interface declares them at the
        // target, the answers read where `Self.Iter` stands
        this.selfAnswersAt = entry.blanketAt;
        this.selfAnswers = entry.answers;
        let asked = List<string>.new();
        for (a in this.chainOf(e)) {
            let iface = this.types[this.ifaceBase(a)];
            let instanceArgs: Ty[] = if (this.ifaceBase(a) != a) this.types[a].args else [];
            for (n in iface.assocNames) {
                asked.push(n);
                if (!entry.answers.containsKey(n)
                    && !this.assocDefaults.containsKey(f"{this.ifaceBase(a)}.{n}")) {
                    this.error(
                        "LYS-SEM0128",
                        f"the blanket block does not answer '{iface.name}.{n}'",
                        x.span
                    );
                }
            }
            for (member in iface.memberNames) {
                let declared = iface.methods.get(member) ?? -1;
                let own = entry.methods.get(member);
                if (own != null) {
                    let selfArgs: Ty[] = if (iface.selfParam) withSelfTy(self, instanceArgs)
                        else instanceArgs;
                    if (!this.sameSignatureAs(own, declared, selfArgs)
                        || this.functions[own].isStatic != this.functions[declared].isStatic) {
                        this.error(
                            "LYS-SEM0042",
                            f"the blanket block's '{member}' does not take and give what '{iface.name}.{member}' declares",
                            x.span
                        );
                    }
                } else if (declared >= 0 && this.functions[declared].abstract) {
                    this.error(
                        "LYS-SEM0020",
                        f"the blanket block does not implement '{iface.name}.{member}'",
                        x.span
                    );
                }
            }
        }
        this.selfAnswersAt = -1;
        this.selfAnswers = Map<string, Ty>.new();
        for (a in x.answers) {
            var wanted = false;
            for (n in asked) {
                wanted = wanted || n == a.name;
            }
            if (!wanted) {
                this.error(
                    "LYS-SEM0129",
                    f"no interface of the block asks for an associated type '{a.name}'",
                    a.span
                );
            }
        }
        this.blanketConfs.push(e);
        this.typeParams = savedScope;
        this.declaringParams = savedDeclaring;
        this.selfTyIs = savedSelf;
    }

    /// The interfaces blanket block `e` gives, each with its parents.
    mut fn chainOf(e: int): int[] {
        let out = List<int>.new();
        for (j in this.types[e].ifaces) {
            for (a in this.ancestry(j)) {
                var seen = false;
                for (x in out) {
                    seen = seen || x == a;
                }
                if (!seen) {
                    out.push(a);
                }
            }
        }
        return out.toArray();
    }

    /// `Self.Item` of a blanket block's target while its signatures are checked: the block's
    /// answer (S7c4c3a).
    fn selfAnswer(k: int, name: string): ?Ty {
        if (k != this.selfAnswersAt) {
            return null;
        }
        return this.selfAnswers.get(name);
    }

    /// The parts of every struct, class and enum that lists `Equatable`, `Ordered` or
    /// `TotalOrder` without the member: each one comparing so (`LYS-SEM0020`, at the conformance;
    /// S7c5b).
    mut fn checkSynthesized(): void {
        let n = this.types.length();
        var i = 0;
        while (i < n) {
            let info = this.types[i];
            let plain = (info.kind == .Struct || info.kind == .Class || info.kind == .Enum)
                && (info.template < 0 || info.template == i);
            if (plain) {
                // the child first: a `TotalOrder` is said once, at its own conformance
                var said = false;
                for (ii in [this.totalOrderIndex, this.orderedIndex]) {
                    let name = if (ii == this.totalOrderIndex) "totalCompare" else "compare";
                    if (!said
                        && ii >= 0
                        && this.listsItself(i, ii)
                        && this.methodOf(i, name) == null) {
                        let missing = this.partNotOf(i, ii);
                        if (missing != "") {
                            let shown = this.types[ii].name;
                            let at = this.conformedAt.get(f"{i}:{shown}")
                                ?? this.conformedAt.get(f"{i}:TotalOrder")
                                ?? nowhereSpan;
                            this.error(
                                "LYS-SEM0020",
                                f"'{info.name}' does not implement '{shown}.{name}': {missing} is no {shown}",
                                at
                            );
                            said = true;
                        }
                    }
                }
                // `Clone` and `Default` (S7c6c1): each part one, at the type's own parameters
                // where it is generic — an instance is one where its arguments are
                if (this.synth.cloneIx >= 0
                    && this.listsItself(i, this.synth.cloneIx)
                    && this.methodOf(i, "clone") == null) {
                    if (let why = this.partsNotCloneable(i)) {
                        this.error(
                            "LYS-SEM0020",
                            f"'{info.name}' does not implement 'Clone.clone': {why}",
                            this.conformedAt.get(f"{i}:Clone") ?? nowhereSpan
                        );
                    }
                }
                if (this.synth.defaultIx >= 0
                    && this.listsItself(i, this.synth.defaultIx)
                    && this.methodOf(i, "default") == null) {
                    let at = this.conformedAt.get(f"{i}:Default") ?? nowhereSpan;
                    if (info.kind == .Enum) {
                        this.error(
                            "LYS-SEM0135",
                            f"'{info.name}' is an enum: no variant is its default",
                            at
                        );
                    } else if (let why = this.partsNotDefaultable(i)) {
                        this.error(
                            "LYS-SEM0020",
                            f"'{info.name}' does not implement 'Default.default': {why}",
                            at
                        );
                    }
                }
            }
            i += 1;
        }
    }

    /// Whether type `i` (or its template) lists interface `ii` itself.
    mut fn saysItself(i: int, ii: int): bool {
        let t = if (this.types[i].template >= 0) this.types[i].template else i;
        return this.listsItself(t, ii) || this.listsItself(i, ii);
    }

    /// Whether a value of `t` is a reference a clone clones (S7c6c1): an object, a list — and an
    /// optional or a tuple holding one; a struct, an enum, a scalar, a string and a function are
    /// values, copied.
    mut fn clonesAsReference(t: Ty): bool {
        return match (t) {
            .List(_) | .Map(_, _) => true,
            .Optional(inner) => this.clonesAsReference(inner.value),
            .Tuple(tt) => {
                var any = false;
                for (x in tt.elements) {
                    any = any || this.clonesAsReference(x);
                }
                any
            }
            .Named(i) => this.types[i].kind == .Class
                || this.types[i].kind == .Interface
                || this.types[i].vmHeld,
            .Param(_) | .Assoc(_, _, _) => true,
            _ => false,
        };
    }

    /// What keeps a value of `t` from being cloned, `null` where nothing does (S7c6c1): a type
    /// that does not list `Clone` and writes no `clone`, a reference part that does not clone.
    mut fn notCloneable(t: Ty, seen: List<int>): ?string {
        return match (t) {
            .Int | .Float | .Bool | .Char | .Str | .Unknown | .NullLit | .Fn(_) => null,
            // a type parameter: at a declaration the conformance is conditional on it (Lyric 5
            // §14 rule 4), in a generic's body its constraints say
            .Param(_) | .Assoc(_, _, _) => if (this.genericFn < 0
                || this.conformsDirect(t, this.synth.cloneIx)) null
                else f"{this.tyName(t)} is no Clone",
            .Optional(inner) => this.notCloneable(inner.value, seen),
            .List(e) => this.notCloneable(e.value, seen),
            .Tuple(tt) => {
                var why: ?string = null;
                for (x in tt.elements) {
                    why = why ?? this.notCloneable(x, seen);
                }
                why
            }
            .Named(i) => {
                if (!this.saysItself(i, this.synth.cloneIx)) {
                    return f"{this.tyName(t)} is no Clone";
                }
                if (this.methodOf(i, "clone") != null) {
                    return null;
                }
                for (s in seen) {
                    if (s == i) {
                        return null;
                    }
                }
                seen.push(i);
                this.partsNotCloneable(i, seen)
            }
            _ => f"{this.tyName(t)} is no Clone",
        };
    }

    /// The first part of type `i` a synthesized `clone` cannot clone, named; `null` where each
    /// can: a reference field, a reference payload, that is no Clone (S7c6c1).
    mut fn partsNotCloneable(i: int, seen: List<int> = List<int>.new()): ?string {
        let info = this.types[i];
        for (f in info.fields) {
            if (this.clonesAsReference(f.ty)) {
                if (let why = this.notCloneable(f.ty, seen)) {
                    return f"its field '{f.name}': {why}";
                }
            }
        }
        var v = 0;
        for (vf in info.variantFields) {
            for (f in vf) {
                if (this.clonesAsReference(f.ty)) {
                    if (let why = this.notCloneable(f.ty, seen)) {
                        return f"a payload of '{info.variants[v]}': {why}";
                    }
                }
            }
            v += 1;
        }
        return null;
    }

    /// What keeps `t` from having a default, `null` where nothing does (S7c6c1): an enum, an
    /// interface, a function, a type that does not list `Default` and writes no `default`, a field
    /// without an initializer whose type has none.
    mut fn notDefaultable(t: Ty, seen: List<int>): ?string {
        return match (t) {
            .Int | .Float | .Bool | .Char | .Str | .Optional(_) | .List(_) => null,
            .Param(_) | .Assoc(_, _, _) => if (this.genericFn < 0
                || this.conformsDirect(t, this.synth.defaultIx)) null
                else f"{this.tyName(t)} has no Default",
            .Tuple(tt) => {
                var why: ?string = null;
                for (x in tt.elements) {
                    why = why ?? this.notDefaultable(x, seen);
                }
                why
            }
            .Named(i) => {
                if (this.types[i].kind == .Enum || !this.saysItself(i, this.synth.defaultIx)) {
                    return f"{this.tyName(t)} has no Default";
                }
                if (this.methodOf(i, "default") != null) {
                    return null;
                }
                for (s in seen) {
                    if (s == i) {
                        return f"{this.tyName(t)} defaults through itself";
                    }
                }
                seen.push(i);
                this.partsNotDefaultable(i, seen)
            }
            _ => f"{this.tyName(t)} has no Default",
        };
    }

    /// The first field of type `i` a synthesized `default` gives no value, named; `null` where
    /// each has one: its initializer, or its type's default (S7c6c1).
    mut fn partsNotDefaultable(i: int, seen: List<int> = List<int>.new()): ?string {
        let info = this.types[i];
        let tmpl = if (info.template >= 0) this.types[info.template] else info;
        var k = 0;
        for (f in info.fields) {
            let written = k < tmpl.fields.length() && tmpl.fields[k].default != null;
            if (!written) {
                if (let why = this.notDefaultable(f.ty, seen)) {
                    return f"its field '{f.name}': {why}";
                }
            }
            k += 1;
        }
        return null;
    }

    /// What keeps a value of `t` from hashing, `null` where nothing does (S7d1; 03 Eq, 05 Fl): a
    /// float, a list, a map, a function, an interface value; a class that is no `Identity` and
    /// does not list `Hashable`; a part of a struct, an enum or a tuple that does not hash.
    mut fn notHashable(t: Ty, seen: List<int>): ?string {
        return match (t) {
            .Int | .Char | .Bool | .Str | .Unknown | .NullLit => null,
            .Param(_) | .Assoc(_, _, _) => if (this.genericFn < 0
                || this.conformsDirect(t, this.synth.hashableIx)) null
                else f"{this.tyName(t)} is no Hashable",
            .Optional(inner) => this.notHashable(inner.value, seen),
            .Tuple(tt) => {
                var why: ?string = null;
                for (x in tt.elements) {
                    why = why ?? this.notHashable(x, seen);
                }
                why
            }
            .Named(i) => {
                let info = this.types[i];
                if (this.methodOf(i, "hash") != null) {
                    return null;
                }
                if (info.kind == .Class || info.vmHeld) {
                    if (this.saysItself(i, this.identityIndex)) {
                        return null;
                    }
                    if (!this.saysItself(i, this.synth.hashableIx)) {
                        return f"{this.tyName(t)} is no Hashable: a class hashes by its identity or through ':: Hashable'";
                    }
                } else if (info.kind != .Struct && info.kind != .Enum) {
                    return f"{this.tyName(t)} is no Hashable";
                }
                for (s in seen) {
                    if (s == i) {
                        return null;
                    }
                }
                seen.push(i);
                for (f in info.fields) {
                    if (let why = this.notHashable(f.ty, seen)) {
                        return f"its field '{f.name}': {why}";
                    }
                }
                var v = 0;
                for (vf in info.variantFields) {
                    for (f in vf) {
                        if (let why = this.notHashable(f.ty, seen)) {
                            return f"a payload of '{info.variants[v]}': {why}";
                        }
                    }
                    v += 1;
                }
                null
            }
            _ => f"{this.tyName(t)} is no Hashable",
        };
    }

    /// `x.hash(h)` of a type that hashes without a `hash` of its own (S7d1): its synthesized
    /// function — over a type parameter the copy's; null for another call.
    mut fn synthHash(t: Ty, receiver: TExpr, method: string, args: Arg[]): ?TExpr {
        if (method != "hash"
            || args.length() != 1
            || this.synth.hashableIx < 0
            || this.synth.hasherIx < 0
            || !this.conformsDirect(t, this.synth.hashableIx)) {
            return null;
        }
        let hasher = Ty.Named(this.synth.hasherIx);
        let h = this.coerce(this.expr(args[0].value, hasher), hasher, spanOf(args[0].value));
        if (this.anyParamIn(t)) {
            return TExpr.CallBound(
                t,
                this.synth.hashableIx,
                "hash",
                this.slotIn(this.synth.hashableIx, "hash"),
                [receiver, h],
                Ty.Void
            );
        }
        return TExpr.Call(this.hashFnOf(t), [receiver, h], Ty.Void);
    }

    /// What writes `e`, of type `t`, into hasher `h` in a synthesized function (S7d1): a part's
    /// own `hash`; an optional a mark and its value, a tuple its elements.
    mut fn hashInto(e: TExpr, t: Ty, h: TExpr, body: List<TStmt>): void {
        match (t) {
            .Optional(inner) => {
                let k = this.hidden(t, nowhereSpan);
                let l = TExpr.Local(k, t);
                let some = List<TStmt>.new();
                some.push(this.hasherCall("writeByte", h, TExpr.Int(1)));
                this.hashInto(TExpr.Narrow(boxE(l), inner.value), inner.value, h, some);
                body.push(TStmt.SetLocal(k, e, 1));
                body.push(
                    TStmt.If(
                        TExpr.IsNull(boxE(l)),
                        [this.hasherCall("writeByte", h, TExpr.Int(0))],
                        some.toArray(),
                        1
                    )
                );
            }
            .Tuple(tt) => {
                let k = this.hidden(t, nowhereSpan);
                let l = TExpr.Local(k, t);
                body.push(TStmt.SetLocal(k, e, 1));
                var j = 0;
                for (x in tt.elements) {
                    this.hashInto(TExpr.Elem(boxE(l), j, x), x, h, body);
                    j += 1;
                }
            }
            _ => {
                body.push(
                    TStmt.Expr(
                        this.memberCallOn(
                            t,
                            this.synth.hashableIx,
                            "hash",
                            this.slotIn(this.synth.hashableIx, "hash"),
                            [e, h],
                            Ty.Void
                        ),
                        1
                    )
                );
            }
        }
    }

    /// `h.writeByte(v)` or `h.writeInt(v)` in a synthesized function.
    mut fn hasherCall(method: string, h: TExpr, v: TExpr): TStmt {
        let fi = this.methodOf(this.synth.hasherIx, method) ?? -1;
        return TStmt.Expr(TExpr.Call(fi, [h, v], Ty.Void), 1);
    }

    /// The function hashing a value of `t`, a type a copy knows (S7d1): an object of an
    /// `Identity` class by its number, a struct's and a class's fields in order, an enum's
    /// variant's position and then its payload.
    mut fn hashFnOf(t: Ty): int {
        let key = "hash:" + tyKey(t);
        if (let known = this.synth.fns.get(key)) {
            return known;
        }
        let hasher = Ty.Named(this.synth.hasherIx);
        let (index, saved) = this.beginSynth(
            "#hash",
            [
                ParamInfo { name = "x", ty = t, default = null },
                ParamInfo { name = "h", ty = hasher, default = null },
            ],
            Ty.Void,
            nowhereSpan
        );
        this.synth.fns.insert(key, index);
        let x = TExpr.Local(0, t);
        let h = TExpr.Local(1, hasher);
        let body = List<TStmt>.new();
        match (t) {
            .Named(i) => {
                let info = this.types[i];
                if ((info.kind == .Class || info.vmHeld)
                    && this.saysItself(i, this.identityIndex)) {
                    if (let n = nativeNamed("object.number")) {
                        let number = TExpr.Native(Native.Std(nativeNumber(n)), [x], Ty.Int);
                        body.push(this.hasherCall("writeInt", h, number));
                    }
                } else if (info.kind == .Enum) {
                    body.push(this.hasherCall("writeInt", h, TExpr.Tag(boxE(x))));
                    var v = 0;
                    while (v < info.variantFields.length()) {
                        let vf = info.variantFields[v];
                        if (vf.length() > 0) {
                            let parts = List<TStmt>.new();
                            var k = 0;
                            while (k < vf.length()) {
                                this.hashInto(
                                    TExpr.Payload(boxE(x), i, v, k, vf[k].ty),
                                    vf[k].ty,
                                    h,
                                    parts
                                );
                                k += 1;
                            }
                            body.push(
                                TStmt.If(
                                    TExpr.Binary(
                                        boxE(TExpr.Tag(boxE(x))),
                                        BinaryOp.Eq,
                                        boxE(TExpr.Int(v)),
                                        Ty.Bool
                                    ),
                                    parts.toArray(),
                                    [],
                                    1
                                )
                            );
                        }
                        v += 1;
                    }
                } else {
                    var k = 0;
                    for (f in info.fields) {
                        this.hashInto(TExpr.Field(boxE(x), k, f.ty), f.ty, h, body);
                        k += 1;
                    }
                }
            }
            _ => this.hashInto(x, t, h, body),
        }
        this.endSynth(index, body.toArray(), saved);
        return index;
    }

    /// Whether member `member` of interface `ii` is one the compiler synthesizes where a type does
    /// not write it — `equals`, `compare`, `totalCompare`, `clone`, `default` (S7c6c1).
    mut fn synthesizedMember(ii: int, member: string): bool {
        if (let found = this.ifaceMember(ii, member)) {
            let (fi, _) = found;
            return this.functions[fi].abstract && this.synthesizable(this.functions[fi].owner);
        }
        return false;
    }

    /// `x.clone()` of a type that clones without a `clone` of its own (S7c6c1): its synthesized
    /// function — over a type parameter the copy's; null for another call.
    mut fn synthClone(t: Ty, receiver: TExpr, method: string, args: Arg[]): ?TExpr {
        if (method != "clone"
            || args.length() != 0
            || this.synth.cloneIx < 0
            || !this.conformsDirect(t, this.synth.cloneIx)) {
            return null;
        }
        if (this.anyParamIn(t)) {
            return TExpr.CallBound(
                t,
                this.synth.cloneIx,
                "clone",
                this.slotIn(this.synth.cloneIx, "clone"),
                [receiver],
                t
            );
        }
        return TExpr.Call(this.cloneFnOf(t), [receiver], t);
    }

    /// The clone of `e`, of type `t`, in a synthesized function (S7c6c1): a value as it is, an
    /// object or a list by its `clone`, an optional's value and a tuple's elements alike.
    mut fn cloneOf(e: TExpr, t: Ty): TExpr {
        if (!this.clonesAsReference(t)) {
            return e;
        }
        return match (t) {
            .Optional(inner) => {
                let h = this.hidden(t, nowhereSpan);
                let l = TExpr.Local(h, t);
                TExpr.Block(
                    [TStmt.SetLocal(h, e, 1)],
                    boxE(
                        TExpr.If(
                            boxE(TExpr.IsNull(boxE(l))),
                            boxE(TExpr.Null(t)),
                            boxE(
                                TExpr.Wrap(
                                    boxE(
                                        this.cloneOf(
                                            TExpr.Narrow(boxE(l), inner.value),
                                            inner.value
                                        )
                                    ),
                                    t
                                )
                            ),
                            t
                        )
                    ),
                    t
                )
            }
            .Tuple(tt) => {
                let h = this.hidden(t, nowhereSpan);
                let l = TExpr.Local(h, t);
                let parts = List<TExpr>.new();
                var k = 0;
                for (x in tt.elements) {
                    parts.push(this.cloneOf(TExpr.Elem(boxE(l), k, x), x));
                    k += 1;
                }
                TExpr.Block([TStmt.SetLocal(h, e, 1)], boxE(TExpr.Tuple(parts.toArray(), t)), t)
            }
            _ => this.memberCallOn(
                t,
                this.synth.cloneIx,
                "clone",
                this.slotIn(this.synth.cloneIx, "clone"),
                [e],
                t
            ),
        };
    }

    /// The function cloning a value of `t`, a type a copy knows (S7c6c1): a struct's, a class's,
    /// an enum's variant's parts — value parts copied, reference parts cloned; a value without a
    /// reference part is itself.
    mut fn cloneFnOf(t: Ty): int {
        let key = "clone:" + tyKey(t);
        if (let known = this.synth.fns.get(key)) {
            return known;
        }
        let (index, saved) = this.beginSynth(
            "#clone",
            [ParamInfo { name = "x", ty = t, default = null }],
            t,
            nowhereSpan
        );
        this.synth.fns.insert(key, index);
        let x = TExpr.Local(0, t);
        let body = List<TStmt>.new();
        match (t) {
            .Named(i) => {
                let info = this.types[i];
                if (info.kind == .Enum) {
                    var v = 0;
                    while (v < info.variantFields.length()) {
                        let vf = info.variantFields[v];
                        var any = false;
                        for (f in vf) {
                            any = any || this.clonesAsReference(f.ty);
                        }
                        if (any) {
                            let parts = List<TExpr>.new();
                            var k = 0;
                            while (k < vf.length()) {
                                parts.push(
                                    this.cloneOf(
                                        TExpr.Payload(boxE(x), i, v, k, vf[k].ty),
                                        vf[k].ty
                                    )
                                );
                                k += 1;
                            }
                            body.push(
                                TStmt.If(
                                    TExpr.Binary(
                                        boxE(TExpr.Tag(boxE(x))),
                                        BinaryOp.Eq,
                                        boxE(TExpr.Int(v)),
                                        Ty.Bool
                                    ),
                                    [TStmt.Return(TExpr.MakeVariant(i, v, parts.toArray()), 1)],
                                    [],
                                    1
                                )
                            );
                        }
                        v += 1;
                    }
                } else if (info.kind == .Struct || info.kind == .Class) {
                    var any = info.kind == .Class;
                    for (f in info.fields) {
                        any = any || this.clonesAsReference(f.ty);
                    }
                    if (any) {
                        let parts = List<TExpr>.new();
                        var k = 0;
                        for (f in info.fields) {
                            parts.push(this.cloneOf(TExpr.Field(boxE(x), k, f.ty), f.ty));
                            k += 1;
                        }
                        body.push(TStmt.Return(TExpr.New(i, parts.toArray()), 1));
                    }
                }
            }
            // a tuple's and an optional's parts (S7d1)
            _ => body.push(TStmt.Return(this.cloneOf(x, t), 1)),
        }
        body.push(TStmt.Return(x, 1));
        this.endSynth(index, body.toArray(), saved);
        return index;
    }

    /// The function giving the default of `t`, a type a copy knows (S7c6c1): each field's
    /// initializer, or its type's default.
    mut fn defaultFnOf(t: Ty): int {
        let key = "default:" + tyKey(t);
        if (let known = this.synth.fns.get(key)) {
            return known;
        }
        let (index, saved) = this.beginSynth("#default", [], t, nowhereSpan);
        this.synth.fns.insert(key, index);
        var value = TExpr.Unknown;
        match (t) {
            .Named(i) => {
                let info = this.types[i];
                let tmpl = if (info.template >= 0) this.types[info.template] else info;
                let parts = List<TExpr>.new();
                var k = 0;
                for (f in info.fields) {
                    let written = if (k < tmpl.fields.length()) tmpl.fields[k].default else null;
                    if (let w = written) {
                        parts.push(if (info.template >= 0) this.specExpr(w, info.args) else w);
                    } else {
                        parts.push(this.defaultOf(f.ty));
                    }
                    k += 1;
                }
                value = TExpr.New(i, parts.toArray());
            }
            _ => { }
        }
        this.endSynth(index, [TStmt.Return(value, 1)], saved);
        return index;
    }

    /// The default of a part of type `t` (S7c6c1): zero, `false`, `'\0'`, `""`, `null`, `[]`, a
    /// tuple of its elements' defaults, a type's `default()`.
    mut fn defaultOf(t: Ty): TExpr {
        return match (t) {
            .Int => TExpr.Int(0),
            .Float => TExpr.Float(0.0),
            .Bool => TExpr.Bool(false),
            .Char => TExpr.Char((0 as uint32) as char),
            .Str => TExpr.Str(""),
            .Optional(_) => TExpr.Null(t),
            .List(_) => TExpr.ListOp(ListOp.Lit, [], t),
            .Tuple(tt) => {
                let parts = List<TExpr>.new();
                for (x in tt.elements) {
                    parts.push(this.defaultOf(x));
                }
                TExpr.Tuple(parts.toArray(), t)
            }
            .Named(i) => {
                let own = this.methodOf(i, "default") ?? -1;
                let info = this.types[i];
                if (own < 0) TExpr.Call(this.defaultFnOf(t), [], t)
                    else if (info.template >= 0 && info.template != i) TExpr.CallGeneric(
                        own,
                        info.args,
                        [],
                        t
                    )
                        else TExpr.Call(own, [], t)
            }
            _ => TExpr.Unknown,
        };
    }

    /// Whether type `i` lists interface `ii` (or a child of it) in its own conformances.
    mut fn listsItself(i: int, ii: int): bool {
        for (x in this.types[i].ifaces) {
            for (a in this.ancestry(x)) {
                if (a == ii) {
                    return true;
                }
            }
        }
        return false;
    }

    /// The first field or payload of type `i` that is no `ii`, named; "" where every one is.
    mut fn partNotOf(i: int, ii: int): string {
        let info = this.types[i];
        for (f in info.fields) {
            if (!this.conformsTo(f.ty, ii)) {
                return f"its field '{f.name}'";
            }
        }
        var v = 0;
        for (vf in info.variantFields) {
            for (f in vf) {
                if (!this.conformsTo(f.ty, ii)) {
                    return f"a payload of '{info.variants[v]}'";
                }
            }
            v += 1;
        }
        return "";
    }

    /// What the blanket blocks that conform give the types they reach (05 §13 rule 8; S7c4c3a):
    /// the interfaces, their answers, the block's members in the type's table — copied for the
    /// type, for a generic one per instance. A type that conforms to one of the chain itself is
    /// refused there (`LYS-SEM0133`). A list, and a generic type whose conformance the block
    /// needs is conditional, come with S7c4c3b: a value of the interface from one is refused.
    mut fn conformBlankets(): void {
        if (this.blanketConfs.length() == 0) {
            return;
        }
        for (name in ["int", "float", "bool", "char", "string"]) {
            this.builtinOf(builtinTy(name));
        }
        let n = this.types.length();
        for (e in this.blanketConfs) {
            var i = 0;
            while (i < n) {
                let info = this.types[i];
                let plain = (info.kind == .Struct
                    || info.kind == .Class
                    || info.kind == .Enum
                    || (info.kind == .Builtin && info.blanketAt < 0))
                    && (info.template < 0 || info.template == i);
                if (plain) {
                    if (let b = this.blanketBindsAt(e, this.selfTy(i))) {
                        this.blanketConform(i, e, b, this.reachCond(i, e));
                    }
                }
                i += 1;
            }
        }
    }

    /// The condition on generic type `i`'s arguments under which it meets blanket block `e`'s
    /// target constraints — a conformance a generic block gives on one (S7c4c3b) —; null where it
    /// meets them on none.
    mut fn reachCond(i: int, e: int): ?TypeParamInfo[] {
        let info = this.types[i];
        if (info.typeParams.length() == 0) {
            return null;
        }
        let entry = this.types[e];
        var out: ?TypeParamInfo[] = null;
        for (c in entry.typeParams[entry.blanketAt].constraints) {
            var plain = false;
            var cond: ?TypeParamInfo[] = null;
            for (x in info.ifaces) {
                for (a in this.ancestry(x)) {
                    if (this.isOf(a, c) || this.ifaceBase(a) == this.ifaceBase(c)) {
                        let given = info.condIfaces.get(x);
                        if (given != null) {
                            cond = given;
                        } else {
                            plain = true;
                        }
                    }
                }
            }
            if (!plain) {
                if (let more = cond) {
                    if (let have = out) {
                        out = mergeConds(have, more);
                    } else {
                        out = more;
                    }
                }
            }
        }
        return out;
    }

    /// Type `i` given blanket block `e`'s interfaces at the block's parameters `b` — for a
    /// generic type's instances that meet `cond` alone, where it has one.
    mut fn blanketConform(i: int, e: int, b: Ty[], cond: ?TypeParamInfo[]): void {
        let info = this.types[i];
        let entry = this.types[e];
        let chain = this.chainOf(e);
        for (x in info.ifaces) {
            for (a in this.ancestry(x)) {
                for (c in chain) {
                    if (this.ifaceBase(a) == this.ifaceBase(c)) {
                        let shown = this.types[this.ifaceBase(x)].name;
                        this.error(
                            "LYS-SEM0133",
                            f"'{info.name}' conforms to '{this.types[this.ifaceBase(c)].name}' itself, which a blanket block gives it too",
                            this.conformedAt.get(f"{i}:{shown}") ?? this.blanketSpan(e)
                        );
                        return;
                    }
                }
            }
        }
        this.blanketAnswers(i, e, b);
        let ifaces = List<int>.new();
        for (x in info.ifaces) {
            ifaces.push(x);
        }
        for (c in chain) {
            let a = this.constraintAt(c, b);
            ifaces.push(a);
            if (let given = cond) {
                info.condIfaces.insert(a, given);
            }
            let iface = this.types[this.ifaceBase(a)];
            let instanceArgs: Ty[] = if (this.ifaceBase(a) != a) this.types[a].args else [];
            for (member in iface.memberNames) {
                let slot = this.slotIn(a, member);
                info.slotArgs.insert(slot, instanceArgs);
                let declared = iface.methods.get(member) ?? -1;
                let own = entry.methods.get(member);
                if (own != null) {
                    // copied once the bodies are checked: for the type in `tableSelf`, for each
                    // instance of a generic one in `tableInstance`
                    info.witness.insert(slot, own);
                } else if (declared >= 0 && !this.functions[declared].abstract) {
                    info.witness.insert(slot, declared);
                }
            }
        }
        info.ifaces = ifaces.toArray();
    }

    /// Type `i`'s answers to what blanket block `e`'s interfaces ask, where it has none of its
    /// own: the block's at its parameters `b`, else the interface's default.
    mut fn blanketAnswers(i: int, e: int, b: Ty[]): void {
        let info = this.types[i];
        let entry = this.types[e];
        let self = this.selfTy(i);
        for (c in this.chainOf(e)) {
            let a = this.constraintAt(c, b);
            for (n in this.types[this.ifaceBase(a)].assocNames) {
                if (info.answers.containsKey(n)) {
                    continue;
                }
                let given = entry.answers.get(n);
                if (given != null) {
                    info.answers.insert(n, this.subst(given, b));
                    continue;
                }
                let d = this.assocDefaults.get(f"{this.ifaceBase(a)}.{n}");
                if (d != null) {
                    let saved = this.selfTyIs;
                    this.selfTyIs = self;
                    info.answers.insert(n, this.resolveType(d));
                    this.selfTyIs = saved;
                }
            }
        }
    }

    /// Where blanket block `e` stands: its first member's place, else nowhere.
    mut fn blanketSpan(e: int): Span {
        for (name in this.types[e].memberNames) {
            if (let fi = this.types[e].methods.get(name)) {
                if (let d = this.fnDecls[fi]) {
                    return d.span;
                }
            }
        }
        for (fi in this.blanketFns) {
            if (this.functions[fi].owner == e) {
                if (let d = this.fnDecls[fi]) {
                    return d.span;
                }
            }
        }
        return nowhereSpan;
    }

    /// The blanket block that gives type `t` interface `ii` (05 §13 rule 8; S7c4c3a); -1 for
    /// none. A block a question is asking already is not asked again.
    mut fn blanketGives(t: Ty, ii: int): int {
        if (this.blanketConfs.length() == 0 || t == .Unknown) {
            return -1;
        }
        for (e in this.blanketConfs) {
            var busy = false;
            for (v in this.blanketVisiting) {
                busy = busy || v == e;
            }
            var named = false;
            for (a in this.chainOf(e)) {
                named = named || this.ifaceBase(a) == this.ifaceBase(ii);
            }
            if (busy || !named) {
                continue;
            }
            this.blanketVisiting.push(e);
            let b = this.blanketBindsAt(e, t);
            this.blanketVisiting.pop();
            if (let bound = b) {
                for (a in this.chainOf(e)) {
                    let at = this.constraintAt(a, bound);
                    if (this.isOf(at, ii) || at == ii || this.isOf(a, ii)) {
                        return e;
                    }
                }
            }
        }
        return -1;
    }

    /// Constraint `c` with the parameters it names at `binds`: an instance of a generic interface
    /// at them, any other as it is (S7c4c2: `C :: [FromIterator<I.Item>]`).
    mut fn constraintAt(c: int, binds: Ty[]): int {
        let info = this.types[c];
        if (info.template < 0 || info.template == c) {
            return c;
        }
        return match (this.subst(Ty.Named(c), binds)) {
            .Named(x) => x,
            _ => c,
        };
    }

    /// `extend<T :: [Show]> Box<T> { … }`: members of every instance whose arguments meet the
    /// block's constraints (05 §13 rules 1–2); the target the type at the block's parameters, in
    /// its order.
    mut fn declareBlock(index: int, x: ExtendDecl): void {
        let info = this.types[index];
        let targs: TypeExpr[] = match (x.target) {
            .Named(_, args, _) => args,
            .List(inner, _) => [inner.value],
            // a shape's parts (S7e2c): an optional's value, a tuple's elements, a function's
            // parameters and its result
            .Optional(inner, _) => [inner.value],
            .Tuple(elems, _, _) => elems,
            .Fn(params, result, _) => {
                let all = List<TypeExpr>.new();
                for (p in params) {
                    all.push(p);
                }
                all.push(result.value);
                all.toArray()
            }
        };
        var plain = info.typeParams.length() == x.typeParams.length()
            && targs.length() == x.typeParams.length();
        var k = 0;
        while (plain && k < targs.length()) {
            let named = match (targs[k]) {
                .Named(n, inner, _) => if (inner.length() == 0) n else "",
                _ => "",
            };
            plain = named == x.typeParams[k].name;
            k += 1;
        }
        // Lyric 5 §13 rule 1: the type at the block's parameters, in its order, or one instance
        if (!plain) {
            this.error(
                "LYS-SEM0124",
                "a generic block's target is its type at the block's parameters, in their order",
                x.span
            );
            return;
        }
        let block = this.typeParamsOf(x.typeParams);
        // a member's parameters: the type's, with the block's constraints added
        let merged = List<TypeParamInfo>.new();
        var j = 0;
        for (tp in block) {
            let cs = List<int>.new();
            for (c in info.typeParams[j].constraints) {
                cs.push(c);
            }
            for (c in tp.constraints) {
                cs.push(c);
            }
            merged.push(TypeParamInfo { name = tp.name, constraints = cs.toArray() });
            j += 1;
        }
        let scope = Map<string, int>.new();
        j = 0;
        for (tp in x.typeParams) {
            scope.insert(tp.name, j);
            j += 1;
        }
        let savedScope = this.typeParams;
        let savedDeclaring = this.declaringParams;
        this.typeParams = scope;
        this.declaringParams = merged.toArray();
        // its associated types' answers, at the block's parameters (S7c4a: `type Iter =
        // ListIter<T>` in `extend<T> T[] :: Iterable`)
        if (x.conforms.length() > 0) {
            this.declareBlockAnswers(index, x);
        } else {
            this.declareAnswers(index, x.answers);
        }
        for (m in x.methods) {
            let fi = this.declareFn(m, index);
            if (m.typeParams.length() == 0) {
                this.functions[fi].typeParams = merged.toArray();
            }
            this.functions[fi].blockParams = block;
            // a second member of a name joins its set, as a block's without parameters does
            // (S7c5d2)
            if (x.conforms.length() > 0) {
                this.memberSite.insert(fi, f"{x.span.file}:{x.span.start}");
            }
            if (info.methods.containsKey(m.name)) {
                this.another(index, m.name, fi);
            } else {
                info.methods.insert(m.name, fi);
            }
        }
        this.restoreAnswers(index);
        this.typeParams = savedScope;
        this.declaringParams = savedDeclaring;
    }

    /// The entry of the type `name` names: one of the program, or a built-in's; -1 for none.
    mut fn typeNamed(name: string): int {
        let index = this.typeIndex.get(this.q(name));
        if (index != null) {
            return index;
        }
        return match (name) {
            "int" | "float" | "bool" | "char" | "string" => this.builtinOf(builtinTy(name)),
            "List" => this.builtinOf(Ty.List(boxTy(Ty.Unknown))),
            _ => -1,
        };
    }

    /// The entry of a built-in type, made when it is first needed; -1 for a type that is none.
    mut fn builtinOf(t: Ty): int {
        let name = match (t) {
            .Int => "int",
            .Float => "float",
            .Bool => "bool",
            .Char => "char",
            .Str => "string",
            .List(_) => "List",
            _ => "",
        };
        if (name == "") {
            // a function type, an optional, a tuple at fixed types (S7e2): an entry for each shape
            return match (t) {
                .Fn(_) | .Optional(_) | .Tuple(_) => if (hasParam(t)) -1 else this.shapeEntry(t),
                _ => -1,
            };
        }
        let known = this.builtinIndex.get(name);
        if (known != null) {
            return known;
        }
        let index = this.types.length();
        this.types.push(
            TypeInfo { name = name, kind = TypeKind.Builtin, methods = Map<string, int>.new() }
        );
        if (name == "List") {
            // one entry for every list: its methods generic over the element (S7b2a)
            this.types[index].typeParams = [TypeParamInfo { name = "T", constraints = [] }];
        }
        this.builtinIndex.insert(name, index);
        return index;
    }

    /// The entry of a function type, an optional or a tuple at fixed types, made when it is first
    /// needed (S7e2; Lyric 5 05 §13 rule 6): its blocks' members and conformances.
    mut fn shapeEntry(t: Ty): int {
        let key = "shape " + tyKey(t);
        if (let known = this.builtinIndex.get(key)) {
            return known;
        }
        let index = this.types.length();
        this.types.push(
            TypeInfo {
                name = this.tyName(t),
                kind = TypeKind.Builtin,
                methods = Map<string, int>.new(),
            }
        );
        this.types[index].shape = t;
        this.builtinIndex.insert(key, index);
        return index;
    }

    /// The entry of the blocks over a shape of their own parameters (S7e2c), one for each kind and
    /// arity — `?T`, `(A, B)`, `fn(A) -> R` — generic over its parts, as the lists' entry is over
    /// the element; -1 where no block stands over such a shape and `make` is not asked.
    mut fn shapeTemplate(kind: string, n: int, make: bool): int {
        let key = "shapeG " + kind;
        if (let known = this.builtinIndex.get(key)) {
            return known;
        }
        if (!make || kind == "") {
            return -1;
        }
        let ps = List<Ty>.new();
        let tps = List<TypeParamInfo>.new();
        var k = 0;
        while (k < n) {
            ps.push(Ty.Param(k));
            tps.push(TypeParamInfo { name = f"P{k}", constraints = [] });
            k += 1;
        }
        let parts = ps.toArray();
        let labels = List<string>.new();
        for (_ in parts) {
            labels.push("");
        }
        let shape = if (kind == "?") Ty.Optional(boxTy(parts[0]))
            else if (kind.startsWith("fn")) Ty.Fn(
                FnTy { params = sliceOf(parts, 0, n - 1), result = boxTy(parts[n - 1]) }
            )
                else Ty.Tuple(TupleTy { elements = parts, labels = labels.toArray() });
        let index = this.types.length();
        this.types.push(
            TypeInfo {
                name = this.tyName(shape),
                kind = TypeKind.Builtin,
                methods = Map<string, int>.new(),
            }
        );
        this.types[index].typeParams = tps.toArray();
        this.types[index].shape = shape;
        this.builtinIndex.insert(key, index);
        return index;
    }

    /// An instance of a shape template at a shape's parts (S7e2c): its members, its table, its box.
    mut fn shapeInstance(g: int, t: Ty): int {
        let parts = shapeParts(t) ?? [];
        let inst = this.typeInstance(g, parts);
        let info = this.types[inst];
        info.shape = t;
        // its conformances where its parts meet their blocks, for a default's box to find; the
        // table comes with the copies (`instantiate`): made now, it copied members not yet checked
        if (!info.tabled) {
            let tmpl = this.types[g];
            let merged = List<int>.new();
            for (x in tmpl.ifaces) {
                let cond = tmpl.condIfaces.get(x);
                if (cond == null || this.meetsBlock(parts, cond)) {
                    merged.push(x);
                }
            }
            info.ifaces = merged.toArray();
        }
        return inst;
    }

    /// What `this` is in a method of type `owner`: the value of a built-in type, else the type.
    mut fn selfTy(owner: int): Ty {
        let info = this.types[owner];
        if (info.blanketAt >= 0) {
            return Ty.Param(info.blanketAt);
        }
        if (let shape = info.shape) {
            // `this` in a block on a function type, an optional, a tuple (S7e2): the shape
            return shape;
        }
        if (info.kind == .Builtin && info.name == "List") {
            // `this` in an extend block of `T[]` (S7b2a): a list of the block's parameter
            return Ty.List(boxTy(Ty.Param(0)));
        }
        if (info.kind == .Builtin && info.template >= 0 && info.template != owner) {
            // an instance of the lists' entry (S7c3): a list of its element
            return Ty.List(boxTy(info.args[0]));
        }
        return if (info.kind == .Builtin) builtinTy(info.name) else Ty.Named(owner);
    }

    /// The entry whose methods and conformances `t` has: its type's, or its built-in's.
    mut fn entryOf(t: Ty): int {
        return match (t) {
            .Named(i) => i,
            // a list's type: an entry for its element type, its box's type and its table (S7c3)
            .List(e) => if (hasParam(t)) this.builtinOf(t)
                else this.typeInstance(this.builtinOf(t), [e.value]),
            // a shape: its blocks' entry at fixed types where it has any, else the instance of the
            // template a block over its kind's parts made (S7e2c)
            .Fn(_) | .Optional(_) | .Tuple(_) => this.shapeEntryOf(t),
            _ => this.builtinOf(t),
        };
    }

    /// A shape's entry (S7e2c): its fixed blocks', or its template's instance, or the empty fixed
    /// entry where neither gives it anything.
    mut fn shapeEntryOf(t: Ty): int {
        let fixed = this.builtinOf(t);
        if (fixed >= 0
            && (this.types[fixed].methods.length() > 0 || this.types[fixed].ifaces.length() > 0)) {
            return fixed;
        }
        let parts = shapeParts(t) ?? [];
        let g = this.shapeTemplate(shapeKind(t), parts.length(), false);
        if (g >= 0 && !hasParam(t)) {
            return this.shapeInstance(g, t);
        }
        return fixed;
    }

    /// Whether a value of `t` goes into a box to be an interface value: a scalar or a string.
    mut fn boxed(t: Ty): bool {
        let list = match (t) {
            .List(_) => true,
            .Named(i) => this.types[i].vmHeld,
            // a function value, an optional, a tuple of a block's conformance (S7e2): a box carries
            // its shape's table to an interface's default
            .Fn(_) | .Optional(_) | .Tuple(_) => true,
            _ => false,
        };
        return t == .Str || list || isScalar(t, this.types.toArray());
    }

    /// The function a box of a `t` runs for method `m`: it takes the box first and calls `m` on
    /// the value inside (made once per method).
    mut fn unboxer(m: int, t: Ty, iface: Ty): int {
        let known = this.unboxers.get(m);
        if (known != null) {
            return known;
        }
        let method = this.functions[m];
        let index = this.functions.length();
        this.functions.push(
            FnInfo { name = method.name + "#box", owner = -1, isStatic = true, line = method.line }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let info = this.functions[index];
        let params = List<ParamInfo>.new();
        let locals = List<Ty>.new();
        let args = List<TExpr>.new();
        params.push(ParamInfo { name = "this", ty = iface, default = null });
        locals.push(iface);
        args.push(TExpr.Unbox(boxE(TExpr.Local(0, iface)), t));
        var k = 0;
        for (p in method.params) {
            params.push(ParamInfo { name = p.name, ty = p.ty, default = null });
            locals.push(p.ty);
            args.push(TExpr.Local(k + 1, p.ty));
            k += 1;
        }
        info.params = params.toArray();
        info.returns = method.returns;
        info.locals = locals.toArray();
        let flags = List<bool>.new();
        for (_ in locals) {
            flags.push(false);
        }
        info.boxed = flags.toArray();
        // the method of a generic entry (a list's, S7c3): the unboxer is generic as it is
        info.typeParams = method.typeParams;
        let own = List<Ty>.new();
        var j = 0;
        for (_ in method.typeParams) {
            own.push(Ty.Param(j));
            j += 1;
        }
        let call = if (method.typeParams.length() > 0) TExpr.CallGeneric(
            m,
            own.toArray(),
            args.toArray(),
            method.returns
        )
            else TExpr.Call(m, args.toArray(), method.returns);
        info.body = if (method.returns == .Void) [
            TStmt.Expr(call, method.line),
            TStmt.Return(null, method.line),
        ]
            else [TStmt.Return(call, method.line)];
        if (method.typeParams.length() > 0) {
            // a generic function's body is its template, which each copy takes (as debugFnOf's)
            info.template = info.body;
            info.body = [];
        }
        this.unboxers.insert(m, index);
        return index;
    }

    /// Interface `ii` and its parents, each once.
    mut fn ancestry(ii: int): int[] {
        let out = List<int>.new();
        let todo = List<int>.new();
        todo.push(ii);
        while (todo.length() > 0) {
            let next = todo.pop() ?? -1;
            var seen = false;
            for (x in out) {
                seen = seen || x == next;
            }
            if (next < 0 || seen) {
                continue;
            }
            out.push(next);
            for (p in this.parentsOf(next)) {
                todo.push(p);
            }
        }
        return out.toArray();
    }

    /// The conformances of type `name` (Lyric 5 05 §1 rule 2): every abstract member of each
    /// interface's chain implemented with its exact signature, or taken from a default.
    mut fn conform(name: string, conforms: Conformance[]): void {
        // where each conformance stands: a blanket block that gives one too is refused there
        // (05 §13 rule 8; S7c4c3a)
        let named = this.typeNamed(name);
        if (named >= 0) {
            for (c in conforms) {
                this.conformedAt.insert(f"{named}:{c.name}", c.span);
            }
        }
        if (conforms.length() == 0) {
            return;
        }
        let index = this.typeNamed(name);
        if (index < 0) {
            return;
        }
        this.conformAt(index, conforms);
    }

    /// Type `index`'s conformances `conforms`: an instance's a block on it alone gives (S7c4c3b),
    /// its own beside its template's.
    mut fn conformAt(index: int, conforms: Conformance[]): void {
        if (conforms.length() == 0) {
            return;
        }
        let info = this.types[index];
        let instance = info.template >= 0 && info.template != index;
        for (c in conforms) {
            this.conformedAt.insert(f"{index}:{c.name}", c.span);
        }
        let self = this.selfTy(index);
        let boxedSelf = this.boxed(self);
        let added = List<int>.new();
        // `V :: [Add]` is `V :: [Add<V>]` (S7c5c1)
        let savedDefaultSelf = this.defaultSelf;
        this.defaultSelf = self;
        // the interfaces a field answers for: each one's field (05 §5)
        let via = Map<int, int>.new();
        // a generic type's parameters in scope: `class Cell<T> :: Store<T>` (S7c1)
        let savedScope = this.typeParams;
        if (info.typeParams.length() > 0 && this.typeParams.length() == 0) {
            let scope = Map<string, int>.new();
            var j = 0;
            for (tp in info.typeParams) {
                scope.insert(tp.name, j);
                j += 1;
            }
            this.typeParams = scope;
        }
        for (c in conforms) {
            let ii = this.ifaceOf(c);
            if (ii < 0) {
                continue;
            }
            let by = c.by;
            if (by != null) {
                var field = -1;
                var k = 0;
                for (f in info.fields) {
                    if (f.name == by) {
                        field = k;
                    }
                    k += 1;
                }
                if (field < 0 || !this.conformsTo(info.fields[field].ty, ii)) {
                    this.error(
                        "LYS-SEM0123",
                        f"'{by}' is no field of {info.name} that holds a {this.types[ii].name}",
                        c.span
                    );
                    continue;
                }
                for (a in this.ancestry(ii)) {
                    if (via.containsKey(a)) {
                        this.error(
                            "LYS-SEM0121",
                            f"two fields would answer for '{this.types[a].name}'",
                            c.span
                        );
                    }
                    via.insert(a, field);
                }
            }
            // one conformance per type and interface, from whichever site (05 §13 rule 4)
            var twice = false;
            for (x in info.ifaces) {
                twice = twice || x == ii;
            }
            // an instance whose template conforms already, for every instance or one it meets
            twice = twice || (instance && this.conformsDirect(self, ii));
            if (twice) {
                this.error(
                    "LYS-SEM0133",
                    f"'{info.name}' conforms to '{this.types[ii].name}' at a second site",
                    c.span
                );
                continue;
            }
            for (a in this.ancestry(ii)) {
                var known = false;
                for (x in info.ifaces) {
                    known = known || x == a;
                }
                for (x in added) {
                    known = known || x == a;
                }
                if (!known) {
                    added.push(a);
                }
            }
        }
        let all = List<int>.new();
        for (x in info.ifaces) {
            all.push(x);
        }
        // the defaults the type takes, by member name (05 §3 rule 2)
        let defaults = Map<string, int>.new();
        // the answers' bounds, asked once the conformances stand
        let bounded = List<(Ty, int, string)>.new();
        // a generic block's: for the instances that meet its constraints (05 §13 rule 3)
        if (this.blockCond.length() > 0) {
            for (ii in added) {
                info.condIfaces.insert(ii, this.blockCond);
            }
        }
        for (ii in added) {
            all.push(ii);
            // an instance of a generic interface: the template's members at its arguments (S7c1)
            let iface = this.types[this.ifaceBase(ii)];
            let instanceArgs: Ty[] = if (this.ifaceBase(ii) != ii) this.types[ii].args else [];
            // its associated types: answered by the type, or by the default (05 §8 rule 3)
            for (n in iface.assocNames) {
                let answer = this.conformanceAnswer(index, ii, n, conforms[0].span);
                if (let got = answer) {
                    info.instAnswers.insert(f"{ii}.{n}", got);
                    // the type's answer: its list's conformance's, else the first
                    if (this.blockSite == "" || !info.answers.containsKey(n)) {
                        info.answers.insert(n, got);
                    }
                }
                if (answer != null) {
                    for (b in this.boundsOf(ii, n)) {
                        if (answer != .Unknown) {
                            bounded.push(
                                (
                                    answer,
                                    b,
                                    f"'{info.name}' answers '{iface.name}.{n}' with {this.tyName(answer)}, which is no {this.types[b].name}"
                                )
                            );
                        }
                    }
                }
            }
            for (member in iface.memberNames) {
                let slot = this.slotIn(ii, member);
                info.slotArgs.insert(slot, instanceArgs);
                let declared = iface.methods.get(member) ?? -1;
                let selfArgs: Ty[] = if (iface.selfParam) withSelfTy(self, instanceArgs)
                    else instanceArgs;
                let own = this.memberAnswering(index, ii, member, declared, selfArgs);
                if (own != null) {
                    if (!this.sameSignatureAs(own, declared, selfArgs)
                        || this.functions[own].isStatic != this.functions[declared].isStatic) {
                        this.error(
                            "LYS-SEM0042",
                            f"'{info.name}.{member}' does not take and give what '{iface.name}.{member}' declares",
                            conforms[0].span
                        );
                    }
                    // through a box the method takes the value inside; a static takes no value
                    info.witness.insert(
                        slot,
                        if (boxedSelf && !this.functions[own].isStatic) this.unboxer(
                            own,
                            self,
                            Ty.Named(ii)
                        )
                            else own
                    );
                } else if (this.functions[declared].abstract && via.containsKey(ii)) {
                    // forwarded to the field, callable on the type too
                    let forward = this.forwarder(index, via.get(ii) ?? 0, ii, declared, slot);
                    info.methods.insert(member, forward);
                    info.witness.insert(slot, forward);
                } else if (!this.functions[declared].abstract) {
                    // the default, its `this` the interface value; two of one name from two
                    // interfaces are the type's to settle (05 §3 rule 2)
                    let other = defaults.get(member);
                    if (other != null && other != declared) {
                        this.error(
                            "LYS-SEM0043",
                            f"'{info.name}' gets '{member}' from two interfaces' defaults: write it, one function for both",
                            conforms[0].span
                        );
                    }
                    defaults.insert(member, declared);
                    info.witness.insert(slot, declared);
                } else if (declared >= 0 && this.synthesizable(this.functions[declared].owner)) {
                    // `equals` synthesized field by field where `==` asks for it (Lyric 5 05 §14;
                    // S7c5a): no table holds it, `Equatable` is a constraint only
                } else {
                    this.error(
                        "LYS-SEM0020",
                        f"'{info.name}' does not implement '{iface.name}.{member}'",
                        conforms[0].span
                    );
                }
            }
        }
        info.ifaces = all.toArray();
        if (instance) {
            info.instIfaces = info.ifaces;
        }
        // an answer meets its bounds with every conformance of the list in place: `type Iter =
        // Both` of a `Both :: [Iterator, Iterable]` (S7c4c3a; since S3i the bound was asked
        // before the type's other conformances stood)
        for (x in bounded) {
            let (answer, bound, text) = x;
            if (!this.conformsTo(answer, bound)) {
                this.error("LYS-SEM0160", text, conforms[0].span);
            }
        }
        this.defaultSelf = savedDefaultSelf;
        this.typeParams = savedScope;
    }

    /// Whether interface `x` is `ii`, or an instance of `ii` where `ii` is a generic interface's
    /// template — what a member generic over `Self` asks of `Self` (S7c1b).
    mut fn isOf(x: int, ii: int): bool {
        if (x == ii) {
            return true;
        }
        let target = this.types[ii];
        return target.kind == .Interface
            && target.typeParams.length() > 0
            && target.template == ii
            && this.ifaceBase(x) == ii;
    }

    /// The interfaces type `i` conforms to: an instance of a generic type its template's, each at
    /// the instance's arguments (S7c1b).
    mut fn ifacesOf(i: int): int[] {
        let info = this.types[i];
        if (info.template < 0 || info.template == i) {
            return info.ifaces;
        }
        let out = List<int>.new();
        for (x in this.types[info.template].ifaces) {
            out.push(this.ifaceAt(x, info.args));
        }
        for (x in info.instIfaces) {
            out.push(x);
        }
        return out.toArray();
    }

    /// Interface `x` of a generic type's template read at an instance's arguments: `Store<T>` of
    /// `Cell<T>` is `Store<int>` for `Cell<int>` (S7c1); another interface as it is.
    mut fn ifaceAt(x: int, args: Ty[]): int {
        let base = this.ifaceBase(x);
        if (this.types[base].typeParams.length() == 0 || args.length() == 0) {
            return x;
        }
        let a = List<Ty>.new();
        for (t in this.types[x].args) {
            a.push(this.subst(t, args));
        }
        return this.typeInstance(base, a.toArray());
    }

    /// A method of type `owner` that calls member `declared` of interface `ii` on its field
    /// `field` — read anew at each call, so an exchanged `var` field is the next call's (05 §5).
    mut fn forwarder(owner: int, field: int, ii: int, declared: int, slot: int): int {
        let member = this.functions[declared];
        let ft = this.types[owner].fields[field].ty;
        let index = this.functions.length();
        this.functions.push(
            FnInfo { name = member.name, owner = owner, isStatic = false, line = member.line }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let info = this.functions[index];
        let self = Ty.Named(owner);
        let locals = List<Ty>.new();
        locals.push(self);
        let params = List<ParamInfo>.new();
        let args = List<TExpr>.new();
        let read = TExpr.Field(boxE(TExpr.Local(0, self)), field, ft);
        let iface = Ty.Named(ii);
        args.push(
            if (this.isIfaceTy(ft)) read
                else if (this.boxed(ft)) TExpr.BoxOf(boxE(read), this.entryOf(ft), iface)
                    else TExpr.Upcast(boxE(read), iface)
        );
        var k = 0;
        for (p in member.params) {
            params.push(ParamInfo { name = p.name, ty = p.ty, default = null });
            locals.push(p.ty);
            args.push(TExpr.Local(k + 1, p.ty));
            k += 1;
        }
        info.params = params.toArray();
        info.returns = member.returns;
        info.locals = locals.toArray();
        let flags = List<bool>.new();
        for (_ in locals) {
            flags.push(false);
        }
        info.boxed = flags.toArray();
        let call = TExpr.CallIface(slot, args.toArray(), member.returns);
        info.body = if (member.returns == .Void) [
            TStmt.Expr(call, member.line),
            TStmt.Return(null, member.line),
        ]
            else [TStmt.Return(call, member.line)];
        return index;
    }

    /// Whether functions `a` and `b` take the same parameters and give the same result.
    /// Whether `a` takes and gives what `b` declares, `b`'s `Self` read as `selfArgs[0]`.
    mut fn sameSignatureAs(a: int, b: int, selfArgs: Ty[]): bool {
        let fa = this.functions[a];
        let fb = this.functions[b];
        // a member generic of its own (S7c4c2: `fromIter<I>`): the conformer's own parameters
        // stand for the interface's, as many, constrained by the same interfaces and fixations
        let ownA = this.ownTypeParams(a);
        let ownB = this.ownTypeParams(b);
        if (ownA != ownB) {
            return false;
        }
        let outerA = fa.typeParams.length() - ownA;
        let outerB = fb.typeParams.length() - ownB;
        let full = List<Ty>.new();
        for (x in selfArgs) {
            full.push(x);
        }
        while (full.length() < outerB) {
            full.push(Ty.Unknown);
        }
        var j = 0;
        while (j < ownA) {
            full.push(Ty.Param(outerA + j));
            j += 1;
        }
        let args = full.toArray();
        j = 0;
        while (j < ownA) {
            let pa = fa.typeParams[outerA + j];
            let pb = fb.typeParams[outerB + j];
            if (pa.constraints.length() != pb.constraints.length()
                || pa.fixed.length() != pb.fixed.length()) {
                return false;
            }
            var c = 0;
            while (c < pa.constraints.length()) {
                if (this.ifaceBase(pa.constraints[c]) != this.ifaceBase(pb.constraints[c])) {
                    return false;
                }
                c += 1;
            }
            c = 0;
            while (c < pa.fixed.length()) {
                if (pa.fixed[c].name != pb.fixed[c].name
                    || !sameOrUnknown(pa.fixed[c].ty, this.subst(pb.fixed[c].ty, args))) {
                    return false;
                }
                c += 1;
            }
            j += 1;
        }
        if (fa.params.length() != fb.params.length()
            || !sameOrUnknown(fa.returns, this.subst(fb.returns, args))) {
            return false;
        }
        var k = 0;
        while (k < fa.params.length()) {
            if (!sameOrUnknown(fa.params[k].ty, this.subst(fb.params[k].ty, args))) {
                return false;
            }
            k += 1;
        }
        return true;
    }

    /// How many type parameters function `fi` declares itself, after its owner's (S7c4c2).
    fn ownTypeParams(fi: int): int {
        if (let d = this.fnDecls[fi]) {
            return d.typeParams.length();
        }
        return 0;
    }

    mut fn sameSignature(a: int, b: int): bool {
        let fa = this.functions[a];
        let fb = this.functions[b];
        if (fa.params.length() != fb.params.length() || fa.returns != fb.returns) {
            return false;
        }
        var k = 0;
        while (k < fa.params.length()) {
            if (fa.params[k].ty != fb.params[k].ty) {
                return false;
            }
            k += 1;
        }
        return true;
    }

    /// The member `name` of interface `ii` or of a parent: its function and its slot.
    mut fn ifaceMember(ii: int, name: string): ?(int, int) {
        for (a in this.ancestry(ii)) {
            let base = this.types[this.ifaceBase(a)];
            let fi = base.methods.get(name);
            if (fi != null) {
                return (fi, this.slotIn(a, name));
            }
        }
        return null;
    }

    /// The slot of member `member` of interface `ii` in a copy for `a`: an instance of a generic
    /// interface at the copy's arguments has slots of its own (S7c5d1); `slot` where nothing moves.
    mut fn slotAt(ii: int, member: string, a: Ty[], slot: int): int {
        let info = this.types[ii];
        if (info.template < 0 || info.template == ii || a.length() == 0) {
            return slot;
        }
        if (let found = this.ifaceMember(this.constraintAt(ii, a), member)) {
            let (_, s) = found;
            return s;
        }
        return slot;
    }

    /// The slot a call through an interface value of type `t` takes for the member in `slot`: the
    /// value's own instance's, where it is an instance of a generic interface (S7c5d1).
    mut fn slotOfValue(t: Ty, slot: int): int {
        let j = match (t) {
            .Named(i) => i,
            _ => -1,
        };
        if (j < 0 || this.types[j].kind != .Interface || this.ifaceBase(j) == j) {
            return slot;
        }
        let fi = this.slotMember(slot);
        if (fi < 0) {
            return slot;
        }
        if (let found = this.ifaceMember(j, this.functions[fi].name)) {
            let (_, s) = found;
            return s;
        }
        return slot;
    }

    /// The slot of member `name` of interface `ii`: an instance of a generic interface has slots
    /// of its own — a type's table keeps `From<int>`'s and `From<string>`'s apart (S7c5d1) —,
    /// given out the first time one is asked; -1 where `ii`'s interface has no such member.
    mut fn slotIn(ii: int, name: string): int {
        let base = this.ifaceBase(ii);
        let template = this.types[base];
        if (base == ii) {
            return template.slotOf.get(name) ?? -1;
        }
        if (!template.methods.containsKey(name)) {
            return -1;
        }
        let info = this.types[ii];
        if (let s = info.slotOf.get(name)) {
            return s;
        }
        let s = this.slotCount;
        this.slotCount += 1;
        info.slotOf.insert(name, s);
        return s;
    }

    /// Whether a value of type `t` is a value of interface `ii`: its type conforms, or it is an
    /// interface value of a child — or a blanket block gives it the interface (05 §13 rule 8;
    /// S7c4c3a).
    mut fn conformsTo(t: Ty, ii: int): bool {
        return this.conformsDirect(t, ii) || this.blanketGives(t, ii) >= 0;
    }

    /// `conformsTo` without the blanket blocks.
    mut fn conformsDirect(t: Ty, ii: int): bool {
        // `Debug`: every value has one, written or synthesized — a type parameter's argument too
        // (03 Eq; S7e3)
        if (ii == this.synth.debugIx && ii >= 0) {
            return t != .Void;
        }
        // `Display`: a list too, its text its Debug form (Lyric 5 12 §Collections; S7e3b)
        if (ii == this.synth.displayIx && ii >= 0) {
            match (t) {
                .List(_) => {
                    return true;
                }
                _ => { }
            }
        }
        // `Clone` and `Default`: a value whose parts clone, a type whose parts have a default
        // (S7c6c1) — a type parameter through its constraints, below
        if ((ii == this.synth.cloneIx || ii == this.synth.defaultIx) && ii >= 0) {
            match (t) {
                .Param(_) | .Assoc(_, _, _) => { }
                _ => {
                    return (if (ii == this.synth.cloneIx) this.notCloneable(t, List<int>.new())
                        else this.notDefaultable(t, List<int>.new()))
                        == null;
                }
            }
        }
        // `Hashable`: a value whose parts hash (03 Eq; S7d1)
        if (ii == this.synth.hashableIx && ii >= 0) {
            match (t) {
                .Param(_) | .Assoc(_, _, _) => { }
                _ => {
                    return this.notHashable(t, List<int>.new()) == null;
                }
            }
        }
        // `Equatable`: a value whose parts compare (03 Eq; S7c5a) — a type parameter through its
        // constraints, below
        if (ii == this.equatableIndex && ii >= 0) {
            match (t) {
                .Param(_) | .Assoc(_, _, _) => { }
                _ => {
                    return this.notEquatable(t, List<int>.new()) == null;
                }
            }
        }
        // a value form: the interface, its fixed associated types answered alike (05 §8 rule 6)
        let target = this.types[ii];
        // (an instance of a generic interface is asked as an interface of its own, S7c1)
        if (target.kind == .Interface
            && target.template >= 0
            && target.template != ii
            && this.ifaceBase(ii) == ii) {
            match (t) {
                .Named(j) => {
                    if (j == ii) {
                        return true;
                    }
                }
                _ => { }
            }
            if (!this.conformsTo(t, target.template)) {
                return false;
            }
            for (n in target.answers.keys()) {
                let want = target.answers.get(n) ?? Ty.Unknown;
                let got = this.answerThrough(t, n, nowhereSpan);
                if (!sameOrUnknown(got, want)) {
                    return false;
                }
            }
            return true;
        }
        // every struct, class, enum and built-in value is an `Any`, an interface value too
        if (ii == this.anyIndex) {
            return match (t) {
                .Int | .Float | .Bool | .Char | .Str | .Named(_) | .List(_) => true,
                _ => false,
            };
        }
        return match (t) {
            .Int | .Float | .Bool | .Char | .Str => {
                let i = this.builtinOf(t);
                var found = false;
                for (x in this.types[i].ifaces) {
                    found = found || x == ii;
                }
                found
            }
            // a function type, an optional, a tuple: what a block on its shape gives (S7e2), or a
            // block over its kind's parts where they meet its condition (S7e2c)
            .Fn(_) | .Optional(_) | .Tuple(_) => {
                let i = this.builtinOf(t);
                var found = false;
                if (i >= 0) {
                    for (x in this.types[i].ifaces) {
                        found = found || this.isOf(x, ii);
                    }
                }
                let parts = shapeParts(t) ?? [];
                let g = this.shapeTemplate(shapeKind(t), parts.length(), false);
                if (!found && g >= 0) {
                    for (x in this.types[g].ifaces) {
                        let cond = this.types[g].condIfaces.get(x);
                        if (!found
                            && (this.isOf(x, ii) || this.ifaceAt(x, parts) == ii)
                            && (cond == null || this.meetsBlock(parts, cond))) {
                            found = true;
                        }
                    }
                }
                found
            }
            // a list: what `extend<T> T[] :: [I]` gives, where its element meets the block (S7c3)
            .List(e) => {
                let i = this.builtinOf(t);
                var found = false;
                // the block's condition is the matched interface's, `Contains<T>` for a `Contains<int>`
                // (S7c5c3: it was looked up under the instance asked, so never found)
                var matched = ii;
                for (x in this.types[i].ifaces) {
                    if (!found && (this.isOf(x, ii) || this.ifaceAt(x, [e.value]) == ii)) {
                        found = true;
                        matched = x;
                    }
                }
                // a block on this list type alone, `extend string[] :: Show` (S7c4c3b)
                let inst = if (hasParam(t)) -1 else this.entryOf(t);
                if (inst >= 0 && inst != i) {
                    for (x in this.types[inst].instIfaces) {
                        if (this.isOf(x, ii)) {
                            return true;
                        }
                    }
                }
                let cond = this.types[i].condIfaces.get(matched);
                if (found && cond != null) {
                    found = this.meetsBlock([e.value], cond);
                }
                found
            }
            .Named(j) => {
                let i = if (this.types[j].template >= 0) this.types[j].template else j;
                let kinds = if (this.types[i].kind == .Interface) this.ancestry(i)
                    else this.types[i].ifaces;
                var found = false;
                var matched = ii;
                for (x in kinds) {
                    // a generic interface of a generic type: at the instance's arguments (S7c1)
                    let hit = this.isOf(x, ii)
                        || (i != j
                            && this.types[i].kind != .Interface
                            && this.ifaceAt(x, this.types[j].args) == ii);
                    if (hit && !found) {
                        found = true;
                        matched = x;
                    }
                }
                // given by a generic block: where the instance's arguments meet its constraints —
                // the matched interface's condition (S7c5c3)
                let cond = this.types[i].condIfaces.get(matched);
                if (found && cond != null && i != j) {
                    found = this.meetsBlock(this.types[j].args, cond);
                }
                // by a block on the instance alone (S7c4c3b)
                if (!found && i != j) {
                    for (x in this.types[j].instIfaces) {
                        found = found || this.isOf(x, ii);
                    }
                }
                found
            }
            // an associated type is what its bounds are, and their parents
            .Assoc(_, ai, an) => {
                var found = false;
                for (b in this.boundsOf(ai, an)) {
                    for (x in this.ancestry(b)) {
                        found = found || x == ii;
                    }
                }
                found
            }
            // a type parameter is what its constraints are, and their parents
            .Param(k) => {
                let g = this.genericFn;
                var found = false;
                if (g >= 0 && k < this.functions[g].typeParams.length()) {
                    for (c in this.functions[g].typeParams[k].constraints) {
                        for (x in this.ancestry(c)) {
                            found = found || this.isOf(x, ii);
                        }
                    }
                }
                found
            }
            _ => false,
        };
    }

    mut fn declareEnum(e: EnumDecl): void {
        let index = this.typeIndex.get(this.q(e.name));
        if (index == null) {
            return;
        }
        let info = this.types[index];
        if (info.kind != .Enum) {
            return;
        }
        let savedScope = this.typeParams;
        if (e.typeParams.length() > 0) {
            this.enterGenericType(index, e.typeParams);
        }
        defer {
            this.typeParams = savedScope;
            info.filled = true;
        }
        this.declareAnswers(index, e.answers);
        this.declareStatics(index, e.statics);
        let variants = List<string>.new();
        let payloads = List<FieldInfo[]>.new();
        let named = List<bool>.new();
        let seen = Map<string, bool>.new();
        for (v in e.variants) {
            if (seen.containsKey(v.name)) {
                this.error("LYS-SEM0121", f"'{e.name}' has a second member '{v.name}'", v.span);
                continue;
            }
            seen.insert(v.name, true);
            variants.push(v.name);
            // a payload by position names its fields "0", "1", …
            let fields = List<FieldInfo>.new();
            var k = 0;
            for (x in v.positional) {
                fields.push(
                    FieldInfo {
                        name = f"{k}",
                        ty = this.resolveType(x),
                        isVar = false,
                        default = null,
                    }
                );
                k += 1;
            }
            let fieldSeen = Map<string, bool>.new();
            for (f in v.fields) {
                if (fieldSeen.containsKey(f.name)) {
                    this.error("LYS-SEM0121", f"'{v.name}' has a second field '{f.name}'", f.span);
                    continue;
                }
                fieldSeen.insert(f.name, true);
                fields.push(
                    FieldInfo {
                        name = f.name,
                        ty = this.resolveType(f.type),
                        isVar = false,
                        default = null,
                    }
                );
            }
            if (fields.length() > 0) {
                info.payload = true;
            }
            payloads.push(fields.toArray());
            named.push(v.named);
        }
        info.variants = variants.toArray();
        info.variantFields = payloads.toArray();
        info.variantNamed = named.toArray();
        for (m in e.methods) {
            if (seen.containsKey(m.name)) {
                this.error("LYS-SEM0121", f"'{e.name}' has a second member '{m.name}'", m.span);
                continue;
            }
            seen.insert(m.name, true);
            info.methods.insert(m.name, this.declareFn(m, index));
            if (!m.isPub) {
                info.hidden.insert(m.name);
            } else if (m.isInternal) {
                info.internalNames.insert(m.name);
            }
        }
    }

    /// Registers a function or a method and its signature; returns its index.
    mut fn declareFn(f: FnDecl, owner: int): int {
        let index = this.functions.length();
        let info = FnInfo {
            name = f.name,
            owner = owner,
            isStatic = f.isStatic || owner < 0,
            line = f.span.line,
            file = this.fileText(fileModule(f.span.file)),
        };
        // `Self` in its signature: its type's (S3i)
        let savedSelf = this.selfTyIs;
        this.selfTyIs = this.selfFor(owner);
        let savedDeclaring = this.declaringParams;
        if (owner >= 0 && this.types[owner].kind == .Interface && this.types[owner].selfParam) {
            this.declaringParams = [TypeParamInfo { name = "Self", constraints = [owner] }];
        }
        defer {
            this.declaringParams = savedDeclaring;
        }
        defer {
            this.selfTyIs = savedSelf;
        }
        // its type parameters, in scope for its signature (03 §9.1) — after its owner's, where it
        // is a method of a generic owner (S7c4c1: `fn map<U>` of `Box<T>` is generic over `T, U`)
        let savedScope = this.typeParams;
        let outer = this.outerParams(owner);
        if (f.typeParams.length() > 0) {
            let scope = Map<string, int>.new();
            let tps = List<TypeParamInfo>.new();
            for (o in outer) {
                tps.push(o);
            }
            for (n in this.typeParams.keys()) {
                if (outer.length() > 0) {
                    scope.insert(n, this.typeParams.get(n) ?? 0);
                }
            }
            var k = outer.length();
            // every parameter in scope first: a constraint may name one, `S :: [Source<T>]` (S7c1)
            for (tp in f.typeParams) {
                scope.insert(tp.name, k);
                k += 1;
            }
            this.typeParams = scope;
            let savedSelf = this.defaultSelf;
            for (tp in f.typeParams) {
                let cs = List<int>.new();
                this.defaultSelf = Ty.Param(scope.get(tp.name) ?? 0);
                for (c in tp.constraints) {
                    let ii = this.ifaceOf(c);
                    if (ii >= 0) {
                        cs.push(ii);
                    }
                }
                tps.push(
                    TypeParamInfo {
                        name = tp.name,
                        constraints = cs.toArray(),
                        defaultType = tp.defaultType,
                        defaultMod = this.mod,
                    }
                );
            }
            this.defaultSelf = savedSelf;
            let all = tps.toArray();
            let own = this.withFixations(f.typeParams, sliceOf(all, outer.length(), all.length()));
            let joined = List<TypeParamInfo>.new();
            for (o in outer) {
                joined.push(o);
            }
            for (o in own) {
                joined.push(o);
            }
            info.typeParams = joined.toArray();
            this.declaringParams = info.typeParams;
        }
        let params = List<ParamInfo>.new();
        var pk = 0;
        for (p in f.params) {
            // the rest of a call's positional arguments: last, and without a default — a call
            // without them passes the empty array (Lyric 5 08 §1 rule 1)
            if (p.variadic && pk != f.params.length() - 1) {
                this.error(
                    "LYS-SEM0024",
                    f"the variadic parameter '{p.name}' must be the last parameter",
                    p.span
                );
            }
            if (p.variadic && p.default != null) {
                this.error(
                    "LYS-SEM0024",
                    f"the variadic parameter '{p.name}' takes no default — a call without its arguments passes the empty array",
                    p.span
                );
            }
            params.push(
                ParamInfo {
                    name = p.name,
                    ty = this.resolveType(p.type),
                    default = null,
                    variadic = p.variadic && pk == f.params.length() - 1,
                }
            );
            pk += 1;
        }
        info.params = params.toArray();
        var state = FnState.Done;
        let written = f.returns;
        if (written != null) {
            info.returns = this.returnType(written);
        } else {
            match (f.body) {
                // Kotlin's rule (09 Ret): a block without a written type gives nothing
                .Block(_) | .None => info.returns = Ty.Void,
                .Expr(_) => {
                    info.returns = Ty.Unknown;
                    state = FnState.Declared;
                }
            }
        }
        if (owner >= 0 && f.typeParams.length() == 0 && this.types[owner].typeParams.length() > 0) {
            info.typeParams = this.types[owner].typeParams;
        }
        this.typeParams = savedScope;
        this.functions.push(info);
        this.fnDecls.push(f);
        this.fnStates.push(state);
        if (owner < 0) {
            let same = this.fnByName.get(this.declKey(f.name));
            if (same != null) {
                // counts that meet for any number, a default widening one (Lyric 5 08 §1.2 rule 2;
                // S7c5d2 — the parameters' counts alone were compared since S2d)
                let (low, high) = this.countRange(index);
                for (other in same) {
                    let (otherLow, otherHigh) = this.countRange(other);
                    if (low <= otherHigh && otherLow <= high) {
                        let n = if (low > otherLow) low else otherLow;
                        this.error(
                            "LYS-SEM0085",
                            f"two functions '{f.name}' take {n} arguments",
                            f.span
                        );
                    }
                }
                same.push(index);
            } else {
                let list = List<int>.new();
                list.push(index);
                this.fnByName.insert(this.declKey(f.name), list);
                this.register(f.name, f.span);
            }
        }
        return index;
    }

    /// The type parameters a method of `owner` is generic over before its own (S7c4c1): a generic
    /// type's, an interface's `Self` and its parameters, an extend block's — none for a function.
    mut fn outerParams(owner: int): TypeParamInfo[] {
        if (owner < 0) {
            return [];
        }
        let info = this.types[owner];
        if (info.kind == .Interface) {
            return if (info.selfParam) this.selfFirst(owner, info.typeParams) else info.typeParams;
        }
        if (info.typeParams.length() == 0) {
            return [];
        }
        // an extend block's own constraints where it is the one declaring
        return if (this.declaringParams.length() == info.typeParams.length()) this.declaringParams
            else info.typeParams;
    }

    mut fn checkFieldDefaults(t: TypeDecl): void {
        let index = this.typeIndex.get(this.q(t.name));
        if (index == null) {
            return;
        }
        let info = this.types[index];
        info.fields = this.defaultsOf(info.fields, t.fields);
    }

    /// The payloads' defaults of a struct variant, as a struct's fields have them.
    mut fn checkVariantDefaults(e: EnumDecl): void {
        let index = this.typeIndex.get(this.q(e.name));
        if (index == null) {
            return;
        }
        let info = this.types[index];
        if (info.kind != .Enum || info.variantFields.length() != info.variants.length()) {
            return;
        }
        let all = List<FieldInfo[]>.new();
        var k = 0;
        for (fields in info.variantFields) {
            var decls: FieldDecl[] = [];
            for (v in e.variants) {
                if (v.name == info.variants[k]) {
                    decls = v.fields;
                }
            }
            all.push(this.defaultsOf(fields, decls));
            k += 1;
        }
        info.variantFields = all.toArray();
    }

    /// `fields` with the defaults `decls` write, each checked against its field's type; a `?T`
    /// field without one starts as null (03 Initialisierung).
    mut fn defaultsOf(infos: FieldInfo[], decls: FieldDecl[]): FieldInfo[] {
        let fields = List<FieldInfo>.new();
        for (f in infos) {
            var dflt: ?TExpr = null;
            for (d in decls) {
                let written = d.default;
                if (d.name == f.name && written != null) {
                    let saved = this.ctx;
                    this.ctx = FnCtx.new(-1, Ty.Void, false, false);
                    dflt = this.coerce(this.expr(written, f.ty), f.ty, spanOf(written));
                    this.ctx = saved;
                }
            }
            // a `?T` field without a default starts as null (03 Initialisierung)
            match (f.ty) {
                .Optional(_) => {
                    if (dflt == null) {
                        dflt = TExpr.Null(f.ty);
                    }
                }
                _ => { }
            }
            fields.push(FieldInfo { name = f.name, ty = f.ty, isVar = f.isVar, default = dflt });
        }
        return fields.toArray();
    }

    // --- types -----------------------------------------------------------------------------------

    /// A return type: `never` stands here, and only here (06 §9 rule 3).
    mut fn returnType(t: TypeExpr): Ty {
        match (t) {
            .Named(name, args, _) => {
                if (name == "never" && args.length() == 0) {
                    return Ty.Never;
                }
            }
            _ => { }
        }
        return this.resolveType(t);
    }

    mut fn resolveType(t: TypeExpr): Ty {
        return match (t) {
            .Named(name, args, at) => this.resolveNamed(name, args, at),
            .Optional(inner, _) => Ty.Optional(boxTy(this.resolveType(inner.value))),
            .List(inner, _) => Ty.List(boxTy(this.resolveType(inner.value))),
            .Tuple(elements, labels, _) => {
                let tys = List<Ty>.new();
                for (x in elements) {
                    tys.push(this.resolveType(x));
                }
                Ty.Tuple(TupleTy { elements = tys.toArray(), labels = labels })
            }
            .Fn(params, result, _) => {
                let tys = List<Ty>.new();
                for (x in params) {
                    tys.push(this.resolveType(x));
                }
                Ty.Fn(
                    FnTy { params = tys.toArray(), result = boxTy(this.returnType(result.value)) }
                )
            }
        };
    }

    mut fn resolveNamed(name: string, args: TypeExpr[], at: Span): Ty {
        if (name == "Self" && args.length() == 0 && this.typeParams.get(name) == null) {
            let s = this.selfTyIs;
            if (s != null) {
                return s;
            }
            this.error(
                "LYS-SEM0011",
                "'Self' names the type whose members these are: in an interface or a type",
                at
            );
            return Ty.Unknown;
        }
        let t = this.resolveNamedType(name, args, at);
        match (t) {
            .Named(i) => {
                let info = this.types[i];
                if (info.kind == .Interface && info.constraintOnly) {
                    this.error(
                        "LYS-SEM0126",
                        f"'{info.name}' is a constraint only, no value of it arises: {info.onlyWhy}",
                        at
                    );
                    return Ty.Unknown;
                }
            }
            _ => { }
        }
        return t;
    }

    /// A type argument written at a call, an initializer or a function's value: the placeholder
    /// `_` there stands for one the inference fills (Lyric 5 03 §9.2 rule 4; S7c6d).
    mut fn writtenType(x: TypeExpr): Ty {
        match (x) {
            .Named(n, args, _) => {
                if (n == "_" && args.length() == 0) {
                    return Ty.Param(-1);
                }
            }
            _ => { }
        }
        return this.resolveType(x);
    }

    mut fn resolveNamedType(name: string, args: TypeExpr[], at: Span): Ty {
        // the placeholder stands only among a call's, an initializer's or a function value's type
        // arguments (Lyric 5 03 §9.2 rule 5; S7c6d)
        if (name == "_") {
            this.error(
                "LYS-SEM0117",
                "'_' stands only among the type arguments of a call, an initializer or a function's value",
                at
            );
            return Ty.Unknown;
        }
        if (name.contains(".")) {
            // `util.Point`: a module's type through its name
            let dot = name.find('.') ?? 0;
            let head = name[0..dot].toString();
            if (let target = this.moduleNamed(head)) {
                let rest = name[dot + 1..name.length()].toString();
                let key = this.exportKey(target, rest);
                this.maySee(key, rest, target, at);
                let index = this.typeIndex.get(key);
                if (index != null) {
                    return this.namedWith(index, rest, args, at);
                }
                let alias = this.aliases.get(key);
                if (alias != null && args.length() == 0) {
                    return this.resolveAlias(alias);
                }
                this.error("LYS-RES0004", f"the module '{head}' declares no type '{rest}'", at);
                return Ty.Unknown;
            }
            return this.assocPath(name, at);
        }
        let ifc = this.typeIndex.get(this.q(name));
        if (ifc != null
            && this.types[ifc].kind == .Interface
            && args.length() > 0
            && this.types[ifc].typeParams.length() == 0) {
            return this.fixedInterface(ifc, args, at);
        }
        let param = this.typeParams.get(name);
        if (param != null && args.length() == 0) {
            return Ty.Param(param);
        }
        // an instance of a generic type of the program
        let generic = this.typeIndex.get(this.q(name));
        if (generic != null && this.types[generic].typeParams.length() > 0) {
            let n = this.types[generic].typeParams.length();
            let tys = List<Ty>.new();
            for (x in args) {
                tys.push(this.resolveType(x));
            }
            // fewer arguments: the trailing defaults — `Coroutine<Y>` is `Coroutine<Y, void>`
            // (Lyric 5 10 §1 rule 1), its `R = void` the prelude's (S7c5c1)
            let all = if (args.length() <= n) this.withDefaults(
                this.types[generic].typeParams,
                tys.toArray(),
                null
            )
                else null;
            if (all == null) {
                this.error(
                    "LYS-SEM0026",
                    f"'{name}' takes {n} type arguments, not {args.length()}",
                    at
                );
                return Ty.Unknown;
            }
            return Ty.Named(this.typeInstance(generic, all));
        }
        let arity = match (name) {
            "List" => 1,
            "Map" => 2,
            _ => 0,
        };
        if (args.length() != arity) {
            // what the name is, first: one that names no type says so, given arguments or not
            // (S7c6b; it said "'Foo' takes 0 type arguments")
            if (arity > 0 || this.resolveNamedType(name, [], at) != .Unknown) {
                this.error(
                    "LYS-SEM0026",
                    f"'{name}' takes {arity} type arguments, not {args.length()}",
                    at
                );
            }
            return Ty.Unknown;
        }
        match (name) {
            "int" => {
                return Ty.Int;
            }
            "float" => {
                return Ty.Float;
            }
            "bool" => {
                return Ty.Bool;
            }
            "char" => {
                return Ty.Char;
            }
            "string" => {
                return Ty.Str;
            }
            "void" => {
                return Ty.Void;
            }
            // a type of no value: written only as a return type (06 §9 rule 3)
            "never" => {
                this.error(
                    "LYS-SEM0145",
                    "never types a value that cannot exist: it stands only as a return type",
                    at
                );
                return Ty.Never;
            }
            "List" => {
                return Ty.List(boxTy(this.resolveType(args[0])));
            }
            _ => { }
        }
        if (isWidthType(name)) {
            this.error(
                "LYS-SEM0900",
                f"'{name}' is a width type of Lyric 5: Lyric-Script has one integer type, int, and one float type, float",
                at
            );
            return Ty.Unknown;
        }
        let index = this.typeIndex.get(this.q(name));
        if (index != null) {
            return Ty.Named(index);
        }
        let alias = this.aliases.get(this.q(name));
        if (alias != null) {
            return this.resolveAlias(alias);
        }
        this.error("LYS-SEM0011", f"'{name}' names no type", at);
        return Ty.Unknown;
    }

    mut fn resolveAlias(a: AliasDecl): Ty {
        for (n in this.resolvingAliases) {
            if (n == a.name) {
                this.error("LYS-SEM0064", f"the alias '{a.name}' expands to itself", a.span);
                return Ty.Unknown;
            }
        }
        this.resolvingAliases.push(a.name);
        let t = this.resolveType(a.type);
        this.resolvingAliases.pop();
        return t;
    }

    mut fn tyName(t: Ty): string {
        return match (t) {
            .Int => "int",
            .Float => "float",
            .Bool => "bool",
            .Char => "char",
            .Str => "string",
            .Void => "void",
            .Never => "never",
            .Unknown => "?",
            .Named(i) => this.types[i].name,
            // `(?int)[]` and `(fn() -> int)[]`: `?int[]` is an optional list (S7b2a)
            .List(e) => match (e.value) {
                .Optional(_) | .Fn(_) => f"({this.tyName(e.value)})[]",
                _ => f"{this.tyName(e.value)}[]",
            },
            .Map(k, v) => f"Map<{this.tyName(k.value)}, {this.tyName(v.value)}>",
            .Optional(e) => f"?{this.tyName(e.value)}",
            .NullLit => "null",
            .Param(k) => if (this.genericFn >= 0
                && k
                    < this.functions[this.genericFn].typeParams.length()) this.functions[this.genericFn].typeParams[k].name
                else "T",
            .Tuple(tt) => {
                let parts = List<string>.new();
                var k = 0;
                for (e in tt.elements) {
                    let label = tt.labels[k];
                    parts.push(if (label == "") this.tyName(e) else f"{label}: {this.tyName(e)}");
                    k += 1;
                }
                "(" + parts.toArray().join(", ") + ")"
            }
            .Fn(ft) => {
                let parts = List<string>.new();
                for (x in ft.params) {
                    parts.push(this.tyName(x));
                }
                "fn(" + parts.toArray().join(", ") + ") -> " + this.tyName(ft.result.value)
            }
            .Cell(inner) => this.tyName(inner.value),
            .Assoc(b, _, n) => f"{this.tyName(b.value)}.{n}",
        };
    }

    /// `e` where a value of type `target` stands: the same type, `int` widened to `float`, or a
    /// fault (`LYS-SEM0001`).
    mut fn coerce(e: TExpr, target: Ty, at: Span): TExpr {
        this.fixFrom(e, target);
        let actual = typeOf(e);
        if (actual == target || actual == .Unknown || target == .Unknown || actual == .Never) {
            return e;
        }
        // an associated type a constraint of the generic in check fixes is that type (S7c6b)
        if (this.settle(actual) == this.settle(target)) {
            return e;
        }
        let fitted = this.fit(e, target);
        if (fitted != null) {
            return fitted;
        }
        this.error(
            "LYS-SEM0001",
            f"expected {this.tyName(target)}, found {this.tyName(actual)}",
            at
        );
        return TExpr.Unknown;
    }

    /// `e` as a value of `target` without a report: the same, an `int` widened to `float`, a
    /// value wrapped as present where an optional of it is taken, `null` given its type; `null`
    /// where it does not fit. `never` fits every type, its value never there (05 E12).
    mut fn fit(e: TExpr, target: Ty): ?TExpr {
        let actual = typeOf(e);
        if (actual == target || actual == .Never) {
            return e;
        }
        if (actual == .Int && target == .Float) {
            return match (e) {
                .Int(n) => TExpr.Float(n as float),
                _ => TExpr.ToFloat(boxE(e)),
            };
        }
        // a conformer's value, or a child interface's, as an interface value (05 §2, §11) — not a
        // task's or a coroutine's, which the VM holds without a descriptor (S6b3)
        match (target) {
            .Named(ii) => {
                if (this.types[ii].kind == .Interface
                    && this.conformsTo(actual, ii)
                    && (!this.heldWithoutDescriptor(actual) || this.boxed(actual))) {
                    // a scalar or a string goes into a box; a reference is its own; a list of a type
                    // parameter into the box its copy makes (S7c4c3b — the template's box before)
                    if (this.boxed(actual) && hasParam(actual)) {
                        return TExpr.Upcast(boxE(e), target);
                    }
                    if (this.boxed(actual)) {
                        return TExpr.BoxOf(boxE(e), this.entryOf(actual), target);
                    }
                    return TExpr.Upcast(boxE(e), target);
                }
            }
            _ => { }
        }
        match (target) {
            .Optional(inner) => {
                if (actual == .NullLit) {
                    return TExpr.Null(target);
                }
                let v = this.fit(e, inner.value);
                if (v != null) {
                    return TExpr.Wrap(boxE(v), target);
                }
            }
            _ => { }
        }
        return null;
    }

    // --- bodies ----------------------------------------------------------------------------------

    /// The script's top-level statements: the function `main`, whose outermost `let`s and `var`s
    /// are the script's globals (07 Top).
    mut fn checkMain(module: Module): void {
        let index = this.functions.length();
        this.mainIndex = index;
        let line = if (module.items.length() > 0) itemLine(module.items[0]) else 1;
        this.functions.push(FnInfo { name = "<script>", owner = -1, isStatic = true, line = line });
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let stmts = List<Stmt>.new();
        for (item in module.items) {
            this.mod = itemFile(item);
            match (item) {
                .Stmt(s) => {
                    if (this.mod <= 0 || bindsGlobals(s)) {
                        stmts.push(s);
                    } else {
                        // only the entry runs its statements; an imported module gives its
                        // bindings (07 Top)
                        this.warn(
                            "LYS-SEM0905",
                            "this statement does not run: only the entry module runs its statements",
                            stmtSpan(s)
                        );
                    }
                }
                .Decl(_) => { }
            }
        }
        var fixes = List<?Ty>.new();
        if (declaresNull(stmts.toArray())) {
            // 03 Leer: a quiet first pass; the globals it declares are declared again by the second
            let made = this.functions.length();
            this.ctx = FnCtx.new(index, Ty.Void, true, true);
            this.stmtList(stmts.toArray());
            fixes = this.ctx.fixes;
            this.dropFunctionsFrom(made);
            // the script's globals go; the types' constants, the first ones, stay
            let keep = this.staticInits.length();
            while (this.globals.length() > keep) {
                this.globals.pop();
            }
            this.globalIndex.clear();
            var gk = 0;
            for (gi in this.globals) {
                this.globalIndex.insert(gi.name, gk);
                gk += 1;
            }
        }
        this.ctx = FnCtx.new(index, Ty.Void, true, false);
        this.ctx.fixes = fixes;
        let body = List<TStmt>.new();
        // the types' constants first
        for (s in this.staticInitStmts()) {
            body.push(s);
        }
        for (s in this.stmtList(stmts.toArray())) {
            body.push(s);
        }
        let info = this.functions[index];
        // `fn main` of an entry without statements is its entry, after its bindings (07 Top)
        let start = this.entryMain(stmts.toArray());
        // the top level ends once every task it spawned ended (07 End): its join, the code made
        // for it where a task is spawned at all
        let last = if (body.length() > 0) stmtLine(body[body.length() - 1]) else info.line;
        if (start != null) {
            let (call, line) = start;
            if (typeOf(call) == .Int) {
                // `fn main(): int` gives the exit code (V1 M7), once its tasks ended
                let tmp = this.hidden(Ty.Int, nowhereSpan);
                body.push(TStmt.SetLocal(tmp, call, line));
                body.push(TStmt.Join(line));
                body.push(TStmt.Return(TExpr.Local(tmp, Ty.Int), line));
                info.returns = Ty.Int;
            } else {
                body.push(TStmt.Expr(call, line));
                body.push(TStmt.Join(line));
            }
        } else {
            body.push(TStmt.Join(last));
        }
        info.body = body.toArray();
        info.locals = this.ctx.locals.toArray();
        info.boxed = this.ctx.boxed.toArray();
    }

    /// The call of the entry's `fn main` where it is the entry, and the line it stands on; `null`
    /// where the entry declares none, or runs statements beside it (`LYS-SEM0906`), or its form
    /// is not an entry's (`LYS-SEM0021`).
    mut fn entryMain(stmts: Stmt[]): ?(TExpr, int) {
        let mains = this.fnByName.get(keyIn("", 0, "main"));
        if (mains == null || mains.length() == 0) {
            return null;
        }
        let fi = mains[0];
        let decl = this.fnDecls[fi];
        if (decl == null) {
            return null;
        }
        for (st in stmts) {
            if (fileModule(stmtSpan(st).file) == 0 && !bindsGlobals(st)) {
                this.error(
                    "LYS-SEM0906",
                    "two entries: the script's statements and 'fn main' — keep one",
                    decl.span
                );
                return null;
            }
        }
        let saved = this.mod;
        this.mod = 0;
        let rt = this.returnsOf(fi, decl.span);
        this.mod = saved;
        if (mains.length() > 1
            || this.functions[fi].params.length() > 0
            || this.functions[fi].typeParams.length() > 0
            || (rt != .Void && rt != .Int && rt != .Unknown)) {
            this.error(
                "LYS-SEM0021",
                "the entry's 'main' takes no parameters and returns void or int",
                decl.span
            );
            return null;
        }
        return (TExpr.Call(fi, [], rt), decl.span.line);
    }

    mut fn checkBodies(): void {
        var k = 0;
        while (k < this.functions.length()) {
            if (this.fnStates[k] != .Done || this.functions[k].body.length() == 0) {
                let decl = this.fnDecls[k];
                if (decl != null) {
                    this.checkFn(k, decl);
                }
            }
            k += 1;
        }
    }

    /// The return type of function `k`, checking its body first when it is to be inferred.
    mut fn returnsOf(k: int, at: Span): Ty {
        let state = this.fnStates[k];
        if (state == .Declared) {
            // the quiet pass of 03 Leer checks no other function: the second pass does
            if (this.ctx.fixing) {
                return Ty.Unknown;
            }
            let decl = this.fnDecls[k];
            if (decl != null) {
                this.checkFn(k, decl);
            }
        } else if (state == .Inferring) {
            this.error(
                "LYS-SEM0010",
                f"'{this.functions[k].name}' calls itself before its type is known: write its result type",
                at
            );
            return Ty.Unknown;
        }
        return this.functions[k].returns;
    }

    mut fn checkFn(k: int, decl: FnDecl): void {
        let info = this.functions[k];
        // the function's own module sees its names, wherever the check began
        let savedMod = this.mod;
        this.mod = fileModule(decl.span.file);
        defer {
            this.mod = savedMod;
        }
        if (this.fnStates[k] == .Declared) {
            this.fnStates[k] = FnState.Inferring;
        }
        let saved = this.ctx;
        let savedScope = this.typeParams;
        let savedGeneric = this.genericFn;
        let savedSelf = this.selfTyIs;
        this.selfTyIs = this.selfFor(info.owner);
        defer {
            this.selfTyIs = savedSelf;
        }
        if (info.typeParams.length() > 0) {
            let scope = Map<string, int>.new();
            var t = 0;
            for (tp in info.typeParams) {
                scope.insert(tp.name, t);
                t += 1;
            }
            this.typeParams = scope;
            this.genericFn = k;
        }
        var fixes = List<?Ty>.new();
        if (fnDeclaresNull(decl)) {
            // 03 Leer: a quiet first pass finds the type of each `var x = null`
            let made = this.functions.length();
            this.enterFn(k, decl, true);
            this.fnBody(k, decl);
            fixes = this.ctx.fixes;
            this.dropFunctionsFrom(made);
        }
        this.enterFn(k, decl, false);
        this.ctx.fixes = fixes;
        info.body = this.fnBody(k, decl);
        info.locals = this.ctx.locals.toArray();
        info.boxed = this.ctx.boxed.toArray();
        if (info.typeParams.length() > 0) {
            info.template = info.body;
            info.body = [];
        }
        this.fnStates[k] = FnState.Done;
        this.ctx = saved;
        this.typeParams = savedScope;
        this.genericFn = savedGeneric;
    }

    /// Takes back the functions from `n` on: the lambdas and values a quiet pass made, which the
    /// second pass makes again.
    mut fn dropFunctionsFrom(n: int): void {
        while (this.functions.length() > n) {
            this.functions.pop();
            this.fnDecls.pop();
            this.fnStates.pop();
        }
        let stale = List<int>.new();
        for (target in this.thunks.keys()) {
            let index = this.thunks.get(target) ?? -1;
            if (index >= n) {
                stale.push(target);
            }
        }
        for (target in stale) {
            this.thunks.remove(target);
        }
        let staleBound = List<int>.new();
        for (m in this.bound.keys()) {
            if ((this.bound.get(m) ?? -1) >= n) {
                staleBound.push(m);
            }
        }
        for (m in staleBound) {
            this.bound.remove(m);
        }
        // every cache of a function the checker wrote: a dropped one is written again (S7b2b —
        // a type's Debug form kept the index of a dropped function, another took its place)
        dropIntKeyed(this.eqFns, n);
        dropIntKeyed(this.debugFns, n);
        dropIntKeyed(this.unboxers, n);
        dropTextKeyed(this.listDebugFns, n);
        dropTextKeyed(this.genericEqFns, n);
        // `instances` keeps the instances of types too, keyed `type …`: their values are types'
        dropCopies(this.instances, n);
        dropTextKeyed(this.descThunks, n);
    }

    // --- the copies of generics (11 Gen) ----------------------------------------------------------

    /// Resolves every call of a generic to the copy for its type arguments' shape, making the
    /// copies; a copy's body is the generic's, its type parameters replaced.
    mut fn instantiate(): void {
        // until nothing is left: a copy makes instances (a shared copy's `Pair<Any>`, whose table
        // a type made at run time takes, S3i), and an instance's table makes copies
        var ti = 0;
        var k = 0;
        while (ti < this.types.length() || k < this.functions.length()) {
            while (ti < this.types.length()) {
                this.tableInstance(ti);
                this.tableSelf(ti);
                ti += 1;
            }
            while (k < this.functions.length()) {
                let info = this.functions[k];
                if (info.typeParams.length() == 0 && info.templateOf < 0) {
                    info.body = this.specStmts(info.body, []);
                }
                k += 1;
            }
        }
    }

    /// Whether a value of `t` is an object of the VM: such type arguments share one copy.
    mut fn sharedShape(t: Ty): bool {
        return match (t) {
            // a value the VM holds has no descriptor of its own: a copy for its type (S7c4b)
            .Named(i) => this.types[i].kind == .Struct
                || (this.types[i].kind == .Class && !this.types[i].vmHeld)
                || this.types[i].kind == .Interface
                || (this.types[i].kind == .Enum && this.types[i].payload),
            // a function value has a copy for its type (S7e2): a call through a constraint is
            // its block's member, as a list's is, where a shared copy would ask a table it has not
            .Fn(_) => false,
            _ => false,
        };
    }

    /// The copy of generic (or lambda template) `fi` for type arguments `args`.
    mut fn instanceOf(fi: int, args: Ty[]): int {
        let shaped = List<Ty>.new();
        let keys = List<string>.new();
        var ak = 0;
        let lambda = this.functions[fi].templateOf >= 0;
        for (a in args) {
            // a lambda's copy: shared where the copy around it is, which gives it `Any`
            let shares = if (lambda) a == Ty.Named(this.anyIndex)
                else this.sharedShape(a) && !this.copyExact && !this.assocConstrained(fi, ak);
            ak += 1;
            if (shares) {
                shaped.push(Ty.Named(this.anyIndex));
                keys.push("ref");
            } else {
                shaped.push(a);
                keys.push(tyKey(a));
            }
        }
        let key = f"{fi}<{keys.toArray().join(",")}>";
        let known = this.instances.get(key);
        if (known != null) {
            return known;
        }
        if (this.instances.length() > 20000) {
            this.error(
                "LYS-SEM0197",
                f"the program asks for more copies of generics than there may be",
                Span { start = 0, end = 0, line = this.functions[fi].line, column = 1 }
            );
            return fi;
        }
        let a = shaped.toArray();
        let generic = this.functions[fi];
        let index = this.functions.length();
        this.functions.push(
            FnInfo {
                name = f"{generic.name}<{keys.toArray().join(", ")}>",
                owner = generic.owner,
                isStatic = generic.isStatic,
                line = generic.line,
                file = generic.file,
            }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        this.instances.insert(key, index);
        let info = this.functions[index];
        let params = List<ParamInfo>.new();
        for (p in generic.params) {
            params.push(ParamInfo { name = p.name, ty = this.subst(p.ty, a), default = null });
        }
        info.params = params.toArray();
        info.returns = this.subst(generic.returns, a);
        let locals = List<Ty>.new();
        for (t in generic.locals) {
            locals.push(this.subst(t, a));
        }
        info.locals = locals.toArray();
        info.boxed = generic.boxed;
        info.env = generic.env;
        let caps = List<CaptureInfo>.new();
        for (c in generic.captures) {
            caps.push(CaptureInfo { ty = this.subst(c.ty, a), isCell = c.isCell });
        }
        info.captures = caps.toArray();
        // the descriptors of its type arguments (S3i, 11 Gen): a method of a generic type reads
        // them from its receiver's; any other copy gets one hidden parameter for each argument
        // it shares. A lambda's copy knows none (S3i i4).
        let anyTy = Ty.Named(this.anyIndex);
        let sources = List<?TExpr>.new();
        let hidden = this.hiddenOf(fi, args);
        let fromThis = this.descsFromThis(fi);
        var k = 0;
        for (x in args) {
            if (generic.templateOf >= 0) {
                // a lambda's copy: the descriptor among its captures, after its own
                if (x == anyTy) {
                    sources.push(TExpr.Captured(caps.length(), anyTy));
                    caps.push(CaptureInfo { ty = anyTy, isCell = false });
                } else {
                    sources.push(null);
                }
            } else if (!this.sharedShape(x) || this.copyExact || this.assocConstrained(fi, k)) {
                sources.push(null);
            } else if (fromThis && this.fromThisAt(fi, k)) {
                let own = TExpr.DescOfValue(boxE(TExpr.Local(0, anyTy)), anyTy);
                // Self is the receiver's type; a generic type's argument is in its descriptor
                sources.push(
                    if (this.types[generic.owner].kind == .Interface) own
                        else TExpr.DescArg(boxE(own), k, anyTy)
                );
            } else {
                let id = locals.length();
                locals.push(anyTy);
                sources.push(TExpr.Local(id, anyTy));
            }
            k += 1;
        }
        if (hidden.length() > 0) {
            info.locals = locals.toArray();
            let ids = List<int>.new();
            var j = 0;
            while (j < hidden.length()) {
                ids.push(generic.locals.length() + j);
                j += 1;
            }
            info.descParams = ids.toArray();
        }
        info.captures = caps.toArray();
        let savedDescs = this.specDescs;
        this.specDescs = sources.toArray();
        info.body = this.specStmts(generic.template, a);
        this.specDescs = savedDescs;
        return index;
    }

    /// Whether a copy of `fi` reads its type arguments' descriptors from its receiver's: a method
    /// of a generic type, which a call through an interface reaches without them.
    mut fn descsFromThis(fi: int): bool {
        let g = this.functions[fi];
        return g.owner >= 0
            && !g.isStatic
            && this.types[g.owner].kind != .Builtin
            && (this.types[g.owner].typeParams.length() > 0 || this.types[g.owner].selfParam);
    }

    /// The type parameters of `fi` whose descriptors a copy for `bound` takes as hidden
    /// parameters, in order: those it shares, where it does not read them from its receiver.
    mut fn hiddenOf(fi: int, bound: Ty[]): int[] {
        let out = List<int>.new();
        if (this.functions[fi].templateOf >= 0 || this.copyExact) {
            return out.toArray();
        }
        let fromThis = this.descsFromThis(fi);
        var k = 0;
        for (x in bound) {
            if (this.sharedShape(x)
                && !this.assocConstrained(fi, k)
                && !(fromThis && this.fromThisAt(fi, k))) {
                out.push(k);
            }
            k += 1;
        }
        return out.toArray();
    }

    /// Whether a copy of method `fi` reads type parameter `k`'s descriptor from its receiver: a
    /// generic type's own parameter from the receiver's descriptor, an interface's `Self` as the
    /// receiver's; a method's own parameters, and a generic interface's, come hidden (S7c4c1).
    mut fn fromThisAt(fi: int, k: int): bool {
        let f = this.functions[fi];
        if (f.owner < 0) {
            return false;
        }
        let info = this.types[f.owner];
        if (info.kind == .Interface) {
            return info.selfParam && k == 0;
        }
        return k < info.typeParams.length();
    }

    /// Whether type parameter `k` of `fi` is constrained by an interface with associated types:
    /// a copy of its own for each argument, since an answer's slots differ by type (S3i) — or
    /// with a member generic of its own, which a table does not hold (S7c4c2).
    mut fn assocConstrained(fi: int, k: int): bool {
        let tps = this.functions[fi].typeParams;
        if (k >= tps.length()) {
            return false;
        }
        for (c in tps[k].constraints) {
            for (x in this.ancestry(c)) {
                // or a member generic of its own, which no table holds for every call (S7c4c2:
                // `C.fromIter(it)` of `C :: [FromIterator<T>]`)
                if (this.assocNamesOf(x).length() > 0
                    || this.hasOwnGeneric(x)
                    || (x == this.equatableIndex && x >= 0)
                    || (x == this.synth.cloneIx && x >= 0)
                    || (x == this.synth.defaultIx && x >= 0)
                    || (x == this.synth.hashableIx && x >= 0)
                    || this.instanceOverParams(x)) {
                    return true;
                }
            }
        }
        return false;
    }

    /// Whether `x` is an instance of a generic interface at arguments naming a type parameter,
    /// `Combine<T>`: its slots are an instance's own, so a shared copy, not knowing `T`, knows no
    /// slot — a copy per argument (S7c5d1).
    mut fn instanceOverParams(x: int): bool {
        let info = this.types[x];
        if (info.template < 0 || info.template == x || this.ifaceBase(x) == x) {
            return false;
        }
        for (t in info.args) {
            if (this.anyParamIn(t)) {
                return true;
            }
        }
        return false;
    }

    /// Whether interface `ii` declares a member with type parameters of its own (S7c4c2).
    mut fn hasOwnGeneric(ii: int): bool {
        let base = this.types[this.ifaceBase(ii)];
        for (name in base.memberNames) {
            let fi = base.methods.get(name) ?? -1;
            if (fi >= 0 && this.ownTypeParams(fi) > 0) {
                return true;
            }
        }
        return false;
    }

    /// Whether `t` names a type parameter whose descriptor the copy being made gets at run time.
    mut fn dynamic(t: Ty): bool {
        return match (t) {
            .Param(k) => k < this.specDescs.length() && this.specDescs[k] != null,
            .Named(i) => {
                var found = false;
                if (this.types[i].template >= 0) {
                    for (x in this.types[i].args) {
                        found = found || this.dynamic(x);
                    }
                }
                found
            }
            .Optional(inner) => this.dynamic(inner.value),
            .List(inner) => this.dynamic(inner.value),
            .Map(x, y) => this.dynamic(x.value) || this.dynamic(y.value),
            .Tuple(tt) => {
                var found = false;
                for (x in tt.elements) {
                    found = found || this.dynamic(x);
                }
                found
            }
            .Fn(ft) => {
                var found = this.dynamic(ft.result.value);
                for (x in ft.params) {
                    found = found || this.dynamic(x);
                }
                found
            }
            _ => false,
        };
    }

    /// The descriptor of `t`, a type of the generic being copied, in the copy for `a`: the
    /// compiler's where the copy knows the type, else built at run time from the parts it gets.
    mut fn descExpr(t: Ty, a: Ty[]): TExpr {
        let anyTy = Ty.Named(this.anyIndex);
        if (!this.dynamic(t)) {
            return TExpr.DescOfType(this.subst(t, a), anyTy);
        }
        let parts = List<TExpr>.new();
        match (t) {
            .Param(k) => {
                let src = this.specDescs[k];
                if (src != null) {
                    return src;
                }
            }
            .Named(i) => {
                for (x in this.types[i].args) {
                    parts.push(this.descExpr(x, a));
                }
            }
            .Optional(inner) => parts.push(this.descExpr(inner.value, a)),
            // a list's: its entry's box at the element's descriptor (S7c4c3b)
            .List(inner) => {
                this.entryOf(Ty.List(boxTy(Ty.Named(this.anyIndex))));
                parts.push(this.descExpr(inner.value, a));
            }
            .Tuple(tt) => {
                for (x in tt.elements) {
                    parts.push(this.descExpr(x, a));
                }
            }
            .Fn(ft) => {
                for (x in ft.params) {
                    parts.push(this.descExpr(x, a));
                }
                parts.push(this.descExpr(ft.result.value, a));
            }
            _ => { }
        }
        return TExpr.InstDesc(this.subst(t, a), parts.toArray(), anyTy);
    }

    /// Type `ti` with the arguments in place: an instance's.
    mut fn specType(ti: int, a: Ty[]): int {
        return match (this.subst(Ty.Named(ti), a)) {
            .Named(j) => j,
            _ => ti,
        };
    }

    mut fn specStmts(list: TStmt[], a: Ty[]): TStmt[] {
        let out = List<TStmt>.new();
        for (s in list) {
            out.push(this.specStmt(s, a));
        }
        return out.toArray();
    }

    mut fn specOpt(e: ?TExpr, a: Ty[]): ?TExpr {
        if (e == null) {
            return null;
        }
        return this.specExpr(e, a);
    }

    mut fn specStmt(s: TStmt, a: Ty[]): TStmt {
        return match (s) {
            .Join(_) => s,
            .Yield(v, c, d, l) => TStmt.Yield(this.specOpt(v, a), c, d, l),
            .Expr(e, l) => TStmt.Expr(this.specExpr(e, a), l),
            .SetLocal(id, e, l) => TStmt.SetLocal(id, this.specExpr(e, a), l),
            .SetGlobal(g, e, l) => TStmt.SetGlobal(g, this.specExpr(e, a), l),
            .If(c, t, o, l) => TStmt.If(
                this.specExpr(c, a),
                this.specStmts(t, a),
                this.specStmts(o, a),
                l
            ),
            .While(c, b, l) => TStmt.While(this.specExpr(c, a), this.specStmts(b, a), l),
            .ForRange(id, x, y, inc, b, l) => TStmt.ForRange(
                id,
                this.specExpr(x, a),
                this.specExpr(y, a),
                inc,
                this.specStmts(b, a),
                l
            ),
            .Break(v, out, l) => TStmt.Break(this.specOpt(v, a), out, l),
            .Continue(out, l) => TStmt.Continue(out, l),
            .DoWhile(b, c, l) => TStmt.DoWhile(this.specStmts(b, a), this.specExpr(c, a), l),
            .Return(v, l) => TStmt.Return(this.specOpt(v, a), l),
            .Block(b, l) => TStmt.Block(this.specStmts(b, a), l),
            .DeclareLocal(id, l) => TStmt.DeclareLocal(id, l),
            .Finally(b, d, c1, r1, c2, r2, l) => TStmt.Finally(
                this.specStmts(b, a),
                this.specStmts(d, a),
                c1,
                r1,
                c2,
                r2,
                l
            ),
            .Try(b, caught, record, clauses, l) => {
                let out = List<TClause>.new();
                for (c in clauses) {
                    let takes = List<Ty>.new();
                    for (t in c.types) {
                        takes.push(this.subst(t, a));
                    }
                    out.push(
                        TClause {
                            test = this.specOpt(c.test, a),
                            body = this.specStmts(c.body, a),
                            types = takes.toArray(),
                        }
                    );
                }
                TStmt.Try(this.specStmts(b, a), caught, record, out.toArray(), l)
            }
        };
    }

    mut fn specAll(xs: TExpr[], a: Ty[]): TExpr[] {
        let out = List<TExpr>.new();
        for (x in xs) {
            out.push(this.specExpr(x, a));
        }
        return out.toArray();
    }

    mut fn specBox(x: Box<TExpr>, a: Ty[]): Box<TExpr> {
        return boxE(this.specExpr(x.value, a));
    }

    /// `e` with the type parameters replaced by `a`, a generic's call by its copy's, a
    /// constraint's member by the type's own — or, on a shared copy, through the value's table.
    /// An `if` and the `if`s standing as its `else`, copied as one chain (S7e1): a match of many
    /// arms lowers to one `if` in another's `else`, and a frame for each of them outgrew a test's
    /// stack at the thirty variants of `UnicodeCategory`. The order is the walk's: each condition,
    /// its branch, then the next.
    mut fn specIfChain(e: TExpr, a: Ty[]): TExpr {
        let conds = List<TExpr>.new();
        let thens = List<TExpr>.new();
        let tys = List<Ty>.new();
        var cur = e;
        var going = true;
        while (going) {
            match (cur) {
                .If(c, x, y, t) => {
                    conds.push(this.specExpr(c.value, a));
                    thens.push(this.specExpr(x.value, a));
                    tys.push(this.subst(t, a));
                    cur = y.value;
                }
                _ => {
                    going = false;
                }
            }
        }
        var out = this.specExpr(cur, a);
        var k = conds.length() - 1;
        while (k >= 0) {
            out = TExpr.If(boxE(conds[k]), boxE(thens[k]), boxE(out), tys[k]);
            k -= 1;
        }
        return out;
    }

    mut fn specExpr(e: TExpr, a: Ty[]): TExpr {
        return match (e) {
            .Int(_) | .Float(_) | .Bool(_) | .Char(_) | .Str(_) | .Variant(_, _) | .Unit | .Unknown => e,
            .Throw(x) => TExpr.Throw(this.specBox(x, a)),
            .Rethrow(_, _) => e,
            .Panic(x, code) => TExpr.Panic(this.specBox(x, a), code),
            .Spawn(x, t) => TExpr.Spawn(this.specBox(x, a), this.subst(t, a)),
            .Await(x, t) => TExpr.Await(this.specBox(x, a), this.subst(t, a)),
            .TaskStatus(x, t) => TExpr.TaskStatus(this.specBox(x, a), t),
            .YieldNow => e,
            .CoNew(x, t) => TExpr.CoNew(this.specBox(x, a), this.subst(t, a)),
            .CoNext(x, t) => TExpr.CoNext(this.specBox(x, a), this.subst(t, a)),
            .CoResult(x, t) => TExpr.CoResult(this.specBox(x, a), this.subst(t, a)),
            .CoDone(x) => TExpr.CoDone(this.specBox(x, a)),
            .CoClose(x, c) => TExpr.CoClose(this.specBox(x, a), this.specBox(c, a)),
            .SpawnDetached(x) => TExpr.SpawnDetached(this.specBox(x, a)),
            .TaskCancel(x) => TExpr.TaskCancel(this.specBox(x, a)),
            .ScopeNew(t) => TExpr.ScopeNew(t),
            .ScopeSpawn(sc, x, t) => TExpr.ScopeSpawn(
                this.specBox(sc, a),
                this.specBox(x, a),
                this.subst(t, a)
            ),
            .ScopeClose(x) => TExpr.ScopeClose(this.specBox(x, a)),
            .ScopeCancel(x) => TExpr.ScopeCancel(this.specBox(x, a)),
            .TaskValue(x, t) => TExpr.TaskValue(this.specBox(x, a), this.subst(t, a)),
            .TaskError(x, t) => TExpr.TaskError(this.specBox(x, a), t),
            .PanicText(x, k) => TExpr.PanicText(this.specBox(x, a), k),
            .ChanNew(x, t) => TExpr.ChanNew(this.specBox(x, a), this.subst(t, a)),
            .ChanSend(x, v) => TExpr.ChanSend(this.specBox(x, a), this.specBox(v, a)),
            .ChanRecv(x, t) => TExpr.ChanRecv(this.specBox(x, a), this.subst(t, a)),
            .ChanClose(x) => TExpr.ChanClose(this.specBox(x, a)),
            .SemNew(x, t) => TExpr.SemNew(this.specBox(x, a), t),
            .SemAcquire(x) => TExpr.SemAcquire(this.specBox(x, a)),
            .SemTry(x) => TExpr.SemTry(this.specBox(x, a)),
            .SemRelease(x) => TExpr.SemRelease(this.specBox(x, a)),
            .SemAvail(x) => TExpr.SemAvail(this.specBox(x, a)),
            .ChanReady(x) => TExpr.ChanReady(this.specBox(x, a)),
            .ChanWatch(x) => TExpr.ChanWatch(this.specBox(x, a)),
            .ParkWatched => e,
            .Sleep(x) => TExpr.Sleep(this.specBox(x, a)),
            .TimerAfter(x, t) => TExpr.TimerAfter(this.specBox(x, a), t),
            .ReadLine => e,
            .Local(id, t) => TExpr.Local(id, this.subst(t, a)),
            .Global(g, t) => TExpr.Global(g, this.subst(t, a)),
            .Unary(op, x, t) => TExpr.Unary(op, this.specBox(x, a), this.subst(t, a)),
            .Binary(x, op, y, t) => TExpr.Binary(
                this.specBox(x, a),
                op,
                this.specBox(y, a),
                this.subst(t, a)
            ),
            .ToFloat(x) => TExpr.ToFloat(this.specBox(x, a)),
            .Cast(x, t) => TExpr.Cast(this.specBox(x, a), this.subst(t, a)),
            .Call(fi, xs, t) => TExpr.Call(fi, this.specAll(xs, a), this.subst(t, a)),
            .Native(n, xs, t) => TExpr.Native(n, this.specAll(xs, a), this.subst(t, a)),
            .ListOp(op, xs, t) => TExpr.ListOp(op, this.specAll(xs, a), this.subst(t, a)),
            // a generic type's instance with the arguments in place; in a shared copy built
            // with the descriptor of the type the arguments make (S3i)
            .New(ti, xs) => if (this.dynamic(Ty.Named(ti))) TExpr.NewD(
                boxE(this.descExpr(Ty.Named(ti), a)),
                this.specType(ti, a),
                -1,
                this.specAll(xs, a),
                Ty.Named(this.specType(ti, a))
            )
                else TExpr.New(this.specType(ti, a), this.specAll(xs, a)),
            .Field(x, k, t) => TExpr.Field(this.specBox(x, a), k, this.subst(t, a)),
            .Assign(place, op, v, t) => {
                let p = match (place) {
                    .Field(o, k) => Place.Field(this.specBox(o, a), k),
                    .Item(o, k) => Place.Item(this.specBox(o, a), this.specBox(k, a)),
                    _ => place,
                };
                TExpr.Assign(p, op, this.specBox(v, a), this.subst(t, a))
            }
            .If(_, _, _, _) => this.specIfChain(e, a),
            .Block(b, v, t) => TExpr.Block(
                this.specStmts(b, a),
                this.specBox(v, a),
                this.subst(t, a)
            ),
            .Loop(b, t) => TExpr.Loop(this.specStmts(b, a), this.subst(t, a)),
            .Null(t) => TExpr.Null(this.subst(t, a)),
            .Wrap(x, t) => TExpr.Wrap(this.specBox(x, a), this.subst(t, a)),
            // a value narrowed to a type parameter: in a copy for a scalar, out of its box
            .Narrow(x, t) => match (t) {
                .Param(_) => if (this.isIfaceTy(typeOf(x.value))) this.heldAs(
                    this.specExpr(x.value, a),
                    this.subst(t, a)
                )
                    else TExpr.Narrow(this.specBox(x, a), this.subst(t, a)),
                _ => TExpr.Narrow(this.specBox(x, a), this.subst(t, a)),
            },
            .Unwrap(x, t) => TExpr.Unwrap(this.specBox(x, a), this.subst(t, a)),
            .IsNull(x) => TExpr.IsNull(this.specBox(x, a)),
            .Coalesce(x, y, t) => TExpr.Coalesce(
                this.specBox(x, a),
                this.specBox(y, a),
                this.subst(t, a)
            ),
            .Tuple(xs, t) => TExpr.Tuple(this.specAll(xs, a), this.subst(t, a)),
            .Elem(x, k, t) => TExpr.Elem(this.specBox(x, a), k, this.subst(t, a)),
            .MakeVariant(ti, k, xs) => if (this.dynamic(Ty.Named(ti))) TExpr.NewD(
                boxE(
                    TExpr.DescVariant(
                        boxE(this.descExpr(Ty.Named(ti), a)),
                        k,
                        Ty.Named(this.anyIndex)
                    )
                ),
                this.specType(ti, a),
                k,
                this.specAll(xs, a),
                Ty.Named(this.specType(ti, a))
            )
                else TExpr.MakeVariant(this.specType(ti, a), k, this.specAll(xs, a)),
            .Tag(x) => TExpr.Tag(this.specBox(x, a)),
            .Payload(x, ti, k, j, t) => TExpr.Payload(
                this.specBox(x, a),
                this.specType(ti, a),
                k,
                j,
                this.subst(t, a)
            ),
            .Unreachable(t) => TExpr.Unreachable(this.subst(t, a)),
            .Closure(fi, xs, t) => {
                // a lambda of a generic's body: its copy for these arguments, holding after its
                // captures the descriptors the shared copy around it has (S3i)
                let isLambda = this.functions[fi].templateOf >= 0;
                let f = if (isLambda) this.instanceOf(fi, a) else fi;
                let caps = List<TExpr>.new();
                for (x in this.specAll(xs, a)) {
                    caps.push(x);
                }
                if (isLambda) {
                    let anyTy = Ty.Named(this.anyIndex);
                    var k = 0;
                    for (x in a) {
                        if (x == anyTy) {
                            let src = if (k < this.specDescs.length()) this.specDescs[k] else null;
                            caps.push(src ?? TExpr.DescOfType(anyTy, anyTy));
                        }
                        k += 1;
                    }
                }
                TExpr.Closure(f, caps.toArray(), this.subst(t, a))
            }
            .Captured(k, t) => TExpr.Captured(k, this.subst(t, a)),
            .CapturedCell(k, t) => TExpr.CapturedCell(k, this.subst(t, a)),
            .CellOf(id, t) => TExpr.CellOf(id, this.subst(t, a)),
            .CallValue(f, xs, t) => TExpr.CallValue(
                this.specBox(f, a),
                this.specAll(xs, a),
                this.subst(t, a)
            ),
            // a type parameter's value as an interface value: a copy at a scalar or a string boxes
            // it, as `fit` does for a type known where it is written
            .Upcast(x, t) => {
                let v = this.specExpr(x.value, a);
                let vt = typeOf(v);
                let written = typeOf(x.value);
                if (this.boxed(vt) && this.dynamic(written)) {
                    // a `T[]` of a shared copy: `List<Any>`'s box at run time, of `T`'s descriptor
                    this.entryOf(Ty.List(boxTy(Ty.Named(this.anyIndex))));
                    TExpr.BoxOfD(boxE(v), boxE(this.descExpr(written, a)), this.subst(t, a))
                } else if (this.boxed(vt)) {
                    TExpr.BoxOf(boxE(v), this.entryOf(vt), this.subst(t, a))
                } else {
                    TExpr.Upcast(boxE(v), this.subst(t, a))
                }
            }
            .CallIface(slot, xs, t) => {
                let all = this.specAll(xs, a);
                let receiver = if (all.length() > 0) typeOf(all[0]) else Ty.Unknown;
                TExpr.CallIface(this.slotOfValue(receiver, slot), all, this.subst(t, a))
            }
            .BoxOf(x, k, t) => TExpr.BoxOf(this.specBox(x, a), k, this.subst(t, a)),
            .BoxOfD(x, d, t) => TExpr.BoxOfD(
                this.specBox(x, a),
                this.specBox(d, a),
                this.subst(t, a)
            ),
            .GenericCompare(x, op, y) => {
                let l = this.specExpr(x.value, a);
                let r = this.specExpr(y.value, a);
                let t = typeOf(l);
                let native = t == .Int
                    || t == .Float
                    || t == .Bool
                    || t == .Char
                    || t == .Str
                    || this.isScalarEnum(t);
                if (op != .Eq && op != .Ne) {
                    // `<` …: the scalars natively, another through its `compare` (S7c5b)
                    if (let n = this.nativeOrder(l, op, r, nowhereSpan)) {
                        return n;
                    }
                    return this.ordered(l, op, r, nowhereSpan);
                }
                let eq = if (native) this.equality(l, BinaryOp.Eq, r, nowhereSpan)
                    else TExpr.Call(this.genericEqFnOf(t, nowhereSpan), [l, r], Ty.Bool);
                if (op == .Eq) eq else TExpr.Unary(UnaryOp.Not, boxE(eq), Ty.Bool)
            }
            .Unbox(x, t) => TExpr.Unbox(this.specBox(x, a), this.subst(t, a)),
            .IsType(x, k, t) => if (this.dynamic(Ty.Named(k))) TExpr.IsDesc(
                this.specBox(x, a),
                boxE(this.descExpr(Ty.Named(k), a))
            )
                else TExpr.IsType(this.specBox(x, a), this.specType(k, a), this.subst(t, a)),
            .IsParam(x, k, t) => {
                let src = if (k < this.specDescs.length()) this.specDescs[k] else null;
                if (src != null) {
                    TExpr.IsDesc(this.specBox(x, a), boxE(src))
                } else if (k < a.length()) {
                    this.typeTest(this.specExpr(x.value, a), a[k], nowhereSpan) ?? TExpr.Bool(false)
                } else {
                    TExpr.IsParam(this.specBox(x, a), k, t)
                }
            }
            .IsDesc(x, d) => TExpr.IsDesc(
                this.specBox(x, a),
                match (d.value) {
                    // `is T[]` (S7c4c3b): the copy's descriptor of the list type
                    .DescOfType(dt, _) => if (hasParam(dt)) boxE(this.descExpr(dt, a))
                        else this.specBox(d, a),
                    _ => this.specBox(d, a),
                }
            ),
            .CallStatic(k, ii, member, slot, xs, t) => {
                let all = this.specAll(xs, a);
                let rt = this.subst(t, a);
                let src = if (k < this.specDescs.length()) this.specDescs[k] else null;
                if (src != null) {
                    // a shared copy: the function in the slot of the argument's descriptor — the
                    // slot of the instance the copy's arguments make (S7c5d1)
                    return TExpr.CallStaticD(this.slotAt(ii, member, a, slot), boxE(src), all, rt);
                }
                let concrete = if (k < a.length()) a[k] else Ty.Unknown;
                let entry = this.entryOf(concrete);
                let own = if (entry >= 0) this.methodOf(entry, member) else null;
                if (own != null && this.functions[own].isStatic) {
                    // a static generic of its own (S7c4c2: `fromIter<I>`): its copy, its owner's
                    // parameters the entry's arguments, its own the arguments' types
                    let info = this.types[entry];
                    let prefix: Ty[] = if (info.template >= 0 && info.template != entry) info.args
                        else [];
                    return TExpr.Call(this.inferredCopy(own, prefix, all), all, rt);
                }
                let found = this.ifaceMember(ii, member);
                if (found == null) {
                    return TExpr.Unknown;
                }
                let (fi, _) = found;
                // `Default.default` of a type that has one without its own (S7c6c1)
                if (this.functions[fi].owner == this.synth.defaultIx
                    && this.functions[fi].abstract) {
                    return TExpr.Call(this.defaultFnOf(concrete), all, rt);
                }
                TExpr.Call(this.inferredCopy(fi, this.bindsOf(fi, ii, concrete), all), all, rt)
            }
            .CallStaticD(slot, d, xs, t) => TExpr.CallStaticD(
                slot,
                this.specBox(d, a),
                this.specAll(xs, a),
                this.subst(t, a)
            ),
            .TextOf(x, open, debug) => {
                // the type put in: its own text; still open, the value's form through its table
                let v = this.specExpr(x.value, a);
                let t = this.subst(open, a);
                let still = match (t) {
                    .Assoc(_, _, _) | .Param(_) | .Unknown => true,
                    _ => false,
                };
                if (still) TExpr.CallIface(
                    if (debug) this.debugSlotOf() else this.textSlotOf(),
                    [v],
                    Ty.Str
                )
                    else this.textInCopy(v, t, debug)
            }
            .TextParam(x, k, t) => {
                let src = if (k < this.specDescs.length()) this.specDescs[k] else null;
                if (src != null || k >= a.length()) {
                    // a shared copy: the value's text through its table (S7e3; its Debug form
                    // before, a `Display` printed as no `Display`)
                    TExpr.CallIface(this.textSlotOf(), [this.specExpr(x.value, a)], t)
                } else {
                    this.textInCopy(this.specExpr(x.value, a), a[k], false)
                }
            }
            .DebugParam(x, k, t) => {
                let src = if (k < this.specDescs.length()) this.specDescs[k] else null;
                // an argument still open — an associated type of an instance only a signature
                // names, `FlatMapIter<I, B, B.Iter>` (S7c6b) — has no form of its own here
                let open = k < a.length() && match (a[k]) {
                    .Assoc(_, _, _) => true,
                    _ => false,
                };
                if (src != null || k >= a.length() || open) {
                    // a shared copy: the value's own form, through its table
                    TExpr.CallIface(this.debugSlotOf(), [this.specExpr(x.value, a)], t)
                } else {
                    this.textInCopy(this.specExpr(x.value, a), a[k], true)
                }
            }
            .DescOfType(_, _) | .InstDesc(_, _, _) | .DescOfValue(_, _) | .DescArg(_, _, _) => e,
            .DescVariant(_, _, _) | .NewD(_, _, _, _, _) => e,
            .SameRef(x, y) => TExpr.SameRef(this.specBox(x, a), this.specBox(y, a)),
            .IsIface(x, k, t) => TExpr.IsIface(this.specBox(x, a), k, this.subst(t, a)),
            .CallGeneric(fi, targs, xs, t) => {
                let bound = List<Ty>.new();
                for (x in targs) {
                    bound.push(this.subst(x, a));
                }
                let b = bound.toArray();
                let inst = this.instanceOf(fi, b);
                // after the arguments, the descriptors the copy takes hidden (S3i)
                let all = List<TExpr>.new();
                for (x in this.specAll(xs, a)) {
                    all.push(x);
                }
                for (k in this.hiddenOf(fi, b)) {
                    all.push(this.descExpr(targs[k], a));
                }
                TExpr.Call(inst, all.toArray(), this.subst(t, a))
            }
            .GenericValue(fi, targs, t) => {
                let bound = List<Ty>.new();
                for (x in targs) {
                    bound.push(this.subst(x, a));
                }
                let b = bound.toArray();
                let inst = this.instanceOf(fi, b);
                let hidden = this.hiddenOf(fi, b);
                let ft = this.subst(t, a);
                if (hidden.length() == 0) {
                    return this.thunk(inst, nowhereSpan);
                }
                let caps = List<TExpr>.new();
                for (k in hidden) {
                    caps.push(this.descExpr(targs[k], a));
                }
                TExpr.Closure(this.descThunk(inst, hidden.length(), ft), caps.toArray(), ft)
            }
            .CallBound(bt, ii, member, slot, xs, t) => {
                let concrete = this.subst(bt, a);
                this.memberCallOn(
                    concrete,
                    ii,
                    member,
                    this.slotAt(ii, member, a, slot),
                    this.specAll(xs, a),
                    this.subst(t, a)
                )
            }
            .CallConstraint(k, ii, member, slot, xs, t) => {
                let all = this.specAll(xs, a);
                let rt = this.subst(t, a);
                let concrete = if (k < a.length()) a[k] else Ty.Unknown;
                // the slot of the instance the copy's arguments make (S7c5d1)
                let at = this.slotAt(ii, member, a, slot);
                // a shared copy: through the receiver's own table — not a member the compiler
                // synthesizes, which no table holds, its copies exact (S7c6c1: `a.equals(b)` of
                // `T :: [Equatable]` over a class was LYS-ICE0001 since S7c5a)
                if (this.sharedShape(concrete) && !this.synthesizedMember(ii, member)) {
                    return TExpr.CallIface(at, all, rt);
                }
                this.memberCallOn(concrete, ii, member, at, all, rt)
            }
        };
    }

    /// Member `member` of interface `ii` called on a value of the concrete type: the type's own
    /// method, or the interface's default — a copy for the type where it is generic over `Self`,
    /// else on the receiver made an interface value.
    mut fn memberCallOn(
        concrete: Ty,
        ii: int,
        member: string,
        slot: int,
        all: TExpr[],
        rt: Ty
    ): TExpr {
        match (concrete) {
            .Assoc(_, _, _) | .Param(_) => {
                return TExpr.CallIface(slot, all, rt);
            }
            .Named(i) => {
                if (this.types[i].kind == .Interface) {
                    return TExpr.CallIface(slot, all, rt);
                }
            }
            _ => { }
        }
        // a copy of its own: the type's own method, or the interface's default
        let entry = this.entryOf(concrete);
        let own = if (entry >= 0) this.memberFor(entry, ii, member) else null;
        if (own != null) {
            // a list's block member: at its element (S7c6c1; operatorMember's since S7c5c3)
            match (concrete) {
                .List(e) => {
                    if (this.functions[own].typeParams.length() > 0) {
                        return TExpr.CallGeneric(own, [e.value], all, rt);
                    }
                }
                _ => { }
            }
            // a generic entry's method (a list's, S7c3): its copy at the entry's arguments
            let info = this.types[entry];
            if (this.functions[own].typeParams.length() > 0
                && info.template >= 0
                && info.template != entry) {
                let b = info.args;
                let xs = List<TExpr>.new();
                for (x in all) {
                    xs.push(x);
                }
                for (k in this.hiddenOf(own, b)) {
                    xs.push(this.descExpr(b[k], []));
                }
                return TExpr.Call(this.instanceOf(own, b), xs.toArray(), rt);
            }
            return TExpr.Call(own, all, rt);
        }
        // the member a blanket block gives the type with the interface (05 §13 rule 8): no own
        // conformance stands beside it (`LYS-SEM0133`)
        let e = this.blanketGives(concrete, ii);
        if (e >= 0) {
            let bfi = this.types[e].methods.get(member) ?? -1;
            if (bfi >= 0) {
                if (let b = this.blanketBindsAt(e, concrete)) {
                    return TExpr.Call(this.selfCopyIn(bfi, b), all, rt);
                }
            }
        }
        let found = this.ifaceMember(ii, member);
        if (found == null) {
            return TExpr.Unknown;
        }
        let (fi, _) = found;
        // `Equatable.equals` of a type that compares without one of its own (S7c5a)
        if (this.functions[fi].owner == this.equatableIndex && this.functions[fi].abstract) {
            return TExpr.Call(this.genericEqFnOf(concrete, nowhereSpan), all, rt);
        }
        // `Clone.clone` of a type that clones without one of its own (S7c6c1)
        if (this.functions[fi].owner == this.synth.cloneIx && this.functions[fi].abstract) {
            return TExpr.Call(this.cloneFnOf(concrete), all, rt);
        }
        // `Hashable.hash` of a type that hashes without one of its own (S7d1)
        if (this.functions[fi].owner == this.synth.hashableIx && this.functions[fi].abstract) {
            return TExpr.Call(this.hashFnOf(concrete), all, rt);
        }
        // `Display.show` and `showTo` of a list: its Debug form (S7e3b) — through a function of
        // its own, as a copy takes no local of the context
        if (this.functions[fi].owner == this.synth.displayIx && this.synth.displayIx >= 0) {
            match (concrete) {
                .List(_) => {
                    let text = this.textInCopy(all[0], concrete, true);
                    if (member == "show") {
                        return text;
                    }
                    let append = this.types[this.synth.builderIx].methods.get("appendStr") ?? -1;
                    return TExpr.Call(append, [all[1], text], Ty.Void);
                }
                _ => { }
            }
        }
        let owner = this.functions[fi].owner;
        if ((owner == this.orderedIndex || owner == this.totalOrderIndex)
            && owner >= 0
            && this.functions[fi].abstract) {
            return this.compareCall(
                concrete,
                all[0],
                all[1],
                owner == this.totalOrderIndex,
                nowhereSpan
            );
        }
        // an abstract member has no body for a copy: the type left unresolved is the compiler's
        // fault, said where it runs (S7c4c3a: the copy of an abstract `next` looped forever)
        if (this.functions[fi].abstract) {
            return TExpr.Unknown;
        }
        if (this.ifaceGeneric(fi)) {
            // a default generic over `Self` or over a generic interface's parameters: its copy for
            // the type and the instance, the receiver as it is
            return TExpr.Call(this.selfCopyIn(fi, this.bindsOf(fi, ii, concrete)), all, rt);
        }
        let iface = Ty.Named(this.functions[fi].owner);
        let rest = List<TExpr>.new();
        rest.push(
            if (this.boxed(concrete)) TExpr.BoxOf(boxE(all[0]), entry, iface)
                else TExpr.Upcast(boxE(all[0]), iface)
        );
        var j = 1;
        while (j < all.length()) {
            rest.push(all[j]);
            j += 1;
        }
        return TExpr.Call(fi, rest.toArray(), rt);
    }

    /// `t` with type parameter `k` replaced by `a[k]` throughout — in an instance of a generic
    /// type too, which becomes the instance of the replaced arguments.
    mut fn subst(t: Ty, a: Ty[]): Ty {
        if (a.length() == 0) {
            return t;
        }
        return match (t) {
            .Param(k) => if (k < a.length()) a[k] else t,
            .Assoc(b, ii, n) => {
                let nb = this.subst(b.value, a);
                // the instance of a generic interface it belongs to (S7c5d3)
                let owner = this.assocAt(ii, b.value, a);
                match (nb) {
                    // through a type parameter: what a constraint fixes, else still open
                    .Param(k) => this.selfAnswer(k, n)
                        ?? this.fixedAt(k, n, owner)
                        ?? Ty.Assoc(boxTy(nb), owner, n),
                    // still open: an associated type of one
                    .Unknown | .Assoc(_, _, _) => Ty.Assoc(boxTy(nb), owner, n),
                    _ => this.answerIn(nb, owner, n) ?? Ty.Unknown,
                }
            }
            .Named(i) => {
                let info = this.types[i];
                if (info.template < 0 || info.args.length() == 0) {
                    return t;
                }
                let args = List<Ty>.new();
                var changed = false;
                for (x in info.args) {
                    let y = this.subst(x, a);
                    changed = changed || y != x;
                    args.push(y);
                }
                if (changed) Ty.Named(this.typeInstance(info.template, args.toArray())) else t
            }
            .Optional(inner) => Ty.Optional(boxTy(this.subst(inner.value, a))),
            .List(inner) => Ty.List(boxTy(this.subst(inner.value, a))),
            .Map(k, v) => Ty.Map(boxTy(this.subst(k.value, a)), boxTy(this.subst(v.value, a))),
            .Cell(inner) => Ty.Cell(boxTy(this.subst(inner.value, a))),
            .Tuple(tt) => {
                let es = List<Ty>.new();
                for (x in tt.elements) {
                    es.push(this.subst(x, a));
                }
                Ty.Tuple(TupleTy { elements = es.toArray(), labels = tt.labels })
            }
            .Fn(ft) => {
                let ps = List<Ty>.new();
                for (x in ft.params) {
                    ps.push(this.subst(x, a));
                }
                Ty.Fn(
                    FnTy { params = ps.toArray(), result = boxTy(this.subst(ft.result.value, a)) }
                )
            }
            _ => t,
        };
    }

    /// `t` with the type parameters bound so far replaced; the others stay.
    mut fn substOpen(t: Ty, binds: (?Ty)[]): Ty {
        let a = List<Ty>.new();
        var k = 0;
        for (b in binds) {
            a.push(b ?? Ty.Param(k));
            k += 1;
        }
        return this.subst(t, a.toArray());
    }

    /// Binds the type parameters of `pattern` by `actual` (03 §9.2 rule 1), through instances of
    /// one generic type too.
    mut fn bind(pattern: Ty, actual: Ty, binds: List<?Ty>): void {
        match (pattern) {
            .Named(p) => {
                match (actual) {
                    .Named(x) => {
                        let pi = this.types[p];
                        let xi = this.types[x];
                        if (pi.template >= 0 && pi.template == xi.template) {
                            var k = 0;
                            while (k < pi.args.length() && k < xi.args.length()) {
                                this.bind(pi.args[k], xi.args[k], binds);
                                k += 1;
                            }
                        }
                    }
                    _ => { }
                }
            }
            _ => bindTyFree(pattern, actual, binds),
        }
    }

    /// The instance of generic type `ti` for `args` (03 §9.1): one entry per argument list, its
    /// fields and variants the template's with the arguments in place.
    mut fn typeInstance(ti: int, args: Ty[]): int {
        let tmpl = this.types[ti];
        // a written interface at parameters of its own spelling is an instance too: `T ::
        // [Combine<T>]` of `fn f<T>` is no template, which any instance meets (S7c5c1)
        var own = args.length() == tmpl.typeParams.length() && !this.exactInstance;
        var k = 0;
        for (x in args) {
            own = own && x == Ty.Param(k);
            k += 1;
        }
        if (own) {
            return ti;
        }
        let names = List<string>.new();
        let keys = List<string>.new();
        for (x in args) {
            names.push(this.tyName(x));
            keys.push(tyKey(x));
        }
        let key = f"type {ti}<{keys.toArray().join(",")}>";
        let known = this.instances.get(key);
        if (known != null) {
            return known;
        }
        let index = this.types.length();
        this.types.push(
            TypeInfo {
                name = f"{tmpl.name}<{names.toArray().join(", ")}>",
                kind = tmpl.kind,
                methods = tmpl.methods,
            }
        );
        this.instances.insert(key, index);
        let info = this.types[index];
        info.template = ti;
        info.args = args;
        info.vmHeld = tmpl.vmHeld;
        if (tmpl.kind == .Interface) {
            // an instance of a generic interface (S7c1): the template's kind; slots of its own,
            // given out as they are asked (`slotIn`, S7c5d1)
            info.slotOf = Map<string, int>.new();
            info.selfParam = tmpl.selfParam;
            info.sealed = tmpl.sealed;
        }
        if (tmpl.filled) {
            this.fillInstance(index);
        }
        return index;
    }

    /// An instance's fields and variants, its template's with the arguments in place.
    mut fn fillInstance(i: int) {
        let info = this.types[i];
        if (info.filled) {
            return;
        }
        info.filled = true;
        let tmpl = this.types[info.template];
        let fields = List<FieldInfo>.new();
        for (f in tmpl.fields) {
            fields.push(
                FieldInfo {
                    name = f.name,
                    ty = this.subst(f.ty, info.args),
                    isVar = f.isVar,
                    default = null,
                }
            );
        }
        info.fields = fields.toArray();
        info.variants = tmpl.variants;
        info.variantNamed = tmpl.variantNamed;
        info.payload = tmpl.payload;
        let all = List<FieldInfo[]>.new();
        for (vf in tmpl.variantFields) {
            let fs = List<FieldInfo>.new();
            for (f in vf) {
                fs.push(
                    FieldInfo {
                        name = f.name,
                        ty = this.subst(f.ty, info.args),
                        isVar = f.isVar,
                        default = null,
                    }
                );
            }
            all.push(fs.toArray());
        }
        info.variantFields = all.toArray();
    }

    /// An instance's table: each slot's function, the template's copied for the arguments.
    /// A type's table entries that are an interface's defaults generic over `Self`: copied for
    /// the type, a static one a copy of its own (S3i).
    mut fn tableSelf(i: int): void {
        let info = this.types[i];
        if (info.kind == .Interface || (info.template >= 0 && info.template != i)) {
            return;
        }
        if (info.typeParams.length() > 0) {
            // a template: its instances copy their entries
            return;
        }
        // by slot: the copies are made in the same order in every run
        var slot = 0;
        while (slot < this.slotCount) {
            let fi = info.witness.get(slot) ?? -1;
            if (fi >= 0 && this.blanketOwned(fi)) {
                // a blanket block's member: its copy for the type, through a box unboxed (S7c4c3a)
                let self = this.selfTy(i);
                let b = this.blanketBindsAt(this.functions[fi].owner, self);
                if (b != null) {
                    let copy = this.selfCopyIn(fi, b);
                    info.witness.insert(
                        slot,
                        if (this.boxed(self) && !this.functions[fi].isStatic) this.unboxer(
                            copy,
                            self,
                            Ty.Named(this.slotIface(i, slot))
                        )
                            else copy
                    );
                }
            } else if (fi >= 0 && this.ifaceGeneric(fi)) {
                let binds = List<Ty>.new();
                if (this.selfGeneric(fi)) {
                    binds.push(this.selfTy(i));
                }
                for (x in info.slotArgs.get(slot) ?? []) {
                    binds.push(x);
                }
                if (binds.length() == this.functions[fi].typeParams.length()) {
                    info.witness.insert(slot, this.selfCopyIn(fi, binds.toArray()));
                }
            }
            slot += 1;
        }
    }

    /// Whether `fi` is a blanket block's member itself, not a copy of one (S7c4c3a).
    mut fn blanketOwned(fi: int): bool {
        let f = this.functions[fi];
        return f.owner >= 0 && this.types[f.owner].blanketAt >= 0 && f.typeParams.length() > 0;
    }

    /// The interface of type `i` whose member has slot `slot`.
    mut fn slotIface(i: int, slot: int): int {
        for (x in this.types[i].ifaces) {
            for (a in this.ancestry(x)) {
                let base = this.types[this.ifaceBase(a)];
                for (name in base.memberNames) {
                    if (this.slotIn(a, name) == slot) {
                        return a;
                    }
                }
            }
        }
        return this.anyIndex;
    }

    /// Whether `fi` is a member of an interface generic over `Self` or over its own parameters:
    /// a table holds its copy for the conformer (S7c1b).
    mut fn ifaceGeneric(fi: int): bool {
        let f = this.functions[fi];
        return f.owner >= 0 && this.types[f.owner].kind == .Interface && f.typeParams.length() > 0;
    }

    /// What the copy of interface member `fi` in the table of instance `i` of a generic type binds:
    /// `Self` the instance, then the slot's arguments as the template wrote them, at the
    /// instance's arguments (S7c1b).
    mut fn tableBinds(fi: int, i: int, slot: int): Ty[] {
        let info = this.types[i];
        let out = List<Ty>.new();
        if (this.selfGeneric(fi)) {
            out.push(Ty.Named(i));
        }
        for (x in this.types[info.template].slotArgs.get(slot) ?? []) {
            out.push(this.subst(x, info.args));
        }
        return out.toArray();
    }

    /// Whether `fi` is a member of an interface generic over `Self`.
    mut fn selfGeneric(fi: int): bool {
        let f = this.functions[fi];
        return f.owner >= 0
            && this.types[f.owner].kind == .Interface
            && this.types[f.owner].selfParam
            && f.typeParams.length() > 0;
    }

    /// The copy of `fi`, generic over `Self`, for the type `self`: a static one a copy of its
    /// own, since a call through a descriptor hands it no `Self`.
    mut fn selfCopy(fi: int, self: Ty): int {
        return this.selfCopyIn(fi, [self]);
    }

    /// The exact copy of `fi` for a call of arguments `all` (S7c4c2): its first parameters bound
    /// by `prefix`, the rest inferred from the arguments' types; `fi` itself where it is generic
    /// over nothing.
    mut fn inferredCopy(fi: int, prefix: Ty[], all: TExpr[]): int {
        let f = this.functions[fi];
        let n = f.typeParams.length();
        if (n == 0) {
            return fi;
        }
        let binds = List<?Ty>.new();
        var k = 0;
        while (k < n) {
            binds.push(if (k < prefix.length()) prefix[k] else null);
            k += 1;
        }
        var j = 0;
        for (p in f.params) {
            if (j < all.length()) {
                this.bind(p.ty, typeOf(all[j]), binds);
            }
            j += 1;
        }
        let out = List<Ty>.new();
        for (b in binds) {
            out.push(b ?? Ty.Unknown);
        }
        return this.selfCopyIn(fi, out.toArray());
    }

    /// The copy of interface member `fi` at `binds` — `Self`, then a generic interface's arguments
    /// (S7c1b); a static one a copy of its own.
    mut fn selfCopyIn(fi: int, binds: Ty[]): int {
        // a copy of its own for the binds: a table's call hands it no hidden descriptor, and a
        // method generic over `Self` reads `Self` alone from its receiver (S7c4c1)
        let saved = this.copyExact;
        this.copyExact = true;
        let k = this.instanceOf(fi, binds);
        this.copyExact = saved;
        return k;
    }

    mut fn tableInstance(i: int): void {
        let info = this.types[i];
        if (info.tabled || info.template < 0 || info.template == i) {
            return;
        }
        info.tabled = true;
        let tmpl = this.types[info.template];
        // an instance of the lists' entry a copy made, after `fillDebugSlot`: its Debug form out
        // of its box too (S7c4c3b: `f([1, 2])` of `fn f<T>(xs: T[]): Any` printed through nothing)
        if (this.debugSlot >= 0
            && (info.kind == .Builtin || info.vmHeld)
            && !info.witness.containsKey(this.debugSlot)) {
            let quiet = this.quietDebug;
            this.quietDebug = true;
            info.witness.insert(this.debugSlot, this.boxTextOf(i, false));
            this.quietDebug = quiet;
        }
        // a list's `Display`, its Debug form, where a shared copy reaches it through the table
        // (S7e3b); `showTo` the interface's default
        let di = this.synth.displayIx;
        if (di >= 0 && info.kind == .Builtin && tmpl.name == "List") {
            let show = this.slotIn(di, "show");
            if (show >= 0 && !info.witness.containsKey(show)) {
                let quiet = this.quietDebug;
                this.quietDebug = true;
                info.witness.insert(show, this.boxTextOf(i, true));
                this.quietDebug = quiet;
            }
            let showTo = this.slotIn(di, "showTo");
            if (let found = this.ifaceMember(di, "showTo")) {
                let (fi, _) = found;
                if (showTo >= 0 && !info.witness.containsKey(showTo)) {
                    info.witness.insert(showTo, fi);
                }
            }
        }
        // its text too (S7e3)
        let ts = this.synth.textSlot;
        if (ts >= 0 && (info.kind == .Builtin || info.vmHeld) && !info.witness.containsKey(ts)) {
            let quiet = this.quietDebug;
            this.quietDebug = true;
            info.witness.insert(ts, this.boxTextOf(i, true));
            this.quietDebug = quiet;
        }
        // its template's conformances, and those a block on it alone gave (S7c4c3b) — a
        // conditional one where its arguments meet the condition: what `is` asks at run time
        // (since S3i every instance's descriptor listed them all, `Cond<int> is Named`)
        let merged = List<int>.new();
        for (x in tmpl.ifaces) {
            let cond = tmpl.condIfaces.get(x);
            if (cond == null || this.meetsBlock(info.args, cond)) {
                merged.push(x);
            }
        }
        for (x in info.instIfaces) {
            merged.push(x);
        }
        info.ifaces = merged.toArray();
        // the slots of a conditional conformance the arguments do not meet: no copy, the instance
        // is no value of it (S7c5c3: `List<Foo>`'s `contains` copied `==` over a class that has none)
        let unmet = Set<int>.new();
        for (x in tmpl.ifaces) {
            let cond = tmpl.condIfaces.get(x);
            if (cond != null && !this.meetsBlock(info.args, cond)) {
                for (a in this.ancestry(x)) {
                    let base = this.types[this.ifaceBase(a)];
                    for (name in base.memberNames) {
                        unmet.insert(this.slotIn(a, name));
                    }
                }
            }
        }
        // an interface at the template's parameters and the one at this instance's arguments have
        // slots of their own: each member moves to the instance's (S7c5d1)
        let moved = Map<int, int>.new();
        for (x in tmpl.ifaces) {
            let xi = this.ifaceAt(x, info.args);
            if (xi != x) {
                for (name in this.types[this.ifaceBase(x)].memberNames) {
                    let from = this.slotIn(x, name);
                    let to = this.slotIn(xi, name);
                    if (from >= 0 && to >= 0 && from != to) {
                        moved.insert(from, to);
                    }
                }
            }
        }
        // by slot: the instances are made in the same order in every run
        let slots = this.slotCount;
        var slot = 0;
        while (slot < slots) {
            let fi = if (unmet.contains(slot)) -1 else tmpl.witness.get(slot) ?? -1;
            let target = moved.get(slot) ?? slot;
            // a member generic of its own is called on its type alone, never through the table:
            // the template stands in its slot, as in a plain type's (S7c4c2)
            if (fi >= 0 && this.ownTypeParams(fi) > 0) {
                info.witness.insert(target, fi);
            } else if (fi >= 0 && this.blanketOwned(fi)) {
                // a blanket block's member: its copy at what the instance binds (S7c4c3a), through
                // the box of a list or of a value the VM holds unboxed (S7c4c3b)
                let self = this.selfTy(i);
                let b = this.blanketBindsAt(this.functions[fi].owner, self);
                if (b != null) {
                    let copy = this.selfCopyIn(fi, b);
                    info.witness.insert(
                        target,
                        if (this.boxed(self) && !this.functions[fi].isStatic) this.unboxer(
                            copy,
                            self,
                            Ty.Named(this.slotIface(i, slot))
                        )
                            else copy
                    );
                } else {
                    info.witness.insert(target, fi);
                }
            } else if (fi >= 0) {
                info.witness.insert(
                    target,
                    if (this.ifaceGeneric(fi)) this.selfCopyIn(fi, this.tableBinds(fi, i, slot))
                        else if (this.functions[fi].typeParams.length() > 0) this.instanceOf(
                            fi,
                            info.args
                        )
                            else fi
                );
            }
            slot += 1;
        }
    }

    /// The type parameters of declaration `params` in scope by name; their constraints read.
    mut fn typeParamsOf(params: TypeParam[]): TypeParamInfo[] {
        let out = List<TypeParamInfo>.new();
        let savedSelf = this.defaultSelf;
        var j = 0;
        for (tp in params) {
            let cs = List<int>.new();
            // `T :: [Add]` is `T :: [Add<T>]` (S7c5c1)
            this.defaultSelf = Ty.Param(j);
            for (c in tp.constraints) {
                let ii = this.ifaceOf(c);
                if (ii < 0) {
                    continue;
                }
                cs.push(ii);
            }
            out.push(
                TypeParamInfo {
                    name = tp.name,
                    constraints = cs.toArray(),
                    defaultType = tp.defaultType,
                    defaultMod = this.mod,
                }
            );
            j += 1;
        }
        this.defaultSelf = savedSelf;
        return out.toArray();
    }

    /// `infos` with the associated types their constraints fix (05 §8 rule 5), read once the
    /// parameters are in scope: each one a constraint declares (`LYS-SEM0128` otherwise).
    mut fn withFixations(params: TypeParam[], infos: TypeParamInfo[]): TypeParamInfo[] {
        let out = List<TypeParamInfo>.new();
        var k = 0;
        for (tp in params) {
            let fixed = List<FixedTy>.new();
            var position = -1;
            for (c in tp.constraints) {
                position += 1;
                let ii = this.typeIndex.get(this.q(c.name));
                if (ii == null) {
                    continue;
                }
                // the instance the constraint names: its fixations are its answers (S7c5d3)
                let cs = infos[k].constraints;
                let named = if (position < cs.length()
                    && this.ifaceBase(cs[position]) == ii) cs[position]
                    else ii;
                for (fx in c.fixed) {
                    var declaring = -1;
                    for (x in this.ancestry(named)) {
                        for (n in this.assocNamesOf(x)) {
                            if (n == fx.name && declaring < 0) {
                                declaring = x;
                            }
                        }
                    }
                    if (declaring < 0) {
                        this.error(
                            "LYS-SEM0128",
                            f"'{c.name}' declares no associated type '{fx.name}' to fix",
                            fx.span
                        );
                        continue;
                    }
                    fixed.push(
                        FixedTy {
                            iface = declaring,
                            name = fx.name,
                            ty = this.resolveType(fx.type),
                        }
                    );
                }
            }
            let info = infos[k];
            out.push(
                TypeParamInfo {
                    name = info.name,
                    constraints = info.constraints,
                    fixed = fixed.toArray(),
                    defaultType = info.defaultType,
                    defaultMod = info.defaultMod,
                }
            );
            k += 1;
        }
        return out.toArray();
    }

    /// Makes a generic type a template: its parameters in scope for what follows.
    mut fn enterGenericType(index: int, params: TypeParam[]): void {
        let info = this.types[index];
        info.typeParams = this.typeParamsOf(params);
        this.declaringParams = info.typeParams;
        let fixScope = Map<string, int>.new();
        var j = 0;
        for (tp in params) {
            fixScope.insert(tp.name, j);
            j += 1;
        }
        let outerScope = this.typeParams;
        this.typeParams = fixScope;
        info.typeParams = this.withFixations(params, info.typeParams);
        this.declaringParams = info.typeParams;
        this.typeParams = outerScope;
        info.template = index;
        let own = List<Ty>.new();
        let scope = Map<string, int>.new();
        var k = 0;
        for (tp in params) {
            own.push(Ty.Param(k));
            scope.insert(tp.name, k);
            k += 1;
        }
        info.args = own.toArray();
        this.typeParams = scope;
    }

    /// A fresh context for function `k`: its receiver and its parameters its first locals.
    mut fn enterFn(k: int, decl: FnDecl, fixing: bool): void {
        let info = this.functions[k];
        this.ctx = FnCtx.new(k, info.returns, false, fixing);
        if (info.owner >= 0 && !info.isStatic) {
            let recv = this.selfFor(info.owner) ?? this.selfTy(info.owner);
            this.declareLocal("this", recv, false, decl.span);
        }
        for (p in info.params) {
            this.declareLocal(p.name, p.ty, false, decl.span);
        }
    }

    mut fn fnBody(k: int, decl: FnDecl): TStmt[] {
        let info = this.functions[k];
        let body = List<TStmt>.new();
        match (decl.body) {
            .Block(b) => {
                // a coroutine function (Lyric 5 10 §1 rule 1): its body is a coroutine's, which a
                // call makes without running it — a closure of no parameter that holds the call's
                // arguments
                let co = this.coroutineArgs(info.returns);
                if (co.length() == 2 && (hasOwnYield(b) || !returnsValue(b))) {
                    this.pendingBody = GenBody {
                        y = co[0],
                        inferY = false,
                        r = co[1],
                        inferR = false,
                        quiet = false,
                        pathCode = "LYS-SEM0017",
                    };
                    let coBody = this.makeLambda(
                        "<coroutine>",
                        [],
                        [],
                        co[1],
                        Expr.Block(b, decl.span),
                        decl.span
                    );
                    return [TStmt.Return(TExpr.CoNew(boxE(coBody), info.returns), decl.span.line)];
                }
                for (s in this.stmtList(b.stmts)) {
                    body.push(s);
                }
                if (info.returns != .Void && info.returns != .Unknown && !endsAll(body.toArray())) {
                    this.error(
                        "LYS-SEM0017",
                        f"'{info.name}' can reach its end without returning its {this.tyName(info.returns)}",
                        decl.span
                    );
                }
            }
            .Expr(e) => {
                let inferring = this.fnStates[k] == .Inferring;
                let value = if (inferring) this.expr(e, null)
                    else this.coerce(this.expr(e, info.returns), info.returns, spanOf(e));
                if (inferring && !this.ctx.fixing) {
                    info.returns = typeOf(value);
                }
                // a value of no type is run, then nothing returned (S7d2: it was dropped since S2d)
                if (typeOf(value) == .Void) {
                    body.push(TStmt.Expr(value, decl.span.line));
                    body.push(TStmt.Return(null, decl.span.line));
                } else {
                    body.push(TStmt.Return(value, decl.span.line));
                }
            }
            // an interface's abstract member: never run, its conformer's runs
            .None => { }
        }
        return body.toArray();
    }

    mut fn declareLocal(name: string, t: Ty, isVar: bool, at: Span): int {
        let scope = this.ctx.scopes[this.ctx.scopes.length() - 1].names;
        if (scope.containsKey(name)) {
            this.error("LYS-SEM0176", f"'{name}' is bound twice in one scope", at);
        }
        let id = this.ctx.locals.length();
        this.ctx.locals.push(t);
        this.ctx.localIsVar.push(isVar);
        this.ctx.localNames.push(name);
        this.ctx.boxed.push(false);
        scope.insert(name, id);
        return id;
    }

    /// A local the program does not name: where `?.`, `if let` and `while let` hold a value.
    mut fn hidden(t: Ty, at: Span): int {
        return this.declareLocal(f"${this.ctx.locals.length()}", t, false, at);
    }

    mut fn narrowedLocal(id: int): ?Ty {
        var k = this.ctx.scopes.length() - 1;
        while (k >= 0) {
            let t = this.ctx.scopes[k].narrowed.get(id);
            if (t != null) {
                return t;
            }
            k -= 1;
        }
        return null;
    }

    mut fn narrowedGlobal(id: int): ?Ty {
        var k = this.ctx.scopes.length() - 1;
        while (k >= 0) {
            let t = this.ctx.scopes[k].narrowedGlobals.get(id);
            if (t != null) {
                return t;
            }
            k -= 1;
        }
        return null;
    }

    /// The facts condition `c` gives where it is `when`: `x != null` narrows `x` where true,
    /// `x == null` where false; `&&` gives both sides' where true, `||` where false; `!` turns.
    mut fn factsOf(c: TExpr, when: bool): List<Fact> {
        let out = List<Fact>.new();
        this.collectFacts(c, when, out);
        return out;
    }

    mut fn collectFacts(c: TExpr, when: bool, out: List<Fact>): void {
        match (c) {
            .IsNull(x) => {
                if (!when) {
                    this.factOf(x.value, out);
                }
            }
            .Unary(op, x, _) => {
                if (op == .Not) {
                    this.collectFacts(x.value, !when, out);
                }
            }
            .Binary(a, op, b, _) => {
                if ((op == .And && when) || (op == .Or && !when)) {
                    this.collectFacts(a.value, when, out);
                    this.collectFacts(b.value, when, out);
                }
            }
            // `x is T`: where it holds, `x` is a `T` (05 §9 rule 4)
            .IsType(x, _, t) => {
                if (when) {
                    typeFact(x.value, t, out);
                }
            }
            .IsIface(x, _, t) => {
                if (when) {
                    typeFact(x.value, t, out);
                }
            }
            _ => { }
        }
    }

    mut fn factOf(x: TExpr, out: List<Fact>): void {
        match (x) {
            // a second test narrows again: a `??int` proven present once is a `?int` (§3.2)
            .Narrow(inner, t) => {
                match (t) {
                    .Optional(i) => {
                        match (inner.value) {
                            .Local(id, _) => out.push(
                                Fact { isGlobal = false, id = id, ty = i.value }
                            ),
                            .Global(g, _) => out.push(
                                Fact { isGlobal = true, id = g, ty = i.value }
                            ),
                            _ => { }
                        }
                    }
                    _ => { }
                }
            }
            .Local(id, t) => {
                match (t) {
                    .Optional(inner) => out.push(
                        Fact { isGlobal = false, id = id, ty = inner.value }
                    ),
                    _ => { }
                }
            }
            .Global(g, t) => {
                match (t) {
                    .Optional(inner) => out.push(
                        Fact { isGlobal = true, id = g, ty = inner.value }
                    ),
                    _ => { }
                }
            }
            _ => { }
        }
    }

    /// Narrows the bindings of `facts` in the innermost scope (Lyric 5 §3.2): a local, until an
    /// assignment ends it; a global `let`, never a global `var`, which any call may write.
    mut fn narrow(facts: List<Fact>): void {
        let scope = this.ctx.scopes[this.ctx.scopes.length() - 1];
        for (f in facts) {
            if (f.isGlobal) {
                if (!this.globals[f.id].isVar) {
                    scope.narrowedGlobals.insert(f.id, f.ty);
                }
            } else {
                scope.narrowed.insert(f.id, f.ty);
            }
        }
    }

    /// Ends the narrowing of local `id` in every scope: it has been written.
    mut fn unnarrow(id: int): void {
        for (scope in this.ctx.scopes) {
            scope.narrowed.remove(id);
        }
    }

    /// Before a loop: a narrowed local the loop writes is narrowed in none of its turns — the
    /// second turn would read it after the write.
    mut fn unnarrowWritten(region: Stmt[]): void {
        let written = List<int>.new();
        for (scope in this.ctx.scopes) {
            for (id in scope.narrowed.keys()) {
                if (writesIn(region, 0, this.ctx.localNames[id])) {
                    written.push(id);
                }
            }
        }
        for (id in written) {
            this.unnarrow(id);
        }
    }

    /// The statements of a block in order: what one of them lets the rest know is narrowed for the
    /// rest (an `if` whose one branch never comes out).
    mut fn stmtList(stmts: Stmt[]): TStmt[] {
        let out = List<TStmt>.new();
        var k = 0;
        while (k < stmts.length()) {
            // a `defer` or a `using`: the rest of the scope is its region (06 §5 rule 2, §7)
            match (stmts[k]) {
                .Defer(body, at) => {
                    let d = this.deferBody(body);
                    out.push(this.deferred(d, stmts, k + 1, at));
                    return out.toArray();
                }
                .Using(name, written, value, at) => {
                    let (bind, close) = this.usingLet(name, written, value, at);
                    out.push(bind);
                    out.push(this.deferred(close, stmts, k + 1, at));
                    return out.toArray();
                }
                _ => { }
            }
            this.postFacts = List<Fact>.new();
            out.push(this.stmt(stmts[k]));
            if (this.postFacts.length() > 0) {
                let facts = this.postFacts;
                this.postFacts = List<Fact>.new();
                this.narrow(facts);
            }
            k += 1;
        }
        return out.toArray();
    }

    /// A defer's body, checked where it stands; its jumps may not leave it (`LYS-SEM0904`).
    mut fn deferBody(body: Block): TStmt[] {
        let saved = this.ctx.deferLoops;
        this.ctx.deferLoops = this.ctx.loops.length();
        let out = this.block(body);
        this.ctx.deferLoops = saved;
        return out;
    }

    /// The rest of a scope, from `from` on, as the region of a defer: the defer runs on every way
    /// out of it, the last registered first — the rest's own defers are inside it (06 §5).
    mut fn deferred(d: TStmt[], stmts: Stmt[], from: int, at: Span): TStmt {
        let rest = List<Stmt>.new();
        var k = from;
        while (k < stmts.length()) {
            rest.push(stmts[k]);
            k += 1;
        }
        let body = this.stmtList(rest.toArray());
        let err = this.errorTy();
        let anyTy = Ty.Named(this.anyIndex);
        return TStmt.Finally(
            body,
            d,
            this.hidden(err, at),
            this.hidden(anyTy, at),
            this.hidden(err, at),
            this.hidden(anyTy, at),
            at.line
        );
    }

    /// `using let f = e`: `f` bound like a `let`, a `Closeable` (`LYS-SEM0143`), and its
    /// `close()` deferred (06 §7 rules 1–3).
    mut fn usingLet(name: string, written: ?TypeExpr, value: Expr, at: Span): (TStmt, TStmt[]) {
        let bind = this.letStmt(false, name, written, value, at);
        let read = match (bind) {
            .SetLocal(id, _, _) => TExpr.Local(id, this.ctx.locals[id]),
            .SetGlobal(g, _, _) => TExpr.Global(g, this.globals[g].ty),
            _ => TExpr.Unknown,
        };
        let t = typeOf(read);
        let ci = this.typeIndex.get("Closeable");
        if (t == .Unknown || ci == null) {
            return (bind, []);
        }
        if (!this.conformsTo(t, ci)) {
            this.error(
                "LYS-SEM0143",
                f"'using' closes what it binds: {this.tyName(t)} is not Closeable",
                at
            );
            return (bind, []);
        }
        let close = this.methodCall(read, "close", [], at, at);
        return (bind, [TStmt.Expr(close, at.line)]);
    }

    mut fn lookupLocal(name: string): ?int {
        var k = this.ctx.scopes.length() - 1;
        while (k >= 0) {
            let id = this.ctx.scopes[k].names.get(name);
            if (id != null) {
                return id;
            }
            k -= 1;
        }
        return null;
    }

    mut fn pushScope(): void {
        this.ctx.scopes.push(Scope.new());
    }

    mut fn popScope(): void {
        this.ctx.scopes.pop();
    }

    mut fn block(b: Block): TStmt[] {
        this.pushScope();
        let out = this.stmtList(b.stmts);
        this.popScope();
        return out;
    }

    /// A block where `facts` hold.
    mut fn blockWith(b: Block, facts: List<Fact>): TStmt[] {
        this.pushScope();
        this.narrow(facts);
        let out = this.block(b);
        this.popScope();
        return out;
    }

    // --- statements ------------------------------------------------------------------------------

    mut fn stmt(s: Stmt): TStmt {
        // the script's code: each statement of it its module's
        if (this.atTop()) {
            this.mod = fileModule(stmtSpan(s).file);
        }
        let out = this.stmtOf(s);
        // nothing follows a statement that never comes out: it adds nothing to what is assigned
        if (leaves(out)) {
            this.ctx.unassigned = Set<int>.new();
        }
        return out;
    }

    mut fn stmtOf(s: Stmt): TStmt {
        return match (s) {
            .Throw(value, at) => TStmt.Expr(this.throwOf(value), at.line),
            .Try(body, clauses, at) => this.tryStmt(body, clauses, at),
            .Expr(e, at) => this.exprStmt(e, at),
            .Let(isVar, name, written, value, at) => this.letStmt(isVar, name, written, value, at),
            .LocalFn(f) => this.localFn(f),
            .Destructure(isVar, pattern, value, otherwise, at) => this.destructure(
                isVar,
                pattern,
                value,
                otherwise,
                at
            ),
            .If(cond, then, otherwise, at) => {
                let c = this.condition(cond);
                let yes = this.factsOf(c, true);
                let no = this.factsOf(c, false);
                let before = this.ctx.unassigned;
                let t = this.blockWith(then, yes);
                let afterThen = this.ctx.unassigned;
                this.ctx.unassigned = before;
                var o: TStmt[] = [];
                if (otherwise != null) {
                    this.pushScope();
                    this.narrow(no);
                    o = [this.stmt(otherwise.value)];
                    this.popScope();
                }
                this.ctx.unassigned = afterThen.union(this.ctx.unassigned);
                // where one branch never comes out, what the other knows holds after the `if`
                if (leavesAll(t) && !leavesAll(o)) {
                    this.postFacts = no;
                } else if (otherwise != null && leavesAll(o) && !leavesAll(t)) {
                    this.postFacts = yes;
                }
                TStmt.If(c, t, o, at.line)
            }
            .While(cond, body, label, at) => {
                this.unnarrowWritten([s]);
                let c = this.condition(cond);
                let before = this.ctx.unassigned;
                this.pushLoop(LoopCtx { isLoop = false }, label, at);
                let b = this.blockWith(body, this.factsOf(c, true));
                this.popLoop();
                // the body may not run: what follows knows what the condition left
                this.ctx.unassigned = before;
                TStmt.While(c, b, at.line)
            }
            .IfLet(pattern, value, then, otherwise, at) => {
                match (pattern) {
                    .Name(name, _) => this.ifLet(name, value, then, otherwise, at),
                    _ => this.ifLetPattern(pattern, value, then, otherwise, at),
                }
            }
            .WhileLet(pattern, value, body, label, at) => {
                this.unnarrowWritten([s]);
                match (pattern) {
                    .Name(name, _) => this.whileLet(name, value, body, label, at),
                    _ => this.whileLetPattern(pattern, value, body, label, at),
                }
            }
            .For(name, iterable, body, label, at) => {
                this.unnarrowWritten([s]);
                this.forStmt(name, iterable, body, label, at)
            }
            .Break(label, value, at) => this.breakStmt(label, value, at),
            .Continue(label, at) => {
                var out = 0;
                if (this.ctx.loops.length() == 0) {
                    this.error("LYS-SEM0147", "'continue' outside a loop", at);
                } else {
                    let k = this.jumpTarget(label, at);
                    if (k >= 0) {
                        this.outOfDefer("continue", k, at);
                        out = this.ctx.loops.length() - 1 - k;
                    }
                }
                TStmt.Continue(out, at.line)
            }
            // the block at least once, then the condition, which sees what the block assigned
            .DoWhile(body, cond, label, at) => {
                this.unnarrowWritten([s]);
                let ctx = LoopCtx { isLoop = false };
                this.pushLoop(ctx, label, at);
                let b = this.block(body);
                let c = this.condition(cond);
                this.popLoop();
                this.ctx.unassigned = this.ctx.unassigned.union(ctx.exits);
                TStmt.DoWhile(b, c, at.line)
            }
            .Return(value, at) => this.returnStmt(value, at),
            .Yield(value, at) => this.yieldStmt(value, at),
            .Block(b, at) => TStmt.Block(this.block(b), at.line),
            // one standing alone, as an `else`: a scope of its own, which it ends at once
            .Defer(_, at) | .Using(_, _, _, at) => TStmt.Block(this.stmtList([s]), at.line),
        };
    }

    /// `throw e`: `e` an `Error` — a value of a type that conforms, of the interface or of one
    /// that extends it —, thrown as the interface's value (06 §1 rule 3, 05 E3).
    mut fn throwOf(value: Expr): TExpr {
        // a clause's own binding: the error it took goes on, with its record (06 §4 rule 4)
        match (value) {
            .Name(name, _) => {
                let id = this.lookupLocal(name);
                if (id != null) {
                    let caught = this.ctx.clauseErrors.get(id);
                    let record = this.ctx.clauseRecords.get(id);
                    if (caught != null && record != null) {
                        return TExpr.Rethrow(caught, record);
                    }
                }
            }
            _ => { }
        }
        let v = this.expr(value, null);
        let t = typeOf(v);
        if (t == .Unknown) {
            return TExpr.Throw(boxE(TExpr.Unknown));
        }
        let err = this.errorTy();
        let thrown = if (err != .Unknown) this.fit(v, err) else null;
        if (thrown == null) {
            this.error(
                "LYS-SEM0030",
                f"{this.tyName(t)} is not an Error: what is thrown conforms to Error",
                spanOf(value)
            );
            return TExpr.Throw(boxE(TExpr.Unknown));
        }
        return TExpr.Throw(boxE(thrown));
    }

    /// `try { … } catch (e: T) { … } catch (e) { … }`: the clauses test the error in order, each
    /// against its type, `catch (e)` against none; what none takes goes on (06 §4). A clause may
    /// run after any part of the body: it knows assigned only what was before the `try`.
    mut fn tryStmt(body: Block, clauses: CatchClause[], at: Span): TStmt {
        if (clauses.length() == 0) {
            this.error(
                "LYS-SEM0036",
                "a try block takes its body's errors in a clause: write one, or leave out the 'try'",
                at
            );
        }
        let before = this.ctx.unassigned;
        let b = this.block(body);
        var after = this.ctx.unassigned;
        let caught = this.hidden(this.errorTy(), at);
        // the error's record, a value of the VM's own; one reference, never read as an `Any`
        let record = this.hidden(Ty.Named(this.anyIndex), at);
        let out = List<TClause>.new();
        let seen = List<Ty>.new();
        var k = 0;
        for (c in clauses) {
            this.ctx.unassigned = before;
            this.pushScope();
            let head = this.clauseHead(c, k, clauses, caught, record, seen);
            let stmts = List<TStmt>.new();
            stmts.pushAll(head.bind);
            for (s in this.block(c.body)) {
                stmts.push(s);
            }
            this.popScope();
            after = after.union(this.ctx.unassigned);
            out.push(TClause { test = head.test, body = stmts.toArray(), types = head.takes });
            k += 1;
        }
        this.ctx.unassigned = after;
        return TStmt.Try(b, caught, record, out.toArray(), at.line);
    }

    /// Clause `k`'s head, in the clause's own scope: the test it makes of the error, the types
    /// it takes and the binding. `catch (e: T)` binds a `T`; `catch (e in [A, B])` and
    /// `catch (e)` an `Error`, which carries the set that reaches the clause (05 K7). A type is
    /// an `Error` (`LYS-SEM0030`), caught once (`LYS-SEM0141`) and not covered by a type caught
    /// before (`LYS-SEM0142`); the clause without a type stands last (`LYS-SEM0035`).
    mut fn clauseHead(
        c: CatchClause,
        k: int,
        clauses: CatchClause[],
        caught: int,
        record: int,
        seen: List<Ty>
    ): ClauseHead {
        let err = this.errorTy();
        let error = TExpr.Local(caught, err);
        // below a clause without a type, its own error is the one said (06 §4 rule 5)
        var belowAll = false;
        var j = 0;
        while (j < k) {
            belowAll = belowAll || clauses[j].types.length() == 0;
            j += 1;
        }
        if (c.types.length() == 0 && k < clauses.length() - 1) {
            this.error(
                "LYS-SEM0035",
                "a clause without a type takes every error: it stands last",
                c.span
            );
        }
        let takes = List<Ty>.new();
        var known = true;
        for (written in c.types) {
            let target = this.resolveType(written);
            if (target == .Unknown || err == .Unknown) {
                known = false;
                continue;
            }
            if (!this.throwable(target)) {
                this.error(
                    "LYS-SEM0030",
                    f"a clause catches {this.tyName(target)}, which is not an Error",
                    c.span
                );
                known = false;
                continue;
            }
            if (!belowAll) {
                var twice = false;
                var above: ?Ty = null;
                for (s in seen) {
                    if (s == target) {
                        twice = true;
                    } else if (above == null && this.catches(s, target)) {
                        above = s;
                    }
                }
                if (twice) {
                    this.error(
                        "LYS-SEM0141",
                        f"{this.tyName(target)} is caught twice in this try",
                        c.span
                    );
                } else if (above != null) {
                    this.error(
                        "LYS-SEM0142",
                        f"no error reaches this clause: {this.tyName(above)} above takes every {this.tyName(target)}",
                        c.span
                    );
                }
            }
            seen.push(target);
            takes.push(target);
        }
        var test: ?TExpr = null;
        var value = error;
        var bound = err;
        if (c.types.length() > 0) {
            if (!known) {
                value = TExpr.Unknown;
                bound = Ty.Unknown;
            } else if (takes.length() == 1) {
                // a typed clause, and a set of one (06 §4 rule 2)
                test = this.typeTest(error, takes[0], c.span);
                value = this.heldAs(error, takes[0]);
                bound = takes[0];
            } else {
                for (t in takes) {
                    let one = this.typeTest(error, t, c.span);
                    if (one != null) {
                        let before = test;
                        test = if (before != null) TExpr.Binary(
                            boxE(before),
                            BinaryOp.Or,
                            boxE(one),
                            Ty.Bool
                        )
                            else one;
                    }
                }
            }
        }
        let bind = List<TStmt>.new();
        if (c.name != "_") {
            let id = this.declareLocal(c.name, bound, false, c.span);
            bind.push(TStmt.SetLocal(id, value, c.span.line));
            this.ctx.clauseErrors.insert(id, caught);
            this.ctx.clauseRecords.insert(id, record);
            if (takes.length() != 1 && known) {
                this.ctx.clauseKeys.insert(id, f"{this.ctx.fnIndex}:{caught}:{k}");
            }
        }
        return ClauseHead { test = test, takes = takes.toArray(), bind = bind.toArray() };
    }

    /// Whether a clause of `by` takes every error of `t`: `by` is `Error`, or an interface `t`
    /// conforms to (06 §3 rule 4).
    mut fn catches(by: Ty, t: Ty): bool {
        if (by == t || by == this.errorTy()) {
            return true;
        }
        return match (by) {
            .Named(ii) => this.types[ii].kind == .Interface && this.conformsTo(t, ii),
            _ => false,
        };
    }

    /// `try? e`: `e`'s value as an optional, `null` where something under it throws; not
    /// flattened — over a `?int`, a `??int` (06 §6 rule 1). Over what gives no value only as a
    /// statement (`LYS-SEM0140`).
    mut fn tryOpt(x: Expr, asStmt: bool, at: Span): TExpr {
        let v = this.expr(x, null);
        let t = typeOf(v);
        let caught = this.hidden(this.errorTy(), at);
        let record = this.hidden(Ty.Named(this.anyIndex), at);
        if (t == .Void || t == .Never || t == .Unknown) {
            // refused where a value stands: what follows takes it as unknown, nothing more said
            var given = Ty.Void;
            if (t == .Void && !asStmt) {
                this.error(
                    "LYS-SEM0140",
                    "'try?' over what gives no value stands as a statement",
                    at
                );
                given = Ty.Unknown;
            }
            let handler = TClause { test = null, body = [], types = [] };
            return TExpr.Block(
                [TStmt.Try([TStmt.Expr(v, at.line)], caught, record, [handler], at.line)],
                boxE(TExpr.Unit),
                given
            );
        }
        let ot = Ty.Optional(boxTy(t));
        let r = this.hidden(ot, at);
        let handler = TClause {
            test = null,
            body = [TStmt.SetLocal(r, TExpr.Null(ot), at.line)],
            types = [],
        };
        let wrapped = this.fit(v, ot) ?? v;
        return TExpr.Block(
            [TStmt.Try([TStmt.SetLocal(r, wrapped, at.line)], caught, record, [handler], at.line)],
            boxE(TExpr.Local(r, ot)),
            ot
        );
    }

    /// `try! e`: `e`'s value; where something under it throws, the panic `LYS-RT0010` with the
    /// error's message (06 §6 rule 2).
    mut fn tryBang(x: Expr, expected: ?Ty, at: Span): TExpr {
        let v = this.expr(x, expected);
        let t = typeOf(v);
        let err = this.errorTy();
        let caught = this.hidden(err, at);
        let record = this.hidden(Ty.Named(this.anyIndex), at);
        let message = TExpr.Native(
            Native.Concat,
            [
                TExpr.Str("'try!' on an error: "),
                TExpr.CallIface(this.errorSlot("message"), [TExpr.Local(caught, err)], Ty.Str),
            ],
            Ty.Str
        );
        let handler = TClause {
            test = null,
            body = [TStmt.Expr(TExpr.Panic(boxE(message), 10), at.line)],
            types = [],
        };
        if (t == .Void || t == .Never || t == .Unknown) {
            return TExpr.Block(
                [TStmt.Try([TStmt.Expr(v, at.line)], caught, record, [handler], at.line)],
                boxE(TExpr.Unit),
                t
            );
        }
        let r = this.hidden(t, at);
        return TExpr.Block(
            [TStmt.Try([TStmt.SetLocal(r, v, at.line)], caught, record, [handler], at.line)],
            boxE(TExpr.Local(r, t)),
            t
        );
    }

    /// `try e catch (x: A) v catch (y) w`: `e`'s value, or the value of the clause that took the
    /// error; the parts give one type as a match's arms do (06 §6 rule 4). As a statement the
    /// parts give none.
    mut fn tryCatch(x: Expr, clauses: CatchClause[], expected: ?Ty, asStmt: bool, at: Span): TExpr {
        let before = this.ctx.unassigned;
        let v = this.expr(x, if (asStmt) null else expected);
        var after = this.reached(v);
        let caught = this.hidden(this.errorTy(), at);
        let record = this.hidden(Ty.Named(this.anyIndex), at);
        let heads = List<ClauseHead>.new();
        let values = List<TExpr>.new();
        let seen = List<Ty>.new();
        var k = 0;
        for (c in clauses) {
            this.ctx.unassigned = before;
            this.pushScope();
            heads.push(this.clauseHead(c, k, clauses, caught, record, seen));
            let value = this.valueBlock(c.body, if (asStmt) null else expected);
            this.popScope();
            after = after.union(this.reached(value));
            values.push(value);
            k += 1;
        }
        this.ctx.unassigned = after;
        var t = Ty.Void;
        if (!asStmt) {
            if (expected != null) {
                t = expected;
            } else {
                t = typeOf(v);
                for (value in values) {
                    t = this.unify(t, typeOf(value), at);
                }
            }
        }
        let valued = t != .Void && t != .Never && t != .Unknown;
        let r = if (valued) this.hidden(t, at) else -1;
        let out = List<TClause>.new();
        k = 0;
        for (head in heads) {
            let stmts = List<TStmt>.new();
            stmts.pushAll(head.bind);
            let value = values[k];
            stmts.push(
                if (valued) TStmt.SetLocal(r, this.coerce(value, t, spanOf(x)), at.line)
                    else TStmt.Expr(value, at.line)
            );
            out.push(TClause { test = head.test, body = stmts.toArray(), types = head.takes });
            k += 1;
        }
        let body = if (valued) TStmt.SetLocal(r, this.coerce(v, t, spanOf(x)), at.line)
            else TStmt.Expr(v, at.line);
        let tail = if (valued) TExpr.Local(r, t) else TExpr.Unit;
        return TExpr.Block(
            [TStmt.Try([body], caught, record, out.toArray(), at.line)],
            boxE(tail),
            if (valued) t else if (t == .Never) Ty.Never else Ty.Void
        );
    }

    /// `e.backtrace()`: a `?Backtrace` of the prelude, the text of the record's frames.
    mut fn backtraceOf(record: int): TExpr {
        let bi = this.typeIndex.get("Backtrace");
        if (bi == null) {
            return TExpr.Unknown;
        }
        let text = TExpr.Native(
            Native.TraceText,
            [TExpr.Local(record, Ty.Named(this.anyIndex))],
            Ty.Str
        );
        let bt = Ty.Named(bi);
        return TExpr.Wrap(boxE(TExpr.New(bi, [text])), Ty.Optional(boxTy(bt)));
    }

    /// Whether a value of `t` has a field or a method named `name`.
    mut fn hasMember(t: Ty, name: string): bool {
        return match (t) {
            .Named(i) => {
                if (this.types[i].kind == .Interface) {
                    this.ifaceMember(i, name) != null
                } else {
                    var found = this.methodOf(i, name) != null;
                    for (f in this.types[i].fields) {
                        found = found || f.name == name;
                    }
                    found
                }
            }
            _ => false,
        };
    }

    /// Whether a value of `t` is thrown: its type conforms to `Error`, or it is an interface
    /// that extends it.
    mut fn throwable(t: Ty): bool {
        return match (this.errorTy()) {
            .Named(ei) => t == Ty.Named(ei) || this.conformsTo(t, ei),
            _ => false,
        };
    }

    /// The optional of an `if let` or a `while let` and what it holds; reported where it is none.
    mut fn optionalOf(v: TExpr, word: string, at: Span): Ty {
        return match (typeOf(v)) {
            .Optional(inner) => inner.value,
            .Unknown => Ty.Unknown,
            _ => {
                this.error(
                    "LYS-SEM0005",
                    f"'{word}' takes an optional: this value is never null",
                    at
                );
                Ty.Unknown
            }
        };
    }

    /// `if (let x = e) { … } else { … }`: `e` held in a local of its own, `x` its value in the
    /// block where it is there.
    mut fn ifLet(name: string, value: Expr, then: Block, otherwise: ?Box<Stmt>, at: Span): TStmt {
        let v = this.expr(value, null);
        let ot = typeOf(v);
        let inner = this.optionalOf(v, "if let", spanOf(value));
        let tmp = this.hidden(ot, at);
        let before = this.ctx.unassigned;
        this.pushScope();
        let x = this.declareLocal(name, inner, false, at);
        let body = List<TStmt>.new();
        body.push(TStmt.SetLocal(x, TExpr.Narrow(boxE(TExpr.Local(tmp, ot)), inner), at.line));
        for (s in this.block(then)) {
            body.push(s);
        }
        this.popScope();
        let afterThen = this.ctx.unassigned;
        this.ctx.unassigned = before;
        var o: TStmt[] = [];
        if (otherwise != null) {
            this.pushScope();
            o = [this.stmt(otherwise.value)];
            this.popScope();
        }
        this.ctx.unassigned = afterThen.union(this.ctx.unassigned);
        let present = TExpr.Unary(
            UnaryOp.Not,
            boxE(TExpr.IsNull(boxE(TExpr.Local(tmp, ot)))),
            Ty.Bool
        );
        return TStmt.Block(
            [TStmt.SetLocal(tmp, v, at.line), TStmt.If(present, body.toArray(), o, at.line)],
            at.line
        );
    }

    /// `while (let x = e) { … }`: `e` again before each turn, the loop's end where it is null.
    mut fn whileLet(name: string, value: Expr, body: Block, label: ?string, at: Span): TStmt {
        this.pushScope();
        let v = this.expr(value, null);
        let ot = typeOf(v);
        let inner = this.optionalOf(v, "while let", spanOf(value));
        let tmp = this.hidden(ot, at);
        let x = this.declareLocal(name, inner, false, at);
        let before = this.ctx.unassigned;
        this.pushLoop(LoopCtx { isLoop = false }, label, at);
        let turn = List<TStmt>.new();
        turn.push(TStmt.SetLocal(tmp, v, at.line));
        turn.push(
            TStmt.If(
                TExpr.IsNull(boxE(TExpr.Local(tmp, ot))),
                [TStmt.Break(null, 0, at.line)],
                [],
                at.line
            )
        );
        turn.push(TStmt.SetLocal(x, TExpr.Narrow(boxE(TExpr.Local(tmp, ot)), inner), at.line));
        for (s in this.block(body)) {
            turn.push(s);
        }
        this.popLoop();
        this.popScope();
        this.ctx.unassigned = before;
        return TStmt.While(TExpr.Bool(true), turn.toArray(), at.line);
    }

    /// An expression as a statement: a call, an assignment or a loop; anything else would be
    /// computed only to be thrown away (`LYS-SEM0022`).
    mut fn exprStmt(e: Expr, at: Span): TStmt {
        let checked = match (e) {
            .Match(x, arms, matchAt) => this.matchOf(x.value, arms, null, true, matchAt),
            .TryOpt(x, tryAt) => this.tryOpt(x.value, true, tryAt),
            .TryCatch(x, clauses, tryAt) => this.tryCatch(x.value, clauses, null, true, tryAt),
            _ => this.expr(e, null),
        };
        let effect = match (unmarked(e)) {
            .Call(_, _, _) | .Assign(_, _, _, _) | .Loop(_, _, _) | .Match(_, _, _) => true,
            .Step(_, _, _, _) => true,
            .TryOpt(_, _) | .TryBang(_, _) | .TryCatch(_, _, _) => true,
            _ => false,
        };
        // a Closeable an expression statement drops is never closed (06 §7 rule 4)
        let ci = this.typeIndex.get("Closeable");
        if (ci != null && effect) {
            let rt = typeOf(checked);
            // a coroutine may be dropped unclosed: nothing of it runs any more (Lyric 5 10 §1
            // rule 10)
            if (rt != .Void
                && rt != .Unknown
                && rt != .Never
                && this.conformsTo(rt, ci)
                && this.coroutineArgs(rt).length() != 2) {
                this.warn(
                    "LYS-SEM0144",
                    f"this {this.tyName(rt)} is Closeable and nothing closes it: bind it with 'using let'",
                    at
                );
            }
        }
        if (!effect && typeOf(checked) != .Unknown) {
            this.error(
                "LYS-SEM0022",
                "this computes a value and throws it away: only calls, assignments and loops stand alone",
                at
            );
        }
        return TStmt.Expr(checked, at.line);
    }

    mut fn letStmt(isVar: bool, name: string, written: ?TypeExpr, value: ?Expr, at: Span): TStmt {
        var t = Ty.Unknown;
        if (written != null) {
            t = this.resolveType(written);
        }
        if (value == null) {
            return this.unassignedLet(isVar, name, written != null, t, at);
        }
        if (isVar && written == null && isNullLit(value)) {
            return this.nullVar(name, at);
        }
        if (written == null && isEmptyList(value)) {
            return this.emptyListVar(name, isVar, at);
        }
        var v = this.expr(value, if (written != null) t else null);
        if (written != null) {
            v = this.coerce(v, t, spanOf(value));
        } else {
            t = typeOf(v);
            if (t == .NullLit) {
                this.error(
                    "LYS-SEM0010",
                    f"'{name}' is null, and nothing says of what: write its type, '?T'",
                    at
                );
                t = Ty.Unknown;
            } else if (t == .Void || t == .Never) {
                this.error(
                    "LYS-SEM0010",
                    f"'{name}' takes the value of something that gives none",
                    at
                );
                t = Ty.Unknown;
            }
        }
        // the outermost scope of the script's code: a global of the script (07 Top)
        if (this.atTop()) {
            return TStmt.SetGlobal(this.declareGlobal(name, t, isVar, at), v, at.line);
        }
        let id = this.declareLocal(name, t, isVar, at);
        return TStmt.SetLocal(id, v, at.line);
    }

    /// `let (a, b) = v`: `v` held once, each name bound to its element (Lyric 5 §6 rule 4); at
    /// the top of the script's code the names are globals.
    mut fn destructure(
        isVar: bool,
        pattern: Pattern,
        value: Expr,
        otherwise: ?Block,
        at: Span
    ): TStmt {
        if (otherwise != null) {
            return this.letElse(isVar, pattern, value, otherwise, at);
        }
        let v = this.expr(value, null);
        let t = typeOf(v);
        let tmp = this.hidden(t, at);
        let out = List<TStmt>.new();
        out.push(TStmt.SetLocal(tmp, v, at.line));
        this.bindPattern(
            isVar,
            pattern,
            TExpr.Local(tmp, t),
            Map<string, bool>.new(),
            out,
            at.line
        );
        return TStmt.Block(out.toArray(), at.line);
    }

    mut fn bindPattern(
        isVar: bool,
        p: Pattern,
        source: TExpr,
        seen: Map<string, bool>,
        out: List<TStmt>,
        line: int
    ): void {
        match (p) {
            .Name(name, at) => {
                if (seen.containsKey(name)) {
                    this.error("LYS-SEM0097", f"'{name}' is bound twice in this pattern", at);
                    return;
                }
                seen.insert(name, true);
                let t = typeOf(source);
                if (this.atTop()) {
                    out.push(TStmt.SetGlobal(this.declareGlobal(name, t, isVar, at), source, line));
                } else {
                    out.push(TStmt.SetLocal(this.declareLocal(name, t, isVar, at), source, line));
                }
            }
            .Ignore(_) => { }
            .Literal(_, at) | .Range(_, _, _, at) | .Variant(_, _, _, at) | .VariantFields(_, _, _, at) | .Fields(_, _, at) | .Or(_, at) | .Typed(_, _, at) | .List(_, _, _, at) => {
                // one that matches every value of the type cannot fail: its names bound from it,
                // `let P { x, y } = p` (09 rule 2; S7d2: refused since S3, and `for` takes it)
                let found = List<Bound>.new();
                if (this.patternTest(p, source, found, seen) == null) {
                    for (b in found) {
                        let bt = typeOf(b.value);
                        if (this.atTop()) {
                            out.push(
                                TStmt.SetGlobal(
                                    this.declareGlobal(b.name, bt, isVar, b.at),
                                    b.value,
                                    line
                                )
                            );
                        } else {
                            out.push(
                                TStmt.SetLocal(
                                    this.declareLocal(b.name, bt, isVar, b.at),
                                    b.value,
                                    line
                                )
                            );
                        }
                    }
                    return;
                }
                this.error(
                    "LYS-SEM0098",
                    "a pattern that can fail needs a way out: 'let P = e else { … }', or a 'match'",
                    at
                );
                // its names are bound all the same, of no known type
                for (b in found) {
                    this.bindPattern(
                        isVar,
                        Pattern.Name(b.name, b.at),
                        TExpr.Unknown,
                        Map<string, bool>.new(),
                        out,
                        line
                    );
                }
            }
            .Tuple(items, at) => {
                let t = typeOf(source);
                match (t) {
                    .Tuple(tt) => {
                        if (tt.elements.length() == items.length()) {
                            var k = 0;
                            for (item in items) {
                                let element = TExpr.Elem(boxE(source), k, tt.elements[k]);
                                this.bindPattern(isVar, item, element, seen, out, line);
                                k += 1;
                            }
                            return;
                        }
                        this.error(
                            "LYS-SEM0058",
                            f"the pattern takes {items.length()} elements apart; the value is {this.tyName(t)}",
                            at
                        );
                    }
                    .Unknown => { }
                    _ => {
                        this.error(
                            "LYS-SEM0058",
                            f"the pattern takes a tuple apart; the value is {this.tyName(t)}",
                            at
                        );
                    }
                }
                // after a fault the names are bound all the same, of no known type
                for (item in items) {
                    this.bindPattern(isVar, item, TExpr.Unknown, seen, out, line);
                }
            }
        }
    }

    // --- match and its patterns ------------------------------------------------------------------

    /// `match (e) { … }` (Lyric 5 §9, 08 §2 rule 4): `e` held once, the arms tried in order as
    /// nested `if`s. A statement's arms give nothing; a value's arms meet the expected type, or
    /// unify.
    mut fn matchOf(
        scrutinee: Expr,
        arms: MatchArm[],
        expected: ?Ty,
        isStmt: bool,
        at: Span
    ): TExpr {
        let v = this.expr(scrutinee, null);
        let t = typeOf(v);
        let tmp = this.hidden(t, at);
        let src = TExpr.Local(tmp, t);
        let before = this.ctx.unassigned;
        var after = Set<int>.new();
        let tests = List<?TExpr>.new();
        let binds = List<TStmt[]>.new();
        let guards = List<?TExpr>.new();
        let bodies = List<TExpr>.new();
        for (arm in arms) {
            this.ctx.unassigned = before;
            this.pushScope();
            let bound = List<Bound>.new();
            let test = this.patternTest(arm.pattern, src, bound, Map<string, bool>.new());
            let sets = List<TStmt>.new();
            for (b in bound) {
                let id = this.declareLocal(b.name, typeOf(b.value), false, b.at);
                sets.push(TStmt.SetLocal(id, b.value, b.at.line));
            }
            var guard: ?TExpr = null;
            let written = arm.guard;
            if (written != null) {
                guard = this.condition(written);
            }
            let body = this.expr(arm.body, if (isStmt) null else expected);
            this.popScope();
            // an arm that never comes out adds nothing to what is assigned after the match
            after = after.union(this.reached(body));
            tests.push(test);
            binds.push(sets.toArray());
            guards.push(guard);
            bodies.push(body);
        }
        this.ctx.unassigned = if (arms.length() == 0) before else after;
        // over a clause's binding that carries a set, the arms cover the set (05 K7): known once
        // the sets are inferred
        var setKey: ?string = null;
        match (v) {
            .Local(id, _) => {
                setKey = this.ctx.clauseKeys.get(id);
            }
            _ => { }
        }
        if (let key = setKey) {
            this.coverageLater(arms, key, at);
        } else {
            this.coverage(arms, t, at);
        }
        var rt = Ty.Void;
        if (!isStmt) {
            if (expected != null) {
                rt = expected;
            } else {
                rt = Ty.Never;
                for (b in bodies) {
                    rt = this.unify(rt, typeOf(b), at);
                }
            }
        }
        // from the last arm back: each arm's test, its guard with its bindings, its body
        var rest = TExpr.Unreachable(rt);
        var k = arms.length() - 1;
        while (k >= 0) {
            let body = if (isStmt) TExpr.Block(
                [TStmt.Expr(bodies[k], at.line)],
                boxE(TExpr.Unit),
                Ty.Void
            )
                else this.coerce(bodies[k], rt, spanOf(arms[k].body));
            let taken = TExpr.Block(binds[k], boxE(body), rt);
            var cond = tests[k];
            let guard = guards[k];
            if (guard != null) {
                let guarded = TExpr.Block(binds[k], boxE(guard), Ty.Bool);
                cond = if (cond != null) andOf(cond, guarded) else guarded;
            }
            rest = if (cond != null) TExpr.If(boxE(cond), boxE(taken), boxE(rest), rt) else taken;
            k -= 1;
        }
        return TExpr.Block([TStmt.SetLocal(tmp, v, at.line)], boxE(rest), rt);
    }

    /// Lyric 5 §9 §3 and §4: the unguarded arms cover every value of `t`, or the match is refused
    /// with a value none takes; an arm behind an irrefutable one, or repeating a unit variant, a
    /// literal or `null` an arm above tests, is warned about.
    mut fn coverage(arms: MatchArm[], t: Ty, at: Span): void {
        if (t == .Unknown) {
            return;
        }
        let rows = List<Space[]>.new();
        let tested = List<string>.new();
        var closed = false;
        for (arm in arms) {
            let guarded = arm.guard != null;
            if (closed) {
                this.warn(
                    "LYS-SEM0112",
                    "no value reaches this arm: an arm above takes every value",
                    arm.span
                );
            } else if (!guarded) {
                let key = repeatKey(arm.pattern);
                var again = false;
                for (x in tested) {
                    again = again || x == key;
                }
                if (key != "" && again) {
                    this.warn(
                        "LYS-SEM0112",
                        "no value reaches this arm: an arm above tests the same",
                        arm.span
                    );
                }
                if (key != "") {
                    tested.push(key);
                }
            }
            if (!guarded) {
                rows.push([this.spaceOf(arm.pattern, t)]);
                closed = closed || irrefutable(arm.pattern);
            }
        }
        let missing = this.uncovered(rows.toArray(), [t]);
        if (missing != null) {
            this.errorHelp(
                "LYS-SEM0050",
                f"this match does not cover every value: no arm takes {this.showSpace(missing[0], t)}",
                "add an arm for it, or one with '_'",
                at
            );
        }
    }

    /// The types a match over a clause's set takes, kept to check against the set once it is
    /// known; nothing to check where an arm takes every value.
    mut fn coverageLater(arms: MatchArm[], key: string, at: Span): void {
        let types = List<Ty>.new();
        for (arm in arms) {
            if (arm.guard != null) {
                continue;
            }
            if (irrefutable(arm.pattern)) {
                return;
            }
            this.patternTypes(arm.pattern, types);
        }
        if (!this.ctx.fixing) {
            this.laterMatches.push(LaterMatch { key = key, types = types.toArray(), at = at });
        }
    }

    mut fn patternTypes(p: Pattern, out: List<Ty>): void {
        match (p) {
            .Typed(_, written, _) => out.push(this.resolveType(written)),
            .Or(alternatives, _) => {
                for (a in alternatives) {
                    this.patternTypes(a, out);
                }
            }
            _ => { }
        }
    }

    /// What `p` covers of the values of `t`, for the check of coverage.
    mut fn spaceOf(p: Pattern, t: Ty): Space {
        match (p) {
            .Name(_, _) | .Ignore(_) => {
                return Space.Any;
            }
            .List(items, rest, _, _) => {
                let elem = match (t) {
                    .List(e) => e.value,
                    .Optional(o) => match (o.value) {
                        .List(e) => e.value,
                        _ => Ty.Unknown,
                    },
                    _ => Ty.Unknown,
                };
                let parts = List<Space>.new();
                for (x in items) {
                    parts.push(this.spaceOf(x, elem));
                }
                return Space.Seq(parts.toArray(), rest);
            }
            .Or(alternatives, _) => {
                let out = List<Space>.new();
                for (a in alternatives) {
                    out.push(this.spaceOf(a, t));
                }
                return Space.Or(out.toArray());
            }
            _ => { }
        }
        // a pattern of the inner type against an optional: the value present
        match (t) {
            .Optional(inner) => {
                let isNull = match (p) {
                    .Literal(e, _) => isNullLit(e),
                    _ => false,
                };
                return if (isNull) Space.Ctor(0, [])
                    else Space.Ctor(1, [this.spaceOf(p, inner.value)]);
            }
            _ => { }
        }
        return match (p) {
            .Tuple(items, _) => {
                let tt = tupleOf(t);
                if (tt.elements.length() != items.length()) {
                    return Space.Any;
                }
                let parts = List<Space>.new();
                var k = 0;
                for (item in items) {
                    parts.push(this.spaceOf(item, tt.elements[k]));
                    k += 1;
                }
                Space.Ctor(0, parts.toArray())
            }
            .Literal(e, _) => {
                if (t == .Bool) {
                    return match (e) {
                        .Bool(b, _) => Space.Ctor(if (b) 1 else 0, []),
                        _ => Space.Any,
                    };
                }
                Space.Lit(litKey(e))
            }
            // a range is a set of values no other pattern is compared with
            .Range(_, _, _, at) => Space.Lit(f"range@{at.start}"),
            .Variant(_, name, payload, _) => {
                let i = this.enumOf(t);
                let k = if (i < 0) -1 else this.variantIndex(i, name);
                if (k < 0) {
                    return Space.Any;
                }
                let fields = this.types[i].variantFields[k];
                let parts = List<Space>.new();
                var j = 0;
                for (f in fields) {
                    parts.push(
                        if (payload != null && j < payload.length()) this.spaceOf(payload[j], f.ty)
                            else Space.Any
                    );
                    j += 1;
                }
                Space.Ctor(k, parts.toArray())
            }
            .VariantFields(_, name, fields, _) => {
                let i = this.enumOf(t);
                let k = if (i < 0) -1 else this.variantIndex(i, name);
                if (k < 0) {
                    return Space.Any;
                }
                Space.Ctor(k, this.fieldSpaces(this.types[i].variantFields[k], fields))
            }
            .Fields(_, fields, _) => {
                let i = match (t) {
                    .Named(n) => n,
                    _ => -1,
                };
                if (i < 0) {
                    return Space.Any;
                }
                Space.Ctor(0, this.fieldSpaces(this.types[i].fields, fields))
            }
            // a sealed interface's conformer, or a type of an open set none enumerates
            .Typed(_, written, at) => {
                let target = this.resolveType(written);
                match (t) {
                    .Named(ii) => {
                        if (this.types[ii].sealed) {
                            let k = this.entryOf(target);
                            var c = 0;
                            for (x in this.conformers(ii)) {
                                if (x == k) {
                                    return Space.Ctor(c, []);
                                }
                                c += 1;
                            }
                        }
                    }
                    _ => { }
                }
                Space.Lit(f"type@{at.start}")
            }
            _ => Space.Any,
        };
    }

    /// Each field's space: its pattern's where one names it, every value where none does.
    mut fn fieldSpaces(decls: FieldInfo[], fields: FieldPattern[]): Space[] {
        let out = List<Space>.new();
        for (d in decls) {
            var space = Space.Any;
            for (f in fields) {
                if (f.name == d.name) {
                    space = this.spaceOf(f.pattern, d.ty);
                }
            }
            out.push(space);
        }
        return out.toArray();
    }

    /// How many constructors make up the values of `t`: an enum's variants, `false` and `true`,
    /// `null` and a value, one for a tuple, a struct or a class; -1 for an open type.
    mut fn ctorCount(t: Ty): int {
        return match (t) {
            .Named(i) => if (this.types[i].kind == .Enum) this.types[i].variants.length()
                else if (this.types[i].kind
                    == .Interface) (if (this.types[i].sealed) this.conformers(i).length() else -1)
                    else 1,
            .Bool => 2,
            .Optional(_) => 2,
            .Tuple(_) => 1,
            _ => -1,
        };
    }

    /// The types of constructor `c`'s parts.
    mut fn ctorParts(t: Ty, c: int): Ty[] {
        let out = List<Ty>.new();
        match (t) {
            .Named(i) => {
                let fields = if (this.types[i].kind == .Enum) this.types[i].variantFields[c]
                    else this.types[i].fields;
                for (f in fields) {
                    out.push(f.ty);
                }
            }
            .Optional(inner) => {
                if (c == 1) {
                    out.push(inner.value);
                }
            }
            .Tuple(tt) => {
                for (e in tt.elements) {
                    out.push(e);
                }
            }
            _ => { }
        }
        return out.toArray();
    }

    /// A row of values none of `rows` covers, one per type of `tys`; `null` where they cover all
    /// (Maranget, "Warnings for pattern matching", 2007).
    mut fn uncovered(rows: Space[][], tys: Ty[]): ?Space[] {
        if (tys.length() == 0) {
            return if (rows.length() == 0) [] else null;
        }
        let flat = expandOr(rows);
        let t = tys[0];
        let rest = sliceOf(tys, 1, tys.length());
        match (t) {
            .List(e) => {
                var seq = false;
                for (row in flat) {
                    match (row[0]) {
                        .Seq(_, _) => {
                            seq = true;
                        }
                        _ => { }
                    }
                }
                if (seq) {
                    return this.uncoveredList(flat, e.value, rest);
                }
            }
            _ => { }
        }
        let count = this.ctorCount(t);
        let used = Set<int>.new();
        for (row in flat) {
            match (row[0]) {
                .Ctor(c, _) => {
                    used.insert(c);
                }
                _ => { }
            }
        }
        if (count > 0 && used.length() == count) {
            var c = 0;
            while (c < count) {
                let parts = this.ctorParts(t, c);
                let sub = List<Ty>.new();
                for (x in parts) {
                    sub.push(x);
                }
                for (x in rest) {
                    sub.push(x);
                }
                let w = this.uncovered(specialize(flat, c, parts.length()), sub.toArray());
                if (w != null) {
                    let out = List<Space>.new();
                    out.push(Space.Ctor(c, sliceOf(w, 0, parts.length())));
                    for (x in w[parts.length()..]) {
                        out.push(x);
                    }
                    return out.toArray();
                }
                c += 1;
            }
            return null;
        }
        // the rows that take every value of the column decide the rest
        let w = this.uncovered(defaultRows(flat), rest);
        if (w == null) {
            return null;
        }
        // a column that names no constructor is missing any value; one that names some, the first
        // it leaves out
        var head = Space.Any;
        if (count > 0 && used.length() > 0) {
            var c = 0;
            while (used.contains(c)) {
                c += 1;
            }
            let parts = List<Space>.new();
            for (_ in this.ctorParts(t, c)) {
                parts.push(Space.Any);
            }
            head = Space.Ctor(c, parts.toArray());
        }
        let out = List<Space>.new();
        out.push(head);
        for (x in w) {
            out.push(x);
        }
        return out.toArray();
    }

    /// The first value a list column leaves out (S7b3; Rust's way): each length up to `top` a
    /// constructor of that many elements, `top` standing for every longer list too — past every
    /// fixed pattern's length, at least every `..` pattern's elements.
    mut fn uncoveredList(flat: Space[][], elem: Ty, rest: Ty[]): ?Space[] {
        var maxFixed = -1;
        var maxVar = -1;
        for (row in flat) {
            match (row[0]) {
                .Seq(parts, at) => {
                    if (at < 0 && parts.length() > maxFixed) {
                        maxFixed = parts.length();
                    }
                    if (at >= 0 && parts.length() > maxVar) {
                        maxVar = parts.length();
                    }
                }
                _ => { }
            }
        }
        let top = if (maxFixed + 1 > maxVar) maxFixed + 1 else maxVar;
        var n = 0;
        while (n <= top) {
            let rows = List<Space[]>.new();
            for (row in flat) {
                let r = List<Space>.new();
                var keep = true;
                match (row[0]) {
                    .Seq(parts, at) => {
                        keep = if (at < 0) parts.length() == n else parts.length() <= n;
                        if (keep) {
                            var k = 0;
                            while (k < parts.length()) {
                                if (k == at) {
                                    var gap = n - parts.length();
                                    while (gap > 0) {
                                        r.push(Space.Any);
                                        gap -= 1;
                                    }
                                }
                                r.push(parts[k]);
                                k += 1;
                            }
                            if (at == parts.length()) {
                                var gap = n - parts.length();
                                while (gap > 0) {
                                    r.push(Space.Any);
                                    gap -= 1;
                                }
                            }
                        }
                    }
                    _ => {
                        var k = 0;
                        while (k < n) {
                            r.push(Space.Any);
                            k += 1;
                        }
                    }
                }
                if (keep) {
                    for (x in row[1..]) {
                        r.push(x);
                    }
                    rows.push(r.toArray());
                }
            }
            let sub = List<Ty>.new();
            var k = 0;
            while (k < n) {
                sub.push(elem);
                k += 1;
            }
            for (x in rest) {
                sub.push(x);
            }
            let w = this.uncovered(rows.toArray(), sub.toArray());
            if (w != null) {
                let out = List<Space>.new();
                out.push(Space.Seq(sliceOf(w, 0, n), if (n == top && n > maxFixed) n else -1));
                for (x in w[n..]) {
                    out.push(x);
                }
                return out.toArray();
            }
            n += 1;
        }
        return null;
    }

    /// A value as a pattern writes it: `.Rect { … }`, `.Num(_)`, `false`, `null`, `(1, _)`.
    mut fn showSpace(space: Space, t: Ty): string {
        return match (space) {
            .Any | .Lit(_) | .Or(_) => "_",
            .Seq(parts, at) => {
                let elem = match (t) {
                    .List(e) => e.value,
                    _ => Ty.Unknown,
                };
                let shown = List<string>.new();
                for (x in parts) {
                    shown.push(this.showSpace(x, elem));
                }
                if (at >= 0) {
                    shown.push("..");
                }
                "[" + shown.toArray().join(", ") + "]"
            }
            .Ctor(c, parts) => {
                match (t) {
                    .Bool => {
                        return if (c == 1) "true" else "false";
                    }
                    .Optional(inner) => {
                        return if (c == 0) "null" else this.showSpace(parts[0], inner.value);
                    }
                    .Tuple(tt) => {
                        let shown = List<string>.new();
                        var k = 0;
                        for (x in parts) {
                            shown.push(this.showSpace(x, tt.elements[k]));
                            k += 1;
                        }
                        return "(" + shown.toArray().join(", ") + ")";
                    }
                    .Named(i) => {
                        let info = this.types[i];
                        if (info.kind == .Interface) {
                            let all = this.conformers(i);
                            return if (c < all.length()) "_: " + this.types[all[c]].name else "_";
                        }
                        if (info.kind != .Enum) {
                            return f"{info.name} {{ … }}";
                        }
                        let v = info.variants[c];
                        if (info.variantNamed[c]) {
                            return f".{v} {{ … }}";
                        }
                        if (parts.length() == 0) {
                            return "." + v;
                        }
                        let shown = List<string>.new();
                        var k = 0;
                        for (x in parts) {
                            shown.push(this.showSpace(x, info.variantFields[c][k].ty));
                            k += 1;
                        }
                        return "." + v + "(" + shown.toArray().join(", ") + ")";
                    }
                    _ => { }
                }
                "_"
            }
        };
    }

    /// What pattern `p` tests of `src` — a read of the matched value's parts, evaluated as often
    /// as needed — as a `bool`; `null` where it matches every value. Its bindings go to `out`.
    mut fn patternTest(p: Pattern, src: TExpr, out: List<Bound>, seen: Map<string, bool>): ?TExpr {
        return match (p) {
            .Ignore(_) => null,
            .Name(name, at) => {
                // a bare name that spells a variant would match every value under its name
                let e = this.enumOf(typeOf(src));
                if (e >= 0 && this.variantIndex(e, name) >= 0) {
                    this.error(
                        "LYS-SEM0111",
                        f"'{name}' binds the whole value; to test the variant write .{name}",
                        at
                    );
                }
                if (seen.containsKey(name)) {
                    this.error("LYS-SEM0097", f"'{name}' is bound twice in this pattern", at);
                } else {
                    seen.insert(name, true);
                    out.push(Bound { name = name, value = src, at = at });
                }
                null
            }
            .Tuple(items, at) => this.tupleTest(items, src, out, seen, at),
            .Literal(e, at) => this.literalTest(e, src, at),
            .Range(low, high, inclusive, at) => this.rangeTest(low, high, inclusive, src, at),
            .Variant(enumName, name, payload, at) => this.variantTest(
                enumName,
                name,
                payload,
                null,
                src,
                out,
                seen,
                at
            ),
            .VariantFields(enumName, name, fields, at) => this.variantTest(
                enumName,
                name,
                null,
                fields,
                src,
                out,
                seen,
                at
            ),
            .Fields(typeName, fields, at) => this.fieldsTest(typeName, fields, src, out, seen, at),
            .Or(alternatives, at) => this.orTest(alternatives, src, out, seen, at),
            .Typed(name, written, at) => this.typedTest(name, written, src, out, seen, at),
            .List(items, rest, name, at) => this.listTest(items, rest, name, src, out, seen, at),
        };
    }

    /// `c: Circle`: the interface value holds a `Circle`, and `c` is it as one (05 §9 rule 5).
    mut fn typedTest(
        name: ?string,
        written: TypeExpr,
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(src, this.typedTest(name, written, inner, out, seen, at));
        }
        let t = typeOf(src);
        let target = this.resolveType(written);
        var test: ?TExpr = null;
        var value = TExpr.Unknown;
        if (t != .Unknown && !this.isIfaceTy(t)) {
            this.error(
                "LYS-SEM0131",
                f"a type pattern asks an interface value; {this.tyName(t)} is known already",
                at
            );
        } else if (t != .Unknown) {
            test = this.typeTest(src, target, at);
            if (test != null) {
                value = this.heldAs(src, target);
            }
        }
        if (name != null) {
            if (seen.containsKey(name)) {
                this.error("LYS-SEM0097", f"'{name}' is bound twice in this pattern", at);
            } else {
                seen.insert(name, true);
                out.push(Bound { name = name, value = value, at = at });
            }
        }
        return test;
    }

    /// The names of the patterns bound to values of no known type: after a fault.
    mut fn bindUnknown(patterns: Pattern[], out: List<Bound>, seen: Map<string, bool>): void {
        for (p in patterns) {
            this.patternTest(p, TExpr.Unknown, out, seen);
        }
    }

    /// Whether `t` is an interface's type.
    mut fn isIfaceTy(t: Ty): bool {
        return match (t) {
            .Named(i) => this.types[i].kind == .Interface,
            _ => false,
        };
    }

    /// The test whether interface value `x` holds a `target` (05 §9 rule 2): its type's family,
    /// or a conformance to an interface; `null` where no interface value holds one.
    mut fn typeTest(x: TExpr, target: Ty, at: Span): ?TExpr {
        return match (target) {
            // every value an interface value holds is an `Any`, and a `Debug` (S7e3)
            .Named(i) => if (i == this.anyIndex || (i == this.synth.debugIx && i >= 0)) TExpr.Bool(
                true
            )
                else if (this.types[i].kind == .Interface) TExpr.IsIface(boxE(x), i, target)
                    else TExpr.IsType(boxE(x), i, target),
            .Int | .Float | .Bool | .Char | .Str => TExpr.IsType(
                boxE(x),
                this.builtinOf(target),
                target
            ),
            // a list of a known element (S7c3)
            // of a type parameter's element: the descriptor its copy makes (S7c4c3b)
            .List(_) => if (hasParam(target)) TExpr.IsDesc(
                boxE(x),
                boxE(TExpr.DescOfType(target, Ty.Named(this.anyIndex)))
            )
                else TExpr.IsType(boxE(x), this.entryOf(target), target),
            // a type parameter: the argument's type, tested in each copy (S3i)
            .Param(k) => TExpr.IsParam(boxE(x), k, Ty.Bool),
            .Unknown => null,
            _ => {
                this.error("LYS-SEM0131", f"no interface value holds a {this.tyName(target)}", at);
                null
            }
        };
    }

    /// The value an interface value holds as a `target`: the reference, or the box's value.
    mut fn heldAs(x: TExpr, target: Ty): TExpr {
        return if (this.boxed(target)) TExpr.Unbox(boxE(x), target)
            else TExpr.Narrow(boxE(x), target);
    }

    /// The types that conform to interface `ii`, in the order of the program: a sealed
    /// interface's are all there are (05 §10).
    mut fn conformers(ii: int): int[] {
        let out = List<int>.new();
        var k = 0;
        for (t in this.types) {
            var found = false;
            for (x in t.ifaces) {
                found = found || x == ii;
            }
            if (found && t.kind != .Interface) {
                out.push(k);
            }
            k += 1;
        }
        return out.toArray();
    }

    /// The value of the optional `src`, where it is one: a pattern of its inner type tests
    /// presence first (Lyric 5 §9 §3 rule 4).
    mut fn presentOf(src: TExpr): ?TExpr {
        return match (typeOf(src)) {
            .Optional(inner) => TExpr.Narrow(boxE(src), inner.value),
            _ => null,
        };
    }

    /// A list pattern (S7b3): the length first — exactly the elements', or at least them where a
    /// `..` stands —, then each element by its position, one after the `..` counted from the end;
    /// the `..`'s name binds the elements between as a new list.
    mut fn listTest(
        items: Pattern[],
        rest: int,
        restName: ?string,
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(src, this.listTest(items, rest, restName, inner, out, seen, at));
        }
        let t = typeOf(src);
        match (t) {
            .List(e) => {
                let elem = e.value;
                let n = items.length();
                let len = TExpr.ListOp(ListOp.Len, [src], Ty.Int);
                var test: ?TExpr = TExpr.Binary(
                    boxE(len),
                    if (rest < 0) BinaryOp.Eq else BinaryOp.Ge,
                    boxE(TExpr.Int(n)),
                    Ty.Bool
                );
                var k = 0;
                for (item in items) {
                    let place = if (rest < 0 || k < rest) TExpr.Int(k)
                        else TExpr.Binary(boxE(len), BinaryOp.Sub, boxE(TExpr.Int(n - k)), Ty.Int);
                    let element = TExpr.ListOp(ListOp.Get, [src, place], elem);
                    test = andMaybe(test, this.patternTest(item, element, out, seen));
                    k += 1;
                }
                if (let name = restName) {
                    if (seen.containsKey(name)) {
                        this.error("LYS-SEM0097", f"'{name}' is bound twice in this pattern", at);
                    } else {
                        seen.insert(name, true);
                        let end = TExpr.Binary(
                            boxE(len),
                            BinaryOp.Sub,
                            boxE(TExpr.Int(n - rest)),
                            Ty.Int
                        );
                        out.push(
                            Bound {
                                name = name,
                                value = this.listCall(
                                    "__listSlice",
                                    elem,
                                    [src, TExpr.Int(rest), end],
                                    t
                                ),
                                at = at,
                            }
                        );
                    }
                }
                return test;
            }
            .Unknown => { }
            _ => {
                this.error("LYS-SEM0029", f"a list pattern against {this.tyName(t)}", at);
            }
        }
        this.bindUnknown(items, out, seen);
        if (let name = restName) {
            if (!seen.containsKey(name)) {
                seen.insert(name, true);
                out.push(Bound { name = name, value = TExpr.Unknown, at = at });
            }
        }
        return null;
    }

    mut fn tupleTest(
        items: Pattern[],
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(src, this.tupleTest(items, inner, out, seen, at));
        }
        let t = typeOf(src);
        match (t) {
            .Tuple(tt) => {
                if (tt.elements.length() == items.length()) {
                    var test: ?TExpr = null;
                    var k = 0;
                    for (item in items) {
                        let element = TExpr.Elem(boxE(src), k, tt.elements[k]);
                        test = andMaybe(test, this.patternTest(item, element, out, seen));
                        k += 1;
                    }
                    return test;
                }
                this.error(
                    "LYS-SEM0029",
                    f"the pattern takes {items.length()} elements; the value is {this.tyName(t)}",
                    at
                );
            }
            .Unknown => { }
            _ => {
                this.error("LYS-SEM0029", f"a tuple pattern against {this.tyName(t)}", at);
            }
        }
        this.bindUnknown(items, out, seen);
        return null;
    }

    /// A literal: the value equal to it, by the equality of the matched value's type; `null`
    /// against an optional only.
    mut fn literalTest(e: Expr, src: TExpr, at: Span): ?TExpr {
        let t = typeOf(src);
        let lit = this.expr(e, null);
        let lt = typeOf(lit);
        if (t == .Unknown || lt == .Unknown) {
            return null;
        }
        if (lt == .NullLit) {
            match (t) {
                .Optional(_) => {
                    return TExpr.IsNull(boxE(src));
                }
                _ => {
                    this.error(
                        "LYS-SEM0029",
                        f"'null' against {this.tyName(t)}, which is never null",
                        at
                    );
                    return null;
                }
            }
        }
        var base = t;
        loop {
            match (base) {
                .Optional(inner) => base = inner.value,
                _ => {
                    break;
                }
            }
        }
        if (base != lt && !(base == .Float && lt == .Int)) {
            this.error("LYS-SEM0029", f"a {this.tyName(lt)} literal against {this.tyName(t)}", at);
            return null;
        }
        let eq = this.equality(src, BinaryOp.Eq, lit, at);
        return if (typeOf(eq) == .Unknown) null else eq;
    }

    /// `a..b`, `a..=b` over int or char literals: the values between.
    mut fn rangeTest(low: Expr, high: Expr, inclusive: bool, src: TExpr, at: Span): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(src, this.rangeTest(low, high, inclusive, inner, at));
        }
        let t = typeOf(src);
        let a = this.expr(low, null);
        let b = this.expr(high, null);
        if (t == .Unknown || typeOf(a) == .Unknown || typeOf(b) == .Unknown) {
            return null;
        }
        let fits = (t == .Int || t == .Char) && typeOf(a) == t && typeOf(b) == t;
        if (!fits) {
            this.error(
                "LYS-SEM0029",
                f"a range of int or char literals against {this.tyName(t)}",
                at
            );
            return null;
        }
        let from = TExpr.Binary(boxE(src), BinaryOp.Ge, boxE(a), Ty.Bool);
        let to = TExpr.Binary(
            boxE(src),
            if (inclusive) BinaryOp.Le else BinaryOp.Lt,
            boxE(b),
            Ty.Bool
        );
        return TExpr.Binary(boxE(from), BinaryOp.And, boxE(to), Ty.Bool);
    }

    /// `.Num(p)`, `.Rect { w = p }`, qualified or not: the variant, then its payload's patterns.
    mut fn variantTest(
        enumName: ?string,
        name: string,
        payload: ?Pattern[],
        fields: ?FieldPattern[],
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(
                src,
                this.variantTest(enumName, name, payload, fields, inner, out, seen, at)
            );
        }
        let subs = List<Pattern>.new();
        if (payload != null) {
            for (x in payload) {
                subs.push(x);
            }
        }
        if (fields != null) {
            for (f in fields) {
                subs.push(f.pattern);
            }
        }
        let t = typeOf(src);
        if (t == .Unknown) {
            this.bindUnknown(subs.toArray(), out, seen);
            return null;
        }
        let i = this.enumOf(t);
        if (i < 0) {
            this.error(
                "LYS-SEM0029",
                f"'.{name}' tests a variant; the value is {this.tyName(t)}, no enum",
                at
            );
            this.bindUnknown(subs.toArray(), out, seen);
            return null;
        }
        let info = this.types[i];
        let k = this.variantIndex(i, name);
        if ((enumName != null && enumName != info.name) || k < 0) {
            let what = if (k < 0) f"'{info.name}' has no variant '{name}'"
                else f"the pattern names {enumName ?? ""}; the value is {info.name}";
            this.error("LYS-SEM0029", what, at);
            this.bindUnknown(subs.toArray(), out, seen);
            return null;
        }
        let vf = info.variantFields[k];
        var test: ?TExpr = TExpr.Binary(
            boxE(TExpr.Tag(boxE(src))),
            BinaryOp.Eq,
            boxE(TExpr.Int(k)),
            Ty.Bool
        );
        if (payload != null) {
            if (vf.length() == 0 || info.variantNamed[k]) {
                this.error(
                    "LYS-SEM0031",
                    if (vf.length() == 0) f"'{name}' carries no payload: write .{name}"
                        else f"'{name}' has named fields: test them as .{name} {{ … }}",
                    at
                );
                this.bindUnknown(subs.toArray(), out, seen);
                return test;
            }
            if (payload.length() != vf.length()) {
                this.error(
                    "LYS-SEM0029",
                    f"'{name}' carries {vf.length()} values; the pattern takes {payload.length()}",
                    at
                );
                this.bindUnknown(subs.toArray(), out, seen);
                return test;
            }
            var j = 0;
            for (x in payload) {
                let part = TExpr.Payload(boxE(src), i, k, j, vf[j].ty);
                test = andMaybe(test, this.patternTest(x, part, out, seen));
                j += 1;
            }
        } else if (fields != null) {
            if (!info.variantNamed[k]) {
                this.error("LYS-SEM0031", f"'{name}' has no named fields", at);
                this.bindUnknown(subs.toArray(), out, seen);
                return test;
            }
            for (f in fields) {
                var j = 0;
                var found = -1;
                for (decl in vf) {
                    if (decl.name == f.name) {
                        found = j;
                    }
                    j += 1;
                }
                if (found < 0) {
                    this.error("LYS-SEM0015", f"'{name}' has no field '{f.name}'", f.span);
                    this.bindUnknown([f.pattern], out, seen);
                    continue;
                }
                let part = TExpr.Payload(boxE(src), i, k, found, vf[found].ty);
                test = andMaybe(test, this.patternTest(f.pattern, part, out, seen));
            }
        } else if (vf.length() > 0) {
            let form = if (info.variantNamed[k]) f".{name} {{ … }}" else f".{name}(…)";
            this.error("LYS-SEM0031", f"'{name}' carries a payload: write {form}", at);
        }
        return test;
    }

    /// `Point { x = 0, y }`: the fields it names of a struct or class value of that type.
    mut fn fieldsTest(
        typeName: string,
        fields: FieldPattern[],
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(src, this.fieldsTest(typeName, fields, inner, out, seen, at));
        }
        let subs = List<Pattern>.new();
        for (f in fields) {
            subs.push(f.pattern);
        }
        let t = typeOf(src);
        let named = this.typeIndex.get(this.q(typeName)) ?? -1;
        let i = match (t) {
            .Named(n) => if (this.types[n].kind != .Enum && n == named) n else -1,
            _ => -1,
        };
        if (i < 0) {
            if (t != .Unknown) {
                this.error(
                    "LYS-SEM0029",
                    f"the pattern names {typeName}; the value is {this.tyName(t)}",
                    at
                );
            }
            this.bindUnknown(subs.toArray(), out, seen);
            return null;
        }
        var test: ?TExpr = null;
        for (f in fields) {
            var j = 0;
            var found = -1;
            for (decl in this.types[i].fields) {
                if (decl.name == f.name) {
                    found = j;
                }
                j += 1;
            }
            if (found < 0) {
                this.error("LYS-SEM0015", f"'{typeName}' has no field '{f.name}'", f.span);
                this.bindUnknown([f.pattern], out, seen);
                continue;
            }
            this.mayName(i, f.name, f.span);
            let part = TExpr.Field(boxE(src), found, this.types[i].fields[found].ty);
            test = andMaybe(test, this.patternTest(f.pattern, part, out, seen));
        }
        return test;
    }

    /// `P | Q`: either; every alternative binds the same names at the same types, each name the
    /// value of the alternative that matched (Lyric 5 §9 §2 rule 7).
    mut fn orTest(
        alternatives: Pattern[],
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let tests = List<?TExpr>.new();
        let bounds = List<List<Bound>>.new();
        for (alt in alternatives) {
            let b = List<Bound>.new();
            tests.push(this.patternTest(alt, src, b, Map<string, bool>.new()));
            bounds.push(b);
        }
        let first = bounds[0];
        var k = 1;
        while (k < bounds.length()) {
            let other = bounds[k];
            var same = other.length() == first.length();
            for (b in first) {
                let o = boundNamed(other, b.name);
                same = same && o != null && typeOf(o) == typeOf(b.value);
            }
            if (!same) {
                this.error(
                    "LYS-SEM0032",
                    "every alternative binds the same names, of the same types",
                    at
                );
            }
            k += 1;
        }
        // any alternative: no test where one matches every value
        var test: ?TExpr = TExpr.Bool(false);
        for (x in tests) {
            if (x == null) {
                test = null;
                break;
            }
            let sofar = test;
            test = if (sofar != null) TExpr.Binary(boxE(sofar), BinaryOp.Or, boxE(x), Ty.Bool)
                else null;
        }
        for (b in first) {
            if (seen.containsKey(b.name)) {
                this.error("LYS-SEM0097", f"'{b.name}' is bound twice in this pattern", b.at);
                continue;
            }
            seen.insert(b.name, true);
            let t = typeOf(b.value);
            var value = boundNamed(bounds[bounds.length() - 1], b.name) ?? TExpr.Unknown;
            var j = bounds.length() - 2;
            while (j >= 0) {
                let mine = boundNamed(bounds[j], b.name) ?? TExpr.Unknown;
                let tj = tests[j];
                value = if (tj != null) TExpr.If(boxE(tj), boxE(mine), boxE(value), t) else mine;
                j -= 1;
            }
            out.push(Bound { name = b.name, value = value, at = b.at });
        }
        return test;
    }

    /// `let P = v else { … }`: the names of `P` bound where it matches; else the block runs, and
    /// it leaves on every path, since after the statement the names are bound (Lyric 5 §9 §1
    /// rule 5).
    mut fn letElse(isVar: bool, pattern: Pattern, value: Expr, otherwise: Block, at: Span): TStmt {
        let v = this.expr(value, null);
        let t = typeOf(v);
        let tmp = this.hidden(t, at);
        let src = TExpr.Local(tmp, t);
        let bound = List<Bound>.new();
        let test = this.patternTest(pattern, src, bound, Map<string, bool>.new());
        let before = this.ctx.unassigned;
        let miss = this.block(otherwise);
        if (!leavesAll(miss)) {
            this.error(
                "LYS-SEM0098",
                "the 'else' of a 'let' leaves on every path — return, break, continue or panic — since after it the names are bound",
                otherwise.span
            );
        }
        this.ctx.unassigned = before;
        let out = List<TStmt>.new();
        out.push(TStmt.SetLocal(tmp, v, at.line));
        if (test != null) {
            out.push(TStmt.If(TExpr.Unary(UnaryOp.Not, boxE(test), Ty.Bool), miss, [], at.line));
        }
        for (b in bound) {
            let bt = typeOf(b.value);
            if (this.atTop()) {
                out.push(
                    TStmt.SetGlobal(this.declareGlobal(b.name, bt, isVar, b.at), b.value, at.line)
                );
            } else {
                out.push(
                    TStmt.SetLocal(this.declareLocal(b.name, bt, isVar, b.at), b.value, at.line)
                );
            }
        }
        return TStmt.Block(out.toArray(), at.line);
    }

    /// `if (let P = v) { … } else { … }` with a pattern: the block where it matches, its names
    /// bound there.
    mut fn ifLetPattern(
        pattern: Pattern,
        value: Expr,
        then: Block,
        otherwise: ?Box<Stmt>,
        at: Span
    ): TStmt {
        let v = this.expr(value, null);
        let t = typeOf(v);
        let tmp = this.hidden(t, at);
        let src = TExpr.Local(tmp, t);
        let before = this.ctx.unassigned;
        this.pushScope();
        let bound = List<Bound>.new();
        let test = this.patternTest(pattern, src, bound, Map<string, bool>.new());
        if (test == null) {
            this.warn(
                "LYS-SEM0104",
                "this pattern matches every value: the 'if' always takes its block",
                at
            );
        }
        let body = List<TStmt>.new();
        for (b in bound) {
            let id = this.declareLocal(b.name, typeOf(b.value), false, b.at);
            body.push(TStmt.SetLocal(id, b.value, at.line));
        }
        for (s in this.block(then)) {
            body.push(s);
        }
        this.popScope();
        let afterThen = this.ctx.unassigned;
        this.ctx.unassigned = before;
        var o: TStmt[] = [];
        if (otherwise != null) {
            this.pushScope();
            o = [this.stmt(otherwise.value)];
            this.popScope();
        }
        this.ctx.unassigned = afterThen.union(this.ctx.unassigned);
        return TStmt.Block(
            [
                TStmt.SetLocal(tmp, v, at.line),
                TStmt.If(test ?? TExpr.Bool(true), body.toArray(), o, at.line),
            ],
            at.line
        );
    }

    /// `while (let P = v) { … }` with a pattern: a turn while it matches, `v` again before each.
    mut fn whileLetPattern(
        pattern: Pattern,
        value: Expr,
        body: Block,
        label: ?string,
        at: Span
    ): TStmt {
        this.pushScope();
        let v = this.expr(value, null);
        let t = typeOf(v);
        let tmp = this.hidden(t, at);
        let src = TExpr.Local(tmp, t);
        let bound = List<Bound>.new();
        let test = this.patternTest(pattern, src, bound, Map<string, bool>.new());
        let turn = List<TStmt>.new();
        turn.push(TStmt.SetLocal(tmp, v, at.line));
        if (test != null) {
            turn.push(
                TStmt.If(
                    TExpr.Unary(UnaryOp.Not, boxE(test), Ty.Bool),
                    [TStmt.Break(null, 0, at.line)],
                    [],
                    at.line
                )
            );
        }
        for (b in bound) {
            let id = this.declareLocal(b.name, typeOf(b.value), false, b.at);
            turn.push(TStmt.SetLocal(id, b.value, at.line));
        }
        let before = this.ctx.unassigned;
        this.pushLoop(LoopCtx { isLoop = false }, label, at);
        for (s in this.block(body)) {
            turn.push(s);
        }
        this.popLoop();
        this.popScope();
        this.ctx.unassigned = before;
        return TStmt.While(TExpr.Bool(true), turn.toArray(), at.line);
    }

    /// Whether a binding here is a global of the script: the outermost scope of its code.
    mut fn atTop(): bool {
        return this.ctx.isMain && this.ctx.scopes.length() == 1;
    }

    mut fn declareGlobal(name: string, t: Ty, isVar: bool, at: Span): int {
        let key = this.declKey(name);
        if (this.globalIndex.containsKey(key)) {
            this.error("LYS-SEM0176", f"'{name}' is bound twice in one scope", at);
        }
        let g = this.globals.length();
        // a global's name is its key: the quiet pass of 03 Leer builds the index again from it
        this.globals.push(GlobalInfo { name = key, ty = t, isVar = isVar });
        this.globalIndex.insert(key, g);
        this.register(name, at);
        return g;
    }

    /// `var x: T` without a value: assigned later, and read only where it is assigned on every
    /// way (Lyric 5 §7.1 rule 5). A `let` so declared is never written, as in Lyric 5.
    mut fn unassignedLet(isVar: bool, name: string, typed: bool, t: Ty, at: Span): TStmt {
        if (!typed) {
            this.error(
                "LYS-SEM0010",
                f"'{name}' has neither a type nor a value: write its type",
                at
            );
        }
        if (this.atTop()) {
            this.error(
                "LYS-SEM0903",
                f"'{name}' is a global of the script: it takes its value where it is declared, as a function may read it before any statement assigns it",
                at
            );
            this.declareGlobal(name, t, isVar, at);
            return TStmt.Expr(TExpr.Unit, at.line);
        }
        let id = this.declareLocal(name, t, isVar, at);
        this.ctx.unassigned = withId(this.ctx.unassigned, id);
        return TStmt.DeclareLocal(id, at.line);
    }

    /// `var x = null` (03 Leer): its type is the first a use in the function fixes — sought by the
    /// first pass, given by the second; where nothing fixes it, it is written.
    mut fn nullVar(name: string, at: Span): TStmt {
        let ord = this.ctx.nullVars;
        this.ctx.nullVars += 1;
        var t = Ty.Unknown;
        if (this.ctx.fixing) {
            this.ctx.fixes.push(null);
        } else {
            let fixed: ?Ty = if (ord < this.ctx.fixes.length()) this.ctx.fixes[ord] else null;
            if (fixed != null) {
                t = fixed;
            } else {
                this.errorHelp(
                    "LYS-SEM0010",
                    f"nothing in this function fixes the type of '{name}'",
                    f"write it: var {name}: ?T = null",
                    at
                );
            }
        }
        let v = if (t == .Unknown) TExpr.Unknown else TExpr.Null(t);
        if (this.atTop()) {
            let g = this.declareGlobal(name, t, true, at);
            if (this.ctx.fixing) {
                this.ctx.soughtGlobals.insert(g, ord);
            }
            return TStmt.SetGlobal(g, v, at.line);
        }
        let id = this.declareLocal(name, t, true, at);
        if (this.ctx.fixing) {
            this.ctx.sought.insert(id, ord);
        }
        return TStmt.SetLocal(id, v, at.line);
    }

    /// `var xs = []` or `let xs = []` (03 Leer, S7b2b): its type is the first a use in the function
    /// fixes — a push, an element written, the list given where a list is taken; where nothing
    /// fixes it, it is written.
    mut fn emptyListVar(name: string, isVar: bool, at: Span): TStmt {
        let ord = this.ctx.nullVars;
        this.ctx.nullVars += 1;
        var t = Ty.List(boxTy(Ty.Unknown));
        if (this.ctx.fixing) {
            this.ctx.fixes.push(null);
        } else {
            let fixed: ?Ty = if (ord < this.ctx.fixes.length()) this.ctx.fixes[ord] else null;
            if (fixed != null) {
                t = fixed;
            } else {
                this.errorHelp(
                    "LYS-SEM0010",
                    f"nothing in this function fixes the type of '{name}'",
                    f"write it: {if (isVar) "var" else "let"} {name}: T[] = []",
                    at
                );
                t = Ty.Unknown;
            }
        }
        let v = if (t == .Unknown) TExpr.Unknown else TExpr.ListOp(ListOp.Lit, [], t);
        if (this.atTop()) {
            let g = this.declareGlobal(name, t, isVar, at);
            if (this.ctx.fixing) {
                this.ctx.soughtGlobals.insert(g, ord);
            }
            return TStmt.SetGlobal(g, v, at.line);
        }
        let id = this.declareLocal(name, t, isVar, at);
        if (this.ctx.fixing) {
            this.ctx.sought.insert(id, ord);
        }
        return TStmt.SetLocal(id, v, at.line);
    }

    /// In the first pass of 03 Leer: where `e` is a `var x = null` whose type is still sought, `t`
    /// fixes it — the first such use in the function, as an optional.
    mut fn fixFrom(e: TExpr, t: Ty): void {
        if (!this.ctx.fixing) {
            return;
        }
        let ord: ?int = match (e) {
            .Local(id, _) => this.ctx.sought.get(id),
            .Global(g, _) => this.ctx.soughtGlobals.get(g),
            _ => null,
        };
        if (ord == null || this.ctx.fixes[ord] != null) {
            return;
        }
        // an empty list's: a list of a known element (S7b2b)
        let sought = typeOf(e);
        let isList = match (sought) {
            .List(_) => true,
            _ => false,
        };
        if (isList) {
            match (t) {
                .List(x) => {
                    if (x.value != .Unknown && x.value != .NullLit) {
                        this.ctx.fixes[ord] = t;
                    }
                }
                _ => { }
            }
            return;
        }
        let fixed: ?Ty = match (t) {
            .Optional(_) => t,
            .NullLit | .Unknown | .Void | .Never => null,
            _ => Ty.Optional(boxTy(t)),
        };
        if (fixed != null) {
            this.ctx.fixes[ord] = fixed;
        }
    }

    mut fn condition(e: Expr): TExpr {
        let c = this.expr(e, Ty.Bool);
        let t = typeOf(c);
        if (t != .Bool && t != .Unknown && t != .Never) {
            this.error("LYS-SEM0004", f"a condition is a bool, not {this.tyName(t)}", spanOf(e));
            return TExpr.Unknown;
        }
        return c;
    }

    /// `for (x in a..b)`: over a range of ints; `for (x in c)` over a coroutine (S6b2); other
    /// iterables come with the collections (S7).
    /// `a..b`, `a..=b` as a value, its first bound checked (Lyric 5 12 Iteration; S7c6a): the
    /// prelude's `Range<T>` or `RangeInclusive<T>`, `T` the bounds' type the position names,
    /// else the first bound's — `let f: Range<float> = 0..3` widens both.
    mut fn rangeValue(checked: TExpr, to: Expr, inclusive: bool, want: ?Ty, at: Span): TExpr {
        let t = want ?? typeOf(checked);
        let first = this.coerce(checked, t, at);
        let last = this.coerce(this.expr(to, t), t, spanOf(to));
        let index = this.typeIndex.get(if (inclusive) "RangeInclusive" else "Range") ?? -1;
        if (index < 0 || t == .Unknown) {
            return TExpr.Unknown;
        }
        let inst = this.typeInstance(index, [t]);
        this.fillInstance(inst);
        return TExpr.New(inst, [first, last]);
    }

    /// The bounds' type a position that wants a range names: `T` of a `Range<T>` or a
    /// `RangeInclusive<T>`.
    fn rangeElement(expected: ?Ty): ?Ty {
        if (let want = expected) {
            match (want) {
                .Named(i) => {
                    let info = this.types[i];
                    let base = info.template;
                    if (base >= 0
                        && info.args.length() == 1
                        && (base == (this.typeIndex.get("Range") ?? -1)
                            || base == (this.typeIndex.get("RangeInclusive") ?? -1))) {
                        return info.args[0];
                    }
                }
                _ => { }
            }
        }
        return null;
    }

    mut fn forStmt(name: string, iterable: Expr, body: Block, label: ?string, at: Span): TStmt {
        // a range of another type than `int` — of characters —: a value walked as any iterable
        // (S7c6a)
        var ranged: ?TExpr = null;
        match (iterable) {
            .Range(from, to, inclusive, _) => {
                let first = this.expr(from.value, Ty.Int);
                if (typeOf(first) != .Int && typeOf(first) != .Unknown) {
                    ranged = this.rangeValue(first, to.value, inclusive, null, spanOf(from.value));
                } else {
                    let a = this.coerce(first, Ty.Int, spanOf(from.value));
                    let b = this.coerce(this.expr(to.value, Ty.Int), Ty.Int, spanOf(to.value));
                    let before = this.ctx.unassigned;
                    this.pushScope();
                    let id = this.declareLocal(name, Ty.Int, false, at);
                    this.pushLoop(LoopCtx { isLoop = false }, label, at);
                    let stmts = this.block(body);
                    this.popLoop();
                    this.popScope();
                    // the body may not run
                    this.ctx.unassigned = before;
                    return TStmt.ForRange(id, a, b, inclusive, stmts, at.line);
                }
            }
            _ => { }
        }
        // a coroutine (S6b2): its values, pulled one by one — `while (let x = c.next())` over the
        // coroutine, held once; other iterables come with the collections (S7)
        this.pushScope();
        let it = ranged ?? this.expr(iterable, null);
        let t = typeOf(it);
        let co = this.coroutineArgs(t);
        if (co.length() == 2) {
            if (co[0] == .Void) {
                this.error(
                    "LYS-SEM0007",
                    "a Coroutine<void> yields no value to bind: pull it with next()",
                    spanOf(iterable)
                );
                this.popScope();
                return TStmt.Expr(it, at.line);
            }
            let id = this.hidden(t, at);
            let held = Expr.Name(this.ctx.localNames[id], at);
            let pull = Expr.Call(
                Box<Expr> { value = Expr.Member(Box<Expr> { value = held }, "next", false, at) },
                [],
                at
            );
            let loop = this.whileLet(name, pull, body, label, at);
            this.popScope();
            return TStmt.Block([TStmt.SetLocal(id, it, at.line), loop], at.line);
        }
        // a list (S7b1): its elements by index over the list held once; a step after a change of its
        // length panics (S7b2a; Lyric 5's `LYR-RT0016`)
        match (t) {
            .List(e) => {
                let elem = e.value;
                let lid = this.hidden(t, at);
                let iid = this.hidden(Ty.Int, at);
                let cid = this.hidden(Ty.Int, at);
                let list = TExpr.Local(lid, t);
                let idx = TExpr.Local(iid, Ty.Int);
                let before = this.ctx.unassigned;
                this.pushScope();
                let xid = this.declareLocal(name, elem, false, at);
                this.pushLoop(LoopCtx { isLoop = false }, label, at);
                let stmts = this.block(body);
                this.popLoop();
                this.popScope();
                // the body may not run
                this.ctx.unassigned = before;
                this.popScope();
                let each = List<TStmt>.new();
                // each step first checks that the list's length did not change (S7b2a)
                each.push(
                    TStmt.Expr(
                        TExpr.ListOp(ListOp.Check, [list, TExpr.Local(cid, Ty.Int)], Ty.Void),
                        at.line
                    )
                );
                each.push(
                    TStmt.If(
                        TExpr.Binary(
                            boxE(idx),
                            BinaryOp.Ge,
                            boxE(TExpr.ListOp(ListOp.Len, [list], Ty.Int)),
                            Ty.Bool
                        ),
                        [TStmt.Break(null, 0, at.line)],
                        [],
                        at.line
                    )
                );
                each.push(
                    TStmt.SetLocal(xid, TExpr.ListOp(ListOp.Get, [list, idx], elem), at.line)
                );
                each.push(
                    TStmt.SetLocal(
                        iid,
                        TExpr.Binary(boxE(idx), BinaryOp.Add, boxE(TExpr.Int(1)), Ty.Int),
                        at.line
                    )
                );
                for (st in stmts) {
                    each.push(st);
                }
                return TStmt.Block(
                    [
                        TStmt.SetLocal(lid, it, at.line),
                        TStmt.SetLocal(cid, TExpr.ListOp(ListOp.Changes, [list], Ty.Int), at.line),
                        TStmt.SetLocal(iid, TExpr.Int(0), at.line),
                        TStmt.While(TExpr.Bool(true), each.toArray(), at.line),
                    ],
                    at.line
                );
            }
            _ => { }
        }
        // an Iterator, or an Iterable through its `iter()` (S7c4a; Lyric 5 §1): `while (let x =
        // it.next())` over the iterator held once, closed at every way out where it is a
        // `Closeable` (05 E7)
        let iteratorI = this.typeIndex.get("Iterator") ?? -1;
        let iterableI = this.typeIndex.get("Iterable") ?? -1;
        let walks = iteratorI >= 0 && this.conformsTo(t, iteratorI);
        if (walks || (iterableI >= 0 && this.conformsTo(t, iterableI))) {
            let head = List<TStmt>.new();
            let h = this.hidden(t, at);
            head.push(TStmt.SetLocal(h, it, at.line));
            var walker = Expr.Name(this.ctx.localNames[h], at);
            var wt = t;
            if (!walks) {
                let made = this.expr(
                    Expr.Call(
                        Box<Expr> {
                            value = Expr.Member(Box<Expr> { value = walker }, "iter", false, at),
                        },
                        [],
                        at
                    ),
                    null
                );
                wt = typeOf(made);
                let h2 = this.hidden(wt, at);
                head.push(TStmt.SetLocal(h2, made, at.line));
                walker = Expr.Name(this.ctx.localNames[h2], at);
            }
            let pull = Expr.Call(
                Box<Expr> { value = Expr.Member(Box<Expr> { value = walker }, "next", false, at) },
                [],
                at
            );
            let loop = Stmt.WhileLet(Pattern.Name(name, at), pull, body, label, at);
            let closeable = this.typeIndex.get("Closeable") ?? -1;
            let stmts = if (closeable >= 0 && this.conformsTo(wt, closeable)) [
                Stmt.Defer(
                    Block {
                        stmts = [
                            Stmt.Expr(
                                Expr.Call(
                                    Box<Expr> {
                                        value = Expr.Member(
                                            Box<Expr> { value = walker },
                                            "close",
                                            false,
                                            at
                                        ),
                                    },
                                    [],
                                    at
                                ),
                                at
                            ),
                        ],
                        span = at,
                    },
                    at
                ),
                loop,
            ]
                else [loop];
            for (s in this.stmtList(stmts)) {
                head.push(s);
            }
            this.popScope();
            return TStmt.Block(head.toArray(), at.line);
        }
        this.popScope();
        if (t != .Unknown) {
            this.error(
                "LYS-SEM0007",
                f"'{this.tyName(t)}' cannot be iterated: it is no Iterable",
                spanOf(iterable)
            );
        }
        return TStmt.Expr(TExpr.Unknown, at.line);
    }

    mut fn breakStmt(label: ?string, value: ?Expr, at: Span): TStmt {
        let out = this.breakOf(label, value, at);
        match (out) {
            .Break(_, outward, _) => {
                let k = this.ctx.loops.length() - 1 - outward;
                if (k >= 0) {
                    let loop = this.ctx.loops[k];
                    loop.exits = loop.exits.union(this.ctx.unassigned);
                }
            }
            _ => { }
        }
        return out;
    }

    /// Opens a loop with its label: one repeating a label around it is refused, a jump to it
    /// would be ambiguous (`LYS-SEM0102`).
    mut fn pushLoop(ctx: LoopCtx, label: ?string, at: Span): void {
        if (let name = label) {
            for (l in this.ctx.loops) {
                if (l.label == name) {
                    this.error(
                        "LYS-SEM0102",
                        f"a loop around is labeled '{name}' already: a jump to it would be ambiguous",
                        at
                    );
                }
            }
            ctx.label = name;
            ctx.labelAt = at;
        }
        this.ctx.loops.push(ctx);
    }

    /// Closes the innermost loop: a label nothing jumps to is warned about (`LYS-SEM0103`).
    mut fn popLoop(): void {
        let loop = this.ctx.loops.pop();
        if (loop != null) {
            let name = loop.label;
            let at = loop.labelAt;
            if (name != null && at != null && !loop.named) {
                this.warn("LYS-SEM0103", f"no jump names the label '{name}'", at);
            }
        }
    }

    /// The loop a jump leaves or continues, by its index among the loops around: the innermost,
    /// or the one its label names (`LYS-SEM0101` for none); -1 after a fault.
    mut fn jumpTarget(label: ?string, at: Span): int {
        let name = label;
        if (name == null) {
            return this.ctx.loops.length() - 1;
        }
        var k = this.ctx.loops.length() - 1;
        while (k >= 0) {
            if (this.ctx.loops[k].label == name) {
                this.ctx.loops[k].named = true;
                return k;
            }
            k -= 1;
        }
        this.error("LYS-SEM0101", f"no loop around is labeled '{name}'", at);
        return -1;
    }

    mut fn breakOf(label: ?string, value: ?Expr, at: Span): TStmt {
        if (this.ctx.loops.length() == 0) {
            this.error("LYS-SEM0147", "'break' outside a loop", at);
            return TStmt.Break(null, 0, at.line);
        }
        let k = this.jumpTarget(label, at);
        if (k < 0) {
            return TStmt.Break(null, 0, at.line);
        }
        this.outOfDefer("break", k, at);
        let outward = this.ctx.loops.length() - 1 - k;
        let loop = this.ctx.loops[k];
        loop.breaks += 1;
        if (value == null) {
            if (loop.isLoop && loop.breakTy != null) {
                this.error(
                    "LYS-SEM0149",
                    "this 'loop' gives a value at some breaks and none at this one",
                    at
                );
            }
            return TStmt.Break(null, outward, at.line);
        }
        if (!loop.isLoop) {
            this.error(
                "LYS-SEM0148",
                "a 'while' or 'for' gives no value: its 'break' takes none",
                at
            );
            return TStmt.Break(null, outward, at.line);
        }
        let given = loop.breakTy;
        let v = this.expr(value, given);
        if (given == null) {
            if (loop.breaks > 1) {
                this.error(
                    "LYS-SEM0149",
                    "this 'loop' gives a value at this break and none at another",
                    at
                );
            }
            loop.breakTy = typeOf(v);
            return TStmt.Break(v, outward, at.line);
        }
        return TStmt.Break(this.coerce(v, given, spanOf(value)), outward, at.line);
    }

    /// A jump that would leave a defer's body: refused, since the body runs where the scope is
    /// left — on an error too, which the jump would drop (`LYS-SEM0904`). `target` is the index of
    /// the loop a `break` or `continue` goes to, -1 for a `return`.
    mut fn outOfDefer(word: string, target: int, at: Span): void {
        let d = this.ctx.deferLoops;
        if (d < 0 || target >= d) {
            return;
        }
        this.error(
            "LYS-SEM0904",
            f"'{word}' would leave a defer's body: a defer runs where its scope is left and goes on from there",
            at
        );
    }

    mut fn returnStmt(value: ?Expr, at: Span): TStmt {
        this.outOfDefer("return", -1, at);
        if (this.ctx.isMain) {
            this.error(
                "LYS-SEM0902",
                "'return' outside a function: a script ends at its end, or with exit(n)",
                at
            );
            return TStmt.Return(null, at.line);
        }
        let expected = this.ctx.returns;
        // a coroutine's body: `return v` gives its result, none where the type has none (rule 3);
        // where nothing gives the result, the returns unify into it (rule 11)
        if (this.ctx.yields != null && this.ctx.returnsInferred) {
            if (value == null) {
                this.ctx.returns = this.unify(expected, Ty.Void, at, "the returns");
                return TStmt.Return(null, at.line);
            }
            let v = this.expr(value, if (expected == .Unknown) null else expected);
            let t = this.unify(expected, typeOf(v), spanOf(value), "the returns");
            this.ctx.returns = t;
            return TStmt.Return(this.coerce(v, t, spanOf(value)), at.line);
        }
        if (this.ctx.yields != null) {
            if (value == null && expected != .Void && expected != .Unknown) {
                this.error(
                    "LYS-SEM0001",
                    f"the coroutine returns {this.tyName(expected)}: its 'return' gives one",
                    at
                );
                return TStmt.Return(null, at.line);
            }
            if (value != null && expected == .Void) {
                this.error(
                    "LYS-SEM0039",
                    "the coroutine returns nothing — a Coroutine<Y> has no result, a Coroutine<Y, R> has",
                    at
                );
                return TStmt.Return(null, at.line);
            }
        }
        if (this.ctx.isLambda && expected == .Unknown) {
            this.error(
                "LYS-SEM0010",
                "this lambda's result type is not known where it returns: write it, (…): T => …",
                at
            );
        }
        if (value == null) {
            if (expected != .Void && expected != .Unknown) {
                this.error(
                    "LYS-SEM0226",
                    f"this 'return' gives no value; the function returns {this.tyName(expected)}",
                    at
                );
            }
            return TStmt.Return(null, at.line);
        }
        if (expected == .Void) {
            this.error(
                "LYS-SEM0001",
                "the function returns nothing, so its 'return' takes no value",
                at
            );
            return TStmt.Return(null, at.line);
        }
        let v = this.expr(value, expected);
        // a function returning `never` does not return, unless what it returns does not either
        // (06 §9 rule 4)
        if (expected == .Never && typeOf(v) != .Never && typeOf(v) != .Unknown) {
            this.error(
                "LYS-SEM0146",
                "the function returns never: it does not return, so a 'return' gives nothing to it",
                at
            );
            return TStmt.Return(null, at.line);
        }
        return TStmt.Return(this.coerce(v, expected, spanOf(value)), at.line);
    }

    /// `yield v` or `yield` (Lyric 5 10 §1 rule 2): the value to the context that pulled, checked
    /// against the coroutine's `Y`; a bare `yield` only in a `Coroutine<void>` (`LYS-SEM0038`).
    mut fn yieldStmt(value: ?Expr, at: Span): TStmt {
        let y = this.ctx.yields;
        let cancelled = this.cancelledTy();
        if (y == null) {
            // a yield in a function a coroutine calls (Lyric 5 10 §1 rule 13): typed as what it
            // is, met with the running coroutine's `Y` where it runs
            let v: ?TExpr = if (value != null) this.expr(value, null) else null;
            return TStmt.Yield(v, cancelled, true, at.line);
        }
        // a generator lambda's without a type for it: the yields unify into it (rule 11)
        if (this.ctx.yieldsInferred) {
            if (value == null) {
                this.ctx.yields = this.unify(y, Ty.Void, at, "the yields");
                return TStmt.Yield(null, cancelled, false, at.line);
            }
            let v = this.expr(value, if (y == .Unknown) null else y);
            let t = this.unify(y, typeOf(v), spanOf(value), "the yields");
            this.ctx.yields = t;
            return TStmt.Yield(this.coerce(v, t, spanOf(value)), cancelled, false, at.line);
        }
        if (value == null) {
            if (y != .Void && y != .Unknown) {
                this.error(
                    "LYS-SEM0038",
                    f"a bare 'yield' in a coroutine that yields {this.tyName(y)}: give it a value",
                    at
                );
            }
            return TStmt.Yield(null, cancelled, false, at.line);
        }
        let v = this.expr(value, y);
        return TStmt.Yield(this.coerce(v, y, spanOf(value)), cancelled, false, at.line);
    }

    // --- expressions -----------------------------------------------------------------------------

    /// Checks an expression; `expected` is the type its place takes, where one is known.
    mut fn expr(e: Expr, expected: ?Ty): TExpr {
        return match (e) {
            .Throw(value, _) => this.throwOf(value.value),
            // `try e` marks `e` and changes nothing (05 Th)
            .TryMark(marked, _) => this.expr(marked.value, expected),
            .TryOpt(x, at) => this.tryOpt(x.value, false, at),
            .TryBang(x, at) => this.tryBang(x.value, expected, at),
            .TryCatch(x, clauses, at) => this.tryCatch(x.value, clauses, expected, false, at),
            // where the place's type conforms, built by its literal protocol (03 Lit)
            .Int(n, _) => this.literalOf(
                TExpr.Int(n),
                "FromIntLiteral",
                "fromIntLiteral",
                expected
            ),
            .Float(x, _) => this.literalOf(
                TExpr.Float(x),
                "FromFloatLiteral",
                "fromFloatLiteral",
                expected
            ),
            .Bool(b, _) => this.literalOf(
                TExpr.Bool(b),
                "FromBoolLiteral",
                "fromBoolLiteral",
                expected
            ),
            .Char(c, _) => TExpr.Char(c),
            .Str(s, _) => this.literalOf(
                TExpr.Str(s),
                "FromStringLiteral",
                "fromStringLiteral",
                expected
            ),
            .Bytes(_, at) => this.notYet("a byte string", "S7f (Bytes)", at),
            .Interpolated(segments, at) => this.interpolated(segments, at),
            .Null(_) => {
                let t = expected ?? Ty.NullLit;
                let built = this.literalBuilt(null, "FromNullLiteral", "fromNullLiteral", t);
                if (built != null) {
                    return built;
                }
                match (t) {
                    .Optional(_) => TExpr.Null(t),
                    _ => TExpr.Null(Ty.NullLit),
                }
            }
            .Tuple(items, _) => this.tuple(items, expected),
            .Unwrap(x, at) => {
                let v = this.expr(x.value, null);
                match (typeOf(v)) {
                    .Optional(inner) => TExpr.Unwrap(boxE(v), inner.value),
                    .Unknown => TExpr.Unknown,
                    _ => {
                        this.error("LYS-SEM0005", "'!' on a value that is never null", at);
                        TExpr.Unknown
                    }
                }
            }
            .Name(name, at) => this.name(name, expected, at),
            .Lambda(params, result, body, implicit, at) => this.lambda(
                params,
                result,
                body.value,
                implicit,
                expected,
                at
            ),
            .This(at) => {
                if (this.ctx.isLambda) {
                    // a lambda in a method captures its receiver (Lyric 5 03 §8.3 rule 3)
                    let k = this.capture(this.ctx, "this", at);
                    if (k >= 0) {
                        return TExpr.Captured(k, this.ctx.captures[k].ty);
                    }
                }
                let fnIndex = this.ctx.fnIndex;
                if (fnIndex >= 0
                    && this.functions[fnIndex].owner >= 0
                    && !this.functions[fnIndex].isStatic) {
                    // in an interface generic over `Self` the receiver is a `Self` (S3i)
                    let owner = this.functions[fnIndex].owner;
                    TExpr.Local(0, this.selfFor(owner) ?? this.selfTy(owner))
                } else {
                    this.error("LYS-SEM0008", "'this' outside a method", at);
                    TExpr.Unknown
                }
            }
            .Unary(op, x, at) => this.unary(op, x.value, at),
            .Binary(l, op, r, at) => this.binary(l.value, op, r.value, at),
            .Assign(target, op, value, at) => this.assign(target.value, op, value.value, at),
            .Step(target, up, prefix, at) => this.step(target.value, up, prefix, at),
            .Range(from, to, inclusive, _) => {
                let want = this.rangeElement(expected);
                let first = this.expr(from.value, want);
                this.rangeValue(first, to.value, inclusive, want, spanOf(from.value))
            }
            .Cast(x, written, at) => this.cast(x.value, written, at),
            .Call(callee, args, at) => this.spreadingCall(callee.value, args, expected, at),
            .Implicit(name, at) => this.implicit(name, expected, at),
            .VariantInit(enumName, name, fields, at) => this.variantInit(
                enumName,
                name,
                fields,
                expected,
                at
            ),
            .Match(x, arms, at) => this.matchOf(x.value, arms, expected, false, at),
            .Instance(callee, written, at) => this.genericValue(
                callee.value,
                written,
                expected,
                at
            ),
            .Is(x, written, at) => {
                let v = this.expr(x.value, null);
                let t = typeOf(v);
                if (t == .Unknown) {
                    TExpr.Unknown
                } else if (!this.isIfaceTy(t)) {
                    this.error(
                        "LYS-SEM0131",
                        f"'is' asks an interface value what it holds; {this.tyName(t)} is known already",
                        at
                    );
                    TExpr.Unknown
                } else {
                    this.typeTest(v, this.resolveType(written), at) ?? TExpr.Unknown
                }
            }
            .Index(x, i, at) => this.indexRead(x.value, i.value, at),
            .FromEnd(_, at) => {
                this.error("LYS-ICE0001", "a count from the end where no list is indexed", at);
                TExpr.Unknown
            }
            .Member(x, name, optional, at) => {
                this.memberExpected = expected;
                this.member(x.value, name, optional, at)
            }
            .List(items, at) => this.listLiteral(items, expected, at),
            .Map(entries, at) => this.mapLiteral(entries, expected, at),
            .StructInit(name, targs, fields, at) => this.init(name, targs, fields, expected, at),
            .With(target, fields, at) => this.withOf(target.value, fields, at),
            .If(cond, then, otherwise, at) => this.ifExpr(
                cond.value,
                then.value,
                otherwise.value,
                expected,
                at
            ),
            .Block(b, _) => this.valueBlock(b, expected),
            .Loop(body, label, at) => {
                this.unnarrowWritten([Stmt.Expr(e, at)]);
                let ctx = LoopCtx { isLoop = true };
                this.pushLoop(ctx, label, at);
                let stmts = this.block(body);
                this.popLoop();
                // left only by its breaks: what follows knows what each of them left
                this.ctx.unassigned = ctx.exits;
                let given = ctx.breakTy;
                let t = if (given != null) given else if (ctx.breaks > 0) Ty.Void else Ty.Never;
                TExpr.Loop(stmts, t)
            }
        };
    }

    /// `(a, b)`: where a tuple of its length is expected — through an optional too — each
    /// element where the expected element is, and the tuple of the expected type, labels and all
    /// (Lyric 5 §6 rule 5); else each element as it stands.
    mut fn tuple(items: Expr[], expected: ?Ty): TExpr {
        let want = expectedTuple(expected, items.length());
        let values = List<TExpr>.new();
        let tys = List<Ty>.new();
        let labels = List<string>.new();
        var bad = false;
        var k = 0;
        for (x in items) {
            if (want != null) {
                let et = want.elements[k];
                values.push(this.coerce(this.expr(x, et), et, spanOf(x)));
                tys.push(et);
            } else {
                let v = this.expr(x, null);
                let t = typeOf(v);
                if (t == .NullLit || t == .Void || t == .Never) {
                    this.error(
                        "LYS-SEM0010",
                        "this element gives no type of its own: write the tuple's type",
                        spanOf(x)
                    );
                    bad = true;
                }
                values.push(v);
                tys.push(t);
            }
            labels.push("");
            k += 1;
        }
        if (bad) {
            return TExpr.Unknown;
        }
        let t = if (want != null) Ty.Tuple(want)
            else Ty.Tuple(TupleTy { elements = tys.toArray(), labels = labels.toArray() });
        return TExpr.Tuple(values.toArray(), t);
    }

    /// `t.0`, `t.x`: the element of tuple `o` at a position or under a label of its type.
    mut fn element(o: TExpr, tt: TupleTy, name: string, at: Span): TExpr {
        var found = positionOf(name);
        if (found < 0) {
            var k = 0;
            for (label in tt.labels) {
                if (label == name) {
                    found = k;
                }
                k += 1;
            }
        }
        if (found < 0 || found >= tt.elements.length()) {
            this.error("LYS-SEM0012", f"{this.tyName(Ty.Tuple(tt))} has no element '{name}'", at);
            return TExpr.Unknown;
        }
        return TExpr.Elem(boxE(o), found, tt.elements[found]);
    }

    mut fn name(name: string, expected: ?Ty, at: Span): TExpr {
        let local = this.lookupLocal(name);
        if (local != null) {
            if (this.ctx.unassigned.contains(local)) {
                this.error(
                    "LYS-SEM0018",
                    f"'{name}' is read where it may not be assigned yet: assign it on every way to here",
                    at
                );
            }
            let declared = this.ctx.locals[local];
            let narrowed = this.narrowedLocal(local);
            if (narrowed != null) {
                // an interface value narrowed by a type test: the value it holds
                if (this.isIfaceTy(declared)) {
                    return this.heldAs(TExpr.Local(local, declared), narrowed);
                }
                return TExpr.Narrow(boxE(TExpr.Local(local, declared)), narrowed);
            }
            return TExpr.Local(local, declared);
        }
        // a lambda sees the bindings of the functions around it (Lyric 5 03 §8.3)
        if (this.ctx.isLambda) {
            let k = this.capture(this.ctx, name, at);
            if (k >= 0) {
                let c = this.ctx.captures[k];
                return if (c.isCell) TExpr.CapturedCell(k, c.ty) else TExpr.Captured(k, c.ty);
            }
        }
        let global = this.globalIndex.get(this.q(name));
        if (global != null) {
            let declared = this.globals[global].ty;
            let narrowed = this.narrowedGlobal(global);
            if (narrowed != null) {
                if (this.isIfaceTy(declared)) {
                    return this.heldAs(TExpr.Global(global, declared), narrowed);
                }
                return TExpr.Narrow(boxE(TExpr.Global(global, declared)), narrowed);
            }
            return TExpr.Global(global, declared);
        }
        let candidates = this.fnByName.get(this.q(name));
        if (candidates != null) {
            return this.functionValue(name, candidates.toArray(), expected, at);
        }
        if (this.typeIndex.containsKey(this.q(name))
            || this.aliases.containsKey(this.q(name))
            || isBuiltinType(name)) {
            this.error("LYS-SEM0052", f"'{name}' is a type, not a value", at);
            return TExpr.Unknown;
        }
        this.error("LYS-SEM0002", f"nothing in scope is named '{name}'", at);
        return TExpr.Unknown;
    }

    mut fn unary(op: UnaryOp, x: Expr, at: Span): TExpr {
        let v = this.expr(x, null);
        let t = typeOf(v);
        // over `never` an operator gives `never` (06 §9 rule 2)
        if (t == .Never) {
            return v;
        }
        if (t == .Unknown) {
            return TExpr.Unknown;
        }
        let fits = match (op) {
            .Neg => t == .Int || t == .Float,
            .Not => t == .Bool,
            .BitNot => t == .Int,
        };
        if (!fits) {
            if (let call = this.unaryOperator(v, op, at)) {
                return call;
            }
            this.error("LYS-SEM0003", f"'{unaryText(op)}' does not take {this.tyName(t)}", at);
            return TExpr.Unknown;
        }
        return TExpr.Unary(op, boxE(v), t);
    }

    mut fn binary(l: Expr, op: BinaryOp, r: Expr, at: Span): TExpr {
        match (op) {
            .Coalesce => {
                return this.coalesce(l, r, at);
            }
            .In | .NotIn => {
                return this.membership(l, op, r, at);
            }
            _ => { }
        }
        let a = this.expr(l, null);
        // the right side of `&&` and `||` sees what the left one says where it is checked
        var b = TExpr.Unknown;
        if (op == .And || op == .Or) {
            // the right side may not run: what it assigns does not count
            let before = this.ctx.unassigned;
            this.pushScope();
            this.narrow(this.factsOf(a, op == .And));
            b = this.expr(r, null);
            this.popScope();
            this.ctx.unassigned = before;
        } else {
            // `x == .Red`: the other side names the enum (Lyric 5 §4.2 rule 1)
            b = this.expr(r, if ((op == .Eq || op == .Ne) && isImplicit(r)) typeOf(a) else null);
        }
        let ta = typeOf(a);
        let tb = typeOf(b);
        if (ta == .Unknown || tb == .Unknown) {
            return TExpr.Unknown;
        }
        // `never` as an operand (06 §9 rule 2): the left one ends the path; on the right of `&&`
        // and `||` it may not run, so the left side's `bool` stands; under any other operator the
        // whole gives `never`, the left side run first
        if (ta == .Never) {
            return a;
        }
        if (tb == .Never) {
            if ((op == .And || op == .Or) && ta == .Bool) {
                return TExpr.Binary(boxE(a), op, boxE(b), Ty.Bool);
            }
            if (op != .And && op != .Or) {
                return TExpr.Block([TStmt.Expr(a, at.line)], boxE(b), Ty.Never);
            }
        }
        // `x == null`, `x != null`
        if ((op == .Eq || op == .Ne) && (ta == .NullLit || tb == .NullLit)) {
            let other = if (ta == .NullLit) b else a;
            let ot = typeOf(other);
            match (ot) {
                .Optional(_) => {
                    let test = TExpr.IsNull(boxE(other));
                    return if (op == .Eq) test else TExpr.Unary(UnaryOp.Not, boxE(test), Ty.Bool);
                }
                _ => {
                    this.error(
                        "LYS-SEM0059",
                        f"'{binaryText(op)} null' on a value that is never null",
                        at
                    );
                    return TExpr.Unknown;
                }
            }
        }
        let numeric = (ta == .Int || ta == .Float) && (tb == .Int || tb == .Float);
        let wide = if (ta == .Float || tb == .Float) Ty.Float else Ty.Int;
        match (op) {
            .And | .Or => {
                if (ta == .Bool && tb == .Bool) {
                    return TExpr.Binary(boxE(a), op, boxE(b), Ty.Bool);
                }
            }
            .Add | .Sub | .Mul | .Div | .Rem => {
                if (numeric) {
                    return TExpr.Binary(
                        boxE(this.coerce(a, wide, at)),
                        op,
                        boxE(this.coerce(b, wide, at)),
                        wide
                    );
                }
                // `xs + ys`, `xs * n` (S7b2a; 12 Container): new lists, through the prelude
                match (ta) {
                    .List(e) => {
                        if (op == .Add && ta == tb) {
                            return this.listCall("__listConcat", e.value, [a, b], ta);
                        }
                        if (op == .Mul && tb == .Int) {
                            return this.listCall("__listRepeat", e.value, [a, b], ta);
                        }
                    }
                    _ => { }
                }
                if (op == .Add && ta == .Str && tb == .Str) {
                    return TExpr.Native(Native.Concat, [a, b], Ty.Str);
                }
                // `s * n`, the text `n` times (Lyric 5 12 §Strings; S7e1), `n * s` refused as
                // `n * xs` is
                if (op == .Mul && ta == .Str && tb == .Int) {
                    return this.preludeCall("__strRepeat", [a, b], Ty.Str);
                }
            }
            .AddWrap | .SubWrap | .MulWrap | .Shl | .Shr | .BitAnd | .BitOr | .BitXor => {
                if (ta == .Int && tb == .Int) {
                    return TExpr.Binary(boxE(a), op, boxE(b), Ty.Int);
                }
            }
            .Lt | .Le | .Gt | .Ge => {
                if (numeric) {
                    return TExpr.Binary(
                        boxE(this.coerce(a, wide, at)),
                        op,
                        boxE(this.coerce(b, wide, at)),
                        Ty.Bool
                    );
                }
                if (let native = this.nativeOrder(a, op, b, at)) {
                    return native;
                }
                // an `Ordered` through its `compare` (Lyric 5 05 §12 rule 6; S7c5b)
                if (ta == tb && this.orderedIndex >= 0) {
                    if (this.anyParamIn(ta)) {
                        if (this.conformsTo(ta, this.orderedIndex)) {
                            return TExpr.GenericCompare(boxE(a), op, boxE(b));
                        }
                    } else if (this.conformsTo(ta, this.orderedIndex)) {
                        return this.ordered(a, op, b, at);
                    }
                    this.error(
                        "LYS-SEM0003",
                        f"'{binaryText(op)}' does not take {this.tyName(ta)} and {this.tyName(tb)}: {this.tyName(ta)} is no Ordered",
                        at
                    );
                    return TExpr.Unknown;
                }
            }
            .Eq | .Ne => {
                return this.equality(a, op, b, at);
            }
            _ => { }
        }
        // a type of the program: its conformance to the operator's interface (S7c5c2)
        if (let call = this.operatorCall(a, op, b, at)) {
            return call;
        }
        let ii = operatorOf(op).0;
        let why = if (ii != ""
            && !this.nativeOperand(ta)) f": {this.tyName(ta)} is no {ii}<{this.tyName(tb)}>"
            else "";
        this.error(
            "LYS-SEM0003",
            f"'{binaryText(op)}' does not take {this.tyName(ta)} and {this.tyName(tb)}{why}",
            at
        );
        return TExpr.Unknown;
    }

    /// Whether `t` is a type the VM computes with itself — a number, a `bool`, a `char`, a
    /// string, a list.
    fn nativeOperand(t: Ty): bool {
        return match (t) {
            .Int | .Float | .Bool | .Char | .Str | .List(_) | .Unknown => true,
            _ => false,
        };
    }

    /// `a op b` of a type of the program: `a.add(b)` through `Add<B>` where `b` is a `B` — the
    /// right operand's static type picks the conformance, an `int` literal adapting to a
    /// `float` (Lyric 5 05 §12 rules 1–2; S7c5c2); null where the type has no such conformance.
    mut fn operatorCall(a: TExpr, op: BinaryOp, b: TExpr, at: Span): ?TExpr {
        let (name, member) = operatorOf(op);
        let ta = typeOf(a);
        if (name == "" || this.nativeOperand(ta)) {
            return null;
        }
        let base = this.typeIndex.get(name) ?? -1;
        if (base < 0) {
            return null;
        }
        var rhs = b;
        var ii = this.exactIface(base, [typeOf(b)]);
        if (!this.conformsTo(ta, ii)) {
            let adapts = match (b) {
                .Int(_) => true,
                _ => false,
            };
            let wide = this.exactIface(base, [Ty.Float]);
            if (!adapts || !this.conformsTo(ta, wide)) {
                return null;
            }
            rhs = this.coerce(b, Ty.Float, at);
            ii = wide;
        }
        return this.operatorMember(a, [rhs], ii, member, at);
    }

    /// The interface `base` at `args`, an instance even where they read as its own parameters.
    mut fn exactIface(base: int, args: Ty[]): int {
        this.exactInstance = true;
        let i = this.typeInstance(base, args);
        this.exactInstance = false;
        return i;
    }

    /// `a.member(args)` of interface `ii` that `a`'s type conforms to: the type's own member,
    /// through a constraint where `a` is a type parameter, through a bound where it is an
    /// associated type (S7c5c2).
    mut fn operatorMember(a: TExpr, args: TExpr[], ii: int, member: string, at: Span): TExpr {
        let found = this.ifaceMember(ii, member);
        if (found == null) {
            return TExpr.Unknown;
        }
        let (fi, slot) = found;
        let ta = typeOf(a);
        let binds = this.bindsOf(fi, ii, ta);
        let rt = this.subst(this.returnsOf(fi, at), binds);
        let all = List<TExpr>.new();
        all.push(a);
        var k = 0;
        for (x in args) {
            let pt = if (k < this.functions[fi].params.length()) this.subst(
                this.functions[fi].params[k].ty,
                binds
            )
                else typeOf(x);
            all.push(this.coerce(x, pt, at));
            k += 1;
        }
        return match (ta) {
            .Param(p) => TExpr.CallConstraint(p, ii, member, slot, all.toArray(), rt),
            .Assoc(_, _, _) => TExpr.CallBound(ta, ii, member, slot, all.toArray(), rt),
            _ => {
                let entry = this.entryOf(ta);
                let own = if (entry >= 0) this.memberFor(entry, ii, member) else null;
                if (own == null) {
                    return this.memberCallOn(ta, ii, member, slot, all.toArray(), rt);
                }
                // a list's block member: at its element, a type parameter's list too (S7c5c3)
                match (ta) {
                    .List(e) => {
                        if (this.functions[own].typeParams.length() > 0) {
                            return TExpr.CallGeneric(own, [e.value], all.toArray(), rt);
                        }
                    }
                    _ => { }
                }
                let info = this.types[entry];
                if (this.functions[own].typeParams.length() > 0
                    && info.template >= 0
                    && info.template != entry) {
                    return TExpr.CallGeneric(own, info.args, all.toArray(), rt);
                }
                return TExpr.Call(own, all.toArray(), rt);
            }
        };
    }

    /// `-a`, `~a` of a type of the program: through `Neg`, `BitNot` (S7c5c2); null where it
    /// has no such conformance.
    mut fn unaryOperator(v: TExpr, op: UnaryOp, at: Span): ?TExpr {
        let (name, member) = match (op) {
            .Neg => ("Neg", "neg"),
            .BitNot => ("BitNot", "bitNot"),
            _ => ("", ""),
        };
        let t = typeOf(v);
        if (name == "" || this.nativeOperand(t)) {
            return null;
        }
        let ii = this.typeIndex.get(name) ?? -1;
        if (ii < 0 || !this.conformsTo(t, ii)) {
            return null;
        }
        return this.operatorMember(v, [], ii, member, at);
    }

    /// `x in xs`, `x !in xs` (Lyric 5 05 §12 rule 10; S7c5c3): `xs.contains(x)` through the
    /// `Contains<T>` of the right operand — a list's is the prelude's —, `x` adapting to its `T`;
    /// `x` evaluated before `xs`, though the call is the container's.
    mut fn membership(l: Expr, op: BinaryOp, r: Expr, at: Span): TExpr {
        let hay = this.expr(r, null);
        let ht = typeOf(hay);
        let ci = match (ht) {
            .Unknown => -2,
            .Str => -4,
            .Map(_, _) => -3,
            // a list's, where its block admits the element
            .List(e) => {
                let c = this.exactIface(this.typeIndex.get("Contains") ?? -1, [e.value]);
                if (this.conformsTo(ht, c)) c else -1
            }
            _ => this.instanceFor(ht, "Contains"),
        };
        if (ci == -2) {
            this.expr(l, null);
            return TExpr.Unknown;
        }
        if (ci == -3) {
            this.expr(l, null);
            return this.notYet(f"'{binaryText(op)}' over a {this.tyName(ht)}", laterClock(ht), at);
        }
        if (ci == -4) {
            // `c in s`: a character in a string, through its `contains` of a pattern (Lyric 5 12
            // §Strings, whose string is a `Contains<char>` through that member; S7e1) — the
            // character first, then the string
            let needle = this.coerce(this.expr(l, Ty.Char), Ty.Char, spanOf(l));
            let hx = this.hidden(Ty.Char, at);
            let hh = this.hidden(Ty.Str, at);
            let has = this.methodCall(
                TExpr.Local(hh, Ty.Str),
                "contains",
                [Arg { name = null, value = Expr.Name(this.ctx.localNames[hx], at) }],
                at,
                at
            );
            let value = if (op == .In) has else TExpr.Unary(UnaryOp.Not, boxE(has), Ty.Bool);
            return TExpr.Block(
                [TStmt.SetLocal(hx, needle, at.line), TStmt.SetLocal(hh, hay, at.line)],
                boxE(value),
                Ty.Bool
            );
        }
        if (ci < 0) {
            this.expr(l, null);
            let why = match (ht) {
                .List(e) => {
                    let missing = this.notEquatable(e.value, List<int>.new()) ?? "";
                    f"its elements do not compare: {missing}"
                }
                _ => f"{this.tyName(ht)} is no Contains",
            };
            this.error(
                "LYS-SEM0059",
                f"'{binaryText(op)}' asks the right operand's contains: {why}",
                at
            );
            return TExpr.Unknown;
        }
        let elem = match (this.types[ci].args.length()) {
            1 => this.types[ci].args[0],
            _ => Ty.Unknown,
        };
        let needle = this.coerce(this.expr(l, elem), elem, spanOf(l));
        // the needle first, then the container (rule 10)
        let hx = this.hidden(typeOf(needle), at);
        let hh = this.hidden(ht, at);
        let has = this.operatorMember(
            TExpr.Local(hh, ht),
            [TExpr.Local(hx, typeOf(needle))],
            ci,
            "contains",
            at
        );
        let value = if (op == .In) has else TExpr.Unary(UnaryOp.Not, boxE(has), Ty.Bool);
        return TExpr.Block(
            [TStmt.SetLocal(hx, needle, at.line), TStmt.SetLocal(hh, hay, at.line)],
            boxE(value),
            Ty.Bool
        );
    }

    /// `x++`, `++x`, `x--`, `--x` (Lyric 5 08 §6; S7c5c3): one added to a number's place or taken
    /// from it — a variable, a field, an element; what leads to it evaluated once —, worth the old
    /// value after it, the new before it; the step is checked as `+` and `-` are.
    mut fn step(target: Expr, up: bool, prefix: bool, at: Span): TExpr {
        let held = List<TStmt>.new();
        let place = match (target) {
            .Name(_, _) => target,
            .Member(obj, field, false, memberAt) => {
                let o = this.expr(obj.value, null);
                let h = this.hidden(typeOf(o), at);
                held.push(TStmt.SetLocal(h, o, at.line));
                Expr.Member(
                    Box<Expr> { value = Expr.Name(this.ctx.localNames[h], at) },
                    field,
                    false,
                    memberAt
                )
            }
            .Index(x, i, indexAt) => {
                let xv = this.expr(x.value, null);
                let hx = this.hidden(typeOf(xv), at);
                held.push(TStmt.SetLocal(hx, xv, at.line));
                let iv = this.expr(i.value, null);
                let hi = this.hidden(typeOf(iv), at);
                held.push(TStmt.SetLocal(hi, iv, at.line));
                Expr.Index(
                    Box<Expr> { value = Expr.Name(this.ctx.localNames[hx], at) },
                    Box<Expr> { value = Expr.Name(this.ctx.localNames[hi], at) },
                    indexAt
                )
            }
            _ => {
                this.expr(target, null);
                this.error(
                    "LYS-SEM0019",
                    "this cannot be stepped: a variable, a field or an element can",
                    at
                );
                return TExpr.Unknown;
            }
        };
        let old = this.expr(place, null);
        let t = typeOf(old);
        let word = if (up) "++" else "--";
        if (t != .Int && t != .Float) {
            if (t != .Unknown) {
                this.error("LYS-SEM0003", f"'{word}' steps a number, not a {this.tyName(t)}", at);
            }
            return TExpr.Unknown;
        }
        let h = this.hidden(t, at);
        held.push(TStmt.SetLocal(h, old, at.line));
        let op = if (up) BinaryOp.Add else BinaryOp.Sub;
        let one = if (t == .Int) Expr.Int(1, at) else Expr.Float(1.0, at);
        held.push(TStmt.Expr(this.assign(place, op, one, at), at.line));
        let oneV = if (t == .Int) TExpr.Int(1) else TExpr.Float(1.0);
        let value = if (prefix) TExpr.Binary(boxE(TExpr.Local(h, t)), op, boxE(oneV), t)
            else TExpr.Local(h, t);
        return TExpr.Block(held.toArray(), boxE(value), t);
    }

    /// `a < b` … of two scalars the VM orders itself: numbers widened, `char`s, strings by bytes;
    /// null for another pair.
    mut fn nativeOrder(a: TExpr, op: BinaryOp, b: TExpr, at: Span): ?TExpr {
        let ta = typeOf(a);
        let tb = typeOf(b);
        if ((ta == .Int || ta == .Float) && (tb == .Int || tb == .Float)) {
            let wide = if (ta == .Float || tb == .Float) Ty.Float else Ty.Int;
            return TExpr.Binary(
                boxE(this.coerce(a, wide, at)),
                op,
                boxE(this.coerce(b, wide, at)),
                Ty.Bool
            );
        }
        if (ta == .Char && tb == .Char) {
            return TExpr.Binary(boxE(a), op, boxE(b), Ty.Bool);
        }
        if (ta == .Str && tb == .Str) {
            let cmp = TExpr.Native(Native.StrCmp, [a, b], Ty.Int);
            return TExpr.Binary(boxE(cmp), op, boxE(TExpr.Int(0)), Ty.Bool);
        }
        return null;
    }

    /// `a < b` … of an `Ordered` type: what its `compare` gives, read by the prelude's `__less`
    /// and its kin (Lyric 5 05 §12 rule 6; S7c5b) — `null` makes all four false.
    mut fn ordered(a: TExpr, op: BinaryOp, b: TExpr, at: Span): TExpr {
        let verdict = match (op) {
            .Lt => "__less",
            .Le => "__lessOrEqual",
            .Gt => "__greater",
            _ => "__greaterOrEqual",
        };
        var fi = -1;
        if (let fs = this.fnByName.get(verdict)) {
            if (fs.length() > 0) {
                fi = fs[0];
            }
        }
        let cmp = this.compareCall(typeOf(a), a, b, false, at);
        return TExpr.Call(fi, [cmp], Ty.Bool);
    }

    /// `a.compare(b)` — `a.totalCompare(b)` where `total` — of two values of `t`: the type's own,
    /// else the one synthesized from its parts (Lyric 5 05 §14; S7c5b).
    mut fn compareCall(t: Ty, a: TExpr, b: TExpr, total: bool, at: Span): TExpr {
        let name = if (total) "totalCompare" else "compare";
        let ordering = Ty.Named(this.orderingIndex);
        let returns = if (total) ordering else Ty.Optional(boxTy(ordering));
        let entry = this.entryOf(t);
        if (entry >= 0) {
            if (let own = this.methodOf(entry, name)) {
                if (!this.functions[own].isStatic && this.functions[own].params.length() == 1) {
                    return TExpr.Call(own, [a, b], returns);
                }
            }
        }
        return TExpr.Call(this.cmpFnOf(t, total, at), [a, b], returns);
    }

    /// The function ordering two values of `t`, a struct, class or enum that lists `Ordered` or
    /// `TotalOrder` without the member (Lyric 5 05 §14 rules 2–3; S7c5b): lexicographic, the
    /// first part not `.Equal` deciding — an enum's variant first —, a `compare` meeting `null`
    /// giving `null`.
    mut fn cmpFnOf(t: Ty, total: bool, at: Span): int {
        let key = (if (total) "total " else "compare ") + tyKey(t);
        let known = this.genericEqFns.get(key);
        if (known != null) {
            return known;
        }
        let ordering = Ty.Named(this.orderingIndex);
        let returns = if (total) ordering else Ty.Optional(boxTy(ordering));
        let (index, saved) = this.beginSynth(
            if (total) "#totalCompare" else "#compare",
            [
                ParamInfo { name = "a", ty = t, default = null },
                ParamInfo { name = "b", ty = t, default = null },
            ],
            returns,
            at
        );
        this.genericEqFns.insert(key, index);
        let a = TExpr.Local(0, t);
        let b = TExpr.Local(1, t);
        let body = List<TStmt>.new();
        let info = match (t) {
            .Named(i) => this.types[i],
            _ => this.types[this.anyIndex],
        };
        if (this.isScalarEnum(t)) {
            this.cmpBefore(body, a, b, total, at);
        } else if (info.kind == .Enum) {
            let i = match (t) {
                .Named(j) => j,
                _ => -1,
            };
            let ta = TExpr.Tag(boxE(a));
            let tb = TExpr.Tag(boxE(b));
            this.cmpBefore(body, ta, tb, total, at);
            var v = 0;
            while (v < info.variantFields.length()) {
                let vf = info.variantFields[v];
                if (vf.length() > 0) {
                    // this variant's parts, where both are it
                    let inner = List<TStmt>.new();
                    var k = 0;
                    while (k < vf.length()) {
                        this.cmpPart(
                            inner,
                            TExpr.Payload(boxE(a), i, v, k, vf[k].ty),
                            TExpr.Payload(boxE(b), i, v, k, vf[k].ty),
                            vf[k].ty,
                            total,
                            at
                        );
                        k += 1;
                    }
                    body.push(
                        TStmt.If(
                            TExpr.Binary(boxE(ta), BinaryOp.Eq, boxE(TExpr.Int(v)), Ty.Bool),
                            inner.toArray(),
                            [],
                            at.line
                        )
                    );
                }
                v += 1;
            }
        } else {
            var k = 0;
            for (f in info.fields) {
                this.cmpPart(
                    body,
                    TExpr.Field(boxE(a), k, f.ty),
                    TExpr.Field(boxE(b), k, f.ty),
                    f.ty,
                    total,
                    at
                );
                k += 1;
            }
        }
        body.push(TStmt.Return(this.orderValue(1, total), at.line));
        this.endSynth(index, body.toArray(), saved);
        return index;
    }

    /// `Ordering`'s variant `k` as a `compare` gives it — wrapped in its optional — or a
    /// `totalCompare`.
    mut fn orderValue(k: int, total: bool): TExpr {
        let v = TExpr.Variant(this.orderingIndex, k);
        let ordering = Ty.Named(this.orderingIndex);
        return if (total) v else TExpr.Wrap(boxE(v), Ty.Optional(boxTy(ordering)));
    }

    /// Into `body`: `.Less` returned where `x < y`, `.Greater` where `x > y` — two integers, an
    /// enum's variant positions.
    mut fn cmpBefore(body: List<TStmt>, x: TExpr, y: TExpr, total: bool, at: Span): void {
        body.push(
            TStmt.If(
                TExpr.Binary(boxE(x), BinaryOp.Lt, boxE(y), Ty.Bool),
                [TStmt.Return(this.orderValue(0, total), at.line)],
                [],
                at.line
            )
        );
        body.push(
            TStmt.If(
                TExpr.Binary(boxE(x), BinaryOp.Gt, boxE(y), Ty.Bool),
                [TStmt.Return(this.orderValue(2, total), at.line)],
                [],
                at.line
            )
        );
    }

    /// Into `body`: the order of one part, `x` against `y` of type `pt`, returned where it is
    /// not `.Equal`.
    mut fn cmpPart(body: List<TStmt>, x: TExpr, y: TExpr, pt: Ty, total: bool, at: Span): void {
        let ordering = Ty.Named(this.orderingIndex);
        let returns = if (total) ordering else Ty.Optional(boxTy(ordering));
        let c = this.hidden(returns, at);
        body.push(TStmt.SetLocal(c, this.compareCall(pt, x, y, total, at), at.line));
        let differs = this.equality(
            TExpr.Local(c, returns),
            BinaryOp.Ne,
            this.orderValue(1, total),
            at
        );
        body.push(TStmt.If(differs, [TStmt.Return(TExpr.Local(c, returns), at.line)], [], at.line));
    }

    /// `a == b` and `a != b` of two checked operands: numbers widened, `bool`, `char`, an enum's
    /// variants and strings by value, optionals by Lyric 5 §3.2 rule 7.
    mut fn equality(a: TExpr, op: BinaryOp, b: TExpr, at: Span): TExpr {
        let ta = typeOf(a);
        let tb = typeOf(b);
        if (ta == .Unknown || tb == .Unknown) {
            return TExpr.Unknown;
        }
        let numeric = (ta == .Int || ta == .Float) && (tb == .Int || tb == .Float);
        if (numeric) {
            let wide = if (ta == .Float || tb == .Float) Ty.Float else Ty.Int;
            return TExpr.Binary(
                boxE(this.coerce(a, wide, at)),
                op,
                boxE(this.coerce(b, wide, at)),
                Ty.Bool
            );
        }
        // an optional beside a value of it or beside its like: a `T` coerces up to `?T`
        let opt = match (ta) {
            .Optional(_) => ta,
            _ => tb,
        };
        match (opt) {
            .Optional(_) => {
                let x = this.fit(a, opt);
                let y = this.fit(b, opt);
                if (x != null && y != null) {
                    return this.optionalEquality(x, op, y, opt, at);
                }
            }
            _ => { }
        }
        // a type that names a type parameter: compared where its copy knows it (S7c5a)
        if (this.anyParamIn(ta) || this.anyParamIn(tb)) {
            if (ta == tb) {
                let missing = this.notEquatable(ta, List<int>.new());
                if (missing == null) {
                    return TExpr.GenericCompare(boxE(a), op, boxE(b));
                }
                this.error(
                    "LYS-SEM0059",
                    f"'{binaryText(op)}' does not compare {this.tyName(ta)}: {missing}",
                    at
                );
                return TExpr.Unknown;
            }
        }
        if (ta == tb && (ta == .Bool || ta == .Char || this.isScalarEnum(ta))) {
            return TExpr.Binary(boxE(a), op, boxE(b), Ty.Bool);
        }
        if (ta == .Str && tb == .Str) {
            let eq = TExpr.Native(Native.StrEq, [a, b], Ty.Bool);
            return if (op == .Eq) eq else TExpr.Unary(UnaryOp.Not, boxE(eq), Ty.Bool);
        }
        let isFn = match (ta) {
            .Fn(_) => true,
            .Named(i) => this.types[i].kind == .Interface,
            _ => false,
        };
        if (isFn) {
            this.error(
                "LYS-SEM0059",
                "two function values, or interface values, are not compared",
                at
            );
            return TExpr.Unknown;
        }
        let isList = match (ta) {
            .List(_) => true,
            _ => false,
        };
        if (ta == tb && isList) {
            let elem = match (ta) {
                .List(e) => e.value,
                _ => Ty.Unknown,
            };
            let missing = this.notEquatable(elem, List<int>.new());
            if (missing != null) {
                this.error(
                    "LYS-SEM0059",
                    f"'{binaryText(op)}' does not compare {this.tyName(ta)}: {missing}",
                    at
                );
                return TExpr.Unknown;
            }
            let eq = TExpr.Call(this.listEqFnOf(ta, at), [a, b], Ty.Bool);
            return if (op == .Eq) eq else TExpr.Unary(UnaryOp.Not, boxE(eq), Ty.Bool);
        }
        if (ta == tb) {
            // a struct, an enum, a tuple compares its parts; a class only as an `Identity` (03 Eq)
            let missing = this.notEquatable(ta, List<int>.new());
            if (missing != null) {
                this.error(
                    "LYS-SEM0059",
                    f"'{binaryText(op)}' does not compare {this.tyName(ta)}: {missing}",
                    at
                );
                return TExpr.Unknown;
            }
            let eq = this.sameValue(a, b, ta, at);
            return if (op == .Eq) eq else TExpr.Unary(UnaryOp.Not, boxE(eq), Ty.Bool);
        }
        this.error(
            "LYS-SEM0059",
            f"'{binaryText(op)}' compares values of one type: {this.tyName(ta)} and {this.tyName(tb)}",
            at
        );
        return TExpr.Unknown;
    }

    /// Whether interface `ii`'s member is synthesized where a type lists it without one: the
    /// comparing family, `Equatable`, `Ordered`, `TotalOrder` (Lyric 5 05 §14; S7c5a, S7c5b).
    fn synthesizable(ii: int): bool {
        return ii >= 0
            && (ii == this.equatableIndex
                || ii == this.orderedIndex
                || ii == this.totalOrderIndex
                || ii == this.synth.cloneIx
                || ii == this.synth.defaultIx
                || ii == this.synth.hashableIx
                || ii == this.synth.debugIx);
    }

    /// `x.compare(y)` and `x.totalCompare(y)` of an `Ordered` or `TotalOrder` without its own
    /// (S7c5b); null for another call.
    mut fn synthCompare(t: Ty, receiver: TExpr, method: string, args: Arg[], at: Span): ?TExpr {
        let total = method == "totalCompare";
        if ((method != "compare" && !total) || args.length() != 1 || this.orderedIndex < 0) {
            return null;
        }
        let ii = if (total) this.totalOrderIndex else this.orderedIndex;
        if (!this.conformsTo(t, ii)) {
            return null;
        }
        let other = this.coerce(this.expr(args[0].value, t), t, spanOf(args[0].value));
        return this.compareCall(t, receiver, other, total, at);
    }

    /// `x.equals(y)` of a type that compares without an `equals` of its own (Lyric 5 05 §14;
    /// S7c5a): the comparison `==` makes; null for another call.
    mut fn synthEquals(t: Ty, receiver: TExpr, method: string, args: Arg[], at: Span): ?TExpr {
        if (method != "equals"
            || args.length() != 1
            || this.equatableIndex < 0
            || !this.conformsDirect(t, this.equatableIndex)) {
            return null;
        }
        let other = this.coerce(this.expr(args[0].value, t), t, spanOf(args[0].value));
        return this.equality(receiver, BinaryOp.Eq, other, at);
    }

    /// Whether type `i` (or its template) conforms to `Equatable` itself: a class that asks for
    /// `==` by its fields or its own `equals` (S7c5a).
    mut fn saysEquatable(i: int): bool {
        if (this.equatableIndex < 0) {
            return false;
        }
        let t = if (this.types[i].template >= 0) this.types[i].template else i;
        for (x in this.types[t].ifaces) {
            // a conditional conformance where the instance's arguments meet its condition (S7d2:
            // `Map<int, C>` of a class `C` no Equatable compared `C`s in its copy)
            if (t != i) {
                if (let cond = this.types[t].condIfaces.get(x)) {
                    if (!this.meetsBlock(this.types[i].args, cond)) {
                        continue;
                    }
                }
            }
            for (a in this.ancestry(x)) {
                if (a == this.equatableIndex) {
                    return true;
                }
            }
        }
        for (x in this.types[i].instIfaces) {
            for (a in this.ancestry(x)) {
                if (a == this.equatableIndex) {
                    return true;
                }
            }
        }
        return false;
    }

    /// Whether parameter type `t` of a callee names one of its type parameters `binds` leaves
    /// unbound: a position that gives its argument no type. A parameter bound, to a type that
    /// names the caller's own parameters too, gives it (S7d3: `b.or([])` of a `Box<T[]>` in a
    /// generic body was LYS-SEM0060).
    mut fn leavesOpen(t: Ty, binds: (?Ty)[]): bool {
        return match (t) {
            .Param(k) => k < 0 || k >= binds.length() || binds[k] == null,
            .Assoc(base, _, _) => this.leavesOpen(base.value, binds),
            .Optional(inner) | .List(inner) | .Cell(inner) => this.leavesOpen(inner.value, binds),
            .Map(k, v) => this.leavesOpen(k.value, binds) || this.leavesOpen(v.value, binds),
            .Tuple(tt) => {
                var found = false;
                for (x in tt.elements) {
                    found = found || this.leavesOpen(x, binds);
                }
                found
            }
            .Fn(ft) => {
                var found = this.leavesOpen(ft.result.value, binds);
                for (x in ft.params) {
                    found = found || this.leavesOpen(x, binds);
                }
                found
            }
            // a generic type at its own parameters is its template itself
            .Named(i) => {
                let info = this.types[i];
                var found = info.template == i && info.typeParams.length() > 0;
                if (info.template >= 0 && info.template != i) {
                    for (x in info.args) {
                        found = found || this.leavesOpen(x, binds);
                    }
                }
                found
            }
            _ => false,
        };
    }

    /// Whether `t` names a type parameter anywhere — in an instance's arguments too.
    mut fn anyParamIn(t: Ty): bool {
        return match (t) {
            .Param(_) | .Assoc(_, _, _) => true,
            .Optional(inner) | .List(inner) | .Cell(inner) => this.anyParamIn(inner.value),
            .Map(k, v) => this.anyParamIn(k.value) || this.anyParamIn(v.value),
            .Tuple(tt) => {
                var found = false;
                for (x in tt.elements) {
                    found = found || this.anyParamIn(x);
                }
                found
            }
            .Fn(ft) => {
                var found = this.anyParamIn(ft.result.value);
                for (x in ft.params) {
                    found = found || this.anyParamIn(x);
                }
                found
            }
            // a generic type at its own parameters is its template itself
            .Named(i) => {
                let info = this.types[i];
                var found = info.template == i && info.typeParams.length() > 0;
                if (info.template >= 0 && info.template != i) {
                    for (x in info.args) {
                        found = found || this.anyParamIn(x);
                    }
                }
                found
            }
            _ => false,
        };
    }

    /// The function comparing two values of `t`, a type a copy knows (S7c5a): a comparison over a
    /// type parameter, made where the copy is.
    mut fn genericEqFnOf(t: Ty, at: Span): int {
        let key = tyKey(t);
        let known = this.genericEqFns.get(key);
        if (known != null) {
            return known;
        }
        let (index, saved) = this.beginSynth(
            "#equals",
            [
                ParamInfo { name = "a", ty = t, default = null },
                ParamInfo { name = "b", ty = t, default = null },
            ],
            Ty.Bool,
            at
        );
        this.genericEqFns.insert(key, index);
        let eq = this.equality(TExpr.Local(0, t), BinaryOp.Eq, TExpr.Local(1, t), at);
        this.endSynth(index, [TStmt.Return(eq, at.line)], saved);
        return index;
    }

    /// What keeps values of `t` from being compared, `null` where nothing does: a class that is
    /// no `Identity`, a function, an interface value — in a field, a payload, an element.
    mut fn notEquatable(t: Ty, seen: List<int>): ?string {
        return match (t) {
            .Int | .Float | .Bool | .Char | .Str | .Unknown | .NullLit => null,
            // a type parameter through its constraints (S7c5a)
            .Param(_) | .Assoc(_, _, _) => if (this.equatableIndex >= 0
                && this.conformsDirect(t, this.equatableIndex)) null
                else f"{this.tyName(t)} is no Equatable",
            .Optional(inner) => this.notEquatable(inner.value, seen),
            .List(e) => this.notEquatable(e.value, seen),
            .Tuple(tt) => {
                for (e in tt.elements) {
                    let m = this.notEquatable(e, seen);
                    if (m != null) {
                        return m;
                    }
                }
                null
            }
            .Named(i) => {
                let info = this.types[i];
                for (x in seen) {
                    if (x == i) {
                        return null;
                    }
                }
                seen.push(i);
                match (info.kind) {
                    .Class => {
                        return if (this.conformsTo(t, this.identityIndex)
                            || this.saysEquatable(i)) null
                            else f"the class {info.name} is no Identity and no Equatable";
                    }
                    .Interface | .Builtin => {
                        return f"{info.name} values are not compared";
                    }
                    _ => { }
                }
                for (f in info.fields) {
                    let m = this.notEquatable(f.ty, seen);
                    if (m != null) {
                        return f"its field '{f.name}': {m}";
                    }
                }
                for (vf in info.variantFields) {
                    for (f in vf) {
                        let m = this.notEquatable(f.ty, seen);
                        if (m != null) {
                            return f"a payload: {m}";
                        }
                    }
                }
                null
            }
            _ => f"{this.tyName(t)} values are not compared",
        };
    }

    /// `a == b` of two values of `t`, which compares: a tuple element by element, a class by its
    /// reference, a struct or an enum through its synthesized function.
    mut fn sameValue(a: TExpr, b: TExpr, t: Ty, at: Span): TExpr {
        match (t) {
            .Tuple(tt) => {
                let ha = this.hidden(t, at);
                let hb = this.hidden(t, at);
                var all = TExpr.Bool(true);
                var k = tt.elements.length() - 1;
                while (k >= 0) {
                    let et = tt.elements[k];
                    let one = this.equality(
                        TExpr.Elem(boxE(TExpr.Local(ha, t)), k, et),
                        BinaryOp.Eq,
                        TExpr.Elem(boxE(TExpr.Local(hb, t)), k, et),
                        at
                    );
                    all = if (k == tt.elements.length() - 1) one else andOf(one, all);
                    k -= 1;
                }
                return TExpr.Block(
                    [TStmt.SetLocal(ha, a, at.line), TStmt.SetLocal(hb, b, at.line)],
                    boxE(all),
                    Ty.Bool
                );
            }
            .Named(i) => {
                // a type's own `equals(o: Self): bool` is what `==` asks (S7c5a)
                let own = this.methodOf(i, "equals");
                if (own != null
                    && !this.functions[own].isStatic
                    && this.functions[own].params.length() == 1) {
                    // a generic type's, copied for the instance's arguments (S7d2: a map's)
                    if (this.functions[own].typeParams.length() > 0) {
                        return TExpr.CallGeneric(own, this.types[i].args, [a, b], Ty.Bool);
                    }
                    return TExpr.Call(own, [a, b], Ty.Bool);
                }
                if (this.types[i].kind == .Class && !this.saysEquatable(i)) {
                    return TExpr.SameRef(boxE(a), boxE(b));
                }
                return TExpr.Call(this.eqFnOf(i, at), [a, b], Ty.Bool);
            }
            _ => {
                return TExpr.Unknown;
            }
        }
    }

    /// The function comparing two values of struct or enum `i` field by field, made once: an
    /// enum's the same variant with equal payloads (Lyric 5 05 §14 rules 2–3).
    mut fn eqFnOf(i: int, at: Span): int {
        let known = this.eqFns.get(i);
        if (known != null) {
            return known;
        }
        let info = this.types[i];
        let t = Ty.Named(i);
        let index = this.functions.length();
        this.functions.push(
            FnInfo { name = info.name + "#eq", owner = -1, isStatic = true, line = at.line }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        this.eqFns.insert(i, index);
        let eqInfo = this.functions[index];
        eqInfo.params = [
            ParamInfo { name = "a", ty = t, default = null },
            ParamInfo { name = "b", ty = t, default = null },
        ];
        eqInfo.returns = Ty.Bool;
        eqInfo.boxed = [false, false];
        let saved = this.ctx;
        this.ctx = FnCtx.new(index, Ty.Bool, false, false);
        let a = TExpr.Local(0, t);
        let b = TExpr.Local(1, t);
        this.declareLocal("a", t, false, at);
        this.declareLocal("b", t, false, at);
        var body = TExpr.Bool(true);
        if (info.kind == .Struct || info.kind == .Class) {
            var k = info.fields.length() - 1;
            while (k >= 0) {
                let f = info.fields[k];
                let one = this.equality(
                    TExpr.Field(boxE(a), k, f.ty),
                    BinaryOp.Eq,
                    TExpr.Field(boxE(b), k, f.ty),
                    at
                );
                body = if (k == info.fields.length() - 1) one else andOf(one, body);
                k -= 1;
            }
        } else {
            // the same variant, then its payload
            var rest = TExpr.Bool(true);
            var v = info.variants.length() - 1;
            while (v >= 0) {
                let vf = info.variantFields[v];
                var payload = TExpr.Bool(true);
                var k = vf.length() - 1;
                while (k >= 0) {
                    let one = this.equality(
                        TExpr.Payload(boxE(a), i, v, k, vf[k].ty),
                        BinaryOp.Eq,
                        TExpr.Payload(boxE(b), i, v, k, vf[k].ty),
                        at
                    );
                    payload = if (k == vf.length() - 1) one else andOf(one, payload);
                    k -= 1;
                }
                let isV = TExpr.Binary(
                    boxE(TExpr.Tag(boxE(a))),
                    BinaryOp.Eq,
                    boxE(TExpr.Int(v)),
                    Ty.Bool
                );
                rest = TExpr.If(boxE(isV), boxE(payload), boxE(rest), Ty.Bool);
                v -= 1;
            }
            let sameTag = TExpr.Binary(
                boxE(TExpr.Tag(boxE(a))),
                BinaryOp.Eq,
                boxE(TExpr.Tag(boxE(b))),
                Ty.Bool
            );
            body = andOf(sameTag, rest);
        }
        eqInfo.locals = this.ctx.locals.toArray();
        eqInfo.boxed = this.ctx.boxed.toArray();
        eqInfo.body = [TStmt.Return(body, at.line)];
        this.ctx = saved;
        return index;
    }

    /// Two optionals of type `t` are equal where both hold nothing, or both hold values their own
    /// equality finds equal; each is evaluated once, into a local of its own.
    mut fn optionalEquality(a: TExpr, op: BinaryOp, b: TExpr, t: Ty, at: Span): TExpr {
        let inner = match (t) {
            .Optional(i) => i.value,
            _ => Ty.Unknown,
        };
        let ha = this.hidden(t, at);
        let hb = this.hidden(t, at);
        let la = TExpr.Local(ha, t);
        let lb = TExpr.Local(hb, t);
        let values = this.equality(
            TExpr.Narrow(boxE(la), inner),
            BinaryOp.Eq,
            TExpr.Narrow(boxE(lb), inner),
            at
        );
        if (typeOf(values) == .Unknown) {
            return TExpr.Unknown;
        }
        let noneA = TExpr.IsNull(boxE(la));
        let noneB = TExpr.IsNull(boxE(lb));
        let same = TExpr.If(
            boxE(noneA),
            boxE(noneB),
            boxE(TExpr.If(boxE(noneB), boxE(TExpr.Bool(false)), boxE(values), Ty.Bool)),
            Ty.Bool
        );
        let eq = TExpr.Block(
            [TStmt.SetLocal(ha, a, at.line), TStmt.SetLocal(hb, b, at.line)],
            boxE(same),
            Ty.Bool
        );
        return if (op == .Eq) eq else TExpr.Unary(UnaryOp.Not, boxE(eq), Ty.Bool);
    }

    /// `a ?? b`: `a` an optional; `b` its value's type, which the result has, or an optional of
    /// it, which the result has then.
    mut fn coalesce(l: Expr, r: Expr, at: Span): TExpr {
        let a = this.expr(l, null);
        let ta = typeOf(a);
        let before = this.ctx.unassigned;
        return match (ta) {
            .Optional(inner) => {
                let b = this.expr(r, inner.value);
                // the right side may not run: what it assigns does not count
                this.ctx.unassigned = before;
                let plain = this.fit(b, inner.value);
                if (plain != null) {
                    return TExpr.Coalesce(boxE(a), boxE(plain), inner.value);
                }
                let opt = this.fit(b, ta);
                if (opt != null) {
                    return TExpr.Coalesce(boxE(a), boxE(opt), ta);
                }
                if (typeOf(b) != .Unknown) {
                    this.error(
                        "LYS-SEM0001",
                        f"expected {this.tyName(inner.value)}, found {this.tyName(typeOf(b))}",
                        spanOf(r)
                    );
                }
                TExpr.Unknown
            }
            .Unknown => TExpr.Unknown,
            _ => {
                this.error("LYS-SEM0005", "'??' on a value that is never null", at);
                TExpr.Unknown
            }
        };
    }

    /// An enum whose values are `int`s: none of its variants carries a payload.
    mut fn isScalarEnum(t: Ty): bool {
        return match (t) {
            .Named(i) => this.types[i].kind == .Enum && !this.types[i].payload,
            _ => false,
        };
    }

    /// The enum `t` is, or holds as an optional; -1 where it is none.
    mut fn enumOf(t: Ty): int {
        return match (t) {
            .Named(i) => if (this.types[i].kind == .Enum) i else -1,
            .Optional(inner) => this.enumOf(inner.value),
            _ => -1,
        };
    }

    /// The enum the position expects, `?E` naming `E` (Lyric 5 §4.2 rule 1); -1 where none.
    mut fn expectedEnum(expected: ?Ty): int {
        if (expected == null) {
            return -1;
        }
        return this.enumOf(expected);
    }

    mut fn variantIndex(i: int, name: string): int {
        var k = 0;
        for (v in this.types[i].variants) {
            if (v == name) {
                return k;
            }
            k += 1;
        }
        return -1;
    }

    /// `Color.Red`, `.Red`: a unit variant — an `int` where the enum carries no payload, an
    /// object where another variant does.
    mut fn unitVariant(i: int, k: int, at: Span): TExpr {
        let info = this.types[i];
        let v = info.variants[k];
        if (info.variantFields[k].length() > 0) {
            let form = if (info.variantNamed[k]) f"{info.name}.{v} {{ … }}"
                else f"{info.name}.{v}(…)";
            this.error("LYS-SEM0031", f"'{v}' carries a payload: build it as {form}", at);
            return TExpr.Unknown;
        }
        if (info.typeParams.length() > 0 && info.template == i) {
            this.error(
                "LYS-SEM0060",
                f"'{info.variants[k]}' of the generic '{info.name}' takes its type from the position: write it there",
                at
            );
            return TExpr.Unknown;
        }
        return if (info.payload) TExpr.MakeVariant(i, k, []) else TExpr.Variant(i, k);
    }

    /// `Shape.Num(3)`: a variant whose payload is given by position.
    mut fn variantCall(i: int, k: int, args: Arg[], at: Span): TExpr {
        if (this.types[i].typeParams.length() > 0 && this.types[i].template == i) {
            return this.genericVariantCall(i, k, args, at);
        }
        let info = this.types[i];
        let v = info.variants[k];
        let fields = info.variantFields[k];
        if (fields.length() == 0) {
            this.error("LYS-SEM0031", f"'{v}' carries no payload: write {info.name}.{v}", at);
            return TExpr.Unknown;
        }
        if (info.variantNamed[k]) {
            this.error(
                "LYS-SEM0031",
                f"'{v}' has named fields: build it as {info.name}.{v} {{ … }}",
                at
            );
            return TExpr.Unknown;
        }
        if (args.length() != fields.length()) {
            this.error(
                "LYS-SEM0014",
                f"'{v}' carries {fields.length()} values; {args.length()} are given",
                at
            );
            return TExpr.Unknown;
        }
        let values = List<TExpr>.new();
        var j = 0;
        for (a in args) {
            if (a.name != null) {
                this.error("LYS-SEM0119", f"'{v}' takes its payload by position", spanOf(a.value));
            }
            let t = fields[j].ty;
            values.push(this.coerce(this.expr(a.value, t), t, spanOf(a.value)));
            j += 1;
        }
        return TExpr.MakeVariant(i, k, values.toArray());
    }

    /// `Opt.Some(3)`: the instance of the generic enum the payload binds.
    mut fn genericVariantCall(i: int, k: int, args: Arg[], at: Span): TExpr {
        let tmpl = this.types[i];
        let fields = tmpl.variantFields[k];
        if (fields.length() == 0 || tmpl.variantNamed[k] || args.length() != fields.length()) {
            this.error(
                "LYS-SEM0060",
                f"'{tmpl.variants[k]}' of the generic '{tmpl.name}' takes its type from its payload or the position: give them",
                at
            );
            return TExpr.Unknown;
        }
        let binds = List<?Ty>.new();
        for (_ in tmpl.typeParams) {
            binds.push(null);
        }
        let values = List<TExpr>.new();
        var j = 0;
        for (a in args) {
            let v = this.expr(a.value, if (hasParam(fields[j].ty)) null else fields[j].ty);
            this.bind(fields[j].ty, typeOf(v), binds);
            values.push(v);
            j += 1;
        }
        let tys = List<Ty>.new();
        for (b in binds) {
            if (b == null) {
                this.error(
                    "LYS-SEM0060",
                    f"nothing here says all of '{tmpl.name}''s type arguments: write them",
                    at
                );
                return TExpr.Unknown;
            }
            tys.push(b);
        }
        let inst = this.typeInstance(i, tys.toArray());
        this.fillInstance(inst);
        let out = List<TExpr>.new();
        j = 0;
        for (v in values) {
            out.push(this.coerce(v, this.types[inst].variantFields[k][j].ty, at));
            j += 1;
        }
        return TExpr.MakeVariant(inst, k, out.toArray());
    }

    /// `.Red` where the position expects an enum (Lyric 5 §4.2).
    mut fn implicit(name: string, expected: ?Ty, at: Span): TExpr {
        let i = this.expectedEnum(expected);
        if (i < 0) {
            this.error(
                "LYS-SEM0113",
                f"'.{name}' needs an enum where it stands: name it, as E.{name}",
                at
            );
            return TExpr.Unknown;
        }
        let k = this.variantIndex(i, name);
        if (k < 0) {
            this.error("LYS-SEM0012", f"'{this.types[i].name}' has no variant '{name}'", at);
            return TExpr.Unknown;
        }
        return this.unitVariant(i, k, at);
    }

    /// `Shape.Rect { w = 1, h = 2 }` and `.Rect { … }`: a variant with named fields.
    mut fn variantInit(
        enumName: ?string,
        name: string,
        fields: FieldInit[],
        expected: ?Ty,
        at: Span
    ): TExpr {
        var i = -1;
        if (enumName != null) {
            let index = this.typeNamed(enumName, at);
            if (index == null || this.types[index].kind != .Enum) {
                this.error("LYS-SEM0011", f"'{enumName}' names no enum", at);
                return TExpr.Unknown;
            }
            i = index;
        } else {
            i = this.expectedEnum(expected);
            if (i < 0) {
                this.error(
                    "LYS-SEM0113",
                    f"'.{name}' needs an enum where it stands: name it, as E.{name} {{ … }}",
                    at
                );
                return TExpr.Unknown;
            }
        }
        let info = this.types[i];
        let k = this.variantIndex(i, name);
        if (k < 0) {
            this.error("LYS-SEM0012", f"'{info.name}' has no variant '{name}'", at);
            return TExpr.Unknown;
        }
        if (!info.variantNamed[k]) {
            this.error(
                "LYS-SEM0031",
                f"'{name}' has no named fields: write {info.name}.{name}"
                    + (if (info.variantFields[k].length() > 0) "(…)" else ""),
                at
            );
            return TExpr.Unknown;
        }
        let values = this.fieldValues(f"{info.name}.{name}", info.variantFields[k], fields, at);
        return TExpr.MakeVariant(i, k, values);
    }

    mut fn assign(target: Expr, op: ?BinaryOp, value: Expr, at: Span): TExpr {
        let result = this.assignTo(target, op, value, at);
        // an assignment ends a narrowing of the binding (Lyric 5 §3.2 rule 4), and assigns it
        match (target) {
            .Name(name, _) => {
                let local = this.lookupLocal(name);
                if (local != null) {
                    this.unnarrow(local);
                    this.ctx.unassigned = withoutId(this.ctx.unassigned, local);
                }
            }
            _ => { }
        }
        return result;
    }

    mut fn assignTo(target: Expr, op: ?BinaryOp, value: Expr, at: Span): TExpr {
        var place = Place.Local(0);
        var t = Ty.Unknown;
        var current = TExpr.Unknown;
        match (target) {
            .Name(name, nameAt) => {
                let local = this.lookupLocal(name);
                let global = this.globalIndex.get(this.q(name));
                let captured = if (local == null && this.ctx.isLambda) this.capture(
                    this.ctx,
                    name,
                    nameAt
                )
                    else -1;
                if (captured >= 0) {
                    // a captured `var` is written in the box the function around shares
                    let c = this.ctx.captures[captured];
                    if (!c.isCell) {
                        this.error(
                            "LYS-SEM0019",
                            f"'{name}' is a let: declare it with var to write it",
                            nameAt
                        );
                    }
                    place = Place.CapturedCell(captured);
                    t = c.ty;
                    current = TExpr.CapturedCell(captured, t);
                } else if (local != null) {
                    if (!this.ctx.localIsVar[local]) {
                        this.error(
                            "LYS-SEM0019",
                            f"'{name}' is a let: declare it with var to write it",
                            nameAt
                        );
                    }
                    // `x op= v` and `x ??= v` read it first
                    if (op != null && this.ctx.unassigned.contains(local)) {
                        this.error(
                            "LYS-SEM0018",
                            f"'{name}' is read where it may not be assigned yet: assign it on every way to here",
                            nameAt
                        );
                    }
                    place = Place.Local(local);
                    t = this.ctx.locals[local];
                    current = TExpr.Local(local, t);
                } else if (global != null) {
                    if (!this.globals[global].isVar) {
                        this.error(
                            "LYS-SEM0019",
                            f"'{name}' is a let: declare it with var to write it",
                            nameAt
                        );
                    }
                    place = Place.Global(global);
                    t = this.globals[global].ty;
                    current = TExpr.Global(global, t);
                } else {
                    this.name(name, null, nameAt);
                    return TExpr.Unknown;
                }
            }
            .Member(object, field, optional, memberAt) => {
                if (optional) {
                    this.error(
                        "LYS-SEM0019",
                        "nothing is assigned through '?.': narrow first",
                        memberAt
                    );
                    return TExpr.Unknown;
                }
                let o = this.expr(object.value, null);
                match (typeOf(o)) {
                    .Tuple(_) => {
                        this.error(
                            "LYS-SEM0019",
                            "a tuple's elements are never written: build a new tuple",
                            memberAt
                        );
                        return TExpr.Unknown;
                    }
                    _ => { }
                }
                let found = this.fieldOf(o, field, memberAt);
                if (found == null) {
                    return TExpr.Unknown;
                }
                let (owner, index) = found;
                let info = this.types[owner];
                if (info.kind == .Struct) {
                    this.error(
                        "LYS-SEM0019",
                        f"a struct's fields are never written: build a new {info.name}",
                        memberAt
                    );
                } else if (!info.fields[index].isVar) {
                    this.error(
                        "LYS-SEM0019",
                        f"'{field}' is no var field of {info.name}",
                        memberAt
                    );
                }
                place = Place.Field(boxE(o), index);
                t = info.fields[index].ty;
                current = TExpr.Field(boxE(o), index, t);
            }
            .Index(x, i, indexAt) => {
                var lv = this.expr(x.value, null);
                let lt = typeOf(lv);
                match (lt) {
                    .List(e) => {
                        var hold: ?int = null;
                        if (countsFromEnd(i.value)) {
                            let h = this.hidden(lt, indexAt);
                            lv = TExpr.Block(
                                [TStmt.SetLocal(h, lv, indexAt.line)],
                                boxE(TExpr.Local(h, lt)),
                                lt
                            );
                            hold = h;
                        }
                        let iv = this.indexOf(i.value, lt, hold);
                        place = Place.Item(boxE(lv), boxE(iv));
                        t = e.value;
                        current = TExpr.ListOp(ListOp.Get, [lv, iv], t);
                    }
                    .Unknown => {
                        return TExpr.Unknown;
                    }
                    .Map(_, _) => {
                        return this.notYet(
                            f"indexing a {this.tyName(typeOf(lv))}",
                            laterClock(typeOf(lv)),
                            indexAt
                        );
                    }
                    _ => {
                        return this.indexWrite(lv, i.value, op, value, indexAt, at);
                    }
                }
            }
            _ => {
                this.error(
                    "LYS-SEM0019",
                    "this cannot be written: a variable or a field can",
                    spanOf(target)
                );
                return TExpr.Unknown;
            }
        }
        if (op == BinaryOp.Coalesce) {
            // `x ??= v`: v, as an optional of x's type, only where x is absent
            match (t) {
                .Optional(_) => {
                    // the value may not be evaluated: what it assigns does not count
                    let before = this.ctx.unassigned;
                    let v = this.coerce(this.expr(value, t), t, spanOf(value));
                    this.ctx.unassigned = before;
                    return TExpr.Assign(place, op, boxE(v), t);
                }
                .Unknown => {
                    this.fixFrom(current, typeOf(this.expr(value, null)));
                    return TExpr.Unknown;
                }
                _ => {
                    this.error("LYS-SEM0005", "'??=' on a value that is never null", at);
                    return TExpr.Unknown;
                }
            }
        }
        if (let o = op) {
            // a type of the program: `x = x op v` through its operator's interface, what leads
            // to the place held once (S7c5c2)
            if (!this.nativeOperand(t) && operatorOf(o).0 != "") {
                return this.operatorAssign(place, current, o, this.expr(value, null), t, at);
            }
        }
        if (op != null) {
            // `x op= v` is `x = x op v`, with the place evaluated once
            let combined = this.binaryChecked(current, op, this.expr(value, t), at);
            return TExpr.Assign(place, op, boxE(this.coerceOperand(combined, t, at)), t);
        }
        let v = this.coerce(this.expr(value, t), t, spanOf(value));
        this.fixFrom(current, typeOf(v));
        return TExpr.Assign(place, null, boxE(v), t);
    }

    /// The right side of `x op= v` as the operation gives it: only its value's type is kept, the
    /// generator applies `op` to the place it reads once.
    /// `x op= v` of a type of the program (Lyric 5 05 §12 rule 4; S7c5c2): `x = x op v` — the
    /// receiver of a field, a list and its index held once —, `op`'s `Out` the place's type.
    mut fn operatorAssign(
        place: Place,
        current: TExpr,
        op: BinaryOp,
        v: TExpr,
        t: Ty,
        at: Span
    ): TExpr {
        let held = List<TStmt>.new();
        var where = place;
        var now = current;
        match (place) {
            .Field(o, k) => {
                let h = this.hidden(typeOf(o.value), at);
                held.push(TStmt.SetLocal(h, o.value, at.line));
                let ho = TExpr.Local(h, typeOf(o.value));
                where = Place.Field(boxE(ho), k);
                now = TExpr.Field(boxE(ho), k, t);
            }
            .Item(l, i) => {
                let hl = this.hidden(typeOf(l.value), at);
                let hi = this.hidden(Ty.Int, at);
                held.push(TStmt.SetLocal(hl, l.value, at.line));
                held.push(TStmt.SetLocal(hi, i.value, at.line));
                let lv = TExpr.Local(hl, typeOf(l.value));
                let iv = TExpr.Local(hi, Ty.Int);
                where = Place.Item(boxE(lv), boxE(iv));
                now = TExpr.ListOp(ListOp.Get, [lv, iv], t);
            }
            _ => { }
        }
        let combined = this.operatorCall(now, op, v, at);
        if (combined == null) {
            this.error(
                "LYS-SEM0003",
                f"'{binaryText(op)}=' does not take {this.tyName(t)} and {this.tyName(typeOf(v))}: {this.tyName(t)} is no {operatorOf(op).0}<{this.tyName(typeOf(v))}>",
                at
            );
            return TExpr.Unknown;
        }
        let result = combined;
        let rt = typeOf(result);
        if (rt != t && rt != .Unknown && !this.anyParamIn(rt)) {
            this.error(
                "LYS-SEM0001",
                f"'{binaryText(op)}=' gives a {this.tyName(rt)}, the place holds a {this.tyName(t)}",
                at
            );
            return TExpr.Unknown;
        }
        let assign = TExpr.Assign(where, null, boxE(this.coerce(result, t, at)), t);
        return if (held.length() == 0) assign else TExpr.Block(held.toArray(), boxE(assign), t);
    }

    mut fn binaryChecked(current: TExpr, op: BinaryOp, v: TExpr, at: Span): TExpr {
        let tc = typeOf(current);
        let tv = typeOf(v);
        if (tc == .Unknown || tv == .Unknown) {
            return TExpr.Unknown;
        }
        let numeric = (tc == .Int || tc == .Float) && (tv == .Int || tv == .Float);
        let fits = match (op) {
            .Add => numeric || (tc == .Str && tv == .Str),
            .Sub | .Mul | .Div | .Rem => numeric,
            .AddWrap | .SubWrap | .MulWrap | .Shl | .Shr | .BitAnd | .BitOr | .BitXor => tc == .Int
                && tv == .Int,
            .And | .Or => tc == .Bool && tv == .Bool,
            _ => false,
        };
        if (!fits) {
            this.error(
                "LYS-SEM0003",
                f"'{binaryText(op)}=' does not take {this.tyName(tc)} and {this.tyName(tv)}",
                at
            );
            return TExpr.Unknown;
        }
        if (tc == .Int && tv == .Float) {
            this.error(
                "LYS-SEM0001",
                f"expected int, found float: '{binaryText(op)}=' keeps the type of its target",
                at
            );
            return TExpr.Unknown;
        }
        return v;
    }

    mut fn coerceOperand(v: TExpr, t: Ty, at: Span): TExpr {
        return this.coerce(v, t, at);
    }

    mut fn cast(x: Expr, written: TypeExpr, at: Span): TExpr {
        let v = this.expr(x, null);
        let from = typeOf(v);
        let to = this.resolveType(written);
        if (from == .Unknown || to == .Unknown) {
            return TExpr.Unknown;
        }
        let scalar = (from == .Int || from == .Float || from == .Char)
            && (to == .Int || to == .Float || to == .Char);
        if (!scalar || (from == .Float && to == .Char) || (from == .Char && to == .Float)) {
            this.error(
                "LYS-SEM0006",
                f"'as' converts between int, float and char: not {this.tyName(from)} to {this.tyName(to)}",
                at
            );
            return TExpr.Unknown;
        }
        return TExpr.Cast(boxE(v), to);
    }

    /// The type and index of a struct's or class's field, reported when it has none.
    mut fn fieldOf(o: TExpr, field: string, at: Span): ?(int, int) {
        let t = typeOf(o);
        match (t) {
            .Unknown => {
                return null;
            }
            .Named(i) => {
                var k = 0;
                for (f in this.types[i].fields) {
                    if (f.name == field) {
                        this.mayName(i, field, at);
                        return (i, k);
                    }
                    k += 1;
                }
                this.error("LYS-SEM0012", f"'{this.types[i].name}' has no field '{field}'", at);
                return null;
            }
            // a list has methods and no fields
            .List(_) => {
                this.error("LYS-SEM0012", f"'{this.tyName(t)}' has no field '{field}'", at);
                return null;
            }
            // a string has methods and no fields (S7e1)
            .Str => {
                this.error("LYS-SEM0012", f"'{this.tyName(t)}' has no field '{field}'", at);
                return null;
            }
            .Map(_, _) => {
                this.notYet(f"the members of {this.tyName(t)}", laterClock(t), at);
                return null;
            }
            _ => { }
        }
        this.error("LYS-SEM0012", f"{this.tyName(t)} has no field '{field}'", at);
        return null;
    }

    /// The value of `x?.…` in a local of its own: its type, and what it holds where it is there;
    /// reported where `x` is never null.
    mut fn optionalReceiver(x: Expr, at: Span): ?(TExpr, int, Ty) {
        let o = this.expr(x, null);
        let ot = typeOf(o);
        return match (ot) {
            .Optional(inner) => (o, this.hidden(ot, at), inner.value),
            .Unknown => null,
            _ => {
                this.error("LYS-SEM0005", "'?.' on a value that is never null", at);
                null
            }
        };
    }

    /// `x?.m` with `x` held in local `tmp`: null where `x` is, else the member, as an optional —
    /// one level only where the member is an optional itself (03 O: `?.` flattens).
    mut fn optChain(tmp: int, value: TExpr, access: TExpr, at: Span): TExpr {
        let ot = typeOf(value);
        let mt = typeOf(access);
        let absent = TExpr.IsNull(boxE(TExpr.Local(tmp, ot)));
        let store = [TStmt.SetLocal(tmp, value, at.line)];
        return match (mt) {
            .Void => TExpr.Block(
                store,
                boxE(TExpr.If(boxE(absent), boxE(TExpr.Unit), boxE(access), Ty.Void)),
                Ty.Void
            ),
            .Unknown => TExpr.Unknown,
            .Optional(_) => TExpr.Block(
                store,
                boxE(TExpr.If(boxE(absent), boxE(TExpr.Null(mt)), boxE(access), mt)),
                mt
            ),
            _ => {
                let rt = Ty.Optional(boxTy(mt));
                TExpr.Block(
                    store,
                    boxE(
                        TExpr.If(
                            boxE(absent),
                            boxE(TExpr.Null(rt)),
                            boxE(TExpr.Wrap(boxE(access), rt)),
                            rt
                        )
                    ),
                    rt
                )
            }
        };
    }

    mut fn member(x: Expr, name: string, optional: bool, at: Span): TExpr {
        let want = this.memberExpected;
        this.memberExpected = null;
        if (optional) {
            let held = this.optionalReceiver(x, at);
            if (held == null) {
                return TExpr.Unknown;
            }
            let (o, tmp, inner) = held;
            let present = TExpr.Narrow(boxE(TExpr.Local(tmp, typeOf(o))), inner);
            match (inner) {
                .Tuple(tt) => {
                    return this.optChain(tmp, o, this.element(present, tt, name, at), at);
                }
                _ => { }
            }
            let found = this.fieldOf(present, name, at);
            if (found == null) {
                return TExpr.Unknown;
            }
            let (owner, index) = found;
            let access = TExpr.Field(boxE(present), index, this.types[owner].fields[index].ty);
            return this.optChain(tmp, o, access, at);
        }
        // `Color.Red`: a variant of an enum; `P.zero`, `T.zero`: a constant (05 §7 rule 2)
        match (x) {
            .Name(typeName, _) => {
                // `util.LIMIT`: a module's binding through its name
                if (this.lookupLocal(typeName) == null
                    && !this.globalIndex.containsKey(this.q(typeName))) {
                    if (let target = this.moduleNamed(typeName)) {
                        let g = this.globalIndex.get(this.exportKey(target, name));
                        if (g != null) {
                            return TExpr.Global(g, this.globals[g].ty);
                        }
                        this.error(
                            "LYS-RES0004",
                            f"the module '{typeName}' declares no binding '{name}'",
                            at
                        );
                        return TExpr.Unknown;
                    }
                }
                if (this.lookupLocal(typeName) == null
                    && !this.globalIndex.containsKey(this.q(typeName))) {
                    let pk = this.typeParams.get(typeName);
                    if (pk != null) {
                        return this.paramStatic(pk, name, [], at);
                    }
                    var index = this.typeIndex.get(this.q(typeName));
                    if (typeName == "Self") {
                        let s = this.selfTyIs;
                        if (s != null) {
                            let si = this.entryOf(s);
                            if (si >= 0) {
                                index = si;
                            }
                        }
                    }
                    if (index != null) {
                        return this.typeMember(index, typeName, name, at);
                    }
                }
            }
            // `util.Shape.Dot`, `util.Point.origin`: a member of a module's type
            .Member(inner, typeName, false, _) => {
                let index = this.moduleType(inner.value, typeName, at);
                if (index >= 0) {
                    return this.typeMember(index, typeName, name, at);
                }
                if (index == -2) {
                    return TExpr.Unknown;
                }
            }
            _ => { }
        }
        let o = this.expr(x, null);
        match (typeOf(o)) {
            .Tuple(tt) => {
                return this.element(o, tt, name, at);
            }
            // a method without a call: bound to the object (§8.4 rule 2); of several of the name,
            // the one the position's function type says (S7c5d2)
            .Named(i) => {
                let picked = this.pickBound(i, name, want, at);
                if ((picked ?? 0) < 0) {
                    return TExpr.Unknown;
                }
                let m = picked ?? this.methodOf(i, name);
                if (m != null && !this.functions[m].isStatic) {
                    return this.boundMethod(o, m, at);
                }
            }
            _ => { }
        }
        let found = this.fieldOf(o, name, at);
        if (found == null) {
            return TExpr.Unknown;
        }
        let (owner, index) = found;
        return TExpr.Field(boxE(o), index, this.types[owner].fields[index].ty);
    }

    /// `spawn { … }` (07 N4): a task of the block, a closure of no parameter; its type `Task<T>`,
    /// `T` the block's.
    mut fn spawnOf(args: Arg[], at: Span): TExpr {
        if (args.length() != 1) {
            this.error("LYS-SEM0014", "spawn takes one block: spawn { … }", at);
            return TExpr.Unknown;
        }
        let want = Ty.Fn(FnTy { params = [], result = boxTy(Ty.Unknown) });
        // a lambda of parameters is reported by the lambda; a function value is not
        let reported = this.errors.length();
        let closure = this.expr(args[0].value, want);
        let given = typeOf(closure);
        let result = match (given) {
            .Fn(ft) => {
                if (ft.params.length() > 0) {
                    if (this.errors.length() == reported) {
                        this.error(
                            "LYS-SEM0001",
                            f"expected a block of no parameter, found {this.tyName(given)}",
                            at
                        );
                    }
                    Ty.Unknown
                } else {
                    ft.result.value
                }
            }
            // reported where it arose
            .Unknown => Ty.Unknown,
            _ => {
                this.error("LYS-SEM0001", f"expected a block, found {this.tyName(given)}", at);
                Ty.Unknown
            }
        };
        let task = this.typeIndex.get("Task");
        if (task == null || result == .Unknown) {
            return TExpr.Unknown;
        }
        return TExpr.Spawn(boxE(closure), Ty.Named(this.typeInstance(task, [result])));
    }

    /// A coroutine of `body` — a generator lambda's, `sequence { … }`'s (Lyric 5 10 §1 rules
    /// 11–12): the body a closure of no parameter over the captures, its `Y` and `R` as given, or
    /// inferred from its yields and returns — by a quiet first pass, so that every yield and
    /// return of the second meets the types they unify into (`LYS-SEM0016`).
    mut fn generatorOf(body: Expr, y: ?Ty, r: ?Ty, pathCode: string, at: Span): TExpr {
        var startY = y ?? Ty.Unknown;
        var startR = r ?? Ty.Unknown;
        if (y == null || r == null) {
            let made = this.functions.length();
            this.pendingBody = GenBody {
                y = startY,
                inferY = y == null,
                r = startR,
                inferR = r == null,
                quiet = true,
                pathCode = pathCode,
            };
            this.makeLambda("<coroutine>", [], [], r, body, at);
            this.dropFunctionsFrom(made);
            startY = this.lastYields;
            startR = this.lastReturns;
        }
        this.pendingBody = GenBody {
            y = startY,
            inferY = y == null,
            r = startR,
            inferR = r == null,
            quiet = false,
            pathCode = pathCode,
        };
        let inner = this.makeLambda("<coroutine>", [], [], r, body, at);
        let co = this.typeIndex.get("Coroutine");
        if (co == null) {
            return TExpr.Unknown;
        }
        let fy = if (this.lastYields == .Unknown) Ty.Void else this.lastYields;
        let fr = if (this.lastReturns == .Unknown) Ty.Void else this.lastReturns;
        return TExpr.CoNew(boxE(inner), Ty.Named(this.typeInstance(co, [fy, fr])));
    }

    /// `sequence { … }` (Lyric 5 10 §1 rule 12): a coroutine of a block that yields, its `Y` the
    /// place's or the yields', its result none.
    mut fn sequenceOf(args: Arg[], expected: ?Ty, at: Span): TExpr {
        if (args.length() != 1) {
            this.error("LYS-SEM0014", "sequence takes one block: sequence { … }", at);
            return TExpr.Unknown;
        }
        match (args[0].value) {
            .Lambda(params, _, body, _, _) => {
                var yields = false;
                match (body.value) {
                    .Block(b, _) => {
                        yields = hasOwnYield(b);
                    }
                    _ => { }
                }
                if (params.length() == 0 && yields) {
                    let co = this.coroutineArgs(expected ?? Ty.Unknown);
                    let y: ?Ty = if (co.length() == 2) co[0] else null;
                    return this.generatorOf(body.value, y, Ty.Void, "LYS-SEM0046", at);
                }
            }
            _ => { }
        }
        this.error("LYS-SEM0001", "sequence takes a block that yields: sequence { yield … }", at);
        return TExpr.Unknown;
    }

    /// The prelude's `Cancelled`, what a yield throws where its coroutine is closed (S6b3).
    fn cancelledTy(): Ty {
        let c = this.typeIndex.get("Cancelled");
        return if (c != null) Ty.Named(c) else Ty.Unknown;
    }

    /// Whether `t` is a task's or a coroutine's type: the VM holds them without a descriptor, so
    /// they are no interface values (S6b3; their descriptors come with the collections, S7).
    fn heldWithoutDescriptor(t: Ty): bool {
        match (t) {
            .Named(i) => {
                let tpl = this.types[i].template;
                let task = this.typeIndex.get("Task") ?? -1;
                let co = this.typeIndex.get("Coroutine") ?? -1;
                let scope = this.typeIndex.get("TaskScope") ?? -1;
                let channel = this.typeIndex.get("Channel") ?? -1;
                let semaphore = this.typeIndex.get("Semaphore") ?? -1;
                return (tpl >= 0 && (tpl == task || tpl == co || tpl == channel))
                    || i == task
                    || i == co
                    || i == scope
                    || i == channel
                    || i == semaphore;
            }
            _ => { }
        }
        return false;
    }

    /// The yield and the result type of a `Coroutine<Y, R>`, `[Y, R]`; none for another type (S6b).
    fn coroutineArgs(t: Ty): Ty[] {
        let co = this.typeIndex.get("Coroutine") ?? -1;
        match (t) {
            .Named(i) => {
                if (co >= 0 && this.types[i].template == co && this.types[i].args.length() == 2) {
                    return this.types[i].args;
                }
            }
            _ => { }
        }
        return [];
    }

    /// A method of a `Coroutine<Y, R>` (Lyric 5 10 §1 rules 4–5): `next()`, `?Y` — `bool` for
    /// a `Coroutine<void>` —, `result()`, `?R`, `isDone()`; `null` where `i` is no coroutine's type.
    mut fn coroutineMethod(receiver: TExpr, i: int, method: string, args: Arg[], at: Span): ?TExpr {
        let yr = this.coroutineArgs(Ty.Named(i));
        if (yr.length() != 2) {
            return null;
        }
        // its others are its prelude class's and its interfaces' — `collect()` (S7c4c2)
        if (method != "next" && method != "result" && method != "isDone" && method != "close") {
            return null;
        }
        if (args.length() > 0) {
            this.error("LYS-SEM0014", f"'{method}' takes no argument", at);
        }
        let y = yr[0];
        let r = yr[1];
        return match (method) {
            "next" => TExpr.CoNext(
                boxE(receiver),
                if (y == .Void) Ty.Bool else Ty.Optional(boxTy(y))
            ),
            "result" => {
                if (r == .Void) {
                    this.error(
                        "LYS-SEM0012",
                        "a coroutine that returns nothing has no 'result()': a Coroutine<Y, R> has",
                        at
                    );
                    TExpr.Unknown
                } else {
                    TExpr.CoResult(boxE(receiver), Ty.Optional(boxTy(r)))
                }
            }
            "isDone" => TExpr.CoDone(boxE(receiver)),
            // its `Cancelled` made here, for the yield it parked at to throw (rule 9)
            "close" => TExpr.CoClose(
                boxE(receiver),
                boxE(this.expr(Expr.StructInit("Cancelled", [], [], at), null))
            ),
            _ => {
                this.error(
                    "LYS-SEM0012",
                    f"a coroutine has no method '{method}': next, result, isDone",
                    at
                );
                TExpr.Unknown
            }
        };
    }

    /// `spawnDetached { … }` (Lyric 5 10 §2 rule 3): a task nobody waits for — the top level's end
    /// neither —, whose block may throw `Cancelled` alone: any other error it handles itself, as
    /// if it had written `throws Cancelled` (`LYS-SEM0034`).
    mut fn spawnDetachedOf(args: Arg[], at: Span): TExpr {
        if (args.length() != 1) {
            this.error("LYS-SEM0014", "spawnDetached takes one block: spawnDetached { … }", at);
            return TExpr.Unknown;
        }
        let want = Ty.Fn(FnTy { params = [], result = boxTy(Ty.Void) });
        let closure = this.expr(args[0].value, want);
        match (closure) {
            .Closure(index, _, _) => {
                this.functions[index].throws = [this.cancelledTy()];
                this.throwsAt.insert(index, at);
            }
            _ => {
                if (typeOf(closure) != .Unknown) {
                    this.error(
                        "LYS-SEM0001",
                        f"expected a block, found {this.tyName(typeOf(closure))}",
                        at
                    );
                }
                return TExpr.Unknown;
            }
        }
        return TExpr.SpawnDetached(boxE(closure));
    }

    /// `t.status()` (Lyric 5 10 §2 rule 11): where the task stands, without a wait — a
    /// `TaskStatus<T>`: `Running`, `Done` with its value, `Failed` with its error, `Cancelled`, or
    /// `Panicked` with its panic's `PanicInfo` (S6c3). The VM numbers the states 0 running, 1 done,
    /// 2 failed, 3 panicked, 4 cancelled.
    mut fn statusOf(receiver: TExpr, value: Ty, at: Span): TExpr {
        let tsi = this.typeIndex.get("TaskStatus");
        let pii = this.typeIndex.get("PanicInfo");
        if (tsi == null || pii == null) {
            return TExpr.Unknown;
        }
        let st = this.typeInstance(tsi, [value]);
        let stTy = Ty.Named(st);
        let taskTy = typeOf(receiver);
        let id = this.hidden(taskTy, at);
        let task = TExpr.Local(id, taskTy);
        let stateId = this.hidden(Ty.Int, at);
        let state = TExpr.Local(stateId, Ty.Int);
        let panic = TExpr.New(
            pii,
            [
                TExpr.PanicText(boxE(task), 0),
                TExpr.PanicText(boxE(task), 1),
                TExpr.PanicText(boxE(task), 2),
            ]
        );
        var chain = TExpr.MakeVariant(st, 4, [panic]);
        chain = TExpr.If(
            boxE(isState(state, 4)),
            boxE(TExpr.MakeVariant(st, 3, [])),
            boxE(chain),
            stTy
        );
        chain = TExpr.If(
            boxE(isState(state, 2)),
            boxE(TExpr.MakeVariant(st, 2, [TExpr.TaskError(boxE(task), this.errorTy())])),
            boxE(chain),
            stTy
        );
        chain = TExpr.If(
            boxE(isState(state, 1)),
            boxE(TExpr.MakeVariant(st, 1, [TExpr.TaskValue(boxE(task), value)])),
            boxE(chain),
            stTy
        );
        chain = TExpr.If(
            boxE(isState(state, 0)),
            boxE(TExpr.MakeVariant(st, 0, [])),
            boxE(chain),
            stTy
        );
        return TExpr.Block(
            [
                TStmt.SetLocal(id, receiver, at.line),
                TStmt.SetLocal(stateId, TExpr.TaskStatus(boxE(task), Ty.Int), at.line),
            ],
            boxE(chain),
            stTy
        );
    }

    /// An intrinsic of the prelude's source (S6d2): `__chanReady(c)`, `__chanWatch(c)`,
    /// `__parkWatched()`.
    /// `[a, b, c]` (S7b1; 03 S): a list of the type the place gives, else of its elements' — an int
    /// among floats is a float (03 Mix); `[]` takes its type from the place.
    mut fn listLiteral(items: Expr[], expected: ?Ty, at: Span): TExpr {
        if (let want = expected) {
            if (let built = this.arrayLiteralBuilt(items, want, at)) {
                return built;
            }
        }
        var elem: ?Ty = null;
        if (let want = expected) {
            match (want) {
                .List(e) => {
                    elem = e.value;
                }
                _ => { }
            }
        }
        let xs = List<TExpr>.new();
        if (let e = elem) {
            for (item in items) {
                xs.push(this.coerce(this.expr(item, e), e, spanOf(item)));
            }
            return TExpr.ListOp(ListOp.Lit, xs.toArray(), Ty.List(boxTy(e)));
        }
        // nothing gives the element type: the binding's first use would, elsewhere it is written
        // (Lyric 5 §9.2 rule 3, 03 Leer)
        if (items.length() == 0) {
            this.error(
                "LYS-SEM0060",
                "nothing here says what the empty list holds: write its type, `let xs: int[] = []`",
                at
            );
            return TExpr.Unknown;
        }
        let checked = List<TExpr>.new();
        for (item in items) {
            checked.push(this.expr(item, null));
        }
        var t = typeOf(checked[0]);
        for (x in checked) {
            if (t == .Int && typeOf(x) == .Float) {
                t = Ty.Float;
            }
        }
        var k = 0;
        for (x in checked) {
            xs.push(this.coerce(x, t, spanOf(items[k])));
            k += 1;
        }
        return TExpr.ListOp(ListOp.Lit, xs.toArray(), Ty.List(boxTy(t)));
    }

    /// `xs[i]` (S7b1; 03 Index): the element at an `int` index; outside the list a panic
    /// (`LYS-RT0003`).
    mut fn indexRead(x: Expr, i: Expr, at: Span): TExpr {
        var lv = this.expr(x, null);
        let t = typeOf(lv);
        match (t) {
            .List(e) => {
                // `^n` reads the length: the list held once, the place where it is read
                var hold: ?int = null;
                if (countsFromEnd(i)) {
                    let h = this.hidden(t, at);
                    lv = TExpr.Block([TStmt.SetLocal(h, lv, at.line)], boxE(TExpr.Local(h, t)), t);
                    hold = h;
                }
                match (i) {
                    .Range(from, to, inclusive, _) => {
                        // a slice is a new list (03 S)
                        let a = this.indexOf(from.value, t, hold);
                        let b = this.indexOf(to.value, t, hold);
                        let end = if (inclusive) TExpr.Binary(
                            boxE(b),
                            BinaryOp.Add,
                            boxE(TExpr.Int(1)),
                            Ty.Int
                        )
                            else b;
                        return this.listCall("__listSlice", e.value, [lv, a, end], t);
                    }
                    _ => { }
                }
                let iv = this.indexOf(i, t, hold);
                return TExpr.ListOp(ListOp.Get, [lv, iv], e.value);
            }
            .Unknown => {
                return TExpr.Unknown;
            }
            .Str => {
                return this.stringIndex(lv, i, at);
            }
            .Map(_, _) => {
                return this.notYet(f"indexing a {this.tyName(t)}", "S7 (the core collections)", at);
            }
            _ => {
                // a type of one's own (03 Index, S7c2): `x[k]` is `x.index(k)`
                if (!this.indexable(t, "Index", at)) {
                    return TExpr.Unknown;
                }
                if (countsFromEnd(i)) {
                    this.error("LYS-SEM0007", "'^' counts from the end of a list alone", at);
                    return TExpr.Unknown;
                }
                return this.methodCall(lv, "index", [Arg { name = null, value = i }], at, at);
            }
        }
    }

    /// `s[i]` and `s[a..b]` of a string (Lyric 5 12 §Strings rules 2–3; S7e1): the character that
    /// begins at byte `i`, through the prelude's `string :: Index<int>`; a new string of the bytes
    /// from `a` to `b` (03 Str), its bounds `^n` too — the string held once. `^n` alone is no index
    /// of a string: a byte counted from the end is rarely where a character begins.
    mut fn stringIndex(s: TExpr, i: Expr, at: Span): TExpr {
        match (i) {
            .Range(from, to, inclusive, _) => {
                var lv = s;
                var hold: ?int = null;
                if (countsFromEnd(i)) {
                    let h = this.hidden(Ty.Str, at);
                    lv = TExpr.Block(
                        [TStmt.SetLocal(h, s, at.line)],
                        boxE(TExpr.Local(h, Ty.Str)),
                        Ty.Str
                    );
                    hold = h;
                }
                let a = this.stringBound(from.value, hold);
                let b = this.stringBound(to.value, hold);
                let end = if (inclusive) TExpr.Binary(
                    boxE(b),
                    BinaryOp.Add,
                    boxE(TExpr.Int(1)),
                    Ty.Int
                )
                    else b;
                return this.preludeCall("__strSlice", [lv, a, end], Ty.Str);
            }
            .FromEnd(_, fromAt) => {
                this.error(
                    "LYS-SEM0114",
                    "'^n' counts from the end of a string in a range alone: a byte from the end is rarely where a character begins",
                    fromAt
                );
                return TExpr.Unknown;
            }
            _ => { }
        }
        return this.methodCall(s, "index", [Arg { name = null, value = i }], at, at);
    }

    /// A bound of a string's slice: an `int`, or `^n`, the string's length in bytes less `n`.
    mut fn stringBound(i: Expr, hold: ?int): TExpr {
        match (i) {
            .FromEnd(n, _) => {
                let k = this.coerce(this.expr(n.value, Ty.Int), Ty.Int, spanOf(n.value));
                let len = this.preludeCall("__strLen", [TExpr.Local(hold ?? 0, Ty.Str)], Ty.Int);
                return TExpr.Binary(boxE(len), BinaryOp.Sub, boxE(k), Ty.Int);
            }
            _ => { }
        }
        return this.coerce(this.expr(i, Ty.Int), Ty.Int, spanOf(i));
    }

    /// A call of the prelude's function `name`, one of its own (S7e1).
    mut fn preludeCall(name: string, args: TExpr[], returns: Ty): TExpr {
        var fi = -1;
        if (let fs = this.fnByName.get(name)) {
            if (fs.length() > 0) {
                fi = fs[0];
            }
        }
        return TExpr.Call(fi, args, returns);
    }

    /// An index of a list: an `int`, or `^n`, the list's length less `n` — the list in hidden
    /// local `hold`, which the place set before (S7b2b).
    mut fn indexOf(i: Expr, t: Ty, hold: ?int): TExpr {
        match (i) {
            .FromEnd(n, _) => {
                let k = this.coerce(this.expr(n.value, Ty.Int), Ty.Int, spanOf(n.value));
                let len = TExpr.ListOp(ListOp.Len, [TExpr.Local(hold ?? 0, t)], Ty.Int);
                return TExpr.Binary(boxE(len), BinaryOp.Sub, boxE(k), Ty.Int);
            }
            _ => { }
        }
        return this.coerce(this.expr(i, Ty.Int), Ty.Int, spanOf(i));
    }

    /// Whether a value of `t` takes `[k]` through the prelude's `proto` (`Index`, `IndexSet`),
    /// reported where it does not (`LYS-SEM0007`, `LYS-SEM0019`; S7c2).
    mut fn indexable(t: Ty, proto: string, at: Span): bool {
        if (t == .Unknown) {
            return false;
        }
        let pi = this.typeIndex.get(proto) ?? -1;
        if (pi >= 0 && this.conformsTo(t, pi)) {
            return true;
        }
        if (proto == "Index") {
            this.error("LYS-SEM0007", f"'{this.tyName(t)}' cannot be indexed: it is no Index", at);
        } else {
            this.error(
                "LYS-SEM0019",
                f"an element of '{this.tyName(t)}' cannot be written: it is no IndexSet",
                at
            );
        }
        return false;
    }

    /// `x[k] = v` and `x[k] op= v` of a type of one's own (S7c2): `x.setIndex(k, v)`, `x` and `k`
    /// evaluated once — held in hidden locals, the read and the write through them.
    mut fn indexWrite(
        lv: TExpr,
        k: Expr,
        op: ?BinaryOp,
        value: Expr,
        indexAt: Span,
        at: Span
    ): TExpr {
        let t = typeOf(lv);
        if (!this.indexable(t, "IndexSet", indexAt)) {
            return TExpr.Unknown;
        }
        if (countsFromEnd(k)) {
            this.error("LYS-SEM0007", "'^' counts from the end of a list alone", indexAt);
            return TExpr.Unknown;
        }
        let kv = this.expr(k, null);
        let hx = this.hidden(t, at);
        let hk = this.hidden(typeOf(kv), at);
        let x = Expr.Name(this.ctx.localNames[hx], at);
        let key = Expr.Name(this.ctx.localNames[hk], at);
        var v = value;
        if (let o = op) {
            let read = Expr.Call(
                Box<Expr> { value = Expr.Member(Box<Expr> { value = x }, "index", false, at) },
                [Arg { name = null, value = key }],
                at
            );
            v = Expr.Binary(Box<Expr> { value = read }, o, Box<Expr> { value = value }, at);
        }
        let write = this.methodCall(
            TExpr.Local(hx, t),
            "setIndex",
            [Arg { name = null, value = key }, Arg { name = null, value = v }],
            at,
            indexAt
        );
        return TExpr.Block(
            [TStmt.SetLocal(hx, lv, at.line), TStmt.SetLocal(hk, kv, at.line)],
            boxE(write),
            Ty.Void
        );
    }

    /// The instance of the prelude's generic interface `proto` that `t` conforms to — through its
    /// type's conformances, or its constraints' — -1 for none (S7c2).
    mut fn instanceFor(t: Ty, proto: string): int {
        let pi = this.typeIndex.get(proto) ?? -1;
        if (pi < 0) {
            return -1;
        }
        let kinds = List<int>.new();
        match (t) {
            .Named(i) => {
                if (this.types[i].kind != .Interface) {
                    for (x in this.ifacesOf(i)) {
                        for (a in this.ancestry(x)) {
                            kinds.push(a);
                        }
                    }
                }
            }
            .Param(k) => {
                let g = this.genericFn;
                if (g >= 0 && k < this.functions[g].typeParams.length()) {
                    for (c in this.functions[g].typeParams[k].constraints) {
                        for (a in this.ancestry(c)) {
                            kinds.push(a);
                        }
                    }
                }
            }
            _ => { }
        }
        for (x in kinds) {
            if (this.ifaceBase(x) == pi && x != pi) {
                return x;
            }
        }
        return -1;
    }

    /// `["a": 1, "b": 2]` and `[:]` (Script 02 K4, 03 Lit; S7d2): the entries, each a key and a
    /// value, given to `fromMapLiteral` of the place's type where it is a `FromMapLiteral<K, V>`,
    /// else of a `Map` of the first entry's types.
    mut fn mapLiteral(entries: MapEntry[], expected: ?Ty, at: Span): TExpr {
        var target: ?Ty = null;
        if (let e = expected) {
            target = match (e) {
                .Optional(inner) => inner.value,
                _ => e,
            };
        }
        var fi = -1;
        if (let t = target) {
            fi = this.instanceFor(t, "FromMapLiteral");
        }
        var k = Ty.Unknown;
        var v = Ty.Unknown;
        if (fi >= 0) {
            k = this.types[fi].args[0];
            v = this.types[fi].args[1];
        } else if (entries.length() > 0) {
            k = typeOf(this.expr(entries[0].key, null));
            v = typeOf(this.expr(entries[0].value, null));
        }
        let mi = this.typeIndex.get("Map") ?? -1;
        if (fi < 0 && (mi < 0 || entries.length() == 0)) {
            if (entries.length() == 0) {
                this.error(
                    "LYS-SEM0060",
                    "nothing here says what the empty map holds: write its type, `let m: Map<string, int> = [:]`",
                    at
                );
            }
            return TExpr.Unknown;
        }
        let pair = Ty.Tuple(TupleTy { elements = [k, v], labels = ["", ""] });
        let items = List<TExpr>.new();
        for (e in entries) {
            let key = this.coerce(this.expr(e.key, k), k, spanOf(e.key));
            let value = this.coerce(this.expr(e.value, v), v, spanOf(e.value));
            items.push(TExpr.Tuple([key, value], pair));
        }
        let list = TExpr.ListOp(ListOp.Lit, items.toArray(), Ty.List(boxTy(pair)));
        let made = if (fi >= 0) target ?? Ty.Unknown else Ty.Named(this.typeInstance(mi, [k, v]));
        match (made) {
            .Named(i) => {
                let tmpl = if (this.types[i].template >= 0) this.types[i].template else i;
                if (let own = this.types[tmpl].methods.get("fromMapLiteral")) {
                    if (this.functions[own].typeParams.length() > 0) {
                        return TExpr.CallGeneric(own, this.types[i].args, [list], made);
                    }
                    return TExpr.Call(own, [list], made);
                }
            }
            _ => { }
        }
        return TExpr.Unknown;
    }

    /// `[a, b]` where the place's type conforms to `FromArrayLiteral<T>` (03 Lit, S7c2): a list of
    /// `T` given to its `fromArrayLiteral`; `null` where the place takes no such type.
    mut fn arrayLiteralBuilt(items: Expr[], expected: Ty, at: Span): ?TExpr {
        let target = match (expected) {
            .Optional(inner) => inner.value,
            _ => expected,
        };
        let fi = this.instanceFor(target, "FromArrayLiteral");
        if (fi < 0) {
            return null;
        }
        let elem = this.types[fi].args[0];
        let list = this.listLiteral(items, Ty.List(boxTy(elem)), at);
        match (target) {
            .Named(i) => {
                let tmpl = if (this.types[i].template >= 0
                    && this.types[i].template != i) this.types[i].template
                    else i;
                let own = this.types[tmpl].methods.get("fromArrayLiteral");
                if (own == null) {
                    return null;
                }
                if (this.functions[own].typeParams.length() > 0) {
                    return TExpr.CallGeneric(own, this.types[i].args, [list], target);
                }
                return TExpr.Call(own, [list], target);
            }
            .Param(k) => {
                let found = this.ifaceMember(fi, "fromArrayLiteral");
                if (found == null) {
                    return null;
                }
                let (_, slot) = found;
                return TExpr.CallStatic(k, fi, "fromArrayLiteral", slot, [list], target);
            }
            _ => {
                return null;
            }
        }
    }

    /// A list's own methods (S7b1): `length()`, `push(v)`, `pop()`; `null` for another name — the
    /// others come with S7b2.
    mut fn listMethod(receiver: TExpr, elem: Ty, method: string, args: Arg[], at: Span): ?TExpr {
        // `sort()` of a list of ints, chars, floats or strings: the VM's, in their own order
        // (S7c6c2)
        if (method == "sort" && args.length() == 0) {
            let native = match (elem) {
                .Int | .Char => "list.sortInts",
                .Float => "list.sortFloats",
                .Str => "list.sortStrings",
                _ => "",
            };
            if (let n = nativeNamed(native)) {
                return TExpr.Native(Native.Std(nativeNumber(n)), [receiver], Ty.Void);
            }
        }
        // `join(sep)` (S7c6c2): each element as `{x}` writes it, `sep` between each two — made
        // where it is called, so a program that joins no list makes no element's text (in the
        // prelude, over `T`, it took the Debug slot, and so every type's form, in every program)
        if (method == "join" && args.length() == 1) {
            let sep = this.coerce(this.expr(args[0].value, Ty.Str), Ty.Str, spanOf(args[0].value));
            let t = Ty.List(boxTy(elem));
            let h = this.hidden(t, at);
            let hs = this.hidden(Ty.Str, at);
            let acc = this.hidden(Ty.Str, at);
            let i = this.hidden(Ty.Int, at);
            let k = TExpr.Local(i, Ty.Int);
            let text = TExpr.Local(acc, Ty.Str);
            let each = [
                TStmt.If(
                    TExpr.Binary(boxE(k), BinaryOp.Gt, boxE(TExpr.Int(0)), Ty.Bool),
                    [TStmt.SetLocal(acc, concatAll([text, TExpr.Local(hs, Ty.Str)]), at.line)],
                    [],
                    at.line
                ),
                TStmt.SetLocal(
                    acc,
                    concatAll(
                        [
                            text,
                            this.stringOf(
                                TExpr.ListOp(ListOp.Get, [TExpr.Local(h, t), k], elem),
                                at
                            ),
                        ]
                    ),
                    at.line
                ),
            ];
            return TExpr.Block(
                [
                    TStmt.SetLocal(h, receiver, at.line),
                    TStmt.SetLocal(hs, sep, at.line),
                    TStmt.SetLocal(acc, TExpr.Str(""), at.line),
                    TStmt.ForRange(
                        i,
                        TExpr.Int(0),
                        TExpr.ListOp(ListOp.Len, [TExpr.Local(h, t)], Ty.Int),
                        false,
                        each,
                        at.line
                    ),
                ],
                boxE(text),
                Ty.Str
            );
        }
        let arity = match (method) {
            "length" | "pop" => 0,
            "push" => 1,
            _ => -1,
        };
        if (arity < 0) {
            return null;
        }
        if (args.length() != arity) {
            this.error(
                "LYS-SEM0014",
                if (arity == 0) f"{method}() takes nothing" else f"{method} takes one value",
                at
            );
            return TExpr.Unknown;
        }
        return match (method) {
            "length" => TExpr.ListOp(ListOp.Len, [receiver], Ty.Int),
            "pop" => TExpr.ListOp(ListOp.Pop, [receiver], Ty.Optional(boxTy(elem))),
            _ => {
                let v = this.coerce(this.expr(args[0].value, elem), elem, spanOf(args[0].value));
                if (elem == .Unknown) {
                    this.fixFrom(receiver, Ty.List(boxTy(typeOf(v))));
                }
                TExpr.ListOp(ListOp.Push, [receiver, v], Ty.Void)
            }
        };
    }

    /// The Debug form of a list of a type parameter (S7c4a), as a loop where it stands: a
    /// generic's copies substitute its types, each element's form through its argument's table.
    mut fn listDebugInline(v: TExpr, t: Ty, at: Span): TExpr {
        let elem = match (t) {
            .List(e) => e.value,
            _ => Ty.Unknown,
        };
        let h = this.hidden(t, at);
        let acc = this.hidden(Ty.Str, at);
        let i = this.hidden(Ty.Int, at);
        let x = TExpr.Local(h, t);
        let text = TExpr.Local(acc, Ty.Str);
        let k = TExpr.Local(i, Ty.Int);
        let each = [
            TStmt.If(
                TExpr.Binary(boxE(k), BinaryOp.Gt, boxE(TExpr.Int(0)), Ty.Bool),
                [TStmt.SetLocal(acc, concatAll([text, TExpr.Str(", ")]), at.line)],
                [],
                at.line
            ),
            TStmt.SetLocal(
                acc,
                concatAll([text, this.debugText(TExpr.ListOp(ListOp.Get, [x, k], elem), elem, at)]),
                at.line
            ),
        ];
        return TExpr.Block(
            [
                TStmt.SetLocal(h, v, at.line),
                TStmt.SetLocal(acc, TExpr.Str("["), at.line),
                TStmt.ForRange(
                    i,
                    TExpr.Int(0),
                    TExpr.ListOp(ListOp.Len, [x], Ty.Int),
                    false,
                    each,
                    at.line
                ),
            ],
            boxE(concatAll([text, TExpr.Str("]")])),
            Ty.Str
        );
    }

    /// The text of `v`, of type `t`, in a copy — its Debug form where `debug`: an optional's and
    /// a tuple's through a function of their own (S7c6b2). A copy is made in no context of its
    /// own, and their text holds the value in a local: it took one of the context then checked
    /// (since S3i, `fn show<T>(x: T) = f"{x}"` with a `?int` broke the code generator).
    mut fn textInCopy(v: TExpr, t: Ty, debug: bool): TExpr {
        return match (t) {
            .Optional(_) | .Tuple(_) => TExpr.Call(this.textFnOf(t, debug), [v], Ty.Str),
            // a list of a parameter still open, a copy inside another generic's body: the list's
            // form through its table, as an open type's (S7d3: `Box<T[]>` in a generic `k` broke
            // the code generator — its loop took a local of no context)
            .List(_) if (hasParam(t)) => TExpr.CallIface(this.debugSlotOf(), [v], Ty.Str),
            _ => if (debug) this.debugText(v, t, nowhereSpan) else this.stringOf(v, nowhereSpan),
        };
    }

    /// A function that gives the text of a value of type `t`, its Debug form where `debug`; one
    /// for each type.
    mut fn textFnOf(t: Ty, debug: bool): int {
        let key = (if (debug) "debug:" else "text:") + tyKey(t);
        if (let known = this.textFns.get(key)) {
            return known;
        }
        let index = this.functions.length();
        this.functions.push(FnInfo { name = "#text", owner = -1, isStatic = false, line = 1 });
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        this.textFns.insert(key, index);
        let saved = this.ctx;
        this.ctx = FnCtx.new(index, Ty.Str, false, false);
        this.declareLocal("x", t, false, nowhereSpan);
        let x = TExpr.Local(0, t);
        let text = if (debug) this.debugText(x, t, nowhereSpan) else this.stringOf(x, nowhereSpan);
        let f = this.functions[index];
        f.params = [ParamInfo { name = "x", ty = t, default = null }];
        f.returns = Ty.Str;
        f.body = [TStmt.Return(text, 1)];
        f.locals = this.ctx.locals.toArray();
        f.boxed = this.ctx.boxed.toArray();
        this.ctx = saved;
        return index;
    }

    /// The Debug form of a list type (S7b1): `[1, 2, 3]`, each element's own form between commas;
    /// one function for each list type printed.
    mut fn listDebugFnOf(t: Ty, at: Span): int {
        let key = t.debug();
        let known = this.listDebugFns.get(key);
        if (known != null) {
            return known;
        }
        let elem = match (t) {
            .List(e) => e.value,
            _ => Ty.Unknown,
        };
        let index = this.functions.length();
        this.functions.push(
            FnInfo { name = "#debug", owner = -1, isStatic = false, line = at.line }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        this.listDebugFns.insert(key, index);
        let saved = this.ctx;
        this.ctx = FnCtx.new(index, Ty.Str, false, false);
        this.declareLocal("x", t, false, at);
        let acc = this.hidden(Ty.Str, at);
        let i = this.hidden(Ty.Int, at);
        let x = TExpr.Local(0, t);
        let text = TExpr.Local(acc, Ty.Str);
        let k = TExpr.Local(i, Ty.Int);
        let each = [
            TStmt.If(
                TExpr.Binary(boxE(k), BinaryOp.Gt, boxE(TExpr.Int(0)), Ty.Bool),
                [TStmt.SetLocal(acc, concatAll([text, TExpr.Str(", ")]), at.line)],
                [],
                at.line
            ),
            TStmt.SetLocal(
                acc,
                concatAll([text, this.debugText(TExpr.ListOp(ListOp.Get, [x, k], elem), elem, at)]),
                at.line
            ),
        ];
        let dbg = this.functions[index];
        dbg.params = [ParamInfo { name = "x", ty = t, default = null }];
        dbg.returns = Ty.Str;
        dbg.body = [
            TStmt.SetLocal(acc, TExpr.Str("["), at.line),
            TStmt.ForRange(
                i,
                TExpr.Int(0),
                TExpr.ListOp(ListOp.Len, [x], Ty.Int),
                false,
                each,
                at.line
            ),
            TStmt.Return(concatAll([text, TExpr.Str("]")]), at.line),
        ];
        dbg.locals = this.ctx.locals.toArray();
        dbg.boxed = this.ctx.boxed.toArray();
        this.ctx = saved;
        return index;
    }

    /// A call of the prelude's generic helper `name` of lists (S7b2a), its element type bound.
    mut fn listCall(name: string, elem: Ty, args: TExpr[], returns: Ty): TExpr {
        var fi = -1;
        if (let fs = this.fnByName.get(name)) {
            if (fs.length() > 0) {
                fi = fs[0];
            }
        }
        return TExpr.CallGeneric(fi, [elem], args, returns);
    }

    /// The method `name` of the prelude's extend block of `T[]` (S7b2a).
    mut fn listMethodFn(name: string): int {
        let i = this.builtinOf(Ty.List(boxTy(Ty.Unknown)));
        return this.types[i].methods.get(name) ?? -1;
    }

    /// A function the checker writes (S7b2a): its entry, its parameters its first locals; the
    /// body comes with `endSynth`.
    mut fn beginSynth(name: string, params: ParamInfo[], returns: Ty, at: Span): (int, FnCtx) {
        let index = this.functions.length();
        this.functions.push(FnInfo { name = name, owner = -1, isStatic = true, line = at.line });
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let info = this.functions[index];
        info.params = params;
        info.returns = returns;
        let saved = this.ctx;
        this.ctx = FnCtx.new(index, returns, false, false);
        for (p in params) {
            this.declareLocal(p.name, p.ty, false, at);
        }
        return (index, saved);
    }

    mut fn endSynth(index: int, body: TStmt[], saved: FnCtx): void {
        let info = this.functions[index];
        info.body = body;
        info.locals = this.ctx.locals.toArray();
        info.boxed = this.ctx.boxed.toArray();
        this.ctx = saved;
    }

    /// `a == b` of two lists of `t` (S7b2a): the lengths, then the elements in order.
    mut fn listEqFnOf(t: Ty, at: Span): int {
        let key = "eq " + t.debug();
        let known = this.listDebugFns.get(key);
        if (known != null) {
            return known;
        }
        let elem = match (t) {
            .List(e) => e.value,
            _ => Ty.Unknown,
        };
        let (index, saved) = this.beginSynth(
            "#eq",
            [
                ParamInfo { name = "a", ty = t, default = null },
                ParamInfo { name = "b", ty = t, default = null },
            ],
            Ty.Bool,
            at
        );
        this.listDebugFns.insert(key, index);
        let a = TExpr.Local(0, t);
        let b = TExpr.Local(1, t);
        let i = this.hidden(Ty.Int, at);
        let k = TExpr.Local(i, Ty.Int);
        let ne = this.equality(
            TExpr.ListOp(ListOp.Get, [a, k], elem),
            BinaryOp.Ne,
            TExpr.ListOp(ListOp.Get, [b, k], elem),
            at
        );
        let body = [
            TStmt.If(
                TExpr.Binary(
                    boxE(TExpr.ListOp(ListOp.Len, [a], Ty.Int)),
                    BinaryOp.Ne,
                    boxE(TExpr.ListOp(ListOp.Len, [b], Ty.Int)),
                    Ty.Bool
                ),
                [TStmt.Return(TExpr.Bool(false), at.line)],
                [],
                at.line
            ),
            TStmt.ForRange(
                i,
                TExpr.Int(0),
                TExpr.ListOp(ListOp.Len, [a], Ty.Int),
                false,
                [TStmt.If(ne, [TStmt.Return(TExpr.Bool(false), at.line)], [], at.line)],
                at.line
            ),
            TStmt.Return(TExpr.Bool(true), at.line),
        ];
        this.endSynth(index, body, saved);
        return index;
    }

    mut fn intrinsic(name: string, args: Arg[], expected: ?Ty, at: Span): TExpr {
        // a native of the standard library (S7a): `__os_env(name)` calls the VM's `os.env`; it
        // stands where its type is known — a function's body, whose signature is the native's
        let native = nativeNamed(name[2..name.length()].toString().replace("_", "."));
        if (native != null) {
            if (let t = expected) {
                let xs = List<TExpr>.new();
                for (a in args) {
                    xs.push(this.expr(a.value, null));
                }
                return TExpr.Native(Native.Std(nativeNumber(native)), xs.toArray(), t);
            }
            this.error("LYS-ICE0001", f"the native '{name}' stands where no type is known", at);
            return TExpr.Unknown;
        }
        let one = if (args.length() == 1) this.expr(args[0].value, null) else TExpr.Unknown;
        return match (name) {
            "__chanReady" => TExpr.ChanReady(boxE(one)),
            "__chanWatch" => TExpr.ChanWatch(boxE(one)),
            "__parkWatched" => TExpr.ParkWatched,
            "__sleep" => TExpr.Sleep(boxE(one)),
            "__readLine" => TExpr.ReadLine,
            "__listChanges" => TExpr.ListOp(ListOp.Changes, [one], Ty.Int),
            // a coroutine's and a scope's methods a table reaches (S7c4b): as their calls
            "__coNext" | "__coClose" => match (typeOf(one)) {
                .Named(i) => this.coroutineMethod(
                    one,
                    i,
                    if (name == "__coNext") "next" else "close",
                    [],
                    at
                )
                    ?? TExpr.Unknown,
                _ => TExpr.Unknown,
            },
            "__scopeClose" => TExpr.ScopeClose(boxE(one)),
            "__boundsPanic" => TExpr.Panic(boxE(one), 3),
            // a precondition from the program text (S7e1: a negative repetition), `LYS-RT0007`
            "__argumentPanic" => TExpr.Panic(boxE(one), 7),
            // a collection changed while it was walked (S7d2): Lyric 5's `LYR-RT0016`
            "__changedPanic" => TExpr.Panic(boxE(one), 16),
            // a value's Debug form, where a type writes its own (S7d2: a map's entries)
            "__debugOf" => this.debugText(one, typeOf(one), at),
            "__listTruncate" | "__listCheck" => {
                let two = args.length() == 2;
                let xs = if (two) this.expr(args[0].value, null) else TExpr.Unknown;
                let n = if (two) this.coerce(this.expr(args[1].value, Ty.Int), Ty.Int, at)
                    else TExpr.Unknown;
                TExpr.ListOp(
                    if (name == "__listTruncate") ListOp.Trunc else ListOp.Check,
                    [xs, n],
                    Ty.Void
                )
            }
            "__timerAfter" => TExpr.TimerAfter(
                boxE(one),
                Ty.Named(this.typeInstance(this.typeIndex.get("Channel") ?? -1, [Ty.Void]))
            ),
            _ => {
                this.error("LYS-ICE0001", f"no intrinsic '{name}'", at);
                TExpr.Unknown
            }
        };
    }

    /// `Channel<T>.new(capacity = 0)` and `Semaphore.new(n)` (S6d1); `null` for another call.
    mut fn syncNew(typeIndex: int, method: string, args: Arg[], at: Span): ?TExpr {
        if (method != "new") {
            return null;
        }
        let channel = this.typeIndex.get("Channel") ?? -1;
        let semaphore = this.typeIndex.get("Semaphore") ?? -1;
        if (typeIndex == channel) {
            this.error(
                "LYS-SEM0060",
                "a channel takes the type of its values where it is made: Channel<T>.new()",
                at
            );
            return TExpr.Unknown;
        }
        let isChannel = channel >= 0 && this.types[typeIndex].template == channel;
        if (!isChannel && typeIndex != semaphore) {
            return null;
        }
        if (args.length() > 1 || (!isChannel && args.length() != 1)) {
            this.error(
                "LYS-SEM0014",
                if (isChannel) "Channel<T>.new takes its capacity, or nothing"
                    else "Semaphore.new takes its permits",
                at
            );
            return TExpr.Unknown;
        }
        let n = if (args.length() == 1) this.coerce(
            this.expr(args[0].value, Ty.Int),
            Ty.Int,
            spanOf(args[0].value)
        )
            else TExpr.Int(0);
        return if (isChannel) TExpr.ChanNew(boxE(n), Ty.Named(typeIndex))
            else TExpr.SemNew(boxE(n), Ty.Named(typeIndex));
    }

    /// A method of a `Channel<T>` — `send(v)`, `recv()`, `close()` — or of a `Semaphore` —
    /// `acquire()`, `tryAcquire()`, `release()`, `available()` (S6d1); `null` for another type.
    mut fn syncMethod(receiver: TExpr, i: int, method: string, args: Arg[], at: Span): ?TExpr {
        let channel = this.typeIndex.get("Channel") ?? -1;
        let semaphore = this.typeIndex.get("Semaphore") ?? -1;
        let isChannel = channel >= 0
            && this.types[i].template == channel
            && this.types[i].args.length() == 1;
        if (!isChannel && i != semaphore) {
            return null;
        }
        if (isChannel && method == "send") {
            if (args.length() != 1) {
                this.error("LYS-SEM0014", "send takes one value", at);
                return TExpr.Unknown;
            }
            let t = this.types[i].args[0];
            let v = this.coerce(this.expr(args[0].value, t), t, spanOf(args[0].value));
            return TExpr.ChanSend(boxE(receiver), boxE(v));
        }
        if (args.length() > 0) {
            this.error("LYS-SEM0014", f"'{method}' takes no argument", at);
        }
        if (isChannel) {
            return match (method) {
                "recv" => TExpr.ChanRecv(boxE(receiver), Ty.Optional(boxTy(this.types[i].args[0]))),
                "close" => TExpr.ChanClose(boxE(receiver)),
                _ => {
                    this.error(
                        "LYS-SEM0012",
                        f"a channel has no method '{method}': send, recv, close",
                        at
                    );
                    TExpr.Unknown
                }
            };
        }
        return match (method) {
            "acquire" => TExpr.SemAcquire(boxE(receiver)),
            "tryAcquire" => TExpr.SemTry(boxE(receiver)),
            "release" => TExpr.SemRelease(boxE(receiver)),
            "available" => TExpr.SemAvail(boxE(receiver)),
            _ => {
                this.error(
                    "LYS-SEM0012",
                    f"a semaphore has no method '{method}': acquire, tryAcquire, release, available",
                    at
                );
                TExpr.Unknown
            }
        };
    }

    /// A method of a `TaskScope` (Lyric 5 10 §4): `spawn { … }` a task of it, `close()`, which
    /// waits for its tasks and throws the first failure, `cancel()`; `null` where `i` is no scope.
    mut fn scopeMethod(receiver: TExpr, i: int, method: string, args: Arg[], at: Span): ?TExpr {
        if (i != (this.typeIndex.get("TaskScope") ?? -1)) {
            return null;
        }
        if (method == "spawn") {
            return match (this.spawnOf(args, at)) {
                .Spawn(x, t) => TExpr.ScopeSpawn(boxE(receiver), x, t),
                _ => TExpr.Unknown,
            };
        }
        if (args.length() > 0) {
            this.error("LYS-SEM0014", f"'{method}' takes no argument", at);
        }
        return match (method) {
            "close" => TExpr.ScopeClose(boxE(receiver)),
            "cancel" => TExpr.ScopeCancel(boxE(receiver)),
            _ => {
                this.error(
                    "LYS-SEM0012",
                    f"a task scope has no method '{method}': spawn, close, cancel",
                    at
                );
                TExpr.Unknown
            }
        };
    }

    /// A method of a `Task<T>` (07 N4): `await()` its value, `status()` where it stands; `null`
    /// where `i` is no task's type.
    mut fn taskMethod(receiver: TExpr, i: int, method: string, args: Arg[], at: Span): ?TExpr {
        let task = this.typeIndex.get("Task") ?? -1;
        if (task < 0 || (i != task && this.types[i].template != task)) {
            return null;
        }
        if (args.length() > 0) {
            this.error("LYS-SEM0014", f"'{method}' takes no argument", at);
        }
        let value = if (this.types[i].args.length() > 0) this.types[i].args[0] else Ty.Unknown;
        return match (method) {
            "await" => TExpr.Await(boxE(receiver), value),
            // its waits throw `Cancelled` from now on (Lyric 5 10 §3 rule 1)
            "cancel" => TExpr.TaskCancel(boxE(receiver)),
            "status" => this.statusOf(receiver, value, at),
            // whether it has ended, with its value or its error (Lyric 5 10 §2 rule 10)
            "isDone" => TExpr.Binary(
                boxE(TExpr.TaskStatus(boxE(receiver), Ty.Int)),
                BinaryOp.Ne,
                boxE(TExpr.Int(0)),
                Ty.Bool
            ),
            _ => {
                this.error(
                    "LYS-SEM0012",
                    f"a task has no method '{method}': await, status, isDone, cancel",
                    at
                );
                TExpr.Unknown
            }
        };
    }

    /// `T.name` of type `index`: a constant, a unit variant, or a static function as a value
    /// (§8.4 rule 1).
    mut fn typeMember(index: int, typeName: string, name: string, at: Span): TExpr {
        let g = this.types[index].staticLets.get(name);
        if (g != null) {
            return TExpr.Global(g, this.globals[g].ty);
        }
        let k = this.variantIndex(index, name);
        if (k >= 0) {
            return this.unitVariant(index, k, at);
        }
        let m = this.methodOf(index, name);
        if (m != null && this.functions[m].isStatic) {
            this.mayName(index, name, at);
            return this.thunk(m, at);
        }
        this.error("LYS-SEM0012", f"'{typeName}' has no member '{name}'", at);
        return TExpr.Unknown;
    }

    /// The type `m.T` names where `e` is the name `m` of a module this one imports: its index;
    /// -1 where `e` is no module's name, -2 where the module has no such type (reported).
    mut fn moduleType(e: Expr, typeName: string, at: Span): int {
        let m = match (e) {
            .Name(n, _) => n,
            _ => "",
        };
        if (m == ""
            || this.lookupLocal(m) != null
            || this.globalIndex.containsKey(this.q(m))
            || this.moduleNamed(m) == null) {
            return -1;
        }
        return this.typeNamed(m + "." + typeName, at) ?? -2;
    }

    mut fn init(
        name: string,
        targs: TypeExpr[],
        fields: FieldInit[],
        expected: ?Ty,
        at: Span
    ): TExpr {
        let index = this.typeNamed(name, at);
        if (index == null) {
            if (!name.contains(".")) {
                this.resolveNamed(name, [], at);
            }
            return TExpr.Unknown;
        }
        let info = this.types[index];
        this.mayBuild(index, at);
        if (info.kind == .Enum) {
            this.error(
                "LYS-SEM0031",
                f"'{name}' is an enum: its values are its variants, written '{name}.Variant'",
                at
            );
            return TExpr.Unknown;
        }
        if (targs.length() > 0) {
            // `Pair<int, _> { … }`: what is written binds first, a placeholder is filled by the
            // position or the fields (Lyric 5 03 §9.3 rules 1–2; S7c6d)
            if (targs.length() != info.typeParams.length()) {
                this.error(
                    "LYS-SEM0026",
                    f"'{name}' takes {info.typeParams.length()} type arguments, not {targs.length()}",
                    at
                );
                return TExpr.Unknown;
            }
            let written = List<?Ty>.new();
            var whole = true;
            for (x in targs) {
                let t = this.writtenType(x);
                if (isHole(t)) {
                    written.push(null);
                    whole = false;
                } else {
                    written.push(t);
                }
            }
            if (whole) {
                let tys = List<Ty>.new();
                for (w in written) {
                    tys.push(w ?? Ty.Unknown);
                }
                return this.genericInit(
                    index,
                    fields,
                    Ty.Named(this.typeInstance(index, tys.toArray())),
                    at
                );
            }
            return this.genericInit(index, fields, expected, at, written.toArray());
        }
        if (info.typeParams.length() > 0) {
            return this.genericInit(index, fields, expected, at);
        }
        return TExpr.New(index, this.fieldValues(name, info.fields, fields, at));
    }

    /// `Pair { first = 1, second = "a" }`: the instance the position expects, or the one the
    /// fields' values bind (03 §9.2).
    mut fn genericInit(
        index: int,
        fields: FieldInit[],
        expected: ?Ty,
        at: Span,
        written: (?Ty)[] = []
    ): TExpr {
        let tmpl = this.types[index];
        var inst = -1;
        if (expected != null) {
            match (expected) {
                .Named(e) => {
                    if (this.types[e].template == index) {
                        inst = e;
                    }
                }
                _ => { }
            }
        }
        if (inst >= 0) {
            this.fillInstance(inst);
            // the template's defaults at the instance's arguments (S7c6b: since S3g a position
            // that named the instance took none — `let h: Holder<int> = Holder { }` was SEM0106)
            let info = this.types[inst];
            let decls = List<FieldInfo>.new();
            var k = 0;
            for (d in info.fields) {
                let td = if (k < tmpl.fields.length()) tmpl.fields[k].default else null;
                if (d.default == null && td != null) {
                    decls.push(d with { default = this.specExpr(td, info.args) });
                } else {
                    decls.push(d);
                }
                k += 1;
            }
            return TExpr.New(inst, this.fieldValues(info.name, decls.toArray(), fields, at));
        }
        let binds = List<?Ty>.new();
        var j0 = 0;
        for (_ in tmpl.typeParams) {
            // what is written, a placeholder left open (S7c6d)
            binds.push(if (j0 < written.length()) written[j0] else null);
            j0 += 1;
        }
        let checked = List<?TExpr>.new();
        for (_ in tmpl.fields) {
            checked.push(null);
        }
        for (f in fields) {
            var k = 0;
            for (d in tmpl.fields) {
                if (d.name == f.name && checked[k] == null) {
                    // as much of the field's type as is known
                    let known = this.substOpen(d.ty, binds.toArray());
                    let v = this.expr(f.value, if (hasParam(known)) null else known);
                    this.bind(d.ty, typeOf(v), binds);
                    checked[k] = v;
                }
                k += 1;
            }
        }
        let args = List<Ty>.new();
        var j = 0;
        for (tp in tmpl.typeParams) {
            let b = binds[j];
            if (b == null) {
                this.error(
                    "LYS-SEM0060",
                    f"nothing here says what '{tp.name}' of '{tmpl.name}' is: write it",
                    at
                );
                return TExpr.Unknown;
            }
            args.push(b);
            j += 1;
        }
        inst = this.typeInstance(index, args.toArray());
        this.fillInstance(inst);
        let info = this.types[inst];
        let out = List<TExpr>.new();
        var k = 0;
        for (d in info.fields) {
            let v = checked[k];
            let dflt = tmpl.fields[k].default;
            if (v != null) {
                out.push(this.coerce(v, d.ty, at));
            } else if (dflt != null) {
                out.push(this.specExpr(dflt, info.args));
            } else {
                match (d.ty) {
                    .Optional(_) => out.push(TExpr.Null(d.ty)),
                    _ => {
                        this.error(
                            "LYS-SEM0106",
                            f"'{info.name}' needs '{d.name}': no default gives it",
                            at
                        );
                        out.push(TExpr.Unknown);
                    }
                }
            }
            k += 1;
        }
        return TExpr.New(inst, out.toArray());
    }

    /// The values of an initializer of `decls`: each given one checked against its field, a
    /// default where none is given; every field without either named in one report.
    mut fn fieldValues(name: string, decls: FieldInfo[], fields: FieldInit[], at: Span): TExpr[] {
        let values = List<?TExpr>.new();
        for (_ in decls) {
            values.push(null);
        }
        for (f in fields) {
            var k = 0;
            var found = -1;
            for (decl in decls) {
                if (decl.name == f.name) {
                    found = k;
                }
                k += 1;
            }
            if (found < 0) {
                this.error("LYS-SEM0015", f"'{name}' declares no field '{f.name}'", f.span);
                continue;
            }
            if (values[found] != null) {
                this.error("LYS-SEM0070", f"'{f.name}' is given twice", f.span);
                continue;
            }
            let t = decls[found].ty;
            values[found] = this.coerce(this.expr(f.value, t), t, spanOf(f.value));
        }
        let out = List<TExpr>.new();
        let missing = List<string>.new();
        var k = 0;
        for (decl in decls) {
            let given = values[k];
            let dflt = decl.default;
            if (given != null) {
                out.push(given);
            } else if (dflt != null) {
                out.push(dflt);
            } else {
                missing.push(decl.name);
                out.push(TExpr.Unknown);
            }
            k += 1;
        }
        if (missing.length() > 0) {
            this.error(
                "LYS-SEM0106",
                f"'{name}' needs {missing.toArray().join(", ")}: no default gives them",
                at
            );
        }
        return out.toArray();
    }

    /// `p with { x = 1, pos.y = 2 }` (Lyric 5 02 M6): a copy of the struct `p` with the named
    /// fields replaced, of `p`'s type — on a struct only (W2); a path reaches into a struct the
    /// value holds (W6). The target first, then the values left to right, each seeing the old `p`
    /// (W4). A struct is shared and never changed, so each struct a path touches is built anew;
    /// a later path into a field replaced whole applies to the new value, as Lyric 5's stores do.
    mut fn withOf(target: Expr, fields: WithField[], at: Span): TExpr {
        let p = this.expr(target, null);
        let t = typeOf(p);
        let owner = this.structOf(t);
        if (owner < 0) {
            if (t != .Unknown) {
                let what = match (t) {
                    .Named(i) => if (this.types[i].kind
                        == .Class) f"'{this.types[i].name}' is a class: an object is changed in place"
                        else f"'{this.types[i].name}' is no struct",
                    .Tuple(_) => f"'{this.tyName(t)}' is a tuple, which has no fields to name",
                    _ => f"'{this.tyName(t)}' is no struct",
                };
                this.error(
                    "LYS-SEM0116",
                    f"'with' copies a struct with fields replaced; {what}",
                    at
                );
            }
            for (f in fields) {
                this.expr(f.value, null);
            }
            return TExpr.Unknown;
        }
        this.mayBuild(owner, at);
        let h = this.hidden(t, at);
        let setup = List<TStmt>.new();
        setup.push(TStmt.SetLocal(h, p, at.line));
        let seen = Set<string>.new();
        let updates = List<WithUpdate>.new();
        for (f in fields) {
            let key = f.path.join(".");
            if (seen.contains(key)) {
                this.error("LYS-SEM0070", f"'{key}' is given twice in 'with'", f.span);
                this.expr(f.value, null);
                continue;
            }
            seen.insert(key);
            let ft = this.withPath(t, f.path, f.span);
            if (ft == null) {
                this.expr(f.value, null);
                continue;
            }
            let v = this.coerce(this.expr(f.value, ft), ft, spanOf(f.value));
            let vh = this.hidden(ft, f.span);
            setup.push(TStmt.SetLocal(vh, v, f.span.line));
            updates.push(WithUpdate { path = f.path, from = 0, value = TExpr.Local(vh, ft) });
        }
        let copy = this.rebuilt(TExpr.Local(h, t), owner, updates.toArray());
        return TExpr.Block(setup.toArray(), boxE(copy), t);
    }

    /// The struct type `t` is, or -1.
    fn structOf(t: Ty): int {
        return match (t) {
            .Named(i) => if (this.types[i].kind == .Struct) i else -1,
            _ => -1,
        };
    }

    /// The type of the field a path of `with` names in `t`; `null` after the report where a step
    /// is no struct (`LYS-SEM0116`) or names no field (`LYS-SEM0015`).
    mut fn withPath(t: Ty, path: string[], at: Span): ?Ty {
        var holder = t;
        var k = 0;
        for (name in path) {
            let o = this.structOf(holder);
            if (o < 0) {
                let through = sliceOf(path, 0, k).join(".");
                this.error(
                    "LYS-SEM0116",
                    f"'{through}' is a '{this.tyName(holder)}', not a struct: a path in 'with' reaches through structs only",
                    at
                );
                return null;
            }
            let info = this.types[o];
            var found = -1;
            var j = 0;
            for (d in info.fields) {
                if (d.name == name) {
                    found = j;
                }
                j += 1;
            }
            if (found < 0) {
                this.error("LYS-SEM0015", f"'{info.name}' declares no field '{name}'", at);
                return null;
            }
            holder = info.fields[found].ty;
            k += 1;
        }
        return holder;
    }

    /// A new `owner` from `base`: each field the old one, or the value the last update that
    /// replaces it whole gives, with the deeper updates after that one built into it.
    mut fn rebuilt(base: TExpr, owner: int, updates: WithUpdate[]): TExpr {
        let info = this.types[owner];
        let values = List<TExpr>.new();
        var k = 0;
        for (d in info.fields) {
            var start = TExpr.Field(boxE(base), k, d.ty);
            var deeper = List<WithUpdate>.new();
            for (u in updates) {
                if (u.path[u.from] != d.name) {
                    continue;
                }
                if (u.from == u.path.length() - 1) {
                    start = u.value;
                    deeper = List<WithUpdate>.new();
                } else {
                    deeper.push(WithUpdate { path = u.path, from = u.from + 1, value = u.value });
                }
            }
            if (deeper.length() > 0) {
                start = this.rebuilt(start, this.structOf(d.ty), deeper.toArray());
            }
            values.push(start);
            k += 1;
        }
        return TExpr.New(owner, values.toArray());
    }

    mut fn ifExpr(cond: Expr, then: Expr, otherwise: Expr, expected: ?Ty, at: Span): TExpr {
        let c = this.condition(cond);
        let before = this.ctx.unassigned;
        this.pushScope();
        this.narrow(this.factsOf(c, true));
        let a = this.expr(then, expected);
        this.popScope();
        let afterThen = this.reached(a);
        this.ctx.unassigned = before;
        this.pushScope();
        this.narrow(this.factsOf(c, false));
        let b = this.expr(otherwise, expected);
        this.popScope();
        this.ctx.unassigned = afterThen.union(this.reached(b));
        let t = this.unify(typeOf(a), typeOf(b), at);
        return TExpr.If(boxE(c), boxE(this.coerce(a, t, at)), boxE(this.coerce(b, t, at)), t);
    }

    /// What a branch that gave `e` leaves unassigned: nothing where it never comes out.
    mut fn reached(e: TExpr): Set<int> {
        return if (typeOf(e) == .Never) Set<int>.new() else this.ctx.unassigned;
    }

    /// The type both branches give: the same one, `float` where one is `int`, the other where one
    /// never ends (`LYS-SEM0016` otherwise).
    mut fn unify(a: Ty, b: Ty, at: Span, what: string = "the branches"): Ty {
        if (a == b || b == .Never || b == .Unknown) {
            return a;
        }
        if (a == .Never || a == .Unknown) {
            return b;
        }
        if ((a == .Int && b == .Float) || (a == .Float && b == .Int)) {
            return Ty.Float;
        }
        // a value beside null, or beside an optional of it: the optional (`if (c) 1 else null`)
        if (a == .NullLit) {
            return match (b) {
                .Optional(_) => b,
                _ => Ty.Optional(boxTy(b)),
            };
        }
        if (b == .NullLit) {
            return match (a) {
                .Optional(_) => a,
                _ => Ty.Optional(boxTy(a)),
            };
        }
        match (a) {
            .Optional(inner) => {
                if (inner.value == b) {
                    return a;
                }
            }
            _ => { }
        }
        match (b) {
            .Optional(inner) => {
                if (inner.value == a) {
                    return b;
                }
            }
            _ => { }
        }
        this.error("LYS-SEM0016", f"{what} give {this.tyName(a)} and {this.tyName(b)}", at);
        return Ty.Unknown;
    }

    /// A block where a value stands: its last statement gives the value when it is an
    /// expression, or an `if` with an `else` (09 NL rule 6).
    mut fn valueBlock(b: Block, expected: ?Ty): TExpr {
        // a value block is a scope: a defer in it makes the rest, the value too, its region
        // (Lyric 5 07 §2 rule 4)
        var split = -1;
        var j = 0;
        while (j < b.stmts.length() && split < 0) {
            match (b.stmts[j]) {
                .Defer(_, _) | .Using(_, _, _, _) => split = j,
                _ => { }
            }
            j += 1;
        }
        if (split >= 0) {
            return this.valueBlockDeferred(b, split, expected);
        }
        this.pushScope();
        let out = List<TStmt>.new();
        var value = TExpr.Unit;
        var k = 0;
        for (s in b.stmts) {
            let last = k == b.stmts.length() - 1;
            k += 1;
            if (last) {
                match (s) {
                    .Expr(e, _) => {
                        value = this.expr(e, expected);
                        continue;
                    }
                    .If(cond, then, otherwise, at) => {
                        if (otherwise != null) {
                            value = this.ifStmtValue(cond, then, otherwise.value, expected, at);
                            continue;
                        }
                    }
                    _ => { }
                }
            }
            out.push(this.stmt(s));
        }
        this.popScope();
        return TExpr.Block(out.toArray(), boxE(value), typeOf(value));
    }

    /// A value block whose statement `split` is a defer or a using: what stands before it, then
    /// the rest and the value in its region.
    mut fn valueBlockDeferred(b: Block, split: int, expected: ?Ty): TExpr {
        this.pushScope();
        let out = List<TStmt>.new();
        let before = List<Stmt>.new();
        let after = List<Stmt>.new();
        var k = 0;
        for (s in b.stmts) {
            if (k < split) {
                before.push(s);
            } else if (k > split) {
                after.push(s);
            }
            k += 1;
        }
        out.pushAll(this.stmtList(before.toArray()));
        var d: TStmt[] = [];
        var at = b.span;
        match (b.stmts[split]) {
            .Defer(body, dat) => {
                d = this.deferBody(body);
                at = dat;
            }
            .Using(name, written, value, uat) => {
                let (bind, close) = this.usingLet(name, written, value, uat);
                out.push(bind);
                d = close;
                at = uat;
            }
            _ => { }
        }
        let v = this.valueBlock(Block { stmts = after.toArray(), span = b.span }, expected);
        let rt = typeOf(v);
        let valued = rt != .Void && rt != .Never && rt != .Unknown;
        let tmp = if (valued) this.hidden(rt, at) else -1;
        let body = if (valued) TStmt.SetLocal(tmp, v, at.line) else TStmt.Expr(v, at.line);
        let err = this.errorTy();
        let anyTy = Ty.Named(this.anyIndex);
        out.push(
            TStmt.Finally(
                [body],
                d,
                this.hidden(err, at),
                this.hidden(anyTy, at),
                this.hidden(err, at),
                this.hidden(anyTy, at),
                at.line
            )
        );
        this.popScope();
        return TExpr.Block(
            out.toArray(),
            boxE(if (valued) TExpr.Local(tmp, rt) else TExpr.Unit),
            rt
        );
    }

    mut fn ifStmtValue(cond: Expr, then: Block, otherwise: Stmt, expected: ?Ty, at: Span): TExpr {
        let c = this.condition(cond);
        let before = this.ctx.unassigned;
        this.pushScope();
        this.narrow(this.factsOf(c, true));
        let a = this.valueBlock(then, expected);
        this.popScope();
        let afterThen = this.reached(a);
        this.ctx.unassigned = before;
        this.pushScope();
        this.narrow(this.factsOf(c, false));
        let b = match (otherwise) {
            .Block(ob, _) => this.valueBlock(ob, expected),
            .If(c2, t2, o2, at2) => {
                if (o2 != null) this.ifStmtValue(c2, t2, o2.value, expected, at2) else TExpr.Unit
            }
            _ => TExpr.Unit,
        };
        this.popScope();
        this.ctx.unassigned = afterThen.union(this.reached(b));
        let t = this.unify(typeOf(a), typeOf(b), at);
        return TExpr.If(boxE(c), boxE(this.coerce(a, t, at)), boxE(this.coerce(b, t, at)), t);
    }

    /// `f"…"`: its text and its holes as strings, joined.
    mut fn interpolated(segments: Segment[], at: Span): TExpr {
        let parts = List<TExpr>.new();
        for (seg in segments) {
            match (seg) {
                .Text(s) => {
                    if (s.length() > 0) {
                        parts.push(TExpr.Str(s));
                    }
                }
                .Hole(x, spec) => {
                    if (spec != null) {
                        parts.push(this.notYet("a format spec", "S7e (std.fmt)", at));
                    } else {
                        parts.push(this.stringOf(this.expr(x, null), spanOf(x)));
                    }
                }
            }
        }
        if (parts.length() == 0) {
            return TExpr.Str("");
        }
        if (parts.length() == 1 && typeOf(parts[0]) == .Str) {
            return parts[0];
        }
        return TExpr.Native(Native.Concat, parts.toArray(), Ty.Str);
    }

    /// A value as text, for `print`, `println` and the holes of an f-string.
    mut fn stringOf(v: TExpr, at: Span): TExpr {
        let t = typeOf(v);
        // what gives no value gives no text either: it ends the path (06 §9 rule 2)
        if (t == .Str || t == .Unknown || t == .Never) {
            return v;
        }
        let native: ?Native = match (t) {
            .Int => Native.IntToStr,
            .Float => Native.FloatToStr,
            .Bool => Native.BoolToStr,
            .Char => Native.CharToStr,
            _ => null,
        };
        if (native == null) {
            // a value whose type is a `Display`: its `show()` (Lyric 5 05 §14; S7e3)
            if (let shown = this.shownBy(v, t)) {
                return shown;
            }
            // a type parameter's value as its argument's text, in each copy (S3i)
            match (t) {
                .Param(k) => {
                    this.debugSlotOf();
                    this.textSlotOf();
                    return TExpr.TextParam(boxE(v), k, Ty.Str);
                }
                // an associated type of one, `I.Item`: its answer's text in each copy (S7c6b2)
                .Assoc(_, _, _) => {
                    this.debugSlotOf();
                    this.textSlotOf();
                    return TExpr.TextOf(boxE(v), t, false);
                }
                // an interface value's: the held value's text through its table — a string
                // itself, a `Display`'s `show()` (S7e3; since S3i its Debug form, `"t"`)
                .Named(i) => {
                    if (this.types[i].kind == .Interface) {
                        return TExpr.CallIface(this.textSlotOf(), [v], Ty.Str);
                    }
                }
                _ => { }
            }
            // every other value prints in its Debug form (03 Eq: `{x}` falls back to it)
            return this.debugText(v, t, at);
        }
        return TExpr.Native(native, [v], Ty.Str);
    }

    /// The Debug form of `v` (Lyric 5 05 §14 rule 2): `P { x = 1, y = "a" }`, `E.B(3)`,
    /// `E.R { w = 4 }`, `E.A`, `(1, "a")`, an optional's value or `null`, a string quoted, a
    /// `char` in single quotes — a type's own `debug()` where it is a `Debug` (S7e3).
    mut fn debugText(v: TExpr, t: Ty, at: Span): TExpr {
        return match (t) {
            // between its quotes and escaped as it would be written, Lyric 5's `escapeTo` (S7e3:
            // since S3h only quoted)
            .Str => this.stdNative("string.debug", [v], Ty.Str),
            .Char => this.stdNative("char.debug", [v], Ty.Str),
            .Int => TExpr.Native(Native.IntToStr, [v], Ty.Str),
            .Float => TExpr.Native(Native.FloatToStr, [v], Ty.Str),
            .Bool => TExpr.Native(Native.BoolToStr, [v], Ty.Str),
            .Optional(inner) => {
                let h = this.hidden(t, at);
                let l = TExpr.Local(h, t);
                TExpr.Block(
                    [TStmt.SetLocal(h, v, at.line)],
                    boxE(
                        TExpr.If(
                            boxE(TExpr.IsNull(boxE(l))),
                            boxE(TExpr.Str("null")),
                            boxE(
                                this.debugText(TExpr.Narrow(boxE(l), inner.value), inner.value, at)
                            ),
                            Ty.Str
                        )
                    ),
                    Ty.Str
                )
            }
            .Tuple(tt) => {
                let h = this.hidden(t, at);
                let l = TExpr.Local(h, t);
                let parts = List<TExpr>.new();
                parts.push(TExpr.Str("("));
                var k = 0;
                for (e in tt.elements) {
                    if (k > 0) {
                        parts.push(TExpr.Str(", "));
                    }
                    parts.push(this.debugText(TExpr.Elem(boxE(l), k, e), e, at));
                    k += 1;
                }
                parts.push(TExpr.Str(")"));
                TExpr.Block(
                    [TStmt.SetLocal(h, v, at.line)],
                    boxE(concatAll(parts.toArray())),
                    Ty.Str
                )
            }
            .Named(i) => {
                let info = this.types[i];
                if (info.vmHeld) {
                    // a value the VM holds: its type alone (S7c4b)
                    return TExpr.Str(f"<{this.tyName(t)}>");
                }
                if (info.kind == .Interface) {
                    // the held value's form, through its table (S3i)
                    TExpr.CallIface(this.debugSlotOf(), [v], Ty.Str)
                } else if (info.typeParams.length() > 0
                    || (info.template >= 0 && this.anyParamIn(t))) {
                    // a generic type's form is its template's, copied for the arguments — an
                    // instance's whose arguments name the body's parameters too, so each copy of
                    // the body has its own (S7d4: `Box<T[]>` in a generic `k` printed `k<int>`'s
                    // list as one of objects, since S7c4a)
                    let tmpl = if (info.template >= 0) info.template else i;
                    TExpr.CallGeneric(this.debugFnOf(tmpl, at), info.args, [v], Ty.Str)
                } else {
                    TExpr.Call(this.debugFnOf(i, at), [v], Ty.Str)
                }
            }
            .Param(k) => {
                this.debugSlotOf();
                TExpr.DebugParam(boxE(v), k, Ty.Str)
            }
            .Assoc(_, _, _) => {
                this.debugSlotOf();
                TExpr.TextOf(boxE(v), t, true)
            }
            .Fn(_) => TExpr.Str("<fn>"),
            // the one value of `void`, `()` — Lyric 5 has no empty tuple, `void` stands for it
            // (03 M6-5); what gives it still runs (S7e3: a void task's `Done` could not print
            // where anything printed through a table, since S6a)
            .Void => match (v) {
                .Local(_, _) | .Field(_, _, _) | .Elem(_, _, _) | .Payload(_, _, _, _, _) | .Unbox(_, _) | .Narrow(_, _) => TExpr.Str(
                    "()"
                ),
                _ => TExpr.Block([TStmt.Expr(v, at.line)], boxE(TExpr.Str("()")), Ty.Str),
            },
            .Unknown => v,
            // a list of a type parameter: the loop where it stands, each copy its own (S7c4a)
            .List(_) => if (hasParam(t)) this.listDebugInline(v, t, at)
                else TExpr.Call(this.listDebugFnOf(t, at), [v], Ty.Str),
            _ => if (this.quietDebug) TExpr.Str(f"<{this.tyName(t)}>")
                else this.notYet(f"text of a {this.tyName(t)}", laterClock(t), at),
        };
    }

    /// The slot of every type's Debug form (S3i), given out the first time a value prints
    /// through a table: an interface value's, or a type parameter's in a shared copy.
    mut fn debugSlotOf(): int {
        if (this.debugSlot < 0) {
            this.debugSlot = this.slotCount;
            this.slotCount += 1;
        }
        return this.debugSlot;
    }

    /// A call of the VM's native `name`, as vm/native.lyr's table names it.
    fn stdNative(name: string, args: TExpr[], t: Ty): TExpr {
        let n = nativeNamed(name);
        if (n == null) {
            return TExpr.Unknown;
        }
        return TExpr.Native(Native.Std(nativeNumber(n)), args, t);
    }

    /// `{x}` of a value whose type is a `Display` (Lyric 5 05 §14; S7e3): its `show()` — the
    /// type's own; an interface value's, a type parameter's, an associated type's bound by it
    /// through the table. Null where it is none: the Debug form.
    mut fn shownBy(v: TExpr, t: Ty): ?TExpr {
        let di = this.synth.displayIx;
        if (di < 0) {
            return null;
        }
        let slot = this.slotIn(di, "show");
        match (t) {
            .Param(k) => {
                let g = this.genericFn;
                if (g >= 0 && k < this.functions[g].typeParams.length()) {
                    for (c in this.functions[g].typeParams[k].constraints) {
                        for (a in this.ancestry(c)) {
                            if (a == di) {
                                return TExpr.CallConstraint(k, di, "show", slot, [v], Ty.Str);
                            }
                        }
                    }
                }
            }
            .Assoc(_, ai, an) => {
                for (b in this.boundsOf(ai, an)) {
                    for (a in this.ancestry(b)) {
                        if (a == di) {
                            return TExpr.CallBound(t, di, "show", slot, [v], Ty.Str);
                        }
                    }
                }
            }
            .Named(i) => {
                let info = this.types[i];
                if (!info.vmHeld && this.conformsTo(t, di)) {
                    let tmpl = if (info.template >= 0) info.template else i;
                    if (info.kind == .Interface) {
                        // an interface value's through its table
                        return TExpr.CallIface(slot, [v], Ty.Str);
                    }
                    if (!this.saysItself(tmpl, di) || this.methodOf(tmpl, "show") == null) {
                        // a blanket block's
                        return this.showCall(v);
                    }
                    // a type's own `show()` through a function of the type, as its Debug form is
                    // reached — a generic type's its template's, copied for the arguments (S7e3b:
                    // through `memberCallOn`, which is made for the copies, an instance of a
                    // generic class printed empty while the top level was checked)
                    if (info.typeParams.length() > 0
                        || (info.template >= 0 && this.anyParamIn(t))) {
                        return TExpr.CallGeneric(this.showFnOf(tmpl), info.args, [v], Ty.Str);
                    }
                    return TExpr.Call(this.showFnOf(i), [v], Ty.Str);
                }
            }
            // a tuple of `Display`s, through the prelude's block of its arity (S7e3b) — called as
            // `x.show()` is written
            .Tuple(_) => {
                if (this.conformsTo(t, di)) {
                    return this.showCall(v);
                }
            }
            _ => { }
        }
        return null;
    }

    /// `v.show()` as it is written (S7e3b): `memberCallOn`, made for the copies, gave a tuple a
    /// wrong text while the top level was checked. The call in progress keeps what it expects.
    mut fn showCall(v: TExpr): TExpr {
        let expected = this.callExpected;
        let written = this.writtenArgs;
        let call = this.methodCall(v, "show", [], nowhereSpan, nowhereSpan);
        this.callExpected = expected;
        this.writtenArgs = written;
        return call;
    }

    /// `x.debug()` and `x.debugTo(out)` where `x`'s type writes neither (S7e3): every value is a
    /// `Debug` (03 Eq), its Debug form — `debugTo` appends it to the builder; through a type
    /// parameter or an interface value a type's own `debugTo` is not called (12 deviation). Null
    /// for another call, or the type's own.
    mut fn synthDebug(t: Ty, receiver: TExpr, method: string, args: Arg[], at: Span): ?TExpr {
        // a list's `show()` and `showTo(out)` alike: its text is its Debug form (S7e3b)
        let list = match (t) {
            .List(_) => true,
            _ => false,
        };
        let to = (method == "debugTo" || (list && method == "showTo")) && args.length() == 1;
        let one = (method == "debug" || (list && method == "show")) && args.length() == 0;
        if (this.synth.debugIx < 0
            || this.synth.builderIx < 0
            || t == .Unknown
            || !(to || one)
            || this.writesMember(t, method)) {
            return null;
        }
        if (!to) {
            return this.debugText(receiver, t, at);
        }
        // the receiver first, as a call takes it
        let h = this.hidden(t, at);
        let sb = Ty.Named(this.synth.builderIx);
        let out = this.coerce(this.expr(args[0].value, sb), sb, spanOf(args[0].value));
        let append = this.types[this.synth.builderIx].methods.get("appendStr") ?? -1;
        return TExpr.Block(
            [TStmt.SetLocal(h, receiver, at.line)],
            boxE(TExpr.Call(append, [out, this.debugText(TExpr.Local(h, t), t, at)], Ty.Void)),
            Ty.Void
        );
    }

    /// Whether `t` has a member `name` written for it — its own, an interface's but `Debug`'s, a
    /// type parameter's constraint's, an associated type's bound's (S7e3).
    mut fn writesMember(t: Ty, name: string): bool {
        let di = this.synth.debugIx;
        match (t) {
            .Param(k) => {
                let g = this.genericFn;
                if (g >= 0 && k < this.functions[g].typeParams.length()) {
                    for (c in this.functions[g].typeParams[k].constraints) {
                        if (let found = this.ifaceMember(c, name)) {
                            let (fi, _) = found;
                            if (this.functions[fi].owner != di) {
                                return true;
                            }
                        }
                    }
                }
                return false;
            }
            .Assoc(_, ai, an) => {
                for (b in this.boundsOf(ai, an)) {
                    if (let found = this.ifaceMember(b, name)) {
                        let (fi, _) = found;
                        if (this.functions[fi].owner != di) {
                            return true;
                        }
                    }
                }
                return false;
            }
            .Named(i) => {
                if (this.types[i].kind == .Interface) {
                    if (let found = this.ifaceMember(i, name)) {
                        let (fi, _) = found;
                        return this.functions[fi].owner != di;
                    }
                    return false;
                }
                return this.hasMember(t, name);
            }
            _ => {
                let entry = this.entryOf(t);
                return entry >= 0 && this.methodOf(entry, name) != null;
            }
        }
    }

    /// The slot of every type's text (S7e3), given out the first time a value prints alone through
    /// a table: an interface value's `{x}`, a type parameter's in a shared copy.
    mut fn textSlotOf(): int {
        if (this.synth.textSlot < 0) {
            this.synth.textSlot = this.slotCount;
            this.slotCount += 1;
        }
        return this.synth.textSlot;
    }

    /// Every type's text in the text slot (S7e3): a `Display`'s `show()`, a scalar's and a
    /// string's own text out of their boxes, any other value's Debug form.
    mut fn fillTextSlot(): void {
        if (this.synth.textSlot >= 0) {
            this.fillSlot(this.synth.textSlot, true);
        }
    }

    /// Every type's Debug form in its table's slot, where something prints through one: a
    /// generic type's its template's, which each instance copies; a scalar's, a string's and a
    /// plain enum's out of their boxes; a function value's `<fn>`.
    mut fn fillDebugSlot(): void {
        if (this.debugSlot >= 0) {
            this.fillSlot(this.debugSlot, false);
        }
    }

    /// Every type's text — its Debug form where not `text` — in table slot `slot`.
    mut fn fillSlot(slot: int, text: bool): void {
        this.quietDebug = true;
        let n = this.types.length();
        var i = 0;
        while (i < n) {
            let info = this.types[i];
            let instance = info.template >= 0 && info.template != i;
            // the lists' entry holds no list; each instance of it, its element's list (S7c3)
            let lists = info.kind == .Builtin && info.name == "List";
            if ((info.kind == .Builtin && instance) || info.vmHeld) {
                info.witness.insert(slot, this.boxTextOf(i, text));
            } else if (info.kind != .Interface && !instance && !lists) {
                let f = if (info.kind == .Builtin
                    || (info.kind == .Enum && !info.payload)) this.boxTextOf(i, text)
                    else if (text) this.showFnOf(i) else this.debugFnOf(i, nowhereSpan);
                info.witness.insert(slot, f);
            }
            i += 1;
        }
        // a function value's, `<fn>` in either slot
        if (this.fnDebug < 0) {
            this.fnDebug = this.textFn("<fn>");
        }
        this.quietDebug = false;
    }

    /// The text of a value of type `i` for the text slot (S7e3): its own `show()` where it is a
    /// `Display` of its own writing — a method of the type, as a table's slot holds it —, else
    /// its Debug form's function.
    mut fn showFnOf(i: int): int {
        let key = f"show:{i}";
        if (let known = this.synth.fns.get(key)) {
            return known;
        }
        let di = this.synth.displayIx;
        let info = this.types[i];
        let t = Ty.Named(i);
        let own = if (di >= 0 && this.saysItself(i, di)) this.methodOf(i, "show") ?? -1 else -1;
        // a `show()` a blanket block gives the type, reached when the slot is filled, the bodies
        // checked
        let blanket = own < 0
            && di >= 0
            && info.typeParams.length() == 0
            && this.blanketGives(t, di) >= 0;
        if (!blanket
            && (own < 0
                || this.functions[own].params.length() != 0
                || this.functions[own].isStatic)) {
            return this.debugFnOf(i, nowhereSpan);
        }
        let index = this.functions.length();
        this.functions.push(FnInfo { name = "#show", owner = i, isStatic = false, line = 1 });
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        this.synth.fns.insert(key, index);
        let saved = this.ctx;
        this.ctx = FnCtx.new(index, Ty.Str, false, false);
        this.declareLocal("x", t, false, nowhereSpan);
        let x = TExpr.Local(0, t);
        // an instance's arguments, a template's own parameters, as `debugFnOf` takes them
        let ps = List<Ty>.new();
        if (info.template >= 0) {
            for (a in info.args) {
                ps.push(a);
            }
        } else {
            var k = 0;
            for (_ in info.typeParams) {
                ps.push(Ty.Param(k));
                k += 1;
            }
        }
        let body = if (blanket) this.memberCallOn(
            t,
            di,
            "show",
            this.slotIn(di, "show"),
            [x],
            Ty.Str
        )
            else if (this.functions[own].typeParams.length() > 0) TExpr.CallGeneric(
                own,
                ps.toArray(),
                [x],
                Ty.Str
            )
                else TExpr.Call(own, [x], Ty.Str);
        let f = this.functions[index];
        f.returns = Ty.Str;
        f.locals = this.ctx.locals.toArray();
        f.boxed = this.ctx.boxed.toArray();
        f.body = [TStmt.Return(body, 1)];
        if (info.typeParams.length() > 0) {
            // a template's: copied for each instance, as `debugFnOf`'s is
            f.typeParams = info.typeParams;
            f.template = f.body;
            f.body = [];
        }
        this.ctx = saved;
        return index;
    }

    /// A function of the table that gives `text` for any value: a function value's form.
    mut fn textFn(text: string): int {
        let anyTy = Ty.Named(this.anyIndex);
        let index = this.functions.length();
        this.functions.push(FnInfo { name = "#text", owner = -1, isStatic = true, line = 1 });
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let f = this.functions[index];
        f.params = [ParamInfo { name = "x", ty = anyTy, default = null }];
        f.returns = Ty.Str;
        f.locals = [anyTy];
        f.boxed = [false];
        f.body = [TStmt.Return(TExpr.Str(text), 1)];
        return index;
    }

    /// The Debug form of a boxed value of type `i` — its text where `text` (S7e3) —, for its box's
    /// table: the value out of the box.
    mut fn boxTextOf(i: int, text: bool): int {
        let anyTy = Ty.Named(this.anyIndex);
        let t = this.selfTy(i);
        let index = this.functions.length();
        this.functions.push(
            FnInfo {
                name = this.types[i].name + (if (text) "#textbox" else "#debugbox"),
                owner = -1,
                isStatic = true,
                line = 1,
            }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let saved = this.ctx;
        this.ctx = FnCtx.new(index, Ty.Str, false, false);
        this.declareLocal("x", anyTy, false, nowhereSpan);
        let held = TExpr.Unbox(boxE(TExpr.Local(0, anyTy)), t);
        let body = if (text) this.stringOf(held, nowhereSpan)
            else this.debugText(held, t, nowhereSpan);
        let f = this.functions[index];
        f.params = [ParamInfo { name = "x", ty = anyTy, default = null }];
        f.returns = Ty.Str;
        f.locals = this.ctx.locals.toArray();
        f.boxed = this.ctx.boxed.toArray();
        f.body = [TStmt.Return(body, 1)];
        this.ctx = saved;
        return index;
    }

    /// The function giving the Debug form of a value of type `i`, made once.
    mut fn debugFnOf(i: int, at: Span): int {
        let known = this.debugFns.get(i);
        if (known != null) {
            return known;
        }
        let info = this.types[i];
        let t = Ty.Named(i);
        let index = this.functions.length();
        // a method of the type, its receiver the value: what a table's slot holds; the name
        // without the type arguments, as the type is declared
        this.functions.push(
            FnInfo { name = "#debug", owner = i, isStatic = false, line = at.line }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        this.debugFns.insert(i, index);
        let saved = this.ctx;
        this.ctx = FnCtx.new(index, Ty.Str, false, false);
        this.declareLocal("x", t, false, at);
        let x = TExpr.Local(0, t);
        let name = declaredName(info.name);
        var body = TExpr.Str(name);
        // a type that is a `Debug` of its own writing: its `debug()` (S7e3; since S7d2 the
        // prelude's types alone, a map's `{"a": 1}`)
        let ownDebug = if (this.synth.debugIx >= 0
            && this.saysItself(i, this.synth.debugIx)) this.methodOf(i, "debug") ?? -1
            else -1;
        if (ownDebug >= 0
            && this.functions[ownDebug].params.length() == 0
            && !this.functions[ownDebug].isStatic) {
            // an instance's arguments, a template's own parameters
            let ps = List<Ty>.new();
            if (info.template >= 0) {
                for (a in info.args) {
                    ps.push(a);
                }
            } else {
                var k = 0;
                for (_ in info.typeParams) {
                    ps.push(Ty.Param(k));
                    k += 1;
                }
            }
            body = if (this.functions[ownDebug].typeParams.length() > 0) TExpr.CallGeneric(
                ownDebug,
                ps.toArray(),
                [x],
                Ty.Str
            )
                else TExpr.Call(ownDebug, [x], Ty.Str);
        } else if (info.kind == .Struct || info.kind == .Class) {
            body = concatAll(
                this.fieldsText(
                    name,
                    info.fields,
                    (k: int, ft: Ty) => TExpr.Field(boxE(x), k, ft),
                    at
                )
            );
        } else {
            // the variant the tag names, its payload after it
            var rest = TExpr.Str(name);
            var v = info.variants.length() - 1;
            while (v >= 0) {
                let vf = info.variantFields[v];
                let head = f"{name}.{info.variants[v]}";
                var text = TExpr.Str(head);
                if (info.variantNamed[v]) {
                    let vv = v;
                    text = concatAll(
                        this.fieldsText(
                            head,
                            vf,
                            (k: int, ft: Ty) => TExpr.Payload(boxE(x), i, vv, k, ft),
                            at
                        )
                    );
                } else if (vf.length() > 0) {
                    let parts = List<TExpr>.new();
                    parts.push(TExpr.Str(head + "("));
                    var k = 0;
                    for (f in vf) {
                        if (k > 0) {
                            parts.push(TExpr.Str(", "));
                        }
                        parts.push(this.debugText(TExpr.Payload(boxE(x), i, v, k, f.ty), f.ty, at));
                        k += 1;
                    }
                    parts.push(TExpr.Str(")"));
                    text = concatAll(parts.toArray());
                }
                let isV = TExpr.Binary(
                    boxE(TExpr.Tag(boxE(x))),
                    BinaryOp.Eq,
                    boxE(TExpr.Int(v)),
                    Ty.Bool
                );
                rest = TExpr.If(boxE(isV), boxE(text), boxE(rest), Ty.Str);
                v -= 1;
            }
            body = rest;
        }
        let dbg = this.functions[index];
        dbg.returns = Ty.Str;
        dbg.locals = this.ctx.locals.toArray();
        dbg.boxed = this.ctx.boxed.toArray();
        dbg.body = [TStmt.Return(body, at.line)];
        if (info.typeParams.length() > 0) {
            // a template's: copied for each instance, its arguments from the receiver's
            dbg.typeParams = info.typeParams;
            dbg.template = dbg.body;
            dbg.body = [];
        }
        this.ctx = saved;
        return index;
    }

    /// `Name { a = …, b = … }`: each field's Debug form after its name.
    mut fn fieldsText(
        name: string,
        fields: FieldInfo[],
        read: fn(int, Ty) -> TExpr,
        at: Span
    ): TExpr[] {
        let parts = List<TExpr>.new();
        if (fields.length() == 0) {
            parts.push(TExpr.Str(name + " { }"));
            return parts.toArray();
        }
        parts.push(TExpr.Str(name + " { "));
        var k = 0;
        for (f in fields) {
            if (k > 0) {
                parts.push(TExpr.Str(", "));
            }
            parts.push(TExpr.Str(f.name + " = "));
            parts.push(this.debugText(read(k, f.ty), f.ty, at));
            k += 1;
        }
        parts.push(TExpr.Str(" }"));
        return parts.toArray();
    }

    // --- calls -----------------------------------------------------------------------------------

    /// A call whose arguments spread an array, `f(xs...)`: refused where the function it reaches
    /// takes no variadic parameter (`LYS-SEM0166`; S7e4a).
    mut fn spreadingCall(callee: Expr, args: Arg[], expected: ?Ty, at: Span): TExpr {
        var dots: ?Span = null;
        for (a in args) {
            if (dots == null) {
                dots = a.spread;
            }
        }
        if (dots == null) {
            return this.call(callee, args, expected, at);
        }
        let saved = this.synth.spreadTaken;
        this.synth.spreadTaken = false;
        let r = this.call(callee, args, expected, at);
        let taken = this.synth.spreadTaken;
        this.synth.spreadTaken = saved;
        if (!taken) {
            this.error(
                "LYS-SEM0166",
                "'...' spreads an array over a variadic parameter, and what this calls has none",
                dots
            );
        }
        return r;
    }

    mut fn call(callee: Expr, args: Arg[], expected: ?Ty, at: Span): TExpr {
        match (callee) {
            // `.Num(3)`: a variant of the enum the position expects
            // `f<int>(x)`: the type arguments bound before the arguments are checked
            .Instance(inner, targs, iat) => {
                let tys = List<Ty>.new();
                for (x in targs) {
                    tys.push(this.writtenType(x));
                }
                match (inner.value) {
                    .Name(name, _) => {
                        let candidates = this.fnByName.get(this.q(name));
                        if (candidates != null) {
                            let fitting = List<int>.new();
                            var filled: Ty[] = tys.toArray();
                            for (c in candidates) {
                                // the trailing ones it leaves out, their defaults (S7c5c1)
                                if (let all = this.withDefaults(
                                    this.functions[c].typeParams,
                                    tys.toArray(),
                                    null
                                )) {
                                    if (all.length() == this.functions[c].typeParams.length()) {
                                        fitting.push(c);
                                        filled = all;
                                    }
                                }
                            }
                            if (fitting.length() == 0) {
                                this.error(
                                    "LYS-SEM0026",
                                    f"no '{name}' takes {tys.length()} type arguments",
                                    iat
                                );
                                return TExpr.Unknown;
                            }
                            this.presetBinds = filled;
                            let call = this.callAmong(name, fitting.toArray(), null, args, at);
                            this.presetBinds = [];
                            return call;
                        }
                    }
                    // `it.collect<int[]>()`: at a method of a value (Lyric 5 §9.2 rule 4)
                    .Member(object, method, false, memberAt) => {
                        let isValue = match (object.value) {
                            .Name(n, _) => this.lookupLocal(n) != null
                                || this.globalIndex.containsKey(this.q(n)),
                            _ => true,
                        };
                        if (isValue) {
                            let recv = this.expr(object.value, null);
                            this.callExpected = expected;
                            this.writtenArgs = tys.toArray();
                            this.writtenTaken = false;
                            let call = this.methodCall(recv, method, args, at, memberAt);
                            if (!this.writtenTaken) {
                                this.error(
                                    "LYS-SEM0026",
                                    f"'{method}' takes no type arguments",
                                    iat
                                );
                            }
                            this.writtenArgs = [];
                            this.callExpected = null;
                            return call;
                        }
                    }
                    _ => { }
                }
                this.error(
                    "LYS-SEM0013",
                    "type arguments are written at a generic function's call",
                    iat
                );
                return TExpr.Unknown;
            }
            .Implicit(name, nameAt) => {
                let i = this.expectedEnum(expected);
                if (i < 0) {
                    this.error(
                        "LYS-SEM0113",
                        f"'.{name}' needs an enum where it stands: name it, as E.{name}(…)",
                        nameAt
                    );
                    return TExpr.Unknown;
                }
                let k = this.variantIndex(i, name);
                if (k < 0) {
                    this.error(
                        "LYS-SEM0012",
                        f"'{this.types[i].name}' has no variant '{name}'",
                        nameAt
                    );
                    return TExpr.Unknown;
                }
                return this.variantCall(i, k, args, at);
            }
            .Name(name, nameAt) => {
                // the VM's intrinsics (S6d2): `__…` names the prelude's source calls, and the
                // standard library's modules (S7a), alone
                if (name.startsWith("__")) {
                    if (nameAt.file != -1 && this.pkgOf(nameAt.file) != stdPackage) {
                        this.error("LYS-SEM0002", f"nothing in scope is named '{name}'", nameAt);
                        return TExpr.Unknown;
                    }
                    if (isIntrinsic(name)) {
                        return this.intrinsic(name, args, expected, at);
                    }
                }
                // a generator lambda's body (S6b2): no name of the program
                if (name == "<generator>" && args.length() == 1) {
                    let co = this.coroutineArgs(expected ?? Ty.Unknown);
                    if (co.length() == 2) {
                        return this.generatorOf(args[0].value, co[0], co[1], "LYS-SEM0046", at);
                    }
                    return this.generatorOf(args[0].value, null, null, "LYS-SEM0046", at);
                }
                let bound = this.lookupLocal(name) != null
                    || (this.ctx.isLambda && this.capture(this.ctx, name, nameAt) >= 0)
                    || this.globalIndex.containsKey(this.q(name));
                if (bound) {
                    return this.callValue(this.name(name, null, nameAt), args, at);
                }
                let candidates = this.fnByName.get(this.q(name));
                if (candidates != null) {
                    this.callExpected = expected;
                    return this.callAmong(name, candidates.toArray(), null, args, at);
                }
                if (name == "print" || name == "println") {
                    return this.prelude(name, args, at);
                }
                // a task (07 N4): `spawn { … }`; the task gives way: `yieldNow()` (N8)
                if (name == "spawn") {
                    // a task of the top level's scope: its end waits for it (S6a) — a scope's tasks
                    // are their scope's, so `scope.spawn` leaves the flag alone (S6d3)
                    let made = this.spawnOf(args, at);
                    match (made) {
                        .Spawn(_, _) => {
                            this.spawns = true;
                        }
                        _ => { }
                    }
                    return made;
                }
                if (name == "spawnDetached") {
                    return this.spawnDetachedOf(args, at);
                }
                // `sequence { … }` (Lyric 5 10 §1 rule 12)
                if (name == "sequence") {
                    return this.sequenceOf(args, expected, at);
                }
                if (name == "yieldNow") {
                    if (args.length() > 0) {
                        this.error("LYS-SEM0014", "yieldNow() takes no argument", at);
                    }
                    return TExpr.YieldNow;
                }
                if (name == "panic"
                    || name == "unreachable"
                    || name == "todo"
                    || name == "assert") {
                    return this.panicking(name, args, at);
                }
                let index = this.typeIndex.get(this.q(name));
                if (index != null) {
                    // `Point(1, 2)` is `Point.new(1, 2)` (05 D11)
                    this.callExpected = expected;
                    return this.staticCall(index, "new", args, at);
                }
                return this.name(name, null, nameAt);
            }
            .Member(object, method, optional, memberAt) => {
                if (optional) {
                    let held = this.optionalReceiver(object.value, memberAt);
                    if (held == null) {
                        return TExpr.Unknown;
                    }
                    let (o, tmp, inner) = held;
                    let present = TExpr.Narrow(boxE(TExpr.Local(tmp, typeOf(o))), inner);
                    // the arguments may not be evaluated: what they assign does not count
                    let before = this.ctx.unassigned;
                    let access = this.methodCall(present, method, args, at, memberAt);
                    this.ctx.unassigned = before;
                    return this.optChain(tmp, o, access, at);
                }
                match (object.value) {
                    .Name(typeName, _) => {
                        if (this.lookupLocal(typeName) == null
                            && !this.globalIndex.containsKey(this.q(typeName))) {
                            // `util.f(x)`, `util.Point(1, 2)`: through a module's name
                            if (let target = this.moduleNamed(typeName)) {
                                return this.moduleCall(target, method, args, at, memberAt);
                            }
                            let pk = this.typeParams.get(typeName);
                            if (pk != null) {
                                return this.paramStatic(pk, method, args, at);
                            }
                            if (typeName == "Self") {
                                let s = this.selfTyIs;
                                if (s != null) {
                                    let si = this.entryOf(s);
                                    if (si >= 0) {
                                        this.callExpected = expected;
                                        return this.staticCall(si, method, args, at);
                                    }
                                }
                            }
                            let index = this.typeIndex.get(this.q(typeName));
                            if (index != null) {
                                this.callExpected = expected;
                                return this.staticCall(index, method, args, at);
                            }
                            // `char.fromDigit(n, 16)`, `string.fromChars(cs)`: a static of a
                            // built-in type, its extend blocks' (S7e1)
                            if (isScalarOrString(typeName)) {
                                let bi = this.typeNamed(typeName);
                                if (bi >= 0) {
                                    this.callExpected = expected;
                                    return this.staticCall(bi, method, args, at);
                                }
                            }
                        }
                    }
                    // `Channel<int>.new(1)`: a static function of a type instance (S6d1)
                    .Instance(inner, targs, _) => {
                        match (inner.value) {
                            // `List<int>.of(xs)`: a static of the lists' block, its element
                            // written (S7c6c2; a `List<T>` is a `T[]`)
                            .Name("List", _) if (targs.length() == 1) => {
                                let entry = this.typeNamed("List");
                                if (entry >= 0) {
                                    this.presetBinds = [this.resolveType(targs[0])];
                                    this.callExpected = expected;
                                    let call = this.staticCall(entry, method, args, at);
                                    this.presetBinds = [];
                                    return call;
                                }
                            }
                            .Name(typeName, _) => {
                                let index = this.typeIndex.get(this.q(typeName));
                                if (index != null
                                    && this.types[index].typeParams.length() == targs.length()) {
                                    let tys = List<Ty>.new();
                                    for (x in targs) {
                                        tys.push(this.resolveType(x));
                                    }
                                    // the written arguments bind the type's parameters of its
                                    // static, `Map<string, int>.withCapacity(4)` (S7d2: dropped)
                                    this.presetBinds = tys.toArray();
                                    this.callExpected = expected;
                                    let call = this.staticCall(
                                        this.typeInstance(index, tys.toArray()),
                                        method,
                                        args,
                                        at
                                    );
                                    this.presetBinds = [];
                                    return call;
                                }
                            }
                            _ => { }
                        }
                    }
                    // `util.Counter.start()`: a static function of a module's type
                    .Member(inner, typeName, false, _) => {
                        let index = this.moduleType(inner.value, typeName, at);
                        if (index >= 0) {
                            this.callExpected = expected;
                            return this.staticCall(index, method, args, at);
                        }
                        if (index == -2) {
                            return TExpr.Unknown;
                        }
                    }
                    _ => { }
                }
                let recv = this.expr(object.value, null);
                this.callExpected = expected;
                return this.methodCall(recv, method, args, at, memberAt);
            }
            _ => { }
        }
        return this.callValue(this.expr(callee, null), args, at);
    }

    /// `f(a, b)` where `f` is a function value: the arguments by position (Lyric 5 03 §8.1).
    mut fn callValue(f: TExpr, args: Arg[], at: Span): TExpr {
        let t = typeOf(f);
        match (t) {
            .Fn(ft) => {
                if (args.length() != ft.params.length()) {
                    this.error(
                        "LYS-SEM0014",
                        f"the function takes {ft.params.length()} values; {args.length()} are given",
                        at
                    );
                    return TExpr.Unknown;
                }
                let values = List<TExpr>.new();
                var k = 0;
                for (a in args) {
                    if (a.name != null) {
                        this.error(
                            "LYS-SEM0119",
                            "a function value takes its arguments by position",
                            spanOf(a.value)
                        );
                    }
                    let pt = ft.params[k];
                    values.push(this.coerce(this.expr(a.value, pt), pt, spanOf(a.value)));
                    k += 1;
                }
                return TExpr.CallValue(boxE(f), values.toArray(), ft.result.value);
            }
            .Unknown => {
                return TExpr.Unknown;
            }
            _ => {
                this.error("LYS-SEM0013", f"{this.tyName(t)} is no function: it is not called", at);
                return TExpr.Unknown;
            }
        }
    }

    // --- lambdas and function values --------------------------------------------------------------

    /// Name `name` as the lambda of context `c` sees it in the functions around it: the index of
    /// its capture, made where it is first used; -1 where none binds it. A `let` and a parameter
    /// are captured as a copy, a `var` as its box, which the function around shares.
    mut fn capture(c: FnCtx, name: string, at: Span): int {
        let known = c.captureIndex.get(name);
        if (known != null) {
            return known;
        }
        let outer = c.outer;
        if (outer == null) {
            return -1;
        }
        var source = TExpr.Unknown;
        var ty = Ty.Unknown;
        var cell = false;
        let id = lookupIn(outer, name);
        if (id != null) {
            ty = outer.locals[id];
            if (outer.unassigned.contains(id)) {
                this.error(
                    "LYS-SEM0018",
                    f"'{name}' is captured where it may not be assigned yet",
                    at
                );
            }
            if (outer.localIsVar[id]) {
                outer.boxed[id] = true;
                cell = true;
                source = TExpr.CellOf(id, Ty.Cell(boxTy(ty)));
            } else {
                source = TExpr.Local(id, ty);
            }
        } else {
            if (!outer.isLambda) {
                return -1;
            }
            let k = this.capture(outer, name, at);
            if (k < 0) {
                return -1;
            }
            let theirs = outer.captures[k];
            ty = theirs.ty;
            cell = theirs.isCell;
            source = TExpr.Captured(k, if (cell) Ty.Cell(boxTy(ty)) else ty);
        }
        c.captures.push(Capture { name = name, source = source, ty = ty, isCell = cell });
        let k = c.captures.length() - 1;
        c.captureIndex.insert(name, k);
        return k;
    }

    /// A lambda (Lyric 5 03 §8.2): its parameters' types written or from the function type the
    /// position expects; a trailing block without names takes `it`, or nothing.
    /// `t` with each associated type of a type parameter that a constraint of the generic in
    /// check fixes put in its place: an instance's field, read in the generic, names `I.Item`
    /// where `I :: [Iterator<Item = T>]` makes it `T` (S7c6b) — an instance over a type parameter
    /// is shared by every generic that names one there.
    mut fn settle(t: Ty): Ty {
        return match (t) {
            .Assoc(b, ii, n) => match (b.value) {
                .Param(k) => this.fixedAt(k, n, ii) ?? t,
                _ => t,
            },
            .Optional(e) => Ty.Optional(boxTy(this.settle(e.value))),
            .List(e) => Ty.List(boxTy(this.settle(e.value))),
            .Fn(ft) => {
                let ps = List<Ty>.new();
                for (x in ft.params) {
                    ps.push(this.settle(x));
                }
                Ty.Fn(FnTy { params = ps.toArray(), result = boxTy(this.settle(ft.result.value)) })
            }
            .Tuple(tt) => {
                let es = List<Ty>.new();
                for (x in tt.elements) {
                    es.push(this.settle(x));
                }
                Ty.Tuple(TupleTy { elements = es.toArray(), labels = tt.labels })
            }
            _ => t,
        };
    }

    mut fn lambda(
        params: LambdaParam[],
        result: ?TypeExpr,
        body: Expr,
        implicit: bool,
        expected: ?Ty,
        at: Span
    ): TExpr {
        // what the generic in check fixes stands in the position's type (S7c6b)
        var settled: ?Ty = null;
        if (let e = expected) {
            settled = this.settle(e);
        }
        let want = expectedFn(settled);
        let names = List<string>.new();
        let tys = List<Ty>.new();
        if (implicit) {
            if (want == null || want.params.length() > 1) {
                this.error(
                    "LYS-SEM0045",
                    if (want
                        == null) "this block's parameter has no type: the position expects no function"
                        else f"the function takes {want.params.length()} parameters: name them before '=>'",
                    at
                );
                return TExpr.Unknown;
            }
            if (want.params.length() == 1) {
                names.push("it");
                tys.push(want.params[0]);
            }
        } else {
            let fits = want != null && want.params.length() == params.length();
            if (want != null && !fits) {
                this.error(
                    "LYS-SEM0001",
                    f"the position expects a function of {want.params.length()} parameters; this lambda takes {params.length()}",
                    at
                );
            }
            var k = 0;
            for (p in params) {
                names.push(p.name);
                let written = p.type;
                if (written != null) {
                    tys.push(this.resolveType(written));
                } else if (want != null && fits) {
                    tys.push(want.params[k]);
                } else {
                    this.error(
                        "LYS-SEM0045",
                        f"'{p.name}' has no type: write it, or pass the lambda where a function type is expected",
                        p.span
                    );
                    tys.push(Ty.Unknown);
                }
                k += 1;
            }
        }
        var rt: ?Ty = null;
        if (result != null) {
            rt = this.resolveType(result);
        } else if (want != null && !hasParam(want.result.value) && want.result.value != .Unknown) {
            // a position that does not know the result — `spawn { … }`'s — leaves it to the body
            rt = want.result.value;
        }
        // a generator lambda (Lyric 5 10 §1 rule 11): a yield of its own makes each call give a
        // coroutine over the call's arguments and the lambda's captures — its body that of a
        // closure the call wraps, typed by the lambda's result type where one is known
        var made = body;
        match (body) {
            .Block(b, bat) => {
                if (hasOwnYield(b)) {
                    made = Expr.Call(
                        Box<Expr> { value = Expr.Name("<generator>", bat) },
                        [Arg { name = null, value = body }],
                        bat
                    );
                }
            }
            _ => { }
        }
        return this.makeLambda("<lambda>", names.toArray(), tys.toArray(), rt, made, at);
    }

    /// The function of a lambda or a local function: a function of its own whose first parameter,
    /// local 0, is its function value — a local function's name for itself — and the function value
    /// built where the lambda stands, holding what it captures.
    mut fn makeLambda(
        selfName: string,
        names: string[],
        tys: Ty[],
        result: ?Ty,
        body: Expr,
        at: Span
    ): TExpr {
        let index = this.functions.length();
        this.functions.push(
            FnInfo {
                name = selfName,
                owner = -1,
                isStatic = true,
                line = at.line,
                file = this.fileText(fileModule(at.file)),
            }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let info = this.functions[index];
        let params = List<ParamInfo>.new();
        var k = 0;
        for (n in names) {
            params.push(ParamInfo { name = n, ty = tys[k], default = null });
            k += 1;
        }
        info.params = params.toArray();
        info.env = true;
        let saved = this.ctx;
        let savedFacts = this.postFacts;
        let gen = this.pendingBody;
        this.pendingBody = null;
        this.ctx = FnCtx.new(
            index,
            result ?? Ty.Unknown,
            false,
            saved.fixing || (gen != null && gen.quiet)
        );
        this.ctx.isLambda = true;
        this.ctx.outer = saved;
        if (gen != null) {
            this.ctx.yields = gen.y;
            this.ctx.yieldsInferred = gen.inferY;
            this.ctx.returnsInferred = gen.inferR;
            if (gen.inferR) {
                this.ctx.returns = gen.r;
            }
        }
        this.declareLocal(
            selfName,
            Ty.Fn(FnTy { params = tys, result = boxTy(result ?? Ty.Unknown) }),
            false,
            at
        );
        k = 0;
        for (n in names) {
            this.declareLocal(n, tys[k], false, at);
            k += 1;
        }
        var rt = result;
        let stmts = List<TStmt>.new();
        match (body) {
            .Block(b, _) => {
                if (gen != null) {
                    // a coroutine's body (S6b): statements, its result given by `return` (Lyric 5
                    // 10 §1 rule 3) — inferred from the returns where nothing gives it
                    for (st in this.stmtList(b.stmts)) {
                        stmts.push(st);
                    }
                    if (rt == null) {
                        rt = if (this.ctx.returns == .Unknown) Ty.Void else this.ctx.returns;
                    }
                    let want = rt ?? Ty.Void;
                    if (want != .Void && want != .Unknown && !endsAll(stmts.toArray())) {
                        this.error(
                            gen.pathCode,
                            f"the coroutine can reach its end without returning its {this.tyName(want)}",
                            at
                        );
                    }
                } else if (rt == Ty.Void) {
                    for (st in this.stmtList(b.stmts)) {
                        stmts.push(st);
                    }
                } else {
                    // a block's last expression is its value (Lyric 5 03 §8.2 rule 3)
                    let v = this.valueBlock(b, rt);
                    let vt = typeOf(v);
                    if (rt == null) {
                        rt = if (vt == .Never) Ty.Void else vt;
                    }
                    let want = rt ?? Ty.Void;
                    if (want == .Void || vt == .Void || vt == .Never) {
                        stmts.push(TStmt.Expr(v, at.line));
                        if (want != .Void && want != .Unknown && vt == .Void && !blockEnds(v)) {
                            this.error(
                                "LYS-SEM0017",
                                f"the lambda can reach its end without giving its {this.tyName(want)}",
                                at
                            );
                        }
                    } else {
                        stmts.push(TStmt.Return(this.coerce(v, want, at), at.line));
                    }
                }
            }
            _ => {
                let v = this.expr(body, rt);
                if (rt == null) {
                    rt = typeOf(v);
                }
                let want = rt ?? Ty.Void;
                if (want == .Void) {
                    // `() => say()`: the call runs, and the lambda gives nothing
                    stmts.push(TStmt.Expr(v, at.line));
                } else {
                    stmts.push(TStmt.Return(this.coerce(v, want, spanOf(body)), at.line));
                }
            }
        }
        let resultTy = rt ?? Ty.Void;
        info.returns = resultTy;
        if (gen != null) {
            // what a generator's caller types the coroutine with — `Unknown` kept where the
            // inference failed, for the second pass to report (S6b2)
            this.lastYields = this.ctx.yields ?? Ty.Void;
            this.lastReturns = if (gen.inferR) this.ctx.returns else resultTy;
        }
        info.body = stmts.toArray();
        info.locals = this.ctx.locals.toArray();
        info.boxed = this.ctx.boxed.toArray();
        let infos = List<CaptureInfo>.new();
        let sources = List<TExpr>.new();
        for (c in this.ctx.captures) {
            infos.push(
                CaptureInfo { ty = if (c.isCell) Ty.Cell(boxTy(c.ty)) else c.ty, isCell = c.isCell }
            );
            sources.push(c.source);
        }
        info.captures = infos.toArray();
        if (this.genericFn >= 0) {
            info.templateOf = this.genericFn;
            info.template = info.body;
            info.body = [];
        }
        this.ctx = saved;
        this.postFacts = savedFacts;
        return TExpr.Closure(
            index,
            sources.toArray(),
            Ty.Fn(FnTy { params = tys, result = boxTy(resultTy) })
        );
    }

    /// `fn name(…) { … }` in a block (Lyric 5 03 §8.6): a named closure, bound as a `let` from
    /// here on; in its own body its name is itself.
    mut fn localFn(f: FnDecl): TStmt {
        let names = List<string>.new();
        let tys = List<Ty>.new();
        for (p in f.params) {
            if (p.default != null || p.variadic) {
                this.error(
                    "LYS-PAR0060",
                    f"a local function's parameter has no default and is no variadic one: '{p.name}'",
                    p.span
                );
            }
            names.push(p.name);
            tys.push(this.resolveType(p.type));
        }
        var rt: ?Ty = null;
        let written = f.returns;
        var body = Expr.Null(f.span);
        match (f.body) {
            .Block(b) => {
                body = Expr.Block(b, b.span);
                rt = Ty.Void;
            }
            .Expr(e) => {
                body = e;
            }
            .None => { }
        }
        if (written != null) {
            rt = this.resolveType(written);
        }
        let closure = this.makeLambda(f.name, names.toArray(), tys.toArray(), rt, body, f.span);
        let t = typeOf(closure);
        if (this.atTop()) {
            return TStmt.SetGlobal(
                this.declareGlobal(f.name, t, false, f.span),
                closure,
                f.span.line
            );
        }
        return TStmt.SetLocal(this.declareLocal(f.name, t, false, f.span), closure, f.span.line);
    }

    /// A function named without a call (Lyric 5 03 §8.4 rule 1): one of its name, or the one the
    /// expected function type's parameter count picks.
    mut fn functionValue(name: string, candidates: int[], expected: ?Ty, at: Span): TExpr {
        var pick = -1;
        if (candidates.length() == 1) {
            pick = candidates[0];
        } else {
            let want = expectedFn(expected);
            if (want != null) {
                for (c in candidates) {
                    if (this.functions[c].params.length() == want.params.length()) {
                        pick = c;
                    }
                }
            }
        }
        if (pick < 0) {
            this.error(
                "LYS-SEM0013",
                f"several functions are named '{name}': the position's function type says which",
                at
            );
            return TExpr.Unknown;
        }
        if (this.functions[pick].typeParams.length() > 0) {
            // the position's function type binds the type arguments (S3i)
            let want = expectedFn(expected);
            let f = this.functions[pick];
            if (want != null && want.params.length() == f.params.length()) {
                let binds = List<?Ty>.new();
                for (_ in f.typeParams) {
                    binds.push(null);
                }
                var k = 0;
                for (p in f.params) {
                    this.bind(p.ty, want.params[k], binds);
                    k += 1;
                }
                this.bind(f.returns, want.result.value, binds);
                let targs = List<Ty>.new();
                var whole = true;
                for (b in binds) {
                    if (b == null) {
                        whole = false;
                    } else {
                        targs.push(b);
                    }
                }
                if (whole) {
                    return this.genericValueOf(pick, targs.toArray(), at);
                }
            }
            this.error(
                "LYS-SEM0060",
                f"'{name}' is generic: as a value it needs its type arguments, which nothing here gives",
                at
            );
            return TExpr.Unknown;
        }
        return this.thunk(pick, at);
    }

    /// `id<int>` without a call: the generic function as a value at the written arguments.
    mut fn genericValue(callee: Expr, written: TypeExpr[], expected: ?Ty, at: Span): TExpr {
        let name = match (callee) {
            .Name(n, _) => n,
            _ => "",
        };
        let candidates = this.fnByName.get(this.q(name));
        if (candidates == null) {
            this.error(
                "LYS-SEM0013",
                "type arguments are written after a generic function's name",
                at
            );
            return TExpr.Unknown;
        }
        var pick = -1;
        for (c in candidates) {
            if (this.functions[c].typeParams.length() == written.length()) {
                pick = c;
            }
        }
        if (pick < 0) {
            this.error("LYS-SEM0026", f"no '{name}' takes {written.length()} type arguments", at);
            return TExpr.Unknown;
        }
        let binds = List<?Ty>.new();
        var holes = false;
        for (w in written) {
            let t = this.writtenType(w);
            holes = holes || isHole(t);
            binds.push(if (isHole(t)) null else t);
        }
        // a placeholder: the position's function type fills it (Lyric 5 03 §9.4; S7c6d)
        if (holes) {
            let f = this.functions[pick];
            if (let want = expectedFn(expected)) {
                if (want.params.length() == f.params.length()) {
                    var k = 0;
                    for (p in f.params) {
                        this.bind(p.ty, want.params[k], binds);
                        k += 1;
                    }
                    this.bind(f.returns, want.result.value, binds);
                }
            }
        }
        let targs = List<Ty>.new();
        var j = 0;
        for (b in binds) {
            if (b == null) {
                this.error(
                    "LYS-SEM0060",
                    f"nothing here says what '{this.functions[pick].typeParams[j].name}' of '{name}' is: write it",
                    at
                );
                return TExpr.Unknown;
            }
            targs.push(b);
            j += 1;
        }
        return this.genericValueOf(pick, targs.toArray(), at);
    }

    /// Generic function `fi` as a value at `targs`, each argument checked against its
    /// constraints; its type the signature at them.
    mut fn genericValueOf(fi: int, targs: Ty[], at: Span): TExpr {
        let f = this.functions[fi];
        var j = 0;
        for (tp in f.typeParams) {
            let b = targs[j];
            for (ii in tp.constraints) {
                if (b != .Unknown && !this.conformsTo(b, ii)) {
                    this.error(
                        "LYS-SEM0028",
                        f"{this.tyName(b)} is no {this.types[ii].name}, which '{tp.name}' of '{f.name}' asks",
                        at
                    );
                }
            }
            j += 1;
        }
        let rt = this.returnsOf(fi, at);
        let tys = List<Ty>.new();
        for (p in f.params) {
            tys.push(this.subst(p.ty, targs));
        }
        let fnTy = Ty.Fn(FnTy { params = tys.toArray(), result = boxTy(this.subst(rt, targs)) });
        return TExpr.GenericValue(fi, targs, fnTy);
    }

    /// A thunk of copy `inst` holding the `n` descriptors it takes hidden, as captures after
    /// its parameters (S3i).
    mut fn descThunk(inst: int, n: int, fnTy: Ty): int {
        let key = f"{inst}/{n}";
        let known = this.descThunks.get(key);
        if (known != null) {
            return known;
        }
        let anyTy = Ty.Named(this.anyIndex);
        let index = this.functions.length();
        let target = this.functions[inst];
        this.functions.push(
            FnInfo {
                name = target.name + "#value",
                owner = -1,
                isStatic = true,
                line = target.line,
            }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let info = this.functions[index];
        let params = List<ParamInfo>.new();
        let locals = List<Ty>.new();
        let args = List<TExpr>.new();
        locals.push(fnTy);
        var k = 0;
        for (p in target.params) {
            params.push(ParamInfo { name = p.name, ty = p.ty, default = null });
            locals.push(p.ty);
            args.push(TExpr.Local(k + 1, p.ty));
            k += 1;
        }
        let caps = List<CaptureInfo>.new();
        var j = 0;
        while (j < n) {
            caps.push(CaptureInfo { ty = anyTy, isCell = false });
            args.push(TExpr.Captured(j, anyTy));
            j += 1;
        }
        info.params = params.toArray();
        info.env = true;
        info.captures = caps.toArray();
        info.returns = target.returns;
        info.locals = locals.toArray();
        let flags = List<bool>.new();
        for (_ in locals) {
            flags.push(false);
        }
        info.boxed = flags.toArray();
        let call = TExpr.Call(inst, args.toArray(), target.returns);
        info.body = if (target.returns == .Void) [
            TStmt.Expr(call, target.line),
            TStmt.Return(null, target.line),
        ]
            else [TStmt.Return(call, target.line)];
        this.descThunks.insert(key, index);
        return index;
    }

    /// `obj.method` without a call: a function value holding `obj`, whose function calls the
    /// method on it with the rest (Lyric 5 03 §8.4 rule 2); one such function per method.
    mut fn boundMethod(o: TExpr, m: int, at: Span): TExpr {
        let method = this.functions[m];
        let rt = this.returnsOf(m, at);
        let tys = List<Ty>.new();
        for (p in method.params) {
            tys.push(p.ty);
        }
        let fnTy = Ty.Fn(FnTy { params = tys.toArray(), result = boxTy(rt) });
        let known = this.bound.get(m);
        if (known != null) {
            return TExpr.Closure(known, [o], fnTy);
        }
        let ot = typeOf(o);
        let index = this.functions.length();
        this.functions.push(
            FnInfo { name = method.name + "#bound", owner = -1, isStatic = true, line = at.line }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let info = this.functions[index];
        let params = List<ParamInfo>.new();
        let locals = List<Ty>.new();
        let args = List<TExpr>.new();
        locals.push(fnTy);
        args.push(TExpr.Captured(0, ot));
        var k = 0;
        for (p in method.params) {
            params.push(ParamInfo { name = p.name, ty = p.ty, default = null });
            locals.push(p.ty);
            args.push(TExpr.Local(k + 1, p.ty));
            k += 1;
        }
        info.params = params.toArray();
        info.env = true;
        info.returns = rt;
        info.locals = locals.toArray();
        let flags = List<bool>.new();
        for (_ in locals) {
            flags.push(false);
        }
        info.boxed = flags.toArray();
        info.captures = [CaptureInfo { ty = ot, isCell = false }];
        let call = TExpr.Call(m, args.toArray(), rt);
        info.body = if (rt == .Void) [TStmt.Expr(call, at.line), TStmt.Return(null, at.line)]
            else [TStmt.Return(call, at.line)];
        this.bound.insert(m, index);
        return TExpr.Closure(index, [o], fnTy);
    }

    /// The function value of function `target`: a function of its own that takes the value
    /// first and calls `target` with the rest, made once.
    mut fn thunk(target: int, at: Span): TExpr {
        let rt = this.returnsOf(target, at);
        let tys = List<Ty>.new();
        for (p in this.functions[target].params) {
            tys.push(p.ty);
        }
        let fnTy = Ty.Fn(FnTy { params = tys.toArray(), result = boxTy(rt) });
        let known = this.thunks.get(target);
        if (known != null) {
            return TExpr.Closure(known, [], fnTy);
        }
        let index = this.functions.length();
        let targetInfo = this.functions[target];
        this.functions.push(
            FnInfo {
                name = targetInfo.name + "#value",
                owner = -1,
                isStatic = true,
                line = at.line,
            }
        );
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let info = this.functions[index];
        let params = List<ParamInfo>.new();
        let locals = List<Ty>.new();
        let args = List<TExpr>.new();
        locals.push(fnTy);
        var k = 0;
        for (p in targetInfo.params) {
            params.push(ParamInfo { name = p.name, ty = p.ty, default = null });
            locals.push(p.ty);
            args.push(TExpr.Local(k + 1, p.ty));
            k += 1;
        }
        info.params = params.toArray();
        info.env = true;
        info.returns = rt;
        info.locals = locals.toArray();
        let flags = List<bool>.new();
        for (_ in locals) {
            flags.push(false);
        }
        info.boxed = flags.toArray();
        let call = TExpr.Call(target, args.toArray(), rt);
        info.body = [TStmt.Return(if (rt == .Void) null else call, at.line)];
        if (rt == .Void) {
            info.body = [TStmt.Expr(call, at.line), TStmt.Return(null, at.line)];
        }
        this.thunks.insert(target, index);
        return TExpr.Closure(index, [], fnTy);
    }

    /// A method called on a value: one of its type's, not static.
    mut fn methodCall(
        receiver: TExpr,
        method: string,
        args: Arg[],
        at: Span,
        memberAt: Span
    ): TExpr {
        // the position's type and the written type arguments: the method's call takes them,
        // not a call in a list method's argument (S7c4c2)
        let posTy = this.callExpected;
        let writtenTys = this.writtenArgs;
        this.callExpected = null;
        this.writtenArgs = [];
        let t = typeOf(receiver);
        if (let d = this.synthDebug(t, receiver, method, args, at)) {
            return d;
        }
        // a clause's binding tells where the error was first thrown, where its type has no
        // member of the name (06 §4 rule 4)
        match (receiver) {
            .Local(id, _) => {
                let record = this.ctx.clauseRecords.get(id);
                if (record != null
                    && method == "backtrace"
                    && args.length() == 0
                    && !this.hasMember(t, method)) {
                    return this.backtraceOf(record);
                }
                // the errors a defer threw while this one was in flight (06 §4, S7b2b)
                if (let rec = record) {
                    if (method == "suppressed"
                        && args.length() == 0
                        && !this.hasMember(t, method)) {
                        return TExpr.ListOp(
                            ListOp.Suppressed,
                            [TExpr.Local(rec, Ty.Named(this.anyIndex))],
                            Ty.List(boxTy(this.errorTy()))
                        );
                    }
                }
            }
            _ => { }
        }
        match (t) {
            .Unknown => {
                return TExpr.Unknown;
            }
            .Assoc(_, ai, an) => {
                // an associated type has its bounds' members (05 §8 rule 4)
                for (b in this.boundsOf(ai, an)) {
                    let found = this.ifaceMember(b, method);
                    if (found != null) {
                        let (fi, slot) = found;
                        this.presetBinds = this.bindsOf(fi, b, t);
                        let call = this.callExpecting(
                            posTy,
                            writtenTys,
                            method,
                            [fi],
                            receiver,
                            args,
                            at
                        );
                        this.presetBinds = [];
                        return match (call) {
                            .Call(_, all, rt) => TExpr.CallBound(t, b, method, slot, all, rt),
                            .CallGeneric(_, _, all, rt) => TExpr.CallBound(
                                t,
                                b,
                                method,
                                slot,
                                all,
                                rt
                            ),
                            _ => call,
                        };
                    }
                }
                if (let call = this.blanketCall(t, receiver, method, args, at, posTy, writtenTys)) {
                    return call;
                }
                this.error(
                    "LYS-SEM0027",
                    f"'{this.tyName(t)}' has no method '{method}': its bounds give none",
                    memberAt
                );
                return TExpr.Unknown;
            }
            .Param(k) => {
                // a type parameter has its constraints' members (03 §9.1 rule 1)
                let g = this.genericFn;
                if (g >= 0 && k < this.functions[g].typeParams.length()) {
                    for (ii in this.functions[g].typeParams[k].constraints) {
                        let found = this.ifaceMember(ii, method);
                        if (found != null) {
                            let (fi, slot) = found;
                            if (this.functions[fi].isStatic) {
                                this.error(
                                    "LYS-SEM0055",
                                    f"'{method}' is static: reach it through the type, {this.tyName(t)}.{method}(…)",
                                    memberAt
                                );
                                return TExpr.Unknown;
                            }
                            // `Self` is the receiver's type; a generic interface's member takes its
                            // instance's arguments (S7c1)
                            this.presetBinds = this.bindsOf(fi, ii, t);
                            let call = this.callExpecting(
                                posTy,
                                writtenTys,
                                method,
                                [fi],
                                receiver,
                                args,
                                at
                            );
                            this.presetBinds = [];
                            return match (call) {
                                .Call(_, all, rt) => TExpr.CallConstraint(
                                    k,
                                    ii,
                                    method,
                                    slot,
                                    all,
                                    rt
                                ),
                                .CallGeneric(_, _, all, rt) => TExpr.CallConstraint(
                                    k,
                                    ii,
                                    method,
                                    slot,
                                    all,
                                    rt
                                ),
                                _ => call,
                            };
                        }
                    }
                }
                if (let call = this.blanketCall(t, receiver, method, args, at, posTy, writtenTys)) {
                    return call;
                }
                this.error(
                    "LYS-SEM0012",
                    f"'{this.tyName(t)}' has no method '{method}': its constraints give none",
                    memberAt
                );
                return TExpr.Unknown;
            }
            .Named(i) => {
                // a task's methods (07 N4, S6a)
                let asTask = this.taskMethod(receiver, i, method, args, memberAt);
                if (asTask != null) {
                    return asTask;
                }
                // a coroutine's (S6b)
                let asCoroutine = this.coroutineMethod(receiver, i, method, args, memberAt);
                if (asCoroutine != null) {
                    return asCoroutine;
                }
                // a task scope's (S6c2)
                let asScope = this.scopeMethod(receiver, i, method, args, memberAt);
                if (asScope != null) {
                    return asScope;
                }
                // a channel's, a semaphore's (S6d1)
                let asSync = this.syncMethod(receiver, i, method, args, memberAt);
                if (asSync != null) {
                    return asSync;
                }
                if (this.types[i].kind == .Interface) {
                    // through the interface value: the conformer's function in the slot
                    let found = this.ifaceMember(i, method);
                    if (found == null) {
                        if (let call = this.blanketCall(
                            t,
                            receiver,
                            method,
                            args,
                            at,
                            posTy,
                            writtenTys
                        )) {
                            return call;
                        }
                        this.error(
                            "LYS-SEM0012",
                            f"'{this.types[i].name}' has no method '{method}'",
                            memberAt
                        );
                        return TExpr.Unknown;
                    }
                    let (fi, slot) = found;
                    // through a value form `Self.Item` reads the fixed type (05 §8 rule 6); a generic
                    // interface's member takes its instance's arguments (S7c1)
                    this.presetBinds = this.bindsOf(fi, i, t);
                    let call = this.callExpecting(
                        posTy,
                        writtenTys,
                        method,
                        [fi],
                        receiver,
                        args,
                        at
                    );
                    this.presetBinds = [];
                    return match (call) {
                        .Call(_, all, rt) => TExpr.CallIface(slot, all, rt),
                        .CallGeneric(_, _, all, rt) => TExpr.CallIface(slot, all, rt),
                        _ => call,
                    };
                }
                // of several members of the name, the one the arguments choose (S7c5d2)
                let picked = this.pickMember(i, method, args, at);
                if ((picked ?? 0) < 0) {
                    return TExpr.Unknown;
                }
                let m = picked ?? this.methodOf(i, method);
                let checkedArgs = this.pickedArgs;
                this.pickedArgs = [];
                // a generic block's member: on an instance that meets its constraints (rule 2)
                if (m != null
                    && this.functions[m].blockParams.length() > 0
                    && !this.meetsBlock(this.types[i].args, this.functions[m].blockParams)) {
                    this.error(
                        "LYS-SEM0134",
                        f"'{this.types[i].name}' has no method '{method}': its block asks more of the type's arguments",
                        memberAt
                    );
                    return TExpr.Unknown;
                }
                if (m != null
                    && this.functions[m].typeParams.length() > 0
                    && this.types[i].args.length() > 0) {
                    this.presetBinds = this.types[i].args;
                    this.preChecked = checkedArgs;
                    let call = this.callExpecting(
                        posTy,
                        writtenTys,
                        method,
                        [m],
                        receiver,
                        args,
                        at
                    );
                    this.presetBinds = [];
                    return call;
                }
                // a default of a conformance, called on the conformer — an instance of a generic
                // type's at its arguments, its table perhaps not made yet (S7c1b)
                if (m == null) {
                    for (ii in this.ifacesOf(i)) {
                        let found = this.ifaceMember(ii, method);
                        if (found != null && m == null) {
                            let (fi, _) = found;
                            if (!this.functions[fi].abstract && this.selfGeneric(fi)) {
                                this.presetBinds = this.bindsOf(fi, ii, t);
                                let call = this.callExpecting(
                                    posTy,
                                    writtenTys,
                                    method,
                                    [fi],
                                    receiver,
                                    args,
                                    at
                                );
                                this.presetBinds = [];
                                return call;
                            }
                            if (!this.functions[fi].abstract) {
                                // a generic interface's default: at its instance's arguments,
                                // the receiver a value of the instance (S7c1b)
                                let binds = this.bindsOf(fi, ii, t);
                                let owner = if (binds.length() > 0) ii
                                    else this.functions[fi].owner;
                                this.presetBinds = binds;
                                let up = if (this.boxed(t)) TExpr.BoxOf(
                                    boxE(receiver),
                                    i,
                                    Ty.Named(owner)
                                )
                                    else TExpr.Upcast(boxE(receiver), Ty.Named(owner));
                                return this.callExpecting(
                                    posTy,
                                    writtenTys,
                                    method,
                                    [fi],
                                    up,
                                    args,
                                    at
                                );
                            }
                        }
                    }
                }
                if (m == null) {
                    // a field that holds a function value is called by its name
                    var k = 0;
                    for (f in this.types[i].fields) {
                        let isFn = match (f.ty) {
                            .Fn(_) => true,
                            _ => false,
                        };
                        if (f.name == method && isFn) {
                            return this.callValue(TExpr.Field(boxE(receiver), k, f.ty), args, at);
                        }
                        k += 1;
                    }
                    if (let eq = this.synthEquals(t, receiver, method, args, at)) {
                        return eq;
                    }
                    if (let cmp = this.synthCompare(t, receiver, method, args, at)) {
                        return cmp;
                    }
                    if (let copy = this.synthClone(t, receiver, method, args)) {
                        return copy;
                    }
                    if (let hashed = this.synthHash(t, receiver, method, args)) {
                        return hashed;
                    }
                    if (let call = this.blanketCall(
                        t,
                        receiver,
                        method,
                        args,
                        at,
                        posTy,
                        writtenTys
                    )) {
                        return call;
                    }
                    this.error(
                        "LYS-SEM0012",
                        f"'{this.types[i].name}' has no method '{method}'",
                        memberAt
                    );
                    return TExpr.Unknown;
                }
                if (this.functions[m].isStatic) {
                    this.error(
                        "LYS-SEM0074",
                        f"'{method}' is static: call it as {this.types[i].name}.{method}(…)",
                        memberAt
                    );
                    return TExpr.Unknown;
                }
                this.mayName(i, method, memberAt);
                this.preChecked = checkedArgs;
                return this.callExpecting(posTy, writtenTys, method, [m], receiver, args, at);
            }
            _ => {
                // a list's own (S7b1)
                match (t) {
                    .List(e) => {
                        let asList = this.listMethod(receiver, e.value, method, args, memberAt);
                        if (asList != null) {
                            return asList;
                        }
                    }
                    _ => { }
                }
                // a block over the receiver's shape's parts (S7e2c): the receiver binds them, as a
                // list binds its element; a block at fixed types answers first
                if (let parts = shapeParts(t)) {
                    let fixed = this.builtinOf(t);
                    let g = this.shapeTemplate(shapeKind(t), parts.length(), false);
                    let fixedHas = fixed >= 0 && this.types[fixed].methods.containsKey(method);
                    if (g >= 0 && !fixedHas) {
                        if (let m = this.types[g].methods.get(method)) {
                            if (!this.meetsBlock(parts, this.functions[m].blockParams)) {
                                this.error(
                                    "LYS-SEM0134",
                                    f"'{this.tyName(t)}' has no method '{method}': its block asks more of its parts",
                                    memberAt
                                );
                                return TExpr.Unknown;
                            }
                            this.presetBinds = parts;
                            let call = this.callExpecting(
                                posTy,
                                writtenTys,
                                method,
                                [m],
                                receiver,
                                args,
                                at
                            );
                            this.presetBinds = [];
                            return call;
                        }
                    }
                }
                // a built-in type's methods: its extend blocks', and its conformances' defaults —
                // a shape's through its entry, its template's instance where a block over its
                // parts gave the conformance (S7e2c)
                let i = match (t) {
                    .Fn(_) | .Optional(_) | .Tuple(_) => this.shapeEntryOf(t),
                    _ => this.builtinOf(t),
                };
                // a block on this list type alone, `extend int[] { … }` (S7c4c3b)
                let inst = this.entryOf(t);
                if (i >= 0 && inst >= 0 && inst != i) {
                    let own = this.types[inst].ownMethods.get(method);
                    if (own != null) {
                        return this.callExpecting(
                            posTy,
                            writtenTys,
                            method,
                            [own],
                            receiver,
                            args,
                            at
                        );
                    }
                }
                if (i >= 0) {
                    // of several members of the name, the one the arguments choose (S7c5d3:
                    // `int`'s `add` for `Add<int>` and `Add<float>`)
                    let picked = this.pickMember(i, method, args, at);
                    if ((picked ?? 0) < 0) {
                        return TExpr.Unknown;
                    }
                    let m = picked ?? this.types[i].methods.get(method);
                    let checkedArgs = this.pickedArgs;
                    this.pickedArgs = [];
                    if (m != null) {
                        match (t) {
                            .List(e) => {
                                if (!this.meetsBlock([e.value], this.functions[m].blockParams)) {
                                    this.error(
                                        "LYS-SEM0134",
                                        f"'{this.tyName(t)}' has no method '{method}': its block asks more of the element type",
                                        memberAt
                                    );
                                    return TExpr.Unknown;
                                }
                                this.presetBinds = [e.value];
                                this.preChecked = checkedArgs;
                                let call = this.callExpecting(
                                    posTy,
                                    writtenTys,
                                    method,
                                    [m],
                                    receiver,
                                    args,
                                    at
                                );
                                this.presetBinds = [];
                                return call;
                            }
                            _ => { }
                        }
                        this.preChecked = checkedArgs;
                        return this.callExpecting(
                            posTy,
                            writtenTys,
                            method,
                            [m],
                            receiver,
                            args,
                            at
                        );
                    }
                    for (ii in this.types[i].ifaces) {
                        let found = this.ifaceMember(ii, method);
                        if (found != null) {
                            let (fi, _) = found;
                            if (!this.functions[fi].abstract) {
                                // a generic interface's default: at its instance's arguments,
                                // the receiver a value of the instance (S7c1b)
                                let binds = this.bindsOf(fi, ii, t);
                                let owner = if (binds.length() > 0) ii
                                    else this.functions[fi].owner;
                                this.presetBinds = binds;
                                let up = TExpr.BoxOf(boxE(receiver), i, Ty.Named(owner));
                                return this.callExpecting(
                                    posTy,
                                    writtenTys,
                                    method,
                                    [fi],
                                    up,
                                    args,
                                    at
                                );
                            }
                        }
                    }
                }
                if (let eq = this.synthEquals(t, receiver, method, args, at)) {
                    return eq;
                }
                // a tuple's and an optional's `hash(h)` and `clone()` (S7d1)
                if (let hashed = this.synthHash(t, receiver, method, args)) {
                    return hashed;
                }
                if (let copy = this.synthClone(t, receiver, method, args)) {
                    return copy;
                }
                if (let call = this.blanketCall(t, receiver, method, args, at, posTy, writtenTys)) {
                    return call;
                }
                // a list's methods are all here (S7b), a string's since S7e2 but what S7e3 and S7f
                // bring; a number's come with S7f
                match (t) {
                    .Str => {
                        match (method) {
                            "toBytes" => {
                                return this.notYet(
                                    "a string's bytes",
                                    "S7f (numbers, BigInt, Bytes)",
                                    memberAt
                                );
                            }
                            _ => {
                                this.error(
                                    "LYS-SEM0012",
                                    f"'{this.tyName(t)}' has no method '{method}'",
                                    memberAt
                                );
                                return TExpr.Unknown;
                            }
                        }
                    }
                    .List(_) => {
                        this.error(
                            "LYS-SEM0012",
                            f"'{this.tyName(t)}' has no method '{method}'",
                            memberAt
                        );
                        return TExpr.Unknown;
                    }
                    _ => { }
                }
                return this.notYet(f"the methods of {this.tyName(t)}", laterClock(t), memberAt);
            }
        }
    }

    /// `I.m(x, …)`: member `m` of interface `I` with `x` as its receiver — the implementation
    /// `x`'s type has for `I` (05 §4 rule 1); a static member is reached on a type, not through
    /// its interface (rule 2).
    mut fn qualifiedCall(ii: int, method: string, args: Arg[], at: Span): TExpr {
        let iface = this.types[ii];
        let found = this.ifaceMember(ii, method);
        if (found == null) {
            this.error("LYS-SEM0012", f"'{iface.name}' has no member '{method}'", at);
            return TExpr.Unknown;
        }
        let (fi, slot) = found;
        if (this.functions[fi].isStatic) {
            this.error(
                "LYS-SEM0231",
                f"'{iface.name}.{method}' is static: call it on a type that conforms, or through a type parameter, T.{method}(…)",
                at
            );
            return TExpr.Unknown;
        }
        if (args.length() == 0) {
            this.error("LYS-SEM0014", f"the receiver comes first: {iface.name}.{method}(x, …)", at);
            return TExpr.Unknown;
        }
        let recv = this.expr(args[0].value, null);
        let t = typeOf(recv);
        if (t == .Unknown) {
            return TExpr.Unknown;
        }
        if (!this.conformsTo(t, ii)) {
            this.error(
                "LYS-SEM0125",
                f"{this.tyName(t)} is no {iface.name}",
                spanOf(args[0].value)
            );
            return TExpr.Unknown;
        }
        let rest = List<Arg>.new();
        var k = 1;
        while (k < args.length()) {
            rest.push(args[k]);
            k += 1;
        }
        this.presetBinds = this.bindsOf(fi, ii, t);
        let call = this.callAmong(method, [fi], recv, rest.toArray(), at);
        this.presetBinds = [];
        let parts = match (call) {
            .Call(_, all, rt) => (all, rt),
            .CallGeneric(_, _, all, rt) => (all, rt),
            _ => {
                return call;
            }
        };
        let (all, rt) = parts;
        return match (t) {
            // a type parameter: through the constraint, in each copy the argument's own
            .Param(pk) => TExpr.CallConstraint(pk, ii, method, slot, all, rt),
            .Named(i) => if (this.types[i].kind == .Interface) TExpr.CallIface(slot, all, rt)
                else TExpr.CallBound(t, ii, method, slot, all, rt),
            _ => TExpr.CallBound(t, ii, method, slot, all, rt),
        };
    }

    /// `T.parse(s)`: a static member of a constraint of type parameter `k` (05 §7 rule 2), the
    /// argument's own in each copy.
    mut fn paramStatic(k: int, method: string, args: Arg[], at: Span): TExpr {
        let g = this.genericFn;
        let t = Ty.Param(k);
        if (g >= 0 && k < this.functions[g].typeParams.length()) {
            for (ii in this.functions[g].typeParams[k].constraints) {
                let found = this.ifaceMember(ii, method);
                if (found != null) {
                    let (fi, slot) = found;
                    if (!this.functions[fi].isStatic) {
                        this.error(
                            "LYS-SEM0055",
                            f"'{method}' needs a {this.tyName(t)} to call it on",
                            at
                        );
                        return TExpr.Unknown;
                    }
                    this.presetBinds = this.bindsOf(fi, ii, t);
                    let call = this.callAmong(method, [fi], null, args, at);
                    this.presetBinds = [];
                    return match (call) {
                        .Call(_, all, rt) => TExpr.CallStatic(k, ii, method, slot, all, rt),
                        .CallGeneric(_, _, all, rt) => TExpr.CallStatic(
                            k,
                            ii,
                            method,
                            slot,
                            all,
                            rt
                        ),
                        _ => call,
                    };
                }
            }
        }
        if (let call = this.blanketStatic(t, method, args, at)) {
            return call;
        }
        this.error(
            "LYS-SEM0012",
            f"'{this.tyName(t)}' has no static member '{method}': its constraints give none",
            at
        );
        return TExpr.Unknown;
    }

    mut fn staticCall(typeIndex: int, method: string, args: Arg[], at: Span): TExpr {
        // the position's type, for this call's, not an argument's: what the arguments leave open
        // of a generic type's parameters it binds (Lyric 5 03 §9.2 rule 6; S7d2: `Map.new()`)
        let posTy = this.callExpected;
        this.callExpected = null;
        let info = this.types[typeIndex];
        // `Channel<T>.new(capacity)`, `Semaphore.new(n)` (Lyric 5 10 §6 rule 1, §10 rule 7): the VM's
        let made = this.syncNew(typeIndex, method, args, at);
        if (made != null) {
            return made;
        }
        // `TaskScope.new()` (Lyric 5 10 §4 rule 1): the VM's scope
        if (typeIndex == (this.typeIndex.get("TaskScope") ?? -1) && method == "new") {
            if (args.length() > 0) {
                this.error("LYS-SEM0014", "TaskScope.new() takes no argument", at);
            }
            return TExpr.ScopeNew(Ty.Named(typeIndex));
        }
        if (info.kind == .Interface) {
            return this.qualifiedCall(typeIndex, method, args, at);
        }
        // `Shape.Num(3)`: a variant with a payload by position
        let k = this.variantIndex(typeIndex, method);
        if (k >= 0) {
            return this.variantCall(typeIndex, k, args, at);
        }
        // of several members of the name, the one the arguments choose (S7c5d2)
        let picked = this.pickMember(typeIndex, method, args, at);
        if ((picked ?? 0) < 0) {
            return TExpr.Unknown;
        }
        let m = picked ?? this.methodOf(typeIndex, method);
        let checkedArgs = this.pickedArgs;
        this.pickedArgs = [];
        // `P.default()` of a type that has one without its own (S7c6c1)
        if (m == null && method == "default" && args.length() == 0 && this.synth.defaultIx >= 0) {
            let self = this.selfTy(typeIndex);
            if (!this.anyParamIn(self) && this.conformsDirect(self, this.synth.defaultIx)) {
                return TExpr.Call(this.defaultFnOf(self), [], self);
            }
        }
        if (m == null) {
            // a blanket block's static member (05 §13 rule 7; S7c4c3a)
            if (let call = this.blanketStatic(this.selfTy(typeIndex), method, args, at)) {
                return call;
            }
            if (method == "new") {
                this.error(
                    "LYS-SEM0012",
                    f"'{info.name}' has no 'new': write {info.name} {{ … }}, or declare static fn new",
                    at
                );
            } else {
                this.error("LYS-SEM0012", f"'{info.name}' has no member '{method}'", at);
            }
            return TExpr.Unknown;
        }
        if (!this.functions[m].isStatic) {
            this.error("LYS-SEM0055", f"'{method}' needs a {info.name} to call it on", at);
            return TExpr.Unknown;
        }
        if (!this.mayName(typeIndex, method, at)) {
            return TExpr.Unknown;
        }
        this.preChecked = checkedArgs;
        return this.callExpecting(posTy, [], method, [m], null, args, at);
    }

    /// The member of `name` a call with `args` reaches on type `i` where it has several (S7c5d2):
    /// the one that takes as many arguments (Lyric 5 08 §1.2), of several the one whose parameters
    /// take the arguments' types, of those the one whose parameters are those types — a literal
    /// its default type (05 §3 rule 5); the arguments checked once, kept in `pickedArgs` for the
    /// call. Members two conformance blocks give apart are called through their interfaces (rule
    /// 4, `LYS-SEM0122`). Null where the type has one member of the name; -1 after an error.
    mut fn pickMember(i: int, name: string, args: Arg[], at: Span): ?int {
        let info = this.types[i];
        let home = if (info.template >= 0) info.template else i;
        let set = this.types[home].sets.get(name);
        if (set == null) {
            return null;
        }
        let byCount = List<int>.new();
        for (c in set) {
            let (low, high) = this.countRange(c);
            if (args.length() >= low && args.length() <= high) {
                byCount.push(c);
            }
        }
        if (byCount.length() == 1) {
            return byCount[0];
        }
        if (byCount.length() == 0) {
            this.error(
                "LYS-SEM0087",
                f"no member '{name}' of {info.name} takes {args.length()} arguments",
                at
            );
            for (a in args) {
                this.expr(a.value, null);
            }
            return -1;
        }
        var perInstance = true;
        var k = 1;
        while (k < byCount.length()) {
            perInstance = perInstance && this.instancesApart(byCount[0], byCount[k]);
            k += 1;
        }
        if (!perInstance) {
            let ways = List<string>.new();
            for (c in byCount) {
                for (x in this.answering.get(c) ?? List<int>.new()) {
                    ways.push(f"{this.types[x].name}.{name}(…)");
                }
            }
            this.error(
                "LYS-SEM0122",
                f"'{name}' of {info.name} is each conformance block's own: call it through its interface, {ways.toArray().join(" or ")}",
                at
            );
            for (a in args) {
                this.expr(a.value, null);
            }
            return -1;
        }
        let checked = List<TExpr>.new();
        var unknown = false;
        for (a in args) {
            let v = this.expr(a.value, null);
            unknown = unknown || typeOf(v) == .Unknown;
            checked.push(v);
        }
        if (unknown) {
            return -1;
        }
        let takers = List<int>.new();
        let exact = List<int>.new();
        for (c in byCount) {
            let params = this.functions[c].params;
            var takes = true;
            var same = true;
            var j = 0;
            for (a in args) {
                var p = j;
                if (let given = a.name) {
                    p = -1;
                    var q = 0;
                    for (x in params) {
                        if (x.name == given) {
                            p = q;
                        }
                        q += 1;
                    }
                }
                if (p < 0) {
                    takes = false;
                } else {
                    // an instance's members at its arguments
                    let want = this.subst(params[p].ty, info.args);
                    same = same && typeOf(checked[j]) == want;
                    takes = takes && this.fit(checked[j], want) != null;
                }
                j += 1;
            }
            if (takes) {
                takers.push(c);
                if (same) {
                    exact.push(c);
                }
            }
        }
        let pick = if (takers.length() == 1) takers[0]
            else if (exact.length() == 1) exact[0] else -1;
        if (pick < 0) {
            this.error(
                "LYS-SEM0086",
                if (takers.length() == 0) f"no member '{name}' of {info.name} takes these arguments"
                    else f"the arguments' types choose no one member '{name}' of {info.name}: write an argument as its type, `x as T`",
                at
            );
            return -1;
        }
        this.pickedArgs = checked.toArray();
        return pick;
    }

    /// The fewest and the most arguments function `f` takes, a default widening its count (Lyric
    /// 5 08 §1.2 rule 2): read off its declaration, whose defaults are checked after the
    /// declarations stand.
    fn countRange(f: int): (int, int) {
        var required = 0;
        var total = 0;
        if (let d = this.fnDecls[f]) {
            for (p in d.params) {
                total += 1;
                if (p.default == null) {
                    required += 1;
                }
            }
            return (required, total);
        }
        for (p in this.functions[f].params) {
            total += 1;
            if (p.default == null) {
                required += 1;
            }
        }
        return (required, total);
    }

    /// Whether `f` and `g` each answer an instance of one generic interface the other does not
    /// (05 §3 rule 5; S7c5d2).
    mut fn instancesApart(f: int, g: int): bool {
        let fs = this.answering.get(f);
        let gs = this.answering.get(g);
        if (fs == null || gs == null) {
            return false;
        }
        for (x in fs) {
            for (y in gs) {
                let base = this.ifaceBase(x);
                if (x != y && base != x && base == this.ifaceBase(y)) {
                    return true;
                }
            }
        }
        return false;
    }

    /// Whether members `f` and `g` of one name stand side by side (S7c5d2): each answering its
    /// own instance of a generic interface (05 §3 rule 5); each its own conformance block's
    /// (rule 4), one block's told apart by count; the type's own told apart by count (08 §1.2) —
    /// never a conformance block's beside the type's own (rule 1).
    mut fn standApart(f: int, g: int): bool {
        if (this.instancesApart(f, g)) {
            return true;
        }
        let fb = this.memberSite.get(f);
        let gb = this.memberSite.get(g);
        let (fl, fh) = this.countRange(f);
        let (gl, gh) = this.countRange(g);
        let meet = fl <= gh && gl <= fh;
        if (fb != null && gb != null) {
            return fb != gb || !meet;
        }
        if (fb != null || gb != null) {
            return false;
        }
        return !meet;
    }

    /// The members of one name a type has several of (Lyric 5 05 §3, 08 §1.2; S7c5d2): a member
    /// that stands apart from none before it is refused where it is declared (`LYS-SEM0121`).
    mut fn checkSets(): void {
        var i = 0;
        while (i < this.types.length()) {
            let info = this.types[i];
            for (name in info.setNames) {
                let set = info.sets.get(name) ?? List<int>.new();
                var j = 1;
                while (j < set.length()) {
                    let g = set[j];
                    var k = 0;
                    while (k < j && !this.refusedMembers.containsKey(g)) {
                        if (!this.standApart(set[k], g)) {
                            this.refusedMembers.insert(g, true);
                            this.error(
                                "LYS-SEM0121",
                                f"'{info.name}' has a second member '{name}'",
                                this.fnSpan(g)
                            );
                        }
                        k += 1;
                    }
                    j += 1;
                }
            }
            i += 1;
        }
    }

    /// The member of type `index` that answers `member` of interface `ii` (`declared` its
    /// declaration, read at `selfArgs`): of a name the type has several of (S7c5d2), one of the
    /// block whose conformance this is, else one of no conformance block, whose signature is
    /// the member's — two that are both answer one instance (`LYS-SEM0085`).
    mut fn memberAnswering(
        index: int,
        ii: int,
        member: string,
        declared: int,
        selfArgs: Ty[]
    ): ?int {
        let info = this.types[index];
        let set = info.sets.get(member);
        if (set == null) {
            return this.methodOf(index, member);
        }
        let here = List<int>.new();
        let plain = List<int>.new();
        for (c in set) {
            let site = this.memberSite.get(c);
            if (site == null) {
                plain.push(c);
            } else if (site == this.blockSite) {
                here.push(c);
            }
        }
        let pool = if (here.length() > 0) here.toArray()
            else if (plain.length() > 0) plain.toArray() else set.toArray();
        var chosen = -1;
        for (c in pool) {
            if (declared >= 0
                && this.sameSignatureAs(c, declared, selfArgs)
                && this.functions[c].isStatic == this.functions[declared].isStatic) {
                if (chosen < 0) {
                    chosen = c;
                } else {
                    this.refusedMembers.insert(c, true);
                    this.error(
                        "LYS-SEM0085",
                        f"'{info.name}' has two members '{member}' that answer '{this.types[ii].name}'",
                        this.fnSpan(c)
                    );
                }
            }
        }
        if (chosen < 0) {
            // none takes and gives what the member declares: the conformance says so, and the
            // member is no second error where it stands
            this.refusedMembers.insert(pool[0], true);
            return pool[0];
        }
        info.setWitness.insert(f"{ii}.{member}", chosen);
        if (let list = this.answering.get(chosen)) {
            list.push(ii);
        } else {
            let list = List<int>.new();
            list.push(ii);
            this.answering.insert(chosen, list);
        }
        return chosen;
    }

    /// The member of type `entry` that answers `member` of interface `ii`: of a name it has
    /// several of, the one its conformance took (S7c5d2) — an instance's at its template's
    /// interface; else its member of the name.
    mut fn memberFor(entry: int, ii: int, member: string): ?int {
        let info = this.types[entry];
        let home = if (info.template >= 0) info.template else entry;
        let tmpl = this.types[home];
        if (!tmpl.sets.containsKey(member)) {
            return this.methodOf(entry, member);
        }
        for (a in this.ancestry(ii)) {
            if (let fi = tmpl.setWitness.get(f"{a}.{member}")) {
                return fi;
            }
        }
        if (home != entry) {
            for (x in tmpl.ifaces) {
                if (this.ifaceAt(x, info.args) == ii) {
                    if (let fi = tmpl.setWitness.get(f"{x}.{member}")) {
                        return fi;
                    }
                }
            }
        }
        return this.methodOf(entry, member);
    }

    /// The member of `name` a read without a call takes on type `i` where it has several: the one
    /// whose function type the position wants (Lyric 5 08 §1.2 rule 3; S7c5d2) — none or several
    /// refused (`LYS-SEM0089`). Null where the type has one member of the name; -1 after an error.
    mut fn pickBound(i: int, name: string, want: ?Ty, at: Span): ?int {
        let info = this.types[i];
        let home = if (info.template >= 0) info.template else i;
        let set = this.types[home].sets.get(name);
        if (set == null) {
            return null;
        }
        var pick = -1;
        var count = 0;
        if (let w = want) {
            for (c in set) {
                if (this.functions[c].isStatic) {
                    continue;
                }
                let tys = List<Ty>.new();
                for (p in this.functions[c].params) {
                    tys.push(this.subst(p.ty, info.args));
                }
                let ft = Ty.Fn(
                    FnTy {
                        params = tys.toArray(),
                        result = boxTy(this.subst(this.returnsOf(c, at), info.args)),
                    }
                );
                if (ft == w) {
                    pick = c;
                    count += 1;
                }
            }
        }
        if (count != 1) {
            this.error(
                "LYS-SEM0089",
                f"'{name}' names several members of {info.name}: a value of one is taken where the position's function type says which",
                at
            );
            return -1;
        }
        return pick;
    }

    /// `callAmong` for a method's call, with the position's type and the type arguments written
    /// at it (S7c4c2).
    mut fn callExpecting(
        posTy: ?Ty,
        writtenTys: Ty[],
        name: string,
        candidates: int[],
        receiver: ?TExpr,
        args: Arg[],
        at: Span
    ): TExpr {
        this.callExpected = posTy;
        this.writtenArgs = writtenTys;
        return this.callAmong(name, candidates, receiver, args, at);
    }

    /// Picks the function of `candidates` that takes as many arguments as the call gives (Lyric 5
    /// §8.1.2) and checks the arguments against its parameters.
    mut fn callAmong(
        name: string,
        candidates: int[],
        receiver: ?TExpr,
        written: Arg[],
        at: Span
    ): TExpr {
        // this call's alone: an argument's call checks without them
        let posTy = this.callExpected;
        let writtenTys = this.writtenArgs;
        this.callExpected = null;
        this.writtenArgs = [];
        // the arguments a member's choice checked already (S7c5d2)
        var pre = this.preChecked;
        this.preChecked = [];
        var args = written;
        // one that takes exactly the count first, then one whose variadic parameter takes the rest
        // (Lyric 5 08 §1 rule 1; S7e4a)
        var chosen = -1;
        for (c in candidates) {
            let params = this.functions[c].params;
            var required = 0;
            for (p in params) {
                if (p.default == null && !p.variadic) {
                    required += 1;
                }
            }
            if (!variadicIn(params)
                && args.length() >= required
                && args.length() <= params.length()) {
                chosen = c;
            }
        }
        if (chosen < 0) {
            for (c in candidates) {
                let params = this.functions[c].params;
                var required = 0;
                for (p in params) {
                    if (p.default == null && !p.variadic) {
                        required += 1;
                    }
                }
                if (variadicIn(params) && args.length() >= required) {
                    chosen = c;
                }
            }
        }
        // a spread refused leaves its parameter without an argument, said once (Lyric 5: checked
        // as nothing)
        var refused = false;
        if (chosen >= 0) {
            let (moved, refusal) = this.gatherRest(chosen, written, name, at);
            args = moved;
            refused = refusal;
            if (args.length() != written.length() || variadicIn(this.functions[chosen].params)) {
                // the arguments moved: what a member's choice checked is checked again
                pre = [];
            }
        }
        if (chosen < 0) {
            if (candidates.length() == 1) {
                let n = this.functions[candidates[0]].params.length();
                this.error("LYS-SEM0014", f"'{name}' takes {n} arguments, not {args.length()}", at);
            } else {
                this.error(
                    "LYS-SEM0087",
                    f"no function '{name}' takes {args.length()} arguments",
                    at
                );
            }
            for (a in args) {
                this.expr(a.value, null);
            }
            return TExpr.Unknown;
        }
        let params = this.functions[chosen].params;
        let given = List<?TExpr>.new();
        for (_ in params) {
            given.push(null);
        }
        // a generic's type arguments: bound by the arguments, a lambda's after the others
        let typeParams = this.functions[chosen].typeParams;
        let binds = List<?Ty>.new();
        for (_ in typeParams) {
            binds.push(null);
        }
        let deferred = List<int>.new();
        let deferredArgs = List<Expr>.new();
        // a method of an instance of a generic type: the instance's arguments bound already
        var preset = 0;
        if (this.presetBinds.length() <= typeParams.length()) {
            var j = 0;
            for (x in this.presetBinds) {
                // a placeholder written, `f<_, int>(x)`: the inference fills it (S7c6d)
                binds[j] = if (isHole(x)) null else x;
                j += 1;
            }
            preset = j;
        }
        this.presetBinds = [];
        // type arguments written at a method: its own, after what its receiver binds (Lyric 5
        // §9.2 rule 4; S7c4c2: `it.collect<int[]>()`)
        if (writtenTys.length() > 0) {
            this.writtenTaken = true;
            let own = typeParams.length() - preset;
            let ownParams = sliceOf(typeParams, preset, typeParams.length());
            let filled = if (writtenTys.length() <= own) this.withDefaults(
                ownParams,
                writtenTys,
                null
            )
                else null;
            if (filled == null) {
                this.error(
                    "LYS-SEM0026",
                    f"'{name}' takes {own} type arguments, not {writtenTys.length()}",
                    at
                );
                for (a in args) {
                    this.expr(a.value, null);
                }
                return TExpr.Unknown;
            } else {
                var j = 0;
                for (x in filled) {
                    binds[preset + j] = if (isHole(x)) null else x;
                    j += 1;
                }
            }
        }
        var position = 0;
        var named = false;
        var ai = -1;
        for (a in args) {
            ai += 1;
            let argName = a.name;
            var k = position;
            if (argName != null) {
                named = true;
                k = -1;
                var j = 0;
                for (p in params) {
                    if (p.name == argName) {
                        k = j;
                    }
                    j += 1;
                }
                if (k < 0) {
                    this.error(
                        "LYS-SEM0119",
                        f"'{name}' has no parameter '{argName}'",
                        spanOf(a.value)
                    );
                    continue;
                }
            } else {
                if (named) {
                    this.error(
                        "LYS-SEM0119",
                        "a positional argument after a named one",
                        spanOf(a.value)
                    );
                    continue;
                }
                position += 1;
            }
            if (given[k] != null) {
                this.error("LYS-SEM0119", f"'{params[k].name}' is given twice", spanOf(a.value));
                continue;
            }
            if (typeParams.length() == 0) {
                given[k] = this.coerce(
                    if (ai < pre.length()) pre[ai] else this.expr(a.value, params[k].ty),
                    params[k].ty,
                    spanOf(a.value)
                );
                continue;
            }
            let isLambda = match (a.value) {
                .Lambda(_, _, _, _, _) => true,
                _ => false,
            };
            if (isLambda && ai >= pre.length()) {
                deferred.push(k);
                deferredArgs.push(a.value);
                continue;
            }
            let want = this.substOpen(params[k].ty, binds.toArray());
            // a position still naming a parameter gives no type: `Box { v = 1 }` at a `Box<T>` binds
            // `T` from its field (S7c5a; since S3g it was checked against the open `T`)
            let v = if (ai < pre.length()) pre[ai]
                else this.expr(
                    a.value,
                    if (this.leavesOpen(params[k].ty, binds.toArray())) null else want
                );
            this.bind(params[k].ty, typeOf(v), binds);
            given[k] = v;
        }
        if (typeParams.length() > 0) {
            var d = 0;
            for (k in deferred) {
                let want = this.substOpen(params[k].ty, binds.toArray());
                let v = this.expr(deferredArgs[d], want);
                this.bind(params[k].ty, typeOf(v), binds);
                given[k] = v;
                d += 1;
            }
            // what the arguments leave open, the position's type binds; it never overrides them
            // (Lyric 5 §9.2 rule 2; S7c4c2: `let xs: int[] = it.collect()`)
            if (posTy != null) {
                this.bind(this.returnsOf(chosen, at), posTy, binds);
            }
            // a constraint naming another parameter, at its binding (S7c4c2: `C ::
            // [FromIterator<Self.Item>]`)
            let known = List<Ty>.new();
            for (b in binds) {
                known.push(b ?? Ty.Unknown);
            }
            let bindsNow = known.toArray();
            let args = List<Ty>.new();
            var j = 0;
            for (tp in typeParams) {
                let b = binds[j];
                if (b == null) {
                    this.error(
                        "LYS-SEM0060",
                        f"nothing here says what '{tp.name}' of '{name}' is: write it",
                        at
                    );
                    args.push(Ty.Unknown);
                } else {
                    for (c in tp.constraints) {
                        let ii = this.constraintAt(c, bindsNow);
                        if (b != .Unknown && !this.conformsTo(b, ii)) {
                            this.error(
                                "LYS-SEM0028",
                                f"{this.tyName(b)} is no {this.types[ii].name}, which '{tp.name}' of '{name}' asks",
                                at
                            );
                        }
                    }
                    // what the constraints fix, the argument answers (05 §8 rule 5)
                    for (f in tp.fixed) {
                        if (b == .Unknown) {
                            continue;
                        }
                        let got = this.answerThroughAt(b, f.iface, f.name, at);
                        let asked = this.subst(f.ty, bindsNow);
                        if (got != .Unknown && asked != .Unknown && got != asked) {
                            this.error(
                                "LYS-SEM0028",
                                f"{this.tyName(b)} answers '{f.name}' with {this.tyName(got)}, where '{tp.name}' of '{name}' asks for {this.tyName(f.ty)}",
                                at
                            );
                        }
                    }
                    args.push(b);
                }
                j += 1;
            }
            let bound = args.toArray();
            let out = List<TExpr>.new();
            if (receiver != null) {
                out.push(receiver);
            }
            var k = 0;
            for (p in params) {
                let v = given[k];
                let pt = this.subst(p.ty, bound);
                let dflt = p.default;
                if (v != null) {
                    out.push(this.coerce(v, pt, at));
                } else if (dflt != null) {
                    out.push(dflt);
                } else {
                    if (!refused) {
                        this.error("LYS-SEM0014", f"'{name}' needs its argument '{p.name}'", at);
                    }
                    out.push(TExpr.Unknown);
                }
                k += 1;
            }
            return TExpr.CallGeneric(
                chosen,
                bound,
                out.toArray(),
                this.subst(this.returnsOf(chosen, at), bound)
            );
        }
        let out = List<TExpr>.new();
        if (receiver != null) {
            out.push(receiver);
        }
        var k = 0;
        for (p in params) {
            let v = given[k];
            let dflt = p.default;
            if (v != null) {
                out.push(v);
            } else if (dflt != null) {
                out.push(dflt);
            } else {
                if (!refused) {
                    this.error("LYS-SEM0014", f"'{name}' needs its argument '{p.name}'", at);
                }
                out.push(TExpr.Unknown);
            }
            k += 1;
        }
        return TExpr.Call(chosen, out.toArray(), this.returnsOf(chosen, at));
    }

    /// The arguments as function `chosen` takes them (Lyric 5 08 §1 rule 1; S7e4a): the positional
    /// ones past its fixed parameters one array literal, given to its variadic parameter by name —
    /// or the array a spread hands on, the whole rest; a spread anywhere else refused
    /// (`LYS-SEM0166`), checked as nothing — and whether one was.
    mut fn gatherRest(chosen: int, written: Arg[], name: string, at: Span): (Arg[], bool) {
        let params = this.functions[chosen].params;
        let variadic = variadicIn(params);
        var spreads = 0;
        for (a in written) {
            if (a.spread != null) {
                spreads += 1;
            }
        }
        if (!variadic && spreads == 0) {
            return (written, false);
        }
        // the call answers for its spreads here
        this.synth.spreadTaken = true;
        let fixed = if (variadic) params.length() - 1 else params.length();
        let vname = if (variadic) params[fixed].name else "";
        let out = List<Arg>.new();
        let rest = List<Expr>.new();
        var handed: ?Expr = null;
        var position = 0;
        var seen = 0;
        var refused = false;
        for (a in written) {
            if (let dots = a.spread) {
                seen += 1;
                refused = true;
                if (seen > 1) {
                    this.error(
                        "LYS-SEM0166",
                        "a call spreads one array, the rest of its arguments — this is a second",
                        dots
                    );
                } else if (!variadic) {
                    this.error(
                        "LYS-SEM0166",
                        f"'...' spreads an array over a variadic parameter, and '{name}' has none",
                        dots
                    );
                } else if (a.name != null || position < fixed) {
                    let to = if (position < params.length()) params[position].name else vname;
                    this.error(
                        "LYS-SEM0166",
                        f"'...' spreads an array over the variadic parameter '{vname}', and this argument goes to '{a.name ?? to}'",
                        dots
                    );
                } else {
                    handed = a.value;
                    position += 1;
                    refused = false;
                    continue;
                }
                this.expr(a.value, null);
                if (a.name == null) {
                    position += 1;
                }
                continue;
            }
            if (a.name == null && variadic && position >= fixed) {
                rest.push(a.value);
                position += 1;
                continue;
            }
            if (a.name != null && variadic && a.name == vname) {
                this.error(
                    "LYS-SEM0119",
                    f"'{vname}' is variadic: the call gives it the rest of its positional arguments, by no name",
                    spanOf(a.value)
                );
                this.expr(a.value, null);
                continue;
            }
            if (a.name == null) {
                position += 1;
            }
            out.push(a);
        }
        if (!variadic) {
            return (out.toArray(), refused);
        }
        let whole = handed;
        if (whole != null) {
            if (rest.length() > 0) {
                this.error(
                    "LYS-SEM0166",
                    f"a spread is the whole rest — '{vname}' takes the array as its own, and no other argument beside it",
                    spanOf(rest[0])
                );
                for (r in rest) {
                    this.expr(r, null);
                }
            }
            out.push(Arg { name = vname, value = whole });
        } else {
            out.push(Arg { name = vname, value = Expr.List(rest.toArray(), at) });
        }
        return (out.toArray(), refused);
    }

    /// `print(x)` and `println(x)`, `println()`: the prelude's output, any core value as text.
    /// The prelude's panics (06 §9 rule 1): `panic(m)` says its message as written
    /// (`LYS-RT0008`); `unreachable(m)` and `todo(m)` their word first, the message behind it where
    /// one is given (`LYS-RT0012`, `LYS-RT0013`); `assert(c) { m }` checks where it stands and,
    /// where `c` is false, says `assertion failed`, the condition as written and the message,
    /// built only then (`LYS-RT0011`).
    /// `util.f(x)` and `util.Point(…)` (Lyric 5 04 §4 rule 1): a function of module `target`, or
    /// a type's `new`.
    mut fn moduleCall(target: int, name: string, args: Arg[], at: Span, nameAt: Span): TExpr {
        let key = this.exportKey(target, name);
        let candidates = this.fnByName.get(key);
        if (candidates != null) {
            this.maySee(key, name, target, nameAt);
            return this.callAmong(name, candidates.toArray(), null, args, at);
        }
        let index = this.typeIndex.get(key);
        if (index != null) {
            return this.staticCall(index, "new", args, at);
        }
        let path = this.modNames.get(target) ?? "";
        this.error("LYS-RES0004", f"the module '{path}' declares no function '{name}'", nameAt);
        return TExpr.Unknown;
    }

    mut fn panicking(name: string, args: Arg[], at: Span): TExpr {
        if (name == "assert") {
            if (args.length() < 1 || args.length() > 2) {
                this.error(
                    "LYS-SEM0014",
                    "'assert' takes a condition and, in a block, a message",
                    at
                );
                return TExpr.Unknown;
            }
            let cond = this.condition(args[0].value);
            let where = spanOf(args[0].value);
            let text = this.sources.get(where.file) ?? this.source;
            let written = if (where.start >= 0
                && where.end <= text.length()) text[where.start..where.end].toString()
                else "?";
            var message = TExpr.Str(f"assertion failed: {written}");
            if (args.length() == 2) {
                // the message's block, set in place: built only where the assertion fails
                let body = match (args[1].value) {
                    .Lambda(ps, _, b, _, _) => if (ps.length() == 0) b.value else args[1].value,
                    _ => args[1].value,
                };
                let m = this.coerce(this.expr(body, Ty.Str), Ty.Str, spanOf(args[1].value));
                message = TExpr.Native(
                    Native.Concat,
                    [TExpr.Str(f"assertion failed: {written}: "), m],
                    Ty.Str
                );
            }
            return TExpr.If(
                boxE(TExpr.Unary(UnaryOp.Not, boxE(cond), Ty.Bool)),
                boxE(TExpr.Panic(boxE(message), 11)),
                boxE(TExpr.Unit),
                Ty.Void
            );
        }
        if (args.length() > 1 || (args.length() == 1 && args[0].name != null)) {
            this.error("LYS-SEM0014", f"'{name}' takes one message, or none", at);
            return TExpr.Unknown;
        }
        if (name == "panic") {
            if (args.length() == 0) {
                this.error("LYS-SEM0014", "'panic' takes its message", at);
                return TExpr.Unknown;
            }
            let m = this.coerce(this.expr(args[0].value, Ty.Str), Ty.Str, spanOf(args[0].value));
            return TExpr.Panic(boxE(m), 8);
        }
        let word = if (name == "todo") "not implemented" else "unreachable";
        let code = if (name == "todo") 13 else 12;
        if (args.length() == 0) {
            return TExpr.Panic(boxE(TExpr.Str(word)), code);
        }
        let m = this.coerce(this.expr(args[0].value, Ty.Str), Ty.Str, spanOf(args[0].value));
        return TExpr.Panic(
            boxE(TExpr.Native(Native.Concat, [TExpr.Str(word + ": "), m], Ty.Str)),
            code
        );
    }

    mut fn prelude(name: string, args: Arg[], at: Span): TExpr {
        let native = if (name == "print") Native.Print else Native.Println;
        if (args.length() > 1 || (args.length() == 1 && args[0].name != null)) {
            this.error("LYS-SEM0014", f"'{name}' takes one value, or none", at);
            return TExpr.Unknown;
        }
        if (args.length() == 0) {
            return TExpr.Native(native, [TExpr.Str("")], Ty.Void);
        }
        let v = this.expr(args[0].value, null);
        return TExpr.Native(native, [this.stringOf(v, spanOf(args[0].value))], Ty.Void);
    }
}

/// Whether `t` is the placeholder `_` written among type arguments (S7c6d): the inference fills it.
fn isHole(t: Ty): bool {
    return match (t) {
        .Param(k) => k == -1,
        _ => false,
    };
}

fn boxE(e: TExpr): Box<TExpr> {
    return Box<TExpr> { value = e };
}

fn boxTy(t: Ty): Box<Ty> {
    return Box<Ty> { value = t };
}

/// Whether every path through the statements ends: in a `return`, or a `loop` without a break.
fn endsAll(stmts: TStmt[]): bool {
    if (stmts.length() == 0) {
        return false;
    }
    return ends(stmts[stmts.length() - 1]);
}

/// Whether control never comes out of the end of `stmts` to what follows them: they return,
/// break, continue or give `never` (Lyric 5 §3.2 rule 3, §7.1 rule 5).
fn leavesAll(stmts: TStmt[]): bool {
    if (stmts.length() == 0) {
        return false;
    }
    return leaves(stmts[stmts.length() - 1]);
}

fn leaves(s: TStmt): bool {
    return match (s) {
        .Break(_, _, _) | .Continue(_, _) => true,
        .If(_, then, otherwise, _) => leavesAll(then) && leavesAll(otherwise),
        .Block(stmts, _) => leavesAll(stmts),
        // the defer runs on the way and goes on as the body does
        .Finally(body, _, _, _, _, _, _) => leavesAll(body),
        // an error no clause takes leaves it too
        .Try(body, _, _, clauses, _) => {
            var all = leavesAll(body);
            for (c in clauses) {
                all = all && leavesAll(c.body);
            }
            all
        }
        _ => ends(s),
    };
}

fn ends(s: TStmt): bool {
    return match (s) {
        .Return(_, _) => true,
        .If(_, then, otherwise, _) => endsAll(then) && endsAll(otherwise),
        .Block(stmts, _) => endsAll(stmts),
        .Expr(e, _) => typeOf(e) == .Never,
        .Finally(body, _, _, _, _, _, _) => endsAll(body),
        .Try(body, _, _, clauses, _) => {
            var all = endsAll(body);
            for (c in clauses) {
                all = all && endsAll(c.body);
            }
            all
        }
        _ => false,
    };
}

/// A shape's parts (S7e2c): an optional's value, a tuple's elements, a function's parameters and
/// its result; `null` for no shape.
fn shapeParts(t: Ty): ?Ty[] {
    return match (t) {
        .Optional(inner) => [inner.value],
        .Tuple(tt) => tt.elements,
        .Fn(ft) => {
            let all = List<Ty>.new();
            for (p in ft.params) {
                all.push(p);
            }
            all.push(ft.result.value);
            all.toArray()
        }
        _ => null,
    };
}

/// A shape's kind and arity, the key of its template (S7e2c).
fn shapeKind(t: Ty): string {
    return match (t) {
        .Optional(_) => "?",
        .Tuple(tt) => f"({tt.elements.length()})",
        .Fn(ft) => f"fn({ft.params.length()})",
        _ => "",
    };
}

/// A written shape's kind and its count of parts (S7e2c).
fn shapeKindOf(x: TypeExpr): (string, int) {
    return match (x) {
        .Optional(_, _) => ("?", 1),
        .Tuple(elems, _, _) => (f"({elems.length()})", elems.length()),
        .Fn(params, _, _) => (f"fn({params.length()})", params.length() + 1),
        _ => ("", 0),
    };
}

/// Whether `name` is a scalar's or the string's: a type whose extend blocks may give statics.
fn isScalarOrString(name: string): bool {
    return match (name) {
        "int" | "float" | "bool" | "char" | "string" => true,
        _ => false,
    };
}

fn isBuiltinType(name: string): bool {
    return match (name) {
        // `Map` is std.collections' class since S7d2, a name a module may give its own
        "int" | "float" | "bool" | "char" | "string" | "void" | "never" | "List" => true,
        _ => isWidthType(name),
    };
}

fn isWidthType(name: string): bool {
    return match (name) {
        "int8" | "int16" | "int32" | "int64" | "uint" | "uint8" | "uint16" | "uint32" | "uint64" => true,
        "float32" | "float64" => true,
        _ => false,
    };
}

fn itemLine(item: Item): int {
    return match (item) {
        .Stmt(s) => stmtSpan(s).line,
        .Decl(d) => match (d) {
            .Fn(f) => f.span.line,
            .Type(t) => t.span.line,
            .Enum(e) => e.span.line,
            .Alias(a) => a.span.line,
            .Interface(i) => i.span.line,
            .Extend(x) => x.span.line,
            .Import(im) => im.span.line,
        },
    };
}

fn stmtSpan(s: Stmt): Span {
    return match (s) {
        .Throw(_, at) => at,
        .Try(_, _, at) => at,
        .Defer(_, at) | .Using(_, _, _, at) | .DoWhile(_, _, _, at) => at,
        .Expr(_, at) => at,
        .Let(_, _, _, _, at) => at,
        .LocalFn(f) => f.span,
        .Destructure(_, _, _, _, at) => at,
        .If(_, _, _, at) => at,
        .While(_, _, _, at) => at,
        .For(_, _, _, _, at) => at,
        .Break(_, _, at) => at,
        .Continue(_, at) => at,
        .Return(_, at) | .Yield(_, at) => at,
        .Block(_, at) => at,
        .IfLet(_, _, _, _, at) => at,
        .WhileLet(_, _, _, _, at) => at,
    };
}

/// Whether any of `stmts`, from `from` on, writes the binding `name` (a loop that writes a
/// narrowed binding has it narrowed in none of its turns).
fn writesIn(stmts: Stmt[], from: int, name: string): bool {
    var k = from;
    while (k < stmts.length()) {
        if (stmtAny(stmts[k], (_: Stmt) => false, (e: Expr) => assigns(e, name))) {
            return true;
        }
        k += 1;
    }
    return false;
}

/// Whether `e` is an assignment to the name `name` itself.
fn assigns(e: Expr, name: string): bool {
    return match (e) {
        .Assign(target, _, _, _) | .Step(target, _, _, _) => {
            match (target.value) {
                .Name(n, _) => n == name,
                _ => false,
            }
        }
        _ => false,
    };
}

/// Whether one of `stmts`, or a statement in a block in them, is `var x = null`: its function
/// takes two passes (03 Leer).
fn declaresNull(stmts: Stmt[]): bool {
    for (s in stmts) {
        if (stmtAny(s, (t: Stmt) => isNullVar(t), (_: Expr) => false)) {
            return true;
        }
    }
    return false;
}

fn fnDeclaresNull(decl: FnDecl): bool {
    return match (decl.body) {
        .Block(b) => declaresNull(b.stmts),
        .Expr(e) => exprAny(e, (t: Stmt) => isNullVar(t), (_: Expr) => false),
        .None => false,
    };
}

fn isNullVar(s: Stmt): bool {
    match (s) {
        .Let(isVar, _, written, value, _) => {
            if (written == null && value != null) {
                return (isVar && isNullLit(value)) || isEmptyList(value);
            }
        }
        _ => { }
    }
    return false;
}

/// `x`, then `xs` (S7c1b): `Self`, then a generic interface's arguments.
fn withSelfTy(x: Ty, xs: Ty[]): Ty[] {
    let out = List<Ty>.new();
    out.push(x);
    for (y in xs) {
        out.push(y);
    }
    return out.toArray();
}

/// The entries of `m` whose function is `n` or later: gone.
fn dropIntKeyed(m: Map<int, int>, n: int): void {
    let stale = List<int>.new();
    for (k in m.keys()) {
        if ((m.get(k) ?? -1) >= n) {
            stale.push(k);
        }
    }
    for (k in stale) {
        m.remove(k);
    }
}

fn dropTextKeyed(m: Map<string, int>, n: int): void {
    let stale = List<string>.new();
    for (k in m.keys()) {
        if ((m.get(k) ?? -1) >= n) {
            stale.push(k);
        }
    }
    for (k in stale) {
        m.remove(k);
    }
}

/// The copies of generic functions in `instances` that are `n` or later: gone; its instances of
/// types, keyed `type …`, stay — their values are indices of types, not of functions.
fn dropCopies(m: Map<string, int>, n: int): void {
    let stale = List<string>.new();
    for (k in m.keys()) {
        if (!k.startsWith("type ") && (m.get(k) ?? -1) >= n) {
            stale.push(k);
        }
    }
    for (k in stale) {
        m.remove(k);
    }
}

/// `[]`: a list literal of no element (S7b2b).
fn isEmptyList(e: Expr): bool {
    return match (e) {
        .List(items, _) => items.length() == 0,
        _ => false,
    };
}

/// Whether an index counts from the end, `^n`, at itself or at an end of its range.
fn countsFromEnd(i: Expr): bool {
    return match (i) {
        .FromEnd(_, _) => true,
        .Range(a, b, _, _) => countsFromEnd(a.value) || countsFromEnd(b.value),
        _ => false,
    };
}

fn isNullLit(e: Expr): bool {
    return match (e) {
        .Null(_) => true,
        _ => false,
    };
}

/// What a pattern covers, for the check of coverage (Lyric 5 §9 §3): every value, a constructor
/// of the column's type with its parts, a value of an open type, or alternatives.
enum Space {
    Any,
    Ctor(int, Space[]),
    Lit(string),
    Or(Space[]),
    /// A list's elements, and the place of its `..`, -1 for none (S7b3).
    Seq(Space[], int),
}

/// Elements `from` to `to` of `xs`, as an array of their own.
fn sliceOf<T>(xs: T[], from: int, to: int): T[] {
    let out = List<T>.new();
    var k = from;
    while (k < to) {
        out.push(xs[k]);
        k += 1;
    }
    return out.toArray();
}

/// The rows with each alternative of a first column's or-pattern a row of its own.
fn expandOr(rows: Space[][]): Space[][] {
    let out = List<Space[]>.new();
    for (row in rows) {
        match (row[0]) {
            .Or(alternatives) => {
                let alone = List<Space[]>.new();
                for (a in alternatives) {
                    let r = List<Space>.new();
                    r.push(a);
                    for (x in row[1..]) {
                        r.push(x);
                    }
                    alone.push(r.toArray());
                }
                for (r in expandOr(alone.toArray())) {
                    out.push(r);
                }
            }
            _ => out.push(row),
        }
    }
    return out.toArray();
}

/// The rows that admit constructor `c` in their first column, its parts in its place.
fn specialize(rows: Space[][], c: int, arity: int): Space[][] {
    let out = List<Space[]>.new();
    for (row in rows) {
        let r = List<Space>.new();
        var keep = true;
        match (row[0]) {
            .Ctor(d, parts) => {
                keep = d == c;
                for (x in parts) {
                    r.push(x);
                }
            }
            .Any => {
                var k = 0;
                while (k < arity) {
                    r.push(Space.Any);
                    k += 1;
                }
            }
            _ => {
                keep = false;
            }
        }
        if (keep) {
            for (x in row[1..]) {
                r.push(x);
            }
            out.push(r.toArray());
        }
    }
    return out.toArray();
}

/// The rows whose first column takes every value, without it.
fn defaultRows(rows: Space[][]): Space[][] {
    let out = List<Space[]>.new();
    for (row in rows) {
        match (row[0]) {
            .Any => out.push(sliceOf(row, 1, row.length())),
            _ => { }
        }
    }
    return out.toArray();
}

/// Whether `p` matches every value of its type.
fn irrefutable(p: Pattern): bool {
    return match (p) {
        .Name(_, _) | .Ignore(_) => true,
        // `[..]` and `[..rest]`: every list
        .List(items, rest, _, _) => rest >= 0 && items.length() == 0,
        .Tuple(items, _) => {
            var all = true;
            for (x in items) {
                all = all && irrefutable(x);
            }
            all
        }
        .Fields(_, fields, _) => {
            var all = true;
            for (f in fields) {
                all = all && irrefutable(f.pattern);
            }
            all
        }
        .Or(alternatives, _) => {
            var any = false;
            for (x in alternatives) {
                any = any || irrefutable(x);
            }
            any
        }
        _ => false,
    };
}

/// What an arm tests where a later arm testing the same is unreachable (Lyric 5 §9 §4 rule 1): a
/// unit variant, a literal, `null`; `""` for any other pattern.
fn repeatKey(p: Pattern): string {
    return match (p) {
        .Variant(_, name, payload, _) => if (payload == null) "variant " + name else "",
        .Literal(e, _) => litKey(e),
        _ => "",
    };
}

/// A literal's value as a key: two literals of one key test the same value.
fn litKey(e: Expr): string {
    return match (e) {
        .Int(n, _) => f"int {n}",
        .Float(x, _) => f"float {x}",
        .Str(text, _) => "string " + text,
        .Char(c, _) => f"char {c}",
        .Bool(b, _) => f"bool {b}",
        .Null(_) => "null",
        .Unary(op, x, _) => if (op == .Neg) "-" + litKey(x.value) else "?",
        _ => "?",
    };
}

/// That `x`, a binding, holds a `t` where a type test holds.
fn typeFact(x: TExpr, t: Ty, out: List<Fact>): void {
    match (x) {
        .Local(id, _) => out.push(Fact { isGlobal = false, id = id, ty = t }),
        .Global(g, _) => out.push(Fact { isGlobal = true, id = g, ty = t }),
        _ => { }
    }
}

/// Whether a type parameter stands in `t`.
fn hasParam(t: Ty): bool {
    return match (t) {
        .Param(_) => true,
        .Optional(inner) | .List(inner) | .Cell(inner) => hasParam(inner.value),
        .Map(k, v) => hasParam(k.value) || hasParam(v.value),
        .Tuple(tt) => {
            var found = false;
            for (x in tt.elements) {
                found = found || hasParam(x);
            }
            found
        }
        .Fn(ft) => {
            var found = hasParam(ft.result.value);
            for (x in ft.params) {
                found = found || hasParam(x);
            }
            found
        }
        _ => false,
    };
}

/// Binds the type parameters of `pattern` by `actual` (03 §9.2 rule 1): at any depth; a plain
/// value where `?U` is asked binds `U`; the first binding stays.
fn bindTyFree(pattern: Ty, actual: Ty, binds: List<?Ty>): void {
    if (actual == .Unknown || actual == .NullLit || actual == .Never) {
        return;
    }
    match (pattern) {
        .Param(k) => {
            if (k < binds.length() && binds[k] == null) {
                binds[k] = actual;
            }
        }
        .Optional(p) => {
            match (actual) {
                .Optional(x) => bindTyFree(p.value, x.value, binds),
                _ => bindTyFree(p.value, actual, binds),
            }
        }
        .List(p) => {
            match (actual) {
                .List(x) => bindTyFree(p.value, x.value, binds),
                _ => { }
            }
        }
        .Tuple(pt) => {
            match (actual) {
                .Tuple(xt) => {
                    var k = 0;
                    while (k < pt.elements.length() && k < xt.elements.length()) {
                        bindTyFree(pt.elements[k], xt.elements[k], binds);
                        k += 1;
                    }
                }
                _ => { }
            }
        }
        .Fn(pf) => {
            match (actual) {
                .Fn(xf) => {
                    var k = 0;
                    while (k < pf.params.length() && k < xf.params.length()) {
                        bindTyFree(pf.params[k], xf.params[k], binds);
                        k += 1;
                    }
                    bindTyFree(pf.result.value, xf.result.value, binds);
                }
                _ => { }
            }
        }
        _ => { }
    }
}

/// The built-in type `name` names.
fn builtinTy(name: string): Ty {
    return match (name) {
        "int" => Ty.Int,
        "float" => Ty.Float,
        "bool" => Ty.Bool,
        "char" => Ty.Char,
        "string" => Ty.Str,
        _ => Ty.Unknown,
    };
}

/// Whether `__name` is one of the VM's intrinsics — a native of the standard library's table, or
/// an op the prelude calls —, not a function of the prelude.
fn isIntrinsic(name: string): bool {
    if (nativeNamed(name[2..name.length()].toString().replace("_", ".")) != null) {
        return true;
    }
    return match (name) {
        "__chanReady" | "__chanWatch" | "__parkWatched" | "__sleep" | "__readLine" => true,
        "__timerAfter" | "__listTruncate" | "__listChanges" | "__listCheck" | "__boundsPanic" => true,
        "__changedPanic" | "__debugOf" | "__argumentPanic" => true,
        "__coNext" | "__coClose" | "__scopeClose" => true,
        _ => false,
    };
}

/// What a lambda captures: the name, the value in the function around, its type, and whether
/// it is a `var`'s box.
struct Capture {
    name: string,
    source: TExpr,
    ty: Ty,
    isCell: bool,
}

/// Whether the value block `v` never comes out of its statements: they return or leave.
fn blockEnds(v: TExpr): bool {
    return match (v) {
        .Block(list, _, _) => endsAll(list),
        _ => false,
    };
}

/// The local `name` binds in context `c`, from its innermost scope out.
fn lookupIn(c: FnCtx, name: string): ?int {
    var k = c.scopes.length() - 1;
    while (k >= 0) {
        let id = c.scopes[k].names.get(name);
        if (id != null) {
            return id;
        }
        k -= 1;
    }
    return null;
}

/// The function type the position expects, through an optional; `null` where it expects none.
fn expectedFn(expected: ?Ty): ?FnTy {
    if (expected == null) {
        return null;
    }
    let t = match (expected) {
        .Optional(inner) => inner.value,
        _ => expected,
    };
    return match (t) {
        .Fn(ft) => ft,
        _ => null,
    };
}

/// A field `with` replaces: its path, the step the struct being built is at, the value.
struct WithUpdate {
    path: string[],
    from: int,
    value: TExpr,
}

/// Whether `a` is `b`, or one of them unknown after a fault reported already.
/// Which of extend block `x`'s parameters its target is, where it is one alone, `extend<I ::
/// [Iterator]> I` (05 §13 rule 7); -1 for any other target.
fn blanketTarget(x: ExtendDecl): int {
    let name = match (x.target) {
        .Named(n, targs, _) => if (targs.length() == 0) n else "",
        _ => "",
    };
    var k = 0;
    for (tp in x.typeParams) {
        if (tp.name == name) {
            return k;
        }
        k += 1;
    }
    return -1;
}

/// Two conditions on one type's arguments, both asked: each parameter's constraints of either.
fn mergeConds(a: TypeParamInfo[], b: TypeParamInfo[]): TypeParamInfo[] {
    let out = List<TypeParamInfo>.new();
    var k = 0;
    for (p in a) {
        let cs = List<int>.new();
        for (c in p.constraints) {
            cs.push(c);
        }
        if (k < b.length()) {
            for (c in b[k].constraints) {
                cs.push(c);
            }
        }
        out.push(
            TypeParamInfo {
                name = p.name,
                constraints = cs.toArray(),
                fixed = p.fixed,
                defaultType = p.defaultType,
                defaultMod = p.defaultMod,
            }
        );
        k += 1;
    }
    return out.toArray();
}

/// The operator interface of a binary operator, and its member (Lyric 5 05 §12 rule 1); ("",
/// "") for one no interface carries.
fn operatorOf(op: BinaryOp): (string, string) {
    return match (op) {
        .Add => ("Add", "add"),
        .Sub => ("Sub", "sub"),
        .Mul => ("Mul", "mul"),
        .Div => ("Div", "div"),
        .Rem => ("Rem", "rem"),
        .BitAnd => ("BitAnd", "bitAnd"),
        .BitOr => ("BitOr", "bitOr"),
        .BitXor => ("BitXor", "bitXor"),
        .Shl => ("Shl", "shl"),
        .Shr => ("Shr", "shr"),
        _ => ("", ""),
    };
}

/// Whether a function's last parameter is variadic (S7e4a).
fn variadicIn(params: ParamInfo[]): bool {
    return params.length() > 0 && params[params.length() - 1].variadic;
}

/// The slice that builds what a built-in type still lacks — a string's methods and indexing, a
/// number's, a map's (plan 14).
fn laterClock(t: Ty): string {
    return match (t) {
        .Int | .Float => "S7f (numbers)",
        .Map(_, _) => "S7d (maps and sets)",
        _ => "S7e (strings and formats)",
    };
}

fn sameOrUnknown(a: Ty, b: Ty): bool {
    return a == b || a == .Unknown || b == .Unknown;
}

/// Whether a written type names `Self` itself, not one of its associated types.
fn mentionsSelfItself(t: TypeExpr): bool {
    return match (t) {
        .Named(name, args, _) => {
            var found = name == "Self";
            for (x in args) {
                found = found || mentionsSelfItself(x);
            }
            found
        }
        .Optional(inner, _) => mentionsSelfItself(inner.value),
        .List(inner, _) => mentionsSelfItself(inner.value),
        .Tuple(elements, _, _) => {
            var found = false;
            for (x in elements) {
                found = found || mentionsSelfItself(x);
            }
            found
        }
        .Fn(params, result, _) => {
            var found = mentionsSelfItself(result.value);
            for (x in params) {
                found = found || mentionsSelfItself(x);
            }
            found
        }
    };
}

/// Whether a written type names `Self`.
fn mentionsSelf(t: TypeExpr): bool {
    return match (t) {
        .Named(name, args, _) => {
            var found = name == "Self" || name.startsWith("Self.");
            for (x in args) {
                found = found || mentionsSelf(x);
            }
            found
        }
        .Optional(inner, _) => mentionsSelf(inner.value),
        .List(inner, _) => mentionsSelf(inner.value),
        .Tuple(elements, _, _) => {
            var found = false;
            for (x in elements) {
                found = found || mentionsSelf(x);
            }
            found
        }
        .Fn(params, result, _) => {
            var found = mentionsSelf(result.value);
            for (x in params) {
                found = found || mentionsSelf(x);
            }
            found
        }
    };
}

/// A type's name as declared: an instance's without its arguments.
fn declaredName(name: string): string {
    var k = 0;
    for (c in name.chars()) {
        if (c == '<') {
            return name[0..k].toString();
        }
        k += 1;
    }
    return name;
}

/// A type's constant to set where the script begins: its global, its value, its type, its type's
/// entry.
struct StaticInit {
    global: int,
    value: Expr,
    ty: Ty,
    owner: int,
}

/// The place of what the compiler makes without a source of its own.
let nowhereSpan: Span = Span { start = 0, end = 0, line = 1, column = 1 };

/// The strings `parts` joined, left to right.
fn concatAll(parts: TExpr[]): TExpr {
    var out = parts[0];
    var k = 1;
    while (k < parts.length()) {
        out = TExpr.Native(Native.Concat, [out, parts[k]], Ty.Str);
        k += 1;
    }
    return out;
}

/// A name a pattern binds, and the part of the matched value it holds.
struct Bound {
    name: string,
    value: TExpr,
    at: Span,
}

fn boundNamed(bounds: List<Bound>, name: string): ?TExpr {
    for (b in bounds) {
        if (b.name == name) {
            return b.value;
        }
    }
    return null;
}

fn andOf(a: TExpr, b: TExpr): TExpr {
    return TExpr.Binary(boxE(a), BinaryOp.And, boxE(b), Ty.Bool);
}

/// Both tests; a missing one tests nothing.
fn andMaybe(a: ?TExpr, b: ?TExpr): ?TExpr {
    if (a == null) {
        return b;
    }
    if (b == null) {
        return a;
    }
    return andOf(a, b);
}

/// That the optional `src` holds a value, and then `test`.
fn presentAnd(src: TExpr, test: ?TExpr): TExpr {
    let present = TExpr.Unary(UnaryOp.Not, boxE(TExpr.IsNull(boxE(src))), Ty.Bool);
    return if (test != null) andOf(present, test) else present;
}

/// Whether `e` names a member of the enum its position expects: `.Red`, `.Num(3)`, `.Rect { … }`.
fn isImplicit(e: Expr): bool {
    return match (e) {
        .Implicit(_, _) | .VariantInit(_, _, _, _) => true,
        .Call(callee, _, _) => isImplicit(callee.value),
        _ => false,
    };
}

/// The tuple of `n` elements `expected` is, or holds as an optional; `null` where it is none.
fn expectedTuple(expected: ?Ty, n: int): ?TupleTy {
    if (expected == null) {
        return null;
    }
    let t = match (expected) {
        .Optional(inner) => inner.value,
        _ => expected,
    };
    return match (t) {
        .Tuple(tt) => if (tt.elements.length() == n) tt else null,
        _ => null,
    };
}

/// The position `t.0` names: its digits as a number, -1 where it is no number (or no position a
/// tuple could have).
fn positionOf(name: string): int {
    var n = 0;
    for (c in name.chars()) {
        let d = c.toDigit(10);
        if (d == null || n > 1000) {
            return -1;
        }
        n = n * 10 + d;
    }
    return n;
}

/// `s` and `id` in it, as a new set: the sets of what is unassigned are never changed in place.
fn withId(s: Set<int>, id: int): Set<int> {
    let out = s.union(Set<int>.new());
    out.insert(id);
    return out;
}

fn withoutId(s: Set<int>, id: int): Set<int> {
    if (!s.contains(id)) {
        return s;
    }
    let out = s.union(Set<int>.new());
    out.remove(id);
    return out;
}

/// Whether `onStmt` holds of `s` or of a statement in it, or `onExpr` of an expression in it: the
/// one walk over the children of a statement.
fn stmtAny(s: Stmt, onStmt: fn(Stmt) -> bool, onExpr: fn(Expr) -> bool, deep: bool = true): bool {
    if (onStmt(s)) {
        return true;
    }
    return match (s) {
        .Throw(e, _) => exprAny(e, onStmt, onExpr, deep),
        .Defer(body, _) => blockAny(body, onStmt, onExpr, deep),
        .DoWhile(body, cond, _, _) => blockAny(body, onStmt, onExpr, deep)
            || exprAny(cond, onStmt, onExpr, deep),
        .Using(_, _, value, _) => exprAny(value, onStmt, onExpr, deep),
        .Try(body, clauses, _) => {
            var found = blockAny(body, onStmt, onExpr, deep);
            for (c in clauses) {
                found = found || blockAny(c.body, onStmt, onExpr, deep);
            }
            found
        }
        .Expr(e, _) => exprAny(e, onStmt, onExpr, deep),
        .Let(_, _, _, v, _) => v != null && exprAny(v, onStmt, onExpr, deep),
        .LocalFn(f) => {
            match (f.body) {
                .Block(b) => deep && blockAny(b, onStmt, onExpr, deep),
                .Expr(e) => deep && exprAny(e, onStmt, onExpr, deep),
                .None => false,
            }
        }
        .Destructure(_, _, v, e, _) => exprAny(v, onStmt, onExpr, deep)
            || (e != null && blockAny(e, onStmt, onExpr, deep)),
        .If(c, then, o, _) => exprAny(c, onStmt, onExpr, deep)
            || blockAny(then, onStmt, onExpr, deep)
            || (o != null && stmtAny(o.value, onStmt, onExpr, deep)),
        .While(c, b, _, _) => exprAny(c, onStmt, onExpr, deep) || blockAny(b, onStmt, onExpr, deep),
        .For(_, it, b, _, _) => exprAny(it, onStmt, onExpr, deep)
            || blockAny(b, onStmt, onExpr, deep),
        .Break(_, v, _) => v != null && exprAny(v, onStmt, onExpr, deep),
        .Continue(_, _) => false,
        .Return(v, _) | .Yield(v, _) => v != null && exprAny(v, onStmt, onExpr, deep),
        .Block(b, _) => blockAny(b, onStmt, onExpr, deep),
        .IfLet(_, v, b, o, _) => exprAny(v, onStmt, onExpr, deep)
            || blockAny(b, onStmt, onExpr, deep)
            || (o != null && stmtAny(o.value, onStmt, onExpr, deep)),
        .WhileLet(_, v, b, _, _) => exprAny(v, onStmt, onExpr, deep)
            || blockAny(b, onStmt, onExpr, deep),
    };
}

/// `state == n`, for a task's state the VM numbers (S6c3).
fn isState(state: TExpr, n: int): TExpr {
    return TExpr.Binary(boxE(state), BinaryOp.Eq, boxE(TExpr.Int(n)), Ty.Bool);
}

/// Whether the block has a `yield` of its own — one outside every lambda and local function in
/// it (Lyric 5 10 §1 rule 1).
fn hasOwnYield(b: Block): bool {
    return blockAny(
        b,
        (s: Stmt) => match (s) {
            .Yield(_, _) => true,
            _ => false,
        },
        (_: Expr) => false,
        false
    );
}

/// Whether the block returns a value of its own: a `return v` outside its lambdas.
fn returnsValue(b: Block): bool {
    return blockAny(
        b,
        (s: Stmt) => match (s) {
            .Return(v, _) => v != null,
            _ => false,
        },
        (_: Expr) => false,
        false
    );
}

fn blockAny(b: Block, onStmt: fn(Stmt) -> bool, onExpr: fn(Expr) -> bool, deep: bool = true): bool {
    for (s in b.stmts) {
        if (stmtAny(s, onStmt, onExpr, deep)) {
            return true;
        }
    }
    return false;
}

fn exprAny(e: Expr, onStmt: fn(Stmt) -> bool, onExpr: fn(Expr) -> bool, deep: bool = true): bool {
    if (onExpr(e)) {
        return true;
    }
    return match (e) {
        .Assign(target, _, value, _) => exprAny(target.value, onStmt, onExpr, deep)
            || exprAny(value.value, onStmt, onExpr, deep),
        .Step(target, _, _, _) => exprAny(target.value, onStmt, onExpr, deep),
        .Unary(_, x, _) => exprAny(x.value, onStmt, onExpr, deep),
        .Binary(l, _, r, _) => exprAny(l.value, onStmt, onExpr, deep)
            || exprAny(r.value, onStmt, onExpr, deep),
        .Range(a, b, _, _) => exprAny(a.value, onStmt, onExpr, deep)
            || exprAny(b.value, onStmt, onExpr, deep),
        .Cast(x, _, _) => exprAny(x.value, onStmt, onExpr, deep),
        .Call(c, args, _) => {
            var found = exprAny(c.value, onStmt, onExpr, deep);
            for (a in args) {
                found = found || exprAny(a.value, onStmt, onExpr, deep);
            }
            found
        }
        .Index(x, i, _) => exprAny(x.value, onStmt, onExpr, deep)
            || exprAny(i.value, onStmt, onExpr, deep),
        .Member(x, _, _, _) => exprAny(x.value, onStmt, onExpr, deep),
        .List(items, _) => {
            var found = false;
            for (x in items) {
                found = found || exprAny(x, onStmt, onExpr, deep);
            }
            found
        }
        .Map(entries, _) => {
            var found = false;
            for (en in entries) {
                found = found
                    || exprAny(en.key, onStmt, onExpr, deep)
                    || exprAny(en.value, onStmt, onExpr, deep);
            }
            found
        }
        .StructInit(_, _, fields, _) => {
            var found = false;
            for (f in fields) {
                found = found || exprAny(f.value, onStmt, onExpr, deep);
            }
            found
        }
        .With(target, fields, _) => {
            var found = exprAny(target.value, onStmt, onExpr, deep);
            for (f in fields) {
                found = found || exprAny(f.value, onStmt, onExpr, deep);
            }
            found
        }
        .Interpolated(segments, _) => {
            var found = false;
            for (seg in segments) {
                match (seg) {
                    .Hole(x, _) => found = found || exprAny(x, onStmt, onExpr, deep),
                    .Text(_) => { }
                }
            }
            found
        }
        .If(c, a, b, _) => exprAny(c.value, onStmt, onExpr, deep)
            || exprAny(a.value, onStmt, onExpr, deep)
            || exprAny(b.value, onStmt, onExpr, deep),
        .Block(b, _) => blockAny(b, onStmt, onExpr, deep),
        .Loop(b, _, _) => blockAny(b, onStmt, onExpr, deep),
        .Unwrap(x, _) => exprAny(x.value, onStmt, onExpr, deep),
        .Tuple(items, _) => {
            var found = false;
            for (x in items) {
                found = found || exprAny(x, onStmt, onExpr, deep);
            }
            found
        }
        .Lambda(_, _, body, _, _) => deep && exprAny(body.value, onStmt, onExpr, deep),
        .Throw(x, _) => exprAny(x.value, onStmt, onExpr, deep),
        .TryMark(x, _) | .TryOpt(x, _) | .TryBang(x, _) => exprAny(x.value, onStmt, onExpr, deep),
        .TryCatch(x, clauses, _) => {
            var found = exprAny(x.value, onStmt, onExpr, deep);
            for (c in clauses) {
                found = found || blockAny(c.body, onStmt, onExpr, deep);
            }
            found
        }
        .Is(x, _, _) => exprAny(x.value, onStmt, onExpr, deep),
        .Instance(x, _, _) => exprAny(x.value, onStmt, onExpr, deep),
        .VariantInit(_, _, fields, _) => {
            var found = false;
            for (f in fields) {
                found = found || exprAny(f.value, onStmt, onExpr, deep);
            }
            found
        }
        .Match(x, arms, _) => {
            var found = exprAny(x.value, onStmt, onExpr, deep);
            for (arm in arms) {
                let g = arm.guard;
                found = found
                    || (g != null && exprAny(g, onStmt, onExpr, deep))
                    || exprAny(arm.body, onStmt, onExpr, deep);
            }
            found
        }
        _ => false,
    };
}

/// Where an expression stands.
/// `e` without its `try` marks.
fn unmarked(e: Expr): Expr {
    return match (e) {
        .TryMark(x, _) => unmarked(x.value),
        _ => e,
    };
}

fn spanOf(e: Expr): Span {
    return match (e) {
        .Throw(_, at) => at,
        .TryMark(_, at) | .TryOpt(_, at) | .TryBang(_, at) | .TryCatch(_, _, at) => at,
        .Int(_, at) => at,
        .Float(_, at) => at,
        .Bool(_, at) => at,
        .Char(_, at) => at,
        .Str(_, at) => at,
        .Bytes(_, at) => at,
        .Interpolated(_, at) => at,
        .Null(at) => at,
        .Name(_, at) => at,
        .This(at) => at,
        .Unary(_, _, at) => at,
        .Binary(_, _, _, at) => at,
        .Assign(_, _, _, at) => at,
        .Step(_, _, _, at) => at,
        .Range(_, _, _, at) => at,
        .Cast(_, _, at) => at,
        .Call(_, _, at) => at,
        .Index(_, _, at) => at,
        .Member(_, _, _, at) => at,
        .List(_, at) => at,
        .Map(_, at) => at,
        .StructInit(_, _, _, at) => at,
        .With(_, _, at) => at,
        .If(_, _, _, at) => at,
        .Block(_, at) => at,
        .Loop(_, _, at) => at,
        .Unwrap(_, at) => at,
        .Tuple(_, at) => at,
        .Implicit(_, at) => at,
        .FromEnd(_, at) => at,
        .VariantInit(_, _, _, at) => at,
        .Match(_, _, at) => at,
        .Is(_, _, at) => at,
        .Instance(_, _, at) => at,
        .Lambda(_, _, _, _, at) => at,
    };
}

/// The file an item stands in: its declaration's or its statement's.
fn itemFile(item: Item): int {
    return match (item) {
        .Stmt(st) => fileModule(stmtSpan(st).file),
        .Decl(d) => fileModule(
            match (d) {
                .Fn(f) => f.span.file,
                .Type(t) => t.span.file,
                .Enum(e) => e.span.file,
                .Alias(a) => a.span.file,
                .Interface(i) => i.span.file,
                .Extend(x) => x.span.file,
                .Import(im) => im.span.file,
            }
        ),
    };
}

/// A file's module: the file itself; the prelude's, which is parsed with no file of the
/// program, -1.
fn fileModule(file: int): int {
    return if (file < 0) -1 else file;
}

/// Whether a statement of an imported module binds its globals: what of it runs (07 Top, V5).
fn bindsGlobals(st: Stmt): bool {
    return match (st) {
        .Let(_, _, _, _, _) | .Destructure(_, _, _, _, _) => true,
        _ => false,
    };
}

/// The key of `name` in module `m` whose path is `path`: "<path>::<name>" in a module of the
/// program — the entry's path empty —, the name alone in the prelude.
/// The names std.collections declares for a program to import (S7d4, P28): its types and
/// functions but the natives' wrappers, and `List`, the prelude's alias of every list, which is a
/// class of Lyric 5's `std.collections`. Read where a program imports the module, alone.
fn collectionsNames(): Set<string> {
    let out = Set<string>.new();
    out.insert("List");
    for (item in parse(collectionsText(), -1).module.items) {
        let name = match (item) {
            .Decl(.Fn(f)) => f.name,
            .Decl(.Type(t)) => t.name,
            .Decl(.Enum(e)) => e.name,
            .Decl(.Alias(a)) => a.name,
            .Decl(.Interface(i)) => i.name,
            _ => "",
        };
        if (name != "" && !name.startsWith("__")) {
            out.insert(name);
        }
    }
    return out;
}

fn keyIn(path: string, m: int, name: string): string {
    return if (m < 0) name else path + "::" + name;
}

/// The prelude's functions the compiler knows rather than declares.
fn isPreludeFn(name: string): bool {
    return match (name) {
        "print" | "println" | "panic" | "unreachable" | "todo" | "assert" | "spawn" | "yieldNow" | "sequence" | "spawnDetached" => true,
        _ => false,
    };
}
