//! The checker (S2d; spec chapters 3, 7, 8 for the core): the syntax tree to the checked program.
//! It resolves names — locals in their scopes, the script's top-level bindings (07 Top), functions
//! by name and number of arguments (Lyric 5 §8.1.2), types —, gives every expression its type and
//! writes out the conversions the language makes on its own (`int` to `float`, 03 Mix).
//!
//! Two passes: the declarations first (types, then fields and signatures), then the bodies. A
//! function whose body is `= expr` without a written type gets the type of `expr` (09 Ret),
//! checked when it is first needed.
//!
//! A code means what Lyric 5's `LYR-SEM` code of the same number means; Lyric-Script's own start
//! at 0900. `LYS-NYI0001` names what the plan builds later: it
//! leaves the toolchain before 1.0.
import std.collections { List, Map, Set };
import lyric_script.compiler.ast {
    AliasDecl,
    Arg,
    BinaryOp,
    Block,
    EnumDecl,
    Expr,
    FieldDecl,
    FieldInit,
    FieldPattern,
    FnDecl,
    Item,
    MatchArm,
    Module,
    Pattern,
    Segment,
    Span,
    Stmt,
    TypeDecl,
    TypeExpr,
    UnaryOp,
    binaryText,
    unaryText,
};
import lyric_script.compiler.diagnostic { Diagnostic };
import lyric_script.compiler.typed {
    FieldInfo,
    FnInfo,
    GlobalInfo,
    Native,
    ParamInfo,
    Place,
    Program,
    TExpr,
    TStmt,
    Ty,
    TypeInfo,
    TypeKind,
    TupleTy,
    typeOf,
};

/// What the checker made of a module: the program, and its errors and warnings.
struct Checked {
    program: Program,
    errors: Diagnostic[],
    warnings: Diagnostic[],
}

/// Checks a parsed module.
fn checkModule(module: Module): Checked {
    let c = Checker.new();
    c.declare(module);
    c.checkMain(module);
    c.checkBodies();
    return Checked {
        program = c.program(),
        errors = c.errors.toArray(),
        warnings = c.warnings.toArray(),
    };
}

/// A loop being checked: `loop` gives the value of its breaks, `while` and `for` give none.
class LoopCtx {
    isLoop: bool,
    var breakTy: ?Ty = null,
    var breaks: int = 0,
    // the bindings without a value its breaks leave unassigned: what follows a `loop`
    var exits: Set<int> = Set<int>.new(),
}

/// A scope's locals by name. A class of its own: a field of type `List<Map<…>>` does not lower
/// yet (lyriclang/lyric#612).
class Scope {
    names: Map<string, int>,
    // the locals and the script's globals a condition has narrowed here: what they hold
    narrowed: Map<int, Ty>,
    narrowedGlobals: Map<int, Ty>,

    static fn new(): Scope {
        return Scope {
            names = Map<string, int>.new(),
            narrowed = Map<int, Ty>.new(),
            narrowedGlobals = Map<int, Ty>.new(),
        };
    }
}

/// What a condition says where it holds, or where it does not: a binding of an optional holds
/// its value (03 O).
struct Fact {
    isGlobal: bool,
    id: int,
    ty: Ty,
}

/// The function being checked: its scopes of locals and its loops.
class FnCtx {
    fnIndex: int,
    scopes: List<Scope>,
    locals: List<Ty>,
    localIsVar: List<bool>,
    localNames: List<string>,
    loops: List<LoopCtx>,
    returns: Ty,
    // whether `let` and `var` at the outermost scope are the script's globals (main's code)
    isMain: bool,
    // the bindings declared without a value that are not assigned on every way to here (Lyric 5
    // §7.1 rule 5); never changed in place, so a saved set stays as it was
    var unassigned: Set<int>,
    // 03 Leer: the first pass over a function that declares `var x = null` reports nothing and
    // records, for each such binding in order, the first type a use fixes; the second pass gives
    // the bindings these types
    fixing: bool,
    var fixes: List<?Ty>,
    var nullVars: int = 0,
    sought: Map<int, int>,
    soughtGlobals: Map<int, int>,

    static fn new(fnIndex: int, returns: Ty, isMain: bool, fixing: bool): FnCtx {
        let scopes = List<Scope>.new();
        scopes.push(Scope.new());
        return FnCtx {
            fnIndex = fnIndex,
            scopes = scopes,
            locals = List<Ty>.new(),
            localIsVar = List<bool>.new(),
            localNames = List<string>.new(),
            loops = List<LoopCtx>.new(),
            returns = returns,
            isMain = isMain,
            unassigned = Set<int>.new(),
            fixing = fixing,
            fixes = List<?Ty>.new(),
            sought = Map<int, int>.new(),
            soughtGlobals = Map<int, int>.new(),
        };
    }
}

/// The state of a function's signature: an expression body without a written type is inferred
/// when first needed.
enum FnState :: [Equatable] {
    Declared,
    Inferring,
    Done,
}

class Checker {
    errors: List<Diagnostic>,
    warnings: List<Diagnostic>,
    types: List<TypeInfo>,
    typeIndex: Map<string, int>,
    aliases: Map<string, AliasDecl>,
    resolvingAliases: List<string>,
    functions: List<FnInfo>,
    // top-level functions by name: the indices of those of that name
    fnByName: Map<string, List<int>>,
    fnDecls: List<?FnDecl>,
    fnStates: List<FnState>,
    globals: List<GlobalInfo>,
    globalIndex: Map<string, int>,
    var ctx: FnCtx,
    var mainIndex: int = -1,
    // what the statement just checked lets the rest of its block know (an `if` whose one branch
    // never comes out)
    var postFacts: List<Fact> = List<Fact>.new(),

    static fn new(): Checker {
        return Checker {
            errors = List<Diagnostic>.new(),
            warnings = List<Diagnostic>.new(),
            types = List<TypeInfo>.new(),
            typeIndex = Map<string, int>.new(),
            aliases = Map<string, AliasDecl>.new(),
            resolvingAliases = List<string>.new(),
            functions = List<FnInfo>.new(),
            fnByName = Map<string, List<int>>.new(),
            fnDecls = List<?FnDecl>.new(),
            fnStates = List<FnState>.new(),
            globals = List<GlobalInfo>.new(),
            globalIndex = Map<string, int>.new(),
            ctx = FnCtx.new(-1, Ty.Void, false, false),
        };
    }

    mut fn program(): Program {
        return Program {
            types = this.types.toArray(),
            functions = this.functions.toArray(),
            globals = this.globals.toArray(),
            main = this.mainIndex,
        };
    }

    // --- reports ---------------------------------------------------------------------------------

    mut fn error(code: string, message: string, at: Span): void {
        this.errorHelp(code, message, null, at);
    }

    mut fn errorHelp(code: string, message: string, help: ?string, at: Span): void {
        // the first pass of 03 Leer reports nothing: the second reports what holds
        if (this.ctx.fixing) {
            return;
        }
        this.errors.push(
            Diagnostic {
                code = code,
                message = message,
                start = at.start,
                end = at.end,
                line = at.line,
                column = at.column,
                help = help,
            }
        );
    }

    /// What a later milestone builds: reported, and the expression read as unknown.
    mut fn notYet(what: string, milestone: string, at: Span): TExpr {
        this.error("LYS-NYI0001", f"{what} comes with {milestone} of the plan to 1.0", at);
        return TExpr.Unknown;
    }

    // --- declarations ----------------------------------------------------------------------------

    mut fn declare(module: Module): void {
        // the names of the types first: fields and signatures may name any of them
        for (item in module.items) {
            match (item) {
                .Decl(d) => {
                    match (d) {
                        .Type(t) => this.declareTypeName(
                            t.name,
                            if (t.isClass) TypeKind.Class else TypeKind.Struct,
                            t.span
                        ),
                        .Enum(e) => this.declareTypeName(e.name, TypeKind.Enum, e.span),
                        .Alias(a) => {
                            if (this.typeIndex.containsKey(a.name)
                                || this.aliases.containsKey(a.name)) {
                                this.error("LYS-SEM0176", f"'{a.name}' is declared twice", a.span);
                            } else {
                                this.aliases.insert(a.name, a);
                            }
                        }
                        .Fn(_) => { }
                    }
                }
                .Stmt(_) => { }
            }
        }
        // then what they hold, and the functions' signatures
        for (item in module.items) {
            match (item) {
                .Decl(d) => {
                    match (d) {
                        .Type(t) => this.declareMembers(t),
                        .Enum(e) => this.declareEnum(e),
                        .Alias(a) => {
                            this.resolveAlias(a);
                        }
                        .Fn(f) => {
                            this.declareFn(f, -1);
                        }
                    }
                }
                .Stmt(_) => { }
            }
        }
        // the fields' defaults, now that every type is known
        for (item in module.items) {
            match (item) {
                .Decl(d) => {
                    match (d) {
                        .Type(t) => this.checkFieldDefaults(t),
                        .Enum(e) => this.checkVariantDefaults(e),
                        _ => { }
                    }
                }
                .Stmt(_) => { }
            }
        }
        // the parameters' defaults: a call that leaves a parameter out gets its default where it
        // stands, so a default sees no parameter (Lyric 5 lets it read those before it)
        var k = 0;
        while (k < this.functions.length()) {
            let decl = this.fnDecls[k];
            if (decl != null) {
                this.checkParamDefaults(k, decl);
            }
            k += 1;
        }
    }

    mut fn checkParamDefaults(k: int, decl: FnDecl): void {
        let info = this.functions[k];
        let params = List<ParamInfo>.new();
        var j = 0;
        for (p in decl.params) {
            let t = info.params[j].ty;
            var dflt: ?TExpr = null;
            let written = p.default;
            if (written != null) {
                let saved = this.ctx;
                this.ctx = FnCtx.new(-1, Ty.Void, false, false);
                dflt = this.coerce(this.expr(written, t), t, spanOf(written));
                this.ctx = saved;
            }
            params.push(ParamInfo { name = p.name, ty = t, default = dflt });
            j += 1;
        }
        info.params = params.toArray();
    }

    mut fn declareTypeName(name: string, kind: TypeKind, at: Span): void {
        if (this.typeIndex.containsKey(name)
            || this.aliases.containsKey(name)
            || isBuiltinType(name)) {
            this.error("LYS-SEM0176", f"'{name}' is declared twice", at);
            return;
        }
        this.typeIndex.insert(name, this.types.length());
        this.types.push(TypeInfo { name = name, kind = kind, methods = Map<string, int>.new() });
    }

    mut fn declareMembers(t: TypeDecl): void {
        let index = this.typeIndex.get(t.name);
        if (index == null) {
            return;
        }
        let info = this.types[index];
        if (info.kind == .Enum || info.name != t.name) {
            return;
        }
        let fields = List<FieldInfo>.new();
        let seen = Map<string, bool>.new();
        for (f in t.fields) {
            if (seen.containsKey(f.name)) {
                this.error("LYS-SEM0121", f"'{t.name}' has a second member '{f.name}'", f.span);
                continue;
            }
            seen.insert(f.name, true);
            if (f.isVar && !t.isClass) {
                this.error(
                    "LYS-SEM0901",
                    f"a struct's fields are never written: '{f.name}' takes no 'var' (a class's may)",
                    f.span
                );
            }
            fields.push(
                FieldInfo {
                    name = f.name,
                    ty = this.resolveType(f.type),
                    isVar = f.isVar,
                    default = null,
                }
            );
        }
        info.fields = fields.toArray();
        for (m in t.methods) {
            if (seen.containsKey(m.name)) {
                this.error("LYS-SEM0121", f"'{t.name}' has a second member '{m.name}'", m.span);
                continue;
            }
            seen.insert(m.name, true);
            info.methods.insert(m.name, this.declareFn(m, index));
        }
    }

    mut fn declareEnum(e: EnumDecl): void {
        let index = this.typeIndex.get(e.name);
        if (index == null) {
            return;
        }
        let info = this.types[index];
        if (info.kind != .Enum) {
            return;
        }
        let variants = List<string>.new();
        let payloads = List<FieldInfo[]>.new();
        let named = List<bool>.new();
        let seen = Map<string, bool>.new();
        for (v in e.variants) {
            if (seen.containsKey(v.name)) {
                this.error("LYS-SEM0121", f"'{e.name}' has a second member '{v.name}'", v.span);
                continue;
            }
            seen.insert(v.name, true);
            variants.push(v.name);
            // a payload by position names its fields "0", "1", …
            let fields = List<FieldInfo>.new();
            var k = 0;
            for (x in v.positional) {
                fields.push(
                    FieldInfo {
                        name = f"{k}",
                        ty = this.resolveType(x),
                        isVar = false,
                        default = null,
                    }
                );
                k += 1;
            }
            let fieldSeen = Map<string, bool>.new();
            for (f in v.fields) {
                if (fieldSeen.containsKey(f.name)) {
                    this.error("LYS-SEM0121", f"'{v.name}' has a second field '{f.name}'", f.span);
                    continue;
                }
                fieldSeen.insert(f.name, true);
                fields.push(
                    FieldInfo {
                        name = f.name,
                        ty = this.resolveType(f.type),
                        isVar = false,
                        default = null,
                    }
                );
            }
            if (fields.length() > 0) {
                info.payload = true;
            }
            payloads.push(fields.toArray());
            named.push(v.named);
        }
        info.variants = variants.toArray();
        info.variantFields = payloads.toArray();
        info.variantNamed = named.toArray();
        for (m in e.methods) {
            if (seen.containsKey(m.name)) {
                this.error("LYS-SEM0121", f"'{e.name}' has a second member '{m.name}'", m.span);
                continue;
            }
            seen.insert(m.name, true);
            info.methods.insert(m.name, this.declareFn(m, index));
        }
    }

    /// Registers a function or a method and its signature; returns its index.
    mut fn declareFn(f: FnDecl, owner: int): int {
        let index = this.functions.length();
        let info = FnInfo {
            name = f.name,
            owner = owner,
            isStatic = f.isStatic || owner < 0,
            line = f.span.line,
        };
        let params = List<ParamInfo>.new();
        for (p in f.params) {
            params.push(ParamInfo { name = p.name, ty = this.resolveType(p.type), default = null });
        }
        info.params = params.toArray();
        var state = FnState.Done;
        let written = f.returns;
        if (written != null) {
            info.returns = this.resolveType(written);
        } else {
            match (f.body) {
                // Kotlin's rule (09 Ret): a block without a written type gives nothing
                .Block(_) => info.returns = Ty.Void,
                .Expr(_) => {
                    info.returns = Ty.Unknown;
                    state = FnState.Declared;
                }
            }
        }
        this.functions.push(info);
        this.fnDecls.push(f);
        this.fnStates.push(state);
        if (owner < 0) {
            let same = this.fnByName.get(f.name);
            if (same != null) {
                for (other in same) {
                    if (this.functions[other].params.length() == params.length()) {
                        this.error(
                            "LYS-SEM0085",
                            f"two functions '{f.name}' take {params.length()} arguments",
                            f.span
                        );
                    }
                }
                same.push(index);
            } else {
                let list = List<int>.new();
                list.push(index);
                this.fnByName.insert(f.name, list);
            }
        }
        return index;
    }

    mut fn checkFieldDefaults(t: TypeDecl): void {
        let index = this.typeIndex.get(t.name);
        if (index == null) {
            return;
        }
        let info = this.types[index];
        info.fields = this.defaultsOf(info.fields, t.fields);
    }

    /// The payloads' defaults of a struct variant, as a struct's fields have them.
    mut fn checkVariantDefaults(e: EnumDecl): void {
        let index = this.typeIndex.get(e.name);
        if (index == null) {
            return;
        }
        let info = this.types[index];
        if (info.kind != .Enum || info.variantFields.length() != info.variants.length()) {
            return;
        }
        let all = List<FieldInfo[]>.new();
        var k = 0;
        for (fields in info.variantFields) {
            var decls: FieldDecl[] = [];
            for (v in e.variants) {
                if (v.name == info.variants[k]) {
                    decls = v.fields;
                }
            }
            all.push(this.defaultsOf(fields, decls));
            k += 1;
        }
        info.variantFields = all.toArray();
    }

    /// `fields` with the defaults `decls` write, each checked against its field's type; a `?T`
    /// field without one starts as null (03 Initialisierung).
    mut fn defaultsOf(infos: FieldInfo[], decls: FieldDecl[]): FieldInfo[] {
        let fields = List<FieldInfo>.new();
        for (f in infos) {
            var dflt: ?TExpr = null;
            for (d in decls) {
                let written = d.default;
                if (d.name == f.name && written != null) {
                    let saved = this.ctx;
                    this.ctx = FnCtx.new(-1, Ty.Void, false, false);
                    dflt = this.coerce(this.expr(written, f.ty), f.ty, spanOf(written));
                    this.ctx = saved;
                }
            }
            // a `?T` field without a default starts as null (03 Initialisierung)
            match (f.ty) {
                .Optional(_) => {
                    if (dflt == null) {
                        dflt = TExpr.Null(f.ty);
                    }
                }
                _ => { }
            }
            fields.push(FieldInfo { name = f.name, ty = f.ty, isVar = f.isVar, default = dflt });
        }
        return fields.toArray();
    }

    // --- types -----------------------------------------------------------------------------------

    mut fn resolveType(t: TypeExpr): Ty {
        return match (t) {
            .Named(name, args, at) => this.resolveNamed(name, args, at),
            .Optional(inner, _) => Ty.Optional(boxTy(this.resolveType(inner.value))),
            .List(inner, _) => Ty.List(boxTy(this.resolveType(inner.value))),
            .Tuple(elements, labels, _) => {
                let tys = List<Ty>.new();
                for (x in elements) {
                    tys.push(this.resolveType(x));
                }
                Ty.Tuple(TupleTy { elements = tys.toArray(), labels = labels })
            }
            .Fn(_, _, at) => {
                this.notYet("a function type", "S3", at);
                Ty.Unknown
            }
        };
    }

    mut fn resolveNamed(name: string, args: TypeExpr[], at: Span): Ty {
        let arity = match (name) {
            "List" => 1,
            "Map" => 2,
            _ => 0,
        };
        if (args.length() != arity) {
            this.error(
                "LYS-SEM0026",
                f"'{name}' takes {arity} type arguments, not {args.length()}",
                at
            );
            return Ty.Unknown;
        }
        match (name) {
            "int" => {
                return Ty.Int;
            }
            "float" => {
                return Ty.Float;
            }
            "bool" => {
                return Ty.Bool;
            }
            "char" => {
                return Ty.Char;
            }
            "string" => {
                return Ty.Str;
            }
            "void" => {
                return Ty.Void;
            }
            "never" => {
                return Ty.Never;
            }
            "List" => {
                return Ty.List(boxTy(this.resolveType(args[0])));
            }
            "Map" => {
                return Ty.Map(boxTy(this.resolveType(args[0])), boxTy(this.resolveType(args[1])));
            }
            _ => { }
        }
        if (isWidthType(name)) {
            this.error(
                "LYS-SEM0900",
                f"'{name}' is a width type of Lyric 5: Lyric-Script has one integer type, int, and one float type, float",
                at
            );
            return Ty.Unknown;
        }
        let index = this.typeIndex.get(name);
        if (index != null) {
            return Ty.Named(index);
        }
        let alias = this.aliases.get(name);
        if (alias != null) {
            return this.resolveAlias(alias);
        }
        this.error("LYS-SEM0011", f"'{name}' names no type", at);
        return Ty.Unknown;
    }

    mut fn resolveAlias(a: AliasDecl): Ty {
        for (n in this.resolvingAliases) {
            if (n == a.name) {
                this.error("LYS-SEM0064", f"the alias '{a.name}' expands to itself", a.span);
                return Ty.Unknown;
            }
        }
        this.resolvingAliases.push(a.name);
        let t = this.resolveType(a.type);
        this.resolvingAliases.pop();
        return t;
    }

    mut fn tyName(t: Ty): string {
        return match (t) {
            .Int => "int",
            .Float => "float",
            .Bool => "bool",
            .Char => "char",
            .Str => "string",
            .Void => "void",
            .Never => "never",
            .Unknown => "?",
            .Named(i) => this.types[i].name,
            .List(e) => f"{this.tyName(e.value)}[]",
            .Map(k, v) => f"Map<{this.tyName(k.value)}, {this.tyName(v.value)}>",
            .Optional(e) => f"?{this.tyName(e.value)}",
            .NullLit => "null",
            .Tuple(tt) => {
                let parts = List<string>.new();
                var k = 0;
                for (e in tt.elements) {
                    let label = tt.labels[k];
                    parts.push(if (label == "") this.tyName(e) else f"{label}: {this.tyName(e)}");
                    k += 1;
                }
                "(" + parts.toArray().join(", ") + ")"
            }
        };
    }

    /// `e` where a value of type `target` stands: the same type, `int` widened to `float`, or a
    /// fault (`LYS-SEM0001`).
    mut fn coerce(e: TExpr, target: Ty, at: Span): TExpr {
        this.fixFrom(e, target);
        let actual = typeOf(e);
        if (actual == target || actual == .Unknown || target == .Unknown || actual == .Never) {
            return e;
        }
        let fitted = this.fit(e, target);
        if (fitted != null) {
            return fitted;
        }
        this.error(
            "LYS-SEM0001",
            f"expected {this.tyName(target)}, found {this.tyName(actual)}",
            at
        );
        return TExpr.Unknown;
    }

    /// `e` as a value of `target` without a report: the same, an `int` widened to `float`, a
    /// value wrapped as present where an optional of it is taken, `null` given its type; `null`
    /// where it does not fit.
    mut fn fit(e: TExpr, target: Ty): ?TExpr {
        let actual = typeOf(e);
        if (actual == target) {
            return e;
        }
        if (actual == .Int && target == .Float) {
            return match (e) {
                .Int(n) => TExpr.Float(n as float),
                _ => TExpr.ToFloat(boxE(e)),
            };
        }
        match (target) {
            .Optional(inner) => {
                if (actual == .NullLit) {
                    return TExpr.Null(target);
                }
                let v = this.fit(e, inner.value);
                if (v != null) {
                    return TExpr.Wrap(boxE(v), target);
                }
            }
            _ => { }
        }
        return null;
    }

    // --- bodies ----------------------------------------------------------------------------------

    /// The script's top-level statements: the function `main`, whose outermost `let`s and `var`s
    /// are the script's globals (07 Top).
    mut fn checkMain(module: Module): void {
        let index = this.functions.length();
        this.mainIndex = index;
        let line = if (module.items.length() > 0) itemLine(module.items[0]) else 1;
        this.functions.push(FnInfo { name = "<script>", owner = -1, isStatic = true, line = line });
        this.fnDecls.push(null);
        this.fnStates.push(FnState.Done);
        let stmts = List<Stmt>.new();
        for (item in module.items) {
            match (item) {
                .Stmt(s) => stmts.push(s),
                .Decl(_) => { }
            }
        }
        var fixes = List<?Ty>.new();
        if (declaresNull(stmts.toArray())) {
            // 03 Leer: a quiet first pass; the globals it declares are declared again by the second
            this.ctx = FnCtx.new(index, Ty.Void, true, true);
            this.stmtList(stmts.toArray());
            fixes = this.ctx.fixes;
            this.globals.clear();
            this.globalIndex.clear();
        }
        this.ctx = FnCtx.new(index, Ty.Void, true, false);
        this.ctx.fixes = fixes;
        let body = List<TStmt>.new();
        for (s in this.stmtList(stmts.toArray())) {
            body.push(s);
        }
        let info = this.functions[index];
        info.body = body.toArray();
        info.locals = this.ctx.locals.toArray();
    }

    mut fn checkBodies(): void {
        var k = 0;
        while (k < this.functions.length()) {
            if (this.fnStates[k] != .Done || this.functions[k].body.length() == 0) {
                let decl = this.fnDecls[k];
                if (decl != null) {
                    this.checkFn(k, decl);
                }
            }
            k += 1;
        }
    }

    /// The return type of function `k`, checking its body first when it is to be inferred.
    mut fn returnsOf(k: int, at: Span): Ty {
        let state = this.fnStates[k];
        if (state == .Declared) {
            // the quiet pass of 03 Leer checks no other function: the second pass does
            if (this.ctx.fixing) {
                return Ty.Unknown;
            }
            let decl = this.fnDecls[k];
            if (decl != null) {
                this.checkFn(k, decl);
            }
        } else if (state == .Inferring) {
            this.error(
                "LYS-SEM0010",
                f"'{this.functions[k].name}' calls itself before its type is known: write its result type",
                at
            );
            return Ty.Unknown;
        }
        return this.functions[k].returns;
    }

    mut fn checkFn(k: int, decl: FnDecl): void {
        let info = this.functions[k];
        if (this.fnStates[k] == .Declared) {
            this.fnStates[k] = FnState.Inferring;
        }
        let saved = this.ctx;
        var fixes = List<?Ty>.new();
        if (fnDeclaresNull(decl)) {
            // 03 Leer: a quiet first pass finds the type of each `var x = null`
            this.enterFn(k, decl, true);
            this.fnBody(k, decl);
            fixes = this.ctx.fixes;
        }
        this.enterFn(k, decl, false);
        this.ctx.fixes = fixes;
        info.body = this.fnBody(k, decl);
        info.locals = this.ctx.locals.toArray();
        this.fnStates[k] = FnState.Done;
        this.ctx = saved;
    }

    /// A fresh context for function `k`: its receiver and its parameters its first locals.
    mut fn enterFn(k: int, decl: FnDecl, fixing: bool): void {
        let info = this.functions[k];
        this.ctx = FnCtx.new(k, info.returns, false, fixing);
        if (info.owner >= 0 && !info.isStatic) {
            this.declareLocal("this", Ty.Named(info.owner), false, decl.span);
        }
        for (p in info.params) {
            this.declareLocal(p.name, p.ty, false, decl.span);
        }
    }

    mut fn fnBody(k: int, decl: FnDecl): TStmt[] {
        let info = this.functions[k];
        let body = List<TStmt>.new();
        match (decl.body) {
            .Block(b) => {
                for (s in this.stmtList(b.stmts)) {
                    body.push(s);
                }
                if (info.returns != .Void && info.returns != .Unknown && !endsAll(body.toArray())) {
                    this.error(
                        "LYS-SEM0017",
                        f"'{info.name}' can reach its end without returning its {this.tyName(info.returns)}",
                        decl.span
                    );
                }
            }
            .Expr(e) => {
                let inferring = this.fnStates[k] == .Inferring;
                let value = if (inferring) this.expr(e, null)
                    else this.coerce(this.expr(e, info.returns), info.returns, spanOf(e));
                if (inferring && !this.ctx.fixing) {
                    info.returns = typeOf(value);
                }
                body.push(
                    TStmt.Return(if (typeOf(value) == .Void) null else value, decl.span.line)
                );
            }
        }
        return body.toArray();
    }

    mut fn declareLocal(name: string, t: Ty, isVar: bool, at: Span): int {
        let scope = this.ctx.scopes[this.ctx.scopes.length() - 1].names;
        if (scope.containsKey(name)) {
            this.error("LYS-SEM0176", f"'{name}' is bound twice in one scope", at);
        }
        let id = this.ctx.locals.length();
        this.ctx.locals.push(t);
        this.ctx.localIsVar.push(isVar);
        this.ctx.localNames.push(name);
        scope.insert(name, id);
        return id;
    }

    /// A local the program does not name: where `?.`, `if let` and `while let` hold a value.
    mut fn hidden(t: Ty, at: Span): int {
        return this.declareLocal(f"${this.ctx.locals.length()}", t, false, at);
    }

    mut fn narrowedLocal(id: int): ?Ty {
        var k = this.ctx.scopes.length() - 1;
        while (k >= 0) {
            let t = this.ctx.scopes[k].narrowed.get(id);
            if (t != null) {
                return t;
            }
            k -= 1;
        }
        return null;
    }

    mut fn narrowedGlobal(id: int): ?Ty {
        var k = this.ctx.scopes.length() - 1;
        while (k >= 0) {
            let t = this.ctx.scopes[k].narrowedGlobals.get(id);
            if (t != null) {
                return t;
            }
            k -= 1;
        }
        return null;
    }

    /// The facts condition `c` gives where it is `when`: `x != null` narrows `x` where true,
    /// `x == null` where false; `&&` gives both sides' where true, `||` where false; `!` turns.
    mut fn factsOf(c: TExpr, when: bool): List<Fact> {
        let out = List<Fact>.new();
        this.collectFacts(c, when, out);
        return out;
    }

    mut fn collectFacts(c: TExpr, when: bool, out: List<Fact>): void {
        match (c) {
            .IsNull(x) => {
                if (!when) {
                    this.factOf(x.value, out);
                }
            }
            .Unary(op, x, _) => {
                if (op == .Not) {
                    this.collectFacts(x.value, !when, out);
                }
            }
            .Binary(a, op, b, _) => {
                if ((op == .And && when) || (op == .Or && !when)) {
                    this.collectFacts(a.value, when, out);
                    this.collectFacts(b.value, when, out);
                }
            }
            _ => { }
        }
    }

    mut fn factOf(x: TExpr, out: List<Fact>): void {
        match (x) {
            // a second test narrows again: a `??int` proven present once is a `?int` (§3.2)
            .Narrow(inner, t) => {
                match (t) {
                    .Optional(i) => {
                        match (inner.value) {
                            .Local(id, _) => out.push(
                                Fact { isGlobal = false, id = id, ty = i.value }
                            ),
                            .Global(g, _) => out.push(
                                Fact { isGlobal = true, id = g, ty = i.value }
                            ),
                            _ => { }
                        }
                    }
                    _ => { }
                }
            }
            .Local(id, t) => {
                match (t) {
                    .Optional(inner) => out.push(
                        Fact { isGlobal = false, id = id, ty = inner.value }
                    ),
                    _ => { }
                }
            }
            .Global(g, t) => {
                match (t) {
                    .Optional(inner) => out.push(
                        Fact { isGlobal = true, id = g, ty = inner.value }
                    ),
                    _ => { }
                }
            }
            _ => { }
        }
    }

    /// Narrows the bindings of `facts` in the innermost scope (Lyric 5 §3.2): a local, until an
    /// assignment ends it; a global `let`, never a global `var`, which any call may write.
    mut fn narrow(facts: List<Fact>): void {
        let scope = this.ctx.scopes[this.ctx.scopes.length() - 1];
        for (f in facts) {
            if (f.isGlobal) {
                if (!this.globals[f.id].isVar) {
                    scope.narrowedGlobals.insert(f.id, f.ty);
                }
            } else {
                scope.narrowed.insert(f.id, f.ty);
            }
        }
    }

    /// Ends the narrowing of local `id` in every scope: it has been written.
    mut fn unnarrow(id: int): void {
        for (scope in this.ctx.scopes) {
            scope.narrowed.remove(id);
        }
    }

    /// Before a loop: a narrowed local the loop writes is narrowed in none of its turns — the
    /// second turn would read it after the write.
    mut fn unnarrowWritten(region: Stmt[]): void {
        let written = List<int>.new();
        for (scope in this.ctx.scopes) {
            for (id in scope.narrowed.keys()) {
                if (writesIn(region, 0, this.ctx.localNames[id])) {
                    written.push(id);
                }
            }
        }
        for (id in written) {
            this.unnarrow(id);
        }
    }

    /// The statements of a block in order: what one of them lets the rest know is narrowed for the
    /// rest (an `if` whose one branch never comes out).
    mut fn stmtList(stmts: Stmt[]): TStmt[] {
        let out = List<TStmt>.new();
        var k = 0;
        while (k < stmts.length()) {
            this.postFacts = List<Fact>.new();
            out.push(this.stmt(stmts[k]));
            if (this.postFacts.length() > 0) {
                let facts = this.postFacts;
                this.postFacts = List<Fact>.new();
                this.narrow(facts);
            }
            k += 1;
        }
        return out.toArray();
    }

    mut fn lookupLocal(name: string): ?int {
        var k = this.ctx.scopes.length() - 1;
        while (k >= 0) {
            let id = this.ctx.scopes[k].names.get(name);
            if (id != null) {
                return id;
            }
            k -= 1;
        }
        return null;
    }

    mut fn pushScope(): void {
        this.ctx.scopes.push(Scope.new());
    }

    mut fn popScope(): void {
        this.ctx.scopes.pop();
    }

    mut fn block(b: Block): TStmt[] {
        this.pushScope();
        let out = this.stmtList(b.stmts);
        this.popScope();
        return out;
    }

    /// A block where `facts` hold.
    mut fn blockWith(b: Block, facts: List<Fact>): TStmt[] {
        this.pushScope();
        this.narrow(facts);
        let out = this.block(b);
        this.popScope();
        return out;
    }

    // --- statements ------------------------------------------------------------------------------

    mut fn stmt(s: Stmt): TStmt {
        let out = this.stmtOf(s);
        // nothing follows a statement that never comes out: it adds nothing to what is assigned
        if (leaves(out)) {
            this.ctx.unassigned = Set<int>.new();
        }
        return out;
    }

    mut fn stmtOf(s: Stmt): TStmt {
        return match (s) {
            .Expr(e, at) => this.exprStmt(e, at),
            .Let(isVar, name, written, value, at) => this.letStmt(isVar, name, written, value, at),
            .Destructure(isVar, pattern, value, at) => this.destructure(isVar, pattern, value, at),
            .If(cond, then, otherwise, at) => {
                let c = this.condition(cond);
                let yes = this.factsOf(c, true);
                let no = this.factsOf(c, false);
                let before = this.ctx.unassigned;
                let t = this.blockWith(then, yes);
                let afterThen = this.ctx.unassigned;
                this.ctx.unassigned = before;
                var o: TStmt[] = [];
                if (otherwise != null) {
                    this.pushScope();
                    this.narrow(no);
                    o = [this.stmt(otherwise.value)];
                    this.popScope();
                }
                this.ctx.unassigned = afterThen.union(this.ctx.unassigned);
                // where one branch never comes out, what the other knows holds after the `if`
                if (leavesAll(t) && !leavesAll(o)) {
                    this.postFacts = no;
                } else if (otherwise != null && leavesAll(o) && !leavesAll(t)) {
                    this.postFacts = yes;
                }
                TStmt.If(c, t, o, at.line)
            }
            .While(cond, body, _, at) => {
                this.unnarrowWritten([s]);
                let c = this.condition(cond);
                let before = this.ctx.unassigned;
                this.ctx.loops.push(LoopCtx { isLoop = false });
                let b = this.blockWith(body, this.factsOf(c, true));
                this.ctx.loops.pop();
                // the body may not run: what follows knows what the condition left
                this.ctx.unassigned = before;
                TStmt.While(c, b, at.line)
            }
            .IfLet(name, value, then, otherwise, at) => this.ifLet(
                name,
                value,
                then,
                otherwise,
                at
            ),
            .WhileLet(name, value, body, _, at) => {
                this.unnarrowWritten([s]);
                this.whileLet(name, value, body, at)
            }
            .For(name, iterable, body, _, at) => {
                this.unnarrowWritten([s]);
                this.forStmt(name, iterable, body, at)
            }
            .Break(_, value, at) => this.breakStmt(value, at),
            .Continue(_, at) => {
                if (this.ctx.loops.length() == 0) {
                    this.error("LYS-SEM0147", "'continue' outside a loop", at);
                }
                TStmt.Continue(at.line)
            }
            .Return(value, at) => this.returnStmt(value, at),
            .Block(b, at) => TStmt.Block(this.block(b), at.line),
        };
    }

    /// The optional of an `if let` or a `while let` and what it holds; reported where it is none.
    mut fn optionalOf(v: TExpr, word: string, at: Span): Ty {
        return match (typeOf(v)) {
            .Optional(inner) => inner.value,
            .Unknown => Ty.Unknown,
            _ => {
                this.error(
                    "LYS-SEM0005",
                    f"'{word}' takes an optional: this value is never null",
                    at
                );
                Ty.Unknown
            }
        };
    }

    /// `if (let x = e) { … } else { … }`: `e` held in a local of its own, `x` its value in the
    /// block where it is there.
    mut fn ifLet(name: string, value: Expr, then: Block, otherwise: ?Box<Stmt>, at: Span): TStmt {
        let v = this.expr(value, null);
        let ot = typeOf(v);
        let inner = this.optionalOf(v, "if let", spanOf(value));
        let tmp = this.hidden(ot, at);
        let before = this.ctx.unassigned;
        this.pushScope();
        let x = this.declareLocal(name, inner, false, at);
        let body = List<TStmt>.new();
        body.push(TStmt.SetLocal(x, TExpr.Narrow(boxE(TExpr.Local(tmp, ot)), inner), at.line));
        for (s in this.block(then)) {
            body.push(s);
        }
        this.popScope();
        let afterThen = this.ctx.unassigned;
        this.ctx.unassigned = before;
        var o: TStmt[] = [];
        if (otherwise != null) {
            this.pushScope();
            o = [this.stmt(otherwise.value)];
            this.popScope();
        }
        this.ctx.unassigned = afterThen.union(this.ctx.unassigned);
        let present = TExpr.Unary(
            UnaryOp.Not,
            boxE(TExpr.IsNull(boxE(TExpr.Local(tmp, ot)))),
            Ty.Bool
        );
        return TStmt.Block(
            [TStmt.SetLocal(tmp, v, at.line), TStmt.If(present, body.toArray(), o, at.line)],
            at.line
        );
    }

    /// `while (let x = e) { … }`: `e` again before each turn, the loop's end where it is null.
    mut fn whileLet(name: string, value: Expr, body: Block, at: Span): TStmt {
        this.pushScope();
        let v = this.expr(value, null);
        let ot = typeOf(v);
        let inner = this.optionalOf(v, "while let", spanOf(value));
        let tmp = this.hidden(ot, at);
        let x = this.declareLocal(name, inner, false, at);
        let before = this.ctx.unassigned;
        this.ctx.loops.push(LoopCtx { isLoop = false });
        let turn = List<TStmt>.new();
        turn.push(TStmt.SetLocal(tmp, v, at.line));
        turn.push(
            TStmt.If(
                TExpr.IsNull(boxE(TExpr.Local(tmp, ot))),
                [TStmt.Break(null, at.line)],
                [],
                at.line
            )
        );
        turn.push(TStmt.SetLocal(x, TExpr.Narrow(boxE(TExpr.Local(tmp, ot)), inner), at.line));
        for (s in this.block(body)) {
            turn.push(s);
        }
        this.ctx.loops.pop();
        this.popScope();
        this.ctx.unassigned = before;
        return TStmt.While(TExpr.Bool(true), turn.toArray(), at.line);
    }

    /// An expression as a statement: a call, an assignment or a loop; anything else would be
    /// computed only to be thrown away (`LYS-SEM0022`).
    mut fn exprStmt(e: Expr, at: Span): TStmt {
        let checked = match (e) {
            .Match(x, arms, matchAt) => this.matchOf(x.value, arms, null, true, matchAt),
            _ => this.expr(e, null),
        };
        let effect = match (e) {
            .Call(_, _, _) | .Assign(_, _, _, _) | .Loop(_, _, _) | .Match(_, _, _) => true,
            _ => false,
        };
        if (!effect && typeOf(checked) != .Unknown) {
            this.error(
                "LYS-SEM0022",
                "this computes a value and throws it away: only calls, assignments and loops stand alone",
                at
            );
        }
        return TStmt.Expr(checked, at.line);
    }

    mut fn letStmt(isVar: bool, name: string, written: ?TypeExpr, value: ?Expr, at: Span): TStmt {
        var t = Ty.Unknown;
        if (written != null) {
            t = this.resolveType(written);
        }
        if (value == null) {
            return this.unassignedLet(isVar, name, written != null, t, at);
        }
        if (isVar && written == null && isNullLit(value)) {
            return this.nullVar(name, at);
        }
        var v = this.expr(value, if (written != null) t else null);
        if (written != null) {
            v = this.coerce(v, t, spanOf(value));
        } else {
            t = typeOf(v);
            if (t == .NullLit) {
                this.error(
                    "LYS-SEM0010",
                    f"'{name}' is null, and nothing says of what: write its type, '?T'",
                    at
                );
                t = Ty.Unknown;
            } else if (t == .Void || t == .Never) {
                this.error(
                    "LYS-SEM0010",
                    f"'{name}' takes the value of something that gives none",
                    at
                );
                t = Ty.Unknown;
            }
        }
        // the outermost scope of the script's code: a global of the script (07 Top)
        if (this.atTop()) {
            return TStmt.SetGlobal(this.declareGlobal(name, t, isVar, at), v, at.line);
        }
        let id = this.declareLocal(name, t, isVar, at);
        return TStmt.SetLocal(id, v, at.line);
    }

    /// `let (a, b) = v`: `v` held once, each name bound to its element (Lyric 5 §6 rule 4); at
    /// the top of the script's code the names are globals.
    mut fn destructure(isVar: bool, pattern: Pattern, value: Expr, at: Span): TStmt {
        let v = this.expr(value, null);
        let t = typeOf(v);
        let tmp = this.hidden(t, at);
        let out = List<TStmt>.new();
        out.push(TStmt.SetLocal(tmp, v, at.line));
        this.bindPattern(
            isVar,
            pattern,
            TExpr.Local(tmp, t),
            Map<string, bool>.new(),
            out,
            at.line
        );
        return TStmt.Block(out.toArray(), at.line);
    }

    mut fn bindPattern(
        isVar: bool,
        p: Pattern,
        source: TExpr,
        seen: Map<string, bool>,
        out: List<TStmt>,
        line: int
    ): void {
        match (p) {
            .Name(name, at) => {
                if (seen.containsKey(name)) {
                    this.error("LYS-SEM0097", f"'{name}' is bound twice in this pattern", at);
                    return;
                }
                seen.insert(name, true);
                let t = typeOf(source);
                if (this.atTop()) {
                    out.push(TStmt.SetGlobal(this.declareGlobal(name, t, isVar, at), source, line));
                } else {
                    out.push(TStmt.SetLocal(this.declareLocal(name, t, isVar, at), source, line));
                }
            }
            .Ignore(_) => { }
            .Literal(_, at) | .Range(_, _, _, at) | .Variant(_, _, _, at) | .VariantFields(_, _, _, at) | .Fields(_, _, at) | .Or(_, at) => {
                this.error(
                    "LYS-SEM0098",
                    "a 'let' takes apart only what cannot fail: test the value with 'match'",
                    at
                );
            }
            .Tuple(items, at) => {
                let t = typeOf(source);
                match (t) {
                    .Tuple(tt) => {
                        if (tt.elements.length() == items.length()) {
                            var k = 0;
                            for (item in items) {
                                let element = TExpr.Elem(boxE(source), k, tt.elements[k]);
                                this.bindPattern(isVar, item, element, seen, out, line);
                                k += 1;
                            }
                            return;
                        }
                        this.error(
                            "LYS-SEM0058",
                            f"the pattern takes {items.length()} elements apart; the value is {this.tyName(t)}",
                            at
                        );
                    }
                    .Unknown => { }
                    _ => {
                        this.error(
                            "LYS-SEM0058",
                            f"the pattern takes a tuple apart; the value is {this.tyName(t)}",
                            at
                        );
                    }
                }
                // after a fault the names are bound all the same, of no known type
                for (item in items) {
                    this.bindPattern(isVar, item, TExpr.Unknown, seen, out, line);
                }
            }
        }
    }

    // --- match and its patterns ------------------------------------------------------------------

    /// `match (e) { … }` (Lyric 5 §9, 08 §2 rule 4): `e` held once, the arms tried in order as
    /// nested `if`s. A statement's arms give nothing; a value's arms meet the expected type, or
    /// unify.
    mut fn matchOf(
        scrutinee: Expr,
        arms: MatchArm[],
        expected: ?Ty,
        isStmt: bool,
        at: Span
    ): TExpr {
        let v = this.expr(scrutinee, null);
        let t = typeOf(v);
        let tmp = this.hidden(t, at);
        let src = TExpr.Local(tmp, t);
        let before = this.ctx.unassigned;
        var after = Set<int>.new();
        let tests = List<?TExpr>.new();
        let binds = List<TStmt[]>.new();
        let guards = List<?TExpr>.new();
        let bodies = List<TExpr>.new();
        for (arm in arms) {
            this.ctx.unassigned = before;
            this.pushScope();
            let bound = List<Bound>.new();
            let test = this.patternTest(arm.pattern, src, bound, Map<string, bool>.new());
            let sets = List<TStmt>.new();
            for (b in bound) {
                let id = this.declareLocal(b.name, typeOf(b.value), false, b.at);
                sets.push(TStmt.SetLocal(id, b.value, b.at.line));
            }
            var guard: ?TExpr = null;
            let written = arm.guard;
            if (written != null) {
                guard = this.condition(written);
            }
            let body = this.expr(arm.body, if (isStmt) null else expected);
            this.popScope();
            // an arm that never comes out adds nothing to what is assigned after the match
            after = after.union(this.reached(body));
            tests.push(test);
            binds.push(sets.toArray());
            guards.push(guard);
            bodies.push(body);
        }
        this.ctx.unassigned = if (arms.length() == 0) before else after;
        var rt = Ty.Void;
        if (!isStmt) {
            if (expected != null) {
                rt = expected;
            } else {
                rt = Ty.Never;
                for (b in bodies) {
                    rt = this.unify(rt, typeOf(b), at);
                }
            }
        }
        // from the last arm back: each arm's test, its guard with its bindings, its body
        var rest = TExpr.Unreachable(rt);
        var k = arms.length() - 1;
        while (k >= 0) {
            let body = if (isStmt) TExpr.Block(
                [TStmt.Expr(bodies[k], at.line)],
                boxE(TExpr.Unit),
                Ty.Void
            )
                else this.coerce(bodies[k], rt, spanOf(arms[k].body));
            let taken = TExpr.Block(binds[k], boxE(body), rt);
            var cond = tests[k];
            let guard = guards[k];
            if (guard != null) {
                let guarded = TExpr.Block(binds[k], boxE(guard), Ty.Bool);
                cond = if (cond != null) andOf(cond, guarded) else guarded;
            }
            rest = if (cond != null) TExpr.If(boxE(cond), boxE(taken), boxE(rest), rt) else taken;
            k -= 1;
        }
        return TExpr.Block([TStmt.SetLocal(tmp, v, at.line)], boxE(rest), rt);
    }

    /// What pattern `p` tests of `src` — a read of the matched value's parts, evaluated as often
    /// as needed — as a `bool`; `null` where it matches every value. Its bindings go to `out`.
    mut fn patternTest(p: Pattern, src: TExpr, out: List<Bound>, seen: Map<string, bool>): ?TExpr {
        return match (p) {
            .Ignore(_) => null,
            .Name(name, at) => {
                // a bare name that spells a variant would match every value under its name
                let e = this.enumOf(typeOf(src));
                if (e >= 0 && this.variantIndex(e, name) >= 0) {
                    this.error(
                        "LYS-SEM0111",
                        f"'{name}' binds the whole value; to test the variant write .{name}",
                        at
                    );
                }
                if (seen.containsKey(name)) {
                    this.error("LYS-SEM0097", f"'{name}' is bound twice in this pattern", at);
                } else {
                    seen.insert(name, true);
                    out.push(Bound { name = name, value = src, at = at });
                }
                null
            }
            .Tuple(items, at) => this.tupleTest(items, src, out, seen, at),
            .Literal(e, at) => this.literalTest(e, src, at),
            .Range(low, high, inclusive, at) => this.rangeTest(low, high, inclusive, src, at),
            .Variant(enumName, name, payload, at) => this.variantTest(
                enumName,
                name,
                payload,
                null,
                src,
                out,
                seen,
                at
            ),
            .VariantFields(enumName, name, fields, at) => this.variantTest(
                enumName,
                name,
                null,
                fields,
                src,
                out,
                seen,
                at
            ),
            .Fields(typeName, fields, at) => this.fieldsTest(typeName, fields, src, out, seen, at),
            .Or(alternatives, at) => this.orTest(alternatives, src, out, seen, at),
        };
    }

    /// The names of the patterns bound to values of no known type: after a fault.
    mut fn bindUnknown(patterns: Pattern[], out: List<Bound>, seen: Map<string, bool>): void {
        for (p in patterns) {
            this.patternTest(p, TExpr.Unknown, out, seen);
        }
    }

    /// The value of the optional `src`, where it is one: a pattern of its inner type tests
    /// presence first (Lyric 5 §9 §3 rule 4).
    mut fn presentOf(src: TExpr): ?TExpr {
        return match (typeOf(src)) {
            .Optional(inner) => TExpr.Narrow(boxE(src), inner.value),
            _ => null,
        };
    }

    mut fn tupleTest(
        items: Pattern[],
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(src, this.tupleTest(items, inner, out, seen, at));
        }
        let t = typeOf(src);
        match (t) {
            .Tuple(tt) => {
                if (tt.elements.length() == items.length()) {
                    var test: ?TExpr = null;
                    var k = 0;
                    for (item in items) {
                        let element = TExpr.Elem(boxE(src), k, tt.elements[k]);
                        test = andMaybe(test, this.patternTest(item, element, out, seen));
                        k += 1;
                    }
                    return test;
                }
                this.error(
                    "LYS-SEM0029",
                    f"the pattern takes {items.length()} elements; the value is {this.tyName(t)}",
                    at
                );
            }
            .Unknown => { }
            _ => {
                this.error("LYS-SEM0029", f"a tuple pattern against {this.tyName(t)}", at);
            }
        }
        this.bindUnknown(items, out, seen);
        return null;
    }

    /// A literal: the value equal to it, by the equality of the matched value's type; `null`
    /// against an optional only.
    mut fn literalTest(e: Expr, src: TExpr, at: Span): ?TExpr {
        let t = typeOf(src);
        let lit = this.expr(e, null);
        let lt = typeOf(lit);
        if (t == .Unknown || lt == .Unknown) {
            return null;
        }
        if (lt == .NullLit) {
            match (t) {
                .Optional(_) => {
                    return TExpr.IsNull(boxE(src));
                }
                _ => {
                    this.error(
                        "LYS-SEM0029",
                        f"'null' against {this.tyName(t)}, which is never null",
                        at
                    );
                    return null;
                }
            }
        }
        var base = t;
        loop {
            match (base) {
                .Optional(inner) => base = inner.value,
                _ => {
                    break;
                }
            }
        }
        if (base != lt && !(base == .Float && lt == .Int)) {
            this.error("LYS-SEM0029", f"a {this.tyName(lt)} literal against {this.tyName(t)}", at);
            return null;
        }
        let eq = this.equality(src, BinaryOp.Eq, lit, at);
        return if (typeOf(eq) == .Unknown) null else eq;
    }

    /// `a..b`, `a..=b` over int or char literals: the values between.
    mut fn rangeTest(low: Expr, high: Expr, inclusive: bool, src: TExpr, at: Span): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(src, this.rangeTest(low, high, inclusive, inner, at));
        }
        let t = typeOf(src);
        let a = this.expr(low, null);
        let b = this.expr(high, null);
        if (t == .Unknown || typeOf(a) == .Unknown || typeOf(b) == .Unknown) {
            return null;
        }
        let fits = (t == .Int || t == .Char) && typeOf(a) == t && typeOf(b) == t;
        if (!fits) {
            this.error(
                "LYS-SEM0029",
                f"a range of int or char literals against {this.tyName(t)}",
                at
            );
            return null;
        }
        let from = TExpr.Binary(boxE(src), BinaryOp.Ge, boxE(a), Ty.Bool);
        let to = TExpr.Binary(
            boxE(src),
            if (inclusive) BinaryOp.Le else BinaryOp.Lt,
            boxE(b),
            Ty.Bool
        );
        return TExpr.Binary(boxE(from), BinaryOp.And, boxE(to), Ty.Bool);
    }

    /// `.Num(p)`, `.Rect { w = p }`, qualified or not: the variant, then its payload's patterns.
    mut fn variantTest(
        enumName: ?string,
        name: string,
        payload: ?Pattern[],
        fields: ?FieldPattern[],
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(
                src,
                this.variantTest(enumName, name, payload, fields, inner, out, seen, at)
            );
        }
        let subs = List<Pattern>.new();
        if (payload != null) {
            for (x in payload) {
                subs.push(x);
            }
        }
        if (fields != null) {
            for (f in fields) {
                subs.push(f.pattern);
            }
        }
        let t = typeOf(src);
        if (t == .Unknown) {
            this.bindUnknown(subs.toArray(), out, seen);
            return null;
        }
        let i = this.enumOf(t);
        if (i < 0) {
            this.error(
                "LYS-SEM0029",
                f"'.{name}' tests a variant; the value is {this.tyName(t)}, no enum",
                at
            );
            this.bindUnknown(subs.toArray(), out, seen);
            return null;
        }
        let info = this.types[i];
        let k = this.variantIndex(i, name);
        if ((enumName != null && enumName != info.name) || k < 0) {
            let what = if (k < 0) f"'{info.name}' has no variant '{name}'"
                else f"the pattern names {enumName ?? ""}; the value is {info.name}";
            this.error("LYS-SEM0029", what, at);
            this.bindUnknown(subs.toArray(), out, seen);
            return null;
        }
        let vf = info.variantFields[k];
        var test: ?TExpr = TExpr.Binary(
            boxE(TExpr.Tag(boxE(src))),
            BinaryOp.Eq,
            boxE(TExpr.Int(k)),
            Ty.Bool
        );
        if (payload != null) {
            if (vf.length() == 0 || info.variantNamed[k]) {
                this.error(
                    "LYS-SEM0031",
                    if (vf.length() == 0) f"'{name}' carries no payload: write .{name}"
                        else f"'{name}' has named fields: test them as .{name} {{ … }}",
                    at
                );
                this.bindUnknown(subs.toArray(), out, seen);
                return test;
            }
            if (payload.length() != vf.length()) {
                this.error(
                    "LYS-SEM0029",
                    f"'{name}' carries {vf.length()} values; the pattern takes {payload.length()}",
                    at
                );
                this.bindUnknown(subs.toArray(), out, seen);
                return test;
            }
            var j = 0;
            for (x in payload) {
                let part = TExpr.Payload(boxE(src), i, k, j, vf[j].ty);
                test = andMaybe(test, this.patternTest(x, part, out, seen));
                j += 1;
            }
        } else if (fields != null) {
            if (!info.variantNamed[k]) {
                this.error("LYS-SEM0031", f"'{name}' has no named fields", at);
                this.bindUnknown(subs.toArray(), out, seen);
                return test;
            }
            for (f in fields) {
                var j = 0;
                var found = -1;
                for (decl in vf) {
                    if (decl.name == f.name) {
                        found = j;
                    }
                    j += 1;
                }
                if (found < 0) {
                    this.error("LYS-SEM0015", f"'{name}' has no field '{f.name}'", f.span);
                    this.bindUnknown([f.pattern], out, seen);
                    continue;
                }
                let part = TExpr.Payload(boxE(src), i, k, found, vf[found].ty);
                test = andMaybe(test, this.patternTest(f.pattern, part, out, seen));
            }
        } else if (vf.length() > 0) {
            let form = if (info.variantNamed[k]) f".{name} {{ … }}" else f".{name}(…)";
            this.error("LYS-SEM0031", f"'{name}' carries a payload: write {form}", at);
        }
        return test;
    }

    /// `Point { x = 0, y }`: the fields it names of a struct or class value of that type.
    mut fn fieldsTest(
        typeName: string,
        fields: FieldPattern[],
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let inner = this.presentOf(src);
        if (inner != null) {
            return presentAnd(src, this.fieldsTest(typeName, fields, inner, out, seen, at));
        }
        let subs = List<Pattern>.new();
        for (f in fields) {
            subs.push(f.pattern);
        }
        let t = typeOf(src);
        let i = match (t) {
            .Named(n) => if (this.types[n].kind != .Enum && this.types[n].name == typeName) n
                else -1,
            _ => -1,
        };
        if (i < 0) {
            if (t != .Unknown) {
                this.error(
                    "LYS-SEM0029",
                    f"the pattern names {typeName}; the value is {this.tyName(t)}",
                    at
                );
            }
            this.bindUnknown(subs.toArray(), out, seen);
            return null;
        }
        var test: ?TExpr = null;
        for (f in fields) {
            var j = 0;
            var found = -1;
            for (decl in this.types[i].fields) {
                if (decl.name == f.name) {
                    found = j;
                }
                j += 1;
            }
            if (found < 0) {
                this.error("LYS-SEM0015", f"'{typeName}' has no field '{f.name}'", f.span);
                this.bindUnknown([f.pattern], out, seen);
                continue;
            }
            let part = TExpr.Field(boxE(src), found, this.types[i].fields[found].ty);
            test = andMaybe(test, this.patternTest(f.pattern, part, out, seen));
        }
        return test;
    }

    /// `P | Q`: either; every alternative binds the same names at the same types, each name the
    /// value of the alternative that matched (Lyric 5 §9 §2 rule 7).
    mut fn orTest(
        alternatives: Pattern[],
        src: TExpr,
        out: List<Bound>,
        seen: Map<string, bool>,
        at: Span
    ): ?TExpr {
        let tests = List<?TExpr>.new();
        let bounds = List<List<Bound>>.new();
        for (alt in alternatives) {
            let b = List<Bound>.new();
            tests.push(this.patternTest(alt, src, b, Map<string, bool>.new()));
            bounds.push(b);
        }
        let first = bounds[0];
        var k = 1;
        while (k < bounds.length()) {
            let other = bounds[k];
            var same = other.length() == first.length();
            for (b in first) {
                let o = boundNamed(other, b.name);
                same = same && o != null && typeOf(o) == typeOf(b.value);
            }
            if (!same) {
                this.error(
                    "LYS-SEM0032",
                    "every alternative binds the same names, of the same types",
                    at
                );
            }
            k += 1;
        }
        // any alternative: no test where one matches every value
        var test: ?TExpr = TExpr.Bool(false);
        for (x in tests) {
            if (x == null) {
                test = null;
                break;
            }
            let sofar = test;
            test = if (sofar != null) TExpr.Binary(boxE(sofar), BinaryOp.Or, boxE(x), Ty.Bool)
                else null;
        }
        for (b in first) {
            if (seen.containsKey(b.name)) {
                this.error("LYS-SEM0097", f"'{b.name}' is bound twice in this pattern", b.at);
                continue;
            }
            seen.insert(b.name, true);
            let t = typeOf(b.value);
            var value = boundNamed(bounds[bounds.length() - 1], b.name) ?? TExpr.Unknown;
            var j = bounds.length() - 2;
            while (j >= 0) {
                let mine = boundNamed(bounds[j], b.name) ?? TExpr.Unknown;
                let tj = tests[j];
                value = if (tj != null) TExpr.If(boxE(tj), boxE(mine), boxE(value), t) else mine;
                j -= 1;
            }
            out.push(Bound { name = b.name, value = value, at = b.at });
        }
        return test;
    }

    /// Whether a binding here is a global of the script: the outermost scope of its code.
    mut fn atTop(): bool {
        return this.ctx.isMain && this.ctx.scopes.length() == 1;
    }

    mut fn declareGlobal(name: string, t: Ty, isVar: bool, at: Span): int {
        if (this.globalIndex.containsKey(name)) {
            this.error("LYS-SEM0176", f"'{name}' is bound twice in one scope", at);
        }
        let g = this.globals.length();
        this.globals.push(GlobalInfo { name = name, ty = t, isVar = isVar });
        this.globalIndex.insert(name, g);
        return g;
    }

    /// `var x: T` without a value: assigned later, and read only where it is assigned on every
    /// way (Lyric 5 §7.1 rule 5). A `let` so declared is never written, as in Lyric 5.
    mut fn unassignedLet(isVar: bool, name: string, typed: bool, t: Ty, at: Span): TStmt {
        if (!typed) {
            this.error(
                "LYS-SEM0010",
                f"'{name}' has neither a type nor a value: write its type",
                at
            );
        }
        if (this.atTop()) {
            this.error(
                "LYS-SEM0903",
                f"'{name}' is a global of the script: it takes its value where it is declared, as a function may read it before any statement assigns it",
                at
            );
            this.declareGlobal(name, t, isVar, at);
            return TStmt.Expr(TExpr.Unit, at.line);
        }
        let id = this.declareLocal(name, t, isVar, at);
        this.ctx.unassigned = withId(this.ctx.unassigned, id);
        return TStmt.Expr(TExpr.Unit, at.line);
    }

    /// `var x = null` (03 Leer): its type is the first a use in the function fixes — sought by the
    /// first pass, given by the second; where nothing fixes it, it is written.
    mut fn nullVar(name: string, at: Span): TStmt {
        let ord = this.ctx.nullVars;
        this.ctx.nullVars += 1;
        var t = Ty.Unknown;
        if (this.ctx.fixing) {
            this.ctx.fixes.push(null);
        } else {
            let fixed: ?Ty = if (ord < this.ctx.fixes.length()) this.ctx.fixes[ord] else null;
            if (fixed != null) {
                t = fixed;
            } else {
                this.errorHelp(
                    "LYS-SEM0010",
                    f"nothing in this function fixes the type of '{name}'",
                    f"write it: var {name}: ?T = null",
                    at
                );
            }
        }
        let v = if (t == .Unknown) TExpr.Unknown else TExpr.Null(t);
        if (this.atTop()) {
            let g = this.declareGlobal(name, t, true, at);
            if (this.ctx.fixing) {
                this.ctx.soughtGlobals.insert(g, ord);
            }
            return TStmt.SetGlobal(g, v, at.line);
        }
        let id = this.declareLocal(name, t, true, at);
        if (this.ctx.fixing) {
            this.ctx.sought.insert(id, ord);
        }
        return TStmt.SetLocal(id, v, at.line);
    }

    /// In the first pass of 03 Leer: where `e` is a `var x = null` whose type is still sought, `t`
    /// fixes it — the first such use in the function, as an optional.
    mut fn fixFrom(e: TExpr, t: Ty): void {
        if (!this.ctx.fixing) {
            return;
        }
        let ord: ?int = match (e) {
            .Local(id, _) => this.ctx.sought.get(id),
            .Global(g, _) => this.ctx.soughtGlobals.get(g),
            _ => null,
        };
        if (ord == null || this.ctx.fixes[ord] != null) {
            return;
        }
        let fixed: ?Ty = match (t) {
            .Optional(_) => t,
            .NullLit | .Unknown | .Void | .Never => null,
            _ => Ty.Optional(boxTy(t)),
        };
        if (fixed != null) {
            this.ctx.fixes[ord] = fixed;
        }
    }

    mut fn condition(e: Expr): TExpr {
        let c = this.expr(e, Ty.Bool);
        let t = typeOf(c);
        if (t != .Bool && t != .Unknown && t != .Never) {
            this.error("LYS-SEM0004", f"a condition is a bool, not {this.tyName(t)}", spanOf(e));
            return TExpr.Unknown;
        }
        return c;
    }

    /// `for (x in a..b)`: over a range of ints; other iterables come with the collections (S7).
    mut fn forStmt(name: string, iterable: Expr, body: Block, at: Span): TStmt {
        match (iterable) {
            .Range(from, to, inclusive, _) => {
                let a = this.coerce(this.expr(from.value, Ty.Int), Ty.Int, spanOf(from.value));
                let b = this.coerce(this.expr(to.value, Ty.Int), Ty.Int, spanOf(to.value));
                let before = this.ctx.unassigned;
                this.pushScope();
                let id = this.declareLocal(name, Ty.Int, false, at);
                this.ctx.loops.push(LoopCtx { isLoop = false });
                let stmts = this.block(body);
                this.ctx.loops.pop();
                this.popScope();
                // the body may not run
                this.ctx.unassigned = before;
                return TStmt.ForRange(id, a, b, inclusive, stmts, at.line);
            }
            _ => { }
        }
        this.notYet(
            "a loop over anything but a range of ints",
            "S7 (the core collections)",
            spanOf(iterable)
        );
        return TStmt.Expr(TExpr.Unknown, at.line);
    }

    mut fn breakStmt(value: ?Expr, at: Span): TStmt {
        let out = this.breakOf(value, at);
        if (this.ctx.loops.length() > 0) {
            let loop = this.ctx.loops[this.ctx.loops.length() - 1];
            loop.exits = loop.exits.union(this.ctx.unassigned);
        }
        return out;
    }

    mut fn breakOf(value: ?Expr, at: Span): TStmt {
        if (this.ctx.loops.length() == 0) {
            this.error("LYS-SEM0147", "'break' outside a loop", at);
            return TStmt.Break(null, at.line);
        }
        let loop = this.ctx.loops[this.ctx.loops.length() - 1];
        loop.breaks += 1;
        if (value == null) {
            if (loop.isLoop && loop.breakTy != null) {
                this.error(
                    "LYS-SEM0149",
                    "this 'loop' gives a value at some breaks and none at this one",
                    at
                );
            }
            return TStmt.Break(null, at.line);
        }
        if (!loop.isLoop) {
            this.error(
                "LYS-SEM0148",
                "a 'while' or 'for' gives no value: its 'break' takes none",
                at
            );
            return TStmt.Break(null, at.line);
        }
        let given = loop.breakTy;
        let v = this.expr(value, given);
        if (given == null) {
            if (loop.breaks > 1) {
                this.error(
                    "LYS-SEM0149",
                    "this 'loop' gives a value at this break and none at another",
                    at
                );
            }
            loop.breakTy = typeOf(v);
            return TStmt.Break(v, at.line);
        }
        return TStmt.Break(this.coerce(v, given, spanOf(value)), at.line);
    }

    mut fn returnStmt(value: ?Expr, at: Span): TStmt {
        if (this.ctx.isMain) {
            this.error(
                "LYS-SEM0902",
                "'return' outside a function: a script ends at its end, or with exit(n)",
                at
            );
            return TStmt.Return(null, at.line);
        }
        let expected = this.ctx.returns;
        if (value == null) {
            if (expected != .Void && expected != .Unknown) {
                this.error(
                    "LYS-SEM0226",
                    f"this 'return' gives no value; the function returns {this.tyName(expected)}",
                    at
                );
            }
            return TStmt.Return(null, at.line);
        }
        if (expected == .Void) {
            this.error(
                "LYS-SEM0001",
                "the function returns nothing, so its 'return' takes no value",
                at
            );
            return TStmt.Return(null, at.line);
        }
        return TStmt.Return(
            this.coerce(this.expr(value, expected), expected, spanOf(value)),
            at.line
        );
    }

    // --- expressions -----------------------------------------------------------------------------

    /// Checks an expression; `expected` is the type its place takes, where one is known.
    mut fn expr(e: Expr, expected: ?Ty): TExpr {
        return match (e) {
            .Int(n, _) => TExpr.Int(n),
            .Float(x, _) => TExpr.Float(x),
            .Bool(b, _) => TExpr.Bool(b),
            .Char(c, _) => TExpr.Char(c),
            .Str(s, _) => TExpr.Str(s),
            .Bytes(_, at) => this.notYet("a byte string", "S7 (Bytes)", at),
            .Interpolated(segments, at) => this.interpolated(segments, at),
            .Null(_) => {
                let t = expected ?? Ty.NullLit;
                match (t) {
                    .Optional(_) => TExpr.Null(t),
                    _ => TExpr.Null(Ty.NullLit),
                }
            }
            .Tuple(items, _) => this.tuple(items, expected),
            .Unwrap(x, at) => {
                let v = this.expr(x.value, null);
                match (typeOf(v)) {
                    .Optional(inner) => TExpr.Unwrap(boxE(v), inner.value),
                    .Unknown => TExpr.Unknown,
                    _ => {
                        this.error("LYS-SEM0005", "'!' on a value that is never null", at);
                        TExpr.Unknown
                    }
                }
            }
            .Name(name, at) => this.name(name, at),
            .This(at) => {
                let fnIndex = this.ctx.fnIndex;
                if (fnIndex >= 0
                    && this.functions[fnIndex].owner >= 0
                    && !this.functions[fnIndex].isStatic) {
                    TExpr.Local(0, Ty.Named(this.functions[fnIndex].owner))
                } else {
                    this.error("LYS-SEM0008", "'this' outside a method", at);
                    TExpr.Unknown
                }
            }
            .Unary(op, x, at) => this.unary(op, x.value, at),
            .Binary(l, op, r, at) => this.binary(l.value, op, r.value, at),
            .Assign(target, op, value, at) => this.assign(target.value, op, value.value, at),
            .Range(_, _, _, at) => this.notYet("a range as a value", "S3", at),
            .Cast(x, written, at) => this.cast(x.value, written, at),
            .Call(callee, args, at) => this.call(callee.value, args, expected, at),
            .Implicit(name, at) => this.implicit(name, expected, at),
            .VariantInit(enumName, name, fields, at) => this.variantInit(
                enumName,
                name,
                fields,
                expected,
                at
            ),
            .Match(x, arms, at) => this.matchOf(x.value, arms, expected, false, at),
            .Index(_, _, at) => this.notYet("indexing", "S7 (the core collections)", at),
            .Member(x, name, optional, at) => this.member(x.value, name, optional, at),
            .List(_, at) => this.notYet("a list literal", "S7 (the core collections)", at),
            .Map(_, at) => this.notYet("a map literal", "S7 (the core collections)", at),
            .StructInit(name, fields, at) => this.init(name, fields, at),
            .If(cond, then, otherwise, at) => this.ifExpr(
                cond.value,
                then.value,
                otherwise.value,
                expected,
                at
            ),
            .Block(b, _) => this.valueBlock(b, expected),
            .Loop(body, _, at) => {
                this.unnarrowWritten([Stmt.Expr(e, at)]);
                let ctx = LoopCtx { isLoop = true };
                this.ctx.loops.push(ctx);
                let stmts = this.block(body);
                this.ctx.loops.pop();
                // left only by its breaks: what follows knows what each of them left
                this.ctx.unassigned = ctx.exits;
                let given = ctx.breakTy;
                let t = if (given != null) given else if (ctx.breaks > 0) Ty.Void else Ty.Never;
                TExpr.Loop(stmts, t)
            }
        };
    }

    /// `(a, b)`: where a tuple of its length is expected — through an optional too — each
    /// element where the expected element is, and the tuple of the expected type, labels and all
    /// (Lyric 5 §6 rule 5); else each element as it stands.
    mut fn tuple(items: Expr[], expected: ?Ty): TExpr {
        let want = expectedTuple(expected, items.length());
        let values = List<TExpr>.new();
        let tys = List<Ty>.new();
        let labels = List<string>.new();
        var bad = false;
        var k = 0;
        for (x in items) {
            if (want != null) {
                let et = want.elements[k];
                values.push(this.coerce(this.expr(x, et), et, spanOf(x)));
                tys.push(et);
            } else {
                let v = this.expr(x, null);
                let t = typeOf(v);
                if (t == .NullLit || t == .Void || t == .Never) {
                    this.error(
                        "LYS-SEM0010",
                        "this element gives no type of its own: write the tuple's type",
                        spanOf(x)
                    );
                    bad = true;
                }
                values.push(v);
                tys.push(t);
            }
            labels.push("");
            k += 1;
        }
        if (bad) {
            return TExpr.Unknown;
        }
        let t = if (want != null) Ty.Tuple(want)
            else Ty.Tuple(TupleTy { elements = tys.toArray(), labels = labels.toArray() });
        return TExpr.Tuple(values.toArray(), t);
    }

    /// `t.0`, `t.x`: the element of tuple `o` at a position or under a label of its type.
    mut fn element(o: TExpr, tt: TupleTy, name: string, at: Span): TExpr {
        var found = positionOf(name);
        if (found < 0) {
            var k = 0;
            for (label in tt.labels) {
                if (label == name) {
                    found = k;
                }
                k += 1;
            }
        }
        if (found < 0 || found >= tt.elements.length()) {
            this.error("LYS-SEM0012", f"{this.tyName(Ty.Tuple(tt))} has no element '{name}'", at);
            return TExpr.Unknown;
        }
        return TExpr.Elem(boxE(o), found, tt.elements[found]);
    }

    mut fn name(name: string, at: Span): TExpr {
        let local = this.lookupLocal(name);
        if (local != null) {
            if (this.ctx.unassigned.contains(local)) {
                this.error(
                    "LYS-SEM0018",
                    f"'{name}' is read where it may not be assigned yet: assign it on every way to here",
                    at
                );
            }
            let declared = this.ctx.locals[local];
            let narrowed = this.narrowedLocal(local);
            if (narrowed != null) {
                return TExpr.Narrow(boxE(TExpr.Local(local, declared)), narrowed);
            }
            return TExpr.Local(local, declared);
        }
        let global = this.globalIndex.get(name);
        if (global != null) {
            let declared = this.globals[global].ty;
            let narrowed = this.narrowedGlobal(global);
            if (narrowed != null) {
                return TExpr.Narrow(boxE(TExpr.Global(global, declared)), narrowed);
            }
            return TExpr.Global(global, declared);
        }
        if (this.fnByName.containsKey(name)) {
            return this.notYet("a function as a value", "S3 (function values)", at);
        }
        if (this.typeIndex.containsKey(name)
            || this.aliases.containsKey(name)
            || isBuiltinType(name)) {
            this.error("LYS-SEM0052", f"'{name}' is a type, not a value", at);
            return TExpr.Unknown;
        }
        this.error("LYS-SEM0002", f"nothing in scope is named '{name}'", at);
        return TExpr.Unknown;
    }

    mut fn unary(op: UnaryOp, x: Expr, at: Span): TExpr {
        let v = this.expr(x, null);
        let t = typeOf(v);
        if (t == .Unknown) {
            return TExpr.Unknown;
        }
        let fits = match (op) {
            .Neg => t == .Int || t == .Float,
            .Not => t == .Bool,
            .BitNot => t == .Int,
        };
        if (!fits) {
            this.error("LYS-SEM0003", f"'{unaryText(op)}' does not take {this.tyName(t)}", at);
            return TExpr.Unknown;
        }
        return TExpr.Unary(op, boxE(v), t);
    }

    mut fn binary(l: Expr, op: BinaryOp, r: Expr, at: Span): TExpr {
        match (op) {
            .Coalesce => {
                return this.coalesce(l, r, at);
            }
            .In | .NotIn => {
                return this.notYet(f"'{binaryText(op)}'", "S7 (the core collections)", at);
            }
            _ => { }
        }
        let a = this.expr(l, null);
        // the right side of `&&` and `||` sees what the left one says where it is checked
        var b = TExpr.Unknown;
        if (op == .And || op == .Or) {
            // the right side may not run: what it assigns does not count
            let before = this.ctx.unassigned;
            this.pushScope();
            this.narrow(this.factsOf(a, op == .And));
            b = this.expr(r, null);
            this.popScope();
            this.ctx.unassigned = before;
        } else {
            // `x == .Red`: the other side names the enum (Lyric 5 §4.2 rule 1)
            b = this.expr(r, if ((op == .Eq || op == .Ne) && isImplicit(r)) typeOf(a) else null);
        }
        let ta = typeOf(a);
        let tb = typeOf(b);
        if (ta == .Unknown || tb == .Unknown) {
            return TExpr.Unknown;
        }
        // `x == null`, `x != null`
        if ((op == .Eq || op == .Ne) && (ta == .NullLit || tb == .NullLit)) {
            let other = if (ta == .NullLit) b else a;
            let ot = typeOf(other);
            match (ot) {
                .Optional(_) => {
                    let test = TExpr.IsNull(boxE(other));
                    return if (op == .Eq) test else TExpr.Unary(UnaryOp.Not, boxE(test), Ty.Bool);
                }
                _ => {
                    this.error(
                        "LYS-SEM0059",
                        f"'{binaryText(op)} null' on a value that is never null",
                        at
                    );
                    return TExpr.Unknown;
                }
            }
        }
        let numeric = (ta == .Int || ta == .Float) && (tb == .Int || tb == .Float);
        let wide = if (ta == .Float || tb == .Float) Ty.Float else Ty.Int;
        match (op) {
            .And | .Or => {
                if (ta == .Bool && tb == .Bool) {
                    return TExpr.Binary(boxE(a), op, boxE(b), Ty.Bool);
                }
            }
            .Add | .Sub | .Mul | .Div | .Rem => {
                if (numeric) {
                    return TExpr.Binary(
                        boxE(this.coerce(a, wide, at)),
                        op,
                        boxE(this.coerce(b, wide, at)),
                        wide
                    );
                }
                if (op == .Add && ta == .Str && tb == .Str) {
                    return TExpr.Native(Native.Concat, [a, b], Ty.Str);
                }
            }
            .AddWrap | .SubWrap | .MulWrap | .Shl | .Shr | .BitAnd | .BitOr | .BitXor => {
                if (ta == .Int && tb == .Int) {
                    return TExpr.Binary(boxE(a), op, boxE(b), Ty.Int);
                }
            }
            .Lt | .Le | .Gt | .Ge => {
                if (numeric) {
                    return TExpr.Binary(
                        boxE(this.coerce(a, wide, at)),
                        op,
                        boxE(this.coerce(b, wide, at)),
                        Ty.Bool
                    );
                }
                if (ta == .Char && tb == .Char) {
                    return TExpr.Binary(boxE(a), op, boxE(b), Ty.Bool);
                }
                if (ta == .Str && tb == .Str) {
                    let cmp = TExpr.Native(Native.StrCmp, [a, b], Ty.Int);
                    return TExpr.Binary(boxE(cmp), op, boxE(TExpr.Int(0)), Ty.Bool);
                }
            }
            .Eq | .Ne => {
                return this.equality(a, op, b, at);
            }
            _ => { }
        }
        this.error(
            "LYS-SEM0003",
            f"'{binaryText(op)}' does not take {this.tyName(ta)} and {this.tyName(tb)}",
            at
        );
        return TExpr.Unknown;
    }

    /// `a == b` and `a != b` of two checked operands: numbers widened, `bool`, `char`, an enum's
    /// variants and strings by value, optionals by Lyric 5 §3.2 rule 7.
    mut fn equality(a: TExpr, op: BinaryOp, b: TExpr, at: Span): TExpr {
        let ta = typeOf(a);
        let tb = typeOf(b);
        if (ta == .Unknown || tb == .Unknown) {
            return TExpr.Unknown;
        }
        let numeric = (ta == .Int || ta == .Float) && (tb == .Int || tb == .Float);
        if (numeric) {
            let wide = if (ta == .Float || tb == .Float) Ty.Float else Ty.Int;
            return TExpr.Binary(
                boxE(this.coerce(a, wide, at)),
                op,
                boxE(this.coerce(b, wide, at)),
                Ty.Bool
            );
        }
        // an optional beside a value of it or beside its like: a `T` coerces up to `?T`
        let opt = match (ta) {
            .Optional(_) => ta,
            _ => tb,
        };
        match (opt) {
            .Optional(_) => {
                let x = this.fit(a, opt);
                let y = this.fit(b, opt);
                if (x != null && y != null) {
                    return this.optionalEquality(x, op, y, opt, at);
                }
            }
            _ => { }
        }
        if (ta == tb && (ta == .Bool || ta == .Char || this.isScalarEnum(ta))) {
            return TExpr.Binary(boxE(a), op, boxE(b), Ty.Bool);
        }
        if (ta == .Str && tb == .Str) {
            let eq = TExpr.Native(Native.StrEq, [a, b], Ty.Bool);
            return if (op == .Eq) eq else TExpr.Unary(UnaryOp.Not, boxE(eq), Ty.Bool);
        }
        if (ta == tb) {
            return this.notYet(
                f"'{binaryText(op)}' on {this.tyName(ta)}",
                "S3 (synthesized equality)",
                at
            );
        }
        this.error(
            "LYS-SEM0059",
            f"'{binaryText(op)}' compares values of one type: {this.tyName(ta)} and {this.tyName(tb)}",
            at
        );
        return TExpr.Unknown;
    }

    /// Two optionals of type `t` are equal where both hold nothing, or both hold values their own
    /// equality finds equal; each is evaluated once, into a local of its own.
    mut fn optionalEquality(a: TExpr, op: BinaryOp, b: TExpr, t: Ty, at: Span): TExpr {
        let inner = match (t) {
            .Optional(i) => i.value,
            _ => Ty.Unknown,
        };
        let ha = this.hidden(t, at);
        let hb = this.hidden(t, at);
        let la = TExpr.Local(ha, t);
        let lb = TExpr.Local(hb, t);
        let values = this.equality(
            TExpr.Narrow(boxE(la), inner),
            BinaryOp.Eq,
            TExpr.Narrow(boxE(lb), inner),
            at
        );
        if (typeOf(values) == .Unknown) {
            return TExpr.Unknown;
        }
        let noneA = TExpr.IsNull(boxE(la));
        let noneB = TExpr.IsNull(boxE(lb));
        let same = TExpr.If(
            boxE(noneA),
            boxE(noneB),
            boxE(TExpr.If(boxE(noneB), boxE(TExpr.Bool(false)), boxE(values), Ty.Bool)),
            Ty.Bool
        );
        let eq = TExpr.Block(
            [TStmt.SetLocal(ha, a, at.line), TStmt.SetLocal(hb, b, at.line)],
            boxE(same),
            Ty.Bool
        );
        return if (op == .Eq) eq else TExpr.Unary(UnaryOp.Not, boxE(eq), Ty.Bool);
    }

    /// `a ?? b`: `a` an optional; `b` its value's type, which the result has, or an optional of
    /// it, which the result has then.
    mut fn coalesce(l: Expr, r: Expr, at: Span): TExpr {
        let a = this.expr(l, null);
        let ta = typeOf(a);
        let before = this.ctx.unassigned;
        return match (ta) {
            .Optional(inner) => {
                let b = this.expr(r, inner.value);
                // the right side may not run: what it assigns does not count
                this.ctx.unassigned = before;
                let plain = this.fit(b, inner.value);
                if (plain != null) {
                    return TExpr.Coalesce(boxE(a), boxE(plain), inner.value);
                }
                let opt = this.fit(b, ta);
                if (opt != null) {
                    return TExpr.Coalesce(boxE(a), boxE(opt), ta);
                }
                if (typeOf(b) != .Unknown) {
                    this.error(
                        "LYS-SEM0001",
                        f"expected {this.tyName(inner.value)}, found {this.tyName(typeOf(b))}",
                        spanOf(r)
                    );
                }
                TExpr.Unknown
            }
            .Unknown => TExpr.Unknown,
            _ => {
                this.error("LYS-SEM0005", "'??' on a value that is never null", at);
                TExpr.Unknown
            }
        };
    }

    /// An enum whose values are `int`s: none of its variants carries a payload.
    mut fn isScalarEnum(t: Ty): bool {
        return match (t) {
            .Named(i) => this.types[i].kind == .Enum && !this.types[i].payload,
            _ => false,
        };
    }

    /// The enum `t` is, or holds as an optional; -1 where it is none.
    mut fn enumOf(t: Ty): int {
        return match (t) {
            .Named(i) => if (this.types[i].kind == .Enum) i else -1,
            .Optional(inner) => this.enumOf(inner.value),
            _ => -1,
        };
    }

    /// The enum the position expects, `?E` naming `E` (Lyric 5 §4.2 rule 1); -1 where none.
    mut fn expectedEnum(expected: ?Ty): int {
        if (expected == null) {
            return -1;
        }
        return this.enumOf(expected);
    }

    mut fn variantIndex(i: int, name: string): int {
        var k = 0;
        for (v in this.types[i].variants) {
            if (v == name) {
                return k;
            }
            k += 1;
        }
        return -1;
    }

    /// `Color.Red`, `.Red`: a unit variant — an `int` where the enum carries no payload, an
    /// object where another variant does.
    mut fn unitVariant(i: int, k: int, at: Span): TExpr {
        let info = this.types[i];
        let v = info.variants[k];
        if (info.variantFields[k].length() > 0) {
            let form = if (info.variantNamed[k]) f"{info.name}.{v} {{ … }}"
                else f"{info.name}.{v}(…)";
            this.error("LYS-SEM0031", f"'{v}' carries a payload: build it as {form}", at);
            return TExpr.Unknown;
        }
        return if (info.payload) TExpr.MakeVariant(i, k, []) else TExpr.Variant(i, k);
    }

    /// `Shape.Num(3)`: a variant whose payload is given by position.
    mut fn variantCall(i: int, k: int, args: Arg[], at: Span): TExpr {
        let info = this.types[i];
        let v = info.variants[k];
        let fields = info.variantFields[k];
        if (fields.length() == 0) {
            this.error("LYS-SEM0031", f"'{v}' carries no payload: write {info.name}.{v}", at);
            return TExpr.Unknown;
        }
        if (info.variantNamed[k]) {
            this.error(
                "LYS-SEM0031",
                f"'{v}' has named fields: build it as {info.name}.{v} {{ … }}",
                at
            );
            return TExpr.Unknown;
        }
        if (args.length() != fields.length()) {
            this.error(
                "LYS-SEM0014",
                f"'{v}' carries {fields.length()} values; {args.length()} are given",
                at
            );
            return TExpr.Unknown;
        }
        let values = List<TExpr>.new();
        var j = 0;
        for (a in args) {
            if (a.name != null) {
                this.error("LYS-SEM0119", f"'{v}' takes its payload by position", spanOf(a.value));
            }
            let t = fields[j].ty;
            values.push(this.coerce(this.expr(a.value, t), t, spanOf(a.value)));
            j += 1;
        }
        return TExpr.MakeVariant(i, k, values.toArray());
    }

    /// `.Red` where the position expects an enum (Lyric 5 §4.2).
    mut fn implicit(name: string, expected: ?Ty, at: Span): TExpr {
        let i = this.expectedEnum(expected);
        if (i < 0) {
            this.error(
                "LYS-SEM0113",
                f"'.{name}' needs an enum where it stands: name it, as E.{name}",
                at
            );
            return TExpr.Unknown;
        }
        let k = this.variantIndex(i, name);
        if (k < 0) {
            this.error("LYS-SEM0012", f"'{this.types[i].name}' has no variant '{name}'", at);
            return TExpr.Unknown;
        }
        return this.unitVariant(i, k, at);
    }

    /// `Shape.Rect { w = 1, h = 2 }` and `.Rect { … }`: a variant with named fields.
    mut fn variantInit(
        enumName: ?string,
        name: string,
        fields: FieldInit[],
        expected: ?Ty,
        at: Span
    ): TExpr {
        var i = -1;
        if (enumName != null) {
            let index = this.typeIndex.get(enumName);
            if (index == null || this.types[index].kind != .Enum) {
                this.error("LYS-SEM0011", f"'{enumName}' names no enum", at);
                return TExpr.Unknown;
            }
            i = index;
        } else {
            i = this.expectedEnum(expected);
            if (i < 0) {
                this.error(
                    "LYS-SEM0113",
                    f"'.{name}' needs an enum where it stands: name it, as E.{name} {{ … }}",
                    at
                );
                return TExpr.Unknown;
            }
        }
        let info = this.types[i];
        let k = this.variantIndex(i, name);
        if (k < 0) {
            this.error("LYS-SEM0012", f"'{info.name}' has no variant '{name}'", at);
            return TExpr.Unknown;
        }
        if (!info.variantNamed[k]) {
            this.error(
                "LYS-SEM0031",
                f"'{name}' has no named fields: write {info.name}.{name}"
                    + (if (info.variantFields[k].length() > 0) "(…)" else ""),
                at
            );
            return TExpr.Unknown;
        }
        let values = this.fieldValues(f"{info.name}.{name}", info.variantFields[k], fields, at);
        return TExpr.MakeVariant(i, k, values);
    }

    mut fn assign(target: Expr, op: ?BinaryOp, value: Expr, at: Span): TExpr {
        let result = this.assignTo(target, op, value, at);
        // an assignment ends a narrowing of the binding (Lyric 5 §3.2 rule 4), and assigns it
        match (target) {
            .Name(name, _) => {
                let local = this.lookupLocal(name);
                if (local != null) {
                    this.unnarrow(local);
                    this.ctx.unassigned = withoutId(this.ctx.unassigned, local);
                }
            }
            _ => { }
        }
        return result;
    }

    mut fn assignTo(target: Expr, op: ?BinaryOp, value: Expr, at: Span): TExpr {
        var place = Place.Local(0);
        var t = Ty.Unknown;
        var current = TExpr.Unknown;
        match (target) {
            .Name(name, nameAt) => {
                let local = this.lookupLocal(name);
                let global = this.globalIndex.get(name);
                if (local != null) {
                    if (!this.ctx.localIsVar[local]) {
                        this.error(
                            "LYS-SEM0019",
                            f"'{name}' is a let: declare it with var to write it",
                            nameAt
                        );
                    }
                    // `x op= v` and `x ??= v` read it first
                    if (op != null && this.ctx.unassigned.contains(local)) {
                        this.error(
                            "LYS-SEM0018",
                            f"'{name}' is read where it may not be assigned yet: assign it on every way to here",
                            nameAt
                        );
                    }
                    place = Place.Local(local);
                    t = this.ctx.locals[local];
                    current = TExpr.Local(local, t);
                } else if (global != null) {
                    if (!this.globals[global].isVar) {
                        this.error(
                            "LYS-SEM0019",
                            f"'{name}' is a let: declare it with var to write it",
                            nameAt
                        );
                    }
                    place = Place.Global(global);
                    t = this.globals[global].ty;
                    current = TExpr.Global(global, t);
                } else {
                    this.name(name, nameAt);
                    return TExpr.Unknown;
                }
            }
            .Member(object, field, optional, memberAt) => {
                if (optional) {
                    this.error(
                        "LYS-SEM0019",
                        "nothing is assigned through '?.': narrow first",
                        memberAt
                    );
                    return TExpr.Unknown;
                }
                let o = this.expr(object.value, null);
                match (typeOf(o)) {
                    .Tuple(_) => {
                        this.error(
                            "LYS-SEM0019",
                            "a tuple's elements are never written: build a new tuple",
                            memberAt
                        );
                        return TExpr.Unknown;
                    }
                    _ => { }
                }
                let found = this.fieldOf(o, field, memberAt);
                if (found == null) {
                    return TExpr.Unknown;
                }
                let (owner, index) = found;
                let info = this.types[owner];
                if (info.kind == .Struct) {
                    this.error(
                        "LYS-SEM0019",
                        f"a struct's fields are never written: build a new {info.name}",
                        memberAt
                    );
                } else if (!info.fields[index].isVar) {
                    this.error(
                        "LYS-SEM0019",
                        f"'{field}' is no var field of {info.name}",
                        memberAt
                    );
                }
                place = Place.Field(boxE(o), index);
                t = info.fields[index].ty;
                current = TExpr.Field(boxE(o), index, t);
            }
            .Index(_, _, indexAt) => {
                return this.notYet("indexing", "S7 (the core collections)", indexAt);
            }
            _ => {
                this.error(
                    "LYS-SEM0019",
                    "this cannot be written: a variable or a field can",
                    spanOf(target)
                );
                return TExpr.Unknown;
            }
        }
        if (op == BinaryOp.Coalesce) {
            // `x ??= v`: v, as an optional of x's type, only where x is absent
            match (t) {
                .Optional(_) => {
                    // the value may not be evaluated: what it assigns does not count
                    let before = this.ctx.unassigned;
                    let v = this.coerce(this.expr(value, t), t, spanOf(value));
                    this.ctx.unassigned = before;
                    return TExpr.Assign(place, op, boxE(v), t);
                }
                .Unknown => {
                    this.fixFrom(current, typeOf(this.expr(value, null)));
                    return TExpr.Unknown;
                }
                _ => {
                    this.error("LYS-SEM0005", "'??=' on a value that is never null", at);
                    return TExpr.Unknown;
                }
            }
        }
        if (op != null) {
            // `x op= v` is `x = x op v`, with the place evaluated once
            let combined = this.binaryChecked(current, op, this.expr(value, t), at);
            return TExpr.Assign(place, op, boxE(this.coerceOperand(combined, t, at)), t);
        }
        let v = this.coerce(this.expr(value, t), t, spanOf(value));
        this.fixFrom(current, typeOf(v));
        return TExpr.Assign(place, null, boxE(v), t);
    }

    /// The right side of `x op= v` as the operation gives it: only its value's type is kept, the
    /// generator applies `op` to the place it reads once.
    mut fn binaryChecked(current: TExpr, op: BinaryOp, v: TExpr, at: Span): TExpr {
        let tc = typeOf(current);
        let tv = typeOf(v);
        if (tc == .Unknown || tv == .Unknown) {
            return TExpr.Unknown;
        }
        let numeric = (tc == .Int || tc == .Float) && (tv == .Int || tv == .Float);
        let fits = match (op) {
            .Add => numeric || (tc == .Str && tv == .Str),
            .Sub | .Mul | .Div | .Rem => numeric,
            .AddWrap | .SubWrap | .MulWrap | .Shl | .Shr | .BitAnd | .BitOr | .BitXor => tc == .Int
                && tv == .Int,
            .And | .Or => tc == .Bool && tv == .Bool,
            _ => false,
        };
        if (!fits) {
            if (op == .Coalesce) {
                return this.notYet("'??='", "S3 (optionals)", at);
            }
            this.error(
                "LYS-SEM0003",
                f"'{binaryText(op)}=' does not take {this.tyName(tc)} and {this.tyName(tv)}",
                at
            );
            return TExpr.Unknown;
        }
        if (tc == .Int && tv == .Float) {
            this.error(
                "LYS-SEM0001",
                f"expected int, found float: '{binaryText(op)}=' keeps the type of its target",
                at
            );
            return TExpr.Unknown;
        }
        return v;
    }

    mut fn coerceOperand(v: TExpr, t: Ty, at: Span): TExpr {
        return this.coerce(v, t, at);
    }

    mut fn cast(x: Expr, written: TypeExpr, at: Span): TExpr {
        let v = this.expr(x, null);
        let from = typeOf(v);
        let to = this.resolveType(written);
        if (from == .Unknown || to == .Unknown) {
            return TExpr.Unknown;
        }
        let scalar = (from == .Int || from == .Float || from == .Char)
            && (to == .Int || to == .Float || to == .Char);
        if (!scalar || (from == .Float && to == .Char) || (from == .Char && to == .Float)) {
            this.error(
                "LYS-SEM0006",
                f"'as' converts between int, float and char: not {this.tyName(from)} to {this.tyName(to)}",
                at
            );
            return TExpr.Unknown;
        }
        return TExpr.Cast(boxE(v), to);
    }

    /// The type and index of a struct's or class's field, reported when it has none.
    mut fn fieldOf(o: TExpr, field: string, at: Span): ?(int, int) {
        let t = typeOf(o);
        match (t) {
            .Unknown => {
                return null;
            }
            .Named(i) => {
                var k = 0;
                for (f in this.types[i].fields) {
                    if (f.name == field) {
                        return (i, k);
                    }
                    k += 1;
                }
                this.error("LYS-SEM0012", f"'{this.types[i].name}' has no field '{field}'", at);
                return null;
            }
            .Str | .List(_) | .Map(_, _) => {
                this.notYet(f"the members of {this.tyName(t)}", "S7 (the core library)", at);
                return null;
            }
            _ => { }
        }
        this.error("LYS-SEM0012", f"{this.tyName(t)} has no field '{field}'", at);
        return null;
    }

    /// The value of `x?.…` in a local of its own: its type, and what it holds where it is there;
    /// reported where `x` is never null.
    mut fn optionalReceiver(x: Expr, at: Span): ?(TExpr, int, Ty) {
        let o = this.expr(x, null);
        let ot = typeOf(o);
        return match (ot) {
            .Optional(inner) => (o, this.hidden(ot, at), inner.value),
            .Unknown => null,
            _ => {
                this.error("LYS-SEM0005", "'?.' on a value that is never null", at);
                null
            }
        };
    }

    /// `x?.m` with `x` held in local `tmp`: null where `x` is, else the member, as an optional —
    /// one level only where the member is an optional itself (03 O: `?.` flattens).
    mut fn optChain(tmp: int, value: TExpr, access: TExpr, at: Span): TExpr {
        let ot = typeOf(value);
        let mt = typeOf(access);
        let absent = TExpr.IsNull(boxE(TExpr.Local(tmp, ot)));
        let store = [TStmt.SetLocal(tmp, value, at.line)];
        return match (mt) {
            .Void => TExpr.Block(
                store,
                boxE(TExpr.If(boxE(absent), boxE(TExpr.Unit), boxE(access), Ty.Void)),
                Ty.Void
            ),
            .Unknown => TExpr.Unknown,
            .Optional(_) => TExpr.Block(
                store,
                boxE(TExpr.If(boxE(absent), boxE(TExpr.Null(mt)), boxE(access), mt)),
                mt
            ),
            _ => {
                let rt = Ty.Optional(boxTy(mt));
                TExpr.Block(
                    store,
                    boxE(
                        TExpr.If(
                            boxE(absent),
                            boxE(TExpr.Null(rt)),
                            boxE(TExpr.Wrap(boxE(access), rt)),
                            rt
                        )
                    ),
                    rt
                )
            }
        };
    }

    mut fn member(x: Expr, name: string, optional: bool, at: Span): TExpr {
        if (optional) {
            let held = this.optionalReceiver(x, at);
            if (held == null) {
                return TExpr.Unknown;
            }
            let (o, tmp, inner) = held;
            let present = TExpr.Narrow(boxE(TExpr.Local(tmp, typeOf(o))), inner);
            match (inner) {
                .Tuple(tt) => {
                    return this.optChain(tmp, o, this.element(present, tt, name, at), at);
                }
                _ => { }
            }
            let found = this.fieldOf(present, name, at);
            if (found == null) {
                return TExpr.Unknown;
            }
            let (owner, index) = found;
            let access = TExpr.Field(boxE(present), index, this.types[owner].fields[index].ty);
            return this.optChain(tmp, o, access, at);
        }
        // `Color.Red`: a variant of an enum
        match (x) {
            .Name(typeName, _) => {
                if (this.lookupLocal(typeName) == null && !this.globalIndex.containsKey(typeName)) {
                    let index = this.typeIndex.get(typeName);
                    if (index != null) {
                        let k = this.variantIndex(index, name);
                        if (k >= 0) {
                            return this.unitVariant(index, k, at);
                        }
                        this.error("LYS-SEM0012", f"'{typeName}' has no member '{name}'", at);
                        return TExpr.Unknown;
                    }
                }
            }
            _ => { }
        }
        let o = this.expr(x, null);
        match (typeOf(o)) {
            .Tuple(tt) => {
                return this.element(o, tt, name, at);
            }
            _ => { }
        }
        let found = this.fieldOf(o, name, at);
        if (found == null) {
            return TExpr.Unknown;
        }
        let (owner, index) = found;
        return TExpr.Field(boxE(o), index, this.types[owner].fields[index].ty);
    }

    mut fn init(name: string, fields: FieldInit[], at: Span): TExpr {
        let index = this.typeIndex.get(name);
        if (index == null) {
            this.resolveNamed(name, [], at);
            return TExpr.Unknown;
        }
        let info = this.types[index];
        if (info.kind == .Enum) {
            this.error(
                "LYS-SEM0031",
                f"'{name}' is an enum: its values are its variants, written '{name}.Variant'",
                at
            );
            return TExpr.Unknown;
        }
        return TExpr.New(index, this.fieldValues(name, info.fields, fields, at));
    }

    /// The values of an initializer of `decls`: each given one checked against its field, a
    /// default where none is given; every field without either named in one report.
    mut fn fieldValues(name: string, decls: FieldInfo[], fields: FieldInit[], at: Span): TExpr[] {
        let values = List<?TExpr>.new();
        for (_ in decls) {
            values.push(null);
        }
        for (f in fields) {
            var k = 0;
            var found = -1;
            for (decl in decls) {
                if (decl.name == f.name) {
                    found = k;
                }
                k += 1;
            }
            if (found < 0) {
                this.error("LYS-SEM0015", f"'{name}' declares no field '{f.name}'", f.span);
                continue;
            }
            if (values[found] != null) {
                this.error("LYS-SEM0070", f"'{f.name}' is given twice", f.span);
                continue;
            }
            let t = decls[found].ty;
            values[found] = this.coerce(this.expr(f.value, t), t, spanOf(f.value));
        }
        let out = List<TExpr>.new();
        let missing = List<string>.new();
        var k = 0;
        for (decl in decls) {
            let given = values[k];
            let dflt = decl.default;
            if (given != null) {
                out.push(given);
            } else if (dflt != null) {
                out.push(dflt);
            } else {
                missing.push(decl.name);
                out.push(TExpr.Unknown);
            }
            k += 1;
        }
        if (missing.length() > 0) {
            this.error(
                "LYS-SEM0106",
                f"'{name}' needs {missing.toArray().join(", ")}: no default gives them",
                at
            );
        }
        return out.toArray();
    }

    mut fn ifExpr(cond: Expr, then: Expr, otherwise: Expr, expected: ?Ty, at: Span): TExpr {
        let c = this.condition(cond);
        let before = this.ctx.unassigned;
        this.pushScope();
        this.narrow(this.factsOf(c, true));
        let a = this.expr(then, expected);
        this.popScope();
        let afterThen = this.reached(a);
        this.ctx.unassigned = before;
        this.pushScope();
        this.narrow(this.factsOf(c, false));
        let b = this.expr(otherwise, expected);
        this.popScope();
        this.ctx.unassigned = afterThen.union(this.reached(b));
        let t = this.unify(typeOf(a), typeOf(b), at);
        return TExpr.If(boxE(c), boxE(this.coerce(a, t, at)), boxE(this.coerce(b, t, at)), t);
    }

    /// What a branch that gave `e` leaves unassigned: nothing where it never comes out.
    mut fn reached(e: TExpr): Set<int> {
        return if (typeOf(e) == .Never) Set<int>.new() else this.ctx.unassigned;
    }

    /// The type both branches give: the same one, `float` where one is `int`, the other where one
    /// never ends (`LYS-SEM0016` otherwise).
    mut fn unify(a: Ty, b: Ty, at: Span): Ty {
        if (a == b || b == .Never || b == .Unknown) {
            return a;
        }
        if (a == .Never || a == .Unknown) {
            return b;
        }
        if ((a == .Int && b == .Float) || (a == .Float && b == .Int)) {
            return Ty.Float;
        }
        // a value beside null, or beside an optional of it: the optional (`if (c) 1 else null`)
        if (a == .NullLit) {
            return match (b) {
                .Optional(_) => b,
                _ => Ty.Optional(boxTy(b)),
            };
        }
        if (b == .NullLit) {
            return match (a) {
                .Optional(_) => a,
                _ => Ty.Optional(boxTy(a)),
            };
        }
        match (a) {
            .Optional(inner) => {
                if (inner.value == b) {
                    return a;
                }
            }
            _ => { }
        }
        match (b) {
            .Optional(inner) => {
                if (inner.value == a) {
                    return b;
                }
            }
            _ => { }
        }
        this.error("LYS-SEM0016", f"the branches give {this.tyName(a)} and {this.tyName(b)}", at);
        return Ty.Unknown;
    }

    /// A block where a value stands: its last statement gives the value when it is an
    /// expression, or an `if` with an `else` (09 NL rule 6).
    mut fn valueBlock(b: Block, expected: ?Ty): TExpr {
        this.pushScope();
        let out = List<TStmt>.new();
        var value = TExpr.Unit;
        var k = 0;
        for (s in b.stmts) {
            let last = k == b.stmts.length() - 1;
            k += 1;
            if (last) {
                match (s) {
                    .Expr(e, _) => {
                        value = this.expr(e, expected);
                        continue;
                    }
                    .If(cond, then, otherwise, at) => {
                        if (otherwise != null) {
                            value = this.ifStmtValue(cond, then, otherwise.value, expected, at);
                            continue;
                        }
                    }
                    _ => { }
                }
            }
            out.push(this.stmt(s));
        }
        this.popScope();
        return TExpr.Block(out.toArray(), boxE(value), typeOf(value));
    }

    mut fn ifStmtValue(cond: Expr, then: Block, otherwise: Stmt, expected: ?Ty, at: Span): TExpr {
        let c = this.condition(cond);
        let before = this.ctx.unassigned;
        this.pushScope();
        this.narrow(this.factsOf(c, true));
        let a = this.valueBlock(then, expected);
        this.popScope();
        let afterThen = this.reached(a);
        this.ctx.unassigned = before;
        this.pushScope();
        this.narrow(this.factsOf(c, false));
        let b = match (otherwise) {
            .Block(ob, _) => this.valueBlock(ob, expected),
            .If(c2, t2, o2, at2) => {
                if (o2 != null) this.ifStmtValue(c2, t2, o2.value, expected, at2) else TExpr.Unit
            }
            _ => TExpr.Unit,
        };
        this.popScope();
        this.ctx.unassigned = afterThen.union(this.reached(b));
        let t = this.unify(typeOf(a), typeOf(b), at);
        return TExpr.If(boxE(c), boxE(this.coerce(a, t, at)), boxE(this.coerce(b, t, at)), t);
    }

    /// `f"…"`: its text and its holes as strings, joined.
    mut fn interpolated(segments: Segment[], at: Span): TExpr {
        let parts = List<TExpr>.new();
        for (seg in segments) {
            match (seg) {
                .Text(s) => {
                    if (s.length() > 0) {
                        parts.push(TExpr.Str(s));
                    }
                }
                .Hole(x, spec) => {
                    if (spec != null) {
                        parts.push(this.notYet("a format spec", "S7 (std.fmt)", at));
                    } else {
                        parts.push(this.stringOf(this.expr(x, null), spanOf(x)));
                    }
                }
            }
        }
        if (parts.length() == 0) {
            return TExpr.Str("");
        }
        if (parts.length() == 1 && typeOf(parts[0]) == .Str) {
            return parts[0];
        }
        return TExpr.Native(Native.Concat, parts.toArray(), Ty.Str);
    }

    /// A value as text, for `print`, `println` and the holes of an f-string.
    mut fn stringOf(v: TExpr, at: Span): TExpr {
        let t = typeOf(v);
        if (t == .Str || t == .Unknown) {
            return v;
        }
        let native: ?Native = match (t) {
            .Int => Native.IntToStr,
            .Float => Native.FloatToStr,
            .Bool => Native.BoolToStr,
            .Char => Native.CharToStr,
            _ => null,
        };
        if (native == null) {
            return this.notYet(f"text of a {this.tyName(t)}", "S3 (Display)", at);
        }
        return TExpr.Native(native, [v], Ty.Str);
    }

    // --- calls -----------------------------------------------------------------------------------

    mut fn call(callee: Expr, args: Arg[], expected: ?Ty, at: Span): TExpr {
        match (callee) {
            // `.Num(3)`: a variant of the enum the position expects
            .Implicit(name, nameAt) => {
                let i = this.expectedEnum(expected);
                if (i < 0) {
                    this.error(
                        "LYS-SEM0113",
                        f"'.{name}' needs an enum where it stands: name it, as E.{name}(…)",
                        nameAt
                    );
                    return TExpr.Unknown;
                }
                let k = this.variantIndex(i, name);
                if (k < 0) {
                    this.error(
                        "LYS-SEM0012",
                        f"'{this.types[i].name}' has no variant '{name}'",
                        nameAt
                    );
                    return TExpr.Unknown;
                }
                return this.variantCall(i, k, args, at);
            }
            .Name(name, nameAt) => {
                if (this.lookupLocal(name) != null || this.globalIndex.containsKey(name)) {
                    return this.notYet("a call through a value", "S3 (function values)", nameAt);
                }
                let candidates = this.fnByName.get(name);
                if (candidates != null) {
                    return this.callAmong(name, candidates.toArray(), null, args, at);
                }
                if (name == "print" || name == "println") {
                    return this.prelude(name, args, at);
                }
                let index = this.typeIndex.get(name);
                if (index != null) {
                    // `Point(1, 2)` is `Point.new(1, 2)` (05 D11)
                    return this.staticCall(index, "new", args, at);
                }
                return this.name(name, nameAt);
            }
            .Member(object, method, optional, memberAt) => {
                if (optional) {
                    let held = this.optionalReceiver(object.value, memberAt);
                    if (held == null) {
                        return TExpr.Unknown;
                    }
                    let (o, tmp, inner) = held;
                    let present = TExpr.Narrow(boxE(TExpr.Local(tmp, typeOf(o))), inner);
                    // the arguments may not be evaluated: what they assign does not count
                    let before = this.ctx.unassigned;
                    let access = this.methodCall(present, method, args, at, memberAt);
                    this.ctx.unassigned = before;
                    return this.optChain(tmp, o, access, at);
                }
                match (object.value) {
                    .Name(typeName, _) => {
                        if (this.lookupLocal(typeName) == null
                            && !this.globalIndex.containsKey(typeName)) {
                            let index = this.typeIndex.get(typeName);
                            if (index != null) {
                                return this.staticCall(index, method, args, at);
                            }
                        }
                    }
                    _ => { }
                }
                return this.methodCall(this.expr(object.value, null), method, args, at, memberAt);
            }
            _ => { }
        }
        this.expr(callee, null);
        return this.notYet("a call through a value", "S3 (function values)", at);
    }

    /// A method called on a value: one of its type's, not static.
    mut fn methodCall(
        receiver: TExpr,
        method: string,
        args: Arg[],
        at: Span,
        memberAt: Span
    ): TExpr {
        let t = typeOf(receiver);
        match (t) {
            .Unknown => {
                return TExpr.Unknown;
            }
            .Named(i) => {
                let m = this.types[i].methods.get(method);
                if (m == null) {
                    this.error(
                        "LYS-SEM0012",
                        f"'{this.types[i].name}' has no method '{method}'",
                        memberAt
                    );
                    return TExpr.Unknown;
                }
                if (this.functions[m].isStatic) {
                    this.error(
                        "LYS-SEM0074",
                        f"'{method}' is static: call it as {this.types[i].name}.{method}(…)",
                        memberAt
                    );
                    return TExpr.Unknown;
                }
                return this.callAmong(method, [m], receiver, args, at);
            }
            _ => {
                return this.notYet(
                    f"the methods of {this.tyName(t)}",
                    "S7 (the core library)",
                    memberAt
                );
            }
        }
    }

    mut fn staticCall(typeIndex: int, method: string, args: Arg[], at: Span): TExpr {
        let info = this.types[typeIndex];
        // `Shape.Num(3)`: a variant with a payload by position
        let k = this.variantIndex(typeIndex, method);
        if (k >= 0) {
            return this.variantCall(typeIndex, k, args, at);
        }
        let m = info.methods.get(method);
        if (m == null) {
            if (method == "new") {
                this.error(
                    "LYS-SEM0012",
                    f"'{info.name}' has no 'new': write {info.name} {{ … }}, or declare static fn new",
                    at
                );
            } else {
                this.error("LYS-SEM0012", f"'{info.name}' has no member '{method}'", at);
            }
            return TExpr.Unknown;
        }
        if (!this.functions[m].isStatic) {
            this.error("LYS-SEM0055", f"'{method}' needs a {info.name} to call it on", at);
            return TExpr.Unknown;
        }
        return this.callAmong(method, [m], null, args, at);
    }

    /// Picks the function of `candidates` that takes as many arguments as the call gives (Lyric 5
    /// §8.1.2) and checks the arguments against its parameters.
    mut fn callAmong(
        name: string,
        candidates: int[],
        receiver: ?TExpr,
        args: Arg[],
        at: Span
    ): TExpr {
        var chosen = -1;
        for (c in candidates) {
            let params = this.functions[c].params;
            var required = 0;
            for (p in params) {
                if (p.default == null) {
                    required += 1;
                }
            }
            if (args.length() >= required && args.length() <= params.length()) {
                chosen = c;
            }
        }
        if (chosen < 0) {
            if (candidates.length() == 1) {
                let n = this.functions[candidates[0]].params.length();
                this.error("LYS-SEM0014", f"'{name}' takes {n} arguments, not {args.length()}", at);
            } else {
                this.error(
                    "LYS-SEM0087",
                    f"no function '{name}' takes {args.length()} arguments",
                    at
                );
            }
            for (a in args) {
                this.expr(a.value, null);
            }
            return TExpr.Unknown;
        }
        let params = this.functions[chosen].params;
        let given = List<?TExpr>.new();
        for (_ in params) {
            given.push(null);
        }
        var position = 0;
        var named = false;
        for (a in args) {
            let argName = a.name;
            var k = position;
            if (argName != null) {
                named = true;
                k = -1;
                var j = 0;
                for (p in params) {
                    if (p.name == argName) {
                        k = j;
                    }
                    j += 1;
                }
                if (k < 0) {
                    this.error(
                        "LYS-SEM0119",
                        f"'{name}' has no parameter '{argName}'",
                        spanOf(a.value)
                    );
                    continue;
                }
            } else {
                if (named) {
                    this.error(
                        "LYS-SEM0119",
                        "a positional argument after a named one",
                        spanOf(a.value)
                    );
                    continue;
                }
                position += 1;
            }
            if (given[k] != null) {
                this.error("LYS-SEM0119", f"'{params[k].name}' is given twice", spanOf(a.value));
                continue;
            }
            given[k] = this.coerce(this.expr(a.value, params[k].ty), params[k].ty, spanOf(a.value));
        }
        let out = List<TExpr>.new();
        if (receiver != null) {
            out.push(receiver);
        }
        var k = 0;
        for (p in params) {
            let v = given[k];
            let dflt = p.default;
            if (v != null) {
                out.push(v);
            } else if (dflt != null) {
                out.push(dflt);
            } else {
                this.error("LYS-SEM0014", f"'{name}' needs its argument '{p.name}'", at);
                out.push(TExpr.Unknown);
            }
            k += 1;
        }
        return TExpr.Call(chosen, out.toArray(), this.returnsOf(chosen, at));
    }

    /// `print(x)` and `println(x)`, `println()`: the prelude's output, any core value as text.
    mut fn prelude(name: string, args: Arg[], at: Span): TExpr {
        let native = if (name == "print") Native.Print else Native.Println;
        if (args.length() > 1 || (args.length() == 1 && args[0].name != null)) {
            this.error("LYS-SEM0014", f"'{name}' takes one value, or none", at);
            return TExpr.Unknown;
        }
        if (args.length() == 0) {
            return TExpr.Native(native, [TExpr.Str("")], Ty.Void);
        }
        let v = this.expr(args[0].value, null);
        return TExpr.Native(native, [this.stringOf(v, spanOf(args[0].value))], Ty.Void);
    }
}

fn boxE(e: TExpr): Box<TExpr> {
    return Box<TExpr> { value = e };
}

fn boxTy(t: Ty): Box<Ty> {
    return Box<Ty> { value = t };
}

/// Whether every path through the statements ends: in a `return`, or a `loop` without a break.
fn endsAll(stmts: TStmt[]): bool {
    if (stmts.length() == 0) {
        return false;
    }
    return ends(stmts[stmts.length() - 1]);
}

/// Whether control never comes out of the end of `stmts` to what follows them: they return,
/// break, continue or give `never` (Lyric 5 §3.2 rule 3, §7.1 rule 5).
fn leavesAll(stmts: TStmt[]): bool {
    if (stmts.length() == 0) {
        return false;
    }
    return leaves(stmts[stmts.length() - 1]);
}

fn leaves(s: TStmt): bool {
    return match (s) {
        .Break(_, _) | .Continue(_) => true,
        .If(_, then, otherwise, _) => leavesAll(then) && leavesAll(otherwise),
        .Block(stmts, _) => leavesAll(stmts),
        _ => ends(s),
    };
}

fn ends(s: TStmt): bool {
    return match (s) {
        .Return(_, _) => true,
        .If(_, then, otherwise, _) => endsAll(then) && endsAll(otherwise),
        .Block(stmts, _) => endsAll(stmts),
        .Expr(e, _) => typeOf(e) == .Never,
        _ => false,
    };
}

fn isBuiltinType(name: string): bool {
    return match (name) {
        "int" | "float" | "bool" | "char" | "string" | "void" | "never" | "List" | "Map" => true,
        _ => isWidthType(name),
    };
}

fn isWidthType(name: string): bool {
    return match (name) {
        "int8" | "int16" | "int32" | "int64" | "uint" | "uint8" | "uint16" | "uint32" | "uint64" => true,
        "float32" | "float64" => true,
        _ => false,
    };
}

fn itemLine(item: Item): int {
    return match (item) {
        .Stmt(s) => stmtSpan(s).line,
        .Decl(d) => match (d) {
            .Fn(f) => f.span.line,
            .Type(t) => t.span.line,
            .Enum(e) => e.span.line,
            .Alias(a) => a.span.line,
        },
    };
}

fn stmtSpan(s: Stmt): Span {
    return match (s) {
        .Expr(_, at) => at,
        .Let(_, _, _, _, at) => at,
        .Destructure(_, _, _, at) => at,
        .If(_, _, _, at) => at,
        .While(_, _, _, at) => at,
        .For(_, _, _, _, at) => at,
        .Break(_, _, at) => at,
        .Continue(_, at) => at,
        .Return(_, at) => at,
        .Block(_, at) => at,
        .IfLet(_, _, _, _, at) => at,
        .WhileLet(_, _, _, _, at) => at,
    };
}

/// Whether any of `stmts`, from `from` on, writes the binding `name` (a loop that writes a
/// narrowed binding has it narrowed in none of its turns).
fn writesIn(stmts: Stmt[], from: int, name: string): bool {
    var k = from;
    while (k < stmts.length()) {
        if (stmtAny(stmts[k], (_: Stmt) => false, (e: Expr) => assigns(e, name))) {
            return true;
        }
        k += 1;
    }
    return false;
}

/// Whether `e` is an assignment to the name `name` itself.
fn assigns(e: Expr, name: string): bool {
    return match (e) {
        .Assign(target, _, _, _) => {
            match (target.value) {
                .Name(n, _) => n == name,
                _ => false,
            }
        }
        _ => false,
    };
}

/// Whether one of `stmts`, or a statement in a block in them, is `var x = null`: its function
/// takes two passes (03 Leer).
fn declaresNull(stmts: Stmt[]): bool {
    for (s in stmts) {
        if (stmtAny(s, (t: Stmt) => isNullVar(t), (_: Expr) => false)) {
            return true;
        }
    }
    return false;
}

fn fnDeclaresNull(decl: FnDecl): bool {
    return match (decl.body) {
        .Block(b) => declaresNull(b.stmts),
        .Expr(e) => exprAny(e, (t: Stmt) => isNullVar(t), (_: Expr) => false),
    };
}

fn isNullVar(s: Stmt): bool {
    match (s) {
        .Let(isVar, _, written, value, _) => {
            if (isVar && written == null && value != null) {
                return isNullLit(value);
            }
        }
        _ => { }
    }
    return false;
}

fn isNullLit(e: Expr): bool {
    return match (e) {
        .Null(_) => true,
        _ => false,
    };
}

/// A name a pattern binds, and the part of the matched value it holds.
struct Bound {
    name: string,
    value: TExpr,
    at: Span,
}

fn boundNamed(bounds: List<Bound>, name: string): ?TExpr {
    for (b in bounds) {
        if (b.name == name) {
            return b.value;
        }
    }
    return null;
}

fn andOf(a: TExpr, b: TExpr): TExpr {
    return TExpr.Binary(boxE(a), BinaryOp.And, boxE(b), Ty.Bool);
}

/// Both tests; a missing one tests nothing.
fn andMaybe(a: ?TExpr, b: ?TExpr): ?TExpr {
    if (a == null) {
        return b;
    }
    if (b == null) {
        return a;
    }
    return andOf(a, b);
}

/// That the optional `src` holds a value, and then `test`.
fn presentAnd(src: TExpr, test: ?TExpr): TExpr {
    let present = TExpr.Unary(UnaryOp.Not, boxE(TExpr.IsNull(boxE(src))), Ty.Bool);
    return if (test != null) andOf(present, test) else present;
}

/// Whether `e` names a member of the enum its position expects: `.Red`, `.Num(3)`, `.Rect { … }`.
fn isImplicit(e: Expr): bool {
    return match (e) {
        .Implicit(_, _) | .VariantInit(_, _, _, _) => true,
        .Call(callee, _, _) => isImplicit(callee.value),
        _ => false,
    };
}

/// The tuple of `n` elements `expected` is, or holds as an optional; `null` where it is none.
fn expectedTuple(expected: ?Ty, n: int): ?TupleTy {
    if (expected == null) {
        return null;
    }
    let t = match (expected) {
        .Optional(inner) => inner.value,
        _ => expected,
    };
    return match (t) {
        .Tuple(tt) => if (tt.elements.length() == n) tt else null,
        _ => null,
    };
}

/// The position `t.0` names: its digits as a number, -1 where it is no number (or no position a
/// tuple could have).
fn positionOf(name: string): int {
    var n = 0;
    for (c in name.chars()) {
        let d = c.toDigit(10);
        if (d == null || n > 1000) {
            return -1;
        }
        n = n * 10 + d;
    }
    return n;
}

/// `s` and `id` in it, as a new set: the sets of what is unassigned are never changed in place.
fn withId(s: Set<int>, id: int): Set<int> {
    let out = s.union(Set<int>.new());
    out.insert(id);
    return out;
}

fn withoutId(s: Set<int>, id: int): Set<int> {
    if (!s.contains(id)) {
        return s;
    }
    let out = s.union(Set<int>.new());
    out.remove(id);
    return out;
}

/// Whether `onStmt` holds of `s` or of a statement in it, or `onExpr` of an expression in it: the
/// one walk over the children of a statement.
fn stmtAny(s: Stmt, onStmt: fn(Stmt) -> bool, onExpr: fn(Expr) -> bool): bool {
    if (onStmt(s)) {
        return true;
    }
    return match (s) {
        .Expr(e, _) => exprAny(e, onStmt, onExpr),
        .Let(_, _, _, v, _) => v != null && exprAny(v, onStmt, onExpr),
        .Destructure(_, _, v, _) => exprAny(v, onStmt, onExpr),
        .If(c, then, o, _) => exprAny(c, onStmt, onExpr)
            || blockAny(then, onStmt, onExpr)
            || (o != null && stmtAny(o.value, onStmt, onExpr)),
        .While(c, b, _, _) => exprAny(c, onStmt, onExpr) || blockAny(b, onStmt, onExpr),
        .For(_, it, b, _, _) => exprAny(it, onStmt, onExpr) || blockAny(b, onStmt, onExpr),
        .Break(_, v, _) => v != null && exprAny(v, onStmt, onExpr),
        .Continue(_, _) => false,
        .Return(v, _) => v != null && exprAny(v, onStmt, onExpr),
        .Block(b, _) => blockAny(b, onStmt, onExpr),
        .IfLet(_, v, b, o, _) => exprAny(v, onStmt, onExpr)
            || blockAny(b, onStmt, onExpr)
            || (o != null && stmtAny(o.value, onStmt, onExpr)),
        .WhileLet(_, v, b, _, _) => exprAny(v, onStmt, onExpr) || blockAny(b, onStmt, onExpr),
    };
}

fn blockAny(b: Block, onStmt: fn(Stmt) -> bool, onExpr: fn(Expr) -> bool): bool {
    for (s in b.stmts) {
        if (stmtAny(s, onStmt, onExpr)) {
            return true;
        }
    }
    return false;
}

fn exprAny(e: Expr, onStmt: fn(Stmt) -> bool, onExpr: fn(Expr) -> bool): bool {
    if (onExpr(e)) {
        return true;
    }
    return match (e) {
        .Assign(target, _, value, _) => exprAny(target.value, onStmt, onExpr)
            || exprAny(value.value, onStmt, onExpr),
        .Unary(_, x, _) => exprAny(x.value, onStmt, onExpr),
        .Binary(l, _, r, _) => exprAny(l.value, onStmt, onExpr) || exprAny(r.value, onStmt, onExpr),
        .Range(a, b, _, _) => exprAny(a.value, onStmt, onExpr) || exprAny(b.value, onStmt, onExpr),
        .Cast(x, _, _) => exprAny(x.value, onStmt, onExpr),
        .Call(c, args, _) => {
            var found = exprAny(c.value, onStmt, onExpr);
            for (a in args) {
                found = found || exprAny(a.value, onStmt, onExpr);
            }
            found
        }
        .Index(x, i, _) => exprAny(x.value, onStmt, onExpr) || exprAny(i.value, onStmt, onExpr),
        .Member(x, _, _, _) => exprAny(x.value, onStmt, onExpr),
        .List(items, _) => {
            var found = false;
            for (x in items) {
                found = found || exprAny(x, onStmt, onExpr);
            }
            found
        }
        .Map(entries, _) => {
            var found = false;
            for (en in entries) {
                found = found
                    || exprAny(en.key, onStmt, onExpr)
                    || exprAny(en.value, onStmt, onExpr);
            }
            found
        }
        .StructInit(_, fields, _) => {
            var found = false;
            for (f in fields) {
                found = found || exprAny(f.value, onStmt, onExpr);
            }
            found
        }
        .Interpolated(segments, _) => {
            var found = false;
            for (seg in segments) {
                match (seg) {
                    .Hole(x, _) => found = found || exprAny(x, onStmt, onExpr),
                    .Text(_) => { }
                }
            }
            found
        }
        .If(c, a, b, _) => exprAny(c.value, onStmt, onExpr)
            || exprAny(a.value, onStmt, onExpr)
            || exprAny(b.value, onStmt, onExpr),
        .Block(b, _) => blockAny(b, onStmt, onExpr),
        .Loop(b, _, _) => blockAny(b, onStmt, onExpr),
        .Unwrap(x, _) => exprAny(x.value, onStmt, onExpr),
        .Tuple(items, _) => {
            var found = false;
            for (x in items) {
                found = found || exprAny(x, onStmt, onExpr);
            }
            found
        }
        .VariantInit(_, _, fields, _) => {
            var found = false;
            for (f in fields) {
                found = found || exprAny(f.value, onStmt, onExpr);
            }
            found
        }
        .Match(x, arms, _) => {
            var found = exprAny(x.value, onStmt, onExpr);
            for (arm in arms) {
                let g = arm.guard;
                found = found
                    || (g != null && exprAny(g, onStmt, onExpr))
                    || exprAny(arm.body, onStmt, onExpr);
            }
            found
        }
        _ => false,
    };
}

/// Where an expression stands.
fn spanOf(e: Expr): Span {
    return match (e) {
        .Int(_, at) => at,
        .Float(_, at) => at,
        .Bool(_, at) => at,
        .Char(_, at) => at,
        .Str(_, at) => at,
        .Bytes(_, at) => at,
        .Interpolated(_, at) => at,
        .Null(at) => at,
        .Name(_, at) => at,
        .This(at) => at,
        .Unary(_, _, at) => at,
        .Binary(_, _, _, at) => at,
        .Assign(_, _, _, at) => at,
        .Range(_, _, _, at) => at,
        .Cast(_, _, at) => at,
        .Call(_, _, at) => at,
        .Index(_, _, at) => at,
        .Member(_, _, _, at) => at,
        .List(_, at) => at,
        .Map(_, at) => at,
        .StructInit(_, _, at) => at,
        .If(_, _, _, at) => at,
        .Block(_, at) => at,
        .Loop(_, _, at) => at,
        .Unwrap(_, at) => at,
        .Tuple(_, at) => at,
        .Implicit(_, at) => at,
        .VariantInit(_, _, _, at) => at,
        .Match(_, _, at) => at,
    };
}
