//! What the compiler reports: a code from the catalog (`diagnostics.toml`), a message and where
//! it stands. Errors and warnings are kept apart by the list that holds them.

/// One finding: its code, its message, and its place as byte offsets into the source and the
/// line and column (from 1) of its start.
pub struct Diagnostic :: [Debug] {
    pub code: string,
    pub message: string,
    pub start: int,
    pub end: int,
    pub line: int,
    pub column: int,
}
