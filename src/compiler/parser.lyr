//! The parser (spec chapter 2): one module's tokens to its syntax tree. Recursive descent for the
//! declarations and the statements, binding powers for the operators — Lyric 5's table. A line
//! end is a token only where it ends a statement (spec 1 D1), so the parser reads it as Lyric 5's
//! reads `;`. A fault is reported where it stands and gives up the statement at hand
//! (`SyntaxError`); the parse goes on with the next statement.
//!
//! A code means what Lyric 5's `LYR-PAR` code of the same number means; Lyric-Script's own start
//! at 0900.
import std.collections { List };
import lyric_script.compiler.ast {
    AliasDecl,
    Arg,
    AssocDecl,
    FixedAnswer,
    BinaryOp,
    Block,
    CatchClause,
    Conformance,
    Decl,
    EnumDecl,
    Expr,
    ExtendDecl,
    FieldDecl,
    FieldInit,
    FieldPattern,
    FnBody,
    FnDecl,
    InterfaceDecl,
    ImportDecl,
    ImportItem,
    Item,
    MapEntry,
    LambdaParam,
    MatchArm,
    Module,
    Param,
    Pattern,
    Segment,
    Span,
    StaticLet,
    Stmt,
    TypeAnswer,
    TypeDecl,
    TypeParam,
    ThrowsClause,
    TypeExpr,
    UnaryOp,
    Variant,
    WithField,
};
import lyric_script.compiler.diagnostic { Diagnostic };
import lyric_script.compiler.lexer { lex, lexRange };
import lyric_script.compiler.literal {
    bytesValue,
    charValue,
    floatValue,
    intValue,
    stringPieces,
    stringValue,
};
import lyric_script.compiler.token { Token, TokenKind };

/// What the parser made of a source: the module, and the lexer's and the parser's errors and
/// warnings.
struct Parsed {
    module: Module,
    errors: Diagnostic[],
    warnings: Diagnostic[],
}

/// How deeply expressions, blocks and prefix operators may nest before the parse refuses
/// (`LYS-PAR0045`). The parser recurses on whatever stack its caller has, a task's among them; on
/// a test's task it reached 90 levels of parentheses and overflowed at 95 (S2c, measured), so 64
/// leaves room (Lyric 5's floor of 128 is a thread's).
let maxNesting: int = 64;

/// Reads `source`, the program's file `file`, into its syntax tree: its spans and its diagnostics
/// name the file (S5a) — 0 the entry, -1 the prelude.
fn parse(source: string, file: int = 0): Parsed {
    let lexed = lex(source);
    let p = Parser.new(source, lexed.tokens);
    p.file = file;
    let module = p.parseModule();
    let errors = List<Diagnostic>.new();
    for (d in lexed.errors) {
        errors.push(d with { file = file });
    }
    for (d in p.errors) {
        errors.push(d with { file = file });
    }
    let warnings = List<Diagnostic>.new();
    for (d in lexed.warnings) {
        warnings.push(d with { file = file });
    }
    for (d in p.warnings) {
        warnings.push(d with { file = file });
    }
    return Parsed { module = module, errors = errors.toArray(), warnings = warnings.toArray() };
}

/// Gives up the statement at hand; its fault is reported already.
pub struct SyntaxError :: [Error] {
    /// The same text for every fault: each is reported where it stands, before this is thrown.
    pub fn message(): string {
        return "a syntax error";
    }
}

class Parser {
    source: string,
    tokens: Token[],
    errors: List<Diagnostic>,
    warnings: List<Diagnostic>,
    var pos: int = 0,
    var depth: int = 0,
    // a `>>` of which one `>` closed type arguments, the other still to read
    var halfShr: bool = false,
    // in a match arm's guard, which a `=>` ends: no lambda begins there (Lyric 5 does likewise)
    var inGuard: bool = false,
    // in an interface's body, where a member without a body is abstract
    var inInterface: bool = false,
    // the program's file this one is (S5a)
    var file: int = 0,
    // the labels of the loops around, "" for one without (07 §1 rule 3), and the label written
    // before the loop the parser is about to read
    var loopLabels: List<string> = List<string>.new(),
    var pendingLabel: ?string = null,

    static fn new(source: string, tokens: Token[]): Parser {
        return Parser {
            source = source,
            tokens = tokens,
            errors = List<Diagnostic>.new(),
            warnings = List<Diagnostic>.new(),
        };
    }

    // --- tokens --------------------------------------------------------------------------------

    mut fn peek(ahead: int): Token {
        let k = this.pos + ahead;
        return if (k < this.tokens.length()) this.tokens[k]
            else this.tokens[this.tokens.length() - 1];
    }

    mut fn current(): Token {
        return this.peek(0);
    }

    mut fn at(kind: TokenKind): bool {
        return this.current().kind == kind;
    }

    mut fn text(t: Token): string {
        return this.source[t.start..t.end].toString();
    }

    /// Whether `t` is the word `w`, reserved or contextual.
    mut fn isWord(t: Token, w: string): bool {
        return (t.kind == .Keyword || t.kind == .Ident) && this.text(t) == w;
    }

    mut fn atWord(w: string): bool {
        return this.isWord(this.current(), w);
    }

    mut fn advance(): Token {
        let t = this.current();
        if (t.kind != .Eof) {
            this.pos += 1;
        }
        return t;
    }

    mut fn spanOf(t: Token): Span {
        return Span {
            start = t.start,
            end = t.end,
            line = t.line,
            column = t.column,
            file = this.file,
        };
    }

    /// From `first` to the last token read.
    mut fn since(first: Token): Span {
        let last = this.tokens[if (this.pos > 0) this.pos - 1 else 0];
        return Span {
            start = first.start,
            end = last.end,
            line = first.line,
            column = first.column,
            file = this.file,
        };
    }

    mut fn shown(t: Token): string {
        return match (t.kind) {
            .Newline => "the end of the line",
            .Eof => "the end of the file",
            _ => f"'{this.text(t)}'",
        };
    }

    mut fn report(code: string, message: string, t: Token): void {
        this.errors.push(
            Diagnostic {
                code = code,
                message = message,
                start = t.start,
                end = t.end,
                line = t.line,
                column = t.column,
                help = null,
            }
        );
    }

    /// Reports a fault and returns what gives up the statement: `throw this.failure(…)`.
    mut fn failure(code: string, message: string, t: Token): SyntaxError {
        this.report(code, message, t);
        return SyntaxError { };
    }

    mut fn expect(kind: TokenKind, code: string, what: string): Token throws SyntaxError {
        if (this.at(kind)) {
            return this.advance();
        }
        let t = this.current();
        throw this.failure(code, f"expected {what}, found {this.shown(t)}", t);
    }

    mut fn skipNewlines(): void {
        while (this.at(.Newline)) {
            this.advance();
        }
    }

    mut fn skipTerminators(): void {
        while (this.at(.Newline) || this.at(.Semi)) {
            this.advance();
        }
    }

    mut fn atStatementEnd(): bool {
        let k = this.current().kind;
        return k == .Newline || k == .Semi || k == .RBrace || k == .Eof;
    }

    /// After a statement: a line end or `;`, or the `}` or the end of the file that closes it.
    mut fn endStatement(): void throws SyntaxError {
        if (this.at(.Newline) || this.at(.Semi)) {
            this.advance();
            return;
        }
        if (this.at(.RBrace) || this.at(.Eof)) {
            return;
        }
        let t = this.current();
        throw this.failure(
            "LYS-PAR0001",
            f"{this.shown(t)} after a whole statement: a line end or ';' ends it",
            t
        );
    }

    /// After a fault: on to the next statement — past a line end or `;` of this level, or up to
    /// the `}` that closes it.
    mut fn synchronize(): void {
        var level = 0;
        while (!this.at(.Eof)) {
            let k = this.current().kind;
            if (level == 0 && (k == .Newline || k == .Semi)) {
                this.advance();
                return;
            }
            if (level == 0 && k == .RBrace) {
                return;
            }
            if (k == .LBrace || k == .LParen || k == .LBracket) {
                level += 1;
            } else if ((k == .RBrace || k == .RParen || k == .RBracket) && level > 0) {
                level -= 1;
            }
            this.advance();
        }
    }

    mut fn enter(t: Token): void throws SyntaxError {
        this.depth += 1;
        if (this.depth > maxNesting) {
            this.depth -= 1;
            throw this.failure(
                "LYS-PAR0045",
                f"nesting deeper than {maxNesting}: the parser stops here",
                t
            );
        }
    }

    // --- the module and its declarations ---------------------------------------------------------

    mut fn parseModule(): Module {
        var frontmatter: ?string = null;
        if (this.at(.Frontmatter)) {
            frontmatter = frontmatterText(this.text(this.advance()));
        }
        let items = List<Item>.new();
        this.skipTerminators();
        while (!this.at(.Eof)) {
            try {
                items.push(this.parseItem());
                this.endStatement();
            } catch (_: SyntaxError) {
                this.synchronize();
            }
            if (this.at(.RBrace)) {
                this.report("LYS-PAR0001", "a '}' that closes nothing", this.current());
                this.advance();
            }
            this.skipTerminators();
        }
        return Module { frontmatter = frontmatter, items = items.toArray(), text = this.source };
    }

    mut fn parseItem(): Item throws SyntaxError {
        let first = this.current();
        // visible beyond its file unless `private` (02 V); `pub` and `internal` are taken
        var isPub = true;
        var worded = false;
        var inPackage = false;
        if (this.atWord("pub") || this.atWord("internal") || this.atWord("private")) {
            isPub = !this.atWord("private");
            worded = this.atWord("pub");
            inPackage = this.atWord("internal");
            this.advance();
        }
        if (this.atWord("import")) {
            return Item.Decl(Decl.Import(try this.parseImport(worded, first)));
        }
        if (this.atWord("fn")) {
            let f = try this.parseFn(isPub, false, first);
            return Item.Decl(Decl.Fn(f with { isInternal = inPackage }));
        }
        if (this.atWord("struct") || this.atWord("class")) {
            let t = try this.parseTypeDecl(isPub, first);
            return Item.Decl(Decl.Type(t with { isInternal = inPackage }));
        }
        if (this.atWord("enum")) {
            let e = try this.parseEnum(isPub, first);
            return Item.Decl(Decl.Enum(e with { isInternal = inPackage }));
        }
        if (this.atWord("type") && this.peek(1).kind == .Ident) {
            let a = try this.parseAlias(isPub, first);
            return Item.Decl(Decl.Alias(a with { isInternal = inPackage }));
        }
        // `sealed` is a word only before `interface`
        if (this.atWord("interface")
            || (this.atWord("sealed") && this.isWord(this.peek(1), "interface"))) {
            let i = try this.parseInterface(isPub, first);
            return Item.Decl(Decl.Interface(i with { isInternal = inPackage }));
        }
        if (this.atWord("extend") && (this.peek(1).kind == .Ident || this.peek(1).kind == .Lt)) {
            return Item.Decl(Decl.Extend(try this.parseExtend(first)));
        }
        if (this.pos > 0 && this.tokens[this.pos - 1].start == first.start) {
            throw this.failure(
                "LYS-PAR0053",
                "a visibility word before something that is no declaration",
                first
            );
        }
        return Item.Stmt(try this.parseStmt());
    }

    /// `import a.b { x, y as z }`, `import a.b`, `import a.b as c` (Lyric 5 04 §4 rule 1).
    mut fn parseImport(isPub: bool, first: Token): ImportDecl throws SyntaxError {
        this.advance();
        let path = List<string>.new();
        path.push(this.text(try this.expect(.Ident, "LYS-PAR0026", "the module's path")));
        while (this.at(.Dot)) {
            this.advance();
            path.push(this.text(try this.expect(.Ident, "LYS-PAR0026", "the module's path")));
        }
        let items = List<ImportItem>.new();
        var selective = false;
        var alias: ?string = null;
        if (this.at(.LBrace)) {
            this.advance();
            selective = true;
            this.skipNewlines();
            while (!this.at(.RBrace)) {
                let name = try this.expect(.Ident, "LYS-PAR0026", "a name the module declares");
                var renamed: ?string = null;
                if (this.atWord("as")) {
                    this.advance();
                    renamed = this.text(
                        try this.expect(.Ident, "LYS-PAR0026", "the name after 'as'")
                    );
                }
                items.push(
                    ImportItem { name = this.text(name), alias = renamed, span = this.since(name) }
                );
                this.skipNewlines();
                if (!this.at(.Comma)) {
                    break;
                }
                this.advance();
                this.skipNewlines();
            }
            try this.expect(.RBrace, "LYS-PAR0018", "'}' after the imported names");
        } else if (this.atWord("as")) {
            this.advance();
            alias = this.text(try this.expect(.Ident, "LYS-PAR0026", "the name after 'as'"));
        }
        return ImportDecl {
            path = path.toArray(),
            items = items.toArray(),
            selective = selective,
            alias = alias,
            isPub = isPub,
            span = this.since(first),
        };
    }

    /// `fn name(params): T { … }` or `fn name(params) = expr` (09 Ret).
    mut fn parseFn(isPub: bool, isStatic: bool, first: Token): FnDecl throws SyntaxError {
        this.advance();
        let name = try this.expect(.Ident, "LYS-PAR0026", "a function's name");
        var typeParams: TypeParam[] = [];
        if (this.at(.Lt)) {
            typeParams = try this.parseTypeParams();
        }
        let params = try this.parseParams();
        var returns: ?TypeExpr = null;
        if (this.at(.Colon)) {
            this.advance();
            returns = try this.parseType();
        }
        var throws: ?ThrowsClause = null;
        if (this.atWord("throws")) {
            throws = try this.parseThrows();
        }
        let body = if (this.at(.Assign)) {
            this.advance();
            FnBody.Expr(try this.parseExpr())
        } else if (this.inInterface && !this.at(.LBrace)) {
            FnBody.None
        } else {
            this.skipNewlines();
            FnBody.Block(try this.parseBlock())
        };
        return FnDecl {
            name = this.text(name),
            typeParams = typeParams,
            params = params,
            returns = returns,
            body = body,
            isPub = isPub,
            isStatic = isStatic,
            span = this.since(first),
            throws = throws,
        };
    }

    /// `throws E`, `throws [A, B]`, or the bare `throws` before the body or a line end; several
    /// types stand in brackets (Lyric 5 06 §2 rule 1).
    mut fn parseThrows(): ThrowsClause throws SyntaxError {
        let first = this.advance();
        let types = List<TypeExpr>.new();
        if (this.at(.LBracket)) {
            this.advance();
            loop {
                types.push(try this.parseType());
                if (!this.at(.Comma)) {
                    break;
                }
                this.advance();
            }
            try this.expect(.RBracket, "LYS-PAR0004", "']' after the thrown types");
        } else if (!this.at(.LBrace)
            && !this.at(.Assign)
            && !this.at(.Newline)
            && !this.at(.RBrace)
            && !this.at(.Eof)) {
            types.push(try this.parseType());
            if (this.at(.Comma)) {
                this.report(
                    "LYS-PAR0049",
                    "several thrown types stand in brackets: 'throws [A, B]'",
                    this.peek(0)
                );
                while (this.at(.Comma)) {
                    this.advance();
                    types.push(try this.parseType());
                }
            }
        }
        return ThrowsClause { types = types.toArray(), span = this.since(first) };
    }

    mut fn parseParams(): Param[] throws SyntaxError {
        try this.expect(.LParen, "LYS-PAR0008", "'(' before the parameters");
        let params = List<Param>.new();
        while (!this.at(.RParen)) {
            let pt = try this.expect(.Ident, "LYS-PAR0026", "a parameter's name");
            try this.expect(.Colon, "LYS-PAR0031", "':' before the parameter's type");
            let ty = try this.parseType();
            var dflt: ?Expr = null;
            if (this.at(.Assign)) {
                this.advance();
                dflt = try this.parseExpr();
            }
            params.push(
                Param { name = this.text(pt), type = ty, default = dflt, span = this.since(pt) }
            );
            if (!this.at(.Comma)) {
                break;
            }
            this.advance();
        }
        try this.expect(.RParen, "LYS-PAR0008", "')' after the parameters");
        return params.toArray();
    }

    /// `struct Name { fields and methods }`, `class Name { … }`: members end at `,` or a line end.
    mut fn parseTypeDecl(isPub: bool, first: Token): TypeDecl throws SyntaxError {
        let isClass = this.atWord("class");
        this.advance();
        let name = try this.expect(.Ident, "LYS-PAR0026", "the type's name");
        var typeParams: TypeParam[] = [];
        if (this.at(.Lt)) {
            typeParams = try this.parseTypeParams();
        }
        let conforms = try this.parseConformances(true);
        this.skipNewlines();
        try this.expect(.LBrace, "LYS-PAR0017", "'{' before the type's body");
        let fields = List<FieldDecl>.new();
        let methods = List<FnDecl>.new();
        let answers = List<TypeAnswer>.new();
        let statics = List<StaticLet>.new();
        loop {
            while (this.at(.Newline) || this.at(.Comma) || this.at(.Semi)) {
                this.advance();
            }
            if (this.at(.RBrace) || this.at(.Eof)) {
                break;
            }
            try {
                this.parseMember(fields, methods, answers, statics);
            } catch (_: SyntaxError) {
                this.synchronize();
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' to close the type's body");
        return TypeDecl {
            answers = answers.toArray(),
            statics = statics.toArray(),
            name = this.text(name),
            typeParams = typeParams,
            conforms = conforms,
            isClass = isClass,
            fields = fields.toArray(),
            methods = methods.toArray(),
            isPub = isPub,
            span = this.since(first),
        };
    }

    mut fn parseMember(
        fields: List<FieldDecl>,
        methods: List<FnDecl>,
        answers: List<TypeAnswer>,
        statics: List<StaticLet>
    ): void throws SyntaxError {
        let first = this.current();
        // `type Item = int`: the answer to an associated type (Lyric 5 05 §8 rule 3)
        if (this.atWord("type") && this.peek(1).kind == .Ident) {
            this.advance();
            let name = this.advance();
            try this.expect(.Assign, "LYS-PAR0037", "'=' and the type that answers it");
            let ty = try this.parseType();
            answers.push(
                TypeAnswer { name = this.text(name), type = ty, span = this.since(first) }
            );
            return;
        }
        // a member is seen where its type is unless `private` (02 V; Lyric 5 04 §3 rule 6)
        var isPub = true;
        var inPackage = false;
        if (this.atWord("pub") || this.atWord("internal") || this.atWord("private")) {
            isPub = !this.atWord("private");
            inPackage = this.atWord("internal");
            this.advance();
        }
        var isStatic = false;
        if (this.atWord("static")) {
            isStatic = true;
            this.advance();
        }
        if (this.atWord("fn")) {
            let f = try this.parseFn(isPub, isStatic, first);
            methods.push(f with { isInternal = inPackage });
            return;
        }
        // `static let zero: int = 0`: a constant of the type (05 §7 rule 2)
        if (isStatic && this.atWord("let")) {
            statics.push(try this.parseStaticLet(first));
            return;
        }
        var isVar = false;
        if (this.atWord("var")) {
            isVar = true;
            this.advance();
        }
        let name = try this.expect(.Ident, "LYS-PAR0026", "a field's name");
        try this.expect(.Colon, "LYS-PAR0031", "':' before the field's type");
        let ty = try this.parseType();
        var dflt: ?Expr = null;
        if (this.at(.Assign)) {
            this.advance();
            dflt = try this.parseExpr();
        }
        fields.push(
            FieldDecl {
                name = this.text(name),
                type = ty,
                default = dflt,
                isVar = isVar,
                isPub = isPub,
                isInternal = inPackage,
                span = this.since(first),
            }
        );
        if (!(this.at(.Comma) || this.at(.Newline) || this.at(.Semi) || this.at(.RBrace))) {
            let t = this.current();
            throw this.failure(
                "LYS-PAR0029",
                f"fields without ',' or a line end between them: found {this.shown(t)}",
                t
            );
        }
    }

    /// `enum Name { A, B, C }` with its methods after the variants, without `;` (a method starts
    /// with its words).
    mut fn parseEnum(isPub: bool, first: Token): EnumDecl throws SyntaxError {
        this.advance();
        let name = try this.expect(.Ident, "LYS-PAR0026", "the enum's name");
        var typeParams: TypeParam[] = [];
        if (this.at(.Lt)) {
            typeParams = try this.parseTypeParams();
        }
        let conforms = try this.parseConformances(false);
        this.skipNewlines();
        try this.expect(.LBrace, "LYS-PAR0017", "'{' before the enum's body");
        let variants = List<Variant>.new();
        let fields = List<FieldDecl>.new();
        let methods = List<FnDecl>.new();
        let answers = List<TypeAnswer>.new();
        let statics = List<StaticLet>.new();
        loop {
            while (this.at(.Newline) || this.at(.Comma) || this.at(.Semi)) {
                this.advance();
            }
            if (this.at(.RBrace) || this.at(.Eof)) {
                break;
            }
            try {
                if (this.at(.Ident) && !this.atWord("static")) {
                    let v = this.advance();
                    var positional: TypeExpr[] = [];
                    var payloadFields: FieldDecl[] = [];
                    var named = false;
                    if (this.at(.LParen)) {
                        positional = this.parsePayloadTypes();
                    } else if (this.at(.LBrace)) {
                        payloadFields = this.parsePayloadFields();
                        named = true;
                    }
                    variants.push(
                        Variant {
                            name = this.text(v),
                            positional = positional,
                            fields = payloadFields,
                            named = named,
                            span = this.since(v),
                        }
                    );
                    if (!(this.at(.Comma)
                        || this.at(.Newline)
                        || this.at(.Semi)
                        || this.at(.RBrace))) {
                        let t = this.current();
                        throw this.failure(
                            "LYS-PAR0001",
                            f"{this.shown(t)} after a variant: a variant is a name",
                            t
                        );
                    }
                } else {
                    this.parseMember(fields, methods, answers, statics);
                }
            } catch (_: SyntaxError) {
                this.synchronize();
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' to close the enum's body");
        for (f in fields) {
            this.report(
                "LYS-PAR0901",
                f"an enum holds variants and methods, no field: '{f.name}'",
                this.current()
            );
        }
        return EnumDecl {
            answers = answers.toArray(),
            statics = statics.toArray(),
            name = this.text(name),
            typeParams = typeParams,
            conforms = conforms,
            variants = variants.toArray(),
            methods = methods.toArray(),
            isPub = isPub,
            span = this.since(first),
        };
    }

    /// `type Name = T`.
    /// `<T, U :: [Show]>`: a declaration's type parameters and their constraints.
    mut fn parseTypeParams(): TypeParam[] throws SyntaxError {
        this.advance();
        let out = List<TypeParam>.new();
        while (!this.at(.Gt)) {
            let first = this.current();
            let name = try this.expect(.Ident, "LYS-PAR0026", "a type parameter's name");
            let constraints = try this.parseConformances(false);
            out.push(
                TypeParam {
                    name = this.text(name),
                    constraints = constraints,
                    span = this.since(first),
                }
            );
            if (!this.at(.Comma)) {
                break;
            }
            this.advance();
        }
        try this.expect(.Gt, "LYS-PAR0004", "'>' after the type parameters");
        return out.toArray();
    }

    /// `:: I`, `:: [I, J by field]`: the interfaces a type conforms to — one may stand bare,
    /// several stand in brackets; `by` only where `delegates` (a struct or a class).
    mut fn parseConformances(delegates: bool): Conformance[] throws SyntaxError {
        let out = List<Conformance>.new();
        if (!this.at(.ColonColon)) {
            return [];
        }
        this.advance();
        let bracketed = this.at(.LBracket);
        if (bracketed) {
            this.advance();
        }
        loop {
            let first = this.current();
            let name = try this.expect(.Ident, "LYS-PAR0026", "an interface's name");
            var by: ?string = null;
            if (this.atWord("by")) {
                let word = this.advance();
                if (!delegates) {
                    throw this.failure(
                        "LYS-PAR0047",
                        "an enum delegates nothing: 'by' stands in a struct's or a class's list",
                        word
                    );
                }
                by = this.text(try this.expect(.Ident, "LYS-PAR0026", "the field it delegates to"));
            }
            // `Iterator<Item = int>`: associated types fixed (05 §8 rule 5)
            let fixed = List<FixedAnswer>.new();
            if (this.at(.Lt)) {
                this.advance();
                loop {
                    let fname = try this.expect(
                        .Ident,
                        "LYS-PAR0026",
                        "the associated type it fixes"
                    );
                    try this.expect(.Assign, "LYS-PAR0037", "'=' and the type it is");
                    let fty = try this.parseType();
                    fixed.push(
                        FixedAnswer {
                            name = this.text(fname),
                            type = fty,
                            span = this.since(fname),
                        }
                    );
                    if (!this.at(.Comma)) {
                        break;
                    }
                    this.advance();
                }
                try this.closeAngle();
            }
            out.push(
                Conformance {
                    name = this.text(name),
                    by = by,
                    span = this.since(first),
                    fixed = fixed.toArray(),
                }
            );
            if (!bracketed || !this.at(.Comma)) {
                break;
            }
            this.advance();
        }
        if (bracketed) {
            try this.expect(.RBracket, "LYS-PAR0004", "']' after the interfaces");
        }
        return out.toArray();
    }

    /// `static let name: T = value`, after `static`; in an interface without its value.
    mut fn parseStaticLet(first: Token): StaticLet throws SyntaxError {
        this.advance();
        let name = try this.expect(.Ident, "LYS-PAR0026", "the constant's name");
        var ty: ?TypeExpr = null;
        if (this.at(.Colon)) {
            this.advance();
            ty = try this.parseType();
        }
        var value: ?Expr = null;
        if (this.at(.Assign)) {
            this.advance();
            value = try this.parseExpr();
        }
        return StaticLet {
            name = this.text(name),
            type = ty,
            value = value,
            span = this.since(first),
        };
    }

    /// `interface I :: [P] { … }`, `sealed` before it: members with a body are defaults, the
    /// others abstract.
    mut fn parseInterface(isPub: bool, first: Token): InterfaceDecl throws SyntaxError {
        let sealed = this.atWord("sealed");
        if (sealed) {
            this.advance();
        }
        this.advance();
        let name = try this.expect(.Ident, "LYS-PAR0026", "the interface's name");
        let parents = try this.parseConformances(false);
        this.skipNewlines();
        try this.expect(.LBrace, "LYS-PAR0017", "'{' before the interface's body");
        let members = List<FnDecl>.new();
        let assoc = List<AssocDecl>.new();
        let ifaceStatics = List<StaticLet>.new();
        this.inInterface = true;
        defer {
            this.inInterface = false;
        }
        loop {
            while (this.at(.Newline) || this.at(.Comma) || this.at(.Semi)) {
                this.advance();
            }
            if (this.at(.RBrace) || this.at(.Eof)) {
                break;
            }
            try {
                let at = this.current();
                // `type Item`, `type Item = T`, `type Item :: [B]`: an associated type (05 §8)
                if (this.atWord("type") && this.peek(1).kind == .Ident) {
                    this.advance();
                    let name = this.advance();
                    let bounds = this.parseConformances(false);
                    var dflt: ?TypeExpr = null;
                    if (this.at(.Assign)) {
                        this.advance();
                        dflt = this.parseType();
                    }
                    assoc.push(
                        AssocDecl {
                            name = this.text(name),
                            default = dflt,
                            bounds = bounds,
                            span = this.since(at),
                        }
                    );
                    continue;
                }
                // a static member (Lyric 5 05 §7 rule 2)
                var isStatic = false;
                if (this.atWord("static")) {
                    isStatic = true;
                    this.advance();
                }
                if (isStatic && this.atWord("let")) {
                    ifaceStatics.push(this.parseStaticLet(at));
                    continue;
                }
                if (!this.atWord("fn")) {
                    throw this.failure(
                        "LYS-PAR0001",
                        f"an interface holds methods: found {this.shown(at)}",
                        at
                    );
                }
                members.push(this.parseFn(false, isStatic, at));
            } catch (_: SyntaxError) {
                this.synchronize();
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' to close the interface's body");
        return InterfaceDecl {
            assoc = assoc.toArray(),
            statics = ifaceStatics.toArray(),
            name = this.text(name),
            parents = parents,
            members = members.toArray(),
            sealed = sealed,
            isPub = isPub,
            span = this.since(first),
        };
    }

    /// `extend T { … }`, `extend T :: [I] { … }`: methods, and conformances, for a type.
    mut fn parseExtend(first: Token): ExtendDecl throws SyntaxError {
        this.advance();
        // `extend<T :: [Show]> Box<T>`: a block of type parameters (05 §13 rule 1)
        var typeParams: TypeParam[] = [];
        if (this.at(.Lt)) {
            typeParams = try this.parseTypeParams();
        }
        let target = try this.parseType();
        let conforms = try this.parseConformances(false);
        this.skipNewlines();
        try this.expect(.LBrace, "LYS-PAR0017", "'{' before the block's body");
        let fields = List<FieldDecl>.new();
        let methods = List<FnDecl>.new();
        let answers = List<TypeAnswer>.new();
        let statics = List<StaticLet>.new();
        loop {
            while (this.at(.Newline) || this.at(.Comma) || this.at(.Semi)) {
                this.advance();
            }
            if (this.at(.RBrace) || this.at(.Eof)) {
                break;
            }
            try {
                this.parseMember(fields, methods, answers, statics);
            } catch (_: SyntaxError) {
                this.synchronize();
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' to close the block");
        for (f in fields) {
            this.report(
                "LYS-PAR0901",
                f"an extend block adds methods, no field: '{f.name}'",
                this.current()
            );
        }
        return ExtendDecl {
            typeParams = typeParams,
            answers = answers.toArray(),
            statics = statics.toArray(),
            target = target,
            conforms = conforms,
            methods = methods.toArray(),
            span = this.since(first),
        };
    }

    /// `(int, Point)`: a tuple variant's payload.
    mut fn parsePayloadTypes(): TypeExpr[] throws SyntaxError {
        let open = this.advance();
        let types = List<TypeExpr>.new();
        while (!this.at(.RParen)) {
            types.push(try this.parseType());
            if (!this.at(.Comma)) {
                break;
            }
            this.advance();
        }
        try this.expect(.RParen, "LYS-PAR0008", "')' after the payload's types");
        if (types.length() == 0) {
            throw this.failure(
                "LYS-PAR0001",
                "a variant without a payload has no parentheses",
                open
            );
        }
        return types.toArray();
    }

    /// `{ w: int, h: int = 0 }`: a struct variant's fields.
    mut fn parsePayloadFields(): FieldDecl[] throws SyntaxError {
        this.advance();
        let fields = List<FieldDecl>.new();
        loop {
            while (this.at(.Newline) || this.at(.Comma)) {
                this.advance();
            }
            if (this.at(.RBrace) || this.at(.Eof)) {
                break;
            }
            let first = this.current();
            let name = try this.expect(.Ident, "LYS-PAR0026", "a field's name");
            try this.expect(.Colon, "LYS-PAR0031", "':' before the field's type");
            let ty = try this.parseType();
            var dflt: ?Expr = null;
            if (this.at(.Assign)) {
                this.advance();
                dflt = try this.parseExpr();
            }
            fields.push(
                FieldDecl {
                    name = this.text(name),
                    type = ty,
                    default = dflt,
                    isVar = false,
                    isPub = false,
                    span = this.since(first),
                }
            );
            if (!(this.at(.Comma) || this.at(.Newline) || this.at(.RBrace))) {
                let t = this.current();
                throw this.failure(
                    "LYS-PAR0029",
                    f"fields without ',' or a line end between them: found {this.shown(t)}",
                    t
                );
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' after the variant's fields");
        return fields.toArray();
    }

    mut fn parseAlias(isPub: bool, first: Token): AliasDecl throws SyntaxError {
        this.advance();
        let name = try this.expect(.Ident, "LYS-PAR0026", "the alias's name");
        if (!this.at(.Assign)) {
            let t = this.current();
            throw this.failure(
                "LYS-PAR0028",
                f"a type alias without '=': found {this.shown(t)}",
                t
            );
        }
        this.advance();
        let ty = try this.parseType();
        return AliasDecl {
            name = this.text(name),
            type = ty,
            isPub = isPub,
            span = this.since(first),
        };
    }

    // --- statements ------------------------------------------------------------------------------

    mut fn parseStmt(): Stmt throws SyntaxError {
        // `outer: loop { … }`: a label names the loop after it (07 §1 rule 3)
        if (this.at(.Ident) && this.peek(1).kind == .Colon && this.loopWordAt(2)) {
            this.pendingLabel = this.text(this.advance());
            this.advance();
        }
        let first = this.current();
        if (this.atWord("let") || this.atWord("var")) {
            return try this.parseLet();
        }
        // a local function, a named closure
        if (this.atWord("fn") && this.peek(1).kind == .Ident) {
            return Stmt.LocalFn(try this.parseFn(false, false, first));
        }
        if (this.atWord("if")) {
            return try this.parseIf();
        }
        if (this.atWord("while")) {
            this.advance();
            let label = this.takeLabel();
            if (this.peek(1).kind == .Keyword && this.isWord(this.peek(1), "let")) {
                let (pattern, value) = try this.parseLetCondition("while");
                this.skipNewlines();
                let body = try this.loopBody(label);
                return Stmt.WhileLet(pattern, value, body, label, this.since(first));
            }
            let cond = try this.parseCondition("while");
            this.skipNewlines();
            let body = try this.loopBody(label);
            return Stmt.While(cond, body, label, this.since(first));
        }
        // `do { … } while (c)`: the block at least once (07 §1)
        if (this.atWord("do") && this.peek(1).kind == .LBrace) {
            this.advance();
            let label = this.takeLabel();
            let body = try this.loopBody(label);
            if (!this.atWord("while")) {
                let t = this.current();
                throw this.failure(
                    "LYS-PAR0001",
                    f"a 'do' loop ends in 'while (condition)': found {this.shown(t)}",
                    t
                );
            }
            this.advance();
            let cond = try this.parseCondition("while");
            return Stmt.DoWhile(body, cond, label, this.since(first));
        }
        if (this.atWord("for")) {
            return try this.parseFor();
        }
        if (this.atWord("break")) {
            this.advance();
            // a name a loop around carries is its label; any other the start of the value
            var label: ?string = null;
            if (this.at(.Ident) && this.labelAround(this.text(this.current()))) {
                label = this.text(this.advance());
            }
            var value: ?Expr = null;
            if (!this.atStatementEnd()) {
                value = try this.parseExpr();
            }
            return Stmt.Break(label, value, this.since(first));
        }
        if (this.atWord("continue")) {
            this.advance();
            var label: ?string = null;
            if (this.at(.Ident)) {
                label = this.text(this.advance());
            }
            return Stmt.Continue(label, this.since(first));
        }
        if (this.atWord("return")) {
            this.advance();
            var value: ?Expr = null;
            if (!this.atStatementEnd()) {
                value = try this.parseExpr();
            }
            return Stmt.Return(value, this.since(first));
        }
        // `yield v` or `yield` (Lyric 5 10 §1 rule 2)
        if (this.atWord("yield")) {
            this.advance();
            var value: ?Expr = null;
            if (!this.atStatementEnd()) {
                value = try this.parseExpr();
            }
            return Stmt.Yield(value, this.since(first));
        }
        // `throw e` (06 §1 rule 3)
        if (this.atWord("throw")) {
            this.advance();
            let value = try this.parseExpr();
            return Stmt.Throw(value, this.since(first));
        }
        // `defer { … }`, `defer e` (06 §5 rule 2)
        if (this.atWord("defer")) {
            this.advance();
            if (this.at(.LBrace)) {
                let b = try this.parseBlock();
                return Stmt.Defer(b, this.since(first));
            }
            let vt = this.current();
            let e = try this.parseExpr();
            let at = this.since(vt);
            return Stmt.Defer(Block { stmts = [Stmt.Expr(e, at)], span = at }, this.since(first));
        }
        // `using let f = e` (06 §7 rule 1); `using` is a word only before `let` or `var`
        if (this.atWord("using")
            && (this.isWord(this.peek(1), "let") || this.isWord(this.peek(1), "var"))) {
            this.advance();
            let bound = try this.parseLet();
            return match (bound) {
                .Let(isVar, name, written, value, at) => {
                    if (isVar || value == null) {
                        this.report(
                            "LYS-PAR0052",
                            "a 'using' is one 'let' with a name and a value: 'using let f = open(…)'",
                            first
                        );
                    }
                    Stmt.Using(name, written, value ?? Expr.Null(at), this.since(first))
                }
                _ => {
                    this.report(
                        "LYS-PAR0052",
                        "a 'using' is one 'let' with a name and a value: 'using let f = open(…)'",
                        first
                    );
                    bound
                }
            };
        }
        // `try { … } catch (e: T) { … }` (06 §4)
        if (this.atWord("try") && this.peek(1).kind == .LBrace) {
            return try this.parseTry();
        }
        if (this.at(.LBrace)) {
            let b = try this.parseBlock();
            return Stmt.Block(b, b.span);
        }
        let e = try this.parseExpr();
        return Stmt.Expr(e, this.since(first));
    }

    /// `try { … }` and its clauses, each `catch (e)`, `catch (e: T)` or `catch (e in [A, B])`.
    mut fn parseTry(): Stmt throws SyntaxError {
        let first = this.advance();
        let body = try this.parseBlock();
        let clauses = List<CatchClause>.new();
        while (this.catchAhead()) {
            clauses.push(try this.parseCatch(false));
        }
        return Stmt.Try(body, clauses.toArray(), this.since(first));
    }

    /// Whether a clause follows, on this line or the next.
    mut fn catchAhead(): bool {
        var k = 0;
        while (this.peek(k).kind == .Newline) {
            k += 1;
        }
        return this.isWord(this.peek(k), "catch");
    }

    /// A clause: its head, and its body — a block, or in the expression form a value, whose
    /// block is the clause's body (06 §6 rule 4).
    mut fn parseCatch(valued: bool): CatchClause throws SyntaxError {
        this.skipNewlines();
        let at = this.advance();
        try this.expect(.LParen, "LYS-PAR0019", "'(' after 'catch'");
        let name = try this.expect(.Ident, "LYS-PAR0026", "the clause's binding, or '_'");
        let types = List<TypeExpr>.new();
        var isSet = false;
        if (this.at(.Colon)) {
            this.advance();
            types.push(try this.parseType());
        } else if (this.atWord("in")) {
            this.advance();
            isSet = true;
            if (this.at(.LBracket)) {
                this.advance();
                loop {
                    types.push(try this.parseType());
                    if (!this.at(.Comma)) {
                        break;
                    }
                    this.advance();
                }
                try this.expect(.RBracket, "LYS-PAR0004", "']' after the clause's types");
            } else {
                types.push(try this.parseType());
            }
        }
        try this.expect(.RParen, "LYS-PAR0008", "')' after the clause");
        var clauseBody = Block { stmts = [], span = this.spanOf(at) };
        if (valued) {
            let vt = this.current();
            let value = try this.parseExpr();
            clauseBody = valueBody(value, this.since(vt));
        } else {
            clauseBody = try this.parseBlock();
        }
        return CatchClause {
            name = this.text(name),
            types = types.toArray(),
            isSet = isSet,
            body = clauseBody,
            span = this.since(at),
        };
    }

    /// `let name: T = value`, `var name = value`; the type or the value may be left out.
    mut fn parseLet(): Stmt throws SyntaxError {
        let first = this.advance();
        let isVar = this.isWord(first, "var");
        // `let (a, b) = t`, `let .Num(n) = s else { … }`: the value taken apart by a pattern
        let head = this.current();
        let pattern = this.at(.LParen)
            || this.at(.Dot)
            || (head.kind == .Ident
                && isTypeName(this.text(head))
                && (this.peek(1).kind == .Dot || this.peek(1).kind == .LBrace));
        if (pattern) {
            let p = try this.parsePattern();
            try this.expect(.Assign, "LYS-PAR0020", "'=' and the value to take apart");
            let value = try this.parseExpr();
            var otherwise: ?Block = null;
            if (this.atWord("else")) {
                this.advance();
                this.skipNewlines();
                otherwise = try this.parseBlock();
            }
            return Stmt.Destructure(isVar, p, value, otherwise, this.since(first));
        }
        let name = this.current();
        if (name.kind != .Ident) {
            throw this.failure(
                "LYS-PAR0020",
                f"a binding without its name: found {this.shown(name)}",
                name
            );
        }
        this.advance();
        var ty: ?TypeExpr = null;
        if (this.at(.Colon)) {
            this.advance();
            ty = try this.parseType();
        }
        var value: ?Expr = null;
        if (this.at(.Assign)) {
            this.advance();
            value = try this.parseExpr();
        }
        return Stmt.Let(isVar, this.text(name), ty, value, this.since(first));
    }

    /// `(condition)` after `if` or `while`.
    mut fn parseCondition(word: string): Expr throws SyntaxError {
        try this.expect(.LParen, "LYS-PAR0019", f"'(' after '{word}'");
        let cond = try this.parseExpr();
        try this.expect(.RParen, "LYS-PAR0008", "')' after the condition");
        return cond;
    }

    /// `if` as a statement: its bodies are blocks, its `else` a block or another `if`.
    /// `(let name = value)` after `if` or `while`.
    /// `(let P = e)`: a pattern, or a name that takes an optional's value.
    mut fn parseLetCondition(word: string): (Pattern, Expr) throws SyntaxError {
        try this.expect(.LParen, "LYS-PAR0019", f"'(' after '{word}'");
        this.advance();
        let pattern = try this.parseOrPattern();
        try this.expect(.Assign, "LYS-PAR0020", "'=' and the value the pattern takes");
        let value = try this.parseExpr();
        try this.expect(.RParen, "LYS-PAR0008", "')' after the condition");
        return (pattern, value);
    }

    mut fn parseIf(): Stmt throws SyntaxError {
        let first = this.advance();
        var letPattern: ?Pattern = null;
        var cond = Expr.Bool(true, this.spanOf(first));
        if (this.peek(1).kind == .Keyword && this.isWord(this.peek(1), "let")) {
            let (pattern, value) = try this.parseLetCondition("if");
            letPattern = pattern;
            cond = value;
        } else {
            cond = try this.parseCondition("if");
        }
        this.skipNewlines();
        let then = try this.parseBlock();
        var otherwise: ?Box<Stmt> = null;
        if (this.atWord("else")) {
            this.advance();
            this.skipNewlines();
            if (this.atWord("if")) {
                otherwise = boxedStmt(try this.parseIf());
            } else {
                let b = try this.parseBlock();
                otherwise = boxedStmt(Stmt.Block(b, b.span));
            }
        }
        if (letPattern != null) {
            return Stmt.IfLet(letPattern, cond, then, otherwise, this.since(first));
        }
        return Stmt.If(cond, then, otherwise, this.since(first));
    }

    /// `for (name in iterable) { … }`.
    mut fn parseFor(): Stmt throws SyntaxError {
        let first = this.advance();
        try this.expect(.LParen, "LYS-PAR0019", "'(' after 'for'");
        let name = this.current();
        if (name.kind != .Ident) {
            throw this.failure(
                "LYS-PAR0020",
                f"a loop variable is missing: found {this.shown(name)}",
                name
            );
        }
        this.advance();
        if (!this.atWord("in")) {
            let t = this.current();
            throw this.failure("LYS-PAR0021", f"a for loop without 'in': found {this.shown(t)}", t);
        }
        this.advance();
        let iterable = try this.parseExpr();
        try this.expect(.RParen, "LYS-PAR0008", "')' after the iterable");
        this.skipNewlines();
        let label = this.takeLabel();
        let body = try this.loopBody(label);
        return Stmt.For(this.text(name), iterable, body, label, this.since(first));
    }

    /// Whether token `k` ahead begins a loop: `loop {`, `while`, `do {`, `for`.
    mut fn loopWordAt(k: int): bool {
        let t = this.peek(k);
        return (this.isWord(t, "loop") && this.peek(k + 1).kind == .LBrace)
            || this.isWord(t, "while")
            || (this.isWord(t, "do") && this.peek(k + 1).kind == .LBrace)
            || this.isWord(t, "for");
    }

    /// The label written before the loop being read, once.
    mut fn takeLabel(): ?string {
        let label = this.pendingLabel;
        this.pendingLabel = null;
        return label;
    }

    /// A loop's block, read with its label among the labels around.
    mut fn loopBody(label: ?string): Block throws SyntaxError {
        this.loopLabels.push(label ?? "");
        defer {
            this.loopLabels.pop();
        }
        return try this.parseBlock();
    }

    /// Whether a loop around carries the label `name`.
    mut fn labelAround(name: string): bool {
        for (l in this.loopLabels) {
            if (l == name) {
                return true;
            }
        }
        return false;
    }

    mut fn parseBlock(): Block throws SyntaxError {
        let open = try this.expect(.LBrace, "LYS-PAR0017", "'{'");
        return try this.parseBlockAfter(open);
    }

    /// A block's statements after its `{`, to its `}`.
    mut fn parseBlockAfter(open: Token): Block throws SyntaxError {
        try this.enter(open);
        defer {
            this.depth -= 1;
        }
        let stmts = List<Stmt>.new();
        this.skipTerminators();
        while (!this.at(.RBrace) && !this.at(.Eof)) {
            try {
                stmts.push(this.parseStmt());
                this.endStatement();
            } catch (_: SyntaxError) {
                this.synchronize();
            }
            this.skipTerminators();
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' to close the block");
        return Block { stmts = stmts.toArray(), span = this.since(open) };
    }

    // --- expressions -----------------------------------------------------------------------------

    mut fn parseExpr(): Expr throws SyntaxError {
        try this.enter(this.current());
        defer {
            this.depth -= 1;
        }
        return try this.parseBinary(0);
    }

    /// An infix token's binding powers (left, right), Lyric 5's table: higher binds tighter, left
    /// below right is left-associative; (-1, -1) where the token is no infix operator.
    mut fn power(t: Token): (int, int) {
        return match (t.kind) {
            .Star | .Slash | .Percent | .StarWrap => (25, 26),
            .Plus | .Minus | .PlusWrap | .MinusWrap => (23, 24),
            .Shl | .Shr => (21, 22),
            .DotDot | .DotDotEq => (19, 20),
            .Amp => (17, 18),
            .Caret => (15, 16),
            .Pipe => (13, 14),
            .Lt | .Le | .Gt | .Ge | .NotIn => (11, 12),
            .EqEq | .NotEq => (9, 10),
            .AndAnd => (7, 8),
            .OrOr => (5, 6),
            .QuestionQuestion => (3, 2),
            .Assign | .PlusAssign | .MinusAssign | .StarAssign | .SlashAssign | .PercentAssign => (
                1,
                0
            ),
            .PlusWrapAssign | .MinusWrapAssign | .StarWrapAssign | .AmpAssign | .PipeAssign => (
                1,
                0
            ),
            .CaretAssign | .ShlAssign | .ShrAssign | .AndAndAssign | .OrOrAssign => (1, 0),
            .QuestionQuestionAssign => (1, 0),
            .Keyword => if (this.isWord(t, "as")) (27, 28)
                else if (this.isWord(t, "in") || this.isWord(t, "is")) (11, 12) else (-1, -1),
            _ => (-1, -1),
        };
    }

    /// Operators by their binding powers. Each nesting level of an expression holds this frame,
    /// `parseUnary`'s and `parsePrimary`'s: what an operator builds is in methods of its own, so
    /// that the frames on the way down stay small (at -O0 every temporary has its own slot).
    mut fn parseBinary(min: int): Expr throws SyntaxError {
        let first = this.current();
        var left = try this.parseUnary();
        loop {
            let t = this.current();
            let (l, r) = this.power(t);
            if (l < 0 || l < min) {
                break;
            }
            this.advance();
            if (this.isWord(t, "as") || this.isWord(t, "is")) {
                left = try this.typeOperator(left, t, first);
                continue;
            }
            let startsWithTry = this.atWord("try");
            let right = try this.parseBinary(r);
            // `try?`, `try!` and a `try` with clauses stand at the start of what they cover; the
            // right of an assignment is such a start (06 §3 rule 2)
            if (startsWithTry && t.kind != .Assign && assignmentOp(t.kind) == null) {
                match (right) {
                    .TryOpt(_, _) | .TryBang(_, _) | .TryCatch(_, _, _) => this.report(
                        "LYS-PAR0050",
                        "a 'try?', 'try!' or 'try' with clauses right of an operator: put it at the start, or in parentheses",
                        t
                    ),
                    _ => { }
                }
            }
            left = try this.infix(left, t, l, right, first);
        }
        return left;
    }

    /// `x as T`, and `x is T`, which stands at the comparisons' level and does not chain.
    mut fn typeOperator(left: Expr, t: Token, first: Token): Expr throws SyntaxError {
        let ty = try this.parseType();
        if (this.isWord(t, "as")) {
            return Expr.Cast(boxed(left), ty, this.since(first));
        }
        if (this.power(this.current()).0 == 11) {
            throw this.failure(
                "LYS-PAR0059",
                "comparisons chained: write each on its own and join them with '&&'",
                this.current()
            );
        }
        return Expr.Is(boxed(left), ty, this.since(first));
    }

    /// `left t right`: an assignment, a range or a binary operation.
    mut fn infix(left: Expr, t: Token, l: int, right: Expr, first: Token): Expr throws SyntaxError {
        let span = this.since(first);
        let compound = assignmentOp(t.kind);
        if (t.kind == .Assign) {
            return Expr.Assign(boxed(left), null, boxed(right), span);
        }
        if (compound != null) {
            return Expr.Assign(boxed(left), compound, boxed(right), span);
        }
        if (t.kind == .DotDot || t.kind == .DotDotEq) {
            if (this.at(.DotDot) || this.at(.DotDotEq)) {
                throw this.failure(
                    "LYS-PAR0005",
                    "ranges chained: a range has two ends",
                    this.current()
                );
            }
            return Expr.Range(boxed(left), boxed(right), t.kind == .DotDotEq, span);
        }
        // `a < b < c` and `a == b == c` are refused, not read left to right (08 Y4)
        if ((l == 11 || l == 9) && this.power(this.current()).0 == l) {
            throw this.failure(
                "LYS-PAR0059",
                "comparisons chained: write each comparison on its own and join them with '&&'",
                this.current()
            );
        }
        let op = if (t.kind == .Keyword) BinaryOp.In else binaryOp(t.kind);
        return Expr.Binary(boxed(left), op, boxed(right), span);
    }

    mut fn parseUnary(): Expr throws SyntaxError {
        let t = this.current();
        let next = this.peek(1);
        // a `-` right before a number belongs to it: `-9223372036854775808` is int's least value
        if (t.kind == .Minus && t.end == next.start && (next.kind == .Int || next.kind == .Float)) {
            return try this.parsePostfix(this.negativeLiteral(t, next), t);
        }
        if (t.kind == .Minus || t.kind == .Bang || t.kind == .Tilde) {
            return try this.prefixed(t);
        }
        return try this.parsePostfix(this.parsePrimary(), t);
    }

    /// `-1`, `-2.5`: the sign and the number, one literal.
    mut fn negativeLiteral(t: Token, next: Token): Expr {
        this.advance();
        this.advance();
        let text = this.text(next);
        return if (next.kind == .Int) Expr.Int(
            intValue(text, true, next, this.errors),
            this.since(t)
        )
            else Expr.Float(floatValue(text, true), this.since(t));
    }

    /// `-x`, `!x`, `~x`: the operator before its operand.
    mut fn prefixed(t: Token): Expr throws SyntaxError {
        let op = match (t.kind) {
            .Minus => UnaryOp.Neg,
            .Bang => UnaryOp.Not,
            _ => UnaryOp.BitNot,
        };
        this.advance();
        try this.enter(t);
        defer {
            this.depth -= 1;
        }
        let operand = try this.parseUnary();
        return Expr.Unary(op, boxed(operand), this.since(t));
    }

    /// Calls, indices and members after an operand; each form built in a method of its own, so
    /// that a call nested in an argument holds a small frame here.
    mut fn parsePostfix(base: Expr, first: Token): Expr throws SyntaxError {
        var e = base;
        loop {
            if (this.at(.LParen)) {
                e = try this.callAfter(e, first);
            } else if (this.at(.Lt) && takesTypeArgs(e) && this.typeArgsAhead()) {
                e = try this.typeArgsAfter(e, first);
            } else if (this.at(.LBrace) && takesTrailing(e)) {
                e = try this.trailingAfter(e, first);
            } else if (this.at(.LBracket)) {
                e = try this.indexAfter(e, first);
            } else if (this.atWord("with") && this.peek(1).kind == .LBrace) {
                e = try this.withAfter(e, first);
            } else if (this.at(.Bang)) {
                // `x!`: a `!` after an operand is the unwrap; before one it is `not`
                this.advance();
                e = Expr.Unwrap(boxed(e), this.since(first));
            } else if (this.at(.Dot) || this.at(.QuestionDot)) {
                e = try this.memberAfter(e, first);
            } else {
                break;
            }
        }
        return e;
    }

    mut fn callAfter(e: Expr, first: Token): Expr throws SyntaxError {
        let args = try this.parseArgs();
        return Expr.Call(boxed(e), args, this.since(first));
    }

    /// `f<int>(x)`: type arguments written, a call after them.
    mut fn typeArgsAfter(e: Expr, first: Token): Expr throws SyntaxError {
        this.advance();
        let args = List<TypeExpr>.new();
        while (!this.at(.Gt)) {
            args.push(try this.parseType());
            if (!this.at(.Comma)) {
                break;
            }
            this.advance();
        }
        try this.expect(.Gt, "LYS-PAR0004", "'>' after the type arguments");
        return Expr.Instance(boxed(e), args.toArray(), this.since(first));
    }

    /// `xs.map { it * 2 }`, `run { … }`: the call's last argument (Lyric 5 03 §8.2).
    mut fn trailingAfter(e: Expr, first: Token): Expr throws SyntaxError {
        let block = try this.parseTrailing();
        return match (e) {
            .Call(callee, args, _) => {
                let all = List<Arg>.new();
                for (a in args) {
                    all.push(a);
                }
                all.push(Arg { name = null, value = block });
                Expr.Call(callee, all.toArray(), this.since(first))
            }
            _ => Expr.Call(boxed(e), [Arg { name = null, value = block }], this.since(first)),
        };
    }

    mut fn indexAfter(e: Expr, first: Token): Expr throws SyntaxError {
        this.advance();
        let index = try this.parseExpr();
        try this.expect(.RBracket, "LYS-PAR0004", "']' after the index");
        return Expr.Index(boxed(e), boxed(index), this.since(first));
    }

    /// `p with { x = 1 }` (Lyric 5 02 M6): a postfix, `with` contextual.
    mut fn withAfter(e: Expr, first: Token): Expr throws SyntaxError {
        this.advance();
        let fields = try this.parseWithFields();
        return Expr.With(boxed(e), fields, this.since(first));
    }

    /// `x.name`, `x?.name`, and `Shape.Rect { w = 1 }`, a struct variant built.
    mut fn memberAfter(e: Expr, first: Token): Expr throws SyntaxError {
        let optional = this.at(.QuestionDot);
        this.advance();
        let name = this.current();
        if (name.kind != .Ident && name.kind != .Keyword && name.kind != .Int) {
            throw this.failure(
                "LYS-PAR0003",
                f"a member's name is missing: found {this.shown(name)}",
                name
            );
        }
        this.advance();
        let member = this.text(name);
        if (!optional && this.at(.LBrace) && isTypeName(member)) {
            // `Shape.Rect { … }`, through a module `util.Shape.Rect { … }`
            let enumName = match (e) {
                .Name(n, _) => if (isTypeName(n)) n else "",
                .Member(inner, tn, false, _) => match (inner.value) {
                    .Name(m, _) => if (!isTypeName(m) && isTypeName(tn)) m + "." + tn else "",
                    _ => "",
                },
                _ => "",
            };
            if (enumName != "") {
                let fields = try this.parseFieldInits();
                return Expr.VariantInit(enumName, member, fields, this.since(first));
            }
            // `util.Point { … }`: a module's type built (Lyric 5 04 §3 rule 3)
            let moduleName = match (e) {
                .Name(n, _) => if (isTypeName(n)) "" else n,
                _ => "",
            };
            if (moduleName != "") {
                let fields = try this.parseFieldInits();
                return Expr.StructInit(moduleName + "." + member, fields, this.since(first));
            }
        }
        return Expr.Member(boxed(e), member, optional, this.since(first));
    }

    /// `(a, b, name: c)`: positional arguments first, named ones after them (Lyric 5 §8.1.1).
    mut fn parseArgs(): Arg[] throws SyntaxError {
        this.advance();
        let args = List<Arg>.new();
        while (!this.at(.RParen)) {
            var name: ?string = null;
            if (this.at(.Ident) && this.peek(1).kind == .Colon) {
                name = this.text(this.advance());
                this.advance();
            }
            let value = try this.parseExpr();
            args.push(Arg { name = name, value = value });
            if (!this.at(.Comma)) {
                break;
            }
            this.advance();
        }
        try this.expect(.RParen, "LYS-PAR0008", "')' after the arguments");
        return args.toArray();
    }

    /// An operand, by its first token; each form read in a method of its own (see `parseBinary`).
    mut fn parsePrimary(): Expr throws SyntaxError {
        let t = this.current();
        let e: ?Expr = match (t.kind) {
            .Int | .Float | .Str | .ByteStr | .Char | .FormatStr => this.literal(t),
            .LParen => try this.parseParen(t),
            .LBracket => try this.parseCollection(),
            .LBrace => try this.blockValue(),
            .Dot => try this.implicitMember(t),
            .Keyword => try this.keywordValue(t),
            .Ident => try this.nameValue(t),
            _ => null,
        };
        if (e != null) {
            return e;
        }
        throw this.missingExpr(t);
    }

    mut fn missingExpr(t: Token): SyntaxError {
        return this.failure("LYS-PAR0002", f"an expression is missing: found {this.shown(t)}", t);
    }

    /// A literal token's value.
    mut fn literal(t: Token): Expr {
        this.advance();
        let span = this.spanOf(t);
        return match (t.kind) {
            .Int => Expr.Int(intValue(this.text(t), false, t, this.errors), span),
            .Float => Expr.Float(floatValue(this.text(t), false), span),
            .Str => Expr.Str(stringValue(this.text(t), t, this.errors), span),
            .ByteStr => Expr.Bytes(bytesValue(this.text(t), t, this.errors), span),
            .Char => Expr.Char(charValue(this.text(t), t, this.errors), span),
            _ => this.interpolated(t),
        };
    }

    /// `(e)`, a grouping; `(a, b)`, a tuple; `(a: int) => …`, a lambda.
    mut fn parseParen(t: Token): Expr throws SyntaxError {
        if (!this.inGuard && this.lambdaAhead()) {
            return try this.parseLambda();
        }
        this.advance();
        let inner = try this.parseExpr();
        if (!this.at(.Comma)) {
            try this.expect(.RParen, "LYS-PAR0008", "')'");
            return inner;
        }
        let items = List<Expr>.new();
        items.push(inner);
        while (this.at(.Comma)) {
            this.advance();
            if (this.at(.RParen)) {
                break;
            }
            items.push(try this.parseExpr());
        }
        try this.expect(.RParen, "LYS-PAR0008", "')' to close the tuple");
        if (items.length() < 2) {
            throw this.failure(
                "LYS-PAR0010",
                "a tuple has two elements or more: one in parentheses is a grouping",
                t
            );
        }
        return Expr.Tuple(items.toArray(), this.since(t));
    }

    /// A value block.
    mut fn blockValue(): Expr throws SyntaxError {
        let b = try this.parseBlock();
        return Expr.Block(b, b.span);
    }

    /// `.Red`, `.Num(3)`, `.Rect { w = 1 }`: a member of the enum the position expects; `null`
    /// where no name follows the `.`.
    mut fn implicitMember(t: Token): ?Expr throws SyntaxError {
        if (this.peek(1).kind != .Ident) {
            return null;
        }
        this.advance();
        let name = this.text(this.advance());
        if (this.at(.LBrace) && isTypeName(name)) {
            let fields = try this.parseFieldInits();
            return Expr.VariantInit(null, name, fields, this.since(t));
        }
        return Expr.Implicit(name, this.since(t));
    }

    /// `true`, `false`, `null`, `this`, an `if` or a `match` where a value stands; `null` for any
    /// other word.
    mut fn keywordValue(t: Token): ?Expr throws SyntaxError {
        let w = this.text(t);
        let span = this.spanOf(t);
        if (w == "true" || w == "false") {
            this.advance();
            return Expr.Bool(w == "true", span);
        }
        if (w == "null") {
            this.advance();
            return Expr.Null(span);
        }
        if (w == "this") {
            this.advance();
            return Expr.This(span);
        }
        if (w == "if") {
            return try this.parseIfExpr();
        }
        if (w == "match") {
            return try this.parseMatch();
        }
        // `try e`: the mark, which covers what stands to its right; without effect (05 Th).
        // `try?` and `try!` with the sign against the keyword, `try e catch …` (06 §6)
        if (w == "try") {
            this.advance();
            let sign = this.current();
            if ((sign.kind == .Question || sign.kind == .Bang) && sign.start == t.end) {
                this.advance();
                let operand = try this.parseExpr();
                if (this.catchAhead()) {
                    this.report(
                        "LYS-PAR0051",
                        f"'try{this.text(sign)}' takes no clause: a clause belongs to a plain 'try'",
                        this.current()
                    );
                    // the clauses read and left, so that nothing follows from them
                    while (this.catchAhead()) {
                        let _ = try this.parseCatch(true);
                    }
                }
                return if (sign.kind == .Question) Expr.TryOpt(boxed(operand), this.since(t))
                    else Expr.TryBang(boxed(operand), this.since(t));
            }
            let marked = try this.parseExpr();
            if (this.catchAhead()) {
                let clauses = List<CatchClause>.new();
                while (this.catchAhead()) {
                    clauses.push(try this.parseCatch(true));
                }
                return Expr.TryCatch(boxed(marked), clauses.toArray(), this.since(t));
            }
            return Expr.TryMark(boxed(marked), this.since(t));
        }
        // `throw e` where a value stands, of type `never` (06 §1 rule 3)
        if (w == "throw") {
            this.advance();
            let value = try this.parseExpr();
            return Expr.Throw(boxed(value), this.since(t));
        }
        return null;
    }

    /// A name, `loop { … }`, `x => …` (a lambda of one parameter, its type from the position), or
    /// `Name { … }`, an initializer.
    mut fn nameValue(t: Token): Expr throws SyntaxError {
        // `found = search: loop { … }`: a label before a loop where a value stands
        if (this.peek(1).kind == .Colon
            && this.isWord(this.peek(2), "loop")
            && this.peek(3).kind == .LBrace) {
            this.pendingLabel = this.text(this.advance());
            this.advance();
        }
        if (this.atWord("loop") && this.peek(1).kind == .LBrace) {
            this.advance();
            let label = this.takeLabel();
            let body = try this.loopBody(label);
            return Expr.Loop(body, label, this.since(t));
        }
        let name = this.text(t);
        let span = this.spanOf(t);
        if (this.peek(1).kind == .FatArrow && !this.inGuard) {
            this.advance();
            this.advance();
            let body = try this.lambdaBody();
            let param = LambdaParam { name = name, type = null, span = span };
            return Expr.Lambda([param], null, boxed(body), false, this.since(t));
        }
        this.advance();
        if (this.at(.LBrace) && isTypeName(name)) {
            return try this.parseStructInit(name, t);
        }
        return Expr.Name(name, span);
    }

    /// Whether the `(` here opens a lambda: its `)` is followed by `=>`, or by `:` and a result
    /// type before a `=>`.
    mut fn lambdaAhead(): bool {
        var k = 0;
        var depth = 0;
        loop {
            let kind = this.peek(k).kind;
            if (kind == .Eof) {
                return false;
            }
            if (kind == .LParen || kind == .LBracket || kind == .LBrace) {
                depth += 1;
            } else if (kind == .RParen || kind == .RBracket || kind == .RBrace) {
                depth -= 1;
                if (depth == 0) {
                    break;
                }
            }
            k += 1;
        }
        let after = this.peek(k + 1).kind;
        if (after == .FatArrow) {
            return true;
        }
        if (after != .Colon) {
            return false;
        }
        // `): T =>` — a type goes on to its `=>`, and stops at what ends an expression
        var j = k + 2;
        var inner = 0;
        while (j < k + 40) {
            let kind = this.peek(j).kind;
            if (kind == .FatArrow) {
                return true;
            }
            // `fn(int, int) -> int`, `Pair<int, int>`: a comma in the type's own brackets — `>>`
            // closes two (S6b2)
            if (kind == .LParen || kind == .Lt) {
                inner += 1;
            } else if (kind == .RParen || kind == .Gt) {
                inner -= 1;
            } else if (kind == .Shr) {
                inner -= 2;
            }
            if (kind == .Eof
                || kind == .Newline
                || (kind == .Comma && inner == 0)
                || kind == .Assign
                || kind == .RBracket
                || kind == .RBrace
                || kind == .LBrace
                || kind == .Semi) {
                return false;
            }
            j += 1;
        }
        return false;
    }

    /// `(a: int, b): int => body`.
    mut fn parseLambda(): Expr throws SyntaxError {
        let first = this.advance();
        let params = List<LambdaParam>.new();
        while (!this.at(.RParen)) {
            let pt = try this.expect(.Ident, "LYS-PAR0020", "a parameter's name");
            var ty: ?TypeExpr = null;
            if (this.at(.Colon)) {
                this.advance();
                ty = try this.parseType();
            }
            params.push(LambdaParam { name = this.text(pt), type = ty, span = this.since(pt) });
            if (!this.at(.Comma)) {
                break;
            }
            this.advance();
        }
        try this.expect(.RParen, "LYS-PAR0008", "')' after the lambda's parameters");
        var result: ?TypeExpr = null;
        if (this.at(.Colon)) {
            this.advance();
            result = try this.parseType();
        }
        try this.expect(.FatArrow, "LYS-PAR0034", "'=>' before the lambda's body");
        let body = try this.lambdaBody();
        return Expr.Lambda(params.toArray(), result, boxed(body), false, this.since(first));
    }

    /// `{ a, b => … }` or `{ … }`: a trailing block, its parameters named before `=>`, or `it`.
    mut fn parseTrailing(): Expr throws SyntaxError {
        let open = this.advance();
        // the names before a `=>`, if the block begins so
        var k = 0;
        while (this.peek(k).kind == .Newline) {
            k += 1;
        }
        var named = false;
        var j = k;
        loop {
            if (this.peek(j).kind != .Ident) {
                break;
            }
            let next = this.peek(j + 1).kind;
            if (next == .FatArrow) {
                named = true;
                break;
            }
            if (next != .Comma) {
                break;
            }
            j += 2;
        }
        let params = List<LambdaParam>.new();
        if (named) {
            this.skipNewlines();
            while (!this.at(.FatArrow)) {
                let pt = this.advance();
                params.push(
                    LambdaParam { name = this.text(pt), type = null, span = this.since(pt) }
                );
                if (this.at(.Comma)) {
                    this.advance();
                }
            }
            this.advance();
        }
        let body = try this.parseBlockAfter(open);
        return Expr.Lambda(
            params.toArray(),
            null,
            boxed(Expr.Block(body, body.span)),
            !named,
            this.since(open)
        );
    }

    /// Whether the `<` here opens type arguments: its matching `>` is followed by what no
    /// comparison goes on with — `(`, a closer, `,`, a line end, `.`, `==` (C#'s rule for the
    /// same doubt) —, and nothing between belongs to no type.
    mut fn typeArgsAhead(): bool {
        var k = 0;
        var depth = 0;
        loop {
            let kind = this.peek(k).kind;
            if (kind == .Lt) {
                depth += 1;
            } else if (kind == .Gt) {
                depth -= 1;
            } else if (kind == .Shr) {
                depth -= 2;
            } else if (!(kind == .Ident
                || kind == .Comma
                || kind == .Question
                || kind == .QuestionQuestion
                || kind == .LBracket
                || kind == .RBracket
                || kind == .LParen
                || kind == .RParen
                || kind == .Arrow
                || kind == .Colon
                || kind == .Keyword)) {
                return false;
            }
            k += 1;
            if (depth <= 0) {
                break;
            }
            if (k > 64) {
                return false;
            }
        }
        return depth == 0 && endsTypeArgs(this.peek(k).kind);
    }

    /// A lambda's body: a value block, or an expression.
    mut fn lambdaBody(): Expr throws SyntaxError {
        if (this.at(.LBrace)) {
            let b = try this.parseBlock();
            return Expr.Block(b, b.span);
        }
        return try this.parseExpr();
    }

    /// `if (c) a else b` where a value stands; each branch an expression or a value block.
    mut fn parseIfExpr(): Expr throws SyntaxError {
        let first = this.advance();
        let cond = try this.parseCondition("if");
        let then = try this.parseBranch();
        if (!this.atWord("else")) {
            let t = this.current();
            throw this.failure(
                "LYS-PAR0036",
                f"an 'if' where a value stands needs its 'else': found {this.shown(t)}",
                t
            );
        }
        this.advance();
        let otherwise = if (this.atWord("if")) try this.parseIfExpr() else try this.parseBranch();
        return Expr.If(boxed(cond), boxed(then), boxed(otherwise), this.since(first));
    }

    mut fn parseBranch(): Expr throws SyntaxError {
        this.skipNewlines();
        if (this.at(.LBrace)) {
            let b = try this.parseBlock();
            return Expr.Block(b, b.span);
        }
        return try this.parseExpr();
    }

    /// `[a, b]`, `[]`, `[k: v, …]`, `[:]` (02 L).
    mut fn parseCollection(): Expr throws SyntaxError {
        let open = this.advance();
        if (this.at(.Colon) && this.peek(1).kind == .RBracket) {
            this.advance();
            this.advance();
            return Expr.Map([], this.since(open));
        }
        if (this.at(.RBracket)) {
            this.advance();
            return Expr.List([], this.since(open));
        }
        let head = try this.parseExpr();
        if (this.at(.Colon)) {
            this.advance();
            let entries = List<MapEntry>.new();
            entries.push(MapEntry { key = head, value = try this.parseExpr() });
            while (this.at(.Comma)) {
                this.advance();
                if (this.at(.RBracket)) {
                    break;
                }
                let key = try this.parseExpr();
                try this.expect(.Colon, "LYS-PAR0902", "':' between a key and its value");
                entries.push(MapEntry { key = key, value = try this.parseExpr() });
            }
            try this.expect(.RBracket, "LYS-PAR0004", "']' to close the map");
            return Expr.Map(entries.toArray(), this.since(open));
        }
        let items = List<Expr>.new();
        items.push(head);
        while (this.at(.Comma)) {
            this.advance();
            if (this.at(.RBracket)) {
                break;
            }
            items.push(try this.parseExpr());
        }
        try this.expect(.RBracket, "LYS-PAR0004", "']' to close the list");
        return Expr.List(items.toArray(), this.since(open));
    }

    /// `Name { field = value, … }`: fields end at `,` or a line end; `name` alone is
    /// `name = name`.
    mut fn parseStructInit(name: string, first: Token): Expr throws SyntaxError {
        let fields = try this.parseFieldInits();
        return Expr.StructInit(name, fields, this.since(first));
    }

    /// `{ x = 1, y }`: an initializer's fields, a name alone standing for `name = name`.
    mut fn parseFieldInits(): FieldInit[] throws SyntaxError {
        this.advance();
        let fields = List<FieldInit>.new();
        loop {
            while (this.at(.Newline) || this.at(.Comma)) {
                this.advance();
            }
            if (this.at(.RBrace)) {
                break;
            }
            let ft = try this.expect(.Ident, "LYS-PAR0026", "a field's name");
            let fname = this.text(ft);
            var value = Expr.Name(fname, this.spanOf(ft));
            if (this.at(.Assign)) {
                this.advance();
                value = try this.parseExpr();
            } else if (!(this.at(.Comma) || this.at(.Newline) || this.at(.RBrace))) {
                let t = this.current();
                throw this.failure(
                    "LYS-PAR0037",
                    f"a field in an initializer without '=': found {this.shown(t)}",
                    t
                );
            }
            fields.push(FieldInit { name = fname, value = value, span = this.since(ft) });
            if (!(this.at(.Comma) || this.at(.Newline) || this.at(.RBrace))) {
                let t = this.current();
                throw this.failure(
                    "LYS-PAR0029",
                    f"fields without ',' or a line end between them: found {this.shown(t)}",
                    t
                );
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' to close the initializer");
        return fields.toArray();
    }

    /// `{ x = 1, pos.y = 2 }` after `with`: as an initializer's fields, a path on the left, the
    /// `=` always written.
    mut fn parseWithFields(): WithField[] throws SyntaxError {
        this.advance();
        let fields = List<WithField>.new();
        loop {
            while (this.at(.Newline) || this.at(.Comma)) {
                this.advance();
            }
            if (this.at(.RBrace)) {
                break;
            }
            let ft = try this.expect(.Ident, "LYS-PAR0026", "a field's name");
            let path = List<string>.new();
            path.push(this.text(ft));
            while (this.at(.Dot)) {
                this.advance();
                path.push(
                    this.text(try this.expect(.Ident, "LYS-PAR0026", "a field's name after '.'"))
                );
            }
            if (!this.at(.Assign)) {
                let t = this.current();
                this.report(
                    "LYS-PAR0037",
                    f"a field in 'with' without '=': found {this.shown(t)}",
                    t
                );
                // the rest of the fields is given up and the copy kept: one report, no cascade
                this.skipToClose();
                break;
            }
            this.advance();
            let value = try this.parseExpr();
            fields.push(WithField { path = path.toArray(), value = value, span = this.since(ft) });
            if (!(this.at(.Comma) || this.at(.Newline) || this.at(.RBrace))) {
                let t = this.current();
                this.report(
                    "LYS-PAR0029",
                    f"fields without ',' or a line end between them: found {this.shown(t)}",
                    t
                );
                this.skipToClose();
                break;
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' to close 'with'");
        return fields.toArray();
    }

    /// `match (e) { p => v, p if g => { … } }`: arms apart by `,` or a line end. A line that
    /// begins with `.` goes on the line before (09 NL rule 3), so a value arm before a `.Variant`
    /// arm on the next line ends with `,`.
    mut fn parseMatch(): Expr throws SyntaxError {
        let first = this.advance();
        try this.expect(.LParen, "LYS-PAR0019", "'(' after 'match'");
        let scrutinee = try this.parseExpr();
        try this.expect(.RParen, "LYS-PAR0008", "')' after the matched value");
        try this.expect(.LBrace, "LYS-PAR0017", "'{' before the arms");
        let arms = List<MatchArm>.new();
        loop {
            while (this.at(.Newline) || this.at(.Comma)) {
                this.advance();
            }
            if (this.at(.RBrace) || this.at(.Eof)) {
                break;
            }
            let armFirst = this.current();
            let pattern = try this.parseOrPattern();
            var guard: ?Expr = null;
            if (this.atWord("if")) {
                this.advance();
                this.inGuard = true;
                defer {
                    this.inGuard = false;
                }
                guard = try this.parseExpr();
            }
            try this.expect(.FatArrow, "LYS-PAR0034", "'=>' after the arm's pattern");
            var isBlock = false;
            var body = Expr.Null(this.spanOf(armFirst));
            if (this.at(.LBrace)) {
                let b = try this.parseBlock();
                body = Expr.Block(b, b.span);
                isBlock = true;
            } else {
                body = try this.parseExpr();
            }
            arms.push(
                MatchArm {
                    pattern = pattern,
                    guard = guard,
                    body = body,
                    span = this.since(armFirst),
                }
            );
            if (!(isBlock || this.at(.Comma) || this.at(.Newline) || this.at(.RBrace))) {
                let t = this.current();
                this.report(
                    "LYS-PAR0035",
                    f"arms without ',' or a line end between them: found {this.shown(t)} — a line that begins with '.' goes on the line before, so end the arm before it with ','",
                    t
                );
                // the rest of the arms is given up and the match kept: one report, no cascade
                this.skipToClose();
                break;
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' to close the match");
        return Expr.Match(boxed(scrutinee), arms.toArray(), this.since(first));
    }

    /// Skips to the `}` that closes the brace the parser stands in, past nested brackets.
    mut fn skipToClose(): void {
        var depth = 0;
        while (!this.at(.Eof)) {
            if (this.at(.LBrace) || this.at(.LParen) || this.at(.LBracket)) {
                depth += 1;
            } else if (this.at(.RBrace) || this.at(.RParen) || this.at(.RBracket)) {
                if (depth == 0 && this.at(.RBrace)) {
                    return;
                }
                depth -= 1;
            }
            this.advance();
        }
    }

    /// An f-string: its text, and each hole's expression read from the source where it stands.
    mut fn interpolated(t: Token): Expr {
        let segments = List<Segment>.new();
        for (piece in stringPieces(this.text(t), t, this.errors)) {
            match (piece) {
                .Text(s) => segments.push(Segment.Text(s)),
                .Hole(start, end, line, column, spec) => {
                    segments.push(Segment.Hole(this.hole(start, end, line, column, t), spec));
                }
            }
        }
        return Expr.Interpolated(segments.toArray(), this.spanOf(t));
    }

    mut fn hole(start: int, end: int, line: int, column: int, t: Token): Expr {
        let lexed = lexRange(this.source, start, end, line, column);
        for (d in lexed.errors) {
            this.errors.push(d);
        }
        let sub = Parser.new(this.source, lexed.tokens);
        sub.depth = this.depth;
        var e = Expr.Null(this.spanOf(t));
        try {
            e = sub.parseExpr();
            if (!sub.at(.Eof)) {
                let rest = sub.current();
                sub.report(
                    "LYS-PAR0014",
                    f"a hole holds one expression: found {sub.shown(rest)} after it",
                    rest
                );
            }
        } catch (_: SyntaxError) { }
        for (d in sub.errors) {
            this.errors.push(d);
        }
        return e;
    }

    // --- types -----------------------------------------------------------------------------------

    /// A written type: `int`, `Point`, `List<int>`, `?T`, `T[]`, `(A, B)`, `fn(A) -> B`.
    /// `P | Q | …`: an or-pattern, or the one pattern.
    mut fn parseOrPattern(): Pattern throws SyntaxError {
        let first = this.current();
        let p = try this.parsePattern();
        if (!this.at(.Pipe)) {
            return p;
        }
        let alternatives = List<Pattern>.new();
        alternatives.push(p);
        while (this.at(.Pipe)) {
            this.advance();
            alternatives.push(try this.parsePattern());
        }
        return Pattern.Or(alternatives.toArray(), this.since(first));
    }

    /// A pattern (Lyric 5 §9 §2): `_`, a name, a literal, a range, `.Variant`, `Enum.Variant`,
    /// `Type { … }`, a tuple, or one in parentheses.
    mut fn parsePattern(): Pattern throws SyntaxError {
        let first = this.current();
        if (this.at(.LParen)) {
            this.advance();
            let items = List<Pattern>.new();
            var commas = 0;
            while (!this.at(.RParen)) {
                items.push(try this.parseOrPattern());
                if (!this.at(.Comma)) {
                    break;
                }
                this.advance();
                commas += 1;
            }
            try this.expect(.RParen, "LYS-PAR0008", "')' to close the pattern");
            if (items.length() == 1 && commas == 0) {
                return items[0];
            }
            if (items.length() < 2) {
                throw this.failure(
                    "LYS-PAR0010",
                    "a tuple has two elements or more: one in parentheses is a grouping",
                    first
                );
            }
            return Pattern.Tuple(items.toArray(), this.since(first));
        }
        if (this.at(.Dot) && this.peek(1).kind == .Ident) {
            this.advance();
            let name = this.text(this.advance());
            return try this.variantPattern(null, name, first);
        }
        if (this.at(.Ident)) {
            let name = this.text(first);
            // `c: Circle`, `_: Circle`: a type pattern
            if (this.peek(1).kind == .Colon) {
                this.advance();
                this.advance();
                let ty = try this.parseType();
                return Pattern.Typed(if (name == "_") null else name, ty, this.since(first));
            }
            if (name == "_") {
                this.advance();
                return Pattern.Ignore(this.since(first));
            }
            if (isTypeName(name) && this.peek(1).kind == .Dot && this.peek(2).kind == .Ident) {
                this.advance();
                this.advance();
                let variant = this.text(this.advance());
                return try this.variantPattern(name, variant, first);
            }
            if (isTypeName(name) && this.peek(1).kind == .LBrace) {
                this.advance();
                let fields = try this.parseFieldPatterns();
                return Pattern.Fields(name, fields, this.since(first));
            }
            this.advance();
            return Pattern.Name(name, this.since(first));
        }
        let low = try this.parseLiteralPattern();
        if (this.at(.DotDot) || this.at(.DotDotEq)) {
            let inclusive = this.at(.DotDotEq);
            this.advance();
            let high = try this.parseLiteralPattern();
            return Pattern.Range(low, high, inclusive, this.since(first));
        }
        return Pattern.Literal(low, this.since(first));
    }

    /// After `.Name` or `Enum.Name`: its payload's patterns, its fields, or neither.
    mut fn variantPattern(
        enumName: ?string,
        name: string,
        first: Token
    ): Pattern throws SyntaxError {
        if (this.at(.LParen)) {
            this.advance();
            let items = List<Pattern>.new();
            while (!this.at(.RParen)) {
                items.push(try this.parseOrPattern());
                if (!this.at(.Comma)) {
                    break;
                }
                this.advance();
            }
            try this.expect(.RParen, "LYS-PAR0008", "')' after the payload's patterns");
            return Pattern.Variant(enumName, name, items.toArray(), this.since(first));
        }
        if (this.at(.LBrace)) {
            let fields = try this.parseFieldPatterns();
            return Pattern.VariantFields(enumName, name, fields, this.since(first));
        }
        return Pattern.Variant(enumName, name, null, this.since(first));
    }

    /// `{ w = 0, h }`: a field tested against a pattern, or bound to its own name.
    mut fn parseFieldPatterns(): FieldPattern[] throws SyntaxError {
        this.advance();
        let fields = List<FieldPattern>.new();
        loop {
            while (this.at(.Newline) || this.at(.Comma)) {
                this.advance();
            }
            if (this.at(.RBrace) || this.at(.Eof)) {
                break;
            }
            let ft = try this.expect(.Ident, "LYS-PAR0026", "a field's name");
            let name = this.text(ft);
            var p = Pattern.Name(name, this.spanOf(ft));
            if (this.at(.Assign)) {
                this.advance();
                p = try this.parseOrPattern();
            }
            fields.push(FieldPattern { name = name, pattern = p, span = this.since(ft) });
            if (!(this.at(.Comma) || this.at(.Newline) || this.at(.RBrace))) {
                let t = this.current();
                throw this.failure(
                    "LYS-PAR0029",
                    f"fields without ',' or a line end between them: found {this.shown(t)}",
                    t
                );
            }
        }
        try this.expect(.RBrace, "LYS-PAR0018", "'}' after the field patterns");
        return fields.toArray();
    }

    /// A literal in a pattern: a number, `-` and a number, a character, a string, `true`,
    /// `false` or `null`.
    mut fn parseLiteralPattern(): Expr throws SyntaxError {
        let t = this.current();
        let literal = t.kind == .Int
            || t.kind == .Float
            || t.kind == .Str
            || t.kind == .Char
            || (t.kind == .Minus && (this.peek(1).kind == .Int || this.peek(1).kind == .Float))
            || this.isWord(t, "true")
            || this.isWord(t, "false")
            || this.isWord(t, "null");
        if (!literal) {
            throw this.failure("LYS-PAR0002", f"a pattern is missing: found {this.shown(t)}", t);
        }
        return try this.parseUnary();
    }

    mut fn parseType(): TypeExpr throws SyntaxError {
        let first = this.current();
        var ty = try this.parseTypeAtom();
        while (this.at(.LBracket) && this.peek(1).kind == .RBracket) {
            this.advance();
            this.advance();
            ty = TypeExpr.List(boxedType(ty), this.since(first));
        }
        return ty;
    }

    mut fn parseTypeAtom(): TypeExpr throws SyntaxError {
        let first = this.current();
        if (this.at(.Question)) {
            this.advance();
            let inner = try this.parseType();
            return TypeExpr.Optional(boxedType(inner), this.since(first));
        }
        // `??T`: the lexer reads `??` as one token; in a type it is two `?`
        if (this.at(.QuestionQuestion)) {
            this.advance();
            let inner = try this.parseType();
            let once = TypeExpr.Optional(boxedType(inner), this.since(first));
            return TypeExpr.Optional(boxedType(once), this.since(first));
        }
        if (this.at(.LParen)) {
            this.advance();
            let elements = List<TypeExpr>.new();
            let labels = List<string>.new();
            var commas = 0;
            while (!this.at(.RParen)) {
                // `x: T`: a label, a name for the reader (Lyric 5 §6 rule 3)
                var label = "";
                if (this.at(.Ident) && this.peek(1).kind == .Colon) {
                    let named = this.advance();
                    label = this.text(named);
                    for (l in labels) {
                        if (l == label) {
                            throw this.failure(
                                "LYS-PAR0010",
                                f"the label '{label}' is given twice in one tuple",
                                named
                            );
                        }
                    }
                    this.advance();
                }
                elements.push(try this.parseType());
                labels.push(label);
                if (!this.at(.Comma)) {
                    break;
                }
                this.advance();
                commas += 1;
            }
            try this.expect(.RParen, "LYS-PAR0008", "')' to close the tuple type");
            if (elements.length() == 1 && commas == 0 && labels[0] == "") {
                return elements[0];
            }
            if (elements.length() < 2) {
                throw this.failure(
                    "LYS-PAR0010",
                    "a tuple has two elements or more: one in parentheses is a grouping",
                    first
                );
            }
            return TypeExpr.Tuple(elements.toArray(), labels.toArray(), this.since(first));
        }
        if (this.atWord("fn")) {
            this.advance();
            try this.expect(.LParen, "LYS-PAR0008", "'(' before the parameter types");
            let params = List<TypeExpr>.new();
            while (!this.at(.RParen)) {
                params.push(try this.parseType());
                if (!this.at(.Comma)) {
                    break;
                }
                this.advance();
            }
            try this.expect(.RParen, "LYS-PAR0008", "')' after the parameter types");
            try this.expect(.Arrow, "LYS-PAR0015", "'->' before the result type");
            let result = try this.parseType();
            return TypeExpr.Fn(params.toArray(), boxedType(result), this.since(first));
        }
        if (!this.at(.Ident)) {
            throw this.failure(
                "LYS-PAR0011",
                f"a type is missing: found {this.shown(first)}",
                first
            );
        }
        var name = this.text(this.advance());
        // `T.Item`, `Self.Item`: an associated type through a type (05 §8 rule 4)
        if (this.at(.Dot) && this.peek(1).kind == .Ident) {
            let parts = List<string>.new();
            parts.push(name);
            while (this.at(.Dot) && this.peek(1).kind == .Ident) {
                this.advance();
                parts.push(this.text(this.advance()));
            }
            name = parts.toArray().join(".");
        }
        let args = List<TypeExpr>.new();
        if (this.at(.Lt)) {
            this.advance();
            loop {
                // `Iterator<Item = int>`: an associated type fixed, written `=Item` (05 §8 rule 6)
                if (this.at(.Ident) && this.peek(1).kind == .Assign) {
                    let fname = this.advance();
                    this.advance();
                    let fty = try this.parseType();
                    args.push(TypeExpr.Named("=" + this.text(fname), [fty], this.since(fname)));
                } else {
                    args.push(try this.parseType());
                }
                if (!this.at(.Comma)) {
                    break;
                }
                this.advance();
            }
            try this.closeAngle();
        }
        return TypeExpr.Named(name, args.toArray(), this.since(first));
    }

    /// The `>` that closes type arguments; one of the two of a `>>` (Lyric 5 §1 rule 2).
    mut fn closeAngle(): void throws SyntaxError {
        if (this.halfShr) {
            this.halfShr = false;
            this.advance();
            return;
        }
        if (this.at(.Gt)) {
            this.advance();
            return;
        }
        if (this.at(.Shr)) {
            this.halfShr = true;
            return;
        }
        let t = this.current();
        throw this.failure(
            "LYS-PAR0009",
            f"expected '>' to close the type's arguments, found {this.shown(t)}",
            t
        );
    }
}

fn boxed(e: Expr): Box<Expr> {
    return Box<Expr> { value = e };
}

fn boxedType(t: TypeExpr): Box<TypeExpr> {
    return Box<TypeExpr> { value = t };
}

fn boxedStmt(s: Stmt): Box<Stmt> {
    return Box<Stmt> { value = s };
}

/// Whether a name is a type's, by its form: a capital first letter. `Name {` opens an initializer
/// only after one; after any other name the brace is a block's (spec 2 D-init).
/// Whether a `{` after `e` is a trailing block: after a call, a member, or a name that is no
/// type's (after a type's name it is an initializer).
fn takesTrailing(e: Expr): bool {
    return match (e) {
        .Call(_, _, _) => true,
        .Member(_, name, _, _) => !isTypeName(name),
        .Name(name, _) => !isTypeName(name),
        _ => false,
    };
}

/// Whether type arguments may follow `e`: a function's name, or a member's.
fn takesTypeArgs(e: Expr): bool {
    return match (e) {
        .Name(_, _) | .Member(_, _, _, _) => true,
        _ => false,
    };
}

fn isTypeName(name: string): bool {
    for (c in name.chars()) {
        return c >= 'A' && c <= 'Z';
    }
    return false;
}

/// The operator of a compound assignment, `null` for any other token.
fn assignmentOp(k: TokenKind): ?BinaryOp {
    return match (k) {
        .PlusAssign => BinaryOp.Add,
        .MinusAssign => BinaryOp.Sub,
        .StarAssign => BinaryOp.Mul,
        .SlashAssign => BinaryOp.Div,
        .PercentAssign => BinaryOp.Rem,
        .PlusWrapAssign => BinaryOp.AddWrap,
        .MinusWrapAssign => BinaryOp.SubWrap,
        .StarWrapAssign => BinaryOp.MulWrap,
        .AmpAssign => BinaryOp.BitAnd,
        .PipeAssign => BinaryOp.BitOr,
        .CaretAssign => BinaryOp.BitXor,
        .ShlAssign => BinaryOp.Shl,
        .ShrAssign => BinaryOp.Shr,
        .AndAndAssign => BinaryOp.And,
        .OrOrAssign => BinaryOp.Or,
        .QuestionQuestionAssign => BinaryOp.Coalesce,
        _ => null,
    };
}

/// The operator of an infix token that is no assignment, range or word.
fn binaryOp(k: TokenKind): BinaryOp {
    return match (k) {
        .Plus => BinaryOp.Add,
        .Minus => BinaryOp.Sub,
        .Star => BinaryOp.Mul,
        .Slash => BinaryOp.Div,
        .Percent => BinaryOp.Rem,
        .PlusWrap => BinaryOp.AddWrap,
        .MinusWrap => BinaryOp.SubWrap,
        .StarWrap => BinaryOp.MulWrap,
        .Shl => BinaryOp.Shl,
        .Shr => BinaryOp.Shr,
        .Amp => BinaryOp.BitAnd,
        .Caret => BinaryOp.BitXor,
        .Pipe => BinaryOp.BitOr,
        .Lt => BinaryOp.Lt,
        .Le => BinaryOp.Le,
        .Gt => BinaryOp.Gt,
        .Ge => BinaryOp.Ge,
        .EqEq => BinaryOp.Eq,
        .NotEq => BinaryOp.Ne,
        .NotIn => BinaryOp.NotIn,
        .AndAnd => BinaryOp.And,
        .OrOr => BinaryOp.Or,
        _ => BinaryOp.Coalesce,
    };
}

/// The TOML of a frontmatter token: its lines between the two `---` lines.
fn frontmatterText(text: string): string {
    let lines = List<string>.new();
    for (l in text.lines()) {
        lines.push(l.toString());
    }
    let inner = List<string>.new();
    var k = 1;
    while (k < lines.length() - 1) {
        inner.push(lines[k]);
        k += 1;
    }
    return inner.toArray().join("\n");
}

/// Whether a token after a `>` closes type arguments, not a comparison: a call's `(`, or what
/// ends or continues a value without an operand (`id<int>` as a value, S3i).
fn endsTypeArgs(k: TokenKind): bool {
    return k == .LParen
        || k == .RParen
        || k == .RBracket
        || k == .RBrace
        || k == .Comma
        || k == .Semi
        || k == .Newline
        || k == .Eof
        || k == .Dot
        || k == .EqEq
        || k == .NotEq;
}

/// A clause's value as its body: a value block is its own block; any other value the block
/// that gives it.
fn valueBody(value: Expr, at: Span): Block {
    return match (value) {
        .Block(b, _) => b,
        _ => Block { stmts = [Stmt.Expr(value, at)], span = at },
    };
}
