//! The syntax tree as S-expressions — `(+ 1 (* 2 3))` — for the parser's tests and for looking at
//! what the parser made of a script. One line per item; no spans.
import std.collections { List };
import lyric_script.compiler.ast {
    Block,
    CatchClause,
    Conformance,
    Decl,
    Expr,
    FnDecl,
    Item,
    Module,
    Param,
    FieldPattern,
    Pattern,
    Stmt,
    TypeExpr,
    binaryText,
    unaryText,
};

fn showModule(m: Module): string {
    let out = List<string>.new();
    let fm = m.frontmatter;
    if (fm != null) {
        out.push("(frontmatter " + quoted(fm) + ")");
    }
    for (item in m.items) {
        out.push(showItem(item));
    }
    return out.toArray().join("\n");
}

fn showItem(item: Item): string {
    return match (item) {
        .Decl(d) => showDecl(d),
        .Stmt(s) => showStmt(s),
    };
}

fn showDecl(d: Decl): string {
    return match (d) {
        .Fn(f) => showFn(f),
        .Type(t) => {
            let parts = List<string>.new();
            parts.push(if (t.isClass) "class" else "struct");
            parts.push(t.name + showConforms(t.conforms));
            for (f in t.fields) {
                let dflt = f.default;
                let kept = if (dflt != null) " = " + showExpr(dflt) else "";
                let word = if (f.isVar) "var " else "";
                parts.push("(" + word + f.name + ": " + showType(f.type) + kept + ")");
            }
            for (m in t.methods) {
                parts.push(showFn(m));
            }
            "(" + parts.toArray().join(" ") + ")"
        }
        .Enum(e) => {
            let parts = List<string>.new();
            parts.push("enum");
            parts.push(e.name);
            for (v in e.variants) {
                if (v.named) {
                    let fs = List<string>.new();
                    for (f in v.fields) {
                        fs.push(f.name + ": " + showType(f.type));
                    }
                    parts.push(v.name + "{" + fs.toArray().join(", ") + "}");
                } else if (v.positional.length() > 0) {
                    let ts = List<string>.new();
                    for (x in v.positional) {
                        ts.push(showType(x));
                    }
                    parts.push(v.name + "(" + ts.toArray().join(", ") + ")");
                } else {
                    parts.push(v.name);
                }
            }
            for (m in e.methods) {
                parts.push(showFn(m));
            }
            "(" + parts.toArray().join(" ") + ")"
        }
        .Alias(a) => "(type " + a.name + " " + showType(a.type) + ")",
        .Interface(i) => {
            let parts = List<string>.new();
            parts.push(if (i.sealed) "sealed-interface" else "interface");
            parts.push(i.name + showConforms(i.parents));
            for (m in i.members) {
                parts.push(showFn(m));
            }
            "(" + parts.toArray().join(" ") + ")"
        }
        .Import(im) => {
            let what = if (im.selective) {
                let names = List<string>.new();
                for (it in im.items) {
                    let renamed = it.alias;
                    names.push(if (renamed != null) it.name + " as " + renamed else it.name);
                }
                " {" + names.toArray().join(", ") + "}"
            } else {
                let renamed = im.alias;
                if (renamed != null) " as " + renamed else ""
            };
            "(" + (if (im.isPub) "pub import " else "import ") + im.path.join(".") + what + ")"
        }
        .Extend(x) => {
            let parts = List<string>.new();
            parts.push("extend");
            parts.push(showType(x.target) + showConforms(x.conforms));
            for (m in x.methods) {
                parts.push(showFn(m));
            }
            "(" + parts.toArray().join(" ") + ")"
        }
    };
}

fn showFn(f: FnDecl): string {
    let params = List<string>.new();
    for (p in f.params) {
        params.push(showParam(p));
    }
    let r = f.returns;
    var returns = if (r != null) ": " + showType(r) + " " else "";
    let th = f.throws;
    if (th != null) {
        let types = List<string>.new();
        for (x in th.types) {
            types.push(showType(x));
        }
        returns = returns + "throws [" + types.toArray().join(", ") + "] ";
    }
    let body = match (f.body) {
        .Block(b) => showBlock(b),
        .Expr(e) => "= " + showExpr(e),
        .None => "abstract",
    };
    let words = if (f.isStatic) "static fn" else "fn";
    return "("
        + words
        + " "
        + f.name
        + " ("
        + params.toArray().join(" ")
        + ") "
        + returns
        + body
        + ")";
}

fn showParam(p: Param): string {
    let dflt = p.default;
    let given = if (dflt != null) " = " + showExpr(dflt) else "";
    return p.name + ": " + showType(p.type) + given;
}

fn showBlock(b: Block): string {
    let parts = List<string>.new();
    for (s in b.stmts) {
        parts.push(showStmt(s));
    }
    return "{" + parts.toArray().join("; ") + "}";
}

fn showConforms(conforms: Conformance[]): string {
    if (conforms.length() == 0) {
        return "";
    }
    let parts = List<string>.new();
    for (c in conforms) {
        let by = c.by;
        parts.push(if (by != null) c.name + " by " + by else c.name);
    }
    return " :: [" + parts.toArray().join(", ") + "]";
}

fn showPattern(p: Pattern): string {
    return match (p) {
        .Name(name, _) => name,
        .Ignore(_) => "_",
        .Tuple(items, _) => "(" + showPatterns(items) + ")",
        .Literal(e, _) => showExpr(e),
        .Range(a, b, inclusive, _) => showExpr(a) + (if (inclusive) "..=" else "..") + showExpr(b),
        .Variant(enumName, name, payload, _) => {
            let head = (enumName ?? "") + "." + name;
            if (payload != null) head + "(" + showPatterns(payload) + ")" else head
        }
        .VariantFields(enumName, name, fields, _) => (enumName ?? "")
            + "."
            + name
            + " {"
            + showFieldPatterns(fields)
            + "}",
        .Fields(name, fields, _) => name + " {" + showFieldPatterns(fields) + "}",
        .Typed(name, t, _) => (name ?? "_") + ": " + showType(t),
        .Or(items, _) => {
            let parts = List<string>.new();
            for (x in items) {
                parts.push(showPattern(x));
            }
            "(or " + parts.toArray().join(" ") + ")"
        }
    };
}

fn showPatterns(items: Pattern[]): string {
    let parts = List<string>.new();
    for (x in items) {
        parts.push(showPattern(x));
    }
    return parts.toArray().join(" ");
}

fn showFieldPatterns(fields: FieldPattern[]): string {
    let parts = List<string>.new();
    for (f in fields) {
        parts.push(f.name + " " + showPattern(f.pattern));
    }
    return parts.toArray().join(" ");
}

/// A `try`'s clauses, each ` (catch e: T {…})`.
fn showClauses(clauses: CatchClause[]): string {
    let parts = List<string>.new();
    for (c in clauses) {
        let tys = List<string>.new();
        for (t in c.types) {
            tys.push(showType(t));
        }
        let typed = if (tys.length() == 0) ""
            else if (c.isSet) " in [" + tys.toArray().join(", ") + "]"
                else ": " + tys.toArray().join(", ");
        parts.push(" (catch " + c.name + typed + " " + showBlock(c.body) + ")");
    }
    return parts.toArray().join("");
}

fn showStmt(s: Stmt): string {
    return match (s) {
        .Throw(e, _) => "(throw " + showExpr(e) + ")",
        .Try(body, clauses, _) => "(try " + showBlock(body) + showClauses(clauses) + ")",
        .Defer(body, _) => "(defer " + showBlock(body) + ")",
        .DoWhile(body, cond, _, _) => "(do " + showBlock(body) + " " + showExpr(cond) + ")",
        .Using(name, ty, value, _) => {
            let typed = if (ty != null) ": " + showType(ty) else "";
            "(using " + name + typed + " " + showExpr(value) + ")"
        }
        .Expr(e, _) => showExpr(e),
        .Let(isVar, name, ty, value, _) => {
            let word = if (isVar) "var" else "let";
            let typed = if (ty != null) ": " + showType(ty) else "";
            let given = if (value != null) " " + showExpr(value) else "";
            "(" + word + " " + name + typed + given + ")"
        }
        .LocalFn(f) => showFn(f),
        .Destructure(isVar, pattern, value, otherwise, _) => "("
            + (if (isVar) "var " else "let ")
            + showPattern(pattern)
            + " "
            + showExpr(value)
            + (if (otherwise != null) " else " + showBlock(otherwise) else "")
            + ")",
        .If(cond, then, otherwise, _) => {
            let rest = if (otherwise != null) " else " + showStmt(otherwise.value) else "";
            "(if " + showExpr(cond) + " " + showBlock(then) + rest + ")"
        }
        .While(cond, body, _, _) => "(while " + showExpr(cond) + " " + showBlock(body) + ")",
        .For(name, iterable, body, _, _) => "(for "
            + name
            + " "
            + showExpr(iterable)
            + " "
            + showBlock(body)
            + ")",
        .Break(_, value, _) => if (value != null) "(break " + showExpr(value) + ")" else "(break)",
        .Continue(_, _) => "(continue)",
        .Return(value, _) => if (value != null) "(return " + showExpr(value) + ")" else "(return)",
        .Yield(value, _) => if (value != null) "(yield " + showExpr(value) + ")" else "(yield)",
        .Block(b, _) => showBlock(b),
        .IfLet(pattern, value, then, otherwise, _) => {
            let rest = if (otherwise != null) " else " + showStmt(otherwise.value) else "";
            "(if-let "
                + showPattern(pattern)
                + " "
                + showExpr(value)
                + " "
                + showBlock(then)
                + rest
                + ")"
        }
        .WhileLet(pattern, value, body, _, _) => "(while-let "
            + showPattern(pattern)
            + " "
            + showExpr(value)
            + " "
            + showBlock(body)
            + ")",
    };
}

fn showExpr(e: Expr): string {
    return match (e) {
        .Throw(x, _) => "(throw " + showExpr(x.value) + ")",
        .TryMark(x, _) => "(try " + showExpr(x.value) + ")",
        .TryOpt(x, _) => "(try? " + showExpr(x.value) + ")",
        .TryBang(x, _) => "(try! " + showExpr(x.value) + ")",
        .TryCatch(x, clauses, _) => "(try " + showExpr(x.value) + showClauses(clauses) + ")",
        .Int(n, _) => f"{n}",
        .Float(x, _) => f"{x}",
        .Bool(b, _) => if (b) "true" else "false",
        .Char(c, _) => f"'{c}'",
        .Str(s, _) => quoted(s),
        .Bytes(bs, _) => {
            let parts = List<string>.new();
            for (b in bs) {
                parts.push(f"{b}");
            }
            "b[" + parts.toArray().join(" ") + "]"
        }
        .Interpolated(segments, _) => {
            let parts = List<string>.new();
            for (seg in segments) {
                parts.push(
                    match (seg) {
                        .Text(s) => quoted(s),
                        .Hole(x, spec) => if (spec != null) showExpr(x) + ":" + spec
                            else showExpr(x),
                    }
                );
            }
            "(f " + parts.toArray().join(" ") + ")"
        }
        .Null(_) => "null",
        .Name(n, _) => n,
        .This(_) => "this",
        .Unary(op, x, _) => "(" + unaryText(op) + " " + showExpr(x.value) + ")",
        .Binary(l, op, r, _) => "("
            + binaryText(op)
            + " "
            + showExpr(l.value)
            + " "
            + showExpr(r.value)
            + ")",
        .Assign(target, op, value, _) => {
            let word = if (op != null) binaryText(op) + "=" else "=";
            "(" + word + " " + showExpr(target.value) + " " + showExpr(value.value) + ")"
        }
        .Range(a, b, inclusive, _) => {
            let word = if (inclusive) "..=" else "..";
            "(" + word + " " + showExpr(a.value) + " " + showExpr(b.value) + ")"
        }
        .Cast(x, ty, _) => "(as " + showExpr(x.value) + " " + showType(ty) + ")",
        .Call(callee, args, _) => {
            let parts = List<string>.new();
            parts.push(showExpr(callee.value));
            for (a in args) {
                let n = a.name;
                parts.push(if (n != null) n + ": " + showExpr(a.value) else showExpr(a.value));
            }
            "(call " + parts.toArray().join(" ") + ")"
        }
        .Index(x, i, _) => "(index " + showExpr(x.value) + " " + showExpr(i.value) + ")",
        .Member(x, name, optional, _) => {
            let word = if (optional) "?." else ".";
            "(" + word + " " + showExpr(x.value) + " " + name + ")"
        }
        .List(items, _) => {
            let parts = List<string>.new();
            for (x in items) {
                parts.push(showExpr(x));
            }
            "[" + parts.toArray().join(" ") + "]"
        }
        .Map(entries, _) => {
            let parts = List<string>.new();
            for (entry in entries) {
                parts.push(showExpr(entry.key) + ": " + showExpr(entry.value));
            }
            if (parts.length() == 0) "[:]" else "[" + parts.toArray().join(", ") + "]"
        }
        .StructInit(name, fields, _) => {
            let parts = List<string>.new();
            parts.push(name);
            for (field in fields) {
                parts.push(field.name + "=" + showExpr(field.value));
            }
            "(init " + parts.toArray().join(" ") + ")"
        }
        .With(target, fields, _) => {
            let parts = List<string>.new();
            parts.push(showExpr(target.value));
            for (field in fields) {
                parts.push(field.path.join(".") + "=" + showExpr(field.value));
            }
            "(with " + parts.toArray().join(" ") + ")"
        }
        .If(cond, then, otherwise, _) => "(if "
            + showExpr(cond.value)
            + " "
            + showExpr(then.value)
            + " "
            + showExpr(otherwise.value)
            + ")",
        .Block(b, _) => showBlock(b),
        .Loop(body, _, _) => "(loop " + showBlock(body) + ")",
        .Unwrap(x, _) => "(unwrap " + showExpr(x.value) + ")",
        .Tuple(items, _) => {
            let parts = List<string>.new();
            for (x in items) {
                parts.push(showExpr(x));
            }
            "(tuple " + parts.toArray().join(" ") + ")"
        }
        .Implicit(name, _) => "." + name,
        .FromEnd(n, _) => "(^ " + showExpr(n.value) + ")",
        .Is(x, t, _) => "(is " + showExpr(x.value) + " " + showType(t) + ")",
        .Instance(x, args, _) => {
            let parts = List<string>.new();
            for (a in args) {
                parts.push(showType(a));
            }
            showExpr(x.value) + "<" + parts.toArray().join(", ") + ">"
        }
        .Lambda(params, result, body, implicit, _) => {
            let parts = List<string>.new();
            for (p in params) {
                let t = p.type;
                parts.push(if (t != null) p.name + ": " + showType(t) else p.name);
            }
            let r = if (result != null) ": " + showType(result) else "";
            let head = if (implicit) "(lambda-it"
                else "(lambda (" + parts.toArray().join(" ") + ")" + r;
            head + " " + showExpr(body.value) + ")"
        }
        .VariantInit(enumName, name, fields, _) => {
            let parts = List<string>.new();
            for (f in fields) {
                parts.push(f.name + " " + showExpr(f.value));
            }
            "(init " + (enumName ?? "") + "." + name + " " + parts.toArray().join(" ") + ")"
        }
        .Match(x, arms, _) => {
            let parts = List<string>.new();
            for (arm in arms) {
                let g = arm.guard;
                let guarded = if (g != null) " if " + showExpr(g) else "";
                parts.push(
                    "(" + showPattern(arm.pattern) + guarded + " => " + showExpr(arm.body) + ")"
                );
            }
            "(match " + showExpr(x.value) + " " + parts.toArray().join(" ") + ")"
        }
    };
}

fn showType(t: TypeExpr): string {
    return match (t) {
        .Named(name, args, _) => {
            let parts = List<string>.new();
            for (a in args) {
                parts.push(showType(a));
            }
            if (parts.length() == 0) name else name + "<" + parts.toArray().join(", ") + ">"
        }
        .Optional(inner, _) => "?" + showType(inner.value),
        .List(inner, _) => showType(inner.value) + "[]",
        .Tuple(elements, labels, _) => {
            let parts = List<string>.new();
            var k = 0;
            for (x in elements) {
                parts.push(if (labels[k] == "") showType(x) else labels[k] + ": " + showType(x));
                k += 1;
            }
            "(" + parts.toArray().join(", ") + ")"
        }
        .Fn(params, result, _) => {
            let parts = List<string>.new();
            for (x in params) {
                parts.push(showType(x));
            }
            "fn(" + parts.toArray().join(", ") + ") -> " + showType(result.value)
        }
    };
}

/// A string in quotes, its quotes, backslashes and line ends escaped.
fn quoted(s: string): string {
    let escaped = s.replace('\\', "\\\\").replace('"', "\\\"").replace('\n', "\\n");
    return "\"" + escaped + "\"";
}
