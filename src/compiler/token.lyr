//! The tokens of Lyric-Script (design/v1, 09; spec chapter 01): Lyric 5's tokens, the line end
//! as a token of its own, and the frontmatter of a single script.

/// What a token is.
pub enum TokenKind :: [Equatable, Debug] {
    // Words and literals.
    Ident,
    Keyword,
    Int,
    Float,
    Char,
    Str,
    /// `f"…"`: the text between the quotes, interpolations unparsed.
    FormatStr,
    /// `b"…"`.
    ByteStr,
    // Brackets and separators.
    LParen,
    RParen,
    LBracket,
    RBracket,
    LBrace,
    RBrace,
    Comma,
    Semi,
    Colon,
    ColonColon,
    Dot,
    QuestionDot,
    Question,
    Arrow,
    FatArrow,
    At,
    DotDot,
    DotDotEq,
    /// `...`: a variadic parameter's mark.
    DotDotDot,
    // Operators.
    Plus,
    Minus,
    Star,
    Slash,
    Percent,
    PlusWrap,
    MinusWrap,
    StarWrap,
    PlusPlus,
    MinusMinus,
    Amp,
    Pipe,
    Caret,
    Tilde,
    Bang,
    Shl,
    Shr,
    Assign,
    PlusAssign,
    MinusAssign,
    StarAssign,
    SlashAssign,
    PercentAssign,
    PlusWrapAssign,
    MinusWrapAssign,
    StarWrapAssign,
    AmpAssign,
    PipeAssign,
    CaretAssign,
    ShlAssign,
    ShrAssign,
    AndAndAssign,
    OrOrAssign,
    QuestionQuestionAssign,
    EqEq,
    NotEq,
    Lt,
    Le,
    Gt,
    Ge,
    /// `!in`, one token.
    NotIn,
    AndAnd,
    OrOr,
    QuestionQuestion,
    // Structure.
    /// The end of a statement: a line end the continuation rules keep (09 NL).
    Newline,
    /// `///` before a declaration.
    DocComment,
    /// `//!` at the top of a module.
    ModuleDoc,
    /// The TOML between two `---` lines at the top of a single script (09 Hd).
    Frontmatter,
    Eof,
}

/// One token: what it is and where it stands, as byte offsets into the source and its line and
/// column (both from 1).
pub struct Token {
    pub kind: TokenKind,
    pub start: int,
    pub end: int,
    pub line: int,
    pub column: int,
}

/// The reserved words: Lyric 5's 41, including those Lyric-Script does not use, so that a name
/// means the same in both languages (09 Y1). `loop`, `using`, `type`, `throws` and the like are
/// contextual, as in Lyric 5: names everywhere else.
pub let keywords: string[] = [
    "module", "import", "as", "pub", "private", "internal", "struct", "class", "enum",
    "interface", "extend", "fn", "mut", "static", "let", "var", "params", "if", "else", "while",
    "do", "for", "in", "is", "match", "break", "continue", "return", "yield", "defer", "try",
    "catch", "throw", "true", "false", "null", "this", "comptime", "inline", "quote", "macro",
];
