//! Rights (design/v1, 01 S1–S4; 12 Rechte): each module of the standard library that reaches
//! outside the script belongs to a class — `file`, `net`, `process`, `os`, `native` —; a program
//! asks for the classes its imports reach, each with the import that asks, and nothing is allowed
//! unless given (`--allow`, `-A`, or the one question before the start at a terminal).
//!
//! The standard library's table is fixed (S7a, plan 14): a module below one of its rows counts as
//! that row; a module it does not name asks for nothing.
import std.collections { List };
import lyric_script.compiler.ast { Expr };
import lyric_script.vm.module { RightUse };

/// The classes of rights (12 Rechte).
let classes: string[] = ["file", "net", "process", "os", "native"];

/// The class a module asks for, `null` for none: the standard library's table's — a module below
/// one counts as it.
fn classOf(module: string): ?string {
    for (row in stdTable()) {
        let (name, right) = row;
        if (module == name || module.startsWith(name + ".")) {
            return right;
        }
    }
    return null;
}

/// The standard library's table (12 Rechte, fixed in S7a): files, the network, processes, the
/// system's environment and signals, its clock and unseeded randomness: a seeded generator is
/// `std.random`'s and asks for nothing (S7f6, 01 S8).
fn stdTable(): (string, string)[] {
    return [
        ("std.fs", "file"),
        ("std.net", "net"),
        ("std.http", "net"),
        ("std.process", "process"),
        ("std.os", "os"),
        ("std.time", "os"),
        ("std.random.system", "os"),
    ];
}

/// The right `@Requires(x)` names (S8f2; 01 S2): a string of lowercase letters, digits and `-`,
/// beginning with a letter; `null` where `x` is none. A name of a class of `std` is that class.
fn rightNamed(x: Expr): ?string {
    let text = match (x) {
        .Str(s, _) => s,
        _ => {
            return null;
        }
    };
    var first = true;
    for (c in text.chars()) {
        let letter = c >= 'a' && c <= 'z';
        if (!letter && (first || !((c >= '0' && c <= '9') || c == '-'))) {
            return null;
        }
        first = false;
    }
    return if (first) null else text;
}

/// The grants an `--allow` names, between commas — a class, or `file` and `net` with a scope after
/// `=` (`file=./data`, `net=example.com:443`; 01 S1, S8e) — `null` where one is neither.
fn allowed(text: string): ?string[] {
    let out = List<string>.new();
    for (part in text.split(',')) {
        let grant = part.trim().toString();
        let (name, scope) = splitGrant(grant);
        var known = false;
        for (c in classes) {
            if (c == name) {
                known = true;
            }
        }
        if (!known) {
            return null;
        }
        if (scope != null && (scope.isEmpty() || (name != "file" && name != "net"))) {
            return null;
        }
        out.push(grant);
    }
    return out.toArray();
}

/// A grant's class and its scope, `null` for none: `file=./data` is `("file", "./data")`.
fn splitGrant(grant: string): (string, ?string) {
    if (let k = grant.find("=")) {
        return (grant[0..k].toString(), grant[k + 1..grant.length()].toString());
    }
    return (grant, null);
}

/// The scopes `granted` gives the class `right`: `null` where it gives the whole class — a grant
/// without a scope, or `all` —, else the scopes, none where it gives none of it (S8e).
fn scopesOf(granted: string[], all: bool, right: string): ?string[] {
    if (all) {
        return null;
    }
    let out = List<string>.new();
    for (g in granted) {
        let (name, scope) = splitGrant(g);
        if (name == right) {
            if (let s = scope) {
                out.push(s);
            } else {
                return null;
            }
        }
    }
    return out.toArray();
}

/// What `uses` asks for that `granted` does not give — everything given where `all` (`-A`).
fn missing(uses: RightUse[], granted: string[], all: bool): RightUse[] {
    let out = List<RightUse>.new();
    if (all) {
        return [];
    }
    for (u in uses) {
        var given = false;
        for (g in granted) {
            if (splitGrant(g).0 == u.right) {
                given = true;
            }
        }
        if (!given) {
            out.push(u);
        }
    }
    return out.toArray();
}

/// The classes among `uses`, each once, in the order they are first asked for.
fn classesOf(uses: RightUse[]): string[] {
    let out = List<string>.new();
    for (u in uses) {
        var seen = false;
        for (c in out) {
            if (c == u.right) {
                seen = true;
            }
        }
        if (!seen) {
            out.push(u.right);
        }
    }
    return out.toArray();
}
