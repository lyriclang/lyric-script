    tempDir as fsTempDir,
    tempFile as fsTempFile,
};
import std.hash { DefaultHasher };
import std.io { IoError, SeekFrom, eprint, eprintln, flush, print, println, stderr, stdin, stdout };
import std.os {
    arch as osArch,
