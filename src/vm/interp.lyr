    cwd as osCwd,
    env,
    envs as osEnvs,
    hostname as osHostname,
    pid as osPid,
    platform as osPlatform,
    setCwd as osSetCwd,
    setEnv as osSetEnv,
    tempDir as osTempRoot,
};
import std.os { Signal, signals };
