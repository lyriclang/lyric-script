/// How a run ended.
pub enum Outcome {
    /// The entry function returned nothing.
    Void,
    /// The entry function returned a scalar, as its 64 bits.
    Scalar(uint64),
    /// The entry function returned a reference.
    Ref(HeapRef),
    /// The entry function returned a value of several slots.
    Slots(uint64[], HeapRef[]),
    /// The script panicked.
    Panic(ScriptPanic),
    /// An error left every frame (06 §5): its report.
    Error(ScriptError),
    /// The fuel ran out (design/v1, 01 S5); the run stopped at a backward jump or a call.
    Suspended,
    /// The script called `exit` with this code: no defer ran and no other task (12 rule 25).
    Exit(int),
    /// A task waits or gave way (S6a): the scheduler runs another; never the outcome of a run.
    Switch,
}

/// A panic of the script: its code, its message and the script's frames, innermost first.
pub struct ScriptPanic {
    pub code: string,
    pub message: string,
    pub trace: string[],
}

/// An error that left every frame: its type's name, its message, the messages of its causes in
/// order, and the frames it was thrown from, innermost first (05 E6, 01 S11).
pub struct ScriptError {
    pub typeName: string,
    pub message: string,
    pub causes: string[],
    pub trace: string[],
    /// The messages of the errors defers threw while it was in flight (S4e).
    pub suppressed: string[] = [],
}

/// The most causes a report follows: a cycle among them ends there (Lyric 5's bound).
pub let maxCauses: int = 64;

/// The report of an error that left every frame, while the VM asks it: `at` is the error asked —
/// for its message where `asking` is 0, its cause where 1 —, then the suppressed errors for
/// theirs (2).
class Report {
    typeName: string,
    trace: string[],
    messages: List<string>,
    var at: HeapRef,
    var asking: int = 0,
    suppressed: HeapRef[],
    suppressedTexts: List<string>,
    var nextSuppressed: int = 0,
}

/// The deepest recursion the VM runs before it reports a stack overflow.
pub let maxDepth: int = 10000;

/// A caller's frame while its callee runs.
struct CallFrame {
    function: int,
    pc: int,
    baseS: int,
    baseR: int,
}

/// The callers' frames while their callees run, in one array doubled where it runs out (S7j). A
/// `List<CallFrame>` cost a call a frame: its `push` lives in the instance unit of
/// `std.collections`, which no build inlines, and its `pop` gives an optional. The growth is a
/// method of its own, so that `push` stays small enough to be inlined.
class FrameStack {
    var data: CallFrame[],
    var n: int = 0,

    static fn new(): FrameStack {
        return FrameStack {
            data = [CallFrame { function = 0, pc = 0, baseS = 0, baseR = 0 }] * 256,
        };
    }

    fn length(): int {
        return this.n;
    }

    mut fn push(fr: CallFrame): void {
        if (this.n == this.data.length()) {
            this.grow();
        }
        this.data[this.n] = fr;
        this.n += 1;
    }

    mut fn grow(): void {
        let bigger = [CallFrame { function = 0, pc = 0, baseS = 0, baseR = 0 }] * (this.n * 2);
        var k = 0;
        while (k < this.n) {
            bigger[k] = this.data[k];
            k += 1;
        }
        this.data = bigger;
    }

    /// The frame on top, taken off; the stack holds one.
    mut fn take(): CallFrame {
        this.n -= 1;
        return this.data[this.n];
    }

    /// Frame `i`, the outermost 0.
    fn get(i: int): CallFrame {
        return this.data[i];
    }

    mut fn clear(): void {
        this.n = 0;
    }
}

/// Runs `entry` of `module` with `args` in its first scalar registers, with `fuel` units of
/// budget (a backward jump or a call costs one; `-1` runs without a limit), on a task of its
/// own: a panic of the VM itself becomes `Outcome.Panic` with the code `LYS-ICE0001`.
pub fn execute(
    module: Module,
    entry: string,
    args: uint64[],
    fuel: int,
    argv: string[] = []
): Outcome {
    let task = spawn(() => run(module, entry, args, fuel, argv));
    while (!task.isDone()) {
        try? yieldNow();
        // a VM that sleeps until a timer leaves this task nothing to wait for: no spinning (S6d3)
        if (!task.isDone()) {
            try? sleep(Duration.ofMillis(1));
        }
    }
    return match (task.status()) {
        .Done(outcome) => outcome,
        .Panicked(p) => Outcome.Panic(
            ScriptPanic {
                code = "LYS-ICE0001",
                message = f"the VM failed: {p.code}: {p.message}",
                trace = [p.trace],
            }
        ),
        _ => Outcome.Panic(
            ScriptPanic {
                code = "LYS-ICE0001",
                message = "the VM's task ended without a result",
                trace = [],
            }
        ),
    };
}

/// A task of the script (07 N4, 11 Co): its registers, its frames and where it stands, kept while
/// another task runs.
class TaskState {
    var s: uint64[],
    var r: HeapRef[],
    var frames: FrameStack,
    var fi: int,
    var pc: int = 0,
    var bs: int = 0,
    var br: int = 0,
    var report: ?Report = null,
    // the script's handle of a spawned task; none for the run's first
    var handle: ?ScriptTask = null,
    // S6c1: the task it waits for, where it waits for one — a cancel takes it out of their
    // waiters —, and whether it gave way and stands in the queue
    var waitingOn: ?ScriptTask = null,
    var yielded: bool = false,
    // S6d1: the channel or the semaphore it waits on; what a channel handed it; the value it waits
    // to send, and how the send ended — 1 taken, 2 the channel closed —; a permit handed to it
    var waitingChan: ?ScriptChannel = null,
    var waitingSem: ?ScriptSemaphore = null,
    var handoff: ?Item = null,
    var sendItem: ?Item = null,
    var sendState: int = 0,
    var granted: bool = false,
    // S6d2: the channels a select of it watches, and whether one of them stirred
    watching: List<ScriptChannel> = List<ScriptChannel>.new(),
    var woken: bool = false,
    // S6d3: the timer it sleeps on, and whether it slept
    var sleeping: ?TimerEntry = null,
    var slept: bool = false,
    // S6e: a native it waits for — the ticket of the one it waits for now, and what came
    var nativePending: bool = false,
    var nativeTicket: int = 0,
    var nativeToItsEnd: bool = false,
    var nativeDone: bool = false,
    var nativeAnswer: ?WaitAnswer = null,
    // what an error that left the task threw, and its record: what `await` throws again
    var thrown: HeapRef = nilRef(),
    var record: HeapRef = nilRef(),
    // S6b: the contexts that pulled the coroutine running now, the innermost last; the fields
    // above are the running context's
    pullers: List<Pull> = List<Pull>.new(),
}

/// Where code stands: a task's, or a coroutine's while it is parked (S6b).
class Context {
    var s: uint64[],
    var r: HeapRef[],
    var frames: FrameStack,
    var fi: int,
    var pc: int,
    var bs: int,
    var br: int,
    var report: ?Report,
}

/// A pull in progress: the context that pulled, at the instruction after its `co.next`, the
/// coroutine, and where the answer goes — the absolute registers of `co.next`'s `a` and `b`.
class Pull {
    ctx: Context,
    co: ScriptCoroutine,
    a: int,
    b: int,
    // a close's, not a pull's: the answer is only whether an error came (S6b3)
    closing: bool = false,
}

/// A coroutine as the script holds it (Lyric 5 10 §1; 07 N2): its closure, its context while it
/// is parked, the slots of what it yields and of its result, and its result once it has one.
/// Its state: 0 never pulled, 1 parked at a yield, 2 running, 3 ended.
pub class ScriptCoroutine :: [HeapRef] {
    env: HeapRef,
    ns: int,
    nr: int,
    rs: int,
    rr: int,
    var state: int = 0,
    var ctx: ?Context = null,
    var returned: bool = false,
    var resS: uint64[] = [],
    var resR: HeapRef[] = [],
    // the `Cancelled` a close threw into it, and the key of its `Y` for a yield outside its own
    // body (S6b3)
    var cancel: HeapRef = nilRef(),
    var ykey: int = -1,

    pub fn desc(): ?TypeDesc {
        return null;
    }
}

/// The context a coroutine starts in: its closure's function, the closure in `r[0]`; `null`
/// where the closure names no function.
fn coroutineStart(module: Module, env: HeapRef): ?Context {
    var target = -1;
    if (env is ScriptObject) {
        target = env.scalars[0] as int;
    }
    if (target < 0 || target >= module.functions.length()) {
        return null;
    }
    let callee = module.functions[target];
    let x = Context {
        s = [0 as uint64] * grown(0, callee.scalars),
        r = refArray(grown(0, callee.refs)),
        frames = FrameStack.new(),
        fi = target,
        pc = 0,
        bs = 0,
        br = 0,
        report = null,
    };
    x.r[0] = env;
    return x;
}

/// A task as the script holds it (07 N4): its state, what it ended with once it has, and the
/// tasks that wait for it.
pub class ScriptTask :: [HeapRef] {
    state: TaskState,
    var result: ?Outcome = null,
    waiters: List<TaskState>,
    // S6c1: cancelled, its waits throw `Cancelled`; detached, nobody waits for it
    var cancelled: bool = false,
    detached: bool = false,
    // S6c2: the task scope it belongs to; none for the top level's
    scope: ?ScriptScope = null,

    pub fn desc(): ?TypeDesc {
        return null;
    }
}

/// A value on its way through a channel: its slots (S6d1).
class Item {
    s: uint64[],
    r: HeapRef[],
}

/// A channel (Lyric 5 10 §6): its buffer, the tasks waiting to receive and to send — a sender's
/// value with it —, whether it is closed; `ns` and `nr` the slots of a value (S6d1).
pub class ScriptChannel :: [HeapRef] {
    capacity: int,
    ns: int,
    nr: int,
    buffer: List<Item>,
    receivers: List<TaskState>,
    senders: List<TaskState>,
    // S6d2: the tasks whose select watches it: woken when it can be received from
    watchers: List<TaskState> = List<TaskState>.new(),
    var closed: bool = false,
    // S7h4: what else ends with it — a subscription to signals, which ends at the close itself
    var closer: ?fn() -> void = null,

    pub fn desc(): ?TypeDesc {
        return null;
    }
}

/// A semaphore (Lyric 5 10 §10 rule 7): its permits, and the tasks waiting for one (S6d1).
pub class ScriptSemaphore :: [HeapRef] {
    var permits: int,
    waiters: List<TaskState>,

    pub fn desc(): ?TypeDesc {
        return null;
    }
}

/// A task scope (Lyric 5 10 §4): its tasks, the first of them to fail, whether it has closed
/// (S6c2).
pub class ScriptScope :: [HeapRef] {
    tasks: List<ScriptTask>,
    var failed: ?ScriptTask = null,
    var closed: bool = false,

    pub fn desc(): ?TypeDesc {
        return null;
    }
}

/// What every task of one run shares: the module, its globals, the descriptors made, the budget.
class RunShared {
    module: Module,
    gs: uint64[],
    gr: HeapRef[],
    interning: Interning,
    var budget: int,
    // what the run was started with, its own name first; a sandbox's are its host's to give
    argv: string[],
    // the code of an `exit`, which ends the run where a budget ends it
    var exitCode: ?int = null,
    // the tasks ready to run, from `head` on; every task spawned, in order (S6a)
    queue: List<TaskState>,
    var head: int = 0,
    // the objects numbered so far, for a hash by identity (01 S8; S7d1)
    var objects: int = 0,
    tasks: List<ScriptTask>,
    // the first task to end with an error or a panic: what the top level's end gives (07 End;
    // Lyric 5 10 §4 rule 2, §5 rule 3) — a later failure is none of the scope's
    var failed: ?ScriptTask = null,
    // S6d3: the run's timers, on its own monotonic clock
    timers: List<TimerEntry> = List<TimerEntry>.new(),
    var timerSeq: int = 0,
    clock: Monotonic = Monotonic.now(),
    // S6e: the script's tasks waiting for a native, and the Lyric 5 channel a native's task
    // signals its end on
    var pendingNatives: int = 0,
    wakeups: Channel<int> = Channel<int>.new(64),
    // S7h4: the run's subscriptions to signals, each Lyric 5's channel, and how many are still open:
    // an open one keeps a run whose tasks all wait waiting for a signal, not ended
    feeds: List<Channel<Signal>>,
    var openFeeds: int = 0,
}

/// A timer of the run (S6d3): its deadline, in nanoseconds of the run's clock — its sequence
/// number orders timers of one deadline —, and what it does then: wake a sleeping task, or close
/// a timer's channel.
class TimerEntry {
    deadline: int,
    seq: int,
    task: ?TaskState = null,
    channel: ?ScriptChannel = null,
}

/// The run's clock now, in nanoseconds (S6d3).
fn nowNs(shared: RunShared): int {
    return shared.clock.elapsed().nanos();
}

/// The timers whose time came, in the order of their deadlines: a sleeper wakes behind the ready
/// tasks, a timer's channel closes (Lyric 5 10 §2 rule 5, §7 rule 5).
fn fireDueTimers(shared: RunShared): void {
    if (shared.timers.length() == 0) {
        return;
    }
    let now = nowNs(shared);
    while (true) {
        var best = -1;
        var k = 0;
        while (k < shared.timers.length()) {
            let e = shared.timers[k];
            if (e.deadline <= now) {
                if (best < 0) {
                    best = k;
                } else {
                    let b = shared.timers[best];
                    if (e.deadline < b.deadline || (e.deadline == b.deadline && e.seq < b.seq)) {
                        best = k;
                    }
                }
            }
            k += 1;
        }
        if (best < 0) {
            return;
        }
        let e = shared.timers.removeAt(best);
        let st = e.task;
        if (st != null) {
            st.sleeping = null;
            shared.queue.push(st);
        }
        let ch = e.channel;
        if (ch != null) {
            closeChannel(ch, shared);
        }
    }
}

/// The earliest deadline of the run's timers (S6d3).
fn earliestDeadline(shared: RunShared): int {
    var best = shared.timers[0].deadline;
    for (e in shared.timers) {
        if (e.deadline < best) {
            best = e.deadline;
        }
    }
    return best;
}

/// Runs `entry` of `module` on the current task; see `execute`. Its end ends the subscriptions to
/// signals its script left open (S7h4): no signal is swallowed after it.
pub fn run(module: Module, entry: string, args: uint64[], fuel: int, argv: string[] = []): Outcome {
    let feeds = List<Channel<Signal>>.new();
    let out = runOn(module, entry, args, fuel, argv, feeds);
    for (f in feeds) {
        f.close();
    }
    return out;
}

/// Runs `entry` of `module`, its subscriptions to signals in `feeds`; see `run`.
fn runOn(
    module: Module,
    entry: string,
    args: uint64[],
    fuel: int,
    argv: string[],
    feeds: List<Channel<Signal>>
): Outcome {
    var fi = -1;
    var i = 0;
    while (i < module.functions.length()) {
        if (module.functions[i].name == entry) {
            fi = i;
        }
        i += 1;
    }
    if (fi < 0) {
        return Outcome.Panic(
            ScriptPanic { code = "LYS-ICE0001", message = f"no function '{entry}'", trace = [] }
        );
    }
    let first = module.functions[fi];
    let main = TaskState {
        s = [0 as uint64] * grown(0, first.scalars),
        r = refArray(grown(0, first.refs)),
        frames = FrameStack.new(),
        fi = fi,
    };
    var k = 0;
    while (k < args.length() && k < first.paramsS) {
        main.s[k] = args[k];
        k += 1;
    }
    // the script's top-level bindings (07 Top), alive for this run; the descriptors of this run:
    // the compiler's, and those shared copies make (S3i)
    let shared = RunShared {
        module = module,
        gs = [0 as uint64] * module.globalsS,
        gr = refArray(module.globalsR),
        interning = Interning.of(module),
        budget = fuel,
        argv = argv,
        queue = List<TaskState>.new(),
        tasks = List<ScriptTask>.new(),
        feeds = feeds,
    };
    // the scheduler (07 N8, 11 Co): one task at a time, each until it ends or waits
    shared.queue.push(main);
    while (true) {
        // S6d3: the timers whose time came wake behind the ready tasks; with none ready, the run
        // waits for the earliest — without timers that is a deadlock
        fireDueTimers(shared);
        // S6e: a native's Lyric 5 task gets its turn at every step while one is waited for, and
        // a subscription's while it is open (S7h4)
        if (shared.pendingNatives + shared.openFeeds > 0) {
            try? yieldNow();
        }
        if (shared.head >= shared.queue.length()) {
            // a native's end, a signal, or the earliest timer, ends the run's wait
            if (shared.pendingNatives + shared.openFeeds > 0) {
                if (shared.timers.length() > 0) {
                    let wait = earliestDeadline(shared) - nowNs(shared);
                    if (wait > 0) {
                        try? Select.on(shared.wakeups) { _ => { } }.timeout(
                            Duration.ofNanos(wait)
                        ) { }.run();
                    }
                } else {
                    try? shared.wakeups.recv();
                }
                continue;
            }
            if (shared.timers.length() == 0) {
                break;
            }
            let wait = earliestDeadline(shared) - nowNs(shared);
            if (wait > 0) {
                try? sleep(Duration.ofNanos(wait));
            }
            continue;
        }
        let t = shared.queue[shared.head];
        shared.head += 1;
        let out = runTask(t, shared);
        match (out) {
            .Switch => { }
            // the budget holds the whole instance (N8, 01 S5b), and `exit` ends it, from any task
            .Suspended | .Exit(_) => {
                return out;
            }
            _ => {
                let h = t.handle;
                if (h == null) {
                    // the run's first task: its end, after its `join`, is the run's
                    return out;
                }
                h.result = out;
                // a task of a scope fails its scope: the first cancels the scope's others (§4
                // rule 2, §5 rule 3)
                let sc = h.scope;
                if (sc != null) {
                    if (sc.failed == null && failedWith(module, h, out)) {
                        sc.failed = h;
                        for (x in sc.tasks) {
                            cancelTask(x, shared);
                        }
                    }
                } else if (shared.failed == null && !h.detached) {
                    // a task that ends with `Cancelled` is no failure (Lyric 5 10 §4 rule 2)
                    var failed = false;
                    match (out) {
                        .Error(_) => {
                            failed = !isCancelled(module, h.state.thrown);
                        }
                        .Panic(_) => {
                            failed = true;
                        }
                        _ => { }
                    }
                    if (failed) {
                        shared.failed = h;
                        // the first failure cancels the scope's other tasks (§4 rule 2, §5 rule 3;
                        // 07 End)
                        for (x in shared.tasks) {
                            if (!x.detached) {
                                cancelTask(x, shared);
                            }
                        }
                    }
                }
                // a detached task's panic ends the run: nobody could look at it (§5 rule 4)
                if (h.detached) {
                    match (out) {
                        .Panic(_) => {
                            return out;
                        }
                        _ => { }
                    }
                }
                for (w in h.waiters) {
                    w.waitingOn = null;
                    shared.queue.push(w);
                }
                h.waiters.clear();
            }
        }
    }
    return Outcome.Panic(
        ScriptPanic {
            code = "LYS-RT0018",
            message = "every task waits for another: none can go on",
            trace = [],
        }
    );
}

/// Whether `v` is the prelude's `Cancelled` (S6c1).
fn isCancelled(module: Module, v: HeapRef): bool {
    if (module.cancelledType < 0 || !(v is ScriptObject)) {
        return false;
    }
    return same(v.typeDesc, module.types[module.cancelledType]);
}

/// Whether task `h`, which ended with `out`, failed: an error other than `Cancelled`, or a panic
/// (Lyric 5 10 §4 rule 2, §5 rule 3).
fn failedWith(module: Module, h: ScriptTask, out: Outcome): bool {
    return match (out) {
        .Error(_) => !isCancelled(module, h.state.thrown),
        .Panic(_) => true,
        _ => false,
    };
}

/// A new `Cancelled`, which a wait in a cancelled task throws (S6c1).
fn newCancelled(module: Module): HeapRef {
    if (module.cancelledType < 0) {
        return nilRef();
    }
    let t = module.types[module.cancelledType];
    return ScriptObject {
        typeDesc = t,
        scalars = [0 as uint64] * t.scalarFields.length(),
        refs = refArray(t.refFields.length()),
    };
}

/// Cancels task `h` (Lyric 5 10 §3 rule 1): marked, so that its waits throw `Cancelled`, and taken
/// out of the wait it is in, which throws at once; a task that has ended stays as it ended.
fn cancelTask(h: ScriptTask, shared: RunShared): void {
    if (h.result != null) {
        return;
    }
    h.cancelled = true;
    let st = h.state;
    let w = st.waitingOn;
    if (w != null) {
        removeFrom(w.waiters, st);
        st.waitingOn = null;
        shared.queue.push(st);
    }
    // S6d1: a channel's or a semaphore's wait ends as well; a value it waited to send stays its own
    let ch = st.waitingChan;
    if (ch != null) {
        removeFrom(ch.receivers, st);
        removeFrom(ch.senders, st);
        st.waitingChan = null;
        st.sendItem = null;
        shared.queue.push(st);
    }
    let sem = st.waitingSem;
    if (sem != null) {
        removeFrom(sem.waiters, st);
        st.waitingSem = null;
        shared.queue.push(st);
    }
    // S6d2: a select's wait ends as well
    if (st.watching.length() > 0) {
        unwatchAll(st);
        shared.queue.push(st);
    }
    // S6e: and a native's
    if (st.nativePending && !st.nativeToItsEnd) {
        st.nativePending = false;
        shared.pendingNatives -= 1;
        shared.queue.push(st);
    }
    // S6d3: and a sleep
    let e = st.sleeping;
    if (e != null) {
        var k = 0;
        while (k < shared.timers.length()) {
            if (same(shared.timers[k], e)) {
                shared.timers.removeAt(k);
                break;
            }
            k += 1;
        }
        st.sleeping = null;
        shared.queue.push(st);
    }
}

/// Closes `ch` (Lyric 5 10 §6 rule 4): its receivers get none, its senders throw, its watchers
/// look again; a closed channel stays as it is.
fn closeChannel(ch: ScriptChannel, shared: RunShared): void {
    if (ch.closed) {
        return;
    }
    ch.closed = true;
    let closer = ch.closer;
    ch.closer = null;
    if (let f = closer) {
        f();
    }
    wakeWatchers(ch, shared);
    for (w in ch.receivers) {
        wake(w, shared);
    }
    ch.receivers.clear();
    for (w in ch.senders) {
        w.sendItem = null;
        w.sendState = 2;
        wake(w, shared);
    }
    ch.senders.clear();
}

/// Takes `st` off the watch of every channel its select watches (S6d2).
fn unwatchAll(st: TaskState): void {
    for (c in st.watching) {
        removeFrom(c.watchers, st);
    }
    st.watching.clear();
}

/// Wakes the selects that watch `ch`, which can be received from now: each looks at its cases
/// again (S6d2).
fn wakeWatchers(ch: ScriptChannel, shared: RunShared): void {
    for (w in ch.watchers.toArray()) {
        unwatchAll(w);
        w.woken = true;
        shared.queue.push(w);
    }
}

/// Takes `st` out of `list`, where it stands in it.
fn removeFrom(list: List<TaskState>, st: TaskState): void {
    var k = 0;
    while (k < list.length()) {
        if (same(list[k], st)) {
            list.removeAt(k);
            return;
        }
        k += 1;
    }
}

/// Wakes a task that waited on a channel or a semaphore: back into the queue (S6d1).
fn wake(st: TaskState, shared: RunShared): void {
    st.waitingChan = null;
    st.waitingSem = null;
    shared.queue.push(st);
}

/// A new `ChannelClosed`, which a send on a closed channel throws (S6d1).
fn newChannelClosed(module: Module): HeapRef {
    if (module.channelClosedType < 0) {
        return nilRef();
    }
    let t = module.types[module.channelClosedType];
    return ScriptObject {
        typeDesc = t,
        scalars = [0 as uint64] * t.scalarFields.length(),
        refs = refArray(t.refFields.length()),
    };
}

/// A pull's or a receive's answer with a value: no error, the value, its presence (S6d1).
fn delivered(s: uint64[], r: HeapRef[], a: int, b: int, item: Item): void {
    s[a] = 0 as uint64;
    var k = 0;
    while (k < item.s.length()) {
        s[a + 1 + k] = item.s[k];
        k += 1;
    }
    s[a + 1 + item.s.length()] = 1 as uint64;
    k = 0;
    while (k < item.r.length()) {
        r[b + k] = item.r[k];
        k += 1;
    }
}

/// Whether `x` and `y` are one object: `sameRef`'s kinds, and a coroutine and a task, which this
/// module holds (S6b3: a coroutine is an `Identity`, Lyric 5 10 §1 rule 14).
fn sameHeld(x: HeapRef, y: HeapRef): bool {
    if (x is ScriptCoroutine) {
        return y is ScriptCoroutine && same(x, y);
    }
    if (x is ScriptTask) {
        return y is ScriptTask && same(x, y);
    }
    return sameRef(x, y);
}

/// A pull's answer that the coroutine has ended: no error, no value — its slots cleared, its
/// presence 0 (S6b).
fn ended(s: uint64[], r: HeapRef[], a: int, b: int, ns: int, nr: int): void {
    s[a] = 0 as uint64;
    var k = 0;
    while (k <= ns) {
        s[a + 1 + k] = 0 as uint64;
        k += 1;
    }
    k = 0;
    while (k < nr) {
        r[b + k] = nil;
        k += 1;
    }
}

/// A native's panic: the dispatch, which holds the frames, reports it.
struct NativeFault {
    code: string,
    message: string,
}

/// Runs the native `which` on its scalars from `s[x]` and its references from `r[y]`; what it returns goes
/// where its first argument stood; its panic where it has one. Out of `runTask` (S7f2): Lyric 5
/// checks a function's entry against twice its temporaries, and the natives' arms in the loop took
/// that past a task's stack in the release profile, 256 KiB, whatever the frame really was.
fn callNative(
    which: NativeFn,
    s: uint64[],
    r: HeapRef[],
    x: int,
    y: int,
    shared: RunShared
): ?NativeFault {
    match (which) {
        .Print => print(textOf(r[y])),
        .Println => println(textOf(r[y])),
        .ConsoleEprint => eprint(textOf(r[y])),
        .ConsoleEprintln => eprintln(textOf(r[y])),
        .ConsoleFlushAll => flush(),
        .ConsolePut => {
            let p = r[y];
            if (!(p is ScriptBytes)) {
                return bytesFault("LYS-RT0007", "a Bytes' field holds no bytes");
            }
            if (charge(shared, bytesCost(p.data.length()))) {
                s[x] = consolePut(s[x] as int, p.data) as uint64;
            }
        }
        .ConsoleFlush => s[x] = consoleFlush(s[x] as int) as uint64,
        // the verifier keeps these to `call.w`
        .ConsoleLine | .ConsoleRead | .FsOpen | .FsRead | .FsWrite | .FsSeek | .FsClose | .FsMetadata | .FsCreateDir | .FsRemove | .FsRemoveDir | .FsRename | .FsCanonicalize | .FsAbsolute | .FsTempDir | .FsTempFile | .FsDirOpen | .FsDirNext | .FsDirClose | .OsCwd | .OsSetCwd | .OsHostname | .ProcessSpawn | .ProcessRead | .ProcessWrite | .ProcessClose | .ProcessWait | .ProcessSignal | .TimeZoneOpen => {
            return bytesFault("LYS-RT0007", "a native that waits called as one that does not");
        }
        .FsFile => r[y] = ScriptFile { },
        .ProcessChild => r[y] = ScriptChild { },
        .TimeZone => r[y] = ScriptZone { },
        .OsSignals => {
            if (let ch = signalChannel(r[y], r[y + 1], shared)) {
                r[y] = ch;
            } else {
                return bytesFault("LYS-RT0007", "signals takes the signals and a form of each");
            }
        }
        .FsDir => r[y] = ScriptDir { },
        .PathSeparator => r[y] = ScriptString { text = pathSeparator },
        .Concat => r[y] = ScriptString { text = textOf(r[y]) + textOf(r[y + 1]) },
        .IntToStr => r[y] = ScriptString { text = f"{s[x] as int}" },
        // Lyric 5's shortest text that reads back, `1.0` for an integral float
        .FloatToStr => r[y] = ScriptString { text = f"{float.fromBits(s[x])}" },
        .BoolToStr => r[y] = ScriptString { text = if (s[x] != 0) "true" else "false" },
        .CharToStr => r[y] = ScriptString { text = f"{(s[x] as uint32) as char}" },
        .StrEq => s[x] = truth(textOf(r[y]) == textOf(r[y + 1])),
        .StrCmp => {
            let p = textOf(r[y]);
            let q = textOf(r[y + 1]);
            s[x] = (if (p < q) -1 else if (p == q) 0 else 1) as uint64;
        }
        .TraceText => {
            let lines = List<string>.new();
            for (line in recordLines(shared.module, r[y])) {
                lines.push(f"    {line}");
            }
            r[y] = ScriptString { text = lines.toArray().join("\n") };
        }
        .OsArgCount => {
            s[x] = shared.argv.length() as uint64;
        }
        .OsArg => {
            r[y] = ScriptString { text = shared.argv[s[x] as int] };
        }
        .OsExit => {
            shared.exitCode = s[x] as int;
            shared.budget = -2;
        }
        // the whole environment, `name=value` each and a NUL after it (S7h2)
        .OsEnvs => {
            let out = StringBuilder.new();
            for ((name, value) in osEnvs()) {
                out.appendStr(name);
                out.appendChar('=');
                out.appendStr(value);
                out.appendChar('\0');
            }
            let text = out.toString();
            if (charge(shared, bytesCost(text.length()))) {
                r[y] = ScriptString { text = text };
            }
        }
        .OsSetEnv => {
            let name = textOf(r[y]);
            let value = textOf(r[y + 1]);
            if (charge(shared, bytesCost(name.length() + value.length()))) {
                osSetEnv(name, value);
            }
        }
        .OsPlatform => {
            s[x] = match (osPlatform()) {
                .Linux => 1 as uint64,
                .MacOS => 2 as uint64,
                .Windows => 3 as uint64,
                _ => 0 as uint64,
            };
        }
        .OsArch => {
            s[x] = match (osArch()) {
                .X86_64 => 1 as uint64,
                .Aarch64 => 2 as uint64,
                _ => 0 as uint64,
            };
        }
        .OsTempRoot => {
            r[y] = ScriptString { text = osTempRoot() };
        }
        .OsCpuCount => {
            s[x] = osCpuCount() as uint64;
        }
        .OsPid => {
            s[x] = osPid() as uint64;
        }
        // the wall clock's nanoseconds since 1970, and the run's own monotonic clock (S7h5): the one
        // its timers keep
        .TimeRealtime => {
            s[x] = epochNanos(Instant.now()) as uint64;
        }
        .TimeMonotonic => {
            s[x] = nowNs(shared) as uint64;
        }
        // what a zone of rules says at a moment, its nanoseconds since 1970 (S7h6a): the offset in
        // seconds twice, the lowest bit daylight time; the abbreviation into the holder
        .TimeZoneAt => {
            let o = r[y];
            if (o is ScriptZone) {
                if (let zone = o.zone) {
                    let epoch = try! Instant.parse("1970-01-01T00:00:00Z");
                    let info = zone.infoAt(epoch + Duration.ofNanos(s[x] as int));
                    let h = r[y + 1];
                    if (h is ScriptArray) {
                        h.r[0] = ScriptString { text = info.abbreviation };
                    }
                    s[x] = (info.offset.secs() * 2 + (if (info.isDst) 1 else 0)) as uint64;
                    return null;
                }
            }
            return bytesFault("LYS-RT0007", "a Zone's field holds no zone");
        }
        .OsEnv => {
            if (let v = env(textOf(r[y]))) {
                r[y] = ScriptString { text = v };
            } else {
                r[y] = nil;
            }
        }
        // the sign bit set: the other bits turned over, so the integers' order is the
        // total order (S7c5b)
        .FloatOrderKey => {
            let mask: uint64 = 0x7FFFFFFFFFFFFFFF;
            let b = s[x];
            s[x] = if ((b >> 63) != 0) b ^ mask else b;
        }
        // a hash's mixing (S7d1): SipHash-1-3 under the process's key, a word or a
        // string's bytes into the state
        .HashMixInt => {
            var h = DefaultHasher.new();
            h.writeUint(s[x]);
            h.writeUint(s[x + 1]);
            s[x] = h.finish();
        }
        .HashMixStr => {
            var h = DefaultHasher.new();
            h.writeUint(s[x]);
            textOf(r[y]).hash(&h);
            s[x] = h.finish();
        }
        // an object's number for a hash by identity, given at its first (01 S8); a
        // value the VM holds otherwise has none of its own
        .ObjectNumber => {
            let o = r[y];
            if (o is ScriptObject) {
                if (o.number == 0) {
                    shared.objects += 1;
                    o.number = shared.objects;
                }
                s[x] = o.number as uint64;
            } else {
                s[x] = 0;
            }
        }
        // a map's index (S7d2): where each hash is, the places in the order they came
        .IndexNew => {
            r[y] = ScriptIndex { table = Map<uint64, List<int>>.new() };
        }
        .IndexAdd => {
            let o = r[y];
            if (o is ScriptIndex) {
                if (let places = o.table.get(s[x])) {
                    places.push(s[x + 1] as int);
                } else {
                    let places = List<int>.new();
                    places.push(s[x + 1] as int);
                    o.table.insert(s[x], places);
                }
            }
        }
        .IndexFirst => {
            let o = r[y];
            var found = -1;
            if (o is ScriptIndex) {
                if (let places = o.table.get(s[x])) {
                    if (places.length() > 0) {
                        found = places[0];
                    }
                }
            }
            s[x] = found as uint64;
        }
        .IndexNext => {
            let o = r[y];
            var found = -1;
            if (o is ScriptIndex) {
                if (let places = o.table.get(s[x])) {
                    let at = s[x + 1] as int;
                    var k = 0;
                    while (k < places.length() - 1 && found < 0) {
                        if (places[k] == at) {
                            found = places[k + 1];
                        }
                        k += 1;
                    }
                }
            }
            s[x] = found as uint64;
        }
        .IndexRemove => {
            let o = r[y];
            if (o is ScriptIndex) {
                if (let places = o.table.get(s[x])) {
                    let at = s[x + 1] as int;
                    let kept = List<int>.new();
                    for (p in places) {
                        if (p != at) {
                            kept.push(p);
                        }
                    }
                    if (kept.length() == 0) {
                        o.table.remove(s[x]);
                    } else {
                        o.table.insert(s[x], kept);
                    }
                }
            }
        }
        .IndexClear => {
            let o = r[y];
            if (o is ScriptIndex) {
                o.table.clear();
            }
        }
        // the strings' members (S7e1): Lyric 5's string under them, its bytes read
        // once for the bounds of the characters
        .StrLen => s[x] = textOf(r[y]).length() as uint64,
        .StrAt => {
            let o = r[y];
            let t = textOf(o);
            let i = s[x] as int;
            let n = t.length();
            if (i < 0 || i >= n) {
                return NativeFault {
                    code = "LYS-RT0003",
                    message = f"index {i} out of bounds for length {n}",
                };
            }
            if (!beginsChar(o, i)) {
                return NativeFault {
                    code = "LYS-RT0003",
                    message = f"byte {i} does not begin a character",
                };
            }
            s[x] = (t[i] as uint32) as uint64;
        }
        .StrNext => {
            let b = bytesOf(r[y]);
            var i = (s[x] as int) + 1;
            while (i < b.length() && (b[i] & 192) == 128) {
                i += 1;
            }
            s[x] = i as uint64;
        }
        .StrPrev => {
            let b = bytesOf(r[y]);
            var i = (s[x] as int) - 1;
            while (i > 0 && (b[i] & 192) == 128) {
                i -= 1;
            }
            s[x] = i as uint64;
        }
        .StrSlice => {
            let o = r[y];
            let t = textOf(o);
            let a = s[x] as int;
            let e = s[x + 1] as int;
            let n = t.length();
            if (a < 0 || a > e || e > n) {
                return NativeFault {
                    code = "LYS-RT0003",
                    message = f"range {a}..{e} out of bounds for length {n}",
                };
            }
            for (at in [a, e]) {
                if (!beginsChar(o, at)) {
                    return NativeFault {
                        code = "LYS-RT0003",
                        message = f"byte {at} does not begin a character",
                    };
                }
            }
            r[y] = ScriptString { text = t[a..e].toString() };
        }
        .StrCharCount => s[x] = textOf(r[y]).charCount() as uint64,
        .StrUpper => r[y] = ScriptString { text = textOf(r[y]).toUpper() },
        .StrLower => r[y] = ScriptString { text = textOf(r[y]).toLower() },
        .StrTrim => {
            let t = textOf(r[y]);
            let mode = s[x] as int;
            let kept = if (mode == 1) t.trimStart() else if (mode == 2) t.trimEnd() else t.trim();
            r[y] = ScriptString { text = kept.toString() };
        }
        .StrRepeat => {
            let n = s[x] as int;
            if (n < 0) {
                return NativeFault {
                    code = "LYS-RT0007",
                    message = f"repeat count {n} is negative",
                };
            }
            r[y] = ScriptString { text = textOf(r[y]) * n };
        }
        .StrFromChars => {
            let o = r[y];
            let out = StringBuilder.new();
            if (o is ScriptArray) {
                var k = 0;
                while (k < o.n) {
                    out.appendChar(charOfCode(o.s[k]));
                    k += 1;
                }
            }
            r[y] = ScriptString { text = out.toString() };
        }
        .StrFind => {
            let o = r[y];
            let t = textOf(o);
            let from = s[x] as int;
            var found = -1;
            if (from >= 0 && from <= t.length() && beginsChar(o, from)) {
                if (let k = t[from..t.length()].find(textOf(r[y + 1]))) {
                    found = from + k;
                }
            }
            s[x] = found as uint64;
        }
        .StrMatchesAt => {
            let o = r[y];
            let t = textOf(o);
            let at = s[x] as int;
            s[x] = truth(
                at >= 0
                    && at <= t.length()
                    && beginsChar(o, at)
                    && t[at..t.length()].startsWith(textOf(r[y + 1]))
            );
        }
        .CharCategory => s[x] = categoryIndex(charOfCode(s[x]).category()) as uint64,
        .CharWhite => s[x] = truth(charOfCode(s[x]).isWhitespace()),
        .CharUpper => s[x] = (charOfCode(s[x]).toUpper() as uint32) as uint64,
        .CharLower => s[x] = (charOfCode(s[x]).toLower() as uint32) as uint64,
        // a builder of text (S7e3)
        .BuilderNew => r[y] = ScriptBuilder { sb = StringBuilder.new() },
        .BuilderAppendStr => {
            let o = r[y];
            if (o is ScriptBuilder) {
                o.sb.appendStr(textOf(r[y + 1]));
            }
        }
        .BuilderAppendChar => {
            let o = r[y];
            if (o is ScriptBuilder) {
                o.sb.appendChar(charOfCode(s[x]));
            }
        }
        .BuilderLength => {
            let o = r[y];
            s[x] = (if (o is ScriptBuilder) o.sb.length() else 0) as uint64;
        }
        .BuilderClear => {
            let o = r[y];
            if (o is ScriptBuilder) {
                o.sb.clear();
            }
        }
        .BuilderText => {
            let o = r[y];
            r[y] = ScriptString { text = if (o is ScriptBuilder) o.sb.toString() else "" };
        }
        .StrDebug => r[y] = ScriptString { text = textOf(r[y]).debug() },
        .CharDebug => r[y] = ScriptString { text = charOfCode(s[x]).debug() },
        // the format language (S7e4b): Lyric 5's own formatting, the spec checked
        // before — by the compiler, or at run time through `fmt.problem`
        .FmtInt => {
            let b = StringBuilder.new();
            fstringFormatted(b, s[x] as int, textOf(r[y]));
            r[y] = ScriptString { text = b.toString() };
        }
        .FmtFloat => {
            let b = StringBuilder.new();
            fstringFormatted(b, float.fromBits(s[x]), textOf(r[y]));
            r[y] = ScriptString { text = b.toString() };
        }
        .FmtStr => {
            let b = StringBuilder.new();
            fstringFormatted(b, textOf(r[y]), textOf(r[y + 1]));
            r[y] = ScriptString { text = b.toString() };
        }
        .FmtPad => {
            let b = StringBuilder.new();
            fstringPadded(b, textOf(r[y]), textOf(r[y + 1]));
            r[y] = ScriptString { text = b.toString() };
        }
        // an integer's bits (S7f1): Lyric 5's own `Integer` members; a float is its
        // bits in a register already
        .IntBits => {
            let v = s[x] as int;
            let k = s[x + 1] as int;
            let n = if (k == 0) v.leadingZeros()
                else if (k == 1) v.trailingZeros() else v.popCount();
            s[x] = n as uint64;
        }
        .IntRotate => s[x] = (s[x] as int).rotateLeft(s[x + 1] as int) as uint64,
        .FloatFromBits | .FloatToBits => { }
        .BigFromInt | .BigAdd | .BigSub | .BigMul | .BigDiv | .BigRem | .BigNeg | .BigCmp | .BigText | .BigParse | .BigFitsInt | .BigToInt | .BigToFloat | .BigShl | .BigShr | .BigBitLength | .BigHash => {
            return bigNative(which, s, r, x, y, shared);
        }
        .BytesCopy | .BytesFind | .BytesNew | .BytesOfText | .BytesOfLatin1 | .BytesOfList | .BytesToList | .BytesLen | .BytesGet | .BytesSet | .BytesPush | .BytesTruncate | .BytesSlice | .BytesAppend | .BytesCmp | .BytesMix | .BytesFill | .BytesBadUtf8 | .BytesText => {
            return bytesNative(which, s, r, x, y, shared);
        }
        .RandomSeeded => r[y] = ScriptRandom { gen = Random.seeded(s[x]) },
        .RandomFresh => r[y] = ScriptRandom { gen = Random.fresh() },
        .RandomInt | .RandomInRange | .RandomFloat | .RandomNormal => {
            let o = r[y];
            if (!(o is ScriptRandom)) {
                return NativeFault {
                    code = "LYS-RT0007",
                    message = "a Random's field holds no generator",
                };
            }
            s[x] = match (which) {
                .RandomInt => o.gen.nextUint64(),
                .RandomInRange => o.gen.nextInRange(s[x] as int..s[x + 1] as int) as uint64,
                .RandomFloat => o.gen.nextFloat().toBits(),
                _ => o.gen.nextNormal(float.fromBits(s[x]), float.fromBits(s[x + 1])).toBits(),
            };
        }
        .MathOne => s[x] = mathOne(s[x] as int, float.fromBits(s[x + 1])).toBits(),
        .MathTwo => s[x] = mathTwo(
            s[x] as int,
            float.fromBits(s[x + 1]),
            float.fromBits(s[x + 2])
        ).toBits(),
        .FmtProblem => {
            let problem = fmtProblem(textOf(r[y]), fmtKindOf(s[x] as int));
            r[y] = ScriptString { text = problem ?? "" };
        }
        .FloatOfText => {
            let v = (try? float.parse(textOf(r[y]))) ?? 0.0;
            s[x] = v.toBits();
        }
        // a list sorted in place (S7c6c2): its length unchanged, a walk goes on
        .ListSortInts => {
            let o = r[y];
            if (o is ScriptArray) {
                let keys = List<int>.new();
                var k = 0;
                while (k < o.n) {
                    keys.push(o.s[k] as int);
                    k += 1;
                }
                let sorted = keys.toArray();
                sorted.sort();
                k = 0;
                while (k < o.n) {
                    o.s[k] = sorted[k] as uint64;
                    k += 1;
                }
            }
        }
        // a float's place in the total order as an int, and back
        .ListSortFloats => {
            let o = r[y];
            if (o is ScriptArray) {
                let mask: uint64 = 0x7FFFFFFFFFFFFFFF;
                let keys = List<int>.new();
                var k = 0;
                while (k < o.n) {
                    let b = o.s[k];
                    keys.push((if ((b >> 63) != 0) b ^ mask else b) as int);
                    k += 1;
                }
                let sorted = keys.toArray();
                sorted.sort();
                k = 0;
                while (k < o.n) {
                    let key = sorted[k] as uint64;
                    o.s[k] = if ((key >> 63) != 0) key ^ mask else key;
                    k += 1;
                }
            }
        }
        .ListSortStrings => {
            let o = r[y];
            if (o is ScriptArray) {
                let items = List<HeapRef>.new();
                var k = 0;
                while (k < o.n) {
                    items.push(o.r[k]);
                    k += 1;
                }
                let sorted = items.toArray();
                sorted.sortByKey((h) => textOf(h));
                k = 0;
                while (k < o.n) {
                    o.r[k] = sorted[k];
                    k += 1;
                }
            }
        }
    }
    return null;
}

/// Runs task `t` from where it stands until it ends — its outcome — or waits.
fn runTask(t: TaskState, shared: RunShared): Outcome {
    let module = shared.module;
    let interning = shared.interning;
    let gs = shared.gs;
    let gr = shared.gr;
    var fi = t.fi;
    var f = module.functions[fi];
    var s = t.s;
    var r = t.r;
    var frames = t.frames;
    // the report of an error no frame took, once one is asked (S4a)
    var report = t.report;
    var code: Instr[] = f.code;
    var pc = t.pc;
    var bs = t.bs;
    var br = t.br;
    // S6b3: a close's `Cancelled`, thrown at the yield the coroutine parked at, from the register
    // above the frame's
    var inject = false;
    while (true) {
        // the injected throw is the `Throw` arm's to clear: no write a step (S7j)
        let ins = if (inject) Instr { op = .Throw, a = f.refs as uint16, b = 0, c = 0 }
            else code[pc];
        let a = ins.a as int;
        let b = ins.b as int;
        let c = ins.c as int;
        match (ins.op) {
            .MoveS => {
                s[bs + a] = s[bs + b];
                pc += 1;
            }
            .MoveR => {
                r[br + a] = r[br + b];
                pc += 1;
            }
            .LoadI => {
                s[bs + a] = signed16(b) as uint64;
                pc += 1;
            }
            .LoadK => {
                s[bs + a] = f.constants[b];
                pc += 1;
            }
            .LoadStr => {
                r[br + a] = ScriptString { text = f.strings[b] };
                pc += 1;
            }
            .LoadNull => {
                r[br + a] = nil;
                pc += 1;
            }
            .AddI => {
                let z = (s[bs + b] as int).checkedAdd(s[bs + c] as int);
                if (z == null) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0002", "integer overflow");
                }
                s[bs + a] = z as uint64;
                pc += 1;
            }
            .SubI => {
                let z = (s[bs + b] as int).checkedSub(s[bs + c] as int);
                if (z == null) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0002", "integer overflow");
                }
                s[bs + a] = z as uint64;
                pc += 1;
            }
            .MulI => {
                let z = (s[bs + b] as int).checkedMul(s[bs + c] as int);
                if (z == null) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0002", "integer overflow");
                }
                s[bs + a] = z as uint64;
                pc += 1;
            }
            .DivI | .RemI => {
                let y = s[bs + c] as int;
                if (y == 0) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0001",
                        "integer division by zero"
                    );
                }
                let x = s[bs + b] as int;
                // a match, not `==`: `==` on `Op` is a call into std.core (S7j)
                let z = match (ins.op) {
                    .DivI => x.checkedDiv(y),
                    _ => x.checkedRem(y),
                };
                if (z == null) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0002", "integer overflow");
                }
                s[bs + a] = z as uint64;
                pc += 1;
            }
            .NegI => {
                let z = (0).checkedSub(s[bs + b] as int);
                if (z == null) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0002", "integer overflow");
                }
                s[bs + a] = z as uint64;
                pc += 1;
            }
            .AddImm => {
                let z = (s[bs + b] as int).checkedAdd(signed16(c));
                if (z == null) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0002", "integer overflow");
                }
                s[bs + a] = z as uint64;
                pc += 1;
            }
            .AddF => {
                s[bs + a] = (float.fromBits(s[bs + b]) + float.fromBits(s[bs + c])).toBits();
                pc += 1;
            }
            .SubF => {
                s[bs + a] = (float.fromBits(s[bs + b]) - float.fromBits(s[bs + c])).toBits();
                pc += 1;
            }
            .MulF => {
                s[bs + a] = (float.fromBits(s[bs + b]) * float.fromBits(s[bs + c])).toBits();
                pc += 1;
            }
            .DivF => {
                s[bs + a] = (float.fromBits(s[bs + b]) / float.fromBits(s[bs + c])).toBits();
                pc += 1;
            }
            .NegF => {
                s[bs + a] = (-float.fromBits(s[bs + b])).toBits();
                pc += 1;
            }
            .EqI => {
                s[bs + a] = truth(s[bs + b] == s[bs + c]);
                pc += 1;
            }
            .NeI => {
                s[bs + a] = truth(s[bs + b] != s[bs + c]);
                pc += 1;
            }
            .LtI => {
                s[bs + a] = truth((s[bs + b] as int) < (s[bs + c] as int));
                pc += 1;
            }
            .LeI => {
                s[bs + a] = truth((s[bs + b] as int) <= (s[bs + c] as int));
                pc += 1;
            }
            .EqF => {
                s[bs + a] = truth(float.fromBits(s[bs + b]) == float.fromBits(s[bs + c]));
                pc += 1;
            }
            .NeF => {
                s[bs + a] = truth(float.fromBits(s[bs + b]) != float.fromBits(s[bs + c]));
                pc += 1;
            }
            .LtF => {
                s[bs + a] = truth(float.fromBits(s[bs + b]) < float.fromBits(s[bs + c]));
                pc += 1;
            }
            .LeF => {
                s[bs + a] = truth(float.fromBits(s[bs + b]) <= float.fromBits(s[bs + c]));
                pc += 1;
            }
            .Same => {
                s[bs + a] = truth(sameHeld(r[br + b], r[br + c]));
                pc += 1;
            }
            .Not => {
                s[bs + a] = truth(s[bs + b] == 0);
                pc += 1;
            }
            .IToF => {
                s[bs + a] = ((s[bs + b] as int) as float).toBits();
                pc += 1;
            }
            .FToI => {
                s[bs + a] = (float.fromBits(s[bs + b]) as int) as uint64;
                pc += 1;
            }
            .Jump => {
                if (a <= pc) {
                    // without a limit (-1) nothing is spent: one read, no write (S7j)
                    if (shared.budget != -1) {
                        shared.budget = spend(shared.budget);
                        if (shared.budget == -2) {
                            return Outcome.Suspended;
                        }
                    }
                }
                pc = a;
            }
            .JumpIf | .JumpIfNot => {
                let whenTrue = match (ins.op) {
                    .JumpIf => true,
                    _ => false,
                };
                let taken = (s[bs + a] != 0) == whenTrue;
                if (taken) {
                    if (b <= pc) {
                        // without a limit (-1) nothing is spent: one read, no write (S7j)
                        if (shared.budget != -1) {
                            shared.budget = spend(shared.budget);
                            if (shared.budget == -2) {
                                return Outcome.Suspended;
                            }
                        }
                    }
                    pc = b;
                } else {
                    pc += 1;
                }
            }
            .JumpLtI => {
                if ((s[bs + a] as int) < (s[bs + b] as int)) {
                    if (c <= pc) {
                        // without a limit (-1) nothing is spent: one read, no write (S7j)
                        if (shared.budget != -1) {
                            shared.budget = spend(shared.budget);
                            if (shared.budget == -2) {
                                return Outcome.Suspended;
                            }
                        }
                    }
                    pc = c;
                } else {
                    pc += 1;
                }
            }
            // its own arm, as `jump.lt.i`: the test sits in every loop's back edge (S7k1b)
            .JumpLeI => {
                if ((s[bs + a] as int) <= (s[bs + b] as int)) {
                    if (c <= pc) {
                        // without a limit (-1) nothing is spent: one read, no write (S7j)
                        if (shared.budget != -1) {
                            shared.budget = spend(shared.budget);
                            if (shared.budget == -2) {
                                return Outcome.Suspended;
                            }
                        }
                    }
                    pc = c;
                } else {
                    pc += 1;
                }
            }
            .Call => {
                // without a limit (-1) nothing is spent: one read, no write (S7j)
                if (shared.budget != -1) {
                    shared.budget = spend(shared.budget);
                    if (shared.budget == -2) {
                        return Outcome.Suspended;
                    }
                }
                if (frames.length() >= maxDepth) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0006", "stack overflow");
                }
                let callee = module.functions[a];
                frames.push(CallFrame { function = fi, pc = pc + 1, baseS = bs, baseR = br });
                bs += b;
                br += c;
                if (bs + callee.scalars > s.length()) {
                    s = growScalars(s, bs + callee.scalars);
                }
                if (br + callee.refs > r.length()) {
                    r = growRefs(r, br + callee.refs);
                }
                fi = a;
                f = callee;
                code = f.code;
                pc = 0;
            }
            .Ret | .RetS | .RetR | .RetN => {
                match (ins.op) {
                    .RetS => {
                        s[bs] = s[bs + a];
                    }
                    .RetR => {
                        r[br] = r[br + a];
                    }
                    .RetN => {
                        // the result's slots to the bases: from higher registers to lower ones,
                        // in order, so an overlap reads before it writes
                        var k = 0;
                        while (k < f.retS) {
                            s[bs + k] = s[bs + a + k];
                            k += 1;
                        }
                        k = 0;
                        while (k < f.retR) {
                            r[br + k] = r[br + b + k];
                            k += 1;
                        }
                    }
                    _ => { }
                }
                if (frames.length() == 0) {
                    // S6b: a coroutine's body ended — its result kept, its pull answers that no
                    // value came (Lyric 5 10 §1 rules 3–5)
                    let p = t.pullers.pop();
                    if (p != null) {
                        let co = p.co;
                        if (ins.op == .RetS) {
                            co.resS = [s[bs]];
                        } else if (ins.op == .RetR) {
                            co.resR = [r[br]];
                        } else if (ins.op == .RetN) {
                            co.resS = firstScalars(s, bs, f.retS);
                            co.resR = firstRefs(r, br, f.retR);
                        }
                        co.returned = true;
                        co.state = 3;
                        co.ctx = null;
                        let x = p.ctx;
                        s = x.s;
                        r = x.r;
                        frames = x.frames;
                        fi = x.fi;
                        f = module.functions[fi];
                        code = f.code;
                        pc = x.pc;
                        bs = x.bs;
                        br = x.br;
                        report = x.report;
                        if (p.closing) {
                            s[p.a] = 0 as uint64;
                        } else {
                            ended(s, r, p.a, p.b, co.ns, co.nr);
                        }
                        continue;
                    }
                    return match (ins.op) {
                        .RetS => Outcome.Scalar(s[bs]),
                        .RetR => Outcome.Ref(r[br]),
                        .RetN => Outcome.Slots(
                            firstScalars(s, bs, f.retS),
                            firstRefs(r, br, f.retR)
                        ),
                        _ => Outcome.Void,
                    };
                }
                let back = frames.take();
                if (back.function < 0) {
                    // a report's call returned: the message, then the cause, then its message
                    let rep = report;
                    if (rep == null) {
                        return panicOut(
                            module,
                            frames,
                            fi,
                            pc,
                            "LYS-ICE0001",
                            "a return to no report"
                        );
                    }
                    var next: HeapRef = nil;
                    var slot = -1;
                    if (rep.asking == 0) {
                        rep.messages.push(textOf(r[br]));
                        if (rep.messages.length() <= maxCauses) {
                            next = rep.at;
                            slot = module.errorCause;
                            rep.asking = 1;
                        }
                    } else if (rep.asking == 1) {
                        let cause = r[br];
                        if (cause is ScriptObject) {
                            rep.at = cause;
                            next = cause;
                            slot = module.errorMessage;
                            rep.asking = 0;
                        }
                    } else {
                        rep.suppressedTexts.push(textOf(r[br]));
                    }
                    // the chain told: the suppressed errors' messages (Lyric 5 06 §5 rule 3)
                    if (slot < 0 && rep.nextSuppressed < rep.suppressed.length()) {
                        next = rep.suppressed[rep.nextSuppressed];
                        rep.nextSuppressed += 1;
                        slot = module.errorMessage;
                        rep.asking = 2;
                    }
                    let target = methodIn(module, next, slot);
                    if (target < 0) {
                        return Outcome.Error(errorOf(rep));
                    }
                    frames.push(CallFrame { function = -1, pc = 0, baseS = bs, baseR = br });
                    r[br] = next;
                    fi = target;
                    f = module.functions[fi];
                    code = f.code;
                    pc = 0;
                    if (bs + f.scalars > s.length()) {
                        s = growScalars(s, bs + f.scalars);
                    }
                    if (br + f.refs > r.length()) {
                        r = growRefs(r, br + f.refs);
                    }
                } else {
                    fi = back.function;
                    f = module.functions[fi];
                    code = f.code;
                    pc = back.pc;
                    bs = back.baseS;
                    br = back.baseR;
                }
            }
            .New => {
                let t = module.types[b];
                r[br + a] = ScriptObject {
                    typeDesc = t,
                    scalars = [0 as uint64] * t.scalarFields.length(),
                    refs = refArray(t.refFields.length()),
                };
                pc += 1;
            }
            .GetS => {
                let o = r[br + b];
                if (o is ScriptObject) {
                    s[bs + a] = o.scalars[c];
                } else {
                    return panicOut(module, frames, fi, pc, "LYS-RT0004", "a field of null read");
                }
                pc += 1;
            }
            .SetS => {
                let o = r[br + a];
                if (o is ScriptObject) {
                    o.scalars[b] = s[bs + c];
                } else {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0004",
                        "a field of null written"
                    );
                }
                pc += 1;
            }
            .GetR => {
                let o = r[br + b];
                if (o is ScriptObject) {
                    r[br + a] = o.refs[c];
                } else {
                    return panicOut(module, frames, fi, pc, "LYS-RT0004", "a field of null read");
                }
                pc += 1;
            }
            .SetR => {
                let o = r[br + a];
                if (o is ScriptObject) {
                    o.refs[b] = r[br + c];
                } else {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0004",
                        "a field of null written"
                    );
                }
                pc += 1;
            }
            .Panic => {
                let m = r[br + a];
                let text = if (m is ScriptString) m.text else "panic";
                return panicOut(module, frames, fi, pc, "LYS-RT0008", text);
            }
            // a panic of the code `b`: `try!` on an error is `LYS-RT0010` (S4d)
            .PanicC => {
                let m = r[br + a];
                let text = if (m is ScriptString) m.text else "panic";
                let code = if (b < 10) f"LYS-RT000{b}" else f"LYS-RT00{b}";
                return panicOut(module, frames, fi, pc, code, text);
            }
            .AddW => {
                s[bs + a] = ((s[bs + b] as int) +% (s[bs + c] as int)) as uint64;
                pc += 1;
            }
            .SubW => {
                s[bs + a] = ((s[bs + b] as int) -% (s[bs + c] as int)) as uint64;
                pc += 1;
            }
            .MulW => {
                s[bs + a] = ((s[bs + b] as int) *% (s[bs + c] as int)) as uint64;
                pc += 1;
            }
            .BAnd => {
                s[bs + a] = s[bs + b] & s[bs + c];
                pc += 1;
            }
            .BOr => {
                s[bs + a] = s[bs + b] | s[bs + c];
                pc += 1;
            }
            .BXor => {
                s[bs + a] = s[bs + b] ^ s[bs + c];
                pc += 1;
            }
            .Shl | .Shr => {
                // a count the width cannot take is an overflow, as in Lyric 5 (no silent masking)
                let count = s[bs + c] as int;
                if (count < 0 || count >= 64) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0002",
                        f"shift by {count} exceeds the width of 64 bits"
                    );
                }
                let x = s[bs + b] as int;
                let shifted = match (ins.op) {
                    .Shl => x << count,
                    _ => x >> count,
                };
                s[bs + a] = shifted as uint64;
                pc += 1;
            }
            .BNot => {
                s[bs + a] = ~s[bs + b];
                pc += 1;
            }
            .RemF => {
                s[bs + a] = (float.fromBits(s[bs + b]) % float.fromBits(s[bs + c])).toBits();
                pc += 1;
            }
            .IToC => {
                let v = s[bs + b] as int;
                if (v < 0 || v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF)) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0009",
                        f"{v} is not a Unicode scalar value"
                    );
                }
                s[bs + a] = v as uint64;
                pc += 1;
            }
            .GetGS => {
                s[bs + a] = gs[b];
                pc += 1;
            }
            .SetGS => {
                gs[a] = s[bs + b];
                pc += 1;
            }
            .GetGR => {
                r[br + a] = gr[b];
                pc += 1;
            }
            .SetGR => {
                gr[a] = r[br + b];
                pc += 1;
            }
            .CheckS => {
                if (s[bs + a] == 0) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0004", "a null value unwrapped");
                }
                pc += 1;
            }
            .CheckR => {
                if (r[br + a] is Nil) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0004", "a null value unwrapped");
                }
                pc += 1;
            }
            // a call through a function value: the value is the callee's first reference argument,
            // and its first scalar field names the function
            .CallV => {
                // without a limit (-1) nothing is spent: one read, no write (S7j)
                if (shared.budget != -1) {
                    shared.budget = spend(shared.budget);
                    if (shared.budget == -2) {
                        return Outcome.Suspended;
                    }
                }
                if (frames.length() >= maxDepth) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0006", "stack overflow");
                }
                let env = r[br + b];
                var target = -1;
                if (env is ScriptObject) {
                    target = env.scalars[0] as int;
                }
                if (target < 0 || target >= module.functions.length()) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a call through no function"
                    );
                }
                let callee = module.functions[target];
                frames.push(CallFrame { function = fi, pc = pc + 1, baseS = bs, baseR = br });
                bs += a;
                br += b;
                if (bs + callee.scalars > s.length()) {
                    s = growScalars(s, bs + callee.scalars);
                }
                if (br + callee.refs > r.length()) {
                    r = growRefs(r, br + callee.refs);
                }
                fi = target;
                f = callee;
                code = f.code;
                pc = 0;
            }
            // a call through an interface value: the receiver is the callee's first reference
            // argument, and its type's table names the function of slot `a`
            .CallI => {
                // without a limit (-1) nothing is spent: one read, no write (S7j)
                if (shared.budget != -1) {
                    shared.budget = spend(shared.budget);
                    if (shared.budget == -2) {
                        return Outcome.Suspended;
                    }
                }
                if (frames.length() >= maxDepth) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0006", "stack overflow");
                }
                let recv = r[br + c];
                var target = -1;
                if (recv is ScriptObject) {
                    let row = recv.typeDesc.methods;
                    if (a < row.length()) {
                        target = row[a];
                    }
                }
                if (target < 0 || target >= module.functions.length()) {
                    // a field of the standard library's holds the VM's own object, and a script
                    // can read the field: that is no fault of the compiler's
                    if (recv is ScriptBigInt
                        || recv is ScriptBytes
                        || recv is ScriptFile
                        || recv is ScriptDir
                        || recv is ScriptRandom
                        || recv is ScriptBuilder
                        || recv is ScriptIndex) {
                        return panicOut(
                            module,
                            frames,
                            fi,
                            pc,
                            "LYS-RT0007",
                            "an object of the VM has no members"
                        );
                    }
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a call through no interface method"
                    );
                }
                let callee = module.functions[target];
                frames.push(CallFrame { function = fi, pc = pc + 1, baseS = bs, baseR = br });
                bs += b;
                br += c;
                if (bs + callee.scalars > s.length()) {
                    s = growScalars(s, bs + callee.scalars);
                }
                if (br + callee.refs > r.length()) {
                    r = growRefs(r, br + callee.refs);
                }
                fi = target;
                f = callee;
                code = f.code;
                pc = 0;
            }
            // S3i: a static member through a type's descriptor: the function in slot `a` of the
            // descriptor in reference register `c`, its arguments after it
            .CallS => {
                // without a limit (-1) nothing is spent: one read, no write (S7j)
                if (shared.budget != -1) {
                    shared.budget = spend(shared.budget);
                    if (shared.budget == -2) {
                        return Outcome.Suspended;
                    }
                }
                if (frames.length() >= maxDepth) {
                    return panicOut(module, frames, fi, pc, "LYS-RT0006", "stack overflow");
                }
                let d = descIn(r[br + c]);
                var target = -1;
                if (d != null && a < d.methods.length()) {
                    target = d.methods[a];
                }
                if (target < 0 || target >= module.functions.length()) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a call through no static member"
                    );
                }
                let callee = module.functions[target];
                frames.push(CallFrame { function = fi, pc = pc + 1, baseS = bs, baseR = br });
                bs += b;
                br += c + 1;
                if (bs + callee.scalars > s.length()) {
                    s = growScalars(s, bs + callee.scalars);
                }
                if (br + callee.refs > r.length()) {
                    r = growRefs(r, br + callee.refs);
                }
                fi = target;
                f = callee;
                code = f.code;
                pc = 0;
            }
            .IsNil => {
                s[bs + a] = truth(r[br + b] is Nil);
                pc += 1;
            }
            // whether an interface value holds a value of the program's type `c`
            .IsT => {
                let o = r[br + b];
                s[bs + a] = truth(o is ScriptObject && o.typeDesc.family == c);
                pc += 1;
            }
            // S3i: a type's descriptor as a value (11 Gen)
            .LoadT => {
                r[br + a] = TypeValue { d = module.types[b] };
                pc += 1;
            }
            // the descriptor of template `b`'s shape at the descriptors from register `c` on
            .InstT => {
                let shape = module.types[b];
                let args = List<TypeDesc>.new();
                var k = 0;
                while (k < shape.args.length()) {
                    let d = descIn(r[br + c + k]);
                    if (d == null) {
                        return panicOut(
                            module,
                            frames,
                            fi,
                            pc,
                            "LYS-ICE0001",
                            "'inst.t' given no descriptor"
                        );
                    }
                    args.push(d);
                    k += 1;
                }
                r[br + a] = TypeValue { d = interning.instance(shape, args.toArray()) };
                pc += 1;
            }
            // the descriptor of the object's type: a variant's is its enum's
            .DescOf => {
                let o = r[br + b];
                if (o is ScriptObject) {
                    r[br + a] = TypeValue { d = o.typeDesc.parent ?? o.typeDesc };
                } else {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "'desc.of' of no object"
                    );
                }
                pc += 1;
            }
            .DescArg => {
                let d = descIn(r[br + b]);
                if (d == null) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "'desc.arg' of no descriptor"
                    );
                }
                if (c >= d.args.length()) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "'desc.arg' past the arguments"
                    );
                }
                r[br + a] = TypeValue { d = d.args[c] };
                pc += 1;
            }
            .DescVar => {
                let d = descIn(r[br + b]);
                if (d == null) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "'desc.var' of no descriptor"
                    );
                }
                if (c >= d.variants.length()) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "'desc.var' past the variants"
                    );
                }
                r[br + a] = TypeValue { d = d.variants[c] };
                pc += 1;
            }
            // an object of the type the descriptor in register `b` names
            .NewD => {
                let t = descIn(r[br + b]);
                if (t == null) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "'new.d' of no descriptor"
                    );
                }
                r[br + a] = ScriptObject {
                    typeDesc = t,
                    scalars = [0 as uint64] * t.scalarFields.length(),
                    refs = refArray(t.refFields.length()),
                };
                pc += 1;
            }
            // whether the value is one of the type the descriptor in register `c` names
            .IsD => {
                let o = r[br + b];
                let d = descIn(r[br + c]);
                if (d == null) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "'is.d' of no descriptor"
                    );
                }
                s[bs + a] = truth(o is ScriptObject && conforms(o.typeDesc, d));
                pc += 1;
            }
            // whether it holds a value of a type that conforms to interface `c`
            .IsI => {
                let o = r[br + b];
                var found = false;
                if (o is ScriptObject) {
                    for (x in o.typeDesc.ifaces) {
                        found = found || x == c;
                    }
                }
                s[bs + a] = truth(found);
                pc += 1;
            }
            // S4a: the error leaves frames until a handler covers where it stands — the throw, or
            // in a caller the call (06 §5 rule 1); `throw` starts its record, `rethrow` goes on
            // with the one in register `b` (S4b)
            .Throw | .Rethrow => {
                inject = false;
                let value = r[br + a];
                let held = if (ins.op == .Rethrow) r[br + b] else nilRef();
                let record = if (held is ErrorRecord) held else recordOf(frames, fi, pc);
                if (caught(module, frames, f, pc)) {
                    loop {
                        if (let h = handlerAt(f, pc)) {
                            r[br + h.reg] = value;
                            r[br + h.rec] = record;
                            pc = h.target;
                            break;
                        }
                        if (frames.length() == 0) {
                            return panicOut(
                                module,
                                frames,
                                fi,
                                pc,
                                "LYS-ICE0001",
                                "an error caught by no frame"
                            );
                        }
                        let back = frames.take();
                        fi = back.function;
                        f = module.functions[fi];
                        code = f.code;
                        pc = back.pc - 1;
                        bs = back.baseS;
                        br = back.baseR;
                    }
                } else {
                    // S6b: out of a coroutine's body — it has ended, and the pull that ran into
                    // the error throws it (Lyric 5 10 §1 rule 6)
                    let p = t.pullers.pop();
                    if (p != null) {
                        let co = p.co;
                        co.state = 3;
                        co.ctx = null;
                        let x = p.ctx;
                        s = x.s;
                        r = x.r;
                        frames = x.frames;
                        fi = x.fi;
                        f = module.functions[fi];
                        code = f.code;
                        pc = x.pc;
                        bs = x.bs;
                        br = x.br;
                        report = x.report;
                        s[p.a] = 1 as uint64;
                        r[p.b] = value;
                        r[p.b + 1] = record;
                        // a close's own `Cancelled` ends there; what a defer threw on the way out
                        // comes out of the close, the first, the rest suppressed into it (rule 9)
                        if (p.closing && sameRef(value, co.cancel)) {
                            s[p.a] = 0 as uint64;
                            if (record.suppressed.length() > 0) {
                                let again = recordOf(frames, fi, pc);
                                var k = 1;
                                while (k < record.suppressed.length()) {
                                    again.suppressed.push(record.suppressed[k]);
                                    k += 1;
                                }
                                s[p.a] = 1 as uint64;
                                r[p.b] = record.suppressed[0];
                                r[p.b + 1] = again;
                            }
                        }
                        continue;
                    }
                    if (t.handle != null) {
                        // a spawned task fails: `await` and `join` throw its error again (S6a)
                        t.thrown = value;
                        t.record = record;
                        return Outcome.Error(
                            ScriptError { typeName = "", message = "", causes = [], trace = [] }
                        );
                    }
                    let rep = report;
                    if (rep != null) {
                        // thrown out of a report's call: the report ends with what it has
                        return Outcome.Error(errorOf(rep));
                    }
                    // no frame takes it: the report asks for its message (05 E6)
                    let o = value;
                    let typeName = if (o is ScriptObject) (o.typeDesc.parent ?? o.typeDesc).name
                        else "";
                    let started = Report {
                        typeName = typeName,
                        trace = recordLines(module, record),
                        messages = List<string>.new(),
                        at = value,
                        suppressed = record.suppressed.toArray(),
                        suppressedTexts = List<string>.new(),
                    };
                    report = started;
                    let target = methodIn(module, value, module.errorMessage);
                    if (target < 0) {
                        return Outcome.Error(errorOf(started));
                    }
                    // the frames are left: the report's call runs where the entry ran
                    if (frames.length() > 0) {
                        bs = frames.get(0).baseS;
                        br = frames.get(0).baseR;
                    }
                    frames.clear();
                    frames.push(CallFrame { function = -1, pc = 0, baseS = bs, baseR = br });
                    r[br] = value;
                    fi = target;
                    f = module.functions[fi];
                    code = f.code;
                    pc = 0;
                    if (bs + f.scalars > s.length()) {
                        s = growScalars(s, bs + f.scalars);
                    }
                    if (br + f.refs > r.length()) {
                        r = growRefs(r, br + f.refs);
                    }
                }
            }
            // S6b: a coroutine of the closure in `b`, run by nothing yet; `c` the slots of what
            // it yields, scalars × 256 + references; its result's from its function
            .CoNew => {
                let env = r[br + b];
                var target = -1;
                if (env is ScriptObject) {
                    target = env.scalars[0] as int;
                }
                if (target < 0 || target >= module.functions.length()) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a coroutine of no function"
                    );
                }
                let body = module.functions[target];
                let (rs, rr) = match (body.returns) {
                    .Scalar => (1, 0),
                    .Ref => (0, 1),
                    .Slots => (body.retS, body.retR),
                    _ => (0, 0),
                };
                r[br + a] = ScriptCoroutine {
                    env = env,
                    ns = c / 256,
                    nr = c % 256,
                    rs = rs,
                    rr = rr,
                };
                pc += 1;
            }
            // S6b: a pull of the coroutine in `c`: it runs to its next yield or its end (Lyric 5
            // 10 §1 rule 4); the answer at `s[a]` 0 and the value at `s[a+1]…`/`r[b]…`, its
            // presence after its scalars — or `s[a]` 1, the error at `r[b]`, its record at `r[b+1]`
            .CoNext => {
                let o = r[br + c];
                if (!(o is ScriptCoroutine)) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a pull of no coroutine"
                    );
                }
                if (o.state == 2) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0014",
                        "a coroutine pulled while it runs"
                    );
                }
                if (o.state == 3) {
                    ended(s, r, bs + a, br + b, o.ns, o.nr);
                    pc += 1;
                } else {
                    let x = o.ctx ?? coroutineStart(module, o.env);
                    if (x == null) {
                        return panicOut(
                            module,
                            frames,
                            fi,
                            pc,
                            "LYS-ICE0001",
                            "a coroutine of no function"
                        );
                    }
                    t.pullers.push(
                        Pull {
                            ctx = Context {
                                s = s,
                                r = r,
                                frames = frames,
                                fi = fi,
                                pc = pc + 1,
                                bs = bs,
                                br = br,
                                report = report,
                            },
                            co = o,
                            a = bs + a,
                            b = br + b,
                        }
                    );
                    o.state = 2;
                    s = x.s;
                    r = x.r;
                    frames = x.frames;
                    fi = x.fi;
                    f = module.functions[fi];
                    code = f.code;
                    pc = x.pc;
                    bs = x.bs;
                    br = x.br;
                    report = x.report;
                }
            }
            // S6b: the running coroutine hands the value at `s[a]…`/`r[b]…` to the context that
            // pulled it and parks (Lyric 5 10 §1 rule 2); where none pulled, a panic
            .YieldV | .YieldD => {
                let p = t.pullers.pop();
                if (p == null) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0014",
                        "a yield where no coroutine runs"
                    );
                }
                if (p.closing) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0014",
                        "a yield after the coroutine was closed"
                    );
                }
                // S6b3: a yield in a function the coroutine calls meets its `Y` here (rule 13)
                if (ins.op == .YieldD && c != p.co.ykey) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0014",
                        "a yield of another type than the running coroutine's"
                    );
                }
                let co = p.co;
                let cs = s;
                let cr = r;
                let vs = bs + a;
                let vr = br + b;
                co.ctx = Context {
                    s = s,
                    r = r,
                    frames = frames,
                    fi = fi,
                    pc = pc + 1,
                    bs = bs,
                    br = br,
                    report = report,
                };
                co.state = 1;
                let x = p.ctx;
                s = x.s;
                r = x.r;
                frames = x.frames;
                fi = x.fi;
                f = module.functions[fi];
                code = f.code;
                pc = x.pc;
                bs = x.bs;
                br = x.br;
                report = x.report;
                s[p.a] = 0 as uint64;
                var k = 0;
                while (k < co.ns) {
                    s[p.a + 1 + k] = cs[vs + k];
                    k += 1;
                }
                s[p.a + 1 + co.ns] = 1 as uint64;
                k = 0;
                while (k < co.nr) {
                    r[p.b + k] = cr[vr + k];
                    k += 1;
                }
            }
            // S6b: the coroutine's result at `s[a]…`/`r[b]…`, its presence after its scalars
            // (rule 5)
            .CoRes => {
                let o = r[br + c];
                if (!(o is ScriptCoroutine)) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a result of no coroutine"
                    );
                }
                var k = 0;
                while (k < o.rs) {
                    s[bs + a + k] = if (o.returned) o.resS[k] else 0 as uint64;
                    k += 1;
                }
                s[bs + a + o.rs] = truth(o.returned);
                k = 0;
                while (k < o.rr) {
                    r[br + b + k] = if (o.returned) o.resR[k] else nil;
                    k += 1;
                }
                pc += 1;
            }
            // S6b3: a close (Lyric 5 10 §1 rule 9): one never pulled or ended ends; one parked at a
            // yield runs on from it with that yield throwing the `Cancelled` in `r[b]`; `s[a]` 1
            // and the error at `r[b]`, its record at `r[b+1]`, where the close throws
            .CoClose => {
                let o = r[br + c];
                if (!(o is ScriptCoroutine)) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a close of no coroutine"
                    );
                }
                if (o.state == 2) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0014",
                        "a coroutine closed while it runs"
                    );
                }
                let x = o.ctx;
                if (o.state == 1 && x != null) {
                    o.cancel = r[br + b];
                    t.pullers.push(
                        Pull {
                            ctx = Context {
                                s = s,
                                r = r,
                                frames = frames,
                                fi = fi,
                                pc = pc + 1,
                                bs = bs,
                                br = br,
                                report = report,
                            },
                            co = o,
                            a = bs + a,
                            b = br + b,
                            closing = true,
                        }
                    );
                    o.state = 2;
                    s = x.s;
                    r = x.r;
                    frames = x.frames;
                    fi = x.fi;
                    f = module.functions[fi];
                    code = f.code;
                    pc = x.pc;
                    bs = x.bs;
                    br = x.br;
                    report = x.report;
                    pc -= 1;
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = o.cancel;
                    inject = true;
                } else {
                    o.state = 3;
                    o.ctx = null;
                    s[bs + a] = 0 as uint64;
                    pc += 1;
                }
            }
            // S6c2: a task scope
            .ScopeNew => {
                r[br + a] = ScriptScope { tasks = List<ScriptTask>.new() };
                pc += 1;
            }
            // S6c2: the scope in `c` closes (Lyric 5 10 §4 rules 1–4): it waits until every task of
            // it has ended — a cancel of the closing task cancels them and goes on waiting —, then
            // throws the first failure (`s[a]` 1, error `r[b]`, record `r[b+1]`) or panics its panic
            .ScopeClose => {
                let sc = r[br + c];
                if (!(sc is ScriptScope)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "a close of no scope");
                }
                let own = t.handle;
                if (own != null && own.cancelled) {
                    for (x in sc.tasks) {
                        cancelTask(x, shared);
                    }
                }
                var open: ?ScriptTask = null;
                for (h in sc.tasks) {
                    if (h.result == null && open == null) {
                        open = h;
                    }
                }
                let waiting = open;
                if (waiting != null) {
                    t.waitingOn = waiting;
                    waiting.waiters.push(t);
                    t.s = s;
                    t.r = r;
                    t.fi = fi;
                    t.pc = pc;
                    t.bs = bs;
                    t.br = br;
                    t.report = report;
                    t.frames = frames;
                    return Outcome.Switch;
                }
                sc.closed = true;
                s[bs + a] = 0 as uint64;
                let h = sc.failed;
                if (h != null) {
                    match (h.result ?? Outcome.Switch) {
                        .Panic(p) => {
                            return Outcome.Panic(p);
                        }
                        _ => {
                            s[bs + a] = 1 as uint64;
                            r[br + b] = h.state.thrown;
                            r[br + b + 1] = h.state.record;
                        }
                    }
                }
                pc += 1;
            }
            // S6c3: the value of the ended task in `c` at `s[a]…`/`r[b]…`, without a wait
            .TaskVal => {
                let o = r[br + c];
                if (o is ScriptTask) {
                    match (o.result ?? Outcome.Void) {
                        .Scalar(v) => {
                            s[bs + a] = v;
                        }
                        .Ref(v) => {
                            r[br + b] = v;
                        }
                        .Slots(xs, ys) => {
                            var k = 0;
                            while (k < xs.length()) {
                                s[bs + a + k] = xs[k];
                                k += 1;
                            }
                            k = 0;
                            while (k < ys.length()) {
                                r[br + b + k] = ys[k];
                                k += 1;
                            }
                        }
                        _ => { }
                    }
                }
                pc += 1;
            }
            // S6c3: the error the task in `b` ended with
            .TaskErr => {
                let o = r[br + b];
                if (o is ScriptTask) {
                    r[br + a] = o.state.thrown;
                }
                pc += 1;
            }
            // S6c3: the code (`c` 0), the message (1) or the trace (2) of the task's panic
            .TaskPInfo => {
                let o = r[br + b];
                var text = "";
                if (o is ScriptTask) {
                    match (o.result ?? Outcome.Void) {
                        .Panic(p) => {
                            text = if (c == 0) p.code
                                else if (c == 1) p.message else p.trace.join("\n");
                        }
                        _ => { }
                    }
                }
                r[br + a] = ScriptString { text = text };
                pc += 1;
            }
            // S6d1: a channel of capacity `s[b]`, `c` the slots of its values
            .ChanNew => {
                let capacity = s[bs + b] as int;
                if (capacity < 0) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0008",
                        "a channel's capacity is negative"
                    );
                }
                r[br + a] = ScriptChannel {
                    capacity = capacity,
                    ns = c / 256,
                    nr = c % 256,
                    buffer = List<Item>.new(),
                    receivers = List<TaskState>.new(),
                    senders = List<TaskState>.new(),
                };
                pc += 1;
            }
            // S6d1: a send of the value at `s[a+1]…`/`r[b+2]…` on the channel in `c` (Lyric 5 10 §6
            // rule 2): to a waiting receiver, or into the buffer while it has room, or the task waits
            // until a receiver takes it; `s[a]` 1 and `ChannelClosed` at `r[b]`, its record at
            // `r[b+1]`, where the channel is closed or closes meanwhile
            .ChanSend => {
                let ch = r[br + c];
                if (!(ch is ScriptChannel)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "a send on no channel");
                }
                // a send that went through is no wait any more: a cancel after it leaves it done
                if (t.sendState == 1) {
                    t.sendState = 0;
                    s[bs + a] = 0 as uint64;
                    pc += 1;
                    continue;
                }
                let own = t.handle;
                if (own != null && own.cancelled) {
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = newCancelled(module);
                    inject = true;
                    continue;
                }
                if (t.sendState == 2 || ch.closed) {
                    t.sendState = 0;
                    s[bs + a] = 1 as uint64;
                    r[br + b] = newChannelClosed(module);
                    r[br + b + 1] = recordOf(frames, fi, pc);
                    pc += 1;
                    continue;
                }
                let item = Item {
                    s = firstScalars(s, bs + a + 1, ch.ns),
                    r = firstRefs(r, br + b + 2, ch.nr),
                };
                s[bs + a] = 0 as uint64;
                if (ch.receivers.length() > 0) {
                    let w = ch.receivers.removeAt(0);
                    w.handoff = item;
                    wake(w, shared);
                    pc += 1;
                } else if (ch.buffer.length() < ch.capacity) {
                    ch.buffer.push(item);
                    wakeWatchers(ch, shared);
                    pc += 1;
                } else {
                    t.sendItem = item;
                    t.waitingChan = ch;
                    ch.senders.push(t);
                    wakeWatchers(ch, shared);
                    t.s = s;
                    t.r = r;
                    t.fi = fi;
                    t.pc = pc;
                    t.bs = bs;
                    t.br = br;
                    t.report = report;
                    t.frames = frames;
                    return Outcome.Switch;
                }
            }
            // S6d1: a receive from the channel in `c` (rule 3): the next value — from the buffer, a
            // waiting sender's taking the freed place, or from a waiting sender — at `s[a+1]…`/
            // `r[b]…` with its presence after; none once it is closed and nothing is left; or the
            // task waits for one
            .ChanRecv => {
                let ch = r[br + c];
                if (!(ch is ScriptChannel)) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a receive of no channel"
                    );
                }
                // a value handed over already is the receive's, a cancel after it notwithstanding
                let got = t.handoff;
                if (got != null) {
                    t.handoff = null;
                    delivered(s, r, bs + a, br + b, got);
                    pc += 1;
                    continue;
                }
                let own = t.handle;
                if (own != null && own.cancelled) {
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = newCancelled(module);
                    inject = true;
                    continue;
                }
                if (ch.buffer.length() > 0) {
                    let item = ch.buffer.removeAt(0);
                    if (ch.senders.length() > 0) {
                        let w = ch.senders.removeAt(0);
                        let waited = w.sendItem;
                        if (waited != null) {
                            ch.buffer.push(waited);
                        }
                        w.sendItem = null;
                        w.sendState = 1;
                        wake(w, shared);
                    }
                    delivered(s, r, bs + a, br + b, item);
                    pc += 1;
                } else if (ch.senders.length() > 0) {
                    let w = ch.senders.removeAt(0);
                    let waited = w.sendItem;
                    w.sendItem = null;
                    w.sendState = 1;
                    wake(w, shared);
                    if (waited != null) {
                        delivered(s, r, bs + a, br + b, waited);
                    } else {
                        ended(s, r, bs + a, br + b, ch.ns, ch.nr);
                    }
                    pc += 1;
                } else if (ch.closed) {
                    ended(s, r, bs + a, br + b, ch.ns, ch.nr);
                    pc += 1;
                } else {
                    t.waitingChan = ch;
                    ch.receivers.push(t);
                    t.s = s;
                    t.r = r;
                    t.fi = fi;
                    t.pc = pc;
                    t.bs = bs;
                    t.br = br;
                    t.report = report;
                    t.frames = frames;
                    return Outcome.Switch;
                }
            }
            // S6d1: the channel in `a` closes (rule 4): its receivers get none, its senders throw
            .ChanClose => {
                let ch = r[br + a];
                if (ch is ScriptChannel) {
                    closeChannel(ch, shared);
                }
                pc += 1;
            }
            // S6d3: the task sleeps `s[a]` nanoseconds on the run's clock (Lyric 5 10 §2 rule 5) — a
            // wait; zero or less lets the ready tasks run first
            .Sleep => {
                let own = t.handle;
                if (own != null && own.cancelled) {
                    t.slept = false;
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = newCancelled(module);
                    inject = true;
                    continue;
                }
                if (t.slept) {
                    t.slept = false;
                    pc += 1;
                    continue;
                }
                let d = s[bs + a] as int;
                t.slept = true;
                if (d <= 0) {
                    shared.queue.push(t);
                } else {
                    let e = TimerEntry {
                        deadline = nowNs(shared) + d,
                        seq = shared.timerSeq,
                        task = t,
                    };
                    shared.timerSeq += 1;
                    shared.timers.push(e);
                    t.sleeping = e;
                }
                t.s = s;
                t.r = r;
                t.fi = fi;
                t.pc = pc;
                t.bs = bs;
                t.br = br;
                t.report = report;
                t.frames = frames;
                return Outcome.Switch;
            }
            // S6e: a line of standard input at `r[a]`, none at its end — the first native that
            // waits: a Lyric 5 task reads it while the script's task waits, and the others run
            // (07 N6, 11 Co)
            .CallW => {
                if (t.nativeDone) {
                    t.nativeDone = false;
                    if (let answer = t.nativeAnswer) {
                        takeAnswer(nativeOf(a), answer, s, r, bs + b, br + c);
                    }
                    t.nativeAnswer = null;
                    pc += 1;
                    continue;
                }
                let waiting = nativeOf(a);
                let own = t.handle;
                if (own != null && own.cancelled && nativeCancels(waiting)) {
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = newCancelled(module);
                    inject = true;
                    continue;
                }
                if (let fault = waitFault(waiting, r, br + c)) {
                    return panicOut(module, frames, fi, pc, fault.code, fault.message);
                }
                // a wait the budget does not cover does not start: this call again on `resume`
                let job = waitJob(waiting, s, r, bs + b, br + c, shared);
                if (shared.budget == -2) {
                    return Outcome.Suspended;
                }
                t.nativePending = true;
                t.nativeToItsEnd = !nativeCancels(waiting);
                t.nativeTicket += 1;
                let ticket = t.nativeTicket;
                let st = t;
                shared.pendingNatives += 1;
                spawnDetached(
                    () => {
                        let answer = job();
                        // a task cancelled meanwhile waits no more: what came is dropped
                        if (st.nativePending && st.nativeTicket == ticket) {
                            st.nativePending = false;
                            st.nativeDone = true;
                            st.nativeAnswer = answer;
                            shared.pendingNatives -= 1;
                            shared.queue.push(st);
                            try? shared.wakeups.send(1);
                        }
                    }
                );
                t.s = s;
                t.r = r;
                t.fi = fi;
                t.pc = pc;
                t.bs = bs;
                t.br = br;
                t.report = report;
                t.frames = frames;
                return Outcome.Switch;
            }
            // S6d3: a channel without values that closes once `s[b]` nanoseconds passed (§7 rule 5)
            .TimerAfter => {
                let ch = ScriptChannel {
                    capacity = 0,
                    ns = 0,
                    nr = 0,
                    buffer = List<Item>.new(),
                    receivers = List<TaskState>.new(),
                    senders = List<TaskState>.new(),
                };
                let d = s[bs + b] as int;
                if (d <= 0) {
                    closeChannel(ch, shared);
                } else {
                    shared.timers.push(
                        TimerEntry {
                            deadline = nowNs(shared) + d,
                            seq = shared.timerSeq,
                            channel = ch,
                        }
                    );
                    shared.timerSeq += 1;
                }
                r[br + a] = ch;
                pc += 1;
            }
            // S6d1: a semaphore of `s[b]` permits (Lyric 5 10 §10 rule 7)
            .SemNew => {
                let n = s[bs + b] as int;
                if (n < 0) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0008",
                        "a semaphore's permits are negative"
                    );
                }
                r[br + a] = ScriptSemaphore { permits = n, waiters = List<TaskState>.new() };
                pc += 1;
            }
            // S6d1: a permit of the semaphore in `a`, the task waiting while none is left
            .SemAcquire => {
                let sem = r[br + a];
                if (!(sem is ScriptSemaphore)) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "an acquire of no semaphore"
                    );
                }
                // a permit handed over already is the task's, a cancel after it notwithstanding
                if (t.granted) {
                    t.granted = false;
                    pc += 1;
                    continue;
                }
                let own = t.handle;
                if (own != null && own.cancelled) {
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = newCancelled(module);
                    inject = true;
                    continue;
                }
                if (sem.permits > 0) {
                    sem.permits -= 1;
                    pc += 1;
                } else {
                    t.waitingSem = sem;
                    sem.waiters.push(t);
                    t.s = s;
                    t.r = r;
                    t.fi = fi;
                    t.pc = pc;
                    t.bs = bs;
                    t.br = br;
                    t.report = report;
                    t.frames = frames;
                    return Outcome.Switch;
                }
            }
            .SemTry => {
                let sem = r[br + b];
                var took = false;
                if (sem is ScriptSemaphore && sem.permits > 0) {
                    sem.permits -= 1;
                    took = true;
                }
                s[bs + a] = truth(took);
                pc += 1;
            }
            // a permit back: to the task that has waited longest, or to the count
            .SemRelease => {
                let sem = r[br + a];
                if (sem is ScriptSemaphore) {
                    if (sem.waiters.length() > 0) {
                        let w = sem.waiters.removeAt(0);
                        w.granted = true;
                        wake(w, shared);
                    } else {
                        sem.permits += 1;
                    }
                }
                pc += 1;
            }
            .SemAvail => {
                let sem = r[br + b];
                s[bs + a] = (if (sem is ScriptSemaphore) sem.permits else 0) as uint64;
                pc += 1;
            }
            // S6d2: whether the channel in `b` can be received from without a wait — a value in its
            // buffer, a sender waiting, or closed (Lyric 5 10 §7 rule 2)
            .ChanReady => {
                let ch = r[br + b];
                s[bs + a] = truth(
                    ch is ScriptChannel
                        && (ch.buffer.length() > 0 || ch.senders.length() > 0 || ch.closed)
                );
                pc += 1;
            }
            .ChanWatch => {
                let ch = r[br + a];
                if (ch is ScriptChannel) {
                    ch.watchers.push(t);
                    t.watching.push(ch);
                }
                pc += 1;
            }
            // the select waits until a channel it watches stirs — a wait (rule 4)
            .ParkW => {
                if (t.woken) {
                    t.woken = false;
                    pc += 1;
                    continue;
                }
                let own = t.handle;
                if (own != null && own.cancelled) {
                    unwatchAll(t);
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = newCancelled(module);
                    inject = true;
                    continue;
                }
                if (t.watching.length() == 0) {
                    pc += 1;
                    continue;
                }
                t.s = s;
                t.r = r;
                t.fi = fi;
                t.pc = pc;
                t.bs = bs;
                t.br = br;
                t.report = report;
                t.frames = frames;
                return Outcome.Switch;
            }
            .ScopeCancel => {
                let sc = r[br + a];
                if (sc is ScriptScope) {
                    for (x in sc.tasks) {
                        cancelTask(x, shared);
                    }
                }
                pc += 1;
            }
            // S6c1: the task in `a` cancelled (Lyric 5 10 §3 rule 1)
            .TaskCancel => {
                let o = r[br + a];
                if (o is ScriptTask) {
                    cancelTask(o, shared);
                }
                pc += 1;
            }
            .CoKey => {
                let o = r[br + a];
                if (o is ScriptCoroutine) {
                    o.ykey = b;
                }
                pc += 1;
            }
            .CoDone => {
                let o = r[br + b];
                s[bs + a] = truth(o is ScriptCoroutine && o.state == 3);
                pc += 1;
            }
            // S6a: a task of the closure in `b`, queued; the spawner goes on (07 N8); `spawn.d` one
            // nobody waits for (S6c1)
            .Spawn | .SpawnD | .SpawnS => {
                // S6c2: a scope's task; a closed scope takes none (Lyric 5 10 §4 rule 5)
                var scope: ?ScriptScope = null;
                if (ins.op == .SpawnS) {
                    let sc = r[br + c];
                    if (sc is ScriptScope) {
                        if (sc.closed) {
                            return panicOut(
                                module,
                                frames,
                                fi,
                                pc,
                                "LYS-RT0008",
                                "a closed scope takes no task"
                            );
                        }
                        scope = sc;
                    }
                }
                let env = r[br + b];
                var target = -1;
                if (env is ScriptObject) {
                    target = env.scalars[0] as int;
                }
                if (target < 0 || target >= module.functions.length()) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "a spawn of no function"
                    );
                }
                let callee = module.functions[target];
                let child = TaskState {
                    s = [0 as uint64] * grown(0, callee.scalars),
                    r = refArray(grown(0, callee.refs)),
                    frames = FrameStack.new(),
                    fi = target,
                };
                child.r[0] = env;
                let handle = ScriptTask {
                    state = child,
                    waiters = List<TaskState>.new(),
                    detached = ins.op == .SpawnD,
                    scope = scope,
                };
                child.handle = handle;
                shared.queue.push(child);
                let own = scope;
                if (own != null) {
                    own.tasks.push(handle);
                } else {
                    shared.tasks.push(handle);
                }
                r[br + a] = handle;
                pc += 1;
            }
            // S6a: the value of the task in `c` — `s[a]` 0 and the value at `s[a+1]…`/`r[b]…` —,
            // or its error — `s[a]` 1, the error at `r[b]`, its record at `r[b+1]` —; a task still
            // running is waited for, the await run again when it ends
            .Await => {
                // S6c1: a wait in a cancelled task throws `Cancelled` (Lyric 5 10 §3 rule 1)
                let own = t.handle;
                if (own != null && own.cancelled) {
                    t.yielded = false;
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = newCancelled(module);
                    inject = true;
                    continue;
                }
                let o = r[br + c];
                if (!(o is ScriptTask)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "an await of no task");
                }
                let res = o.result;
                if (res == null) {
                    t.waitingOn = o;
                    o.waiters.push(t);
                    t.s = s;
                    t.r = r;
                    t.fi = fi;
                    t.pc = pc;
                    t.bs = bs;
                    t.br = br;
                    t.report = report;
                    t.frames = frames;
                    return Outcome.Switch;
                }
                s[bs + a] = 0 as uint64;
                match (res) {
                    .Scalar(v) => {
                        s[bs + a + 1] = v;
                    }
                    .Ref(v) => {
                        r[br + b] = v;
                    }
                    .Slots(xs, ys) => {
                        var k = 0;
                        while (k < xs.length()) {
                            s[bs + a + 1 + k] = xs[k];
                            k += 1;
                        }
                        k = 0;
                        while (k < ys.length()) {
                            r[br + b + k] = ys[k];
                            k += 1;
                        }
                    }
                    .Error(_) => {
                        s[bs + a] = 1 as uint64;
                        r[br + b] = o.state.thrown;
                        r[br + b + 1] = o.state.record;
                    }
                    // a panic in a task panics the one that awaits it (07 N4)
                    .Panic(p) => {
                        return Outcome.Panic(p);
                    }
                    _ => { }
                }
                pc += 1;
            }
            // S6a: the task gives way, to the queue's back (07 N8)
            .Yield => {
                // S6c1: a wait in a cancelled task throws `Cancelled` (Lyric 5 10 §3 rule 1)
                let own = t.handle;
                if (own != null && own.cancelled) {
                    t.yielded = false;
                    if (br + f.refs + 1 > r.length()) {
                        r = growRefs(r, br + f.refs + 1);
                    }
                    r[br + f.refs] = newCancelled(module);
                    inject = true;
                    continue;
                }
                if (t.yielded) {
                    // back from the queue: the wait is over
                    t.yielded = false;
                    pc += 1;
                } else {
                    t.yielded = true;
                    shared.queue.push(t);
                    t.s = s;
                    t.r = r;
                    t.fi = fi;
                    t.pc = pc;
                    t.bs = bs;
                    t.br = br;
                    t.report = report;
                    t.frames = frames;
                    return Outcome.Switch;
                }
            }
            // S6a: the status of the task in `b`, as `TaskStatus` numbers it
            .TaskSt => {
                let o = r[br + b];
                var st = 0;
                if (o is ScriptTask) {
                    let res = o.result;
                    if (res != null) {
                        st = match (res) {
                            .Error(_) => if (isCancelled(module, o.state.thrown)) 4 else 2,
                            .Panic(_) => 3,
                            _ => 1,
                        };
                    }
                }
                s[bs + a] = st as uint64;
                pc += 1;
            }
            // S6a: the end of the top level (07 End) — every task of the run ended, the first
            // to fail thrown again here (`s[a]` 1, error `r[b]`, record `r[b+1]`), or its panic
            // panicking the run
            .Join => {
                var open: ?ScriptTask = null;
                for (h in shared.tasks) {
                    if (h.result == null && open == null && !h.detached) {
                        open = h;
                    }
                }
                let waiting = open;
                if (waiting != null) {
                    t.waitingOn = waiting;
                    waiting.waiters.push(t);
                    t.s = s;
                    t.r = r;
                    t.fi = fi;
                    t.pc = pc;
                    t.bs = bs;
                    t.br = br;
                    t.report = report;
                    t.frames = frames;
                    return Outcome.Switch;
                }
                s[bs + a] = 0 as uint64;
                let h = shared.failed;
                if (h != null) {
                    match (h.result ?? Outcome.Switch) {
                        .Panic(p) => {
                            return Outcome.Panic(p);
                        }
                        _ => {
                            s[bs + a] = 1 as uint64;
                            r[br + b] = h.state.thrown;
                            r[br + b + 1] = h.state.record;
                        }
                    }
                }
                pc += 1;
            }
            // S4e: an error a defer threw while the one of record `a` was in flight goes with it
            .Suppress => {
                let rec = r[br + a];
                if (rec is ErrorRecord) {
                    rec.suppressed.push(r[br + b]);
                }
                pc += 1;
            }
            .ListNew => {
                let shape = b;
                r[br + a] = ScriptArray {
                    ns = shape / 256,
                    nr = shape % 256,
                    s = List<uint64>.new(),
                    r = List<HeapRef>.new(),
                };
                pc += 1;
            }
            .ListPush => {
                let o = r[br + b];
                if (!(o is ScriptArray)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "a push on no list");
                }
                var k = 0;
                while (k < o.ns) {
                    o.s.push(s[bs + a + k]);
                    k += 1;
                }
                k = 0;
                while (k < o.nr) {
                    o.r.push(r[br + c + k]);
                    k += 1;
                }
                o.n += 1;
                o.changes += 1;
                pc += 1;
            }
            .ListGetS | .ListGetR | .ListSetS | .ListSetR => {
                let reads = match (ins.op) {
                    .ListGetS | .ListGetR => true,
                    _ => false,
                };
                let o = r[br + (if (reads) b else a)];
                let i = (s[bs + (if (reads) c else b)]) as int;
                if (!(o is ScriptArray)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "an index into no list");
                }
                if (i < 0 || i >= o.n) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0003",
                        f"index {i} out of bounds for length {o.n}"
                    );
                }
                match (ins.op) {
                    .ListGetS => s[bs + a] = o.s[i],
                    .ListGetR => r[br + a] = o.r[i],
                    .ListSetS => o.s[i] = s[bs + c],
                    _ => o.r[i] = r[br + c],
                }
                pc += 1;
            }
            .ListGetN | .ListSetN => {
                let o = r[br + b];
                let i = s[bs + a] as int;
                if (!(o is ScriptArray)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "an index into no list");
                }
                if (i < 0 || i >= o.n) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0003",
                        f"index {i} out of bounds for length {o.n}"
                    );
                }
                // a write's value stands after the index and the list
                let writes = match (ins.op) {
                    .ListSetN => true,
                    _ => false,
                };
                let at = if (writes) 1 else 0;
                var k = 0;
                while (k < o.ns) {
                    if (writes) {
                        o.s[i * o.ns + k] = s[bs + a + at + k];
                    } else {
                        s[bs + a + k] = o.s[i * o.ns + k];
                    }
                    k += 1;
                }
                k = 0;
                while (k < o.nr) {
                    if (writes) {
                        o.r[i * o.nr + k] = r[br + b + at + k];
                    } else {
                        r[br + b + k] = o.r[i * o.nr + k];
                    }
                    k += 1;
                }
                pc += 1;
            }
            .ListLen => {
                let o = r[br + b];
                if (!(o is ScriptArray)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "the length of no list");
                }
                s[bs + a] = o.n as uint64;
                pc += 1;
            }
            .ListPop => {
                let o = r[br + b];
                if (!(o is ScriptArray)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "a pop of no list");
                }
                let plain = c == 1;
                if (o.n == 0) {
                    if (plain) {
                        r[br + b] = nil;
                    } else {
                        s[bs + a + o.ns] = 0 as uint64;
                        var k = 0;
                        while (k < o.nr) {
                            r[br + b + k] = nil;
                            k += 1;
                        }
                    }
                } else {
                    o.n -= 1;
                    var k = 0;
                    while (k < o.ns) {
                        s[bs + a + k] = o.s[o.n * o.ns + k];
                        k += 1;
                    }
                    k = 0;
                    while (k < o.nr) {
                        r[br + b + k] = o.r[o.n * o.nr + k];
                        k += 1;
                    }
                    if (!plain) {
                        s[bs + a + o.ns] = 1 as uint64;
                    }
                    o.s.truncate(o.n * o.ns);
                    o.r.truncate(o.n * o.nr);
                    o.changes += 1;
                }
                pc += 1;
            }
            .ListTrunc => {
                let o = r[br + a];
                let n = s[bs + b] as int;
                if (!(o is ScriptArray)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "a truncate of no list");
                }
                if (n >= 0 && n < o.n) {
                    o.n = n;
                    o.s.truncate(n * o.ns);
                    o.r.truncate(n * o.nr);
                    o.changes += 1;
                }
                pc += 1;
            }
            .ListSupp => {
                let out = ScriptArray {
                    ns = 0,
                    nr = 1,
                    s = List<uint64>.new(),
                    r = List<HeapRef>.new(),
                };
                let rec = r[br + b];
                if (rec is ErrorRecord) {
                    for (x in rec.suppressed) {
                        out.r.push(x);
                        out.n += 1;
                    }
                }
                r[br + a] = out;
                pc += 1;
            }
            .ListChanges => {
                let o = r[br + b];
                if (!(o is ScriptArray)) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-ICE0001",
                        "the changes of no list"
                    );
                }
                s[bs + a] = o.changes as uint64;
                pc += 1;
            }
            .ListCheck => {
                let o = r[br + a];
                if (!(o is ScriptArray)) {
                    return panicOut(module, frames, fi, pc, "LYS-ICE0001", "a walk over no list");
                }
                if (o.changes != s[bs + b] as int) {
                    return panicOut(
                        module,
                        frames,
                        fi,
                        pc,
                        "LYS-RT0016",
                        "List: changed while it was walked"
                    );
                }
                pc += 1;
            }
            .CallN => {
                if (let fault = callNative(nativeOf(a), s, r, bs + b, br + c, shared)) {
                    return panicOut(module, frames, fi, pc, fault.code, fault.message);
                }
                // a native the budget does not cover did nothing: this call again on `resume`,
                // as a backward jump is taken again (01 S5c; S7f4); `exit` leaves the same way
                if (shared.budget == -2) {
                    if (let code = shared.exitCode) {
                        return Outcome.Exit(code);
                    }
                    return Outcome.Suspended;
                }
                pc += 1;
            }
        }
    }
}

/// The record of an error thrown at `pc` of function `fi`: that frame, then its callers at their
/// calls; a report's call stands for none.
fn recordOf(frames: FrameStack, fi: int, pc: int): ErrorRecord {
    let functions = List<int>.new();
    let pcs = List<int>.new();
    functions.push(fi);
    pcs.push(pc);
    var i = frames.length() - 1;
    while (i >= 0) {
        let fr = frames.get(i);
        if (fr.function >= 0) {
            functions.push(fr.function);
            pcs.push(fr.pc - 1);
        }
        i -= 1;
    }
    return ErrorRecord {
        functions = functions.toArray(),
        pcs = pcs.toArray(),
        suppressed = List<HeapRef>.new(),
    };
}

/// The frames of a record as a trace's lines; none for what holds no record.
fn recordLines(module: Module, v: HeapRef): string[] {
    let out = List<string>.new();
    if (v is ErrorRecord) {
        var k = 0;
        while (k < v.functions.length()) {
            out.push(frameText(module.functions[v.functions[k]], v.pcs[k]));
            k += 1;
        }
    }
    return out.toArray();
}

/// The first region of `f` that covers instruction `pc`.
fn handlerAt(f: Function, pc: int): ?Handler {
    for (h in f.handlers) {
        if (pc >= h.start && pc < h.end) {
            return h;
        }
    }
    return null;
}

/// Whether a frame takes an error thrown at `pc` of `f`: `f`'s, or a caller's at its call, down
/// to the first frame or to a report's call.
fn caught(module: Module, frames: FrameStack, f: Function, pc: int): bool {
    if (handlerAt(f, pc) != null) {
        return true;
    }
    var k = frames.length() - 1;
    while (k >= 0 && frames.get(k).function >= 0) {
        if (handlerAt(module.functions[frames.get(k).function], frames.get(k).pc - 1) != null) {
            return true;
        }
        k -= 1;
    }
    return false;
}

/// The function in slot `slot` of the object's table; -1 where it has none.
fn methodIn(module: Module, v: HeapRef, slot: int): int {
    if (slot < 0) {
        return -1;
    }
    if (v is ScriptObject) {
        let row = v.typeDesc.methods;
        if (slot < row.length() && row[slot] < module.functions.length()) {
            return row[slot];
        }
    }
    return -1;
}

/// What a report has found: the first message is the error's, the others its causes'. Where
/// the error gave no message — its `message()` threw, or the module has no `Error` — its type
/// names it.
fn errorOf(rep: Report): ScriptError {
    let causes = List<string>.new();
    var k = 1;
    while (k < rep.messages.length()) {
        causes.push(rep.messages[k]);
        k += 1;
    }
    return ScriptError {
        typeName = rep.typeName,
        message = if (rep.messages.length() > 0) rep.messages[0] else rep.typeName,
        causes = causes.toArray(),
        trace = rep.trace,
        suppressed = rep.suppressedTexts.toArray(),
    };
}

/// The text of a string reference; the compiler gives a native nothing else.
fn textOf(v: HeapRef): string {
    return if (v is ScriptString) v.text else "";
}

/// A string's bytes, read the first time they are asked for and kept (S7e1).
fn bytesOf(v: HeapRef): uint8[] {
    if (v is ScriptString) {
        if (let b = v.bytes) {
            return b;
        }
        let b = v.text.toBytes();
        v.bytes = b;
        return b;
    }
    return [];
}

/// Whether a character begins at byte `i` of a string, or `i` is its length.
fn beginsChar(v: HeapRef, i: int): bool {
    let b = bytesOf(v);
    return i >= b.length() || (b[i] & 192) != 128;
}

/// The character of a scalar slot; U+FFFD for a value that is no Unicode scalar value.
fn charOfCode(v: uint64): char {
    if (v > 1114111) {
        return '\u{FFFD}';
    }
    return char.fromUint32(v as uint32) ?? '\u{FFFD}';
}

/// A general category's place in `UnicodeCategory`, the order of Lyric 5's enum.
fn categoryIndex(c: UnicodeCategory): int {
    return match (c) {
        .UppercaseLetter => 0,
        .LowercaseLetter => 1,
        .TitlecaseLetter => 2,
        .ModifierLetter => 3,
        .OtherLetter => 4,
        .NonspacingMark => 5,
        .SpacingMark => 6,
        .EnclosingMark => 7,
        .DecimalNumber => 8,
        .LetterNumber => 9,
        .OtherNumber => 10,
        .ConnectorPunctuation => 11,
        .DashPunctuation => 12,
        .OpenPunctuation => 13,
        .ClosePunctuation => 14,
        .InitialPunctuation => 15,
        .FinalPunctuation => 16,
        .OtherPunctuation => 17,
        .MathSymbol => 18,
        .CurrencySymbol => 19,
        .ModifierSymbol => 20,
        .OtherSymbol => 21,
        .SpaceSeparator => 22,
        .LineSeparator => 23,
        .ParagraphSeparator => 24,
        .Control => 25,
        .Format => 26,
        .Surrogate => 27,
        .PrivateUse => 28,
        .Unassigned => 29,
    };
}

fn firstScalars(s: uint64[], from: int, n: int): uint64[] {
    var out: uint64[] = [0 as uint64] * n;
    var k = 0;
    while (k < n) {
        out[k] = s[from + k];
        k += 1;
    }
    return out;
}

fn firstRefs(r: HeapRef[], from: int, n: int): HeapRef[] {
    return arrayOf(n, (k: int) => r[from + k]);
}

fn signed16(v: int): int {
    return if (v >= 32768) v - 65536 else v;
}

/// The descriptor a register holds, `null` where it holds none.
fn descIn(v: HeapRef): ?TypeDesc {
    if (v is TypeValue) {
        return v.d;
    }
    return null;
}

fn truth(b: bool): uint64 {
    return if (b) 1 else 0;
}

/// `n` units of budget taken before a native's work: false where they are not there, and the
/// budget is out then — what a native costs is known from its operands, so it never starts what it
/// cannot pay (01 S5c).
fn charge(shared: RunShared, n: int): bool {
    if (shared.budget < 0) {
        return shared.budget == -1;
    }
    if (shared.budget < n) {
        shared.budget = -2;
        return false;
    }
    shared.budget -= n;
    return true;
}

/// What a native that waits brought (S7g2): a number, a failure as `-(kind << 32 | code)`; a text; bytes.
struct WaitAnswer {
    n: int,
    text: ?string = null,
    bytes: ?uint8[] = null,
}

/// What `call.w` runs on a Lyric 5 task, charged here, before it starts: nothing the task does
/// touches the script's values. The budget's end is the caller's to read.
fn waitJob(
    which: NativeFn,
    s: uint64[],
    r: HeapRef[],
    x: int,
    y: int,
    shared: RunShared
): fn() -> WaitAnswer {
    match (which) {
        .ConsoleRead => {
            let n = bytesAt(r[y]).length();
            charge(shared, bytesCost(n));
            return () => consoleRead(n);
        }
        .FsOpen => {
            let handle = r[y];
            let name = textOf(r[y + 1]);
            let how = s[x] as int;
            charge(shared, bytesCost(name.length()));
            return () => fileOpen(handle, name, how);
        }
        .FsRead => {
            let file = fileAt(r[y]);
            let n = bytesAt(r[y + 1]).length();
            charge(shared, bytesCost(n));
            return () => fileRead(file, n);
        }
        .FsWrite => {
            let file = fileAt(r[y]);
            let data = bytesAt(r[y + 1]);
            charge(shared, bytesCost(data.length()));
            // another task may change the bytes meanwhile: these are the ones the call was handed
            let from = data.toArray();
            return () => fileWrite(file, from);
        }
        .FsSeek => {
            let file = fileAt(r[y]);
            let offset = s[x] as int;
            let whence = s[x + 1] as int;
            charge(shared, 1);
            return () => fileSeek(file, offset, whence);
        }
        .FsClose => {
            let file = fileAt(r[y]);
            charge(shared, 1);
            return () => fileClose(file);
        }
        .FsMetadata => {
            let name = pathCharged(r[y + 1], shared);
            return () => pathLook(name);
        }
        .TimeZoneOpen => {
            let handle = r[y + 1];
            let name = textOf(r[y + 2]);
            let how = s[x] as int;
            let text = textOf(r[y + 3]);
            let data = r[y + 4];
            // a TZif file's bytes as the call was handed them; a POSIX rule as text
            var bytes: uint8[] = [];
            if (data is ScriptBytes) {
                bytes = data.data.toArray();
            }
            charge(shared, bytesCost(bytes.length() + text.length()));
            return () => zoneOpen(handle, how, name, bytes, text);
        }
        .FsCreateDir => {
            let name = pathCharged(r[y], shared);
            return () => pathDone(() => try fsCreateDir(name));
        }
        .FsRemove => {
            let name = pathCharged(r[y], shared);
            return () => pathDone(() => try fsRemove(name));
        }
        .FsRemoveDir => {
            let name = pathCharged(r[y], shared);
            return () => pathDone(() => try fsRemoveDir(name));
        }
        .FsRename => {
            let from = pathCharged(r[y], shared);
            let to = pathCharged(r[y + 1], shared);
            return () => pathDone(() => try fsRename(from, to));
        }
        .FsCanonicalize => {
            let name = pathCharged(r[y + 1], shared);
            return () => pathMade(() => try fsCanonicalize(name));
        }
        .FsAbsolute => {
            let name = pathCharged(r[y + 1], shared);
            return () => pathMade(() => try fsAbsolute(name));
        }
        .OsCwd => {
            charge(shared, 1);
            return () => pathMade(() => try osCwd());
        }
        .OsSetCwd => {
            let name = pathCharged(r[y], shared);
            return () => pathDone(() => try osSetCwd(name));
        }
        .OsHostname => {
            charge(shared, 1);
            return () => pathMade(() => try osHostname());
        }
        // S7h3: a child, its pipes, its end
        .ProcessSpawn => {
            let handle = r[y];
            let program = pathCharged(r[y + 1], shared);
            let args = partsOf(pathCharged(r[y + 2], shared), s[x + 1] as int);
            let names = partsOf(pathCharged(r[y + 3], shared), s[x + 2] as int);
            let values = partsOf(pathCharged(r[y + 4], shared), s[x + 2] as int);
            let cwd = pathCharged(r[y + 5], shared);
            let modes = s[x] as int;
            return () => childSpawn(handle, program, args, names, values, cwd, modes);
        }
        .ProcessRead => {
            let child = childAt(r[y]);
            let which = s[x] as int;
            let n = bytesAt(r[y + 1]).length();
            charge(shared, bytesCost(n));
            return () => pipeRead(child, which, n);
        }
        .ProcessWrite => {
            let child = childAt(r[y]);
            let data = bytesAt(r[y + 1]);
            charge(shared, bytesCost(data.length()));
            // another task may change the bytes meanwhile: these are the ones the call was handed
            let from = data.toArray();
            return () => pipeWrite(child, from);
        }
        .ProcessClose => {
            let child = childAt(r[y]);
            let which = s[x] as int;
            charge(shared, 1);
            return () => pipeClose(child, which);
        }
        .ProcessWait => {
            let child = childAt(r[y + 1]);
            charge(shared, 1);
            return () => childWait(child);
        }
        .ProcessSignal => {
            let child = childAt(r[y]);
            let signal = signalFrom(s[x] as int, s[x + 1] as int);
            charge(shared, 1);
            return () => pathDone(() => try child.signal(signal));
        }
        .FsTempDir => {
            charge(shared, 1);
            return () => pathMade(() => try fsTempDir());
        }
        .FsTempFile => {
            charge(shared, 1);
            return () => pathMade(() => try fsTempFile());
        }
        .FsDirOpen => {
            let handle = r[y];
            let name = pathCharged(r[y + 1], shared);
            return () => dirOpen(handle, name);
        }
        .FsDirNext => {
            let dir = dirAt(r[y + 1]);
            charge(shared, 1);
            return () => dirNext(dir);
        }
        .FsDirClose => {
            let dir = dirAt(r[y]);
            charge(shared, 1);
            return () => dirClose(dir);
        }
        _ => {
            charge(shared, 1);
            return () => consoleLine();
        }
    }
}

/// What stops a native that waits before it starts: a field of the standard library's that holds
/// something else, since a script can build a `File` or a `Bytes` of its own.
fn waitFault(which: NativeFn, r: HeapRef[], y: int): ?NativeFault {
    let bytesOnly = which == NativeFn.ConsoleRead;
    let holdsFile = which == NativeFn.FsRead
        || which == NativeFn.FsWrite
        || which == NativeFn.FsSeek
        || which == NativeFn.FsClose;
    if (bytesOnly && !(r[y] is ScriptBytes)) {
        return bytesFault("LYS-RT0007", "a Bytes' field holds no bytes");
    }
    if (holdsFile) {
        let o = r[y];
        if (!(o is ScriptFile) || o.file == null) {
            return bytesFault("LYS-RT0007", "a File's field holds no file");
        }
    }
    if ((which == NativeFn.FsRead || which == NativeFn.FsWrite) && !(r[y + 1] is ScriptBytes)) {
        return bytesFault("LYS-RT0007", "a Bytes' field holds no bytes");
    }
    if (which == NativeFn.ProcessSpawn && !(r[y] is ScriptChild)) {
        return bytesFault("LYS-RT0007", "a Child's field holds no child");
    }
    let holdsChild = which == NativeFn.ProcessRead
        || which == NativeFn.ProcessWrite
        || which == NativeFn.ProcessClose
        || which == NativeFn.ProcessWait
        || which == NativeFn.ProcessSignal;
    if (holdsChild) {
        let o = if (which == NativeFn.ProcessWait) r[y + 1] else r[y];
        if (!(o is ScriptChild) || o.child == null) {
            return bytesFault("LYS-RT0007", "a Child's field holds no child");
        }
    }
    if ((which == NativeFn.ProcessRead || which == NativeFn.ProcessWrite)
        && !(r[y + 1] is ScriptBytes)) {
        return bytesFault("LYS-RT0007", "a Bytes' field holds no bytes");
    }
    if (which == NativeFn.TimeZoneOpen && !(r[y + 1] is ScriptZone)) {
        return bytesFault("LYS-RT0007", "a Zone's field holds no zone");
    }
    if (which == NativeFn.FsDirNext || which == NativeFn.FsDirClose) {
        let o = if (which == NativeFn.FsDirNext) r[y + 1] else r[y];
        if (!(o is ScriptDir) || o.dir == null) {
            return bytesFault("LYS-RT0007", "a ReadDirIter's field holds no directory");
        }
    }
    return null;
}

/// The bytes `waitFault` saw.
fn bytesAt(o: HeapRef): List<uint8> {
    if (o is ScriptBytes) {
        return o.data;
    }
    unreachable("waitFault looked");
}

/// The file `waitFault` saw.
fn fileAt(o: HeapRef): File {
    if (o is ScriptFile) {
        if (let f = o.file) {
            return f;
        }
    }
    unreachable("waitFault looked");
}

/// The child `waitFault` saw.
fn childAt(o: HeapRef): Child {
    if (o is ScriptChild) {
        if (let c = o.child) {
            return c;
        }
    }
    unreachable("waitFault looked");
}

/// The first `count` parts of `text`, each ended by a NUL.
fn partsOf(text: string, count: int): string[] {
    let out = List<string>.new();
    for (part in text.split('\0')) {
        if (out.length() < count) {
            out.push(part.toString());
        }
    }
    return out.toArray();
}

/// What a mode of `std.process` says, 0 to 2.
fn stdioOf(mode: int): Stdio {
    return match (mode) {
        1 => Stdio.Piped,
        2 => Stdio.Null,
        _ => Stdio.Inherit,
    };
}

/// Starts the child into `handle`: 0, or the failure. What the console holds is written first,
/// so that a child that inherits a stream writes after it.
fn childSpawn(
    handle: HeapRef,
    program: string,
    args: string[],
    names: string[],
    values: string[],
    cwd: string,
    modes: int
): WaitAnswer {
    let pairs = List<(string, string)>.new();
    var k = 0;
    while (k < names.length()) {
        pairs.push((names[k], values[k]));
        k += 1;
    }
    let command = Command {
        program = program,
        args = args,
        cwd = if (cwd.isEmpty()) null else cwd,
        env = pairs.toArray(),
        stdin = stdioOf(modes & 3),
        stdout = stdioOf((modes >> 2) & 3),
        stderr = stdioOf((modes >> 4) & 3),
    };
    consoleFlush(1);
    consoleFlush(2);
    let child = try command.spawn() catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    if (handle is ScriptChild) {
        handle.child = child;
    }
    return WaitAnswer { n = 0 };
}

/// The answer of a pipe the command did not make: closed.
fn noPipe(): WaitAnswer {
    return WaitAnswer { n = failureCode(IoError { kind = .Closed, detail = "" }) };
}

/// Up to `n` bytes of the child's output (1) or errors (2), into an array of their own.
fn pipeRead(child: Child, which: int, n: int): WaitAnswer {
    let pipe = if (which == 2) child.stderr else child.stdout;
    if (let p = pipe) {
        let into = [0 as uint8] * n;
        try {
            let got = p.read(into);
            return WaitAnswer { n = got, bytes = into };
        } catch (e: IoError) {
            return WaitAnswer { n = failureCode(e) };
        } catch (_: Cancelled) {
            unreachable("nobody cancels a native's task");
        }
    }
    return noPipe();
}

fn pipeWrite(child: Child, from: uint8[]): WaitAnswer {
    if (let p = child.stdin) {
        try {
            return WaitAnswer { n = p.write(from) };
        } catch (e: IoError) {
            return WaitAnswer { n = failureCode(e) };
        } catch (_: Cancelled) {
            unreachable("nobody cancels a native's task");
        }
    }
    return noPipe();
}

/// Closes the child's input (0), output (1) or errors (2).
fn pipeClose(child: Child, which: int): WaitAnswer {
    if (which == 0) {
        if (let p = child.stdin) {
            return pathDone(() => try p.close());
        }
    } else if (let p = if (which == 2) child.stderr else child.stdout) {
        return pathDone(() => try p.close());
    }
    return noPipe();
}

/// The child's end: its code, or a signal as `signalAnswer` writes it, and its text.
fn childWait(child: Child): WaitAnswer {
    var c = child;
    try {
        let status = c.wait();
        if (let code = status.code()) {
            return WaitAnswer { n = code, text = f"{status}" };
        }
        return WaitAnswer { n = signalAnswer(status.signal()!), text = f"{status}" };
    } catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    } catch (_: Cancelled) {
        unreachable("nobody cancels a native's task");
    }
}

/// A child's end by a signal: bit 40, the signal's kind from bit 16, the number of an `Other`.
fn signalAnswer(s: Signal): int {
    let kind = match (s) {
        Signal.Interrupt => 0,
        Signal.Terminate => 1,
        Signal.Hangup => 2,
        Signal.Quit => 3,
        Signal.User1 => 4,
        Signal.User2 => 5,
        Signal.WindowChange => 6,
        Signal.Other(n) => (7 << 16) + n,
    };
    return (1 << 40) + (if (kind >= 7 << 16) kind else kind << 16);
}

/// A channel the signals of `wanted` come in on (Lyric 5 10 §12; S7h4): Lyric 5's subscription to
/// them, whose signals a job of the host hands over as the script's values — `forms` holds one of
/// each variant, `Other`'s last. Sixteen fit; one that finds them taken is lost for this channel
/// (rule 3). Closing it ends the subscription at once (rule 4), the run's end each one left open.
/// `null` where the two are no arrays of the eight forms.
fn signalChannel(wanted: HeapRef, forms: HeapRef, shared: RunShared): ?HeapRef {
    if (!(wanted is ScriptArray)) {
        return null;
    }
    if (!(forms is ScriptArray)) {
        return null;
    }
    if (forms.n != 8 || forms.nr != 1 || wanted.nr != 1) {
        return null;
    }
    let ch = ScriptChannel {
        capacity = 16,
        ns = 0,
        nr = 1,
        buffer = List<Item>.new(),
        receivers = List<TaskState>.new(),
        senders = List<TaskState>.new(),
    };
    let asked = List<Signal>.new();
    var k = 0;
    while (k < wanted.n) {
        let o = wanted.r[k];
        if (o is ScriptObject) {
            let number = if (o.scalars.length() > 1) o.scalars[1] as int else 0;
            asked.push(signalFrom(o.scalars[0] as int, number));
        }
        k += 1;
    }
    // none asked: a channel no signal comes in on, which keeps no run waiting
    if (asked.length() == 0) {
        return ch;
    }
    let incoming = signals(asked.toArray()...);
    shared.feeds.push(incoming);
    shared.openFeeds += 1;
    ch.closer = () => {
        incoming.close();
        shared.openFeeds -= 1;
    };
    let shapes = forms;
    spawnDetached(
        () => {
            while (true) {
                let got = try incoming.recv() catch (_: Cancelled) null;
                if (let s = got) {
                    if (!ch.closed) {
                        offerSignal(ch, signalValue(s, shapes), shared);
                        try? shared.wakeups.send(1);
                    }
                } else {
                    return;
                }
            }
        }
    );
    return ch;
}

/// Hands `value` to a task waiting on `ch`, or into its buffer while it has room; a full buffer
/// loses it for this channel (Lyric 5 10 §12 rule 3).
fn offerSignal(ch: ScriptChannel, value: HeapRef, shared: RunShared): void {
    let item = Item { s = [0 as uint64] * 0, r = [value] };
    if (ch.receivers.length() > 0) {
        let w = ch.receivers.removeAt(0);
        w.handoff = item;
        wake(w, shared);
    } else if (ch.buffer.length() < ch.capacity) {
        ch.buffer.push(item);
        wakeWatchers(ch, shared);
    }
}

/// The script's value of `s`: its form, an `Other` with its number in a new one.
fn signalValue(s: Signal, forms: ScriptArray): HeapRef {
    let (kind, number) = match (s) {
        Signal.Interrupt => (0, 0),
        Signal.Terminate => (1, 0),
        Signal.Hangup => (2, 0),
        Signal.Quit => (3, 0),
        Signal.User1 => (4, 0),
        Signal.User2 => (5, 0),
        Signal.WindowChange => (6, 0),
        Signal.Other(n) => (7, n),
    };
    let form = forms.r[kind];
    if (kind < 7 || !(form is ScriptObject)) {
        return form;
    }
    let scalars = [0 as uint64] * form.scalars.length();
    scalars[0] = 7 as uint64;
    if (scalars.length() > 1) {
        scalars[1] = number as uint64;
    }
    return ScriptObject {
        typeDesc = form.typeDesc,
        scalars = scalars,
        refs = form.refs,
        owner = form.owner,
        version = form.version,
    };
}

/// The signal of a kind as `std.os`'s `Signal` counts its variants, `number` for an `Other`.
fn signalFrom(kind: int, number: int): Signal {
    return match (kind) {
        0 => Signal.Interrupt,
        1 => Signal.Terminate,
        2 => Signal.Hangup,
        3 => Signal.Quit,
        4 => Signal.User1,
        5 => Signal.User2,
        6 => Signal.WindowChange,
        _ => Signal.Other(number),
    };
}

/// The iterator `waitFault` saw.
fn dirAt(o: HeapRef): ReadDirIter {
    if (o is ScriptDir) {
        if (let d = o.dir) {
            return d;
        }
    }
    unreachable("waitFault looked");
}

/// The path a native takes, charged by its bytes.
fn pathCharged(o: HeapRef, shared: RunShared): string {
    let name = textOf(o);
    charge(shared, bytesCost(name.length()));
    return name;
}

/// What a native read: copied to the script's bytes here, where it is not running on another
/// task, and no more than they hold now: another task may have cut them meanwhile.
fn deliverBytes(a: WaitAnswer, o: HeapRef): int {
    let bytes = a.bytes;
    if (!(o is ScriptBytes) || bytes == null) {
        return a.n;
    }
    let n = if (a.n > o.data.length()) o.data.length() else a.n;
    var k = 0;
    while (k < n) {
        o.data[k] = bytes[k];
        k += 1;
    }
    return n;
}

/// Puts what a native that waits brought where the script sees it: the number at the scalar base,
/// and what goes with it into the object at the reference base, which the script's task kept.
fn takeAnswer(which: NativeFn, a: WaitAnswer, s: uint64[], r: HeapRef[], x: int, y: int): void {
    var n = a.n;
    match (which) {
        .ConsoleRead => n = deliverBytes(a, r[y]),
        .FsRead => n = deliverBytes(a, r[y + 1]),
        .ProcessRead => n = deliverBytes(a, r[y + 1]),
        _ => {
            let o = r[y];
            let text = a.text;
            if (o is ScriptArray && text != null) {
                o.r[0] = ScriptString { text = text };
            }
        }
    }
    s[x] = n as uint64;
}

/// The next line of the standard input: 1 and the line, 0 at its end, or the failure and its detail.
fn consoleLine(): WaitAnswer {
    let line = try stdin().readLine() catch (e: IoError) {
        return WaitAnswer { n = failureCode(e), text = failureDetail(e) };
    };
    if (let l = line) {
        return WaitAnswer { n = 1, text = l };
    }
    return WaitAnswer { n = 0 };
}

/// Up to `n` bytes of the standard input, into an array of their own: the script's stay its own.
fn consoleRead(n: int): WaitAnswer {
    let into = [0 as uint8] * n;
    let got = try stdin().read(into) catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    return WaitAnswer { n = got, bytes = into };
}

/// Opens the path as the bits say, `File.openWith`'s options; what they refuse, the script refused.
fn fileOpen(handle: HeapRef, name: string, how: int): WaitAnswer {
    let options = OpenOptions {
        read = how & 1 != 0,
        write = how & 2 != 0,
        append = how & 4 != 0,
        create = how & 8 != 0,
        truncate = how & 16 != 0,
    };
    let file = try File.openWith(name, options) catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    if (handle is ScriptFile) {
        handle.file = file;
    }
    return WaitAnswer { n = 0 };
}

/// Up to `n` bytes of a file, into an array of their own.
fn fileRead(file: File, n: int): WaitAnswer {
    let into = [0 as uint8] * n;
    let got = try file.read(into) catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    return WaitAnswer { n = got, bytes = into };
}

fn fileWrite(file: File, from: uint8[]): WaitAnswer {
    return WaitAnswer { n = try file.write(from) catch (e: IoError) failureCode(e) };
}

fn fileSeek(file: File, offset: int, whence: int): WaitAnswer {
    let to = if (whence == 0) SeekFrom.Start(offset)
        else if (whence == 1) SeekFrom.Current(offset) else SeekFrom.End(offset);
    return WaitAnswer { n = try file.seek(to) catch (e: IoError) failureCode(e) };
}

fn fileClose(file: File): WaitAnswer {
    try file.close() catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    return WaitAnswer { n = 0 };
}

/// What a path names, as `std.fs`'s `Metadata` reads it.
fn pathLook(name: string): WaitAnswer {
    let m = try fsMetadata(name) catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    let bits = (if (m.isFile) 1 else 0)
        | (if (m.isDir) 2 else 0)
        | (if (m.isSymlink) 4 else 0)
        | (if (m.readonly) 8 else 0);
    // the moment it was last written, its nanoseconds since 1970 as text: the holder's
    return WaitAnswer { n = m.size << 4 | bits, text = f"{epochNanos(m.modified)}" };
}

/// A zone Lyric 5 reads (S7h6a), by `how`: 0 the database's of the name, 1 a TZif file's bytes, 2 a
/// POSIX rule, 3 the system's own. 0 and the zone in the handle, its name in the holder; 1 where it is
/// UTC, which the script holds itself; the failure's kind below zero — -1 `Invalid`, -2 `NoZoneData`,
/// -3 `NoSuchZone` — and its detail in the holder.
fn zoneOpen(handle: HeapRef, how: int, name: string, bytes: uint8[], text: string): WaitAnswer {
    let zone = try zoneOf(how, name, bytes, text) catch (e: HostTimeError) {
        let n = match (e.kind) {
            .Invalid => -1,
            .NoZoneData => -2,
            .NoSuchZone => -3,
        };
        return WaitAnswer { n = n, text = e.message() };
    };
    if (zone.isFixed()) {
        return WaitAnswer { n = 1, text = zone.name() };
    }
    if (handle is ScriptZone) {
        handle.zone = zone;
    }
    return WaitAnswer { n = 0, text = zone.name() };
}

fn zoneOf(how: int, name: string, bytes: uint8[], text: string): HostZone throws HostTimeError {
    return match (how) {
        0 => try HostZone.load(name),
        1 => try HostZone.fromTzif(name, bytes[..]),
        2 => try HostZone.fromPosix(name, text),
        _ => HostZone.local(),
    };
}

/// The nanoseconds of `at` since 1970-01-01T00:00:00Z: Lyric 5's `Instant` answers no count of them (S7h5).
fn epochNanos(at: Instant): int {
    let epoch = try! Instant.parse("1970-01-01T00:00:00Z");
    return at.since(epoch).nanos();
}

/// A call that answers nothing: 0, or its failure.
fn pathDone(call: fn() -> void throws IoError): WaitAnswer {
    try call() catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    return WaitAnswer { n = 0 };
}

/// A call that answers a path: 0 and the path, or its failure and the path it was at.
fn pathMade(call: fn() -> string throws IoError): WaitAnswer {
    let made = try call() catch (e: IoError) {
        return WaitAnswer { n = failureCode(e), text = e.path ?? "" };
    };
    return WaitAnswer { n = 0, text = made };
}

/// Opens the directory, the handle on it from now on.
fn dirOpen(handle: HeapRef, name: string): WaitAnswer {
    let dir = try fsReadDir(name) catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    if (handle is ScriptDir) {
        handle.dir = dir;
    }
    return WaitAnswer { n = 0 };
}

/// A directory's next entry: its kind and name, 0 at the end, or the failure and its detail.
fn dirNext(dir: ReadDirIter): WaitAnswer {
    let next = try dir.next() catch (e: IoError) {
        return WaitAnswer { n = failureCode(e), text = e.detail };
    };
    if (let entry = next) {
        let kind = if (entry.isFile) 1 else if (entry.isDir) 2 else if (entry.isSymlink) 3 else 4;
        return WaitAnswer { n = kind, text = entry.name };
    }
    return WaitAnswer { n = 0 };
}

fn dirClose(dir: ReadDirIter): WaitAnswer {
    try dir.close() catch (e: IoError) {
        return WaitAnswer { n = failureCode(e) };
    };
    return WaitAnswer { n = 0 };
}

fn consolePut(stream: int, data: List<uint8>): int {
    let from = data.toArray();
    let w = if (stream == 2) stderr() else stdout();
    return try w.write(from) catch (e: IoError) failureCode(e);
}

fn consoleFlush(stream: int): int {
    let w = if (stream == 2) stderr() else stdout();
    try w.flush() catch (e: IoError) {
        return failureCode(e);
    };
    return 0;
}

/// An `IoError` as a number, the way the runtime's calls answer: the kinds counted from 1 in their
/// order, and what `std.core`'s prelude reads back in `__ioFailure`.
fn failureCode(e: IoError): int {
    let kind = match (e.kind) {
        .NotFound => 1,
        .PermissionDenied => 2,
        .AlreadyExists => 3,
        .IsDirectory => 4,
        .NotDirectory => 5,
        .InvalidInput => 6,
        .InvalidData => 7,
        .UnexpectedEof => 8,
        .TimedOut => 9,
        .ConnectionRefused => 10,
        .ConnectionReset => 11,
        .AddrInUse => 12,
        .BrokenPipe => 13,
        .Closed => 14,
        .Unsupported => 15,
        .Other { code } => {
            return -((16 << 32) | (code & 0xFFFFFFFF));
        }
        _ => 16,
    };
    return -(kind << 32);
}

/// What a failure says more than its kind: what caused it, or else what was being done.
fn failureDetail(e: IoError): string {
    if (let cause = e.cause()) {
        return cause.message();
    }
    return e.detail;
}

/// What a native of `Bytes` costs for `n` bytes (12 rule 17): a unit for every 32 and one for the call.
fn bytesCost(n: int): int {
    return 1 + n / 32;
}

fn bytesFault(code: string, message: string): NativeFault {
    return NativeFault { code = code, message = message };
}

fn notAByte(v: int): NativeFault {
    return bytesFault("LYS-RT0002", f"{v} is no byte: a byte holds 0 to 255");
}

/// The natives of `Bytes` (S7f5). Those that walk the bytes charge first: where the budget does
/// not cover them they leave everything as it is, and the instance stops at the call.
fn bytesNative(
    which: NativeFn,
    s: uint64[],
    r: HeapRef[],
    x: int,
    y: int,
    shared: RunShared
): ?NativeFault {
    match (which) {
        .BytesNew => {
            let n = s[x] as int;
            if (n < 0) {
                return bytesFault("LYS-RT0003", f"a length of {n}: a length is never negative");
            }
            if (charge(shared, bytesCost(n))) {
                let data = List<uint8>.withCapacity(n);
                var k = 0;
                while (k < n) {
                    data.push(0);
                    k += 1;
                }
                r[y] = ScriptBytes { data = data };
            }
            return null;
        }
        .BytesOfText => {
            let t = textOf(r[y]);
            if (charge(shared, bytesCost(t.length()))) {
                r[y] = ScriptBytes { data = List<uint8>.of(t.toBytes()) };
            }
            return null;
        }
        .BytesOfLatin1 => {
            let t = textOf(r[y]);
            if (charge(shared, bytesCost(t.length()))) {
                let data = List<uint8>.withCapacity(t.length());
                for (c in t.chars()) {
                    data.push((c as uint32) as uint8);
                }
                r[y] = ScriptBytes { data = data };
            }
            return null;
        }
        .BytesOfList => {
            let o = r[y];
            if (!(o is ScriptArray)) {
                return bytesFault("LYS-RT0007", "a list of bytes is no list");
            }
            if (charge(shared, bytesCost(o.n))) {
                let data = List<uint8>.withCapacity(o.n);
                var k = 0;
                while (k < o.n) {
                    let v = o.s[k] as int;
                    if (v < 0 || v > 255) {
                        return notAByte(v);
                    }
                    data.push(v as uint8);
                    k += 1;
                }
                r[y] = ScriptBytes { data = data };
            }
            return null;
        }
        _ => { }
    }
    let o = r[y];
    if (!(o is ScriptBytes)) {
        return bytesFault("LYS-RT0007", "a Bytes' field holds no bytes");
    }
    let data = o.data;
    let n = data.length();
    match (which) {
        .BytesToList => {
            if (charge(shared, bytesCost(n))) {
                let out = List<uint64>.withCapacity(n);
                var k = 0;
                while (k < n) {
                    out.push(data[k] as uint64);
                    k += 1;
                }
                r[y] = ScriptArray { ns = 1, nr = 0, s = out, r = List<HeapRef>.new(), n = n };
            }
        }
        .BytesLen => s[x] = n as uint64,
        .BytesGet => {
            let i = s[x] as int;
            if (i < 0 || i >= n) {
                return bytesFault("LYS-RT0003", f"index {i} out of bounds for length {n}");
            }
            s[x] = data[i] as uint64;
        }
        .BytesSet => {
            let i = s[x] as int;
            let v = s[x + 1] as int;
            if (i < 0 || i >= n) {
                return bytesFault("LYS-RT0003", f"index {i} out of bounds for length {n}");
            }
            if (v < 0 || v > 255) {
                return notAByte(v);
            }
            data[i] = v as uint8;
        }
        .BytesPush => {
            let v = s[x] as int;
            if (v < 0 || v > 255) {
                return notAByte(v);
            }
            data.push(v as uint8);
        }
        .BytesTruncate => data.truncate(s[x] as int),
        .BytesSlice => {
            let a = s[x] as int;
            let e = s[x + 1] as int;
            if (a < 0 || a > e || e > n) {
                return bytesFault("LYS-RT0003", f"range {a}..{e} out of bounds for length {n}");
            }
            if (charge(shared, bytesCost(e - a))) {
                let out = List<uint8>.withCapacity(e - a);
                var k = a;
                while (k < e) {
                    out.push(data[k]);
                    k += 1;
                }
                r[y] = ScriptBytes { data = out };
            }
        }
        .BytesCopy => {
            let p = r[y + 1];
            if (!(p is ScriptBytes)) {
                return bytesFault("LYS-RT0007", "a Bytes' field holds no bytes");
            }
            let at = s[x] as int;
            let from = s[x + 1] as int;
            let to = s[x + 2] as int;
            if (from < 0 || from > to || to > n) {
                return bytesFault(
                    "LYS-RT0003",
                    f"the range {from}..{to} out of bounds for length {n}"
                );
            }
            let m = to - from;
            if (at < 0 || at > p.data.length() - m) {
                return bytesFault(
                    "LYS-RT0003",
                    f"{m} bytes at {at} out of bounds for length {p.data.length()}"
                );
            }
            if (charge(shared, bytesCost(m))) {
                // from the back where the bytes may be one and the target stands behind the source
                if (at > from) {
                    var k = m - 1;
                    while (k >= 0) {
                        p.data[at + k] = data[from + k];
                        k -= 1;
                    }
                } else {
                    var k = 0;
                    while (k < m) {
                        p.data[at + k] = data[from + k];
                        k += 1;
                    }
                }
            }
        }
        .BytesFind => {
            let v = s[x] as int;
            let from = s[x + 1] as int;
            let to = s[x + 2] as int;
            if (from < 0 || from > to || to > n) {
                return bytesFault(
                    "LYS-RT0003",
                    f"the range {from}..{to} out of bounds for length {n}"
                );
            }
            if (charge(shared, bytesCost(to - from))) {
                var found = -1;
                var k = from;
                while (k < to && found < 0) {
                    if (data[k] as int == v) {
                        found = k;
                    }
                    k += 1;
                }
                s[x] = found as uint64;
            }
        }
        .BytesAppend => {
            let p = r[y + 1];
            if (!(p is ScriptBytes)) {
                return bytesFault("LYS-RT0007", "a Bytes' field holds no bytes");
            }
            // its own length first: a value may be appended to itself
            let m = p.data.length();
            if (charge(shared, bytesCost(m))) {
                var k = 0;
                while (k < m) {
                    data.push(p.data[k]);
                    k += 1;
                }
            }
        }
        .BytesCmp => {
            let p = r[y + 1];
            if (!(p is ScriptBytes)) {
                return bytesFault("LYS-RT0007", "a Bytes' field holds no bytes");
            }
            let m = p.data.length();
            let least = if (n < m) n else m;
            if (charge(shared, bytesCost(least))) {
                var k = 0;
                var c = if (n < m) -1 else if (n > m) 1 else 0;
                while (k < least) {
                    if (data[k] != p.data[k]) {
                        c = if (data[k] < p.data[k]) -1 else 1;
                        break;
                    }
                    k += 1;
                }
                s[x] = c as uint64;
            }
        }
        .BytesMix => {
            if (charge(shared, bytesCost(n))) {
                var h = DefaultHasher.new();
                h.writeUint(s[x]);
                var k = 0;
                while (k < n) {
                    h.writeByte(data[k]);
                    k += 1;
                }
                s[x] = h.finish();
            }
        }
        .BytesFill => {
            let v = s[x] as int;
            if (v < 0 || v > 255) {
                return notAByte(v);
            }
            if (charge(shared, bytesCost(n))) {
                var k = 0;
                while (k < n) {
                    data[k] = v as uint8;
                    k += 1;
                }
            }
        }
        .BytesBadUtf8 => {
            if (charge(shared, bytesCost(n))) {
                let _ = try string.fromUtf8(data.asSlice()) catch (e) {
                    s[x] = e.offset as uint64;
                    return null;
                };
                s[x] = (-1) as uint64;
            }
        }
        _ => {
            if (charge(shared, bytesCost(n))) {
                r[y] = ScriptString { text = string.fromUtf8Lossy(data.asSlice()) };
            }
        }
    }
    return null;
}

/// The most words a `BigInt` holds, 2^31 bits: past it a program's shift or product would end the
/// process for want of memory, where a script's fault is due.
let bigMaxWords: int = 67108864;

fn bigFault(code: string, message: string): ?NativeFault {
    return NativeFault { code = code, message = message };
}

/// The natives of a `BigInt` (S7f4), each charging before it works (12 rule 16): one unit stands for
/// about eight words, as a backward jump's cost stands for a few instructions; a product or quotient
/// is the product of the lengths it walks, a text the square of its length.
fn bigNative(
    which: NativeFn,
    s: uint64[],
    r: HeapRef[],
    x: int,
    y: int,
    shared: RunShared
): ?NativeFault {
    match (which) {
        .BigFromInt => {
            r[y] = ScriptBigInt { big = bigFromInt(s[x] as int) };
            return null;
        }
        .BigParse => {
            let radix = s[x] as int;
            if (radix < 2 || radix > 36) {
                return bigFault("LYS-RT0007", f"radix {radix} is outside 2..36");
            }
            let text = textOf(r[y]);
            let w = text.length() / 8 + 1;
            if (!charge(shared, 1 + w * w / 4)) {
                return null;
            }
            if (let v = bigParse(text, radix)) {
                r[y] = ScriptBigInt { big = v };
            } else {
                r[y] = nilRef();
            }
            return null;
        }
        _ => { }
    }
    let o = r[y];
    if (!(o is ScriptBigInt)) {
        return bigFault("LYS-RT0007", "a BigInt's field holds no number");
    }
    let a = o.big;
    let n = a.mag.length();
    let cheap = 1 + n / 8;
    match (which) {
        .BigNeg => {
            if (charge(shared, cheap)) {
                r[y] = ScriptBigInt { big = bigNeg(a) };
            }
        }
        .BigText => {
            let radix = s[x] as int;
            if (radix < 2 || radix > 36) {
                return bigFault("LYS-RT0007", f"radix {radix} is outside 2..36");
            }
            if (charge(shared, 1 + n * n / 4)) {
                r[y] = ScriptString { text = bigText(a, radix) };
            }
        }
        .BigFitsInt => s[x] = truth(bigFitsInt(a)),
        .BigToInt => s[x] = bigToInt(a) as uint64,
        .BigToFloat => s[x] = bigToFloat(a).toBits(),
        .BigBitLength => s[x] = bigBitLength(a) as uint64,
        .BigHash => {
            if (charge(shared, cheap)) {
                s[x] = bigHash(a);
            }
        }
        .BigShl => {
            let count = s[x] as int;
            if (count < 0) {
                return bigFault("LYS-RT0002", f"shift by {count}: a count is never negative");
            }
            if (bigIsZero(a)) {
                r[y] = o;
                return null;
            }
            let words = count / 32 + n + 1;
            if (words > bigMaxWords) {
                return bigFault("LYS-RT0002", "integer overflow: a BigInt holds at most 2^31 bits");
            }
            if (charge(shared, 1 + words / 8)) {
                r[y] = ScriptBigInt { big = bigShl(a, count) };
            }
        }
        .BigShr => {
            let count = s[x] as int;
            if (count < 0) {
                return bigFault("LYS-RT0002", f"shift by {count}: a count is never negative");
            }
            if (charge(shared, cheap)) {
                r[y] = ScriptBigInt { big = bigShr(a, count) };
            }
        }
        _ => {
            let p = r[y + 1];
            if (!(p is ScriptBigInt)) {
                return bigFault("LYS-RT0007", "a BigInt's field holds no number");
            }
            return bigTwo(which, s, r, x, y, a, p.big, shared);
        }
    }
    return null;
}

/// The natives of two `BigInt`s (S7f4).
fn bigTwo(
    which: NativeFn,
    s: uint64[],
    r: HeapRef[],
    x: int,
    y: int,
    a: Big,
    b: Big,
    shared: RunShared
): ?NativeFault {
    let n = a.mag.length();
    let m = b.mag.length();
    let cheap = 1 + (if (n > m) n else m) / 8;
    match (which) {
        .BigAdd => {
            if (charge(shared, cheap)) {
                r[y] = ScriptBigInt { big = bigAdd(a, b) };
            }
        }
        .BigSub => {
            if (charge(shared, cheap)) {
                r[y] = ScriptBigInt { big = bigSub(a, b) };
            }
        }
        .BigCmp => {
            if (charge(shared, cheap)) {
                s[x] = bigCmp(a, b) as uint64;
            }
        }
        .BigMul => {
            if (n + m > bigMaxWords) {
                return bigFault("LYS-RT0002", "integer overflow: a BigInt holds at most 2^31 bits");
            }
            if (charge(shared, 1 + n * m / 8)) {
                r[y] = ScriptBigInt { big = bigMul(a, b) };
            }
        }
        _ => {
            if (bigIsZero(b)) {
                return bigFault("LYS-RT0001", "integer division by zero");
            }
            let span = if (n >= m) n - m + 1 else 1;
            if (charge(shared, 1 + span * m / 8)) {
                let (q, rem) = bigDivRem(a, b);
                r[y] = ScriptBigInt { big = if (which == .BigDiv) q else rem };
            }
        }
    }
    return null;
}

/// One unit of budget spent: the budget left, `-1` for none, `-2` once it ran out.
fn spend(budget: int): int {
    if (budget < 0) {
        return budget;
    }
    if (budget == 0) {
        return -2;
    }
    return budget - 1;
}

/// The length a register stack grows to so that it holds `need`: at least 256, doubling.
fn grown(have: int, need: int): int {
    var n = if (have < 256) 256 else have;
    while (n < need) {
        n *= 2;
    }
    return n;
}

/// `n` reference registers, each `null`.
fn refArray(n: int): HeapRef[] {
    return arrayOf(n, (i: int) => nilRef());
}

fn growScalars(s: uint64[], need: int): uint64[] {
    var bigger: uint64[] = [0 as uint64] * grown(s.length(), need);
    var i = 0;
    while (i < s.length()) {
        bigger[i] = s[i];
        i += 1;
    }
    return bigger;
}

fn growRefs(r: HeapRef[], need: int): HeapRef[] {
    var bigger: HeapRef[] = refArray(grown(r.length(), need));
    var i = 0;
    while (i < r.length()) {
        bigger[i] = r[i];
        i += 1;
    }
    return bigger;
}

/// The panic outcome, with the script's frames: the current one first, then its callers.
fn panicOut(
    module: Module,
    frames: FrameStack,
    fi: int,
    pc: int,
    code: string,
    message: string
): Outcome {
    return Outcome.Panic(
        ScriptPanic { code = code, message = message, trace = traceOf(module, frames, fi, pc) }
    );
}

/// The script's frames: the current one first, then its callers; a report's call stands for
/// none.
fn traceOf(module: Module, frames: FrameStack, fi: int, pc: int): string[] {
    let trace = List<string>.new();
    trace.push(frameText(module.functions[fi], pc));
    var i = frames.length() - 1;
    while (i >= 0) {
        let fr = frames.get(i);
        if (fr.function >= 0) {
            trace.push(frameText(module.functions[fr.function], fr.pc - 1));
        }
        i -= 1;
    }
    return trace.toArray();
}

fn frameText(f: Function, pc: int): string {
    let line = if (pc >= 0 && pc < f.lines.length()) f.lines[pc] else 0;
    // an imported module's frame names its file (S5a2)
    return if (f.file == "") f"at {f.name} (line {line})" else f"at {f.name} ({f.file}:{line})";
}
