//! The run-time form of compiled code: modules, functions and object types, as the compiler
//! (S2) and the text assembler produce them and the interpreter runs them. `check` tests the
//! structure of a module; it guards against faults of the toolchain, not against foreign
//! bytecode, which is never loaded (design/v1, 01 S10).
import std.collections { List };
import lyric_script.vm.native { nativeCount, nativeInfo, nativeOf };
import lyric_script.vm.op { Instr, Op, Operand, info };

/// What a function returns, and in which register file the caller receives it: one scalar,
/// one reference, or `Slots` — `retS` scalars and `retR` references, as a value of several
/// slots (`?int`) is held (11 V2).
pub enum ReturnKind :: [Equatable] {
    Void,
    Scalar,
    Ref,
    Slots,
}

/// An object type: its name and its fields, the scalar ones and the reference ones apart
/// (design/v1, 11 V2). The descriptor's identity is the type's identity.
pub class TypeDesc :: [Identity] {
    name: string,
    scalarFields: string[],
    refFields: string[],
    /// The function of each interface method by its slot, -1 where the type has none (S3f).
    var methods: int[] = [],
    /// The type of the program this descriptor is one of, for `is`; -1 for none.
    var family: int = -1,
    /// The interfaces the type conforms to, parents included, for `is` against an interface.
    var ifaces: int[] = [],
    /// S3i, the descriptor as a value (11 Gen): the template it is an instance of — a type of
    /// the program, or a structural kind (`fnKind`, `tupleKind`, `optionalKind`) —, -1 for none;
    /// its type arguments, or its parts; the name before them.
    var template: int = -1,
    var args: TypeDesc[] = [],
    var base: string = "",
    /// A variant's enum; a payload enum's variants; an interface's descriptor.
    var parent: ?TypeDesc = null,
    var variants: TypeDesc[] = [],
    var isInterface: bool = false,
    /// Its number among the descriptors of a run, the key of their interning.
    var id: int = -1,
}

/// The structural kinds of a descriptor's template: a function type (its parameters, then its
/// result), a tuple (its elements), an optional (its value).
pub let fnKind: int = -2;

pub let tupleKind: int = -3;

pub let optionalKind: int = -4;

/// A region of a function's code, `start` up to before `end`, whose errors go to `target`: the
/// error arrives in reference register `reg` (S4a), its record in `rec` (S4b). A function's
/// regions are listed innermost first, so the first that covers an instruction takes its errors.
pub struct Handler {
    start: int,
    end: int,
    target: int,
    reg: int,
    rec: int,
}

/// A compiled function. Its first `paramsS` scalar registers and first `paramsR` reference
/// registers hold the arguments.
pub class Function :: [Identity] {
    name: string,
    paramsS: int,
    paramsR: int,
    scalars: int,
    refs: int,
    returns: ReturnKind,
    code: Instr[],
    /// The scalar constants, as their 64 bits.
    constants: uint64[],
    /// The string constants.
    strings: string[],
    /// The source line of each instruction; 0 where there is none.
    lines: int[],
    /// For `Slots`: how many scalar and reference slots the result has.
    retS: int = 0,
    retR: int = 0,
    /// The regions whose errors the function handles (S4a).
    handlers: Handler[] = [],
    /// The file of an imported module's function, relative to the root, which its frames name;
    /// empty for the entry's (S5a2).
    file: string = "",
}

/// A compiled module: its functions, the object types they create, and how many scalar and
/// reference globals its code reads and writes (the script's top-level bindings).
pub class Module :: [Identity] {
    name: string,
    functions: Function[],
    types: TypeDesc[],
    globalsS: int = 0,
    globalsR: int = 0,
    /// The slots of `Error`'s `message` and `cause`: what the VM asks an error that leaves every
    /// frame for its report (S4a); -1 in a module without `Error`.
    errorMessage: int = -1,
    /// The module type of the prelude's `Cancelled`, which a wait in a cancelled task throws; -1
    /// where the program has none (S6c1).
    cancelledType: int = -1,
    /// The module type of the prelude's `ChannelClosed` (S6d1).
    channelClosedType: int = -1,
    errorCause: int = -1,
    /// The rights its imports ask for, each with where (01 S1, S5e): checked when it is loaded.
    var rights: RightUse[] = [],
}

/// A right a module's import asks for: its class — `file`, `net`, `process`, `os`, `native` —,
/// the module imported, and the file and line of the import.
pub struct RightUse :: [Equatable, Debug] {
    pub right: string,
    pub module: string,
    pub path: string,
    pub line: int,
}

/// A fault in the structure of a module: the function, the instruction and what is wrong.
pub struct CheckError {
    function: string,
    pc: int,
    message: string,
}

/// The faults of `module`'s structure; none for a module the interpreter can run.
pub fn check(module: Module): CheckError[] {
    let errors = List<CheckError>.new();
    for (f in module.functions) {
        checkFunction(module, f, errors);
    }
    return errors.toArray();
}

fn checkFunction(module: Module, f: Function, errors: List<CheckError>): void {
    if (f.paramsS > f.scalars || f.paramsR > f.refs) {
        errors.push(
            CheckError { function = f.name, pc = -1, message = "more parameters than registers" }
        );
    }
    if (f.lines.length() != f.code.length()) {
        errors.push(
            CheckError {
                function = f.name,
                pc = -1,
                message = "the line table does not match the code",
            }
        );
    }
    if (f.code.length() == 0) {
        errors.push(CheckError { function = f.name, pc = -1, message = "no instructions" });
    }
    for (h in f.handlers) {
        if (h.start < 0 || h.start > h.end || h.end > f.code.length()) {
            errors.push(
                CheckError { function = f.name, pc = h.start, message = "a handler's region" }
            );
        }
        if (h.target < 0 || h.target >= f.code.length()) {
            errors.push(
                CheckError { function = f.name, pc = h.start, message = "a handler's target" }
            );
        }
        for (x in [h.reg, h.rec]) {
            if (x < 0 || x >= f.refs) {
                errors.push(
                    CheckError {
                        function = f.name,
                        pc = h.start,
                        message = f"a handler's register {x} of {f.refs}",
                    }
                );
            }
        }
    }
    var pc = 0;
    while (pc < f.code.length()) {
        let ins = f.code[pc];
        let operands = info(ins.op).operands;
        var i = 0;
        while (i < operands.length()) {
            let value = operandValue(ins, i);
            let fault = checkOperand(module, f, ins.op, operands[i], value);
            if (fault != null) {
                errors.push(CheckError { function = f.name, pc = pc, message = fault });
            }
            i += 1;
        }
        let call = checkCall(module, f, ins);
        if (call != null) {
            errors.push(CheckError { function = f.name, pc = pc, message = call });
        }
        let ret = checkReturn(f, ins.op);
        if (ret != null) {
            errors.push(CheckError { function = f.name, pc = pc, message = ret });
        }
        if (ins.op == .RetN
            && ((ins.a as int) + f.retS > f.scalars || (ins.b as int) + f.retR > f.refs)) {
            errors.push(
                CheckError {
                    function = f.name,
                    pc = pc,
                    message = "'ret.n' reads past the registers",
                }
            );
        }
        pc += 1;
    }
}

fn operandValue(ins: Instr, i: int): int {
    return match (i) {
        0 => ins.a as int,
        1 => ins.b as int,
        _ => ins.c as int,
    };
}

fn checkOperand(module: Module, f: Function, op: Op, kind: Operand, value: int): ?string {
    return match (kind) {
        .Scalar => if (value < f.scalars) null else f"scalar register {value} of {f.scalars}",
        .Ref => if (value < f.refs) null else f"reference register {value} of {f.refs}",
        .Imm => null,
        .Const => {
            let size = if (op == .LoadStr) f.strings.length() else f.constants.length();
            if (value < size) null else f"constant {value} of {size}"
        }
        .Label => if (value < f.code.length()) null
            else f"jump target {value} of {f.code.length()}",
        .Func => if (value < module.functions.length()) null
            else f"function {value} of {module.functions.length()}",
        .Type => if (value < module.types.length()) null
            else f"type {value} of {module.types.length()}",
        .GlobalS => if (value < module.globalsS) null
            else f"scalar global {value} of {module.globalsS}",
        .GlobalR => if (value < module.globalsR) null
            else f"reference global {value} of {module.globalsR}",
        .Native => if (value < nativeCount) null else f"native {value} of {nativeCount}",
        .ScalarBase | .RefBase | .Field => null,
    };
}

/// A call passes the callee's parameters from consecutive registers starting at its bases, and
/// the result lands at the base of the file the callee returns in.
fn checkCall(module: Module, f: Function, ins: Instr): ?string {
    if (ins.op == .CallN && (ins.a as int) < nativeCount) {
        let n = nativeInfo(nativeOf(ins.a as int));
        let baseS = ins.b as int;
        let baseR = ins.c as int;
        if (baseS + n.scalars > f.scalars || (n.returnsScalar && baseS >= f.scalars)) {
            return f"native '{n.name}' reaches past the scalar registers";
        }
        if (baseR + n.refs > f.refs || (n.returnsRef && baseR >= f.refs)) {
            return f"native '{n.name}' reaches past the reference registers";
        }
        return null;
    }
    // `inst.t` reads one descriptor per argument of its shape (S3i)
    if (ins.op == .InstT && (ins.b as int) < module.types.length()) {
        let n = module.types[ins.b as int].args.length();
        return if ((ins.c as int) + n > f.refs) "'inst.t' reads past the reference registers"
            else null;
    }
    if (ins.op != .Call || (ins.a as int) >= module.functions.length()) {
        return null;
    }
    let callee = module.functions[ins.a as int];
    let baseS = ins.b as int;
    let baseR = ins.c as int;
    if (baseS + callee.paramsS > f.scalars || (callee.returns == .Scalar && baseS >= f.scalars)) {
        return f"call of '{callee.name}' reaches past the scalar registers";
    }
    if (baseR + callee.paramsR > f.refs || (callee.returns == .Ref && baseR >= f.refs)) {
        return f"call of '{callee.name}' reaches past the reference registers";
    }
    if (callee.returns == .Slots
        && (baseS + callee.retS > f.scalars || baseR + callee.retR > f.refs)) {
        return f"the result of '{callee.name}' reaches past the registers";
    }
    return null;
}

fn checkReturn(f: Function, op: Op): ?string {
    return match (op) {
        .RetN => if (f.returns == .Slots) null
            else "'ret.n' in a function that does not return slots",
        .Ret => if (f.returns == .Void) null else "'ret' in a function that returns a value",
        .RetS => if (f.returns == .Scalar) null
            else "'ret.s' in a function that does not return a scalar",
        .RetR => if (f.returns == .Ref) null
            else "'ret.r' in a function that does not return a reference",
        _ => null,
    };
}
