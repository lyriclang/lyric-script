        .HashMixStr => 17,
        .ObjectNumber => 18,
        .IndexNew => 19,
        .IndexAdd => 20,
        .IndexFirst => 21,
        .IndexNext => 22,
        .IndexRemove => 23,
        .IndexClear => 24,
        .StrLen => 25,
        .StrAt => 26,
        .StrNext => 27,
        .StrPrev => 28,
        .StrSlice => 29,
        .StrCharCount => 30,
        .StrUpper => 31,
        .StrLower => 32,
        .StrTrim => 33,
        .StrRepeat => 34,
        .StrFromChars => 35,
        .StrFind => 36,
        .StrMatchesAt => 37,
        .CharCategory => 38,
        .CharWhite => 39,
        .CharUpper => 40,
        .CharLower => 41,
        .FloatOfText => 42,
        .BuilderNew => 43,
        .BuilderAppendStr => 44,
        .BuilderAppendChar => 45,
        .BuilderLength => 46,
        .BuilderClear => 47,
        .BuilderText => 48,
        .StrDebug => 49,
        .CharDebug => 50,
        .FmtInt => 51,
        .FmtFloat => 52,
        .FmtStr => 53,
        .FmtPad => 54,
        .FmtProblem => 55,
        .IntBits => 56,
        .IntRotate => 57,
        .FloatFromBits => 58,
        .FloatToBits => 59,
        .MathOne => 60,
        .MathTwo => 61,
        .BigFromInt => 62,
        .BigAdd => 63,
        .BigSub => 64,
        .BigMul => 65,
        .BigDiv => 66,
        .BigRem => 67,
        .BigNeg => 68,
        .BigCmp => 69,
        .BigText => 70,
        .BigParse => 71,
        .BigFitsInt => 72,
        .BigToInt => 73,
        .BigToFloat => 74,
        .BigShl => 75,
        .BigShr => 76,
        .BigBitLength => 77,
        .BigHash => 78,
        .BytesNew => 79,
        .BytesOfText => 80,
        .BytesOfLatin1 => 81,
        .BytesOfList => 82,
        .BytesToList => 83,
        .BytesLen => 84,
        .BytesGet => 85,
        .BytesSet => 86,
        .BytesPush => 87,
        .BytesTruncate => 88,
