fn nativeInfo(n: NativeFn): NativeInfo {
    return match (n) {
        .Print => sig("print", 0, 1, false, false),
        .Println => sig("println", 0, 1, false, false),
        .Concat => sig("concat", 0, 2, false, true),
        .IntToStr => sig("int.text", 1, 0, false, true),
        .FloatToStr => sig("float.text", 1, 0, false, true),
        .BoolToStr => sig("bool.text", 1, 0, false, true),
        .CharToStr => sig("char.text", 1, 0, false, true),
        .StrEq => sig("string.eq", 0, 2, true, false),
        .StrCmp => sig("string.cmp", 0, 2, true, false),
        .TraceText => sig("error.trace", 0, 1, false, true),
        .OsEnv => sig("os.env", 0, 1, false, true),
        .FsExists => sig("fs.exists", 0, 1, true, false),
        .FloatOrderKey => sig("float.orderKey", 1, 0, true, false),
        .ListSortInts => sig("list.sortInts", 0, 1, false, false),
        .ListSortFloats => sig("list.sortFloats", 0, 1, false, false),
        .ListSortStrings => sig("list.sortStrings", 0, 1, false, false),
        .HashMixInt => sig("hash.mixInt", 2, 0, true, false),
        .HashMixStr => sig("hash.mixStr", 1, 1, true, false),
        .ObjectNumber => sig("object.number", 0, 1, true, false),
        .IndexNew => sig("index.new", 0, 0, false, true),
        .IndexAdd => sig("index.add", 2, 1, false, false),
        .IndexFirst => sig("index.first", 1, 1, true, false),
        .IndexNext => sig("index.next", 2, 1, true, false),
        .IndexRemove => sig("index.remove", 2, 1, false, false),
        .IndexClear => sig("index.clear", 0, 1, false, false),
        .StrLen => sig("string.len", 0, 1, true, false),
        .StrAt => sig("string.at", 1, 1, true, false),
        .StrNext => sig("string.next", 1, 1, true, false),
        .StrPrev => sig("string.prev", 1, 1, true, false),
        .StrSlice => sig("string.slice", 2, 1, false, true),
        .StrCharCount => sig("string.charCount", 0, 1, true, false),
        .StrUpper => sig("string.upper", 0, 1, false, true),
        .StrLower => sig("string.lower", 0, 1, false, true),
        .StrTrim => sig("string.trim", 1, 1, false, true),
        .StrRepeat => sig("string.repeat", 1, 1, false, true),
        .StrFromChars => sig("string.fromChars", 0, 1, false, true),
        .StrFind => sig("string.find", 1, 2, true, false),
        .StrMatchesAt => sig("string.matchesAt", 1, 2, true, false),
        .CharCategory => sig("char.category", 1, 0, true, false),
        .CharWhite => sig("char.white", 1, 0, true, false),
        .CharUpper => sig("char.upper", 1, 0, true, false),
        .CharLower => sig("char.lower", 1, 0, true, false),
        .FloatOfText => sig("float.ofText", 0, 1, true, false),
        .BuilderNew => sig("builder.new", 0, 0, false, true),
        .BuilderAppendStr => sig("builder.appendStr", 0, 2, false, false),
        .BuilderAppendChar => sig("builder.appendChar", 1, 1, false, false),
        .BuilderLength => sig("builder.length", 0, 1, true, false),
        .BuilderClear => sig("builder.clear", 0, 1, false, false),
        .BuilderText => sig("builder.text", 0, 1, false, true),
        .StrDebug => sig("string.debug", 0, 1, false, true),
        .CharDebug => sig("char.debug", 1, 0, false, true),
        .FmtInt => sig("fmt.int", 1, 1, false, true),
        .FmtFloat => sig("fmt.float", 1, 1, false, true),
        .FmtStr => sig("fmt.str", 0, 2, false, true),
        .FmtPad => sig("fmt.pad", 0, 2, false, true),
        .FmtProblem => sig("fmt.problem", 1, 1, false, true),
        .IntBits => sig("int.bits", 2, 0, true, false),
        .IntRotate => sig("int.rotate", 2, 0, true, false),
        .FloatFromBits => sig("float.fromBits", 1, 0, true, false),
        .FloatToBits => sig("float.toBits", 1, 0, true, false),
        .MathOne => sig("math.one", 2, 0, true, false),
        .MathTwo => sig("math.two", 3, 0, true, false),
        .BigFromInt => sig("big.fromInt", 1, 0, false, true),
        .BigAdd => sig("big.add", 0, 2, false, true),
        .BigSub => sig("big.sub", 0, 2, false, true),
        .BigMul => sig("big.mul", 0, 2, false, true),
        .BigDiv => sig("big.div", 0, 2, false, true),
        .BigRem => sig("big.rem", 0, 2, false, true),
        .BigNeg => sig("big.neg", 0, 1, false, true),
        .BigCmp => sig("big.cmp", 0, 2, true, false),
        .BigText => sig("big.text", 1, 1, false, true),
        .BigParse => sig("big.parse", 1, 1, false, true),
        .BigFitsInt => sig("big.fitsInt", 0, 1, true, false),
        .BigToInt => sig("big.toInt", 0, 1, true, false),
        .BigToFloat => sig("big.toFloat", 0, 1, true, false),
        .BigShl => sig("big.shl", 1, 1, false, true),
        .BigShr => sig("big.shr", 1, 1, false, true),
        .BigBitLength => sig("big.bitLength", 0, 1, true, false),
        .BigHash => sig("big.hash", 0, 1, true, false),
        .BytesNew => sig("bytes.new", 1, 0, false, true),
        .BytesOfText => sig("bytes.ofText", 0, 1, false, true),
        .BytesOfLatin1 => sig("bytes.ofLatin1", 0, 1, false, true),
        .BytesOfList => sig("bytes.ofList", 0, 1, false, true),
        .BytesToList => sig("bytes.toList", 0, 1, false, true),
        .BytesLen => sig("bytes.len", 0, 1, true, false),
        .BytesGet => sig("bytes.get", 1, 1, true, false),
        .BytesSet => sig("bytes.set", 2, 1, false, false),
        .BytesPush => sig("bytes.push", 1, 1, false, false),
        .BytesTruncate => sig("bytes.truncate", 1, 1, false, false),
        .BytesSlice => sig("bytes.slice", 2, 1, false, true),
        .BytesAppend => sig("bytes.append", 0, 2, false, false),
        .BytesCmp => sig("bytes.cmp", 0, 2, true, false),
        .BytesMix => sig("bytes.mix", 1, 1, true, false),
        .BytesFill => sig("bytes.fill", 1, 1, false, false),
        .BytesBadUtf8 => sig("bytes.badUtf8", 0, 1, true, false),
        .BytesText => sig("bytes.text", 0, 1, false, true),
        .RandomSeeded => sig("random.seeded", 1, 0, false, true),
        .RandomFresh => sig("random.fresh", 0, 0, false, true),
        .RandomInt => sig("random.int", 0, 1, true, false),
        .RandomInRange => sig("random.inRange", 2, 1, true, false),
        .RandomFloat => sig("random.float", 0, 1, true, false),
        .RandomNormal => sig("random.normal", 2, 1, true, false),
        .BytesCopy => sig("bytes.copy", 3, 2, false, false),
        .BytesFind => sig("bytes.find", 3, 1, true, false),
        .ConsoleEprint => sig("console.eprint", 0, 1, false, false),
        .ConsoleEprintln => sig("console.eprintln", 0, 1, false, false),
        .ConsoleFlushAll => sig("console.flushAll", 0, 0, false, false),
        .ConsolePut => sig("console.put", 1, 1, true, false),
        .ConsoleFlush => sig("console.flush", 1, 0, true, false),
        .ConsoleLine => sig("console.line", 0, 1, true, false),
        .ConsoleRead => sig("console.read", 0, 1, true, false),
    };
}

/// Whether a native waits (07 N6; S7g2): it runs on a task of the host while the script's task waits,
/// called by `call.w`; every other by `call.n`.
fn nativeWaits(n: NativeFn): bool {
    return match (n) {
        .ConsoleLine | .ConsoleRead => true,
        _ => false,
    };
}

/// The native of a name of the table, `os.env`; `null` where none has it.
fn nativeNamed(name: string): ?NativeFn {
    var k = 0;
    while (k < nativeCount) {
        let n = nativeOf(k);
        if (nativeInfo(n).name == name) {
            return n;
        }
        k += 1;
    }
    return null;
}

fn sig(name: string, scalars: int, refs: int, returnsScalar: bool, returnsRef: bool): NativeInfo {
    return NativeInfo {
        name = name,
        scalars = scalars,
        refs = refs,
        returnsScalar = returnsScalar,
        returnsRef = returnsRef,
    };
}
