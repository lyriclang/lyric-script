//! The VM's natives (design/v1, 11 and 12): what a script reaches that is no bytecode. A native is
//! called as a function is (`call.n`, the S1 convention): its arguments stand in consecutive
//! registers from the call's bases, and its result lands at the base of its file. S2 has the
//! prelude's output and the operations on strings the core needs; S7 the standard library's
//! (S7a): a module of `std` calls one as `__os_env(name)` in the body of a function whose
//! signature is the native's — the compiler checks the slots against this table.

/// A native, by what it does.
enum NativeFn :: [Equatable] {
    /// `print(text)`: the text to standard output.
    Print,
    /// `println(text)`: the text and a line end.
    Println,
    /// Two strings joined.
    Concat,
    IntToStr,
    FloatToStr,
    BoolToStr,
    CharToStr,
    /// Whether two strings are equal, as a bool.
    StrEq,
    /// -1, 0 or 1 as the first string sorts before, with or after the second, by bytes.
    StrCmp,
    /// The frames of an error's record as text, a line `    at <function> (line <n>)` each,
    /// innermost first (S4b).
    TraceText,
    /// `std.os.env(name)`: the environment variable's value, `null` where it is not set.
    OsEnv,
    /// `std.fs.exists(path)`: whether something is at the path.
    FsExists,
    /// A `float`'s place in IEEE 754's total order as an `int` (S7c5b): -NaN, -infinity, …, -0.0,
    /// 0.0, …, infinity, NaN, compared as integers.
    FloatOrderKey,
    /// A list sorted in place (S7c6c2): ints and chars by value, floats by IEEE 754's total
    /// order, strings by their bytes.
    ListSortInts,
    ListSortFloats,
    ListSortStrings,
    /// A hash's state and a word mixed (S7d1): SipHash-1-3 under the process's key.
    HashMixInt,
    /// A hash's state and a string's bytes mixed.
    HashMixStr,
    /// An object's number, given the first time it is asked (01 S8).
    ObjectNumber,
    /// A map's index (S7d2): a new one; a place under a hash; the first place under a hash, or -1;
    /// the next after a place, or -1; a place taken out; every place taken out.
    IndexNew,
    IndexAdd,
    IndexFirst,
    IndexNext,
    IndexRemove,
    IndexClear,
    /// The strings' members (S7e1): a string's length in bytes; the character at a byte, a panic
    /// outside or inside a character; the first byte of the next character and of the one
    /// before; a slice on characters' bounds; the characters counted; the case mappings; the
    /// trims (0 both ends, 1 the start, 2 the end); a repetition; a list of characters joined;
    /// the first match of a string from a byte, or -1; whether one stands at a byte.
    StrLen,
    StrAt,
    StrNext,
    StrPrev,
    StrSlice,
    StrCharCount,
    StrUpper,
    StrLower,
    StrTrim,
    StrRepeat,
    StrFromChars,
    StrFind,
    StrMatchesAt,
    /// A character's general category, as its place in `UnicodeCategory`; whether it is white
    /// space; its simple case mappings.
    CharCategory,
    CharWhite,
    CharUpper,
    CharLower,
    /// A float read from a text of a float's form (S7e2), Lyric 5's reading, correctly rounded;
    /// the form is the program's to check.
    FloatOfText,
    /// A builder of text (S7e3): a new one; a string and a character appended; its length in
    /// bytes; emptied; its text.
    BuilderNew,
    BuilderAppendStr,
    BuilderAppendChar,
    BuilderLength,
    BuilderClear,
    BuilderText,
    /// A string's and a character's Debug form (S7e3): Lyric 5's, quoted and escaped.
    StrDebug,
    CharDebug,
    /// The format language (S7e4b): an integer's, a float's, a string's text under a spec,
    /// a text padded, what is wrong with a spec read at run time.
    FmtInt,
    FmtFloat,
    FmtStr,
    FmtPad,
    FmtProblem,
    /// An integer's bits counted (leading zeros, trailing zeros, ones) and rotated; a float's
    /// bits as an integer and back (S7f1).
    IntBits,
    IntRotate,
    FloatFromBits,
    FloatToBits,
    MathOne,
    MathTwo,
    BigFromInt,
    BigAdd,
    BigSub,
    BigMul,
    BigDiv,
    BigRem,
    BigNeg,
    BigCmp,
    BigText,
    BigParse,
    BigFitsInt,
    BigToInt,
    BigToFloat,
    BigShl,
    BigShr,
    BigBitLength,
    BigHash,
    BytesNew,
    BytesOfText,
    BytesOfLatin1,
    BytesOfList,
    BytesToList,
    BytesLen,
    BytesGet,
    BytesSet,
    BytesPush,
    BytesTruncate,
    BytesSlice,
    BytesAppend,
    BytesCmp,
    BytesMix,
    BytesFill,
    BytesBadUtf8,
    BytesText,
    RandomSeeded,
    RandomFresh,
    RandomInt,
    RandomInRange,
    RandomFloat,
    RandomNormal,
    /// `b.copyInto(into, at, from, to)`: `s[x]` is `at`, then `from`, `to`; `r[y]` the bytes, `r[y + 1]` `into`.
    BytesCopy,
    /// The first `s[x]` in `s[x + 1]..s[x + 2]` of `r[y]`, into `s[x]`; -1 for none.
    BytesFind,
    /// The console (S7g2): text on the standard error; what the buffers hold written out, a failure
    /// dropped; bytes into a stream's buffer and that stream written out, each answering a failure
    /// as `-(kind << 32 | code)`. The last two wait (`call.w`): the next line of the standard input
    /// into a holder, 1, or 0 at its end; bytes of the input, how many.
    ConsoleEprint,
    ConsoleEprintln,
    ConsoleFlushAll,
    ConsolePut,
    ConsoleFlush,
    ConsoleLine,
    ConsoleRead,
}

/// What a native takes and gives: its name in the text form, its scalar and reference
/// parameters, the file of its result.
struct NativeInfo {
    name: string,
    scalars: int,
    refs: int,
    returnsScalar: bool,
    returnsRef: bool,
}

/// How many natives there are: the numbers `0..nativeCount` name them.
let nativeCount: int = 111;

/// The native of a number; the numbers are the order of `NativeFn`.
fn nativeOf(n: int): NativeFn {
    return match (n) {
        0 => NativeFn.Print,
        1 => NativeFn.Println,
        2 => NativeFn.Concat,
        3 => NativeFn.IntToStr,
        4 => NativeFn.FloatToStr,
        5 => NativeFn.BoolToStr,
        6 => NativeFn.CharToStr,
        7 => NativeFn.StrEq,
        8 => NativeFn.StrCmp,
        9 => NativeFn.TraceText,
        10 => NativeFn.OsEnv,
        11 => NativeFn.FsExists,
        12 => NativeFn.FloatOrderKey,
        13 => NativeFn.ListSortInts,
        14 => NativeFn.ListSortFloats,
        15 => NativeFn.ListSortStrings,
        16 => NativeFn.HashMixInt,
        17 => NativeFn.HashMixStr,
        18 => NativeFn.ObjectNumber,
        19 => NativeFn.IndexNew,
        20 => NativeFn.IndexAdd,
        21 => NativeFn.IndexFirst,
        22 => NativeFn.IndexNext,
        23 => NativeFn.IndexRemove,
        24 => NativeFn.IndexClear,
        25 => NativeFn.StrLen,
        26 => NativeFn.StrAt,
        27 => NativeFn.StrNext,
        28 => NativeFn.StrPrev,
        29 => NativeFn.StrSlice,
        30 => NativeFn.StrCharCount,
        31 => NativeFn.StrUpper,
        32 => NativeFn.StrLower,
        33 => NativeFn.StrTrim,
        34 => NativeFn.StrRepeat,
        35 => NativeFn.StrFromChars,
        36 => NativeFn.StrFind,
        37 => NativeFn.StrMatchesAt,
        38 => NativeFn.CharCategory,
        39 => NativeFn.CharWhite,
        40 => NativeFn.CharUpper,
        41 => NativeFn.CharLower,
        42 => NativeFn.FloatOfText,
        43 => NativeFn.BuilderNew,
        44 => NativeFn.BuilderAppendStr,
        45 => NativeFn.BuilderAppendChar,
        46 => NativeFn.BuilderLength,
        47 => NativeFn.BuilderClear,
        48 => NativeFn.BuilderText,
        49 => NativeFn.StrDebug,
        50 => NativeFn.CharDebug,
        51 => NativeFn.FmtInt,
        52 => NativeFn.FmtFloat,
        53 => NativeFn.FmtStr,
        54 => NativeFn.FmtPad,
        55 => NativeFn.FmtProblem,
        56 => NativeFn.IntBits,
        57 => NativeFn.IntRotate,
        58 => NativeFn.FloatFromBits,
        59 => NativeFn.FloatToBits,
        60 => NativeFn.MathOne,
        61 => NativeFn.MathTwo,
        62 => NativeFn.BigFromInt,
        63 => NativeFn.BigAdd,
        64 => NativeFn.BigSub,
        65 => NativeFn.BigMul,
        66 => NativeFn.BigDiv,
        67 => NativeFn.BigRem,
        68 => NativeFn.BigNeg,
        69 => NativeFn.BigCmp,
        70 => NativeFn.BigText,
        71 => NativeFn.BigParse,
        72 => NativeFn.BigFitsInt,
        73 => NativeFn.BigToInt,
        74 => NativeFn.BigToFloat,
        75 => NativeFn.BigShl,
        76 => NativeFn.BigShr,
        77 => NativeFn.BigBitLength,
        78 => NativeFn.BigHash,
        79 => NativeFn.BytesNew,
        80 => NativeFn.BytesOfText,
        81 => NativeFn.BytesOfLatin1,
        82 => NativeFn.BytesOfList,
        83 => NativeFn.BytesToList,
        84 => NativeFn.BytesLen,
        85 => NativeFn.BytesGet,
        86 => NativeFn.BytesSet,
        87 => NativeFn.BytesPush,
        88 => NativeFn.BytesTruncate,
        89 => NativeFn.BytesSlice,
        90 => NativeFn.BytesAppend,
        91 => NativeFn.BytesCmp,
        92 => NativeFn.BytesMix,
        93 => NativeFn.BytesFill,
        94 => NativeFn.BytesBadUtf8,
        95 => NativeFn.BytesText,
        96 => NativeFn.RandomSeeded,
        97 => NativeFn.RandomFresh,
        98 => NativeFn.RandomInt,
        99 => NativeFn.RandomInRange,
        100 => NativeFn.RandomFloat,
        101 => NativeFn.RandomNormal,
        102 => NativeFn.BytesCopy,
        103 => NativeFn.BytesFind,
        104 => NativeFn.ConsoleEprint,
        105 => NativeFn.ConsoleEprintln,
        106 => NativeFn.ConsoleFlushAll,
        107 => NativeFn.ConsolePut,
        108 => NativeFn.ConsoleFlush,
        109 => NativeFn.ConsoleLine,
        _ => NativeFn.ConsoleRead,
    };
}

