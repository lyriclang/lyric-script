// std.collections (Lyric 5 12 §Collections; S7d): the maps. A map holds each key once, in the
// order the keys came (12 Src: insertion order, where Lyric 5's map keeps none of its own); its
// entries lie in lists, and the VM keeps the places of their hashes (P27) — the program hashes
// the keys and compares them. The prelude names this module: the loader adds it to a program that
// names a map or writes a map literal, and its names are the prelude's.

fn __ixNew(): Any = __index_new()
fn __ixAdd(ix: Any, h: int, p: int): void = __index_add(ix, h, p)
fn __ixFirst(ix: Any, h: int): int = __index_first(ix, h)
fn __ixNext(ix: Any, h: int, p: int): int = __index_next(ix, h, p)
fn __ixRemove(ix: Any, h: int, p: int): void = __index_remove(ix, h, p)
fn __ixClear(ix: Any): void = __index_clear(ix)

// a key's hash, through the one hasher (05 rule 20)
fn __hashOf<K :: [Hashable]>(k: K): int {
    let h = Hasher { }
    k.hash(h)
    return h.finish()
}

// a map of keys to values: `m[k]` the value under `k` or `null`, `m[k] = v` puts `v` there,
// `m[k] = null` takes `k` out; walked in the order the keys came
class Map<K :: [Hashable], V> :: [Debug, Display] {
    ks: K[] = []
    vs: V[] = []
    hs: int[] = []
    live: bool[] = []
    var count: int = 0
    var changes: int = 0
    ix: Any = __ixNew()

    static fn new(): Map<K, V> = Map { }
    // an empty map; a negative `n` panics (the room is the VM's to keep)
    static fn withCapacity(n: int): Map<K, V> {
        if (n < 0) {
            panic(f"Map.withCapacity: a negative capacity {n}")
        }
        return Map { }
    }
    // the pairs in a map, a later value of a key replacing the earlier one
    static fn from(pairs: (K, V)[]): Map<K, V> {
        let m: Map<K, V> = Map { }
        for (p in pairs) {
            m.insert(p.0, p.1)
        }
        return m
    }
    // the place of `k`'s entry, its hash `h`; -1 where it has none
    fn place(k: K, h: int): int {
        var p = __ixFirst(this.ix, h)
        while (p >= 0) {
            if (this.live[p] && this.ks[p] == k) {
                return p
            }
            p = __ixNext(this.ix, h, p)
        }
        return -1
    }
    // `v` under `k`; the value it replaces, `null` where there was none
    fn insert(k: K, v: V): ?V {
        let h = __hashOf(k)
        let p = this.place(k, h)
        if (p >= 0) {
            let old = this.vs[p]
            this.vs[p] = v
            return old
        }
        __ixAdd(this.ix, h, this.ks.length())
        this.ks.push(k)
        this.vs.push(v)
        this.hs.push(h)
        this.live.push(true)
        this.count += 1
        this.changes += 1
        return null
    }
    fn get(k: K): ?V {
        let p = this.place(k, __hashOf(k))
        if (p < 0) {
            return null
        }
        return this.vs[p]
    }
    fn containsKey(k: K): bool = this.place(k, __hashOf(k)) >= 0
    // takes `k` out; its value, `null` where it had none
    fn remove(k: K): ?V {
        let h = __hashOf(k)
        let p = this.place(k, h)
        if (p < 0) {
            return null
        }
        let v = this.vs[p]
        __ixRemove(this.ix, h, p)
        this.live[p] = false
        this.count -= 1
        this.changes += 1
        this.compact()
        return v
    }
    // the dead entries past the live ones, more than a handful: the lists anew, the index too
    fn compact() {
        let dead = this.ks.length() - this.count
        if (dead <= 8 || dead <= this.count) {
            return
        }
        let ks: K[] = []
        let vs: V[] = []
        let hs: int[] = []
        var p = 0
        while (p < this.ks.length()) {
            if (this.live[p]) {
                ks.push(this.ks[p])
                vs.push(this.vs[p])
                hs.push(this.hs[p])
            }
            p += 1
        }
        this.ks.clear()
        this.vs.clear()
        this.hs.clear()
        this.live.clear()
        __ixClear(this.ix)
        var q = 0
        while (q < ks.length()) {
            __ixAdd(this.ix, hs[q], q)
            this.ks.push(ks[q])
            this.vs.push(vs[q])
            this.hs.push(hs[q])
            this.live.push(true)
            q += 1
        }
    }
    fn length(): int = this.count
    fn isEmpty(): bool = this.count == 0
    fn clear() {
        this.ks.clear()
        this.vs.clear()
        this.hs.clear()
        this.live.clear()
        __ixClear(this.ix)
        this.count = 0
        this.changes += 1
    }
    // the value under `k`, else `d`
    fn getOr(k: K, d: V): V {
        let p = this.place(k, __hashOf(k))
        if (p < 0) {
            return d
        }
        return this.vs[p]
    }
    // the value under `k`, else `make()`'s, inserted
    fn getOrInsert(k: K, make: fn() -> V): V {
        let p = this.place(k, __hashOf(k))
        if (p >= 0) {
            return this.vs[p]
        }
        let v = make()
        this.insert(k, v)
        return v
    }
    // the value under `k` through `f`; whether there was one to replace
    fn update(k: K, f: fn(V) -> V): bool {
        let p = this.place(k, __hashOf(k))
        if (p < 0) {
            return false
        }
        this.vs[p] = f(this.vs[p])
        return true
    }
    // keeps the entries `p` holds for; how many went
    fn retain(p: fn(K, V) -> bool): int {
        var gone = 0
        var q = 0
        while (q < this.ks.length()) {
            if (this.live[q] && !p(this.ks[q], this.vs[q])) {
                __ixRemove(this.ix, this.hs[q], q)
                this.live[q] = false
                this.count -= 1
                gone += 1
            }
            q += 1
        }
        if (gone > 0) {
            this.changes += 1
            this.compact()
        }
        return gone
    }
    fn entries(): MapEntriesIter<K, V> = MapEntriesIter { map = this, changes = this.changes }
    fn keys(): MapKeysIter<K, V> = MapKeysIter { map = this, changes = this.changes }
    fn values(): MapValuesIter<K, V> = MapValuesIter { map = this, changes = this.changes }
    // `{"a": 1, "b": 2}`: the entries in their order, each part in its Debug form
    // its text is its Debug form, as Lyric 5's (S7e3b)
    fn show(): string = this.debug()
    fn debug(): string {
        var s = "{"
        var first = true
        var p = 0
        while (p < this.ks.length()) {
            if (this.live[p]) {
                if (!first) {
                    s += ", "
                }
                s += __debugOf(this.ks[p]) + ": " + __debugOf(this.vs[p])
                first = false
            }
            p += 1
        }
        return s + "}"
    }
    // the next live place from `p` on, -1 at the end; a change since `changes` panics, the
    // collection named `label` — a set walks its map's keys
    fn nextLive(p: int, changes: int, label: string = "Map"): int {
        if (this.changes != changes) {
            __changedPanic(label + ": changed while it was walked")
        }
        var q = p
        while (q < this.ks.length()) {
            if (this.live[q]) {
                return q
            }
            q += 1
        }
        return -1
    }
}

// a map's entries, keys and values, in the order the keys came
class MapEntriesIter<K :: [Hashable], V> :: Iterator {
    type Item = (K, V)
    map: Map<K, V>
    var at: int = 0
    changes: int
    fn next(): ?(K, V) {
        let p = this.map.nextLive(this.at, this.changes)
        if (p < 0) {
            return null
        }
        this.at = p + 1
        return (this.map.ks[p], this.map.vs[p])
    }
}
class MapKeysIter<K :: [Hashable], V> :: Iterator {
    type Item = K
    map: Map<K, V>
    var at: int = 0
    changes: int
    // the collection a panic names: `"Set"` where a set walks its map
    label: string = "Map"
    fn next(): ?K {
        let p = this.map.nextLive(this.at, this.changes, this.label)
        if (p < 0) {
            return null
        }
        this.at = p + 1
        return this.map.ks[p]
    }
}
class MapValuesIter<K :: [Hashable], V> :: Iterator {
    type Item = V
    map: Map<K, V>
    var at: int = 0
    changes: int
    fn next(): ?V {
        let p = this.map.nextLive(this.at, this.changes)
        if (p < 0) {
            return null
        }
        this.at = p + 1
        return this.map.vs[p]
    }
}

// walked over its entries; `k in m` asks its keys; `m[k]`, `m[k] = v`; a map literal; equal where
// it holds the same keys under equal values, in any order
extend<K :: [Hashable], V> Map<K, V> :: Iterable {
    type Iter = MapEntriesIter<K, V>
    fn iter(): MapEntriesIter<K, V> = this.entries()
}
extend<K :: [Hashable], V> Map<K, V> :: Contains<K> {
    fn contains(k: K): bool = this.containsKey(k)
}
extend<K :: [Hashable], V> Map<K, V> :: IndexSet<K> {
    type Output = ?V
    fn index(k: K): ?V = this.get(k)
    fn setIndex(k: K, v: ?V) {
        if (let x = v) {
            this.insert(k, x)
        } else {
            this.remove(k)
        }
    }
}
extend<K :: [Hashable], V> Map<K, V> :: FromMapLiteral<K, V> {
    static fn fromMapLiteral(entries: (K, V)[]): Map<K, V> = Map<K, V>.from(entries)
}
// a new map of the entries' clones, in their order, an index of its own (Lyric 5 12 §Clone)
extend<K :: [Hashable, Clone], V :: [Clone]> Map<K, V> :: Clone {
    fn clone(): Map<K, V> {
        let out: Map<K, V> = Map { }
        for ((k, v) in this) {
            out.insert(k.clone(), v.clone())
        }
        return out
    }
}
// `pairs.iter().collect()`: the pairs' map, a later value of a key replacing the earlier one
extend<K :: [Hashable], V> Map<K, V> :: FromIterator<(K, V)> {
    static fn fromIter<I :: [Iterator<Item = (K, V)>]>(it: I): Map<K, V> {
        let out: Map<K, V> = Map { }
        while (let p = it.next()) {
            out.insert(p.0, p.1)
        }
        return out
    }
}
extend<K :: [Hashable], V :: [Equatable]> Map<K, V> :: Equatable {
    fn equals(o: Map<K, V>): bool {
        if (this.count != o.count) {
            return false
        }
        var p = 0
        while (p < this.ks.length()) {
            if (this.live[p]) {
                let q = o.place(this.ks[p], this.hs[p])
                if (q < 0 || o.vs[q] != this.vs[p]) {
                    return false
                }
            }
            p += 1
        }
        return true
    }
}

// a set of values, each once, in the order they came: a map's keys (Lyric 5 12 §Collections;
// S7d3); its operations are methods that make a new set, or answer a question
class Set<T :: [Hashable]> :: [Debug, Display] {
    table: Map<T, bool> = Map { }

    static fn new(): Set<T> = Set { }
    // a set of the list's values, each once
    static fn of(xs: T[]): Set<T> {
        let out: Set<T> = Set { }
        for (x in xs) {
            out.insert(x)
        }
        return out
    }
    // an empty set; a negative `n` panics (the room is the VM's to keep)
    static fn withCapacity(n: int): Set<T> {
        if (n < 0) {
            panic(f"Map.withCapacity: a negative capacity {n}")
        }
        return Set { }
    }
    fn length(): int = this.table.length()
    fn isEmpty(): bool = this.table.isEmpty()
    // adds `v`; whether it was not there
    fn insert(v: T): bool = this.table.insert(v, true) == null
    // takes `v` out; whether it was there
    fn remove(v: T): bool = this.table.remove(v) != null
    fn clear() {
        this.table.clear()
    }
    // the values of either set: this one's, then the other's new ones
    fn union(o: Set<T>): Set<T> {
        let out: Set<T> = Set { }
        for (x in this) {
            out.insert(x)
        }
        for (x in o) {
            out.insert(x)
        }
        return out
    }
    // the values of both sets, in this one's order
    fn intersect(o: Set<T>): Set<T> {
        let out: Set<T> = Set { }
        for (x in this) {
            if (o.contains(x)) {
                out.insert(x)
            }
        }
        return out
    }
    // the values of this set the other has not
    fn difference(o: Set<T>): Set<T> {
        let out: Set<T> = Set { }
        for (x in this) {
            if (!o.contains(x)) {
                out.insert(x)
            }
        }
        return out
    }
    // the values of exactly one of the two sets
    fn symmetricDifference(o: Set<T>): Set<T> {
        let out = this.difference(o)
        for (x in o) {
            if (!this.contains(x)) {
                out.insert(x)
            }
        }
        return out
    }
    // whether every value of this set is the other's; the empty set is of every set
    fn isSubset(o: Set<T>): bool {
        for (x in this) {
            if (!o.contains(x)) {
                return false
            }
        }
        return true
    }
    fn isSuperset(o: Set<T>): bool = o.isSubset(this)
    // whether the two sets have no value in common
    fn isDisjoint(o: Set<T>): bool {
        for (x in this) {
            if (o.contains(x)) {
                return false
            }
        }
        return true
    }
    // `{1, 2}`: the values in their order, each in its Debug form
    // its text is its Debug form, as Lyric 5's (S7e3b)
    fn show(): string = this.debug()
    fn debug(): string {
        var s = "{"
        var first = true
        for (x in this) {
            if (!first) {
                s += ", "
            }
            s += __debugOf(x)
            first = false
        }
        return s + "}"
    }
}

// walked over its values in their order; `x in s`; a list literal where a set is taken; equal
// where it holds the same values, in any order
extend<T :: [Hashable]> Set<T> :: Iterable {
    type Iter = MapKeysIter<T, bool>
    fn iter(): MapKeysIter<T, bool> = MapKeysIter {
        map = this.table,
        changes = this.table.changes,
        label = "Set",
    }
}
extend<T :: [Hashable]> Set<T> :: Contains<T> {
    fn contains(v: T): bool = this.table.containsKey(v)
}
extend<T :: [Hashable]> Set<T> :: FromArrayLiteral<T> {
    static fn fromArrayLiteral(items: T[]): Set<T> = Set<T>.of(items)
}
// `values.iter().collect()`: the values' set, each once
extend<T :: [Hashable]> Set<T> :: FromIterator<T> {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Set<T> {
        let out: Set<T> = Set { }
        while (let x = it.next()) {
            out.insert(x)
        }
        return out
    }
}
extend<T :: [Hashable]> Set<T> :: Equatable {
    fn equals(o: Set<T>): bool {
        if (this.length() != o.length()) {
            return false
        }
        for (x in this) {
            if (!o.contains(x)) {
                return false
            }
        }
        return true
    }
}
// a new set of the values' clones, in their order
extend<T :: [Hashable, Clone]> Set<T> :: Clone {
    fn clone(): Set<T> {
        let out: Set<T> = Set { }
        for (x in this) {
            out.insert(x.clone())
        }
        return out
    }
}

// an iterator's values gathered (Lyric 5 12 §Collections, which holds them, not std.iter):
// `groupBy(key)` a map from each key to its values, in their order; `toMap()` of pairs, a later
// value of a key replacing the earlier one; `toSet()` of hashable values, each once
extend<I :: [Iterator]> I {
    fn groupBy<K :: [Hashable]>(key: fn(I.Item) -> K): Map<K, I.Item[]> {
        let out: Map<K, I.Item[]> = Map { }
        while (let x = this.next()) {
            let group = out.getOrInsert(key(x), () => [])
            group.push(x)
        }
        return out
    }
}
extend<I :: [Iterator<Item = (K, V)>], K :: [Hashable], V> I {
    fn toMap(): Map<K, V> = this.collect()
}
extend<I :: [Iterator<Item = T>], T :: [Hashable]> I {
    fn toSet(): Set<T> = this.collect()
}

// a double-ended queue: values pushed and popped at either end (Lyric 5 12 §Collections; S7d4).
// The values lie in a ring: `count` of them from `head` on, wrapping at the slots' end; a full ring
// is copied, in order, into one twice its size (at least 8); a slot no value holds is `null`.
// `d[i]` counts from the front; it walks front to back.
class Deque<T> :: [Debug, Display] {
    var slots: (?T)[] = []
    var head: int = 0
    var count: int = 0
    var changes: int = 0

    static fn new(): Deque<T> = Deque { }
    // an empty deque; a negative `n` panics (the room is the VM's to keep)
    static fn withCapacity(n: int): Deque<T> {
        if (n < 0) {
            panic(f"Deque.withCapacity: a negative capacity {n}")
        }
        return Deque { }
    }
    fn length(): int = this.count
    fn isEmpty(): bool = this.count == 0
    fn pushBack(v: T) {
        this.grow()
        this.slots[this.slotOf(this.count)] = v
        this.count += 1
        this.changes += 1
    }
    fn pushFront(v: T) {
        this.grow()
        this.head = (this.head + this.slots.length() - 1) % this.slots.length()
        this.slots[this.head] = v
        this.count += 1
        this.changes += 1
    }
    // the front value taken out, `null` where there is none
    fn popFront(): ?T {
        if (this.count == 0) {
            return null
        }
        let v = this.slots[this.head]
        this.slots[this.head] = null
        this.head = (this.head + 1) % this.slots.length()
        this.count -= 1
        this.changes += 1
        return v
    }
    // the back value taken out, `null` where there is none
    fn popBack(): ?T {
        if (this.count == 0) {
            return null
        }
        let at = this.slotOf(this.count - 1)
        let v = this.slots[at]
        this.slots[at] = null
        this.count -= 1
        this.changes += 1
        return v
    }
    fn peekFront(): ?T = if (this.count == 0) null else this.slots[this.head]
    fn peekBack(): ?T = if (this.count == 0) null else this.slots[this.slotOf(this.count - 1)]
    // the slot `offset` places past the head, around the ring
    fn slotOf(offset: int): int = (this.head + offset) % this.slots.length()
    // room for one more value: a full ring copied from its head on into one twice its size
    fn grow() {
        if (this.count < this.slots.length()) {
            return
        }
        let room = if (this.slots.length() == 0) 8 else this.slots.length() * 2
        let grown: (?T)[] = []
        var i = 0
        while (i < this.count) {
            grown.push(this.slots[this.slotOf(i)])
            i += 1
        }
        while (grown.length() < room) {
            grown.push(null)
        }
        this.slots = grown
        this.head = 0
    }
    // `[1, 2]`: the values front to back, each in its Debug form
    // its text is its Debug form, as Lyric 5's (S7e3b)
    fn show(): string = this.debug()
    fn debug(): string {
        var s = "["
        var i = 0
        while (i < this.count) {
            if (i > 0) {
                s += ", "
            }
            s += __debugOf(this.slots[this.slotOf(i)]!)
            i += 1
        }
        return s + "]"
    }
}

// a deque's values front to back; a push or a pop while it walks makes the next pull panic
class DequeIter<T> :: Iterator {
    type Item = T
    deque: Deque<T>
    var at: int = 0
    changes: int
    fn next(): ?T {
        if (this.deque.changes != this.changes) {
            __changedPanic("Deque: changed while it was walked")
        }
        if (this.at >= this.deque.count) {
            return null
        }
        this.at += 1
        return this.deque.slots[this.deque.slotOf(this.at - 1)]
    }
}

// walked front to back; `d[i]` the value `i` places from the front, a panic outside
// `0 ≤ i < length()`; a list literal where a deque is taken; equal where the values are, in order
extend<T> Deque<T> :: Iterable {
    type Iter = DequeIter<T>
    fn iter(): DequeIter<T> = DequeIter { deque = this, changes = this.changes }
}
extend<T> Deque<T> :: Index<int> {
    type Output = T
    fn index(i: int): T {
        if (i < 0 || i >= this.count) {
            __boundsPanic(f"index {i} out of bounds for length {this.count}")
        }
        return this.slots[this.slotOf(i)]!
    }
}
extend<T> Deque<T> :: FromArrayLiteral<T> {
    static fn fromArrayLiteral(items: T[]): Deque<T> {
        let out: Deque<T> = Deque { }
        for (x in items) {
            out.pushBack(x)
        }
        return out
    }
}
extend<T> Deque<T> :: FromIterator<T> {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Deque<T> {
        let out: Deque<T> = Deque { }
        while (let x = it.next()) {
            out.pushBack(x)
        }
        return out
    }
}
extend<T :: [Equatable]> Deque<T> :: Equatable {
    fn equals(o: Deque<T>): bool {
        if (this.count != o.count) {
            return false
        }
        var i = 0
        while (i < this.count) {
            if (this[i] != o[i]) {
                return false
            }
            i += 1
        }
        return true
    }
}
// a new deque of the values' clones, in their order
extend<T :: [Clone]> Deque<T> :: Clone {
    fn clone(): Deque<T> {
        let out: Deque<T> = Deque { }
        var i = 0
        while (i < this.count) {
            out.pushBack(this[i].clone())
            i += 1
        }
        return out
    }
}

// a binary min-heap: `peek()` and `pop()` give the least value (Lyric 5 12 §Collections; S7d4).
// A binary tree laid out in a list: the children of `i` at `2i + 1` and `2i + 2`, no value less
// than its parent.
class Heap<T :: [TotalOrder]> :: Debug {
    items: T[] = []

    static fn new(): Heap<T> = Heap { }
    // an empty heap; a negative `n` panics (the room is the VM's to keep)
    static fn withCapacity(n: int): Heap<T> {
        if (n < 0) {
            panic(f"List.withCapacity: a negative capacity {n}")
        }
        return Heap { }
    }
    // a heap of the list's values, built in linear time: each parent sunk to its place, from the
    // last one up (Floyd's method)
    static fn of(xs: T[]): Heap<T> {
        let heap: Heap<T> = Heap { }
        heap.items.pushAll(xs)
        var at = xs.length() / 2 - 1
        while (at >= 0) {
            heap.sink(at, xs.length())
            at -= 1
        }
        return heap
    }
    fn length(): int = this.items.length()
    fn isEmpty(): bool = this.items.isEmpty()
    // the least value, `null` where there is none
    fn peek(): ?T = this.items.get(0)
    // adds `v`, letting it rise to its place
    fn push(v: T) {
        this.items.push(v)
        var at = this.items.length() - 1
        while (at > 0) {
            let parent = (at - 1) / 2
            if (this.items[at].totalCompare(this.items[parent]) != Ordering.Less) {
                return
            }
            this.items.swap(at, parent)
            at = parent
        }
    }
    // the least value taken out, `null` where there is none: the last put at the top and sunk
    fn pop(): ?T {
        let n = this.items.length()
        if (n == 0) {
            return null
        }
        this.items.swap(0, n - 1)
        let top = this.items.pop()
        this.sink(0, n - 1)
        return top
    }
    // the value at `from` sunk below every child less than it, among the first `m`
    fn sink(from: int, m: int) {
        var at = from
        while (true) {
            let left = 2 * at + 1
            if (left >= m) {
                return
            }
            var child = left
            if (left + 1 < m
                && this.items[left + 1].totalCompare(this.items[left]) == Ordering.Less) {
                child = left + 1
            }
            if (this.items[child].totalCompare(this.items[at]) != Ordering.Less) {
                return
            }
            this.items.swap(at, child)
            at = child
        }
    }
    // the values as the heap holds them, a list's form
    fn debug(): string = __debugOf(this.items)
}

extend<T :: [TotalOrder]> Heap<T> :: FromArrayLiteral<T> {
    static fn fromArrayLiteral(items: T[]): Heap<T> = Heap<T>.of(items)
}
extend<T :: [TotalOrder]> Heap<T> :: FromIterator<T> {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Heap<T> {
        let out: Heap<T> = Heap { }
        while (let x = it.next()) {
            out.push(x)
        }
        return out
    }
}
// a new heap of the values' clones, in the same order
extend<T :: [TotalOrder, Clone]> Heap<T> :: Clone {
    fn clone(): Heap<T> {
        let out: Heap<T> = Heap { }
        for (x in this.items) {
            out.items.push(x.clone())
        }
        return out
    }
}
