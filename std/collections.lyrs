// std.collections (Lyric 5 12 §Collections; S7d): the maps. A map holds each key once, in the
// order the keys came (12 Src: insertion order, where Lyric 5's map keeps none of its own); its
// entries lie in lists, and the VM keeps the places of their hashes (P27) — the program hashes
// the keys and compares them. The prelude names this module: the loader adds it to a program that
// names a map or writes a map literal, and its names are the prelude's.

fn __ixNew(): Any = __index_new()
fn __ixAdd(ix: Any, h: int, p: int): void = __index_add(ix, h, p)
fn __ixFirst(ix: Any, h: int): int = __index_first(ix, h)
fn __ixNext(ix: Any, h: int, p: int): int = __index_next(ix, h, p)
fn __ixRemove(ix: Any, h: int, p: int): void = __index_remove(ix, h, p)
fn __ixClear(ix: Any): void = __index_clear(ix)

// a key's hash, through the one hasher (05 rule 20)
fn __hashOf<K :: [Hashable]>(k: K): int {
    let h = Hasher { }
    k.hash(h)
    return h.finish()
}

// a map of keys to values: `m[k]` the value under `k` or `null`, `m[k] = v` puts `v` there,
// `m[k] = null` takes `k` out; walked in the order the keys came
class Map<K :: [Hashable], V> {
    ks: K[] = []
    vs: V[] = []
    hs: int[] = []
    live: bool[] = []
    var count: int = 0
    var changes: int = 0
    ix: Any = __ixNew()

    static fn new(): Map<K, V> = Map { }
    // an empty map; a negative `n` panics (the room is the VM's to keep)
    static fn withCapacity(n: int): Map<K, V> {
        if (n < 0) {
            panic(f"a negative capacity: {n}")
        }
        return Map { }
    }
    // the pairs in a map, a later value of a key replacing the earlier one
    static fn from(pairs: (K, V)[]): Map<K, V> {
        let m: Map<K, V> = Map { }
        for (p in pairs) {
            m.insert(p.0, p.1)
        }
        return m
    }
    // the place of `k`'s entry, its hash `h`; -1 where it has none
    fn place(k: K, h: int): int {
        var p = __ixFirst(this.ix, h)
        while (p >= 0) {
            if (this.live[p] && this.ks[p] == k) {
                return p
            }
            p = __ixNext(this.ix, h, p)
        }
        return -1
    }
    // `v` under `k`; the value it replaces, `null` where there was none
    fn insert(k: K, v: V): ?V {
        let h = __hashOf(k)
        let p = this.place(k, h)
        if (p >= 0) {
            let old = this.vs[p]
            this.vs[p] = v
            return old
        }
        __ixAdd(this.ix, h, this.ks.length())
        this.ks.push(k)
        this.vs.push(v)
        this.hs.push(h)
        this.live.push(true)
        this.count += 1
        this.changes += 1
        return null
    }
    fn get(k: K): ?V {
        let p = this.place(k, __hashOf(k))
        if (p < 0) {
            return null
        }
        return this.vs[p]
    }
    fn containsKey(k: K): bool = this.place(k, __hashOf(k)) >= 0
    // takes `k` out; its value, `null` where it had none
    fn remove(k: K): ?V {
        let h = __hashOf(k)
        let p = this.place(k, h)
        if (p < 0) {
            return null
        }
        let v = this.vs[p]
        __ixRemove(this.ix, h, p)
        this.live[p] = false
        this.count -= 1
        this.changes += 1
        this.compact()
        return v
    }
    // the dead entries past the live ones, more than a handful: the lists anew, the index too
    fn compact() {
        let dead = this.ks.length() - this.count
        if (dead <= 8 || dead <= this.count) {
            return
        }
        let ks: K[] = []
        let vs: V[] = []
        let hs: int[] = []
        var p = 0
        while (p < this.ks.length()) {
            if (this.live[p]) {
                ks.push(this.ks[p])
                vs.push(this.vs[p])
                hs.push(this.hs[p])
            }
            p += 1
        }
        this.ks.clear()
        this.vs.clear()
        this.hs.clear()
        this.live.clear()
        __ixClear(this.ix)
        var q = 0
        while (q < ks.length()) {
            __ixAdd(this.ix, hs[q], q)
            this.ks.push(ks[q])
            this.vs.push(vs[q])
            this.hs.push(hs[q])
            this.live.push(true)
            q += 1
        }
    }
    fn length(): int = this.count
    fn isEmpty(): bool = this.count == 0
    fn clear() {
        this.ks.clear()
        this.vs.clear()
        this.hs.clear()
        this.live.clear()
        __ixClear(this.ix)
        this.count = 0
        this.changes += 1
    }
    // the value under `k`, else `d`
    fn getOr(k: K, d: V): V {
        let p = this.place(k, __hashOf(k))
        if (p < 0) {
            return d
        }
        return this.vs[p]
    }
    // the value under `k`, else `make()`'s, inserted
    fn getOrInsert(k: K, make: fn() -> V): V {
        let p = this.place(k, __hashOf(k))
        if (p >= 0) {
            return this.vs[p]
        }
        let v = make()
        this.insert(k, v)
        return v
    }
    // the value under `k` through `f`; whether there was one to replace
    fn update(k: K, f: fn(V) -> V): bool {
        let p = this.place(k, __hashOf(k))
        if (p < 0) {
            return false
        }
        this.vs[p] = f(this.vs[p])
        return true
    }
    // keeps the entries `p` holds for; how many went
    fn retain(p: fn(K, V) -> bool): int {
        var gone = 0
        var q = 0
        while (q < this.ks.length()) {
            if (this.live[q] && !p(this.ks[q], this.vs[q])) {
                __ixRemove(this.ix, this.hs[q], q)
                this.live[q] = false
                this.count -= 1
                gone += 1
            }
            q += 1
        }
        if (gone > 0) {
            this.changes += 1
            this.compact()
        }
        return gone
    }
    fn entries(): MapEntriesIter<K, V> = MapEntriesIter { map = this, changes = this.changes }
    fn keys(): MapKeysIter<K, V> = MapKeysIter { map = this, changes = this.changes }
    fn values(): MapValuesIter<K, V> = MapValuesIter { map = this, changes = this.changes }
    // `{"a": 1, "b": 2}`: the entries in their order, each part in its Debug form
    fn debug(): string {
        var s = "{"
        var first = true
        var p = 0
        while (p < this.ks.length()) {
            if (this.live[p]) {
                if (!first) {
                    s += ", "
                }
                s += __debugOf(this.ks[p]) + ": " + __debugOf(this.vs[p])
                first = false
            }
            p += 1
        }
        return s + "}"
    }
    // the next live place from `p` on, -1 at the end; a change since `changes` panics
    fn nextLive(p: int, changes: int): int {
        if (this.changes != changes) {
            __changedPanic("Map: changed while it was walked")
        }
        var q = p
        while (q < this.ks.length()) {
            if (this.live[q]) {
                return q
            }
            q += 1
        }
        return -1
    }
}

// a map's entries, keys and values, in the order the keys came
class MapEntriesIter<K :: [Hashable], V> :: Iterator {
    type Item = (K, V)
    map: Map<K, V>
    var at: int = 0
    changes: int
    fn next(): ?(K, V) {
        let p = this.map.nextLive(this.at, this.changes)
        if (p < 0) {
            return null
        }
        this.at = p + 1
        return (this.map.ks[p], this.map.vs[p])
    }
}
class MapKeysIter<K :: [Hashable], V> :: Iterator {
    type Item = K
    map: Map<K, V>
    var at: int = 0
    changes: int
    fn next(): ?K {
        let p = this.map.nextLive(this.at, this.changes)
        if (p < 0) {
            return null
        }
        this.at = p + 1
        return this.map.ks[p]
    }
}
class MapValuesIter<K :: [Hashable], V> :: Iterator {
    type Item = V
    map: Map<K, V>
    var at: int = 0
    changes: int
    fn next(): ?V {
        let p = this.map.nextLive(this.at, this.changes)
        if (p < 0) {
            return null
        }
        this.at = p + 1
        return this.map.vs[p]
    }
}

// walked over its entries; `k in m` asks its keys; `m[k]`, `m[k] = v`; a map literal; equal where
// it holds the same keys under equal values, in any order
extend<K :: [Hashable], V> Map<K, V> :: Iterable {
    type Iter = MapEntriesIter<K, V>
    fn iter(): MapEntriesIter<K, V> = this.entries()
}
extend<K :: [Hashable], V> Map<K, V> :: Contains<K> {
    fn contains(k: K): bool = this.containsKey(k)
}
extend<K :: [Hashable], V> Map<K, V> :: IndexSet<K> {
    type Output = ?V
    fn index(k: K): ?V = this.get(k)
    fn setIndex(k: K, v: ?V) {
        if (let x = v) {
            this.insert(k, x)
        } else {
            this.remove(k)
        }
    }
}
extend<K :: [Hashable], V> Map<K, V> :: FromMapLiteral<K, V> {
    static fn fromMapLiteral(entries: (K, V)[]): Map<K, V> = Map<K, V>.from(entries)
}
// a new map of the entries' clones, in their order, an index of its own (Lyric 5 12 §Clone)
extend<K :: [Hashable, Clone], V :: [Clone]> Map<K, V> :: Clone {
    fn clone(): Map<K, V> {
        let out: Map<K, V> = Map { }
        for ((k, v) in this) {
            out.insert(k.clone(), v.clone())
        }
        return out
    }
}
// `pairs.iter().collect()`: the pairs' map, a later value of a key replacing the earlier one
extend<K :: [Hashable], V> Map<K, V> :: FromIterator<(K, V)> {
    static fn fromIter<I :: [Iterator<Item = (K, V)>]>(it: I): Map<K, V> {
        let out: Map<K, V> = Map { }
        while (let p = it.next()) {
            out.insert(p.0, p.1)
        }
        return out
    }
}
extend<K :: [Hashable], V :: [Equatable]> Map<K, V> :: Equatable {
    fn equals(o: Map<K, V>): bool {
        if (this.count != o.count) {
            return false
        }
        var p = 0
        while (p < this.ks.length()) {
            if (this.live[p]) {
                let q = o.place(this.ks[p], this.hs[p])
                if (q < 0 || o.vs[q] != this.vs[p]) {
                    return false
                }
            }
            p += 1
        }
        return true
    }
}
