//! The file system (12; Lyric 5's `std.fs`). A module of the right `file` (01 S1). A file's call runs
//! on a task of the host: the other tasks go on, and in a cancelled task it runs to its end, so that it
//! declares `IoError` alone, as the conveniences do (12 rule 22).

import std.io { Reader, Seek, SeekFrom, TextReader, Writer, copy as copyAll }
import std.path { join, parent }

private fn fileNew(): Any = __fs_file()
private fn fileOpen(how: int, file: Any, path: string): int = __fs_open(how, file, path)
private fn fileRead(file: Any, into: Any): int = __fs_read(file, into)
private fn fileWrite(file: Any, from: Any): int = __fs_write(file, from)
private fn fileSeek(offset: int, whence: int, file: Any): int = __fs_seek(offset, whence, file)
private fn fileClose(file: Any): int = __fs_close(file)

private fn pathLook(path: string): int = __fs_metadata(path)
private fn pathMakeDir(path: string): int = __fs_createDir(path)
private fn pathRemove(path: string): int = __fs_remove(path)
private fn pathRemoveDir(path: string): int = __fs_removeDir(path)
private fn pathRename(from: string, to: string): int = __fs_rename(from, to)
private fn pathResolve(holder: string[], path: string): int = __fs_canonicalize(holder, path)
private fn pathAbsolute(holder: string[], path: string): int = __fs_absolute(holder, path)
private fn newTempDir(holder: string[]): int = __fs_tempDir(holder)
private fn newTempFile(holder: string[]): int = __fs_tempFile(holder)
private fn dirNew(): Any = __fs_dir()
private fn dirOpen(dir: Any, path: string): int = __fs_dirOpen(dir, path)
private fn dirNext(holder: string[], dir: Any): int = __fs_dirNext(holder, dir)
private fn dirClose(dir: Any): int = __fs_dirClose(dir)

/// Whether a path names anything: `false` where `metadata` would throw.
fn exists(path: string): bool = pathLook(path) >= 0

/// How a file is opened: to read, to write, to append at its end, created where it is not there, cut to
/// nothing where it is. `File.openWith` refuses with `InvalidInput` a file opened neither to read nor to
/// write, one cut without being written from the start, and one created without being written.
struct OpenOptions {
    read: bool = false
    write: bool = false
    append: bool = false
    create: bool = false
    truncate: bool = false
}

/// A handle on a file, its position moved by what is read and written.
class File :: [Reader, Writer, Seek, Closeable] {
    handle: Any
    name: string
    var closed: bool = false

    /// Opens `path` to read.
    static fn open(path: string): File throws IoError = File.openWith(path, OpenOptions { read = true })

    /// Opens `path` to write: made where it is not there, cut to nothing where it is.
    static fn create(path: string): File throws IoError {
        return File.openWith(path, OpenOptions { write = true, create = true, truncate = true })
    }

    /// Opens `path` as `options` say.
    static fn openWith(path: string, options: OpenOptions): File throws IoError {
        if (!options.read && !options.write && !options.append) {
            throw IoError { kind = IoErrorKind.InvalidInput, path = path, detail = "opened neither to read nor to write" }
        }
        if (options.truncate && (!options.write || options.append)) {
            throw IoError {
                kind = IoErrorKind.InvalidInput,
                path = path,
                detail = "cut to nothing without being written from the start",
            }
        }
        if (options.create && !options.write && !options.append) {
            throw IoError { kind = IoErrorKind.InvalidInput, path = path, detail = "created without being written" }
        }
        var how = 0
        if (options.read) {
            how = how | 1
        }
        if (options.write) {
            how = how | 2
        }
        if (options.append) {
            how = how | 4
        }
        if (options.create) {
            how = how | 8
        }
        if (options.truncate) {
            how = how | 16
        }
        let handle = fileNew()
        let n = fileOpen(how, handle, path)
        if (n < 0) {
            throw __ioFailure(n, path, if (options.write || options.append) "opened to write" else "opened to read")
        }
        return File { handle = handle, name = path }
    }

    /// Reads into `into` from the position and answers how many bytes; 0 at the end.
    fn read(into: Bytes): int throws IoError {
        let n = fileRead(this.handle, into.v)
        if (n < 0) {
            throw __ioFailure(n, this.name, "read")
        }
        return n
    }

    /// Writes from `from` at the position and answers how many bytes.
    fn write(from: Bytes): int throws IoError {
        let n = fileWrite(this.handle, from.v)
        if (n < 0) {
            throw __ioFailure(n, this.name, "written")
        }
        return n
    }

    /// Moves the position as `to` says and answers the new one from the start.
    fn seek(to: SeekFrom): int throws IoError {
        let (offset, whence) = match (to) {
            .Start(n) => (n, 0),
            .Current(n) => (n, 1),
            .End(n) => (n, 2),
        }
        let at = fileSeek(offset, whence, this.handle)
        if (at < 0) {
            throw __ioFailure(at, this.name, "sought")
        }
        return at
    }

    /// Closes the file. A second close does nothing.
    fn close(): void throws IoError {
        this.closed = true
        let n = fileClose(this.handle)
        if (n < 0) {
            throw __ioFailure(n, this.name, "closed")
        }
    }

    /// Everything to the end, in new bytes: `Reader`'s, without the `Cancelled` a reader may throw.
    fn readToEnd(): Bytes throws IoError {
        let held = Bytes.new()
        let chunk = Bytes.zeroed(8192)
        loop {
            let n = this.read(chunk)
            if (n == 0) {
                return held
            }
            if (n == 8192) {
                held.pushAll(chunk)
            } else {
                held.pushAll(chunk[0..n])
            }
        }
    }

    /// Everything to the end as UTF-8; `InvalidData` with the path, the decoder's error as the cause.
    fn readToString(): string throws IoError {
        let bytes = this.readToEnd()
        return try string.fromUtf8(bytes) catch (e: Utf8Error) throw IoError {
            kind = IoErrorKind.InvalidData,
            path = this.name,
            detail = "the bytes are no UTF-8",
            inner = e,
        }
    }

    /// Writes all of `from`, as often as it takes: `Writer`'s, without the `Cancelled`.
    fn writeAll(from: Bytes): void throws IoError {
        let n = from.length()
        var at = 0
        while (at < n) {
            let k = this.write(if (at == 0) from else from[at..n])
            if (k == 0) {
                throw IoError {
                    kind = IoErrorKind.Other { code = 0 },
                    path = this.name,
                    detail = f"the file took none of {n - at} bytes",
                }
            }
            at += k
        }
    }

    /// Writes the bytes of `s`, its UTF-8.
    fn writeString(s: string): void throws IoError {
        this.writeAll(s.toBytes())
    }
}

/// The whole file at `path` as UTF-8 text; a byte order mark is text like any other.
fn readText(path: string): string throws IoError {
    using let f = File.open(path)
    return f.readToString()
}

/// The whole file at `path` as bytes.
fn readBytes(path: string): Bytes throws IoError {
    using let f = File.open(path)
    return f.readToEnd()
}

/// Writes `text` as the file at `path`, made where it is not there, cut where it is.
fn writeText(path: string, text: string): void throws IoError {
    using let f = File.create(path)
    f.writeString(text)
}

/// Writes `bytes` as the file at `path`, made where it is not there, cut where it is.
fn writeBytes(path: string, bytes: Bytes): void throws IoError {
    using let f = File.create(path)
    f.writeAll(bytes)
}

/// Appends `text` at the end of the file at `path`, made where it is not there.
fn appendText(path: string, text: string): void throws IoError {
    using let f = File.openWith(path, OpenOptions { append = true, create = true })
    f.writeString(text)
}

/// The lines of the file at `path`, as `TextReader.readLine` gives them. The iterator closes the file
/// at its end and at an error; a `for` that leaves it early closes it, and so does `close()`.
fn lines(path: string): FileLinesIter throws IoError {
    let f = File.open(path)
    return FileLinesIter { file = f, reader = TextReader.new(f) }
}

/// The lines of a file, from `lines`. After its end or an error it gives no more; after `close()` a call
/// throws `Closed`, as the file's would, and what it had read ahead is not given.
class FileLinesIter :: [Iterator, Closeable] {
    type Item = string
    file: File
    reader: TextReader<File>
    var done: bool = false

    /// The next line, `null` at the end.
    fn next(): ?string throws IoError {
        if (this.done) {
            return null
        }
        // the reader holds what it read ahead: a closed file is seen here, not at its next read
        if (this.file.closed) {
            throw IoError { kind = IoErrorKind.Closed, path = this.file.name, detail = "read" }
        }
        var line: ?string = null
        try {
            line = this.reader.readLine()
        } catch (e: IoError) {
            this.done = true
            // the first error wins, the close's is attached to it
            defer {
                this.file.close()
            }
            throw if (e.path == null) e with { path = this.file.name } else e
        } catch (e: Cancelled) {
            unreachable("a file's call is not cancelled")
        }
        if (line == null) {
            this.done = true
            this.file.close()
        }
        return line
    }

    /// Closes the file before the end. A second close does nothing.
    fn close(): void throws IoError {
        this.file.close()
    }
}

/// What a path names, through links: its size in bytes, whether it is a file or a directory — neither,
/// for a device or a socket —, whether it cannot be written; and whether the path itself is a link.
struct Metadata {
    size: int
    isFile: bool
    isDir: bool
    isSymlink: bool
    readonly: bool
}

/// The metadata of the answer of `pathLook`, which is no failure.
private fn metadataOf(n: int): Metadata {
    return Metadata {
        size = n >> 4,
        isFile = n & 1 != 0,
        isDir = n & 2 != 0,
        isSymlink = n & 4 != 0,
        readonly = n & 8 != 0,
    }
}

/// What `path` names, through links; a link that leads nowhere is not found.
fn metadata(path: string): Metadata throws IoError {
    let n = pathLook(path)
    if (n < 0) {
        throw __ioFailure(n, path, "looked at")
    }
    return metadataOf(n)
}

/// Makes the directory `path` in one that is there.
fn createDir(path: string): void throws IoError {
    let n = pathMakeDir(path)
    if (n < 0) {
        throw __ioFailure(n, path, "made")
    }
}

/// Removes the file `path`.
fn remove(path: string): void throws IoError {
    let n = pathRemove(path)
    if (n < 0) {
        throw __ioFailure(n, path, "removed")
    }
}

/// Removes the directory `path`, which must be empty; one that is not is `Other` with the system's code.
fn removeDir(path: string): void throws IoError {
    let n = pathRemoveDir(path)
    if (n < 0) {
        throw __ioFailure(n, path, "removed")
    }
}

/// Renames `from` to `to` on one file system, replacing a file there.
fn rename(from: string, to: string): void throws IoError {
    let n = pathRename(from, to)
    if (n < 0) {
        throw __ioFailure(n, from, f"renamed to {to}")
    }
}

/// `path` absolute, its links resolved and its `.` and `..` taken out; it must be there.
fn canonicalize(path: string): string throws IoError {
    let holder = [""]
    let n = pathResolve(holder, path)
    if (n < 0) {
        throw __ioFailure(n, path, "resolved")
    }
    return holder[0]
}

/// `path` made absolute by the working directory and normalized; nothing more is asked of the file system.
fn absolute(path: string): string throws IoError {
    let holder = [""]
    let n = pathAbsolute(holder, path)
    if (n < 0) {
        throw __ioFailure(n, path, "made absolute")
    }
    return holder[0]
}

/// An entry of a directory: its name, its path, the directory's joined with the name, and what the entry
/// is itself, a link not followed.
struct DirEntry {
    name: string
    path: string
    isFile: bool
    isDir: bool
    isSymlink: bool

    /// What the entry names, following a link, as the module's `metadata` does.
    fn metadata(): Metadata throws IoError {
        let n = pathLook(this.path)
        if (n < 0) {
            throw __ioFailure(n, this.path, "looked at")
        }
        return metadataOf(n)
    }
}

/// The entries of the directory `path`, in the system's order, without `.` and `..`. The iterator lets the
/// directory go at its end and at an error; a `for` that leaves it early lets it go, and so does `close()`.
fn readDir(path: string): ReadDirIter throws IoError {
    let handle = dirNew()
    let n = dirOpen(handle, path)
    if (n < 0) {
        throw __ioFailure(n, path, "opened to read")
    }
    return ReadDirIter { handle = handle, dir = path }
}

/// A directory's entries, from `readDir`. After its end or an error it gives no more; after `close()` a
/// call throws `Closed`.
class ReadDirIter :: [Iterator, Closeable] {
    type Item = DirEntry
    handle: Any
    dir: string

    /// The next entry, `null` at the end.
    fn next(): ?DirEntry throws IoError {
        let holder = [""]
        let n = dirNext(holder, this.handle)
        if (n < 0) {
            throw __ioFailure(n, this.dir, holder[0])
        }
        if (n == 0) {
            return null
        }
        return DirEntry {
            name = holder[0],
            path = join(this.dir, holder[0]),
            isFile = n == 1,
            isDir = n == 2,
            isSymlink = n == 3,
        }
    }

    /// Lets the directory go before the end. A second close does nothing.
    fn close(): void throws IoError {
        let n = dirClose(this.handle)
        if (n < 0) {
            throw __ioFailure(n, this.dir, "closed")
        }
    }
}

/// What `name` names, `null` where nothing is there; any other error is thrown.
private fn lookOrNothing(name: string): ?Metadata throws IoError {
    let n = pathLook(name)
    if (n >= 0) {
        return metadataOf(n)
    }
    let e = __ioFailure(n, name, "looked at")
    if (e.kind == IoErrorKind.NotFound) {
        return null
    }
    throw e
}

/// Makes the directory and every one above it that is not there. A directory there already is nothing to
/// do; something else there is `NotDirectory`.
fn createDirAll(path: string): void throws IoError {
    if (let m = lookOrNothing(path)) {
        if (m.isDir) {
            return
        }
        throw IoError { kind = IoErrorKind.NotDirectory, path = path, detail = "made" }
    }
    let up = parent(path)
    if (up != path && up != ".") {
        createDirAll(up)
    }
    let n = pathMakeDir(path)
    if (n < 0) {
        let e = __ioFailure(n, path, "made")
        // made meanwhile by another: done, where it is a directory
        if (e.kind == IoErrorKind.AlreadyExists) {
            if (let m = lookOrNothing(path)) {
                if (m.isDir) {
                    return
                }
            }
        }
        throw e
    }
}

/// Removes `path` and all that is in it: a link is removed, never followed into, and nothing there is
/// nothing to do. It removes what it can and throws the first error it met.
fn removeAll(path: string): void throws IoError {
    let n = pathLook(path)
    if (n >= 0) {
        let m = metadataOf(n)
        if (let e = takeAway(path, m.isDir && !m.isSymlink, m.isSymlink)) {
            throw e
        }
        return
    }
    // nothing there, a link that leads nowhere, or one that leads to itself: what the path names itself
    // the system alone can say, and removing it asks
    let answer = pathRemove(path)
    if (answer < 0) {
        let e = __ioFailure(answer, path, "removed")
        if (e.kind != IoErrorKind.NotFound) {
            throw e
        }
    }
}

/// Removes `name`, a directory with everything in it, and answers the first error met.
private fn takeAway(name: string, isDir: bool, isLink: bool): ?IoError {
    if (!isDir) {
        let n = pathRemove(name)
        if (n >= 0) {
            return null
        }
        // a link to a directory is a directory to Windows' DeleteFileW
        if (isLink && pathRemoveDir(name) >= 0) {
            return null
        }
        return __ioFailure(n, name, "removed")
    }
    var first: ?IoError = null
    let entries: DirEntry[] = []
    try {
        for (e in readDir(name)) {
            entries.push(e)
        }
    } catch (e: IoError) {
        first = e
    }
    for (e in entries) {
        let error = takeAway(e.path, e.isDir, e.isSymlink)
        if (first == null) {
            first = error
        }
    }
    let n = pathRemoveDir(name)
    if (n < 0 && first == null) {
        first = __ioFailure(n, name, "removed")
    }
    return first
}

/// Copies the bytes of the file `from` to the file `to`, made or cut as `File.create` makes it, and
/// answers how many. From a directory it is `IsDirectory`, from anything else that is no file and onto
/// itself `InvalidInput`, before anything is written.
fn copy(from: string, to: string): int throws IoError {
    let what = metadata(from)
    if (!what.isFile) {
        throw IoError {
            kind = if (what.isDir) IoErrorKind.IsDirectory else IoErrorKind.InvalidInput,
            path = from,
            detail = "copied: no file",
        }
    }
    if (exists(to) && canonicalize(from) == canonicalize(to)) {
        throw IoError { kind = IoErrorKind.InvalidInput, path = from, detail = f"copied onto itself, {to}" }
    }
    using let r = File.open(from)
    using let w = File.create(to)
    try {
        return copyAll(r, w)
    } catch (e: Cancelled) {
        unreachable("a file's call is not cancelled")
    }
}

/// The entries under `path`, not `path` itself: depth first, a directory before what is in it, each
/// directory's entries in the byte order of their names, links not followed. Each directory is read whole
/// and let go, so the walk holds nothing open; an error ends it.
fn walk(path: string): WalkIter throws IoError {
    let it = WalkIter { frames = [] }
    it.enter(path)
    return it
}

/// The entries under a directory, from `walk`. After its end or an error it gives no more.
class WalkIter :: [Iterator] {
    type Item = DirEntry
    frames: WalkFrame[]
    var below: ?string = null
    var done: bool = false

    /// The next entry, `null` at the end.
    fn next(): ?DirEntry throws IoError {
        if (this.done) {
            return null
        }
        // the directory given last is entered now: what reading it throws comes after its entry
        if (let dir = this.below) {
            this.below = null
            try {
                this.enter(dir)
            } catch (e: IoError) {
                this.done = true
                throw e
            }
        }
        loop {
            if (this.frames.isEmpty()) {
                this.done = true
                return null
            }
            let frame = this.frames[this.frames.length() - 1]
            if (frame.at == frame.entries.length()) {
                this.frames.pop()
                continue
            }
            let e = frame.entries[frame.at]
            frame.at += 1
            if (e.isDir) {
                this.below = e.path
            }
            return e
        }
    }

    /// Reads the entries of `dir`, sorted by name, as the walk's next to give.
    private fn enter(dir: string): void throws IoError {
        let entries: DirEntry[] = []
        for (e in readDir(dir)) {
            entries.push(e)
        }
        // a function value may throw anything to the checker: this one does not
        try {
            entries.sortByKey((e) => e.name)
        } catch (e: Error) {
            unreachable("a name throws nothing")
        }
        this.frames.push(WalkFrame { entries = entries })
    }
}

/// A directory of a walk: its entries, and how many were given.
private class WalkFrame {
    entries: DirEntry[]
    var at: int = 0
}

/// Makes a new directory under the system's directory for temporary files and answers its path. Nothing
/// removes it but `removeAll`.
fn tempDir(): string throws IoError {
    let holder = [""]
    let n = newTempDir(holder)
    if (n < 0) {
        throw __ioFailure(n, holder[0], "made")
    }
    return holder[0]
}

/// Makes a new empty file under the system's directory for temporary files and answers its path. Nothing
/// removes it but `remove`.
fn tempFile(): string throws IoError {
    let holder = [""]
    let n = newTempFile(holder)
    if (n < 0) {
        throw __ioFailure(n, holder[0], "made")
    }
    return holder[0]
}
