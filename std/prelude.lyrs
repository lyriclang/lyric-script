//! The prelude (07 V3 I8): what every module names without an import, written in Lyric-Script and
//! parsed before the program as no file of it. The literal protocols (03 Lit), each a static
//! member that builds the conforming type from a literal of its kind; `Error`, the root of what is
//! thrown, `Exception`, the ready-made one with a message, `Backtrace`, where an error was first
//! thrown, and `Closeable`, what `using` closes (05 E3, E6, E7; Lyric 5's std.core); tasks,
//! coroutines, scopes, channels, semaphores, `select` and time (S6; 07 N2-N9). Its `__` names are
//! the VM's intrinsics, which only the prelude and the standard library's modules can call.
interface Error {
    fn message(): string
    fn cause(): ?Error {
        return null
    }
}
class Exception :: Error {
    text: string
    inner: ?Error = null
    static fn new(message: string, cause: ?Error = null): Exception {
        return Exception { text = message, inner = cause }
    }
    fn message(): string {
        return this.text
    }
    fn cause(): ?Error {
        return this.inner
    }
}
struct Backtrace {
    text: string
    fn show(): string = this.text
}
interface Closeable {
    fn close()
}
interface FromIntLiteral {
    static fn fromIntLiteral(v: int): Self
}
interface FromFloatLiteral {
    static fn fromFloatLiteral(v: float): Self
}
interface FromStringLiteral {
    static fn fromStringLiteral(v: string): Self
}
interface FromBoolLiteral {
    static fn fromBoolLiteral(v: bool): Self
}
interface FromNullLiteral {
    static fn fromNullLiteral(): Self
}
class Task<T> {
}
class PanicInfo {
    code: string
    message: string
    trace: string
}
enum TaskStatus<T> {
    Running,
    Done(T),
    Failed(Error),
    Cancelled,
    Panicked(PanicInfo),
}
class Coroutine<Y, R = void> :: [Identity, Closeable, Iterator] {
    type Item = Y
    fn next(): ?Y = __coNext(this)
    fn close() {
        __coClose(this)
    }
}
class Cancelled :: Error {
    fn message(): string = "cancelled"
}
class TaskScope :: Closeable {
    fn close() {
        __scopeClose(this)
    }
}
class ChannelClosed :: Error {
    fn message(): string = "channel closed"
}
class Channel<T> {
}
class Semaphore {
}
interface SelectCase {
    fn ready(): bool
    fn watch()
    fn fire()
}
class ChannelCase<T> :: SelectCase {
    channel: Channel<T>
    body: fn(?T) -> void
    fn ready(): bool = __chanReady(this.channel)
    fn watch() {
        __chanWatch(this.channel)
    }
    fn fire() {
        let f = this.body
        f(this.channel.recv())
    }
}
class CaseNode {
    entry: SelectCase
    var next: ?CaseNode = null
}
class Selection {
    var first: ?CaseNode = null
    var last: ?CaseNode = null
    var timeoutNanos: int = -1
    var onTimeout: ?fn() -> void = null
    fn on<T>(c: Channel<T>, body: fn(?T) -> void): Selection {
        let node = CaseNode { entry = ChannelCase { channel = c, body = body } }
        if (let tail = this.last) {
            tail.next = node
        } else {
            this.first = node
        }
        this.last = node
        return this
    }
    fn timeout(d: Duration, body: fn() -> void): Selection {
        this.timeoutNanos = if (d.nanos() > 0) d.nanos() else 0
        this.onTimeout = body
        return this
    }
    fn run() {
        var timer: ?Channel<void> = null
        while (true) {
            var n = this.first
            while (let c = n) {
                if (c.entry.ready()) {
                    c.entry.fire()
                    return
                }
                n = c.next
            }
            if (let late = this.onTimeout) {
                if (this.timeoutNanos == 0) {
                    late()
                    return
                }
                if (timer == null) {
                    timer = Timer.after(Duration.ofNanos(this.timeoutNanos))
                }
                if (let tc = timer) {
                    if (__chanReady(tc)) {
                        late()
                        return
                    }
                    __chanWatch(tc)
                }
            }
            n = this.first
            while (let c = n) {
                c.entry.watch()
                n = c.next
            }
            __parkWatched()
        }
    }
}
class Select {
    static fn on<T>(c: Channel<T>, body: fn(?T) -> void): Selection = Selection { }.on(c, body)
}
struct Duration {
    private nanosCount: int
    static fn ofNanos(n: int): Duration = Duration { nanosCount = n }
    static fn ofMicros(n: int): Duration = Duration { nanosCount = n * 1000 }
    static fn ofMillis(n: int): Duration = Duration { nanosCount = n * 1000000 }
    static fn ofSecs(n: int): Duration = Duration { nanosCount = n * 1000000000 }
    static fn ofMinutes(n: int): Duration = Duration { nanosCount = n * 60000000000 }
    static fn ofHours(n: int): Duration = Duration { nanosCount = n * 3600000000000 }
    fn nanos(): int = this.nanosCount
    fn millis(): int = this.nanosCount / 1000000
    fn secs(): int = this.nanosCount / 1000000000
}
fn sleep(d: Duration) {
    __sleep(d.nanos())
}
class Timer {
    static fn after(d: Duration): Channel<void> = __timerAfter(d.nanos())
}
fn readLine(): ?string = __readLine()
class TimedOut :: Error {
    fn message(): string = "timed out"
}
class TimeoutFlag {
    var late: bool = false
}
fn withTimeout<T>(d: Duration, body: fn() -> T): T {
    let flag = TimeoutFlag { }
    let scope = TaskScope.new()
    let work = scope.spawn { body() }
    let timer = scope.spawn {
        sleep(d)
        flag.late = true
        work.cancel()
    }
    defer {
        timer.cancel()
        try {
            scope.close()
        } catch (e) {
        }
    }
    try {
        return work.await()
    } catch (e: Cancelled) {
        if (flag.late) {
            throw TimedOut { }
        }
        throw e
    }
}
extend<T> T[] {
    /// The elements in the order `cmp` gives, stably — equal ones keep their order (Lyric 5 C10;
    /// S7c6c2): a merge sort through a buffer of the length, O(n log n) comparisons. Where `cmp`
    /// throws, the list is as it was.
    fn sortBy(cmp: fn(T, T) -> Ordering) {
        let n = this.length()
        if (n < 2) {
            return
        }
        var a = this[..]
        var b = this[..]
        var width = 1
        while (width < n) {
            var lo = 0
            while (lo < n) {
                let mid = if (lo + width < n) lo + width else n
                let hi = if (lo + 2 * width < n) lo + 2 * width else n
                var i = lo
                var j = mid
                var k = lo
                while (k < hi) {
                    if (i < mid && (j >= hi || cmp(a[j], a[i]) != Ordering.Less)) {
                        b[k] = a[i]
                        i += 1
                    } else {
                        b[k] = a[j]
                        j += 1
                    }
                    k += 1
                }
                lo = hi
            }
            let t = a
            a = b
            b = t
            width *= 2
        }
        var k = 0
        while (k < n) {
            this[k] = a[k]
            k += 1
        }
    }
    /// The elements in the order of a `TotalOrder` key, stably.
    fn sortByKey<K :: [TotalOrder]>(key: fn(T) -> K) {
        this.sortBy((x, y) => key(x).totalCompare(key(y)))
    }
    /// The first index whose element fails `p`, for elements `p` partitions — every one it holds
    /// for before every one it does not: a binary search.
    fn partitionPoint(p: fn(T) -> bool): int {
        var lo = 0
        var hi = this.length()
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2
            if (p(this[mid])) {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return lo
    }
    /// The elements as `{x}` writes each, `sep` between each two — every value prints (03 Eq).
    fn join(sep: string): string {
        var s = ""
        var k = 0
        while (k < this.length()) {
            if (k > 0) {
                s += sep
            }
            s += f"{this[k]}"
            k += 1
        }
        return s
    }
    /// An empty list (Lyric 5's `List.new`; a `List<T>` is a `T[]`).
    static fn new(): T[] = []
    /// A new list of the elements of `xs` (Lyric 5's `List.of`).
    static fn of(xs: T[]): T[] = xs[..]
    /// The values of an iterator, in order (Lyric 5's `List.from`).
    static fn from<I :: [Iterator<Item = T>]>(it: I): T[] {
        let out: T[] = []
        while (let x = it.next()) {
            out.push(x)
        }
        return out
    }
    /// An empty list (Lyric 5's `List.withCapacity`: the room is the VM's to keep); a negative
    /// `n` panics.
    static fn withCapacity(n: int): T[] {
        if (n < 0) {
            panic(f"a negative capacity: {n}")
        }
        return []
    }
    /// Whether the list has no element.
    fn isEmpty(): bool = this.length() == 0
    /// The element at `i`, `null` outside the list.
    fn get(i: int): ?T {
        if (i < 0 || i >= this.length()) {
            return null
        }
        return this[i]
    }
    /// The first element, `null` where the list is empty.
    fn first(): ?T = this.get(0)
    /// The last element, `null` where the list is empty.
    fn last(): ?T = this.get(this.length() - 1)
    /// Appends every element of `xs`, in order; `xs` may be the list itself.
    fn pushAll(xs: T[]) {
        let n = xs.length()
        var k = 0
        while (k < n) {
            this.push(xs[k])
            k += 1
        }
    }
    /// `v` at `i`, the elements from `i` on one place further; a panic where `i` is outside
    /// `0..=length()`.
    fn insert(i: int, v: T) {
        let n = this.length()
        if (i < 0 || i > n) {
            __boundsPanic(f"index {i} out of bounds for length {n}")
        }
        this.push(v)
        var k = n
        while (k > i) {
            this[k] = this[k - 1]
            k -= 1
        }
        this[i] = v
    }
    /// Takes the element at `i` out and gives it, the elements after it one place nearer.
    fn removeAt(i: int): T {
        let v = this[i]
        let n = this.length()
        var k = i
        while (k < n - 1) {
            this[k] = this[k + 1]
            k += 1
        }
        __listTruncate(this, n - 1)
        return v
    }
    /// Takes out the elements `p` holds for, the others kept in order; how many went. Where `p`
    /// throws, the elements decided so far are gone or kept and the rest stay, in order.
    fn removeWhere(p: fn(T) -> bool): int {
        let n = this.length()
        var kept = 0
        var k = 0
        defer {
            var j = k
            while (j < n) {
                this[kept + j - k] = this[j]
                j += 1
            }
            __listTruncate(this, kept + n - k)
        }
        while (k < n) {
            let v = this[k]
            if (!p(v)) {
                this[kept] = v
                kept += 1
            }
            k += 1
        }
        return n - kept
    }
    /// Takes every element out.
    fn clear() {
        __listTruncate(this, 0)
    }
    /// Keeps the first `n` elements: an `n` at or past the length keeps all, a negative one panics.
    fn truncate(n: int) {
        if (n < 0) {
            panic(f"a negative length: {n}")
        }
        __listTruncate(this, n)
    }
    /// Exchanges the elements at `i` and `j`.
    fn swap(i: int, j: int) {
        let v = this[i]
        this[i] = this[j]
        this[j] = v
    }
    /// The elements in the opposite order, in place.
    fn reverse() {
        var i = 0
        var j = this.length() - 1
        while (i < j) {
            this.swap(i, j)
            i += 1
            j -= 1
        }
    }
    /// A new list of the elements in the opposite order.
    fn reversed(): T[] {
        let out: T[] = []
        var k = this.length() - 1
        while (k >= 0) {
            out.push(this[k])
            k -= 1
        }
        return out
    }
    /// Every element `v`.
    fn fill(v: T) {
        var k = 0
        while (k < this.length()) {
            this[k] = v
            k += 1
        }
    }
}
fn __listConcat<T>(a: T[], b: T[]): T[] {
    let out: T[] = []
    out.pushAll(a)
    out.pushAll(b)
    return out
}
fn __listRepeat<T>(a: T[], n: int): T[] {
    if (n < 0) {
        panic("negative repeat count")
    }
    let out: T[] = []
    var k = 0
    while (k < n) {
        out.pushAll(a)
        k += 1
    }
    return out
}
fn __listSlice<T>(xs: T[], from: int, to: int): T[] {
    let n = xs.length()
    if (from < 0 || from > to || to > n) {
        __boundsPanic(f"range {from}..{to} out of bounds for length {n}")
    }
    let out: T[] = []
    var k = from
    while (k < to) {
        out.push(xs[k])
        k += 1
    }
    return out
}
// what `==` asks of a type parameter (Lyric 5 05 §12 rule 5): a struct, an enum, a tuple, a list
// and an optional are one where their parts are, a class through `:: Equatable` or `:: Identity`
interface Equatable {
    fn equals(o: Self): bool
}
// the order of two values (Lyric 5 05 §12 rule 6; S7c5b): `<` … read `compare`, `null` where the
// two are not ordered; `TotalOrder` is what sorting asks — `float` is one in IEEE 754's order
enum Ordering {
    Less,
    Equal,
    Greater,
}
interface Ordered :: Equatable {
    fn compare(o: Self): ?Ordering
}
interface TotalOrder :: Ordered {
    fn totalCompare(o: Self): Ordering
}
extend int :: [Ordered, TotalOrder] {
    fn compare(o: int): ?Ordering = this.totalCompare(o)
    fn totalCompare(o: int): Ordering = if (this < o) Ordering.Less
        else if (this > o) Ordering.Greater
        else Ordering.Equal
}
extend char :: [Ordered, TotalOrder] {
    fn compare(o: char): ?Ordering = this.totalCompare(o)
    fn totalCompare(o: char): Ordering = if (this < o) Ordering.Less
        else if (this > o) Ordering.Greater
        else Ordering.Equal
}
extend string :: [Ordered, TotalOrder] {
    fn compare(o: string): ?Ordering = this.totalCompare(o)
    fn totalCompare(o: string): Ordering = if (this < o) Ordering.Less
        else if (this > o) Ordering.Greater
        else Ordering.Equal
}
extend float :: [Ordered, TotalOrder] {
    fn compare(o: float): ?Ordering = if (this < o) Ordering.Less
        else if (this > o) Ordering.Greater
        else if (this == o) Ordering.Equal
        else null
    fn totalCompare(o: float): Ordering = __floatKey(this).totalCompare(__floatKey(o))
}
fn __floatKey(x: float): int = __float_orderKey(x)
// the operators of a type of the program (Lyric 5 05 §12 rules 1–4; S7c5c2): `a + b` is
// `a.add(b)` through the conformance the right operand's type picks, `-a` is `a.neg()`; the
// result is the conformance's `Out`, `Self` unless it answers otherwise
interface Add<Rhs = Self> {
    type Out = Self
    fn add(rhs: Rhs): Self.Out
}
interface Sub<Rhs = Self> {
    type Out = Self
    fn sub(rhs: Rhs): Self.Out
}
interface Mul<Rhs = Self> {
    type Out = Self
    fn mul(rhs: Rhs): Self.Out
}
interface Div<Rhs = Self> {
    type Out = Self
    fn div(rhs: Rhs): Self.Out
}
interface Rem<Rhs = Self> {
    type Out = Self
    fn rem(rhs: Rhs): Self.Out
}
interface BitAnd<Rhs = Self> {
    type Out = Self
    fn bitAnd(rhs: Rhs): Self.Out
}
interface BitOr<Rhs = Self> {
    type Out = Self
    fn bitOr(rhs: Rhs): Self.Out
}
interface BitXor<Rhs = Self> {
    type Out = Self
    fn bitXor(rhs: Rhs): Self.Out
}
interface Shl<Rhs = int> {
    type Out = Self
    fn shl(rhs: Rhs): Self.Out
}
interface Shr<Rhs = int> {
    type Out = Self
    fn shr(rhs: Rhs): Self.Out
}
interface Neg {
    type Out = Self
    fn neg(): Self.Out
}
interface BitNot {
    type Out = Self
    fn bitNot(): Self.Out
}
// the scalars keep their own arithmetic and conform besides, for a constraint to take them
extend int :: [Add, Sub, Mul, Div, Rem, Neg, BitAnd, BitOr, BitXor, BitNot, Shl, Shr] {
    fn add(rhs: int): int = this + rhs
    fn sub(rhs: int): int = this - rhs
    fn mul(rhs: int): int = this * rhs
    fn div(rhs: int): int = this / rhs
    fn rem(rhs: int): int = this % rhs
    fn neg(): int = -this
    fn bitAnd(rhs: int): int = this & rhs
    fn bitOr(rhs: int): int = this | rhs
    fn bitXor(rhs: int): int = this ^ rhs
    fn bitNot(): int = ~this
    fn shl(rhs: int): int = this << rhs
    fn shr(rhs: int): int = this >> rhs
}
extend float :: [Add, Sub, Mul, Div, Rem, Neg] {
    fn add(rhs: float): float = this + rhs
    fn sub(rhs: float): float = this - rhs
    fn mul(rhs: float): float = this * rhs
    fn div(rhs: float): float = this / rhs
    fn rem(rhs: float): float = this % rhs
    fn neg(): float = -this
}
extend string :: Add {
    fn add(rhs: string): string = this + rhs
}
// a value's own copy, and a type's value where nothing is given (Lyric 5 05 §14; S7c6c1):
// synthesized where a struct, a class or an enum lists them without the member — `clone` copies
// the value fields and clones the reference fields, `default` takes each field's initializer or
// its type's default
interface Clone {
    fn clone(): Self
}
interface Default {
    static fn default(): Self
}
extend int :: [Clone, Default] {
    fn clone(): int = this
    static fn default(): int = 0
}
extend float :: [Clone, Default] {
    fn clone(): float = this
    static fn default(): float = 0.0
}
extend bool :: [Clone, Default] {
    fn clone(): bool = this
    static fn default(): bool = false
}
extend char :: [Clone, Default] {
    fn clone(): char = this
    static fn default(): char = 0 as char
}
extend string :: [Clone, Default] {
    fn clone(): string = this
    static fn default(): string = ""
}
// of a Clone element a list is Clone: a new list of the elements' clones
extend<T :: [Clone]> T[] :: Clone {
    fn clone(): T[] {
        let out: T[] = []
        for (x in this) {
            out.push(x.clone())
        }
        return out
    }
}
extend<T> T[] :: Default {
    static fn default(): T[] = []
}
// mixed arithmetic through the interfaces, the `int` widened (03 Mix; S7c5d3)
extend int :: [Add<float>, Sub<float>, Mul<float>, Div<float>, Rem<float>] {
    type Out = float
    fn add(rhs: float): float = this + rhs
    fn sub(rhs: float): float = this - rhs
    fn mul(rhs: float): float = this * rhs
    fn div(rhs: float): float = this / rhs
    fn rem(rhs: float): float = this % rhs
}
extend float :: [Add<int>, Sub<int>, Mul<int>, Div<int>, Rem<int>] {
    fn add(rhs: int): float = this + rhs
    fn sub(rhs: int): float = this - rhs
    fn mul(rhs: int): float = this * rhs
    fn div(rhs: int): float = this / rhs
    fn rem(rhs: int): float = this % rhs
}
// the sorts and the search of elements in a total order (Lyric 5 C10; S7c6c2): ascending,
// stably; a list of ints, chars, floats or strings is sorted by the VM
extend<T :: [TotalOrder]> T[] {
    fn sort() {
        this.sortBy((x, y) => x.totalCompare(y))
    }
    // Lyric 5's sorts in place without a buffer, equal elements in any order: a stable sort is
    // one
    fn sortUnstable() {
        this.sort()
    }
    // the index of an element equal to `x` in sorted elements, any of several equal ones; `null`
    // where there is none
    fn binarySearch(x: T): ?int {
        var lo = 0
        var hi = this.length()
        while (lo < hi) {
            let mid = lo + (hi - lo) / 2
            let c = this[mid].totalCompare(x)
            if (c == Ordering.Less) {
                lo = mid + 1
            } else if (c == Ordering.Greater) {
                hi = mid
            } else {
                return mid
            }
        }
        return null
    }
}
// what `<`, `<=`, `>` and `>=` make of a `compare`
fn __less(c: ?Ordering): bool = c == Ordering.Less
fn __lessOrEqual(c: ?Ordering): bool = c == Ordering.Less || c == Ordering.Equal
fn __greater(c: ?Ordering): bool = c == Ordering.Greater
fn __greaterOrEqual(c: ?Ordering): bool = c == Ordering.Greater || c == Ordering.Equal
// what `x in xs` asks of `xs` (Lyric 5 05 §12 rule 10; S7c5c3)
interface Contains<T> {
    fn contains(x: T): bool
}
// the comparing methods of every list whose elements compare (S7c5a; S7b2a synthesized them)
extend<T :: [Equatable]> T[] :: Contains<T> {
    fn contains(x: T): bool = this.indexOf(x) != null
    fn indexOf(x: T): ?int {
        var k = 0
        while (k < this.length()) {
            if (this[k] == x) {
                return k
            }
            k += 1
        }
        return null
    }
    fn remove(x: T): bool {
        if (let k = this.indexOf(x)) {
            this.removeAt(k)
            return true
        }
        return false
    }
    fn dedup() {
        if (this.length() < 2) {
            return
        }
        var kept = 1
        var k = 1
        while (k < this.length()) {
            if (this[k] != this[kept - 1]) {
                this[kept] = this[k]
                kept += 1
            }
            k += 1
        }
        this.truncate(kept)
    }
}
interface Index<K> {
    type Output
    fn index(k: K): Self.Output
}
interface IndexSet<K> :: Index<K> {
    fn setIndex(k: K, v: Self.Output)
}
interface FromArrayLiteral<T> {
    static fn fromArrayLiteral(items: T[]): Self
}
interface Iterator {
    type Item
    fn next(): ?Self.Item
    // how many values are left, at least and at most where that is known (S7c6a)
    fn sizeHint(): (int, ?int) = (0, null)
}
// an iterator from both ends: `nextBack()` gives the last value not yet given (S7c6a)
interface DoubleEnded :: Iterator {
    fn nextBack(): ?Self.Item
}
interface FromIterator<T> {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): Self
}
extend<T> T[] :: FromIterator<T> {
    static fn fromIter<I :: [Iterator<Item = T>]>(it: I): T[] {
        let out: T[] = []
        while (let x = it.next()) {
            out.push(x)
        }
        return out
    }
}
extend<I :: [Iterator]> I {
    fn collect<C :: [FromIterator<I.Item>]>(): C = C.fromIter(this)
}
extend<I :: [Iterator]> I :: Iterable<Iter = I> {
    fn iter(): I = this
}
interface Iterable {
    type Iter :: [Iterator]
    fn iter(): Self.Iter
}
class ListIter<T> :: [Iterator, DoubleEnded, Clone] {
    type Item = T
    list: T[]
    var at: int = 0
    var end: int
    changes: int
    fn next(): ?T {
        __listCheck(this.list, this.changes)
        if (this.at >= this.end) {
            return null
        }
        let v = this.list[this.at]
        this.at += 1
        return v
    }
    fn nextBack(): ?T {
        __listCheck(this.list, this.changes)
        if (this.at >= this.end) {
            return null
        }
        this.end -= 1
        return this.list[this.end]
    }
