//! Spans, the system's two clocks, the calendar and RFC 3339 (12 rules 29–30; Lyric 5 12 §Time): a module of
//! the right `os`. `Duration` is the prelude's, so that a script waits without an import; its arithmetic, its
//! text and `parse` are this module's, a program that names none of them pays for none. So are `Instant`'s
//! text, `parse` and `toDateTime`: `Instant` lives in `std.time.instant`, which `std.fs` names alone.
pub import std.time.instant { Instant }
import std.time.instant { epochNanosOf, floorDiv, instantOfEpochNanos }

private fn clockMonotonic(): int = __time_monotonic()
private fn zoneNew(): Any = __time_zone()
private fn zoneOpen(how: int, holder: string[], handle: Any, name: string, text: string, data: Any): int = __time_zoneOpen(how, holder, handle, name, text, data)
private fn zoneAt(ns: int, handle: Any, holder: string[]): int = __time_zoneAt(ns, handle, holder)

/// The least span, whose text has no positive twin.
private fn leastNanos(): int = -9223372036854775807 - 1

extend Duration :: [
    Equatable,
    Ordered,
    TotalOrder,
    Hashable,
    Default,
    Display,
    Parse,
    Add,
    Sub,
    Mul<int>,
    Div<int>
] {
    /// The span in seconds, with their fraction.
    fn asSecsFloat(): float = (this.nanos() as float) / 1000000000.0

    fn add(rhs: Duration): Duration = Duration.ofNanos(this.nanos() + rhs.nanos())
    fn sub(rhs: Duration): Duration = Duration.ofNanos(this.nanos() - rhs.nanos())
    fn mul(rhs: int): Duration = Duration.ofNanos(this.nanos() * rhs)

    /// The span divided by `rhs`, rounded toward zero; a division by zero panics.
    fn div(rhs: int): Duration = Duration.ofNanos(this.nanos() / rhs)

    fn equals(o: Duration): bool = this.nanos() == o.nanos()
    fn compare(o: Duration): ?Ordering = this.nanos().compare(o.nanos())
    fn totalCompare(o: Duration): Ordering = this.nanos().totalCompare(o.nanos())

    fn hash(h: Hasher) {
        h.writeInt(this.nanos())
    }

    /// Zero.
    static fn default(): Duration = Duration.ofNanos(0)

    /// The span as Go writes it: `0s`; under a second one unit — `ns`, `µs`, `ms` — with the fraction, its
    /// trailing zeros dropped (`1.5µs`, `500ms`); from a second on hours, minutes and seconds with their
    /// fraction, the larger ones from the first that is not zero (`1.5s`, `1m30s`, `1h0m0s`); a minus in front
    /// of a negative one.
    fn show(): string {
        let ns = this.nanos()
        if (ns == 0) {
            return "0s"
        }
        // its positive twin is no `int`
        if (ns == leastNanos()) {
            return "-2562047h47m16.854775808s"
        }
        let u = if (ns < 0) -ns else ns
        var text = ""
        if (u < 1000000000) {
            let unit = if (u < 1000) "ns" else if (u < 1000000) "µs" else "ms"
            let precision = if (u < 1000) 0 else if (u < 1000000) 3 else 6
            let (whole, fraction) = splitFraction(u, precision)
            text = f"{whole}{fraction}{unit}"
        } else {
            let (secs, fraction) = splitFraction(u, 9)
            let minutes = secs / 60
            let hours = minutes / 60
            text = if (hours > 0) f"{hours}h{minutes % 60}m{secs % 60}{fraction}s"
                else if (minutes > 0) f"{minutes}m{secs % 60}{fraction}s"
                else f"{secs}{fraction}s"
        }
        return if (ns < 0) "-" + text else text
    }

    /// A span in Go's form: an optional sign, then one or more numbers each with its unit — `ns`, `us` (or
    /// `µs`, `μs`), `ms`, `s`, `m`, `h` —, a number with a fraction allowed: `1h30m`, `1.5h`, `.5s`,
    /// `-300ms`; `0` alone is zero. A fraction is scaled to its unit through a float, as Go does. An empty
    /// text throws `ParseError` with `Empty`, a number without digits or a missing or unknown unit `Invalid`,
    /// a span beyond the range `Overflow`.
    static fn parse(s: string): Duration {
        let cs = List<char>.new()
        for (c in s.chars()) {
            cs.push(c)
        }
        let n = cs.length()
        if (n == 0) {
            throw ParseError { kind = ParseErrorKind.Empty }
        }
        var i = 0
        var negative = false
        if (cs[0] == '-' || cs[0] == '+') {
            negative = cs[0] == '-'
            i = 1
        }
        if (n - i == 1 && cs[i] == '0') {
            return Duration.ofNanos(0)
        }
        if (i == n) {
            throw ParseError { kind = ParseErrorKind.Invalid }
        }
        // the span counts downward, so that the least is reached: each part is taken from it
        var total = 0
        while (i < n) {
            let start = i
            var whole = 0
            while (i < n && isDigit(cs[i])) {
                let d = (cs[i] as int) - 48
                if (whole < (leastNanos() + d) / 10) {
                    throw ParseError { kind = ParseErrorKind.Overflow }
                }
                whole = whole * 10 - d
                i += 1
            }
            let digitsBefore = i > start
            var fraction = 0
            var scale = 1.0
            var digitsAfter = false
            if (i < n && cs[i] == '.') {
                i += 1
                let fractionStart = i
                var full = false
                while (i < n && isDigit(cs[i])) {
                    // digits past what 63 bits hold add nothing a nanosecond sees; one digit fewer than
                    // Lyric 5's unsigned count takes, which no nanosecond sees either
                    if (!full && fraction < 922337203685477580) {
                        fraction = fraction * 10 + ((cs[i] as int) - 48)
                        scale = scale * 10.0
                    } else {
                        full = true
                    }
                    i += 1
                }
                digitsAfter = i > fractionStart
            }
            if (!digitsBefore && !digitsAfter) {
                throw ParseError { kind = ParseErrorKind.Invalid }
            }
            // the unit: everything up to the next number
            let unit = StringBuilder.new()
            while (i < n && !isDigit(cs[i]) && cs[i] != '.') {
                unit.appendChar(cs[i])
                i += 1
            }
            let per = unitNanos(unit.toString())
            if (per == 0) {
                throw ParseError { kind = ParseErrorKind.Invalid }
            }
            if (whole < leastNanos() / per) {
                throw ParseError { kind = ParseErrorKind.Overflow }
            }
            var value = whole * per
            if (fraction > 0) {
                let part = ((fraction as float) * ((per as float) / scale)) as int
                if (value < leastNanos() + part) {
                    throw ParseError { kind = ParseErrorKind.Overflow }
                }
                value -= part
            }
            if (total < leastNanos() - value) {
                throw ParseError { kind = ParseErrorKind.Overflow }
            }
            total += value
        }
        if (negative) {
            return Duration.ofNanos(total)
        }
        if (total == leastNanos()) {
            throw ParseError { kind = ParseErrorKind.Overflow }
        }
        return Duration.ofNanos(-total)
    }
}

private fn isDigit(c: char): bool = c >= '0' && c <= '9'

/// `v` over 10^`precision`: the whole part, and the fraction as `.ddd` without its trailing zeros, nothing
/// where it is zero.
private fn splitFraction(v: int, precision: int): (int, string) {
    var scale = 1
    var k = 0
    while (k < precision) {
        scale *= 10
        k += 1
    }
    let whole = v / scale
    var rest = v % scale
    if (rest == 0) {
        return (whole, "")
    }
    var digits = precision
    while (rest % 10 == 0) {
        rest = rest / 10
        digits -= 1
    }
    var text = f"{rest}"
    while (text.length() < digits) {
        text = "0" + text
    }
    return (whole, "." + text)
}

/// The nanoseconds of a unit's name, 0 for no unit.
private fn unitNanos(name: string): int = match (name) {
    "ns" => 1,
    "us" => 1000,
    "µs" => 1000,
    "μs" => 1000,
    "ms" => 1000000,
    "s" => 1000000000,
    "m" => 60000000000,
    "h" => 3600000000000,
    _ => 0,
}

/// A moment on the clock that only moves forward, from an unspecified start: for how long something takes,
/// never for the time of day. The run's own, which its timers keep.
struct Monotonic {
    private ns: int

    static fn now(): Monotonic = Monotonic { ns = clockMonotonic() }

    /// How long ago this moment was taken.
    fn elapsed(): Duration = Duration.ofNanos(clockMonotonic() - this.ns)
}

/// The nanoseconds of a day.
private fn nanosPerDay(): int = 86400000000000

/// The reason for a `TimeError`: a value that does not exist; no zone database on the system; a zone the
/// database does not have.
enum TimeErrorKind :: [Equatable] {
    Invalid,
    NoZoneData,
    NoSuchZone,
}

/// The error for what is no date, no time of day, no offset — February 30th, 24:00, an offset of 90 seconds
/// —, its `kind` saying why.
struct TimeError :: Error {
    detail: string
    kind: TimeErrorKind = TimeErrorKind.Invalid

    fn message(): string = this.detail
}

/// The days of the week, Monday first (ISO 8601).
enum Weekday :: [Equatable, Display] {
    Monday,
    Tuesday,
    Wednesday,
    Thursday,
    Friday,
    Saturday,
    Sunday,

    fn show(): string = match (this) {
        .Monday => "Monday",
        .Tuesday => "Tuesday",
        .Wednesday => "Wednesday",
        .Thursday => "Thursday",
        .Friday => "Friday",
        .Saturday => "Saturday",
        .Sunday => "Sunday",
    }
}

/// A day of the proleptic Gregorian calendar, in every year an `int` holds; two order by year, month and day.
/// Its text is ISO 8601's, `2026-10-08`; a year outside 0000–9999 shows its sign and its digits,
/// `+10000-01-01`, which RFC 3339 does not read back.
struct Date :: [Equatable, Ordered, TotalOrder, Hashable, Display, Parse] {
    private y: int
    private m: int
    private d: int

    /// The date `year-month-day`; `TimeError` where there is none — a month outside 1–12, a day beyond the
    /// month's.
    static fn of(year: int, month: int, day: int): Date {
        if (month < 1 || month > 12) {
            throw TimeError { detail = f"there is no month {month}" }
        }
        if (day < 1 || day > daysIn(year, month)) {
            throw TimeError { detail = f"there is no day {day} in {yearText(year)}-{twoDigits(month)}" }
        }
        return Date { y = year, m = month, d = day }
    }

    fn year(): int = this.y
    fn month(): int = this.m
    fn day(): int = this.d

    /// Whether the date's year has a February 29th: divisible by 4, and by 400 where by 100.
    fn isLeapYear(): bool = isLeap(this.y)

    fn dayOfWeek(): Weekday {
        // 1970-01-01 was a Thursday: day 0 is weekday 3 counted from Monday as 0
        return match (floorRem(daysOf(this) + 3, 7)) {
            0 => Weekday.Monday,
            1 => Weekday.Tuesday,
            2 => Weekday.Wednesday,
            3 => Weekday.Thursday,
            4 => Weekday.Friday,
            5 => Weekday.Saturday,
            _ => Weekday.Sunday,
        }
    }

    /// The date `n` days later, earlier for a negative `n`.
    fn plusDays(n: int): Date = fromDays(daysOf(this) + n)

    fn show(): string = f"{yearText(this.y)}-{twoDigits(this.m)}-{twoDigits(this.d)}"

    /// RFC 3339's full-date: `YYYY-MM-DD`, four digits of year, a date that exists. `ParseError` with `Empty`
    /// for an empty text, `Invalid` for a text of another shape or a date that does not exist.
    static fn parse(s: string): Date {
        let cs = charsOf(s)
        if (cs.length() == 0) {
            throw ParseError { kind = ParseErrorKind.Empty }
        }
        if (cs.length() != 10) {
            throw ParseError { kind = ParseErrorKind.Invalid, detail = "a date is YYYY-MM-DD", offset = 0 }
        }
        return readDate(cs)
    }
}

/// A time of day: hours 0–23, minutes and seconds 0–59 — no leap second, which POSIX time does not count —,
/// nanoseconds; two order as the times they are. Its text is `HH:MM:SS` and the fraction, without trailing
/// zeros.
struct Time :: [Equatable, Ordered, TotalOrder, Hashable, Display, Parse] {
    private h: int
    private mi: int
    private s: int
    private n: int

    /// The time of day; `TimeError` where a field is out of range: hour 0–23, minute and second 0–59,
    /// nanosecond 0–999999999.
    static fn of(hour: int, minute: int, second: int, nano: int = 0): Time {
        if (hour < 0
            || hour > 23
            || minute < 0
            || minute > 59
            || second < 0
            || second > 59
            || nano < 0
            || nano > 999999999) {
            throw TimeError {
                detail = f"there is no time of day with hour {hour}, minute {minute}, second {second}, nanosecond {nano}",
            }
        }
        return Time { h = hour, mi = minute, s = second, n = nano }
    }

    fn hour(): int = this.h
    fn minute(): int = this.mi
    fn second(): int = this.s
    fn nano(): int = this.n

    fn show(): string {
        let (_, fraction) = splitFraction(this.n, 9)
        return f"{twoDigits(this.h)}:{twoDigits(this.mi)}:{twoDigits(this.s)}{fraction}"
    }

    /// `HH:MM:SS` and a fraction of up to nine digits (RFC 3339's partial-time, no offset): the text `show()`
    /// writes, read back; digits past the ninth are ignored. `ParseError` with `Empty` for an empty text,
    /// `Invalid` for a text of another shape or a time of day that does not exist.
    static fn parse(s: string): Time {
        let cs = charsOf(s)
        let n = cs.length()
        if (n == 0) {
            throw ParseError { kind = ParseErrorKind.Empty }
        }
        if (n < 8 || cs[2] != ':' || cs[5] != ':') {
            throw ParseError {
                kind = ParseErrorKind.Invalid,
                detail = "a time of day is HH:MM:SS, a fraction after it",
                offset = 0,
            }
        }
        let hour = twoDigitsAt(cs, 0)
        let minute = twoDigitsAt(cs, 3)
        let second = twoDigitsAt(cs, 6)
        var nano = 0
        if (n > 8) {
            if (cs[8] != '.') {
                throw ParseError {
                    kind = ParseErrorKind.Invalid,
                    detail = "only a fraction may follow the seconds",
                    offset = 8,
                }
            }
            let (fraction, at) = readFraction(cs, 9)
            if (at == 9 || at != n) {
                throw ParseError {
                    kind = ParseErrorKind.Invalid,
                    detail = "the fraction is digits, and nothing follows it",
                    offset = at,
                }
            }
            nano = fraction
        }
        return try Time.of(hour, minute, second, nano) catch (e: TimeError) throw ParseError {
            kind = ParseErrorKind.Invalid,
            detail = e.message(),
            offset = 0,
        }
    }
}

/// A time zone: UTC, a fixed offset from it, or a zone of rules — the database's, a TZif file's, a POSIX
/// rule's. The host reads and keeps the rules (Lyric 5's), the zone asks them for the offset at a moment
/// (12 rule 31). Two zones are equal by name, offset and kind.
struct Zone :: [Equatable] {
    private label: string
    private off: int
    private rules: ?Any = null

    static let utc: Zone = Zone { label = "UTC", off = 0 }

    /// The zone `offset` east of UTC, west for a negative one; `TimeError` unless the offset is whole minutes
    /// under a day, as RFC 3339 writes an offset. Its name is the offset's text, `+01:00`; `UTC` for none.
    static fn fixed(offset: Duration): Zone {
        let ns = offset.nanos()
        if (ns % 60000000000 != 0 || ns <= -nanosPerDay() || ns >= nanosPerDay()) {
            throw TimeError { detail = f"an offset is whole minutes under a day; {offset} is not" }
        }
        return fixedOf(ns)
    }

    /// The zone of the IANA name (`Europe/Berlin`) in the system's database, `TZDIR` or `/usr/share/zoneinfo`;
    /// `UTC`, `Etc/UTC` and `Z` are `Zone.utc` without it. `TimeError` with `NoZoneData` where the system has
    /// no database (Windows), `NoSuchZone` for a name it does not have or that is no name — empty, absolute,
    /// with `..` —, `Invalid` for a file that is no TZif.
    static fn load(name: string): Zone = openZone(0, name, "", null)

    /// The zone of a TZif file's bytes (RFC 8536, versions 1 to 4): its transitions, its types and the
    /// footer's rule for the years beyond; `TimeError` for bytes that are no TZif.
    static fn fromTzif(name: string, bytes: Bytes): Zone = openZone(1, name, "", bytes.v)

    /// The zone of a POSIX TZ string (`CET-1CEST,M3.5.0,M10.5.0/3`, `EST5EDT`, `<+0330>-3:30`), its offsets
    /// west-positive as POSIX writes them; `TimeError` for a string that is none.
    static fn fromPosix(name: string, tz: string): Zone = openZone(2, name, tz, null)

    /// The system's own zone: `TZ` where it is set — a name of the database, else a POSIX string —, else
    /// `/etc/localtime`, else UTC.
    static fn local(): Zone = openZone(3, "", "", null)

    fn name(): string = this.label

    /// Whether the zone is one offset for all time.
    fn isFixed(): bool = this.rules == null

    /// The offset east of UTC; a zone of rules answers its offset now.
    fn offset(): Duration {
        if (this.rules == null) {
            return Duration.ofNanos(this.off)
        }
        return this.offsetAt(Instant.now())
    }

    /// The offset east of UTC at the moment `at`.
    fn offsetAt(at: Instant): Duration = Duration.ofNanos(offsetNanosAt(this, epochNanosOf(at)))

    /// The offset, whether daylight time is in force, and the abbreviation at the moment `at`.
    fn infoAt(at: Instant): ZoneInfo {
        if (let handle = this.rules) {
            let holder = [""]
            let bits = zoneAt(epochNanosOf(at), handle, holder)
            let secs = floorDiv(bits, 2)
            return ZoneInfo { offset = Duration.ofSecs(secs), isDst = bits - secs * 2 == 1, abbreviation = holder[0] }
        }
        return ZoneInfo { offset = Duration.ofNanos(this.off), isDst = false, abbreviation = this.label }
    }

    fn equals(o: Zone): bool = this.label == o.label && this.off == o.off && (this.rules == null) == (o.rules == null)
}

/// What a zone says about a moment.
struct ZoneInfo :: [Equatable, Debug] {
    offset: Duration
    isDst: bool
    abbreviation: string
}

/// A date and a time of day at an offset, in a zone. Two are equal by date, time and offset — one moment at
/// two offsets is two date-times and one instant. Its text is RFC 3339's, `Z` for no offset.
struct DateTime :: [Equatable, Display, Parse] {
    private d: Date
    private t: Time
    private off: int
    private z: Zone

    /// The date and time in the zone: in a zone of rules, at the offset in force then. A local time that does
    /// not exist — the hour the clocks spring forward — moves forward by the gap; one that exists twice — the
    /// hour they fall back — takes the earlier moment. In a zone of rules a local time beyond the moments an
    /// `Instant` reaches, or within a day of their ends, panics (`LYS-RT0002`).
    static fn of(date: Date, time: Time, zone: Zone): DateTime {
        if (zone.rules == null) {
            return DateTime { d = date, t = time, off = zone.off, z = zone }
        }
        let local = daysOf(date) * 86400 + (time.h * 60 + time.mi) * 60 + time.s
        let before = offsetSecsAt(zone, local - 86400)
        let after = offsetSecsAt(zone, local + 86400)
        let beforeHolds = offsetSecsAt(zone, local - before) == before
        let afterHolds = offsetSecsAt(zone, local - after) == after
        if (beforeHolds && afterHolds) {
            // once, or twice (an overlap): the earlier moment is the larger offset's
            let off = if (before > after) before else after
            return DateTime { d = date, t = time, off = off * 1000000000, z = zone }
        }
        if (beforeHolds) {
            return DateTime { d = date, t = time, off = before * 1000000000, z = zone }
        }
        if (afterHolds) {
            return DateTime { d = date, t = time, off = after * 1000000000, z = zone }
        }
        // a gap: forward by it, as the offset before the change reads the local time
        return instantOfEpochNanos((local - before) * 1000000000 + time.n).toDateTime(zone)
    }

    fn date(): Date = this.d
    fn time(): Time = this.t
    fn offset(): Duration = Duration.ofNanos(this.off)
    fn zone(): Zone = this.z

    /// The same local time `n` days on, in the zone: across a change of the clocks the offset follows it, a
    /// day 23 or 25 hours long.
    fn plusDays(n: int): DateTime = DateTime.of(this.d.plusDays(n), this.t, this.z)

    /// The same moment in another zone.
    fn withZone(zone: Zone): DateTime = this.toInstant().toDateTime(zone)

    /// What the zone says at this moment: the offset, daylight time, the abbreviation.
    fn zoneInfo(): ZoneInfo = this.z.infoAt(this.toInstant())

    /// The moment this date-time names; outside the years an `Instant` reaches, an overflow panics
    /// (`LYS-RT0002`).
    fn toInstant(): Instant {
        let t = this.t
        let ofDay = ((t.h * 60 + t.mi) * 60 + t.s) * 1000000000 + t.n
        return instantOfEpochNanos(daysOf(this.d) * nanosPerDay() + ofDay - this.off)
    }

    fn equals(o: DateTime): bool = this.d == o.d && this.t == o.t && this.off == o.off

    fn show(): string = f"{this.d}T{this.t}{offsetText(this.off)}"

    /// RFC 3339's date-time (§5.6), strictly: `T` or `t` between the date and the time, a fraction of any
    /// length — cut to nanoseconds —, `Z`, `z` or `±hh:mm`; no space for the `T`, no second 60. `ParseError`
    /// with `Empty` for an empty text, `Invalid` for a text of another shape or a date or time that does not
    /// exist.
    static fn parse(s: string): DateTime {
        let cs = charsOf(s)
        let n = cs.length()
        if (n == 0) {
            throw ParseError { kind = ParseErrorKind.Empty }
        }
        if (n < 20 || (cs[10] != 'T' && cs[10] != 't')) {
            throw ParseError {
                kind = ParseErrorKind.Invalid,
                detail = "a date-time is YYYY-MM-DDTHH:MM:SS with 'Z' or an offset",
                offset = 0,
            }
        }
        let date = readDate(cs)
        if (cs[13] != ':' || cs[16] != ':') {
            throw ParseError { kind = ParseErrorKind.Invalid, detail = "the time of day is HH:MM:SS", offset = 11 }
        }
        let hour = twoDigitsAt(cs, 11)
        let minute = twoDigitsAt(cs, 14)
        let second = twoDigitsAt(cs, 17)
        var at = 19
        var nano = 0
        if (cs[at] == '.') {
            let (fraction, end) = readFraction(cs, at + 1)
            if (end == at + 1) {
                throw ParseError { kind = ParseErrorKind.Invalid }
            }
            nano = fraction
            at = end
        }
        if (at >= n) {
            throw ParseError {
                kind = ParseErrorKind.Invalid,
                detail = "the offset is missing: 'Z', or +HH:MM",
                offset = at,
            }
        }
        var offset = 0
        if (cs[at] == 'Z' || cs[at] == 'z') {
            at += 1
        } else if ((cs[at] == '+' || cs[at] == '-') && at + 6 == n && cs[at + 3] == ':') {
            let hours = twoDigitsAt(cs, at + 1)
            let minutes = twoDigitsAt(cs, at + 4)
            if (hours > 23 || minutes > 59) {
                throw ParseError { kind = ParseErrorKind.Invalid }
            }
            offset = (hours * 60 + minutes) * 60000000000
            if (cs[at] == '-') {
                offset = -offset
            }
            at += 6
        } else {
            throw ParseError { kind = ParseErrorKind.Invalid, detail = "the offset is 'Z', or +HH:MM", offset = at }
        }
        if (at != n) {
            throw ParseError { kind = ParseErrorKind.Invalid, detail = "text after the date-time", offset = at }
        }
        let time = try Time.of(hour, minute, second, nano) catch (e: TimeError) throw ParseError {
            kind = ParseErrorKind.Invalid,
            detail = e.message(),
            offset = 11,
        }
        return DateTime { d = date, t = time, off = offset, z = fixedOf(offset) }
    }
}

extend Instant :: [Display, Parse] {
    /// The date, the time of day and the offset of this moment in `zone`, the offset in force then.
    fn toDateTime(zone: Zone): DateTime {
        let ns = epochNanosOf(this)
        let off = offsetNanosAt(zone, ns)
        let local = ns + off
        let days = floorDiv(local, nanosPerDay())
        let rest = local - days * nanosPerDay()
        let time = Time {
            h = rest / 3600000000000,
            mi = rest / 60000000000 % 60,
            s = rest / 1000000000 % 60,
            n = rest % 1000000000,
        }
        return DateTime { d = fromDays(days), t = time, off = off, z = zone }
    }

    /// The moment as RFC 3339 text in UTC.
    fn show(): string = this.toDateTime(Zone.utc).show()

    /// An RFC 3339 date-time at any offset, the moment it names: `ParseError` as `DateTime.parse` throws it;
    /// outside the years an `Instant` reaches, an overflow panics (`LYS-RT0002`).
    static fn parse(s: string): Instant = DateTime.parse(s).toInstant()
}

/// The characters of `s`, for the parsers: a text of these forms is ASCII, and what is not fails as no digit.
private fn charsOf(s: string): List<char> {
    let cs = List<char>.new()
    for (c in s.chars()) {
        cs.push(c)
    }
    return cs
}

/// The digits of a fraction from `at` on, as nanoseconds — past the ninth digit ignored —, and where they end.
private fn readFraction(cs: List<char>, at: int): (int, int) {
    var i = at
    var nano = 0
    var digits = 0
    while (i < cs.length() && isDigit(cs[i])) {
        if (digits < 9) {
            nano = nano * 10 + ((cs[i] as int) - 48)
        }
        digits += 1
        i += 1
    }
    while (digits < 9) {
        nano *= 10
        digits += 1
    }
    return (nano, i)
}

/// `YYYY-MM-DD` at the front of `cs`, a date that exists.
private fn readDate(cs: List<char>): Date {
    if (cs[4] != '-' || cs[7] != '-') {
        throw ParseError { kind = ParseErrorKind.Invalid }
    }
    let year = twoDigitsAt(cs, 0) * 100 + twoDigitsAt(cs, 2)
    let month = twoDigitsAt(cs, 5)
    let day = twoDigitsAt(cs, 8)
    return try Date.of(year, month, day) catch (_: TimeError) throw ParseError { kind = ParseErrorKind.Invalid }
}

private fn twoDigitsAt(cs: List<char>, at: int): int {
    if (!isDigit(cs[at]) || !isDigit(cs[at + 1])) {
        throw ParseError { kind = ParseErrorKind.Invalid }
    }
    return ((cs[at] as int) - 48) * 10 + ((cs[at + 1] as int) - 48)
}

/// An offset as RFC 3339 writes it, `Z` for none.
private fn offsetText(off: int): string {
    if (off == 0) {
        return "Z"
    }
    let minutes = (if (off < 0) -off else off) / 60000000000
    let sign = if (off < 0) "-" else "+"
    return f"{sign}{twoDigits(minutes / 60)}:{twoDigits(minutes % 60)}"
}

private fn twoDigits(n: int): string = if (n < 10) f"0{n}" else f"{n}"

/// The year as four digits at least, with a sign where it is outside 0000–9999 (ISO 8601's expanded form).
private fn yearText(y: int): string {
    var text = f"{if (y < 0) -y else y}"
    while (text.length() < 4) {
        text = "0" + text
    }
    return if (y < 0) "-" + text else if (y > 9999) "+" + text else text
}

private fn isLeap(y: int): bool = y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)

private fn daysIn(year: int, month: int): int = match (month) {
    2 => if (isLeap(year)) 29 else 28,
    4 | 6 | 9 | 11 => 30,
    _ => 31,
}

private fn floorRem(a: int, b: int): int {
    let r = a % b
    return if (r < 0) r + b else r
}

/// The days from 1970-01-01 to `date` (Hinnant's days_from_civil).
private fn daysOf(date: Date): int {
    let y = if (date.m <= 2) date.y - 1 else date.y
    let era = (if (y >= 0) y else y - 399) / 400
    let yearOfEra = y - era * 400
    let dayOfYear = (153 * (if (date.m > 2) date.m - 3 else date.m + 9) + 2) / 5 + date.d - 1
    let dayOfEra = yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear
    return era * 146097 + dayOfEra - 719468
}

/// The date `days` after 1970-01-01 (Hinnant's civil_from_days).
private fn fromDays(days: int): Date {
    let z = days + 719468
    let era = (if (z >= 0) z else z - 146096) / 146097
    let dayOfEra = z - era * 146097
    let yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
    let dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
    let mp = (5 * dayOfYear + 2) / 153
    let day = dayOfYear - (153 * mp + 2) / 5 + 1
    let month = if (mp < 10) mp + 3 else mp - 9
    let year = yearOfEra + era * 400 + (if (month <= 2) 1 else 0)
    return Date { y = year, m = month, d = day }
}

/// A zone the host reads, by `how` (0 the database's, 1 a TZif file's bytes, 2 a POSIX rule's text, 3 the
/// system's).
private fn openZone(how: int, name: string, text: string, bytes: ?Any): Zone {
    let holder = [""]
    let handle = zoneNew()
    let n = zoneOpen(how, holder, handle, name, text, bytes ?? handle)
    if (n == 1) {
        return Zone.utc
    }
    if (n < 0) {
        let kind = if (n == -2) TimeErrorKind.NoZoneData else if (n == -3) TimeErrorKind.NoSuchZone else TimeErrorKind.Invalid
        throw TimeError { detail = holder[0], kind = kind }
    }
    return Zone { label = holder[0], off = 0, rules = handle }
}

/// The offset of `zone` in nanoseconds at the moment `ns` nanoseconds after 1970.
private fn offsetNanosAt(zone: Zone, ns: int): int {
    if (let handle = zone.rules) {
        return floorDiv(zoneAt(ns, handle, [""]), 2) * 1000000000
    }
    return zone.off
}

/// The offset of `zone` in seconds at the second `secs` after 1970: beyond an `Instant`'s moments the count
/// overflows (`LYS-RT0002`).
private fn offsetSecsAt(zone: Zone, secs: int): int {
    if (let handle = zone.rules) {
        return floorDiv(zoneAt(secs * 1000000000, handle, [""]), 2)
    }
    return zone.off / 1000000000
}

/// The fixed zone of an offset in nanoseconds, UTC for none.
private fn fixedOf(off: int): Zone {
    if (off == 0) {
        return Zone.utc
    }
    return Zone { label = offsetText(off), off = off }
}
