// The code generator: checked programs run in the VM and give what the language says — the
// arithmetic, the widening, the loops, short-circuits, structs and classes, the globals, the
// natives, and the script's panics — with the registers given back as the S1 convention needs.
import std.collections { List };
import std.test { assertEq, assertTrue };
import lyric_script.compiler.checker { checkModule };
import lyric_script.compiler.codegen { generate };
import lyric_script.compiler.parser { parse };
import lyric_script.vm.asm { disassemble };
import lyric_script.vm.interp { Outcome, run };
import lyric_script.vm.module { Module, check };

fn compiled(source: string): Module {
    let parsed = parse(source);
    assertEq(parsed.errors.length(), 0, "the source parses");
    let checked = checkModule(parsed.module);
    for (e in checked.errors) {
        assertEq(e.message, "", "the source checks");
    }
    let module = generate(checked.program, "test");
    assertEq(check(module).length(), 0, "the module is sound");
    return module;
}

/// Runs function `entry` of the script and gives its int result.
fn value(source: string, entry: string): int {
    return match (run(compiled(source), entry, [], -1)) {
        .Scalar(bits) => bits as int,
        _ => -999,
    };
}

fn floatResult(source: string, entry: string): float {
    return match (run(compiled(source), entry, [], -1)) {
        .Scalar(bits) => float.fromBits(bits),
        _ => -999.0,
    };
}

/// The disassembly of the functions of `source` named in `names`, without the prelude's.
fn codeOf(source: string, names: string[]): string {
    let out = List<string>.new();
    var inside = false;
    for (line in disassemble(compiled(source)).split("\n")) {
        if (line.startsWith("fn ")) {
            inside = false;
            for (n in names) {
                if (line.startsWith(f"fn {n}(")) {
                    inside = true;
                }
            }
        }
        if (inside) {
            out.push(line.toString());
        }
    }
    return out.toArray().join("\n");
}

fn panicCode(source: string, entry: string): string {
    return match (run(compiled(source), entry, [], -1)) {
        .Panic(p) => p.code,
        _ => "none",
    };
}

@Test
fn arithmeticAndItsPrecedence(): void {
    assertEq(value("fn f(): int = 7 / 2 + 7 % 3 * 10", "f"), 13);
    assertEq(floatResult("fn g(): float = 1 + 2.5", "g"), 3.5);
    assertEq(value("fn w(): int = 9223372036854775807 +% 1", "w"), -9223372036854775807 - 1);
    assertEq(value("fn b(): int = (6 & 3) | (1 << 4) ^ 1", "b"), 19);
    assertEq(value("fn s(): int = -16 >> 2", "s"), -4);
    assertEq(value("fn ca(): int = (3.9 as int) + ('A' as int)", "ca"), 68);
}

@Test
fn comparisonsAndShortCircuits(): void {
    assertEq(value("fn c(): int = if (3 > 2 && 2 >= 2 && !(1 > 2)) 1 else 0", "c"), 1);
    assertEq(
        value("fn t(): int = if (\"ab\" + \"c\" == \"abc\" && \"a\" < \"b\") 1 else 0", "t"),
        1
    );
    let hits = "var hits = 0\nfn hit(): bool {\n    hits += 1\n    return true\n}\n";
    assertEq(
        value(
            hits
                + "fn sc(): int {\n    if (false && hit()) {\n    }\n    if (true || hit()) {\n    }\n    return hits\n}",
            "sc"
        ),
        0
    );
    assertEq(
        value(
            hits + "fn ac(): int {\n    var b = false\n    b &&= hit()\n    return hits\n}",
            "ac"
        ),
        0
    );
}

@Test
fn loops(): void {
    assertEq(
        value(
            "fn sum(): int {\n    var s = 0\n    for (i in 1..=100) {\n        s += i\n    }\n    return s\n}",
            "sum"
        ),
        5050
    );
    assertEq(
        value(
            "fn sum(): int {\n    var s = 0\n    for (i in 1..101) {\n        s += i\n    }\n    return s\n}",
            "sum"
        ),
        5050
    );
    let odd = "fn odd(): int {\n    var s = 0\n    var i = 0\n    while (i < 20) {\n        i += 1\n        if (i % 2 == 0 || i == 5) {\n            continue\n        }\n        if (i > 10) {\n            break\n        }\n        s += i\n    }\n    return s\n}";
    assertEq(value(odd, "odd"), 20);
    let lv = "fn lv(): int {\n    var i = 0\n    let v = loop {\n        i += 1\n        if (i == 7) {\n            break i * 6\n        }\n    }\n    return v\n}";
    assertEq(value(lv, "lv"), 42);
    // `..=` up to int's last value ends without overflow
    assertEq(
        value(
            "fn top(): int {\n    var n = 0\n    for (i in 9223372036854775806..=9223372036854775807) {\n        n += 1\n    }\n    return n\n}",
            "top"
        ),
        2
    );
}

@Test
fn recursion(): void {
    let fib = "fn fib(n: int): int {\n    if (n < 2) {\n        return n\n    }\n    return fib(n - 1) + fib(n - 2)\n}\nfn fib20(): int = fib(20)";
    assertEq(value(fib, "fib20"), 6765);
}

@Test
fn structsAndClasses(): void {
    let p = "struct P {\n    x: int\n    y: int\n}\n";
    assertEq(
        value(p + "fn f(): int {\n    let a = P { x = 3, y = 4 }\n    return a.x * a.y\n}", "f"),
        12
    );
    // an initializer that reads the binding it is stored to
    assertEq(
        value(
            p
                + "fn g(): int {\n    var a = P { x = 1, y = 2 }\n    a = P { x = a.y, y = a.x }\n    return a.x * 10 + a.y\n}",
            "g"
        ),
        21
    );
    let v = "struct V {\n    x: int\n    static fn new(x: int): V = V { x = x * 2 }\n    fn twice(): int = this.x * 2\n}\nfn v(): int = V(5).twice()";
    assertEq(value(v, "v"), 20);
    let c = "class C {\n    var n: int = 0\n    var name: string = \"c\"\n    fn inc() {\n        this.n += 1\n        this.name += \"+\"\n    }\n}\n";
    assertEq(
        value(
            c
                + "fn h(): int {\n    let c = C { }\n    c.inc()\n    c.inc()\n    c.inc()\n    return if (c.name == \"c+++\") c.n else -1\n}",
            "h"
        ),
        3
    );
}

@Test
fn aBindingThatReadsItselfIsSafe(): void {
    assertEq(
        value(
            "fn al(): int {\n    var x = 1\n    x = if (x == 1) x + 10 else 0\n    return x\n}",
            "al"
        ),
        11
    );
    assertEq(
        value(
            "fn bo(): int {\n    var b = true\n    b = false || b\n    return if (b) 1 else 0\n}",
            "bo"
        ),
        1
    );
}

@Test
fn globals(): void {
    // `g` runs on its own, so it sets the globals itself: the script's code does not run first
    let g = "var total = 0\nvar label = \"\"\nfn add(n: int) {\n    total += n\n    label += \"+\"\n}\nfn g(): int {\n    total = 10\n    label = \"x\"\n    add(2)\n    add(5)\n    return if (label == \"x++\") total else -1\n}";
    assertEq(value(g, "g"), 17);
}

@Test
fn theNativesWriteText(): void {
    assertEq(
        value(
            "fn fs(): int = if (f\"{1 + 1}-{2.5}-{true}-{'c'}\" == \"2-2.5-true-c\") 1 else 0",
            "fs"
        ),
        1
    );
    assertEq(value("fn fd(): int = if (f\"{21.0}\" == \"21.0\") 1 else 0", "fd"), 1);
}

@Test
fn theScriptsPanics(): void {
    assertEq(panicCode("fn d(): int {\n    let z = 0\n    return 1 / z\n}", "d"), "LYS-RT0001");
    assertEq(
        panicCode("fn o(): int {\n    let m = 9223372036854775807\n    return m + 1\n}", "o"),
        "LYS-RT0002"
    );
    assertEq(panicCode("fn sh(): int {\n    let n = 64\n    return 1 << n\n}", "sh"), "LYS-RT0002");
    assertEq(
        panicCode("fn ch(): int {\n    let n = -1\n    return (n as char) as int\n}", "ch"),
        "LYS-RT0009"
    );
}

@Test
fn registersAreGivenBack(): void {
    // `*` has no immediate form, so the constant takes a register, and it is given back
    let text = disassemble(compiled("fn mul3(x: int) = x * 3"));
    assertTrue(
        text.contains(
            "fn mul3(s) -> s regs 3 0\n    load.i s2, 3\n    mul.i s1, s0, s2\n    ret.s s1\n"
        ),
        text
    );
}

@Test
fn aLoopOfWhileLowersAsARangesDoes(): void {
    // S7k1b: the assignments as statements copy their value nowhere, `i += 1` is `add.imm`, the
    // test is one fused jump
    let text = codeOf(
        "fn up(n: int): int {\n    var s = 0\n    var i = 0\n    while (i < n) {\n        s = s + i\n        i += 1\n    }\n    return s\n}",
        ["up"]
    );
    assertTrue(text.contains("fn up("), text);
    assertTrue(text.contains("    add.imm s"), text);
    assertTrue(text.contains("    jump.lt.i s"), text);
    assertTrue(!text.contains("    move.s "), text);
    assertTrue(!text.contains("    lt.i "), text);
    assertTrue(!text.contains("    jump.if "), text);
    assertEq(
        value(
            "fn up(n: int): int {\n    var s = 0\n    var i = 0\n    while (i < n) {\n        s = s + i\n        i += 1\n    }\n    return s\n}\nfn f(): int = up(101)",
            "f"
        ),
        5050
    );
}

@Test
fn everyComparisonJumpsBothWays(): void {
    // each test as an `if` (jumps where false) and as a `while` (jumps where true), at the
    // boundaries, on ints and on chars
    let src = "fn bits(a: int, b: int): int {\n    var r = 0\n    if (a < b) {\n        r += 1\n    }\n    if (a <= b) {\n        r += 2\n    }\n    if (a > b) {\n        r += 4\n    }\n    if (a >= b) {\n        r += 8\n    }\n    var n = 0\n    while (a < b && n == 0) {\n        n = 16\n    }\n    r += n\n    n = 0\n    while (a <= b && n == 0) {\n        n = 32\n    }\n    r += n\n    n = 0\n    while (a > b) {\n        n = 64\n        break\n    }\n    r += n\n    n = 0\n    while (a >= b) {\n        n = 128\n        break\n    }\n    return r + n\n}\nfn cbits(a: char, b: char): int {\n    var r = 0\n    if (a < b) {\n        r += 1\n    }\n    if (a >= b) {\n        r += 8\n    }\n    return r\n}\n";
    let calls = "fn lt(): int = bits(1, 2)\nfn eq(): int = bits(2, 2)\nfn gt(): int = bits(3, 2)\nfn neg(): int = bits(-9223372036854775807 - 1, 9223372036854775807)\nfn cl(): int = cbits('a', 'b')\nfn cg(): int = cbits('b', 'a')";
    // < 1, <= 2, > 4, >= 8, while < 16, while <= 32, while > 64, while >= 128
    assertEq(value(src + calls, "lt"), 1 + 2 + 16 + 32);
    assertEq(value(src + calls, "eq"), 2 + 8 + 32 + 128);
    assertEq(value(src + calls, "gt"), 4 + 8 + 64 + 128);
    assertEq(value(src + calls, "neg"), 1 + 2 + 16 + 32);
    assertEq(value(src + calls, "cl"), 1);
    assertEq(value(src + calls, "cg"), 8);
    let text = codeOf(src, ["bits", "cbits"]);
    assertTrue(text.contains("    jump.le.i s"), text);
    assertTrue(text.contains("    jump.lt.i s"), text);
}

@Test
fn aConstantStepIsAnImmediate(): void {
    // at the edges of the 16-bit immediate, and just past them (then a register)
    let src = "fn a(x: int): int = x + 32767\nfn b(x: int): int = x + 32768\nfn c(x: int): int = x - 32768\nfn d(x: int): int = x - 32769\nfn e(x: int): int = 5 + x\nfn g(x: int): int = x - -32768\nfn h(x: int): int {\n    var y = x\n    y -= 32768\n    y += 7\n    return y\n}\n";
    let calls = "fn ta(): int = a(1)\nfn tb(): int = b(1)\nfn tc(): int = c(1)\nfn td(): int = d(1)\nfn te(): int = e(1)\nfn tg(): int = g(1)\nfn th(): int = h(1)";
    assertEq(value(src + calls, "ta"), 32768);
    assertEq(value(src + calls, "tb"), 32769);
    assertEq(value(src + calls, "tc"), -32767);
    assertEq(value(src + calls, "td"), -32768);
    assertEq(value(src + calls, "te"), 6);
    assertEq(value(src + calls, "tg"), 32769);
    assertEq(value(src + calls, "th"), -32760);
    let text = codeOf(src, ["a", "b", "c", "d", "e", "g", "h"]);
    assertTrue(text.contains("add.imm s1, s0, 32767"), text);
    assertTrue(text.contains("add.imm s1, s0, -32768"), text);
    assertTrue(!text.contains("add.imm s1, s0, 32768"), text);
    // the step overflows as the addition does
    assertEq(
        panicCode(
            "fn o(): int {\n    var m = -9223372036854775807 - 1\n    m -= 1\n    return m\n}",
            "o"
        ),
        "LYS-RT0002"
    );
    assertEq(
        panicCode("fn p(): int {\n    let m = 9223372036854775807\n    return 1 + m\n}", "p"),
        "LYS-RT0002"
    );
}

@Test
fn aConstantConditionJumpsAlwaysOrNever(): void {
    let src = "fn w(): int {\n    var n = 0\n    while (true) {\n        n += 1\n        if (n >= 5) {\n            break\n        }\n    }\n    if (false) {\n        n = 100\n    }\n    if (true) {\n        n += 10\n    } else {\n        n = 200\n    }\n    var k = 0\n    do {\n        k += 1\n    } while (k < 3)\n    while (false) {\n        n = 300\n    }\n    return n + k\n}";
    assertEq(value(src, "w"), 18);
    let text = codeOf(src, ["w"]);
    assertTrue(text.contains("fn w("), text);
    assertTrue(!text.contains("    jump.if "), text);
    assertTrue(!text.contains("    jump.ifnot "), text);
}

@Test
fn aMatchOfManyArmsRuns(): void {
    // its arms lower to a chain of conditions the code generator walks in one frame (S7e1: four
    // hundred overflowed a thread's stack, a frame for each), in a copy of a generic too
    let parts = List<string>.new();
    parts.push("fn arm<T>(x: T, n: int): int = match (n) {");
    var k = 0;
    while (k < 400) {
        parts.push("    " + f"{k}" + " => " + f"{k}" + ",");
        k += 1;
    }
    parts.push("    _ => -1,");
    parts.push("}");
    parts.push("fn f(): int = arm(1, 399) + arm(\"s\", 398)");
    assertEq(value(parts.toArray().join("\n"), "f"), 797);
}
