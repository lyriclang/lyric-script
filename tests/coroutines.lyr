// Coroutines in the VM (S6b; Lyric 5 10 §1; Script 07 N2, N3): hand-written programs make
// coroutines of closures, pull them to their yields and their end, read their results, and get
// the error that left a body from the pull that ran into it; a wait inside one parks its task.
import std.collections { List };
import std.test { assertEq, assertTrue };
import lyric_script.compiler.checker { checkModule };
import lyric_script.compiler.codegen { generate };
import lyric_script.compiler.parser { parse };
import lyric_script.vm.asm { assemble };
import lyric_script.vm.interp { Outcome, execute, run };

fn runText(text: string): Outcome {
    return execute(try! assemble(text, "t"), "main", [], -1);
}

fn scalar(o: Outcome): int {
    return match (o) {
        .Scalar(bits) => bits as int,
        .Panic(p) => -1000,
        _ => -999999,
    };
}

fn panicCode(o: Outcome): string {
    return match (o) {
        .Panic(p) => p.code,
        _ => "no panic",
    };
}

// a function value: its function's index, and a box it shares; `co.new`'s 256 is one scalar
let types: string = """
    type Fn scalar f ref box
    type Box scalar n
    type Oops
    """;

@Test
fn aCoroutineYieldsItsValuesThenEnds(): void {
    // each pull runs to the next yield; after the end, every pull answers that none came
    let text = types
        + "\n"
        + """
        fn gen(r) regs 1 1
            load.i s0, 1
            yield.v s0, r0
            load.i s0, 2
            yield.v s0, r0
            load.i s0, 3
            yield.v s0, r0
            ret
        end

        fn main() -> s regs 8 3
            new r0, Fn
            load.i s0, 0
            set.s r0, Fn.f, s0
            co.new r1, r0, 256
            load.i s5, 0
            load.i s6, 10
        again:
            co.next s1, r2, r1
            jump.ifnot s3, @done
            mul.i s5, s5, s6
            add.i s5, s5, s2
            jump @again
        done:
            co.next s1, r2, r1
            mul.i s5, s5, s6
            add.i s5, s5, s3
            co.done s4, r1
            mul.i s5, s5, s6
            add.i s5, s5, s4
            ret.s s5
        end
        """;
    assertEq(scalar(runText(text)), 12301);
}

@Test
fn aCoroutineKeepsItsLocalsAndGivesItsResult(): void {
    // the body's registers live across its yields; its return is the result, none before
    let text = types
        + "\n"
        + """
        fn gen(r) -> s regs 2 1
            load.i s0, 0
            load.i s1, 3
        more:
            add.imm s0, s0, 1
            yield.v s0, r0
            jump.lt.i s0, s1, @more
            load.i s1, 100
            mul.i s0, s0, s1
            ret.s s0
        end

        fn main() -> s regs 9 3
            new r0, Fn
            load.i s0, 0
            set.s r0, Fn.f, s0
            co.new r1, r0, 256
            co.res s4, r2, r1
            move.s s7, s5
            load.i s6, 0
        again:
            co.next s1, r2, r1
            jump.ifnot s3, @done
            add.i s6, s6, s2
            jump @again
        done:
            co.res s4, r2, r1
            load.i s8, 1000
            mul.i s6, s6, s8
            add.i s6, s6, s4
            load.i s8, 10000
            mul.i s5, s5, s8
            add.i s6, s6, s5
            load.i s8, 10
            mul.i s8, s8, s8
            mul.i s8, s8, s8
            mul.i s7, s7, s8
            add.i s6, s6, s7
            ret.s s6
        end
        """;
    // 1 + 2 + 3 = 6 thousands, the result 300, its presence after (10000), none before
    assertEq(scalar(runText(text)), 16300);
}

@Test
fn anErrorLeavesTheBodyThroughThePullThatRanIntoIt(): void {
    // `s[a]` 1 and the error where the value would be; the coroutine has ended, with no result
    let text = types
        + "\n"
        + """
        fn gen(r) regs 1 2
            load.i s0, 1
            yield.v s0, r0
            new r1, Oops
            throw r1
        end

        fn main() -> s regs 10 4
            new r0, Fn
            load.i s0, 0
            set.s r0, Fn.f, s0
            co.new r1, r0, 256
            co.next s1, r2, r1
            co.next s4, r2, r1
            co.next s5, r2, r1
            co.res s8, r2, r1
            load.i s9, 10
            mul.i s2, s2, s9
            add.i s2, s2, s4
            mul.i s2, s2, s9
            add.i s2, s2, s7
            mul.i s2, s2, s9
            add.i s2, s2, s8
            ret.s s2
        end
        """;
    // the value 1, the error (1), then an end with no value (0), and no result (0)
    assertEq(scalar(runText(text)), 1100);
}

@Test
fn aCoroutinePulledWhileItRunsPanics(): void {
    let text = types
        + "\n"
        + """
        fn gen(r) regs 1 3
            get.r r1, r0, Fn.box
            co.next s0, r1, r1
            ret
        end

        fn main() regs 4 4
            new r0, Fn
            load.i s0, 0
            set.s r0, Fn.f, s0
            co.new r1, r0, 256
            set.r r0, Fn.box, r1
            co.next s1, r2, r1
            ret
        end
        """;
    assertEq(panicCode(runText(text)), "LYS-RT0014");
}

@Test
fn aYieldWhereNoCoroutineRunsPanics(): void {
    let text = """
        fn main() regs 1 1
            load.i s0, 1
            yield.v s0, r0
            ret
        end
        """;
    assertEq(panicCode(runText(text)), "LYS-RT0014");
}

@Test
fn aWaitInACoroutineParksItsTask(): void {
    // the coroutine gives way as a task does (07 N3): the other task runs, then the pull goes on
    let text = types
        + "\n"
        + """
        fn gen(r) regs 1 2
            yield
            get.r r1, r0, Fn.box
            get.s s0, r1, Box.n
            yield.v s0, r0
            ret
        end

        fn work(r) regs 1 2
            get.r r1, r0, Fn.box
            load.i s0, 7
            set.s r1, Box.n, s0
            ret
        end

        fn main() -> s regs 4 6
            new r1, Box
            new r0, Fn
            load.i s0, 1
            set.s r0, Fn.f, s0
            set.r r0, Fn.box, r1
            spawn r2, r0
            new r0, Fn
            load.i s0, 0
            set.s r0, Fn.f, s0
            set.r r0, Fn.box, r1
            co.new r3, r0, 256
            co.next s1, r4, r3
            ret.s s2
        end
        """;
    assertEq(scalar(runText(text)), 7);
}

@Test
fn aPanicInACoroutinePanicsItsTask(): void {
    let text = types
        + "\n"
        + """
        fn gen(r) regs 2 1
            load.i s0, 1
            load.i s1, 0
            div.i s0, s0, s1
            yield.v s0, r0
            ret
        end

        fn main() -> s regs 4 3
            new r0, Fn
            load.i s0, 0
            set.s r0, Fn.f, s0
            co.new r1, r0, 256
            co.next s1, r2, r1
            ret.s s2
        end
        """;
    match (runText(text)) {
        .Panic(p) => assertTrue(p.message.contains("zero"), p.message),
        _ => assertTrue(false, "the panic reaches the task"),
    }
}

// The language (S6b): coroutine functions, `yield`, `return` as the result, `next()`,
// `result()`, `isDone()`.
fn errs(source: string): string[] {
    let parsed = parse(source);
    let out = List<string>.new();
    for (e in parsed.errors) {
        out.push(e.code);
    }
    for (e in checkModule(parsed.module).errors) {
        out.push(e.code);
    }
    return out.toArray();
}

fn value(source: string, entry: string): int {
    let checked = checkModule(parse(source).module);
    for (e in checked.errors) {
        assertEq(e.message, "", "the source checks");
    }
    return match (run(generate(checked.program, "t"), entry, [], -1)) {
        .Scalar(bits) => bits as int,
        _ => -999,
    };
}

let count: string = "fn count(n: int): Coroutine<int> {\n    var i = 0\n    while (i < n) {\n        i += 1\n        yield i\n    }\n}\n";

@Test
fn aCoroutineFunctionYieldsThroughNext(): void {
    let f = "fn f(): int {\n    let c = count(3)\n    var s = 0\n    while (let v = c.next()) {\n        s += v\n    }\n    return s\n}";
    assertEq(value(count + f, "f"), 6);
}

@Test
fn aCallRunsNothingOfTheBody(): void {
    let src = "class B {\n    var n: int = 0\n}\nfn g(b: B): Coroutine<int> {\n    b.n = 1\n    yield 0\n}\n"
        + "fn f(): int {\n    let b = B { }\n    let c = g(b)\n    let before = b.n\n    c.next()\n    return before * 10 + b.n\n}";
    assertEq(value(src, "f"), 1);
}

@Test
fn theResultComesWithTheReturn(): void {
    let src = "fn g(): Coroutine<int, int> {\n    yield 1\n    return 7\n}\n"
        + "fn f(): int {\n    let c = g()\n    let before = c.result() ?? -1\n    c.next()\n    c.next()\n    return before * 100 + (c.result() ?? -1)\n}";
    assertEq(value(src, "f"), -93);
}

@Test
fn aFactoryAndTheEmptyBody(): void {
    // a function that returns a value is ordinary; one whose body neither yields nor returns a
    // value is the empty coroutine
    let src = count
        + "fn make(): Coroutine<int> {\n    return count(2)\n}\nfn empty(): Coroutine<int> {\n}\n"
        + "fn f(): int {\n    let e = empty()\n    let gone = e.next() == null && e.isDone()\n    return (make().next() ?? 0) + (if (gone) 10 else 0)\n}";
    assertEq(value(src, "f"), 11);
}

@Test
fn aCoroutinesBodyIsChecked(): void {
    assertEq(errs("fn f(): Coroutine<int> {\n    yield\n}"), ["LYS-SEM0038"]);
    assertEq(errs("fn f(): Coroutine<int> {\n    yield 1\n    return 2\n}"), ["LYS-SEM0039"]);
    assertEq(errs("fn f(): Coroutine<int> {\n    yield \"x\"\n}"), ["LYS-SEM0001"]);
    assertEq(
        errs(
            "fn f(b: bool): Coroutine<int, int> {\n    yield 1\n    if (b) {\n        return 2\n    }\n}"
        ),
        ["LYS-SEM0017"]
    );
    assertEq(
        errs(
            "fn f(): Coroutine<int> {\n    yield 1\n}\nfn g(): ?int {\n    return f().result()\n}"
        ),
        ["LYS-SEM0012"]
    );
}

@Test
fn aYieldOfItsOwnMakesTheCoroutineFunction(): void {
    // a yield in a lambda is the lambda's (S6b2): the function that returns a value stays a factory
    assertEq(errs("fn f() {\n    yield 1\n}"), ["LYS-NYI0001"]);
    assertEq(
        errs(
            count
                + "fn f(): Coroutine<int> {\n    let g = () => {\n        yield 1\n    }\n    return count(1)\n}"
        ),
        ["LYS-NYI0001"]
    );
}

@Test
fn aPullThrowsAnyError(): void {
    // the coroutine's type carries no `throws` (03)
    let a = "struct A :: Error {\n    fn message(): string = \"a\"\n}\n";
    assertEq(
        errs(
            a + count + "fn f(): int throws A {\n    let c = count(1)\n    return c.next() ?? 0\n}"
        ),
        ["LYS-SEM0034"]
    );
}
