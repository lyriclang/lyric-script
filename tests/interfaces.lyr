// Interfaces (S3f, Lyric 5 05 §1–§4, §11): declarations, conformance in a type's list, defaults
// that call through `this` again, interface values and the calls through them (`call.i`), a
// child interface's value as a parent's — run in the VM.
import std.test { assertEq };
import lyric_script.compiler.checker { checkModule };
import lyric_script.compiler.codegen { generate };
import lyric_script.compiler.parser { parse };
import lyric_script.vm.interp { run };
import lyric_script.vm.module { Module, check };
import std.collections { List };

fn compiled(source: string): Module {
    let parsed = parse(source);
    for (e in parsed.errors) {
        assertEq(e.message, "", "the source parses");
    }
    let checked = checkModule(parsed.module);
    for (e in checked.errors) {
        assertEq(e.message, "", "the source checks");
    }
    let module = generate(checked.program, "test");
    for (fault in check(module)) {
        assertEq(fault.message, "", "the module is sound");
    }
    return module;
}

fn value(source: string, entry: string): int {
    return match (run(compiled(source), entry, [], -1)) {
        .Scalar(bits) => bits as int,
        _ => -999,
    };
}

fn errs(source: string): string[] {
    let parsed = parse(source);
    let out = List<string>.new();
    for (e in parsed.errors) {
        out.push(e.code);
    }
    for (e in checkModule(parsed.module).errors) {
        out.push(e.code);
    }
    return out.toArray();
}

let shapes = "interface Shape {\n    fn area(): int\n    fn describe(): string {\n        return if (this.area() > 10) \"big\" else \"small\"\n    }\n}\nstruct Sq :: [Shape] {\n    side: int\n    fn area(): int = this.side * this.side\n}\nclass Box :: Shape {\n    var w: int = 1\n    var h: int = 1\n    fn area(): int = this.w * this.h\n    fn describe(): string = \"box\"\n}\n";

@Test
fn aCallThroughAnInterfaceRunsTheConformersMethod(): void {
    assertEq(
        value(
            shapes
                + "fn total(a: Shape, b: Shape): int = a.area() + b.area()\nfn t(): int = total(Sq { side = 3 }, Box { w = 2, h = 5 })",
            "t"
        ),
        19
    );
}

@Test
fn aDefaultCallsThroughThisAgain(): void {
    let d = "fn d(): int {\n    let s: Shape = Sq { side = 4 }\n    let b: Shape = Box { }\n    return (if (s.describe() == \"big\") 1 else 0) + (if (b.describe() == \"box\") 10 else 0)\n}";
    assertEq(value(shapes + d, "d"), 11);
    // a default called on the conformer itself
    assertEq(
        value(shapes + "fn c(): int = if (Sq { side = 1 }.describe() == \"small\") 1 else 0", "c"),
        1
    );
}

@Test
fn aChildsValueIsAParentsValue(): void {
    let pets = "interface Named {\n    fn name(): string\n}\ninterface Pet :: [Named] {\n    fn sound(): string\n}\nstruct Dog :: [Pet] {\n    fn name(): string = \"rex\"\n    fn sound(): string = \"woof\"\n}\nfn greet(n: Named): string = n.name()\n";
    assertEq(
        value(
            pets
                + "fn p(): int {\n    let pet: Pet = Dog { }\n    return if (greet(pet) == \"rex\" && pet.sound() == \"woof\") 1 else 0\n}",
            "p"
        ),
        1
    );
}

@Test
fn whatConformanceRefuses(): void {
    let i = "interface I {\n    fn m(): int\n}\n";
    assertEq(errs(i + "struct S :: [I] {\n    x: int\n}"), ["LYS-SEM0020"]);
    assertEq(errs(i + "struct S :: [I] {\n    fn m(): string = \"a\"\n}"), ["LYS-SEM0042"]);
    assertEq(errs("struct P {\n    x: int\n}\nstruct S :: [P] {\n    y: int\n}"), ["LYS-SEM0078"]);
    assertEq(errs(i + "fn f(a: I, b: I): bool = a == b"), ["LYS-SEM0059"]);
}

@Test
fn builtInValuesAndPlainEnumsConformThroughABox(): void {
    let src = "interface Named {\n    fn name(): string\n    fn shout(): string = this.name() + \"!\"\n}\nextend int :: [Named] {\n    fn name(): string = if (this > 0) \"pos\" else \"neg\"\n}\nextend string {\n    fn twice(): string = this + this\n}\nenum Color :: [Named] {\n    Red, Green\n    fn name(): string = match (this) {\n        .Red => \"red\",\n        .Green => \"green\",\n    }\n}\nfn label(n: Named): string = n.name()\n";
    let b = "fn b(): int = (if (label(5) == \"pos\") 1 else 0) + (if (label(Color.Green) == \"green\") 10 else 0) + (if (\"ab\".twice() == \"abab\") 100 else 0) + (if ((-3).shout() == \"neg!\") 1000 else 0)";
    assertEq(value(src + b, "b"), 1111);
    // values held as interface values, called later: the box's value is what `this` reads
    let num = "interface Num {\n    fn twice(): int\n}\nextend int :: [Num] {\n    fn twice(): int = this * 2\n}\nfn h(): int {\n    let a: Num = 21\n    let b: Num = 100\n    let c = 7 + 8\n    return a.twice() + b.twice() + c\n}";
    assertEq(value(num, "h"), 257);
}

let shapes2 = "interface Shape {\n    fn area(): int\n}\nstruct Sq :: [Shape] {\n    side: int\n    fn area(): int = this.side * this.side\n}\nstruct Rect :: [Shape] {\n    w: int\n    h: int\n    fn area(): int = this.w * this.h\n}\n";

@Test
fn isNarrowsAndTypePatternsBind(): void {
    // where `s is Sq` holds, `s` is the struct
    let sides = "fn sides(s: Shape): int {\n    if (s is Sq) {\n        return s.side\n    }\n    return -1\n}\nfn i(): int = sides(Sq { side = 7 }) * 10 + sides(Rect { w = 1, h = 2 })";
    assertEq(value(shapes2 + sides, "i"), 69);
    // type patterns over an open interface, with `_` for the rest
    let kind = "fn kind(s: Shape): int = match (s) {\n    q: Sq => q.side,\n    r: Rect => r.w + r.h,\n    _ => 0,\n}\nfn k(): int = kind(Sq { side = 4 }) * 100 + kind(Rect { w = 2, h = 3 })";
    assertEq(value(shapes2 + kind, "k"), 405);
    // `Any` holds everything; `is` takes a box's value out again
    let any = "fn a(): int {\n    let xs: Any = 41\n    let ys: Any = \"s\"\n    var n = 0\n    if (xs is int) {\n        n = xs + 1\n    }\n    if (ys is string) {\n        n += 100\n    }\n    if (xs is string) {\n        n += 1000\n    }\n    return n\n}";
    assertEq(value(any, "a"), 142);
}

@Test
fn aSealedInterfaceIsCoveredByItsConformers(): void {
    let sealed = "sealed interface Shape {\n    fn area(): int\n}\nstruct Sq :: [Shape] {\n    side: int\n    fn area(): int = this.side\n}\nstruct Rect :: [Shape] {\n    w: int\n    fn area(): int = this.w\n}\n";
    assertEq(
        value(
            sealed
                + "fn k(s: Shape): int = match (s) {\n    _: Sq => 1,\n    _: Rect => 2,\n}\nfn kk(): int = k(Sq { side = 1 }) * 10 + k(Rect { w = 1 })",
            "kk"
        ),
        12
    );
    assertEq(
        errs(sealed + "fn k(s: Shape): int = match (s) {\n    _: Sq => 1,\n}"),
        ["LYS-SEM0050"]
    );
    // `is` asks an interface value only
    assertEq(errs("let n = 3\nprintln(n is int)"), ["LYS-SEM0131"]);
}

@Test
fn aConformanceByDelegationForwardsToTheField(): void {
    let src = "interface Walker {\n    fn walk(): int\n}\nstruct Legs :: [Walker] {\n    n: int\n    fn walk(): int = this.n * 10\n}\nclass Dog :: [Walker by legs] {\n    var legs: Legs\n    fn bark(): int = 1\n}\nfn w(x: Walker): int = x.walk()\n";
    // through the interface and on the type, the field read anew at each call
    let d = "fn d(): int {\n    let dog = Dog { legs = Legs { n = 4 } }\n    let a = w(dog)\n    dog.legs = Legs { n = 2 }\n    return a + dog.walk()\n}";
    assertEq(value(src + d, "d"), 60);
    assertEq(
        errs(
            "interface Walker {\n    fn walk(): int\n}\nclass Cat :: [Walker by paws] {\n    var n: int = 0\n}"
        ),
        ["LYS-SEM0123"]
    );
}

let qualified = "interface A {\n    fn d(): int = 1\n}\ninterface B {\n    fn d(): int = 2\n}\nstruct T :: [A, B] {\n    x: int\n\n    fn d(): int = 3\n}\nstruct U :: [A] {\n    x: int\n}\ninterface W {\n    fn walk(): int\n}\nstruct Dog :: [W] {\n    fn walk(): int = 4\n}\nfn viaT<X :: [W]>(x: X): int = W.walk(x)\n";

@Test
fn theQualifiedCallNamesTheInterface(): void {
    // the type's own member answers both interfaces; a default; through a type parameter and an
    // interface value
    let e = "fn e(): int {\n    let w: W = Dog { }\n    return T { x = 1 }.d() * 100000 + A.d(T { x = 1 }) * 10000 + A.d(U { x = 1 }) * 1000 + W.walk(Dog { }) * 100 + viaT(Dog { }) * 10 + W.walk(w)\n}";
    assertEq(value(qualified + e, "e"), 331444);
}

@Test
fn whatOneMethodSetRefuses(): void {
    // two defaults of one name the type does not write
    assertEq(errs(qualified + "struct S :: [A, B] {\n    x: int\n}"), ["LYS-SEM0043"]);
    // a receiver that does not conform, and none
    assertEq(errs(qualified + "let n = A.d(3)"), ["LYS-SEM0125"]);
    assertEq(errs(qualified + "let n = A.d()"), ["LYS-SEM0014"]);
    // a static member through its interface
    assertEq(
        errs("interface Make {\n    static fn make(n: int): Self\n}\nlet m = Make.make(1)"),
        ["LYS-SEM0231"]
    );
}

@Test
fn aCopyAtAScalarBoxesItForAnInterface(): void {
    // a type parameter's value where an interface is taken: a copy at an `int` or at an enum
    // without payloads boxes it (S4a; since S3g such a copy moved a scalar as a reference)
    let source = """
interface Show {
    fn show(): int
}
enum F :: Show {
    One
    fn show(): int = 1
}
extend int :: Show {
    fn show(): int = this * 10
}
fn describe(s: Show): int = s.show()
fn f<T :: [Show]>(x: T): int = describe(x)
fn t(): int = f(F.One) + f(4)
""";
    assertEq(value(source, "t"), 41);
}
