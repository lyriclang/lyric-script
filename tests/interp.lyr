// The interpreter: hand-written programs run to their results; overflow, division by zero, null,
// a too deep recursion and `panic` end as the script's panics with their codes and frames; the
// fuel stops a loop deterministically.
import std.fs { exists, readBytes, remove, removeAll, tempDir, tempFile, writeBytes };
import std.os { env, setEnv };
import std.path { join };
import std.test { assertEq, assertTrue };
import lyric_script.vm.asm { assemble };
import lyric_script.vm.heap { ScriptString };
import lyric_script.vm.interp { Outcome, ScriptPanic, execute, maxDepth };

fn runText(text: string, entry: string, args: uint64[], fuel: int): Outcome {
    return execute(try! assemble(text, "t"), entry, args, fuel);
}

fn scalar(o: Outcome): int {
    return match (o) {
        .Scalar(bits) => bits as int,
        _ => -999999,
    };
}

fn suspended(o: Outcome): bool {
    return match (o) {
        .Suspended => true,
        _ => false,
    };
}

fn panicOf(o: Outcome): ScriptPanic {
    return match (o) {
        .Panic(p) => p,
        _ => ScriptPanic { code = "none", message = "", trace = [] },
    };
}

let fib: string = """
    fn fib(s) -> s regs 4 0
        load.i s1, 2
        jump.lt.i s0, s1, @small
        add.imm s2, s0, -1
        call fib, s2, r0
        add.imm s3, s0, -2
        call fib, s3, r0
        add.i s0, s2, s3
        ret.s s0
    small:
        ret.s s0
    end
    """;

@Test
fn fibRuns(): void {
    assertEq(scalar(runText(fib, "fib", [20], -1)), 6765);
}

let sum: string = """
    fn sum(s) -> s regs 4 0
        load.i s1, 0
        load.i s2, 1
    loop:
        add.i s1, s1, s2
        add.imm s2, s2, 1
        le.i s3, s2, s0
        jump.if s3, @loop
        ret.s s1
    end
    """;

// What the natives of a `BigInt` cost (12 rule 16): `s0` a shift, so that `1 << s0` has `s0 / 32 + 1`
// words. The shift costs `1 + (w + 1) / 8`, the operation after it as its rule says; nothing else
// here takes budget. With exactly the sum it finishes, with a unit less it stops at the operation.
fn bigProgram(op: string): string {
    return f"""
    fn p(s) -> s regs 2 2
        load.i s1, 1
        call.n big.fromInt, s1, r0
        call.n big.shl, s0, r0
        move.r r1, r0
        {op}
        load.i s0, 7
        ret.s s0
    end
    """;
}

fn bigCosts(op: string, cost: int): void {
    let text = bigProgram(op);
    // 1001 words: the shift's cost is 1 + 1002 / 8
    let shift = 1 + 1002 / 8;
    assertEq(scalar(runText(text, "p", [32000], shift + cost)), 7);
    assertTrue(suspended(runText(text, "p", [32000], shift + cost - 1)));
    assertTrue(suspended(runText(text, "p", [32000], shift - 1)));
    assertEq(scalar(runText(text, "p", [32000], -1)), 7);
}

@Test
fn theNativesOfABigIntChargeByTheirOperands(): void {
    bigCosts("call.n big.add, s1, r0", 1 + 1001 / 8);
    bigCosts("call.n big.sub, s1, r0", 1 + 1001 / 8);
    bigCosts("call.n big.cmp, s1, r0", 1 + 1001 / 8);
    bigCosts("call.n big.neg, s1, r0", 1 + 1001 / 8);
    bigCosts("call.n big.hash, s1, r0", 1 + 1001 / 8);
    bigCosts("call.n big.mul, s1, r0", 1 + 1001 * 1001 / 8);
    // a quotient one word long walks the divisor once
    bigCosts("call.n big.div, s1, r0", 1 + 1 * 1001 / 8);
    bigCosts("call.n big.rem, s1, r0", 1 + 1 * 1001 / 8);
    bigCosts("load.i s1, 10\n        call.n big.text, s1, r0", 1 + 1001 * 1001 / 4);
    bigCosts("load.i s1, 5\n        call.n big.shr, s1, r0", 1 + 1001 / 8);
    bigCosts("load.i s1, 3200\n        call.n big.shl, s1, r0", 1 + (100 + 1001 + 1) / 8);
    // a length, a sign's room, a conversion: what they read does not grow with the number
    bigCosts("call.n big.bitLength, s1, r0", 0);
    bigCosts("call.n big.fitsInt, s1, r0", 0);
    bigCosts("call.n big.toInt, s1, r0", 0);
    bigCosts("call.n big.toFloat, s1, r0", 0);
}

@Test
fn aBigIntProductTheBudgetDoesNotCoverIsNotStarted(): void {
    // half a million words: a square would take minutes; a unit too few returns at once
    let text = bigProgram("call.n big.mul, s1, r0");
    let words = 524288;
    let shift = 1 + (words + 1) / 8;
    assertTrue(suspended(runText(text, "p", [((words - 1) * 32) as uint64], shift)));
}

// What the natives of `Bytes` cost (12 rule 17): `s0` their number, so the first native makes them
// for `1 + n / 32`, and the operation after it costs as its rule says.
fn bytesProgram(op: string): string {
    return f"""
    fn p(s) -> s regs 4 2
        call.n bytes.new, s0, r0
        call.n bytes.len, s1, r0
        move.r r1, r0
        {op}
        load.i s0, 7
        ret.s s0
    end
    """;
}

fn bytesCosts(op: string, cost: int): void {
    let text = bytesProgram(op);
    let made = 1 + 3200 / 32;
    assertEq(scalar(runText(text, "p", [3200], made + cost)), 7);
    assertTrue(suspended(runText(text, "p", [3200], made + cost - 1)));
    assertTrue(suspended(runText(text, "p", [3200], made - 1)));
    assertEq(scalar(runText(text, "p", [3200], -1)), 7);
}

@Test
fn aNativeThatWaitsDoesNotStartWithoutItsBudget(): void {
    // only the side that does not start: the other would read this test's standard input
    let made = 1 + 3200 / 32;
    assertTrue(
        suspended(runText(bytesProgram("call.w console.read, s1, r0"), "p", [3200], made + 100))
    );
    let line = """
    fn p(s) -> s regs 2 1
        call.w console.line, s1, r0
        ret.s s1
    end
    """;
    assertTrue(suspended(runText(line, "p", [1], 0)));
    // a write to the console too: charged by its bytes, and none of them written
    let put = bytesProgram("load.i s1, 1\n        call.n console.put, s1, r0");
    assertTrue(suspended(runText(put, "p", [3200], made + 100)));
}

/// The handle in r0, the file open as `how` says, the 3200 bytes in r1, then `op`.
/// A path as the assembler's text says it: Windows' separators are escapes there.
fn inAsm(path: string): string {
    return path.replace("\\", "\\\\");
}

fn fileProgram(path: string, how: int, op: string): string {
    return f"""
    fn p(s) -> s regs 4 3
        call.n bytes.new, s0, r2
        call.n fs.file, s1, r0
        load.str r1, "{inAsm(path)}"
        load.i s1, {how}
        call.w fs.open, s1, r0
        move.r r1, r2
        {op}
        load.i s0, 7
        ret.s s0
    end
    """;
}

fn fileCosts(path: string, how: int, op: string, cost: int): void {
    let text = fileProgram(path, how, op);
    let before = 1 + 3200 / 32 + 1 + path.length() / 32;
    assertEq(scalar(runText(text, "p", [3200], before + cost)), 7);
    assertTrue(suspended(runText(text, "p", [3200], before + cost - 1)));
}

@Test
fn aFilesCallsChargeBeforeTheyStart(): void {
    let path = try! tempFile();
    defer {
        try! remove(path);
    }
    try! writeBytes(path, [0 as uint8] * 3200);
    let walk = 1 + 3200 / 32;
    fileCosts(path, 1, "", 0);
    fileCosts(path, 1, "call.w fs.read, s1, r0", walk);
    fileCosts(path, 2, "call.w fs.write, s1, r0", walk);
    fileCosts(path, 1, "load.i s1, 0\n        load.i s2, 0\n        call.w fs.seek, s1, r0", 1);
    fileCosts(path, 1, "call.w fs.close, s1, r0", 1);
    // what the budget does not cover has not happened: the bytes are still there
    assertTrue(suspended(runText(fileProgram(path, 2, "call.w fs.write, s1, r0"), "p", [3200], 1)));
    assertEq((try! readBytes(path)).length(), 3200);
}

/// `op` with a handle's place in r0, the path in r1 and r2, in a program that answers 7.
fn dirProgram(path: string, op: string): string {
    return f"""
    fn p(s) -> s regs 4 5
        load.str r1, "{inAsm(path)}"
        load.str r2, "{inAsm(path)}"
        {op}
        load.i s0, 7
        ret.s s0
    end
    """;
}

fn dirCosts(path: string, op: string, cost: int): void {
    let text = dirProgram(path, op);
    assertEq(scalar(runText(text, "p", [0], cost)), 7, op);
    assertTrue(suspended(runText(text, "p", [0], cost - 1)), op);
}

@Test
fn theSystemsCallsChargeBeforeTheyAct(): void {
    let long = "x" * 3200;
    let one = 1 + 3200 / 32;
    // no such directory: the call fails, what counts is what it took first
    dirCosts(long, "call.w os.setCwd, s1, r1", one);
    assertTrue(suspended(runText(dirProgram("x", "call.w os.cwd, s1, r0"), "p", [0], 0)));
    assertTrue(suspended(runText(dirProgram("x", "call.w os.hostname, s1, r0"), "p", [0], 0)));
    // a variable is set once it is paid, by its name and its value
    let name = "LYRIC_SCRIPT_TEST_" + "y" * 3182;
    let set = dirProgram(name, "call.n os.setEnv, s1, r1");
    assertTrue(suspended(runText(set, "p", [0], 2 * one - 2)));
    assertTrue(env(name) == null);
    assertEq(scalar(runText(set, "p", [0], 1 + 6400 / 32)), 7);
    assertEq(env(name), name);
    // the whole environment costs what it holds
    setEnv("LYRIC_SCRIPT_TEST_LONG", long);
    let all = dirProgram("x", "call.n os.envs, s1, r0");
    assertTrue(suspended(runText(all, "p", [0], one - 1)));
    assertEq(scalar(runText(all, "p", [0], -1)), 7);
}

@Test
fn aChildIsChargedBeforeItStarts(): void {
    // no such program: the start fails, what counts is what it took first, the program and its four other texts
    let text = f"""
    fn p(s) -> s regs 4 7
        call.n process.child, s1, r0
        load.str r1, "{"x" * 3200}"
        load.str r2, ""
        load.str r3, ""
        load.str r4, ""
        load.str r5, ""
        load.i s1, 0
        load.i s2, 0
        load.i s3, 0
        call.w process.spawn, s1, r0
        load.i s0, 7
        ret.s s0
    end
    """;
    let cost = 1 + 3200 / 32 + 4;
    assertEq(scalar(runText(text, "p", [0], cost)), 7);
    assertTrue(suspended(runText(text, "p", [0], cost - 1)));
}

@Test
fn signalsTakeTheSignalsAndTheirForms(): void {
    // `std.os` hands it two arrays, the forms eight; bytecode that hands it other things is the program's mistake
    let text = """
    fn p(s) -> s regs 1 2
        load.null r0
        load.null r1
        call.n os.signals, s0, r0
        ret.s s0
    end
    """;
    assertEq(panicOf(runText(text, "p", [0], -1)).code, "LYS-RT0007");
}

@Test
fn aChildNotStartedHoldsNoPipe(): void {
    // `std.process` never hands one out; bytecode that reads from one is the program's mistake, not the VM's
    let text = """
    fn p(s) -> s regs 2 2
        call.n process.child, s1, r0
        load.i s0, 4
        call.n bytes.new, s0, r1
        load.i s0, 1
        call.w process.read, s0, r0
        ret.s s0
    end
    """;
    assertEq(panicOf(runText(text, "p", [0], -1)).code, "LYS-RT0007");
}

@Test
fn whatAPathNamesIsChargedBeforeItIsAsked(): void {
    // no such path: the call fails, what counts is what it took first
    let long = "x" * 3200;
    let one = 1 + 3200 / 32;
    dirCosts(long, "call.w fs.metadata, s1, r1", one);
    dirCosts(long, "call.w fs.createDir, s1, r1", one);
    dirCosts(long, "call.w fs.remove, s1, r1", one);
    dirCosts(long, "call.w fs.removeDir, s1, r1", one);
    dirCosts(long, "call.w fs.rename, s1, r1", 2 * one);
    dirCosts(long, "call.w fs.canonicalize, s1, r0", one);
    dirCosts(long, "call.w fs.absolute, s1, r0", one);
    dirCosts(long, "call.n fs.dir, s1, r0\n        call.w fs.dirOpen, s1, r0", one);
    // a place is made once it is paid: without the budget, none is
    assertTrue(suspended(runText(dirProgram("x", "call.w fs.tempDir, s1, r0"), "p", [0], 0)));
    assertTrue(suspended(runText(dirProgram("x", "call.w fs.tempFile, s1, r0"), "p", [0], 0)));
    // what the budget does not cover has not happened
    let t = try! tempDir();
    defer {
        try! removeAll(t);
    }
    let made = join(t, "made");
    assertTrue(suspended(runText(dirProgram(made, "call.w fs.createDir, s1, r1"), "p", [0], 1)));
    assertTrue(!exists(made));
    // a directory's entry costs one, and letting it go
    let open = f"call.n fs.dir, s1, r0\n        call.w fs.dirOpen, s1, r0\n        ";
    let opened = 1 + t.length() / 32;
    dirCosts(t, open + "move.r r4, r0\n        call.w fs.dirNext, s1, r3", opened + 1);
    dirCosts(t, open + "call.w fs.dirClose, s1, r0", opened + 1);
}

fn exitCode(o: Outcome): int {
    return match (o) {
        .Exit(code) => code,
        _ => -999999,
    };
}

@Test
fn anExitIsTheRunsOutcome(): void {
    let text = """
    fn p() -> s regs 2 1
        load.i s0, 7
        call.n os.exit, s0, r0
        load.i s0, 8
        ret.s s0
    end
    """;
    assertEq(exitCode(runText(text, "p", [], -1)), 7);
    // it asks nothing of the budget
    assertEq(exitCode(runText(text, "p", [], 0)), 7);
}

@Test
fn aRunsArgumentsAreTheHostsToGive(): void {
    let module = try! assemble(
        """
        fn p() -> s regs 2 1
            call.n os.argCount, s0, r0
            ret.s s0
        end
        fn q() -> s regs 2 1
            load.i s0, 1
            call.n os.arg, s0, r0
            load.i s1, 0
            ret.s s1
        end
        """,
        "t"
    );
    assertEq(scalar(execute(module, "p", [], -1)), 0);
    assertEq(scalar(execute(module, "p", [], -1, ["tool", "a", "b"])), 3);
    assertEq(scalar(execute(module, "q", [], -1, ["tool", "a"])), 0);
}

@Test
fn theNativesOfBytesChargeByTheirBytes(): void {
    let walk = 1 + 3200 / 32;
    bytesCosts("call.n bytes.toList, s1, r0", walk);
    bytesCosts("call.n bytes.text, s1, r0", walk);
    bytesCosts("call.n bytes.badUtf8, s1, r0", walk);
    bytesCosts("call.n bytes.cmp, s1, r0", walk);
    bytesCosts("call.n bytes.append, s1, r0", walk);
    bytesCosts("load.i s1, 0\n        call.n bytes.mix, s1, r0", walk);
    bytesCosts("load.i s1, 0\n        call.n bytes.fill, s1, r0", walk);
    // a slice costs what it copies
    bytesCosts("load.i s1, 0\n        load.i s2, 3200\n        call.n bytes.slice, s1, r0", walk);
    bytesCosts("load.i s1, 100\n        load.i s2, 164\n        call.n bytes.slice, s1, r0", 3);
    // a copy and a search cost what they walk
    bytesCosts(
        "load.i s1, 0\n        load.i s2, 0\n        load.i s3, 3200\n        call.n bytes.copy, s1, r0",
        walk
    );
    bytesCosts(
        "load.i s1, 0\n        load.i s2, 100\n        load.i s3, 164\n        call.n bytes.copy, s1, r0",
        3
    );
    bytesCosts(
        "load.i s1, 300\n        load.i s2, 0\n        load.i s3, 3200\n        call.n bytes.find, s1, r0",
        walk
    );
    bytesCosts(
        "load.i s1, 300\n        load.i s2, 100\n        load.i s3, 164\n        call.n bytes.find, s1, r0",
        3
    );
    // what makes them from a text or a list: what gives the operand, then the same again
    bytesCosts("call.n bytes.toList, s1, r0\n        call.n bytes.ofList, s1, r0", walk + walk);
    bytesCosts("call.n bytes.text, s1, r0\n        call.n bytes.ofText, s1, r0", walk + walk);
    bytesCosts("call.n bytes.text, s1, r0\n        call.n bytes.ofLatin1, s1, r0", walk + walk);
    // one byte at a time: what they do does not grow with the bytes
    bytesCosts("call.n bytes.len, s1, r0", 0);
    bytesCosts("load.i s1, 5\n        call.n bytes.get, s1, r0", 0);
    bytesCosts("load.i s1, 5\n        load.i s2, 9\n        call.n bytes.set, s1, r0", 0);
    bytesCosts("load.i s1, 9\n        call.n bytes.push, s1, r0", 0);
    bytesCosts("load.i s1, 9\n        call.n bytes.truncate, s1, r0", 0);
}

@Test
fn bytesTheBudgetDoesNotCoverAreNotMade(): void {
    // a program that makes more than memory holds, a unit too few returns at once
    let text = "fn p(s) -> s regs 1 1\n    call.n bytes.new, s0, r0\n    ret.s s0\nend\n";
    assertTrue(suspended(runText(text, "p", [1 << 50], 1000)));
}

@Test
fn aLoopSums(): void {
    assertEq(scalar(runText(sum, "sum", [1000], -1)), 500500);
}

@Test
fn theFuelStopsALoopAtTheSameBackwardJump(): void {
    // 1000 iterations take 999 backward jumps
    assertTrue(suspended(runText(sum, "sum", [1000], 998)));
    assertEq(scalar(runText(sum, "sum", [1000], 999)), 500500);
}

/// A loop that jumps back by a fused comparison pays as one that compares first (S7k1b): `jump.le.i`
/// and `jump.lt.i` each have their own arm, and each takes the fuel of a backward jump.
@Test
fn aFusedComparisonPaysItsBackwardJump(): void {
    let le = """
        fn sum(s) -> s regs 3 0
            load.i s1, 0
            load.i s2, 1
        loop:
            add.i s1, s1, s2
            add.imm s2, s2, 1
            jump.le.i s2, s0, @loop
            ret.s s1
        end
        """;
    let lt = """
        fn sum(s) -> s regs 4 0
            load.i s1, 0
            load.i s2, 1
            add.imm s3, s0, 1
        loop:
            add.i s1, s1, s2
            add.imm s2, s2, 1
            jump.lt.i s2, s3, @loop
            ret.s s1
        end
        """;
    for (text in [le, lt]) {
        assertTrue(suspended(runText(text, "sum", [1000], 998)));
        assertEq(scalar(runText(text, "sum", [1000], 999)), 500500);
    }
}

@Test
fn overflowIsTheScriptsPanic(): void {
    let text = """
        fn top() -> s regs 2 0
            load.k s0, 9223372036854775807
            load.i s1, 1
            add.i s0, s0, s1
            ret.s s0
        end
        """;
    let p = panicOf(runText(text, "top", [], -1));
    assertEq(p.code, "LYS-RT0002");
    assertEq(p.trace.length(), 1);
    assertTrue(p.trace[0].contains("top (line 4)"));
}

@Test
fn divisionByZeroIsTheScriptsPanicWithItsCallers(): void {
    let text = """
        fn div(s, s) -> s regs 2 0
            div.i s0, s0, s1
            ret.s s0
        end

        fn main() -> s regs 2 0
            load.i s0, 7
            load.i s1, 0
            call div, s0, r0
            ret.s s0
        end
        """;
    let p = panicOf(runText(text, "main", [], -1));
    assertEq(p.code, "LYS-RT0001");
    assertEq(p.trace.length(), 2);
    assertTrue(p.trace[0].contains("div"));
    assertTrue(p.trace[1].contains("main"));
}

@Test
fn aTooDeepRecursionIsAStackOverflow(): void {
    let text = """
        fn down(s) -> s regs 1 0
            call down, s0, r0
            ret.s s0
        end
        """;
    let p = panicOf(runText(text, "down", [0], -1));
    assertEq(p.code, "LYS-RT0006");
    assertEq(p.trace.length(), maxDepth + 1);
}

/// A recursion deeper than the frames' first array returns through every frame (S7j): the frames
/// grow, and what they held before is what they hold after.
@Test
fn aDeepRecursionReturnsThroughEveryFrame(): void {
    let text = """
        fn sum(s) -> s regs 3 0
            load.i s1, 0
            jump.lt.i s1, s0, @more
            ret.s s0
        more:
            add.imm s2, s0, -1
            call sum, s2, r0
            add.i s0, s0, s2
            ret.s s0
        end
        """;
    assertEq(scalar(runText(text, "sum", [1000], -1)), 500500);
}

@Test
fn objectsHoldTheirFields(): void {
    let text = """
        type Node scalar value ref next

        fn main() -> s regs 3 3
            load.null r2
            new r0, Node
            load.i s0, 30
            set.s r0, Node.value, s0
            set.r r0, Node.next, r2
            new r1, Node
            load.i s0, 12
            set.s r1, Node.value, s0
            set.r r1, Node.next, r0
            get.r r2, r1, Node.next
            get.s s1, r2, Node.value
            get.s s2, r1, Node.value
            add.i s0, s1, s2
            ret.s s0
        end
        """;
    assertEq(scalar(runText(text, "main", [], -1)), 42);
}

@Test
fn aFieldOfNullIsTheScriptsPanic(): void {
    let text = """
        type Node scalar value

        fn main() -> s regs 1 1
            load.null r0
            get.s s0, r0, Node.value
            ret.s s0
        end
        """;
    assertEq(panicOf(runText(text, "main", [], -1)).code, "LYS-RT0004");
}

@Test
fn floatsCompute(): void {
    let text = """
        fn main() -> s regs 3 0
            load.k s0, 1.5
            load.k s1, 2.25
            add.f s2, s0, s1
            f2i s0, s2
            ret.s s2
        end
        """;
    let o = runText(text, "main", [], -1);
    let v = match (o) {
        .Scalar(bits) => float.fromBits(bits),
        _ => 0.0,
    };
    assertEq(v, 3.75);
}

@Test
fn panicCarriesItsMessage(): void {
    let text = """
        fn main() regs 0 1
            load.str r0, "no way"
            panic r0
        end
        """;
    let p = panicOf(runText(text, "main", [], -1));
    assertEq(p.code, "LYS-RT0008");
    assertEq(p.message, "no way");
}

@Test
fn aStringIsReturnedAsAReference(): void {
    let text = """
        fn main() -> r regs 0 1
            load.str r0, "hello"
            ret.r r0
        end
        """;
    let o = runText(text, "main", [], -1);
    let ok = match (o) {
        .Ref(v) => v is ScriptString && v.text == "hello",
        _ => false,
    };
    assertTrue(ok);
}

let optional: string = """
    fn some(s) -> slots 2 0 regs 2 0
        load.i s1, 1
        ret.n s0, r0
    end

    fn none(s) -> slots 2 0 regs 2 0
        load.i s1, 0
        ret.n s0, r0
    end

    fn present() -> s regs 3 0
        load.i s0, 41
        call some, s0, r0
        check.s s1
        add.imm s0, s0, 1
        ret.s s0
    end

    fn absent() -> s regs 3 0
        load.i s0, 41
        call none, s0, r0
        check.s s1
        ret.s s0
    end

    fn nilTest() -> s regs 1 1
        load.null r0
        is.nil s0, r0
        check.r r0
        ret.s s0
    end
    """;

@Test
fn aValueOfSeveralSlotsComesBackWhole(): void {
    // `?int` is two scalar slots, the value and its presence (11 V2)
    assertEq(scalar(runText(optional, "present", [], -1)), 42);
    let o = runText(optional, "some", [7 as uint64], -1);
    match (o) {
        .Slots(s, r) => {
            assertEq(s.length(), 2);
            assertEq(s[0] as int, 7);
            assertEq(s[1] as int, 1);
            assertEq(r.length(), 0);
        }
        _ => assertTrue(false, "the slots of the result"),
    }
}

@Test
fn anAbsentValueUnwrappedIsTheScriptsPanic(): void {
    assertEq(panicOf(runText(optional, "absent", [], -1)).code, "LYS-RT0004");
    assertEq(panicOf(runText(optional, "nilTest", [], -1)).code, "LYS-RT0004");
}

let throwing: string = """
    type Oops
    fn inner() -> s regs 1 1
        new r0, Oops
        throw r0
    end
    fn outer() -> s regs 1 2
    from:
        call inner, s0, r1
    to:
        load.i s0, 1
        ret.s s0
    handler:
        load.i s0, 42
        ret.s s0
        catch @from, @to, @handler, r0, r1
    end
    fn missed() -> s regs 1 2
        call inner, s0, r1
    from:
        load.i s0, 1
    to:
        ret.s s0
    handler:
        load.i s0, 42
        ret.s s0
        catch @from, @to, @handler, r0, r1
    end
    """;

@Test
fn anErrorLeavesFramesForTheRegionThatCoversTheCall(): void {
    // the callee throws; in the caller the call stands where it was thrown (06 §5 rule 1)
    assertEq(scalar(runText(throwing, "outer", [], -1)), 42);
}

@Test
fn anErrorNoRegionCoversLeavesTheRun(): void {
    // `missed`'s region starts after the call; a module without `Error` names the error by its
    // type
    match (runText(throwing, "missed", [], -1)) {
        .Error(e) => {
            assertEq(e.typeName, "Oops");
            assertEq(e.message, "Oops");
            assertEq(e.causes.length(), 0);
            assertEq(e.trace, ["at inner (line 4)", "at missed (line 18)"]);
        }
        _ => assertTrue(false, "an error leaves the run"),
    }
}
