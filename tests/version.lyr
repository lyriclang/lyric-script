// The version the toolchain reports, and the first export of the C ABI.
import std.test { assertEq, assertTrue };
import lyric_script { version, abiVersion };

@Test
fn theVersionIsOfTheOneLine(): void {
    assertTrue(version.startsWith("1."));
}

@Test
fn theAbiStartsAtOne(): void {
    assertEq(abiVersion(), 1);
}
